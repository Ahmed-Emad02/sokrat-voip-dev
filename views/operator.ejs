<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <!-- Prevent theme flickering -->
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - Operator Board</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #121212;
            --bg-card: #18181b;
            --bg-hover: #27272a;
            --border-primary: #27272a;
            --border-accent: #3f3f46;
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent-color: var(--accent-color);
            --accent-hover: var(--accent-hover);
            --status-online: var(--accent-color);
            --status-offline: #71717a;
            --status-active: var(--accent-color);
        }
        body { 
            background-color: var(--bg-primary); 
            font-family: 'Roboto', 'IBM Plex Sans Arabic', sans-serif; 
            color: var(--text-primary); 
        }
        /* Modern background pattern with subtle gradients */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 10% 20%, rgba(255, 59, 48, 0.06) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.02) 0%, transparent 45%);
            pointer-events: none;
            z-index: -1;
        }
        .panel-surface { 
            background-color: var(--bg-secondary); 
            border: 1px solid var(--border-primary); 
        }
        .accent-orange { color: var(--accent-color); }
        .font-vibrant-display { font-weight: 900; letter-spacing: -0.01em; }
        .card-stat { 
            transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), 
                        border-color 150ms cubic-bezier(0.4, 0, 0.2, 1); 
        }
        .card-stat:hover { 
            transform: translateY(-2px); 
            border-color: var(--border-accent); 
        }
        input, select, button { 
            transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1); 
        }
        
        /* Switchboard color coding overrides */
        
        /* === STATE 1: OFFLINE === */
        #switchboardGrid .panel-surface.state-offline {
            opacity: 1;
            background-color: var(--bg-card) !important;
            border-color: var(--border-primary) !important;
        }
        .light-theme #switchboardGrid .panel-surface.state-offline {
            background-color: #ffffff !important;
            border-color: #e4e4e7 !important;
        }
        .light-theme #switchboardGrid .panel-surface.state-offline .text-white {
            color: #09090b !important;
        }
        .light-theme #switchboardGrid .panel-surface.state-offline .employee-title {
            color: #71717a !important;
        }
        .light-theme #switchboardGrid .panel-surface.state-offline .employee-group-chip,
        .light-theme #switchboardGrid .panel-surface.state-offline .employee-avatar {
            background-color: #f4f4f5 !important;
            border-color: #e4e4e7 !important;
            color: #27272a !important;
        }
        .employee-ip-badge {
            font-size: 0.625rem;
            line-height: 0.875rem;
            letter-spacing: 0.02em;
            transition: all 150ms ease;
        }
        #switchboardGrid .panel-surface.state-offline .employee-ip-badge {
            background-color: rgba(39, 39, 42, 0.6);
            border-color: rgba(63, 63, 70, 0.4);
            color: #a1a1aa;
        }
        .light-theme #switchboardGrid .panel-surface.state-offline .employee-ip-badge {
            background-color: #f4f4f5 !important;
            border-color: #e4e4e7 !important;
            color: #52525b !important;
        }
        #switchboardGrid .panel-surface.state-idle .employee-ip-badge,
        .light-theme #switchboardGrid .panel-surface.state-idle .employee-ip-badge {
            background-color: rgba(0, 0, 0, 0.14) !important;
            border-color: rgba(0, 0, 0, 0.22) !important;
            color: #111827 !important;
        }
        #switchboardGrid .panel-surface.state-ringing .employee-ip-badge,
        .light-theme #switchboardGrid .panel-surface.state-ringing .employee-ip-badge {
            background-color: rgba(0, 0, 0, 0.3) !important;
            border-color: rgba(255, 255, 255, 0.35) !important;
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-incall .employee-ip-badge,
        .light-theme #switchboardGrid .panel-surface.state-incall .employee-ip-badge {
            background-color: rgba(0, 0, 0, 0.3) !important;
            border-color: rgba(255, 255, 255, 0.35) !important;
            color: #ffffff !important;
        }

        /* === STATE 2: ONLINE / IDLE (ORANGE) === */
        #switchboardGrid .panel-surface.state-idle,
        .light-theme #switchboardGrid .panel-surface.state-idle {
            background-color: #f59e0b !important;
            border-color: rgba(255, 255, 255, 0.25) !important;
            color: #111827 !important;
        }
        #switchboardGrid .panel-surface.state-idle:hover,
        .light-theme #switchboardGrid .panel-surface.state-idle:hover {
            border-color: rgba(255, 255, 255, 0.5) !important;
        }
        #switchboardGrid .panel-surface.state-idle .text-white,
        #switchboardGrid .panel-surface.state-idle .text-base.font-bold,
        .light-theme #switchboardGrid .panel-surface.state-idle .text-white,
        .light-theme #switchboardGrid .panel-surface.state-idle .text-base.font-bold {
            color: #111827 !important;
        }
        #switchboardGrid .panel-surface.state-idle .extension-number {
            color: #7f1d1d !important;
        }
        #switchboardGrid .panel-surface.state-idle .employee-title {
            color: #3f2d00 !important;
        }
        #switchboardGrid .panel-surface.state-idle .employee-group-chip {
            border-color: rgba(17, 24, 39, 0.18) !important;
            background: rgba(17, 24, 39, 0.10) !important;
            color: #111827 !important;
        }
        #switchboardGrid .panel-surface.state-idle .employee-avatar {
            border-color: rgba(17, 24, 39, 0.2) !important;
            background: rgba(255, 255, 255, 0.28) !important;
            color: #111827 !important;
        }
        #switchboardGrid .panel-surface.state-idle [id^="sipBadge-"],
        #switchboardGrid .panel-surface.state-idle [id^="badge-"] {
            background-color: #22c55e !important;
        }
        #switchboardGrid .panel-surface.state-idle [id^="sipLabel-"],
        #switchboardGrid .panel-surface.state-idle [id^="status-"] {
            color: #052e16 !important;
            font-weight: 800 !important;
        }
        #switchboardGrid .panel-surface.state-idle .border-t {
            border-color: rgba(17, 24, 39, 0.15) !important;
        }
        #switchboardGrid .panel-surface.state-idle .action-select,
        .light-theme #switchboardGrid .panel-surface.state-idle .action-select {
            background-color: rgba(0, 0, 0, 0.12) !important;
            border-color: rgba(0, 0, 0, 0.18) !important;
            color: #111827 !important;
        }

        /* === STATE 3: RINGING (PURPLE) === */
        #switchboardGrid .panel-surface.state-ringing,
        .light-theme #switchboardGrid .panel-surface.state-ringing {
            background-color: #7e22ce !important;
            border-color: rgba(255, 255, 255, 0.4) !important;
            color: #ffffff !important;
            animation: pulse-ring-purple 2s infinite;
        }
        @keyframes pulse-ring-purple {
            0% { border-color: rgba(255, 255, 255, 0.3); }
            50% { border-color: rgba(255, 255, 255, 0.8); }
            100% { border-color: rgba(255, 255, 255, 0.3); }
        }
        #switchboardGrid .panel-surface.state-ringing .text-white,
        #switchboardGrid .panel-surface.state-ringing .text-base.font-bold,
        .light-theme #switchboardGrid .panel-surface.state-ringing .text-white,
        .light-theme #switchboardGrid .panel-surface.state-ringing .text-base.font-bold {
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-ringing .extension-number {
            color: #fef08a !important; /* High-contrast yellow */
        }
        #switchboardGrid .panel-surface.state-ringing .employee-title {
            color: #f1f5f9 !important;
        }
        #switchboardGrid .panel-surface.state-ringing .employee-group-chip {
            border-color: rgba(255, 255, 255, 0.3) !important;
            background: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-ringing .employee-avatar {
            border-color: rgba(255, 255, 255, 0.4) !important;
            background: rgba(255, 255, 255, 0.25) !important;
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-ringing [id^="sipBadge-"],
        #switchboardGrid .panel-surface.state-ringing [id^="badge-"] {
            background-color: #3b82f6 !important;
        }
        #switchboardGrid .panel-surface.state-ringing [id^="sipLabel-"],
        #switchboardGrid .panel-surface.state-ringing [id^="status-"],
        #switchboardGrid .panel-surface.state-ringing [id^="partner-"] {
            color: #ffffff !important;
            font-weight: 800 !important;
        }
        #switchboardGrid .panel-surface.state-ringing .border-t {
            border-color: rgba(255, 255, 255, 0.25) !important;
        }
        #switchboardGrid .panel-surface.state-ringing .action-select,
        .light-theme #switchboardGrid .panel-surface.state-ringing .action-select {
            background-color: rgba(0, 0, 0, 0.35) !important;
            border-color: rgba(255, 255, 255, 0.3) !important;
            color: #ffffff !important;
        }

        /* === STATE 4: IN CALL (GREEN) === */
        #switchboardGrid .panel-surface.state-incall,
        .light-theme #switchboardGrid .panel-surface.state-incall {
            background-color: #15803d !important;
            border-color: rgba(255, 255, 255, 0.4) !important;
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-incall .text-white,
        #switchboardGrid .panel-surface.state-incall .text-base.font-bold,
        .light-theme #switchboardGrid .panel-surface.state-incall .text-white,
        .light-theme #switchboardGrid .panel-surface.state-incall .text-base.font-bold {
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-incall .extension-number,
        #switchboardGrid .panel-surface.state-incall [id^="timer-"] {
            color: #fef08a !important; /* High-contrast yellow */
        }
        #switchboardGrid .panel-surface.state-incall .employee-title {
            color: #f1f5f9 !important;
        }
        #switchboardGrid .panel-surface.state-incall .employee-group-chip {
            border-color: rgba(255, 255, 255, 0.3) !important;
            background: rgba(255, 255, 255, 0.2) !important;
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-incall .employee-avatar {
            border-color: rgba(255, 255, 255, 0.4) !important;
            background: rgba(255, 255, 255, 0.25) !important;
            color: #ffffff !important;
        }
        #switchboardGrid .panel-surface.state-incall [id^="sipBadge-"],
        #switchboardGrid .panel-surface.state-incall [id^="badge-"] {
            background-color: #a855f7 !important;
        }
        #switchboardGrid .panel-surface.state-incall [id^="sipLabel-"],
        #switchboardGrid .panel-surface.state-incall [id^="status-"],
        #switchboardGrid .panel-surface.state-incall [id^="partner-"] {
            color: #ffffff !important;
            font-weight: 800 !important;
        }
        #switchboardGrid .panel-surface.state-incall .border-t {
            border-color: rgba(255, 255, 255, 0.25) !important;
        }
        #switchboardGrid .panel-surface.state-incall .action-select,
        .light-theme #switchboardGrid .panel-surface.state-incall .action-select {
            background-color: rgba(0, 0, 0, 0.35) !important;
            border-color: rgba(255, 255, 255, 0.3) !important;
            color: #ffffff !important;
        }
        .live-panel-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
        }
        .employee-group-header {
            display: flex;
            align-items: center;
            gap: 0.625rem;
            min-height: 2rem;
            padding: 0 0.25rem;
        }
        .employee-group-count {
            min-width: 1.5rem;
            height: 1.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: var(--bg-card);
            color: var(--text-secondary);
            font-size: 0.6875rem;
            font-weight: 800;
        }
        .employee-avatar {
            position: relative;
            width: 2.75rem;
            height: 2.75rem;
            flex: 0 0 2.75rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid var(--border-primary);
            border-radius: 0.75rem;
            background: var(--bg-hover);
            color: var(--text-secondary);
            font-size: 0.875rem;
            font-weight: 900;
        }
        .employee-avatar img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .employee-title {
            display: block;
            min-height: 1rem;
            margin-top: 0.125rem;
            overflow: hidden;
            color: var(--text-secondary);
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1rem;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .employee-title-empty { color: var(--text-muted); font-weight: 500; }
        .employee-group-chip {
            display: inline-flex;
            align-items: center;
            max-width: 100%;
            margin-top: 0.375rem;
            padding: 0.1875rem 0.5rem;
            overflow: hidden;
            border: 1px solid var(--border-primary);
            border-radius: 999px;
            background: var(--bg-card);
            color: var(--text-secondary);
            font-size: 0.625rem;
            font-weight: 800;
            line-height: 1;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        @media (max-width: 640px) {
            .live-panel-header { flex-direction: column; }
        }
        /* Employee group manager modal config-input compat */
        #groupManagerModal .config-input {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-primary) !important;
            color: var(--text-primary) !important;
            border-radius: 0.5rem !important;
            padding: 0.5rem 0.75rem !important;
            outline: none !important;
        }
        #groupManagerModal .config-input:focus {
            border-color: var(--accent-color) !important;
        }
        #groupManagerModal .config-btn-primary {
            background-color: var(--accent-color) !important;
            color: #fff !important;
            font-weight: 700 !important;
            border-radius: 0.5rem !important;
        }

        /* View Mode Overrides for Extension Switchboard Grid */
        #switchboardGrid.view-mode-compact .extension-group-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            gap: 0.5rem !important;
        }
        @media (min-width: 640px) {
            #switchboardGrid.view-mode-compact .extension-group-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1024px) {
            #switchboardGrid.view-mode-compact .extension-group-grid {
                grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            }
        }
        @media (min-width: 1400px) {
            #switchboardGrid.view-mode-compact .extension-group-grid {
                grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
            }
        }
        #switchboardGrid.view-mode-compact article[id^="card-"] {
            min-height: 124px !important;
            padding: 0.5rem !important;
        }
        #switchboardGrid.view-mode-compact article[id^="card-"] .employee-avatar {
            width: 2.25rem !important;
            height: 2.25rem !important;
            flex-basis: 2.25rem !important;
            font-size: 0.75rem !important;
        }
        #switchboardGrid.view-mode-compact article[id^="card-"] .employee-title,
        #switchboardGrid.view-mode-compact article[id^="card-"] .employee-group-chip {
            display: none !important;
        }
        #switchboardGrid.view-mode-compact article[id^="card-"] .border-t {
            margin-top: 0.35rem !important;
            padding-top: 0.35rem !important;
        }

        /* View Mode 3: Minimal 2-Column Responsive Grid */
        #switchboardGrid.view-mode-minimal .extension-group-grid {
            display: grid !important;
            grid-template-columns: repeat(1, minmax(0, 1fr)) !important;
            gap: 0.5rem !important;
        }
        @media (min-width: 768px) {
            #switchboardGrid.view-mode-minimal .extension-group-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
                gap: 0.625rem !important;
            }
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] {
            min-height: auto !important;
            padding: 0.625rem 0.875rem !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 0.75rem !important;
            flex-wrap: nowrap !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] > div:first-child {
            display: flex !important;
            align-items: center !important;
            gap: 0.625rem !important;
            min-width: 0 !important;
            flex: 1 1 auto !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .employee-avatar {
            width: 2.125rem !important;
            height: 2.125rem !important;
            flex-basis: 2.125rem !important;
            border-radius: 0.5rem !important;
            font-size: 0.8rem !important;
            flex-shrink: 0 !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .employee-title,
        #switchboardGrid.view-mode-minimal article[id^="card-"] .employee-group-chip {
            display: none !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .text-base.font-bold {
            font-size: 0.875rem !important;
            line-height: 1.15rem !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .extension-number {
            font-size: 0.75rem !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .border-t {
            border-top: 0 !important;
            margin-top: 0 !important;
            padding-top: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.5rem !important;
            margin-left: auto !important;
            flex-shrink: 0 !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .border-t > div:first-child {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.35rem !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .border-t > .mt-2 {
            margin-top: 0 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }
        #switchboardGrid.view-mode-minimal article[id^="card-"] .action-select {
            width: 7.75rem !important;
            height: 1.875rem !important;
            font-size: 0.6875rem !important;
            padding: 0.2rem 0.5rem !important;
        }

        /* === Drag & Drop arrangement of extension cards (local-only persistence) === */
        #switchboardGrid article[id^="card-"][draggable="true"] { cursor: grab; }
        #switchboardGrid article[id^="card-"].dnd-dragging {
            opacity: 0.45 !important;
            transform: scale(0.98) !important;
        }
        /* Snap card layout instantly while dragging — transitions would smear rapid reflows into flicker */
        #switchboardGrid.dnd-active article[id^="card-"] { transition: none !important; }
        #switchboardGrid.dnd-active .extension-group-grid {
            min-height: 72px;
            border-radius: 0.75rem;
            outline: 2px dashed rgba(245, 158, 11, 0.4);
            outline-offset: 3px;
        }
        #switchboardGrid .extension-group-grid.dnd-drop-hover {
            outline-color: var(--accent-color);
            background-color: rgba(255, 255, 255, 0.03);
        }
        .light-theme #switchboardGrid .extension-group-grid.dnd-drop-hover {
            background-color: rgba(0, 0, 0, 0.04);
        }
        /* Empty groups stay visible as drop targets */
        #switchboardGrid .extension-group-grid > .drop-hint { display: none; }
        #switchboardGrid .extension-group-grid:not(:has(> article[id^="card-"])) > .drop-hint {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 56px;
            border: 1px dashed var(--border-primary);
            border-radius: 0.75rem;
            color: var(--text-muted);
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <div class="flex-1 p-8 relative flex flex-col min-h-screen">
        
        <div class="live-panel-header mb-4 shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="min-w-0">
                <h2 class="text-xl font-vibrant-display text-[var(--text-primary)] tracking-tight"><%= t.title %> <span class="accent-orange"><%= t.subtitle %></span></h2>
            </div>
            <div class="flex items-center gap-2 shrink-0 flex-wrap">
                <div class="inline-flex items-center p-1 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] gap-1">
                    <button type="button" id="btn-op-grid" onclick="setOperatorViewMode('grid')" class="px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[var(--accent-color)] text-white">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span><%= t.viewGrid %></span>
                    </button>
                    <button type="button" id="btn-op-compact" onclick="setOperatorViewMode('compact')" class="px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="4" height="4"/><rect x="10" y="3" width="4" height="4"/><rect x="17" y="3" width="4" height="4"/><rect x="3" y="10" width="4" height="4"/><rect x="10" y="10" width="4" height="4"/><rect x="17" y="10" width="4" height="4"/><rect x="3" y="17" width="4" height="4"/><rect x="10" y="17" width="4" height="4"/><rect x="17" y="17" width="4" height="4"/></svg>
                        <span><%= t.viewCompact %></span>
                    </button>
                    <button type="button" id="btn-op-minimal" onclick="setOperatorViewMode('minimal')" class="px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                        <span><%= t.viewMinimal %></span>
                    </button>
                </div>
                <button onclick="openIntercomModal()" class="btn-primary shrink-0 px-3 py-2 text-xs cursor-pointer flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.684A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.316z"/></svg>
                    <span><%= t.intercomBtn %></span>
                </button>
                <button onclick="openGroupManager()" class="config-btn-primary shrink-0 px-3 py-2 text-xs cursor-pointer flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-1a6 6 0 00-9-5.197M15 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a7 7 0 00-7 7h14a7 7 0 00-7-7zm9-8v6m3-3h-6"/></svg>
                    <span><%= t.manageGroups %></span>
                </button>
            </div>
        </div>
        <div class="flex-1 min-h-0 overflow-y-auto mb-4 bg-black/20 rounded-2xl p-3 border border-[#27272a]/30">
            <div id="switchboardGrid">
                <%
                // Group roster by emp_group; every defined group gets a section even when empty
                var groups = {};
                var definedGroups = Array.isArray(employeeGroups) ? employeeGroups : [];
                definedGroups.forEach(function(gName) {
                    if (gName && !groups[gName]) groups[gName] = [];
                });
                roster.forEach(function(emp) {
                    var g = emp.emp_group || '___ungrouped___';
                    if (!groups[g]) groups[g] = [];
                    groups[g].push(emp);
                });
                var groupNames = Object.keys(groups).sort(function(a, b) {
                    if (a === '___ungrouped___') return 1;
                    if (b === '___ungrouped___') return -1;
                    return a.localeCompare(b);
                });
                %>
                <% groupNames.forEach(function(gName) { %>
                <section class="mb-5" aria-label="<%= gName === '___ungrouped___' ? t.ungrouped : gName %>" data-group="<%= gName %>">
                    <div class="employee-group-header mb-2">
                        <span class="h-2 w-2 rounded-full bg-[var(--accent-color)] shrink-0"></span>
                        <h3 class="text-sm font-extrabold text-[var(--text-primary)] truncate">
                            <%= gName === '___ungrouped___' ? t.ungrouped : gName %>
                        </h3>
                        <span class="employee-group-count"><%= groups[gName].length %></span>
                        <span class="h-px bg-[var(--border-primary)] flex-1"></span>
                    </div>
                    <div class="extension-group-grid grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4 gap-2">
                        <% groups[gName].forEach(function(emp) {
                            const live = activeCalls[emp.extension];
                            let callState = 'idle';
                            let partnerNum = '';
                            let startTimeStamp = '';
                            if (live) {
                                callState = live.state === 'In Call' ? 'incall' : 'ringing';
                                partnerNum = live.partner || '';
                                startTimeStamp = live.start || '';
                            }
                            const isOnline = emp.online;
                            const groupLabel = emp.emp_group || t.ungrouped;
                            const profileInitial = String(emp.name || emp.extension || '?').trim().charAt(0).toUpperCase();
                            let stateClass = 'state-offline';
                            if (isOnline) {
                                if (callState === 'incall') stateClass = 'state-incall';
                                else if (callState === 'ringing') stateClass = 'state-ringing';
                                else stateClass = 'state-idle';
                            }
                        %>
                        <article id="card-<%= emp.extension %>"
                                 data-start="<%= startTimeStamp %>"
                                 data-emp-group="<%= emp.emp_group || '' %>"
                                 class="panel-surface rounded-xl p-3 flex flex-col justify-between min-h-[188px] transition-all duration-300 relative overflow-hidden border <%= stateClass %>">
                            <div class="flex items-start justify-between gap-3 min-w-0">
                                <div class="flex items-start gap-2.5 min-w-0 flex-1">
                                    <div class="employee-avatar" aria-hidden="true">
                                        <span><%= profileInitial %></span>
                                        <% if (emp.photo) { %>
                                        <img src="<%= emp.photo %>" alt="" onerror="this.remove()">
                                        <% } %>
                                    </div>
                                    <div class="min-w-0 flex-1 <%= isRtl ? 'text-right' : 'text-left' %>">
                                        <div class="flex items-baseline gap-2 min-w-0">
                                            <span class="text-base font-bold text-white truncate" title="<%= emp.name %>"><%= emp.name %></span>
                                            <span class="extension-number text-xs font-mono font-black text-[var(--accent-color)] shrink-0"><%= emp.extension %></span>
                                        </div>
                                        <span class="employee-title <%= emp.title ? '' : 'employee-title-empty' %>" title="<%= emp.title || t.noTitle %>"><%= emp.title || t.noTitle %></span>
                                        <div class="flex items-center gap-1 flex-wrap mt-0.5">
                                            <span class="employee-group-chip" title="<%= groupLabel %>"><%= groupLabel %></span>
                                            <% if (emp.is_group_admin) { %>
                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-amber-500/15 text-amber-400 border border-amber-500/30 font-mono" title="<%= isRtl ? 'مدير المجموعة (صلاحية التقاط المكالمات)' : 'Group Admin (Call Pickup Authority)' %>">
                                                    <svg class="w-2.5 h-2.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                                                    <span>Admin</span>
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                                <div class="flex flex-col items-end gap-1 shrink-0">
                                    <div class="flex items-center gap-1.5">
                                        <span id="sipBadge-<%= emp.extension %>" class="h-2 w-2 rounded-full bg-zinc-800 transition-all duration-300"></span>
                                        <span id="sipLabel-<%= emp.extension %>" class="text-[11px] font-bold uppercase tracking-wide text-zinc-500 transition-all duration-300"><%= isOnline ? t.online : t.offline %></span>
                                    </div>
                                    <span id="ipText-<%= emp.extension %>" class="employee-ip-badge font-mono font-bold px-1.5 py-0.5 rounded border truncate max-w-[125px] select-all <%= emp.ip ? '' : 'hidden' %>" title="<%= emp.ip || '' %>"><%= emp.ip || '' %></span>
                                </div>
                            </div>

                            <div class="border-t border-zinc-900/50 pt-2 mt-3">
                                <div class="flex items-center justify-between gap-2 min-w-0">
                                    <div class="flex items-center gap-1.5 min-w-0">
                                        <span id="badge-<%= emp.extension %>" class="h-2 w-2 rounded-full shrink-0 bg-transparent transition-all duration-300"></span>
                                        <span id="status-<%= emp.extension %>" class="text-xs font-bold uppercase tracking-wide text-zinc-500 truncate transition-all duration-300">
                                            <%= callState === 'incall' ? t.incall : callState === 'ringing' ? t.ringing : t.noCall %>
                                        </span>
                                        <span id="timer-<%= emp.extension %>" class="text-xs font-mono font-bold text-[var(--accent-color)] tracking-wider <%= callState === 'incall' ? '' : 'hidden' %>">00:00</span>
                                    </div>
                                    <span id="partner-<%= emp.extension %>" title="<%= partnerNum %>" class="text-xs font-mono font-bold truncate max-w-[9rem] <%= (callState === 'incall' || callState === 'ringing') ? '' : 'hidden' %>">
                                        <%= partnerNum %>
                                    </span>
                                </div>
                                <div class="mt-2 relative">
                                    <select id="actionSelect-<%= emp.extension %>"
                                            onchange="handleSelectAction('<%= emp.extension %>', this.value); this.value='';"
                                            <%= (callState === 'incall' || callState === 'ringing') ? '' : 'disabled' %>
                                            class="action-select w-full bg-[var(--bg-card)] text-xs font-semibold rounded-lg px-2.5 py-1.5 border border-[var(--border-primary)] focus:outline-none focus:border-[var(--accent-color)] cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed transition-all duration-150 text-[var(--text-primary)]">
                                        <option value="" disabled selected hidden><%= isRtl ? 'إجراءات المكالمة' : 'Call Actions' %></option>
                                        <option value="listen"><%= isRtl ? 'استماع (Listen)' : 'Listen' %></option>
                                        <option value="whisper"><%= isRtl ? 'همس (Whisper)' : 'Whisper' %></option>
                                        <option value="barge"><%= isRtl ? 'تدخل (Barge)' : 'Barge' %></option>
                                        <option value="hijack" class="text-amber-400 font-bold"><%= isRtl ? 'سحب المكالمة (Hijack)' : 'Hijack Call' %></option>
                                        <option value="hangup" class="text-rose-400 font-bold"><%= isRtl ? 'إنهاء المكالمة' : 'End Call' %></option>
                                    </select>
                                </div>
                            </div>
                        </article>
                        <% }) %>
                        <div class="drop-hint col-span-full select-none"><%= t.dropHere %></div>
                    </div>
                </section>
                <% }) %>
                <% if (groupNames.length === 0) { %>
                <div class="text-center py-8 text-[var(--text-muted)] text-sm font-semibold"><%= isRtl ? 'لا توجد تحويلات' : 'No extensions found' %></div>
                <% } %>
            </div>

            <!-- TRUNKS LIVE BOARD SECTION -->
            <section class="mt-6 border-t border-[var(--border-primary)] pt-4" aria-label="Trunks Live Board">
                <div class="employee-group-header mb-3">
                    <span class="h-2 w-2 rounded-full bg-cyan-400 shrink-0 animate-pulse"></span>
                    <h3 class="text-sm font-extrabold text-[var(--text-primary)] tracking-wide uppercase">
                        <%= isRtl ? 'خطوط الربط النشطة (Trunks Live Board)' : 'Active Trunks Board' %>
                    </h3>
                    <span id="trunksTotalCount" class="employee-group-count">0</span>
                    <span class="h-px bg-[var(--border-primary)] flex-1"></span>
                </div>
                
                <div id="trunksLiveGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                    <!-- Rendered dynamically via Socket.io -->
                </div>
            </section>
        </div>
        <div class="panel-surface rounded-2xl px-6 py-4 bg-black/40 flex <%= isRtl ? 'flex-row-reverse' : '' %> justify-between items-center shrink-0">
            <span class="text-xs font-bold uppercase tracking-widest text-zinc-500"><%= t.footerLeft %></span>
            <span class="text-sm font-black text-white"><%= t.footerRight %> <span class="text-[var(--accent-color)]"><%= roster.length %></span></span>
        </div>
    </div>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
        let currentOpViewMode = localStorage.getItem('operator_view_mode') || 'grid';
        window.currentOpViewMode = currentOpViewMode;

        function updateOpViewButtons() {
            const btnGrid = document.getElementById('btn-op-grid');
            const btnCompact = document.getElementById('btn-op-compact');
            const btnMinimal = document.getElementById('btn-op-minimal');
            const switchboardGrid = document.getElementById('switchboardGrid');
            if (!btnGrid || !btnCompact || !btnMinimal || !switchboardGrid) return;

            btnGrid.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
            btnCompact.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
            btnMinimal.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]';

            switchboardGrid.classList.remove('view-mode-grid', 'view-mode-compact', 'view-mode-minimal');

            if (currentOpViewMode === 'minimal') {
                btnMinimal.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer btn-primary';
                switchboardGrid.classList.add('view-mode-minimal');
            } else if (currentOpViewMode === 'compact') {
                btnCompact.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer btn-primary';
                switchboardGrid.classList.add('view-mode-compact');
            } else {
                btnGrid.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer btn-primary';
                switchboardGrid.classList.add('view-mode-grid');
            }
        }
        window.updateOpViewButtons = updateOpViewButtons;

        window.setOperatorViewMode = function(mode) {
            currentOpViewMode = mode;
            window.currentOpViewMode = mode;
            localStorage.setItem('operator_view_mode', mode);
            updateOpViewButtons();
        };

        updateOpViewButtons();
            const clockEl = document.getElementById('digitalClock');
            if (clockEl) {
                setInterval(() => { clockEl.textContent = new Date().toTimeString().split(' ')[0]; }, 1000);
            }
            const socket = io();
            const labels = {
                incall: '<%= t.incall %>',
                ringing: '<%= t.ringing %>',
                idle: '<%= t.noCall %>',
                connected: '<%= t.connectedWith %>'
            };

            const localPeerStatus = {};
            const localCallStatus = {};

            // Initialize localPeerStatus from EJS rendering status
            <% roster.forEach(emp => { %>
                localPeerStatus['<%= emp.extension %>'] = <%= emp.online ? 'true' : 'false' %>;
            <% }) %>

            function formatDuration(startMs) {
                if (!startMs) return "00:00";
                const s = Math.floor((Date.now() - startMs) / 1000);
                if (s < 0) return "00:00";
                return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
            }

            setInterval(() => {
                document.querySelectorAll('[data-start]').forEach(card => {
                    const start = card.getAttribute('data-start');
                    if (start) {
                        const ext = card.id.replace('card-', '');
                        const el = document.getElementById('timer-' + ext);
                        if (el) el.textContent = formatDuration(parseInt(start));
                    }
                });
            }, 1000);

            function updateCardStateClass(extension, isOnline, callState) {
                const card = document.getElementById('card-' + extension);
                if (!card) return;
                
                card.classList.remove('state-offline', 'state-idle', 'state-ringing', 'state-incall');
                
                let stateClass = 'state-offline';
                if (isOnline) {
                    if (callState === 'In Call' || callState === 'incall') {
                        stateClass = 'state-incall';
                    } else if (callState === 'Ringing' || callState === 'ringing') {
                        stateClass = 'state-ringing';
                    } else {
                        stateClass = 'state-idle';
                    }
                }
                
                card.classList.add(stateClass);
            }

            socket.on('initialState', (calls) => {
                document.querySelectorAll('[id^="card-"]').forEach(card => {
                    const ext = card.id.replace('card-', '');
                    const callData = (calls && calls[ext]) ? calls[ext] : null;
                    localCallStatus[ext] = callData;
                    handleCallUpdate({ extension: ext, callData: callData });
                });
            });

            let rafPeerScheduled = false;
            socket.on('peerStatus', (statusMap) => {
                for (let ext in statusMap) {
                    localPeerStatus[ext] = statusMap[ext];
                }
                if (!rafPeerScheduled) {
                    rafPeerScheduled = true;
                    requestAnimationFrame(() => {
                        rafPeerScheduled = false;
                        for (let ext in localPeerStatus) {
                            const online = localPeerStatus[ext];
                            const label = document.getElementById('sipLabel-' + ext);
                            if (label) label.textContent = online ? '<%= t.online %>' : '<%= t.offline %>';
                            const callState = localCallStatus[ext]?.state || 'Idle';
                            updateCardStateClass(ext, online, callState);
                        }
                        if (window.refreshIntercomRosterIfOpen) window.refreshIntercomRosterIfOpen();
                    });
                }
            });

            let rafIPsScheduled = false;
            let pendingIPs = {};
            socket.on('peerIPs', (ipMap) => {
                Object.assign(pendingIPs, ipMap);
                if (!rafIPsScheduled) {
                    rafIPsScheduled = true;
                    requestAnimationFrame(() => {
                        rafIPsScheduled = false;
                        for (let ext in pendingIPs) {
                            const ipText = document.getElementById('ipText-' + ext);
                            const ipVal = pendingIPs[ext] || '';
                            if (ipText) {
                                ipText.textContent = ipVal;
                                ipText.title = ipVal;
                                if (ipVal) {
                                    ipText.classList.remove('hidden');
                                } else {
                                    ipText.classList.add('hidden');
                                }
                            }
                        }
                    });
                }
            });
            let localTrunksData = {};

            let rafTrunksScheduled = false;
            function scheduleRenderTrunksBoard() {
                if (!rafTrunksScheduled) {
                    rafTrunksScheduled = true;
                    requestAnimationFrame(() => {
                        rafTrunksScheduled = false;
                        renderTrunksBoard();
                    });
                }
            }

            socket.on('initialTrunks', (trunksMap) => {
                localTrunksData = trunksMap || {};
                scheduleRenderTrunksBoard();
            });

            socket.on('trunkStatus', (trunksMap) => {
                localTrunksData = trunksMap || {};
                scheduleRenderTrunksBoard();
            });

            socket.on('trunkCalls', (callsMap) => {
                for (let tid in callsMap) {
                    if (localTrunksData[tid]) {
                        localTrunksData[tid].activeCalls = callsMap[tid];
                    }
                }
                scheduleRenderTrunksBoard();
            });
            function renderTrunksBoard() {
                const grid = document.getElementById('trunksLiveGrid');
                const countEl = document.getElementById('trunksTotalCount');
                if (!grid) return;

                const trunkIds = Object.keys(localTrunksData);
                if (countEl) countEl.textContent = trunkIds.length;
                grid.innerHTML = '';

                if (trunkIds.length === 0) {
                    grid.innerHTML = `<div class="col-span-full py-4 text-center text-xs text-[var(--text-muted)] italic"><%= isRtl ? "لا توجد خطوط SIP أو IAX2 مهيأة." : "No SIP or IAX2 trunks configured." %></div>`;
                    return;
                }

                trunkIds.forEach(tid => {
                    const trunk = localTrunksData[tid];
                    const isOnline = trunk.online;
                    const activeCount = trunk.activeCalls || 0;
                    const channelIdUpper = String(trunk.channelid || '').toUpperCase();
                    let techDisplay = String(trunk.tech || '').toUpperCase();
                    if (channelIdUpper.startsWith('IAX2/') || channelIdUpper.startsWith('IAX/')) {
                        techDisplay = 'IAX2';
                    } else if (channelIdUpper.startsWith('SIP/') || channelIdUpper.startsWith('PJSIP/')) {
                        techDisplay = 'SIP';
                    }
                    let techBadgeClass = 'bg-slate-500/15 text-slate-300 border-slate-500/20';
                    if (techDisplay === 'SIP') techBadgeClass = 'bg-cyan-500/15 text-cyan-400 border-cyan-500/20';
                    else if (techDisplay === 'IAX2' || techDisplay === 'IAX') techBadgeClass = 'bg-purple-500/15 text-purple-400 border-purple-500/20';
                    const statusBadgeClass = isOnline
                        ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/20'
                        : 'bg-rose-500/15 text-rose-400 border-rose-500/20';

                    const statusDotClass = isOnline ? 'bg-emerald-400' : 'bg-rose-500';

                    const card = document.createElement('div');
                    card.className = 'panel-surface rounded-xl p-3.5 flex flex-col justify-between transition-all duration-200 hover:border-[var(--border-accent)]';
                    card.innerHTML = `
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full ${statusDotClass} shrink-0"></span>
                                    <h4 class="text-sm font-bold text-[var(--text-primary)] font-mono truncate">${escapeHtml(trunk.name)}</h4>
                                </div>
                                <span class="text-[10px] font-mono text-[var(--text-muted)] block truncate mt-0.5">${escapeHtml(trunk.channelid || trunk.host || '-')}</span>
                            </div>
                            <span class="px-2 py-0.5 text-[10px] font-extrabold rounded border ${techBadgeClass} shrink-0">${techDisplay}</span>
                        </div>
                        <div class="flex items-center justify-between mt-2 pt-2 border-t border-[var(--border-primary)] text-xs">
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded border ${statusBadgeClass}">${escapeHtml(trunk.statusText || (isOnline ? 'OK' : 'Offline'))}</span>
                            <span class="text-[11px] font-bold font-mono ${activeCount > 0 ? 'text-amber-400 animate-pulse' : 'text-[var(--text-muted)]'}">
                                ${activeCount > 0 ? `<span class="inline-block w-1.5 h-1.5 rounded-full bg-amber-400 mr-1"></span>${activeCount} Active` : '0 Active'}
                            </span>
                        </div>
                    `;
                    grid.appendChild(card);
                });
            }

            function escapeHtml(str) {
                if (str === null || str === undefined) return '';
                return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
            }
            // Auto-Dialer Live Lead Pop-Up
            let activeDialerPopData = null;
            socket.on('dialerLeadPop', (data) => {
                if (!data || !data.lead) return;
                activeDialerPopData = data;
                document.getElementById('dialerLeadName').textContent = (data.lead.first_name || '') + ' ' + (data.lead.last_name || data.lead.phone_number || '');
                document.getElementById('dialerLeadPhone').textContent = data.lead.phone_number || '';
                document.getElementById('dialerLeadCompany').textContent = data.lead.company || 'N/A';
                document.getElementById('dialerLeadModal').classList.remove('hidden');
            });

            window.submitLeadDisposition = async function(disposition) {
                if (!activeDialerPopData) return;
                const { attemptUuid, lead } = activeDialerPopData;
                try {
                    await fetch('/api/dialer/disposition', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            attemptUuid,
                            leadId: lead.id,
                            disposition,
                            agentExtension: activeDialerPopData.agentExtension || ''
                        })
                    });
                } catch (e) {}
                document.getElementById('dialerLeadModal').classList.add('hidden');
                activeDialerPopData = null;
            };

            function handleCallUpdate(data) {
                const { extension, callData } = data;
                localCallStatus[extension] = callData;
                if (window.refreshIntercomRosterIfOpen) window.refreshIntercomRosterIfOpen();
                const card = document.getElementById('card-' + extension);
                const badge = document.getElementById('badge-' + extension);
                const status = document.getElementById('status-' + extension);
                const partner = document.getElementById('partner-' + extension);
                const timer = document.getElementById('timer-' + extension);
                if (!card || !badge || !status || !partner || !timer) return;

                const isOnline = !!localPeerStatus[extension];
                const callState = callData?.state || 'Idle';
                updateCardStateClass(extension, isOnline, callState);

                const selectEl = document.getElementById('actionSelect-' + extension);

                if (callData) {
                    if (selectEl) selectEl.removeAttribute('disabled');
                    partner.textContent = callData.partner || '';
                    partner.setAttribute('title', callData.partner || '');
                    partner.classList.remove('hidden');

                    if (callData.state === 'In Call') {
                        if (!card.getAttribute('data-start')) {
                            card.setAttribute('data-start', Date.now());
                        }
                        status.textContent = labels.incall;
                        timer.textContent = formatDuration(parseInt(card.getAttribute('data-start')));
                        timer.classList.remove('hidden');
                    } else {
                        card.removeAttribute('data-start');
                        status.textContent = labels.ringing;
                        timer.classList.add('hidden');
                    }
                } else {
                    if (selectEl) selectEl.setAttribute('disabled', 'true');
                    card.removeAttribute('data-start');
                    status.textContent = labels.idle;
                    partner.classList.add('hidden');
                    timer.classList.add('hidden');
                }
            }

            function launchSipUrl(url) {
                var iframe = document.getElementById('sip-protocol-iframe');
                if (!iframe) {
                    iframe = document.createElement('iframe');
                    iframe.id = 'sip-protocol-iframe';
                    iframe.style.display = 'none';
                    document.body.appendChild(iframe);
                }
                iframe.src = url;

                var a = document.createElement('a');
                a.href = url;
                a.style.display = 'none';
                document.body.appendChild(a);
                a.click();
                setTimeout(function() { if (a.parentNode) a.remove(); }, 500);
            }

            window.handleSelectAction = function(extension, action) {
                if (!action) return;
                var card = document.querySelector('[data-ext="' + extension + '"]') || document.querySelector('[data-extension="' + extension + '"]');
                if (card && typeof anime !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    anime({
                        targets: card,
                        scale: [0.96, 1.02, 1],
                        duration: 350,
                        easing: 'easeOutElastic(1, .7)'
                    });
                }

                if (action === 'listen') {
                    launchSipUrl('sip:222' + extension);
                } else if (action === 'whisper') {
                    launchSipUrl('sip:223' + extension);
                } else if (action === 'barge') {
                    launchSipUrl('sip:224' + extension);
                } else if (action === 'hijack') {
                    launchSipUrl('sip:225' + extension);
                } else if (action === 'hangup') {
                    if (confirm('<%= isRtl ? "هل أنت متأكد من إنهاء المكالمة؟" : "Are you sure you want to end this call?" %>')) {
                        fetch('/api/hangup/' + extension, { method: 'POST' })
                            .then(res => res.json())
                            .then(data => {
                                if (!data.success) {
                                    alert('Error ending call: ' + (data.error || 'Unknown error'));
                                }
                            })
                            .catch(err => {
                                alert('Network error: ' + err.message);
                            });
                    }
                }
            };

            socket.on('callUpdate', handleCallUpdate);
        });
    </script>
    <script>
        // Live Panel: drag & drop extension cards to reorder them or move them between groups.
        // The arrangement is persisted locally per browser (localStorage) — no server-side changes.
        (function () {
            const LAYOUT_KEY = 'operator_panel_layout_v1';
            const gridRoot = document.getElementById('switchboardGrid');
            if (!gridRoot) return;

            const allCards = Array.from(gridRoot.querySelectorAll('article[id^="card-"]'));
            if (!allCards.length) return;

            let draggedCard = null;

            function extOf(card) { return card.id.replace(/^card-/, ''); }

            function loadLayout() {
                try {
                    const parsed = JSON.parse(localStorage.getItem(LAYOUT_KEY));
                    return (parsed && typeof parsed === 'object' && parsed.groups && typeof parsed.groups === 'object') ? parsed : null;
                } catch (_) { return null; }
            }

            function saveLayout() {
                // Only the ORDER of cards within their own group is stored locally.
                // Group membership is authoritative on the server (employee_extras.emp_group).
                const groups = {};
                gridRoot.querySelectorAll('section[data-group]').forEach(section => {
                    groups[section.dataset.group] = Array.from(
                        section.querySelectorAll('.extension-group-grid > article[id^="card-"]')
                    )
                        .filter(card => section.dataset.group === '___ungrouped___'
                            ? !(card.dataset.empGroup || '')
                            : card.dataset.empGroup === section.dataset.group)
                        .map(extOf);
                });
                try { localStorage.setItem(LAYOUT_KEY, JSON.stringify({ v: 1, groups })); } catch (_) {}
            }

            function updateGroupCounts() {
                gridRoot.querySelectorAll('section[data-group]').forEach(section => {
                    const count = section.querySelectorAll('.extension-group-grid > article[id^="card-"]').length;
                    section.querySelectorAll('.employee-group-count').forEach(el => { el.textContent = count; });
                });
            }

            const UNGROUPED_KEY = '___ungrouped___';

            // Push cross-group moves to the server so the employee group in PBX
            // extension configuration matches the Live Panel arrangement.
            function syncGroupAssignments() {
                const jobs = [];
                gridRoot.querySelectorAll('article[id^="card-"]').forEach(card => {
                    const section = card.closest('section[data-group]');
                    if (!section) return;
                    const target = section.dataset.group === UNGROUPED_KEY ? '' : section.dataset.group;
                    if ((card.dataset.empGroup || '') === target) return;
                    jobs.push({ card, target, previous: card.dataset.empGroup || '' });
                });

                if (!jobs.length) { saveLayout(); return; }

                const ungroupedLabel = '<%= t.ungrouped %>';
                let pending = jobs.length;
                let failures = 0;

                jobs.forEach(job => {
                    // Optimistic UI — chip follows the drop immediately
                    job.card.querySelector('.employee-group-chip').textContent = job.target || ungroupedLabel;
                    fetch('/api/employee/group-assignment', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ extension: extOf(job.card), group: job.target })
                    })
                        .then(response => response.json().then(data => ({ ok: response.ok, data })))
                        .then(({ ok, data }) => {
                            if (!ok || !data.success) throw new Error(data.error || 'Failed to assign group');
                            job.card.dataset.empGroup = job.target;
                        })
                        .catch(() => {
                            failures++;
                            // Roll back optimistic label; the card returns to its server
                            // group on next reload since layout storage keeps same-group order only.
                            job.card.querySelector('.employee-group-chip').textContent = job.previous || ungroupedLabel;
                        })
                        .finally(() => {
                            if (--pending === 0) {
                                saveLayout();
                                if (failures) {
                                    alert((document.documentElement.dir === 'rtl'
                                        ? 'تعذر حفظ المجموعة لـ '
                                        : 'Could not save the group assignment for ')
                                        + failures + (document.documentElement.dir === 'rtl' ? ' تحويلة.' : ' extension(s).'));
                                }
                            }
                        });
                });
            }

            function applySavedLayout() {
                const saved = loadLayout();
                if (!saved || !saved.groups) return;
                const sections = Array.from(gridRoot.querySelectorAll('section[data-group]'));
                if (!sections.length) return;
                const grids = new Map(sections.map(s => [s.dataset.group, s.querySelector('.extension-group-grid')]));

                const originalGridOf = new Map();
                allCards.forEach(card => {
                    const section = card.closest('section[data-group]');
                    originalGridOf.set(card, section ? grids.get(section.dataset.group) : null);
                });

                allCards.forEach(card => card.remove());

                const placed = new Set();
                sections.forEach(section => {
                    const grid = grids.get(section.dataset.group);
                    if (!grid) return;
                    // Layout storage only orders cards inside their own server-side group
                    const wanted = saved.groups[section.dataset.group];
                    if (Array.isArray(wanted)) {
                        wanted.forEach(ext => {
                            const card = allCards.find(c => c.id === 'card-' + String(ext));
                            if (!card || placed.has(card)) return;
                            const homeKey = (card.dataset.empGroup || '') === '' ? UNGROUPED_KEY : card.dataset.empGroup;
                            if (homeKey !== section.dataset.group) return;
                            grid.appendChild(card);
                            placed.add(card);
                        });
                    }
                });

                allCards.forEach(card => {
                    if (!placed.has(card)) {
                        const grid = originalGridOf.get(card);
                        if (grid) grid.appendChild(card);
                    }
                });
            }

            function setDraggable(card, enabled) {
                if (enabled) card.setAttribute('draggable', 'true');
                else card.removeAttribute('draggable');
            }

            // Only allow starting a drag from the card surface itself,
            // never from interactive controls inside the card.
            gridRoot.addEventListener('pointerdown', e => {
                if (e.button !== 0 || !e.target.closest) return;
                const card = e.target.closest('article[id^="card-"]');
                if (!card || !gridRoot.contains(card)) return;
                if (e.target.closest('select, option, button, input, textarea, a, label')) return;
                setDraggable(card, true);
            }, true);

            document.addEventListener('pointerup', () => {
                gridRoot.querySelectorAll('article[id^="card-"][draggable]').forEach(card => setDraggable(card, false));
            }, true);

            gridRoot.addEventListener('dragstart', e => {
                const card = e.target.closest && e.target.closest('article[id^="card-"]');
                if (!card) return;
                draggedCard = card;
                card.classList.add('dnd-dragging');
                gridRoot.classList.add('dnd-active');
                if (e.dataTransfer) {
                    e.dataTransfer.effectAllowed = 'move';
                    try { e.dataTransfer.setData('text/plain', extOf(card)); } catch (_) {}
                }
            });

            function insertionBoundary(grid, x, y) {
                let closest = null;
                let closestDist = Infinity;
                grid.querySelectorAll('article[id^="card-"]').forEach(card => {
                    if (card === draggedCard) return;
                    const box = card.getBoundingClientRect();
                    const dx = x - (box.left + box.width / 2);
                    const dy = y - (box.top + box.height / 2);
                    const dist = Math.hypot(dx, dy);
                    if (dist < closestDist) { closest = { card, dx, dy }; closestDist = dist; }
                });
                if (!closest) return null;
                const rtl = document.documentElement.dir === 'rtl';
                const insertBefore = Math.abs(closest.dy) > Math.abs(closest.dx)
                    ? closest.dy < 0
                    : (rtl ? closest.dx > 0 : closest.dx < 0);
                return insertBefore ? closest.card : closest.card.nextSibling;
            }

            // Insertion jobs are batched to one per animation frame and flip-suppressed:
            // when the cursor rests near an unstable boundary (e.g. swapping with a
            // corner card), consecutive dragover events would otherwise alternate the
            // insertion point several times per second, which reads as visual flicker.
            const FLIP_SUPPRESS_MS = 90;
            const FLIP_TRAVEL_PX = 6;
            let pendingDropJob = null;
            let dropRafId = null;
            let lastAppliedSlot = { key: '', at: 0, x: 0, y: 0 };

            function applyDropJob() {
                dropRafId = null;
                const job = pendingDropJob;
                pendingDropJob = null;
                if (!job || !draggedCard) return;

                const boundary = insertionBoundary(job.grid, job.x, job.y);
                if (!draggedCard || boundary === draggedCard) return;

                // Skip when the card already occupies the exact target slot (no-op move)
                if (draggedCard.parentElement === job.grid &&
                    (boundary === draggedCard.nextSibling || (!boundary && !draggedCard.nextSibling))) {
                    lastAppliedSlot.at = performance.now();
                    lastAppliedSlot.x = job.x;
                    lastAppliedSlot.y = job.y;
                    return;
                }

                const key = (boundary ? boundary.id : 'end') + ':' + Array.prototype.indexOf.call(job.grid.children, boundary);
                const now = performance.now();
                const traveled = Math.hypot(job.x - lastAppliedSlot.x, job.y - lastAppliedSlot.y);
                const suppress = key !== lastAppliedSlot.key &&
                    (now - lastAppliedSlot.at) < FLIP_SUPPRESS_MS &&
                    traveled < FLIP_TRAVEL_PX;
                if (suppress) {
                    pendingDropJob = job;
                    if (!dropRafId) dropRafId = requestAnimationFrame(applyDropJob);
                    return;
                }
                lastAppliedSlot = { key, at: now, x: job.x, y: job.y };

                if (boundary) job.grid.insertBefore(draggedCard, boundary);
                else job.grid.appendChild(draggedCard);
            }

            gridRoot.querySelectorAll('.extension-group-grid').forEach(grid => {
                grid.addEventListener('dragover', e => {
                    if (!draggedCard) return;
                    e.preventDefault();
                    if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';
                    grid.classList.add('dnd-drop-hover');
                    pendingDropJob = { grid, x: e.clientX, y: e.clientY };
                    if (!dropRafId) dropRafId = requestAnimationFrame(applyDropJob);
                });
                grid.addEventListener('dragleave', e => {
                    if (!grid.contains(e.relatedTarget)) grid.classList.remove('dnd-drop-hover');
                });
                grid.addEventListener('drop', e => {
                    e.preventDefault();
                    grid.classList.remove('dnd-drop-hover');
                });
            });

            gridRoot.addEventListener('dragend', () => {
                if (!draggedCard) return;
                draggedCard.classList.remove('dnd-dragging');
                setDraggable(draggedCard, false);
                draggedCard = null;
                if (dropRafId) { cancelAnimationFrame(dropRafId); dropRafId = null; }
                pendingDropJob = null;
                lastAppliedSlot = { key: '', at: 0, x: 0, y: 0 };
                gridRoot.classList.remove('dnd-active');
                gridRoot.querySelectorAll('.dnd-drop-hover').forEach(el => el.classList.remove('dnd-drop-hover'));
                updateGroupCounts();
                syncGroupAssignments();
            });

            applySavedLayout();
            updateGroupCounts();
        })();
    </script>
    <script>
        var isRtl = <%= isRtl %>;

        function openGroupManager() {
            document.getElementById('groupManagerModal').classList.remove('hidden');
            loadGroupsList();
        }

        function closeGroupManager() {
            document.getElementById('groupManagerModal').classList.add('hidden');
        }

        function loadGroupsList() {
            fetch('/api/employee/groups')
                .then(response => response.json().then(data => ({ response, data })))
                .then(({ response, data }) => {
                    if (!response.ok || !data.success) throw new Error(data.error || 'Failed to load employee groups');
                    const list = document.getElementById('groupsList');
                    list.className = 'space-y-2 max-h-60 overflow-y-auto';
                    list.replaceChildren();
                    if (!data.groups.length) {
                        const empty = document.createElement('div');
                        empty.className = 'text-center text-[var(--text-muted)] text-sm py-5';
                        empty.textContent = '<%= t.noGroups %>';
                        list.appendChild(empty);
                        return;
                    }

                    data.groups.forEach(group => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between gap-3 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-3 py-2';
                        const name = document.createElement('span');
                        name.className = 'text-sm font-bold min-w-0 truncate';
                        name.textContent = group.name;
                        const remove = document.createElement('button');
                        remove.type = 'button';
                        remove.className = 'text-red-500 hover:text-red-400 cursor-pointer p-1 rounded focus:outline-none focus:ring-2 focus:ring-red-500/40';
                        remove.setAttribute('aria-label', '<%= t.deleteGroup %> ' + group.name);
                        remove.innerHTML = '<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>';
                        remove.addEventListener('click', () => deleteGroup(group.id, group.name));
                        row.append(name, remove);
                        list.appendChild(row);
                    });
                })
                .catch(error => {
                    const list = document.getElementById('groupsList');
                    list.className = 'space-y-2 max-h-60 overflow-y-auto';
                    const errorState = document.createElement('div');
                    errorState.className = 'text-center text-red-400 text-sm py-5';
                    errorState.textContent = error.message;
                    list.replaceChildren(errorState);
                });
        }

        function addGroup(event) {
            event.preventDefault();
            const input = document.getElementById('newGroupName');
            const button = document.getElementById('addGroupButton');
            const name = input.value.trim();
            if (!name) return;
            button.disabled = true;

            fetch('/api/employee/groups', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            })
                .then(response => response.json().then(data => ({ response, data })))
                .then(({ response, data }) => {
                    if (!response.ok || !data.success) throw new Error(data.error || 'Failed to create group');
                    input.value = '';
                    loadGroupsList();
                })
                .catch(error => alert(error.message))
                .finally(() => { button.disabled = false; });
        }

        function deleteGroup(id, name) {
            if (!confirm((isRtl ? 'حذف المجموعة ' : 'Delete group ') + name + '?')) return;
            fetch('/api/employee/groups/' + id, { method: 'DELETE' })
                .then(response => response.json().then(data => ({ response, data })))
                .then(({ response, data }) => {
                    if (!response.ok || !data.success) throw new Error(data.error || 'Failed to delete group');
                    window.location.reload();
                })
                .catch(error => alert(error.message));
        }
    </script>


                <button onclick="submitLeadDisposition('Add to DNC')" class="w-full mt-2 px-3 py-2 text-xs font-bold bg-rose-900/60 hover:bg-rose-800 text-rose-300 rounded-lg border border-rose-700/50 cursor-pointer">Add to DNC (Block)</button>
            </div>
        </div>
    </div>
    <div id="groupManagerModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full p-6 text-[var(--text-primary)]">
            <div class="flex items-center justify-between mb-2">
                <h3 class="text-base font-extrabold"><%= t.manageGroups %></h3>
                <button type="button" onclick="closeGroupManager()" aria-label="<%= t.close %>" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer p-1">&#10005;</button>
            </div>
            <p class="text-xs text-[var(--text-muted)] mb-5"><%= t.groupHelp %></p>

            <form id="groupForm" onsubmit="addGroup(event)" class="flex gap-2 mb-4">
                <label for="newGroupName" class="sr-only"><%= t.groupName %></label>
                <input type="text" id="newGroupName" maxlength="100" required placeholder="<%= t.groupName %>" class="config-input flex-1 text-sm min-w-0">
                <button id="addGroupButton" type="submit" class="config-btn-primary px-3 py-2 text-xs cursor-pointer whitespace-nowrap disabled:opacity-50">
                    <%= t.addGroup %>
                </button>
            </form>

            <div id="groupsList" class="space-y-2 max-h-60 overflow-y-auto">
                <div class="text-center text-[var(--text-muted)] text-sm py-4"><%= isRtl ? 'جاري التحميل...' : 'Loading...' %></div>
            </div>
        </div>
    </div>
    <!-- Intercom Instant Meeting Modal -->
    <div id="intercomModal" class="fixed inset-0 bg-black/70 backdrop-blur-md z-50 flex items-center justify-center hidden p-4">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-xl w-full p-6 text-[var(--text-primary)] animate-fade-in flex flex-col max-h-[90vh]">
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.684A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.316z"/></svg>
                    </span>
                    <div>
                        <h3 class="text-base font-extrabold text-white"><%= t.intercomModalTitle %></h3>
                        <p class="text-xs text-[var(--text-muted)]"><%= t.intercomDesc %></p>
                    </div>
                </div>
                <button type="button" onclick="closeIntercomModal()" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 cursor-pointer">&#10005;</button>
            </div>

            <!-- Host Extension Selector -->
            <div class="mb-4 bg-[var(--bg-card)] p-3 rounded-xl border border-[var(--border-primary)] flex items-center justify-between gap-3">
                <label for="intercomCallerSelect" class="text-xs font-bold text-slate-300 shrink-0 flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <%= t.hostExt %>
                </label>
                <select id="intercomCallerSelect" onchange="onIntercomHostChange()" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg text-xs font-bold px-3 py-1.5 text-[var(--text-primary)] focus:outline-none focus:border-emerald-500 flex-1 max-w-[220px]">
                    <% roster.forEach(emp => { %>
                        <option value="<%= emp.extension %>"><%= emp.name %> (<%= emp.extension %>)</option>
                    <% }) %>
                </select>
            </div>

            <!-- Filter and Select All Bar -->
            <div class="flex items-center justify-between gap-3 mb-3">
                <div class="relative flex-1">
                    <input type="text" id="intercomSearch" oninput="filterIntercomList()" placeholder="<%= t.searchPlaceholder %>" class="w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-3 py-1.5 text-xs text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500">
                </div>
                <label class="flex items-center gap-2 cursor-pointer bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-3 py-1.5 hover:border-emerald-500/50 transition">
                    <input type="checkbox" id="intercomSelectAll" onchange="toggleSelectAllIntercom(this.checked)" class="rounded border-zinc-700 text-emerald-500 focus:ring-emerald-500 bg-zinc-800">
                    <span class="text-xs font-extrabold text-slate-200 whitespace-nowrap"><%= t.selectAllAvailable %></span>
                </label>
            </div>

            <!-- Extension List Roster -->
            <div id="intercomRosterList" class="flex-1 overflow-y-auto space-y-1.5 pr-1 my-1 max-h-[340px]">
                <!-- Populated dynamically via JS -->
            </div>

            <!-- Modal Footer -->
            <div class="border-t border-[var(--border-primary)] pt-4 mt-3 flex items-center justify-between gap-3">
                <span id="intercomSelectionStatus" class="text-xs font-bold text-emerald-400">0 selected</span>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="closeIntercomModal()" class="px-4 py-2 text-xs font-bold text-slate-300 hover:text-white bg-zinc-800 hover:bg-zinc-700 rounded-xl transition cursor-pointer"><%= t.close %></button>
                    <button type="button" id="startIntercomBtn" onclick="submitIntercomCall()" class="px-5 py-2 text-xs font-extrabold text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl transition flex items-center gap-2 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1.1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <span id="startIntercomBtnText"><%= t.startIntercom %></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script>
        (function() {
            const rosterData = <%- JSON.stringify(roster) %>;
            let intercomSelectedMap = {};

            window.openIntercomModal = function() {
                const modal = document.getElementById('intercomModal');
                if (!modal) return;
                modal.classList.remove('hidden');

                const hostSelect = document.getElementById('intercomCallerSelect');
                const hostExt = hostSelect ? hostSelect.value : (rosterData[0] ? rosterData[0].extension : '');
                
                rosterData.forEach(emp => {
                    if (emp.extension === hostExt) return;
                    const isOnline = (typeof localPeerStatus !== 'undefined' && localPeerStatus[emp.extension] === true) || emp.online;
                    const callState = (typeof localCallStatus !== 'undefined' && localCallStatus[emp.extension]) ? localCallStatus[emp.extension].state : null;
                    const isBusy = callState === 'In Call' || callState === 'incall' || callState === 'Ringing' || callState === 'ringing';
                    if (isOnline && !isBusy) {
                        intercomSelectedMap[emp.extension] = true;
                    } else {
                        intercomSelectedMap[emp.extension] = false;
                    }
                });

                renderIntercomRoster();
            };

            window.closeIntercomModal = function() {
                const modal = document.getElementById('intercomModal');
                if (modal) modal.classList.add('hidden');
            };

            window.onIntercomHostChange = function() {
                renderIntercomRoster();
            };

            window.filterIntercomList = function() {
                renderIntercomRoster();
            };

            window.toggleSelectAllIntercom = function(selectAll) {
                const hostSelect = document.getElementById('intercomCallerSelect');
                const hostExt = hostSelect ? hostSelect.value : '';
                const query = (document.getElementById('intercomSearch')?.value || '').toLowerCase().trim();

                rosterData.forEach(emp => {
                    if (emp.extension === hostExt) return;
                    const matchesSearch = !query || emp.extension.toLowerCase().includes(query) || (emp.name || '').toLowerCase().includes(query);
                    if (!matchesSearch) return;

                    const isOnline = (typeof localPeerStatus !== 'undefined' && localPeerStatus[emp.extension] === true) || emp.online;
                    const callState = (typeof localCallStatus !== 'undefined' && localCallStatus[emp.extension]) ? localCallStatus[emp.extension].state : null;
                    const isBusy = callState === 'In Call' || callState === 'incall' || callState === 'Ringing' || callState === 'ringing';

                    if (isOnline && !isBusy) {
                        intercomSelectedMap[emp.extension] = selectAll;
                    }
                });
                renderIntercomRoster();
            };

            window.toggleIntercomExtension = function(ext, checked) {
                intercomSelectedMap[ext] = checked;
                updateIntercomFooter();
            };

            function updateIntercomFooter() {
                const hostSelect = document.getElementById('intercomCallerSelect');
                const hostExt = hostSelect ? hostSelect.value : '';
                const selectedCount = Object.keys(intercomSelectedMap).filter(ext => intercomSelectedMap[ext] && ext !== hostExt).length;
                const statusEl = document.getElementById('intercomSelectionStatus');
                const btn = document.getElementById('startIntercomBtn');
                const btnText = document.getElementById('startIntercomBtnText');

                if (statusEl) {
                    statusEl.textContent = selectedCount + ' ' + (isRtl ? 'تحويلة محددة' : 'extension(s) selected');
                }
                if (btn) {
                    btn.disabled = selectedCount === 0;
                }
                if (btnText) {
                    btnText.textContent = (isRtl ? 'بدء المكالمة (' : 'Start Intercom (') + selectedCount + ')';
                }
            }

            function renderIntercomRoster() {
                const listEl = document.getElementById('intercomRosterList');
                if (!listEl) return;
                const hostSelect = document.getElementById('intercomCallerSelect');
                const hostExt = hostSelect ? hostSelect.value : '';
                const query = (document.getElementById('intercomSearch')?.value || '').toLowerCase().trim();

                let availableCount = 0;
                let selectedAvailableCount = 0;

                listEl.replaceChildren();

                rosterData.forEach(emp => {
                    if (emp.extension === hostExt) return;

                    const matchesSearch = !query || emp.extension.toLowerCase().includes(query) || (emp.name || '').toLowerCase().includes(query);
                    if (!matchesSearch) return;

                    const isOnline = (typeof localPeerStatus !== 'undefined' && localPeerStatus[emp.extension] === true) || emp.online;
                    const callState = (typeof localCallStatus !== 'undefined' && localCallStatus[emp.extension]) ? localCallStatus[emp.extension].state : null;
                    const isBusy = callState === 'In Call' || callState === 'incall' || callState === 'Ringing' || callState === 'ringing';

                    const isAvailable = isOnline && !isBusy;
                    if (isAvailable) availableCount++;

                    const isChecked = Boolean(intercomSelectedMap[emp.extension]) && isAvailable;
                    if (isChecked) selectedAvailableCount++;

                    const item = document.createElement('div');
                    item.className = 'flex items-center justify-between p-2.5 rounded-xl border transition-all ' + 
                        (isAvailable 
                            ? (isChecked ? 'bg-emerald-950/40 border-emerald-500/50 text-white' : 'bg-[#18181b] border-[#27272a] hover:border-zinc-700 text-slate-200')
                            : 'bg-zinc-900/60 border-zinc-900 opacity-60 text-zinc-500 cursor-not-allowed');

                    let badgeHtml = '';
                    if (!isOnline) {
                        badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-zinc-800 text-zinc-400 border border-zinc-700">' + (isRtl ? 'غير متصل' : 'Offline') + '</span>';
                    } else if (callState === 'In Call' || callState === 'incall') {
                        badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800">' + (isRtl ? 'في مكالمة' : 'In Call') + '</span>';
                    } else if (callState === 'Ringing' || callState === 'ringing') {
                        badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-purple-950 text-purple-400 border border-purple-800">' + (isRtl ? 'يرن' : 'Ringing') + '</span>';
                    } else {
                        badgeHtml = '<span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-950 text-amber-300 border border-amber-800/60">' + (isRtl ? 'متاح' : 'Available') + '</span>';
                    }

                    item.innerHTML = `
                        <div class="flex items-center gap-3 min-w-0 flex-1">
                            <input type="checkbox" id="intercom_chk_${emp.extension}" name="intercom_extension" aria-label="Select extension ${emp.extension}" ${isChecked ? 'checked' : ''} ${isAvailable ? '' : 'disabled'} onchange="toggleIntercomExtension('${emp.extension}', this.checked)" class="rounded border-zinc-700 text-emerald-500 focus:ring-emerald-500 bg-zinc-800 disabled:opacity-40 cursor-pointer">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-bold truncate ${isAvailable ? 'text-white' : 'text-zinc-400'}">${emp.name}</span>
                                    <span class="text-[11px] font-mono font-black text-amber-400">#${emp.extension}</span>
                                </div>
                            </div>
                        </div>
                        <div class="shrink-0">
                            ${badgeHtml}
                        </div>
                    `;
                    listEl.appendChild(item);
                });

                const selectAllCb = document.getElementById('intercomSelectAll');
                if (selectAllCb) {
                    selectAllCb.checked = availableCount > 0 && selectedAvailableCount === availableCount;
                }
                updateIntercomFooter();
            }

            window.submitIntercomCall = function() {
                const hostSelect = document.getElementById('intercomCallerSelect');
                const hostExt = hostSelect ? hostSelect.value : '';
                const targetExtensions = Object.keys(intercomSelectedMap).filter(ext => intercomSelectedMap[ext] && ext !== hostExt);
                const btn = document.getElementById('startIntercomBtn');

                if (!hostExt) {
                    alert(isRtl ? 'يرجى تحديد تحويلة المتصل' : 'Please select host extension');
                    return;
                }
                if (targetExtensions.length === 0) {
                    alert(isRtl ? 'يرجى تحديد تحويلة واحدة على الأقل' : 'Please select at least one target extension');
                    return;
                }

                btn.disabled = true;
                btn.innerHTML = `
                    <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>${isRtl ? 'جاري الاتصال...' : 'Calling...'}</span>
                `;

                fetch('/api/intercom/call', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ callerExtension: hostExt, targetExtensions })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        closeIntercomModal();
                        alert(isRtl ? `تم بدء اجتماع الإنتركم في الغرفة ${data.roomId} مع ${data.invitedCount} تحويلة.` : `Intercom meeting started in room ${data.roomId} with ${data.invitedCount} extension(s).`);
                    } else {
                        alert('Error: ' + (data.error || 'Failed to start intercom call'));
                    }
                })
                .catch(err => {
                    alert('Network Error: ' + err.message);
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = `
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1.1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <span id="startIntercomBtnText">${isRtl ? 'بدء المكالمة' : 'Start Intercom'}</span>
                    `;
                    updateIntercomFooter();
                });
            };

            window.refreshIntercomRosterIfOpen = function() {
                const modal = document.getElementById('intercomModal');
                if (modal && !modal.classList.contains('hidden')) {
                    renderIntercomRoster();
                }
            };
        })();
    </script>
</body>
</html>

<%
const words = {
    en: {
        title: "Employees", subtitle: "",
        desc: "Per-extension analytics and consolidated employee metrics",
        startTime: "Start Time", endTime: "End Time",
        direction: "Direction", allDir: "All", inbound: "Inbound", outbound: "Outbound",
        apply: "Apply Filters",
        selectExt: "Select an extension from the list",
        totalCalls: "Total Calls", answered: "Answered", answerRate: "Answer Rate",
        uniqueContacts: "Unique Contacts", avgTalk: "Avg Talk Time",
        inboundLabel: "Inbound", outboundLabel: "Outbound",
        talkTime: "Talk Time", sec: "s", min: "min",
        disposition: "Call Disposition", daily: "Daily Call Volume",
        hourly: "Peak Hours Distribution", duration: "Call Duration Breakdown", exportPdf: "Save PDF",
        recentCalls: "Recent Calls", noData: "No data found",
        src: "Source", dst: "Destination", duration: "Duration", status: "Status",
        footerLeft: "Agent Analytics Engine", footerRight: "Monitored Extensions:",
        extList: "Extensions",
        overview: "Overview",
        employee: "Employee",
        inboundDuration: "Inbound Dur.",
        outboundDuration: "Outbound Dur.",
        totalDuration: "Total Talk Time",
        online: "Online",
        offline: "Offline",
        agentStatus: "Agent Status",
        interactiveTable: "Click a row to inspect an extension."
    },
    ar: {
        title: "الموظفين", subtitle: "",
        desc: "تحليلات شاملة لكل وكيل مع مقاييس أداء الموظفين المدمجة",
        startTime: "وقت البداية", endTime: "وقت النهاية",
        direction: "الاتجاه", allDir: "الكل", inbound: "وارد", outbound: "صادر",
        apply: "تطبيق الفلتر",
        selectExt: "اختر وكيل من القائمة",
        totalCalls: "إجمالي المكالمات", answered: "تم الرد", answerRate: "نسبة الرد",
        uniqueContacts: "جهات اتصال فريدة", avgTalk: "متوسط وقت التحدث",
        inboundLabel: "وارد", outboundLabel: "صادر",
        talkTime: "وقت التحدث", sec: "ث", min: "د",
        disposition: "حالة المكالمة", daily: "حجم المكالمات اليومي",
        hourly: "توزيع المكالمات بالساعات", duration: "تصنيف مدة المكالمات", exportPdf: "حفظ PDF",
        recentCalls: "آخر المكالمات", noData: "لا توجد بيانات",
        src: "المصدر", dst: "الوجهة", duration: "المدة", status: "الحالة",
        footerLeft: "محرك تحليلات الوكلاء", footerRight: "الوكلاء المراقبة:",
        extList: "قائمة الوكلاء",
        overview: "نظرة عامة على المقاييس",
        employee: "الموظف",
        inboundDuration: "مدة الوارد",
        outboundDuration: "مدة الصادر",
        totalDuration: "إجمالي وقت التحدث",
        online: "متصل",
        offline: "غير متصل",
        agentStatus: "حالة الوكيل",
        interactiveTable: "جدول ملخص أداء الموظفين (انقر فوق أي صف لعرض التحليلات العميقة)"
    }
};
const t = words[currentLang];
const isRtl = currentLang === 'ar';
%>
<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <!-- Prevent theme flickering -->
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - Agent Stats</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #121212;
            --bg-card: #18181b;
            --bg-hover: #27272a;
            --border-primary: #27272a;
            --border-accent: #3f3f46;
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent-color: var(--accent-color);
            --accent-hover: var(--accent-hover);
            --status-online: var(--accent-color);
            --status-offline: #71717a;
            --status-active: var(--accent-color);
        }
        body { 
            background-color: var(--bg-primary); 
            font-family: 'Roboto', 'IBM Plex Sans Arabic', sans-serif; 
            color: var(--text-primary); 
        }
        /* Modern background pattern with subtle gradients */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 10% 20%, rgba(255, 59, 48, 0.06) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.02) 0%, transparent 45%);
            pointer-events: none;
            z-index: -1;
        }
        .panel-surface { 
            background-color: var(--bg-secondary); 
            border: 1px solid var(--border-primary); 
        }
        .accent-orange { color: var(--accent-color); }
        .font-vibrant-display { font-weight: 900; letter-spacing: -0.01em; }
        
        .card-stat { 
            transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1),
                        border-color 150ms ease; 
        }
        .card-stat:hover { 
            transform: translateY(-1px);
            border-color: var(--border-accent); 
        }
        .ext-card {
            transition: all 150ms ease;
            cursor: pointer;
        }
        .ext-card:hover {
            background-color: var(--bg-hover);
            border-color: var(--border-accent);
        }
        .ext-card.active {
            background-color: #27272a;
            border-color: var(--accent-color);
        }
        input, select, button { 
            transition: all 150ms ease; 
        }

        @media print {
            html, body {
                background-color: #ffffff !important;
                color: #0f172a !important;
                padding: 0 !important;
                margin: 0 !important;
                height: auto !important;
                min-height: 0 !important;
                max-height: none !important;
                overflow: visible !important;
            }
            body > *:not(#mainContentWrapper) {
                display: none !important;
            }
            #mainContentWrapper {
                display: block !important;
                padding: 0.25in !important;
                margin: 0 !important;
                width: 100% !important;
                height: auto !important;
                overflow: visible !important;
            }
            #mainContentWrapper > div.mb-6,
            #mainContentWrapper > form#filterForm,
            #extListCol,
            .app-sidebar, #sidebarOverlay, .mobile-topbar, #overviewHeaderBtn, #exportPdfBtn, .no-print {
                display: none !important;
                height: 0 !important;
                width: 0 !important;
                margin: 0 !important;
                padding: 0 !important;
                border: none !important;
                visibility: hidden !important;
            }
            #mainContentWrapper > div.flex {
                display: block !important;
                padding: 0 !important;
                margin: 0 !important;
                width: 100% !important;
                height: auto !important;
                overflow: visible !important;
            }
            .print-header-banner {
                display: flex !important;
                border-bottom: 2px solid #cbd5e1 !important;
                padding-bottom: 0.75rem !important;
                margin-bottom: 1.25rem !important;
                page-break-before: avoid !important;
                break-before: avoid !important;
                break-after: avoid !important;
            }
            #detailPanel {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                margin: 0 !important;
                background: transparent !important;
                overflow: visible !important;
                width: 100% !important;
                display: block !important;
                page-break-before: avoid !important;
                break-before: avoid !important;
            }
            #detailPanel div,
            #detailPanel form,
            #detailPanel section {
                display: block !important;
                flex: none !important;
                float: none !important;
                position: static !important;
                height: auto !important;
                min-height: 0 !important;
                max-height: none !important;
            }
            .panel-surface {
                background-color: #ffffff !important;
                border: 1px solid #e2e8f0 !important;
                color: #0f172a !important;
                box-shadow: none !important;
                break-inside: avoid !important;
                page-break-inside: avoid !important;
                margin-bottom: 1rem !important;
            }
            .text-white, .text-zinc-300, .text-zinc-400 {
                color: #0f172a !important;
            }
            .grid {
                display: grid !important;
                grid-template-columns: 1fr !important;
                gap: 1.5rem !important;
            }
            /* Hide canvas during print and display static high-DPI chart images */
            #dispositionChart canvas, #dailyChart canvas, #hourlyChart canvas, #durationChart canvas {
                display: none !important;
            }
            .print-chart-img {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                height: auto !important;
                object-fit: contain !important;
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            margin: 0 auto !important;
            }
            #dispositionChart, #dailyChart, #hourlyChart, #durationChart {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
                height: auto !important;
                min-height: 0 !important;
            }
            /* Prevent tables and table rows from being split across page breaks */
            table, tr, tbody, thead {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            }
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <div id="mainContentWrapper" class="flex-1 p-5 md:p-6 flex flex-col min-h-0">
        
        <div class="mb-3 shrink-0 flex items-center justify-between <%= isRtl ? 'flex-row-reverse' : '' %>">
            <div>
                <h2 class="text-3xl font-vibrant-display text-white tracking-tight"><%= t.title %> <span class="accent-orange"><%= t.subtitle %></span></h2>
            </div>
            <!-- Header Actions -->
            <div class="flex items-center gap-3">
                <button id="exportPdfBtn" onclick="exportReportPdf()" class="hidden bg-[var(--bg-primary)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-[var(--border-accent)] text-[var(--text-primary)] px-3.5 py-2 rounded-xl text-xs font-bold uppercase tracking-wider transition cursor-pointer flex items-center gap-2" title="<%= isRtl ? 'حفظ التقارير بتنسيق PDF' : 'Save PDF Report' %>">
                    <svg class="w-4 h-4 text-[var(--accent-color)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                    <span><%= t.exportPdf %></span>
                </button>

                <!-- Back to Overview Button in Title Bar -->
                <button id="overviewHeaderBtn" onclick="selectOverview()" class="hidden bg-[var(--bg-primary)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-[var(--border-accent)] text-[var(--accent-color)] hover:text-[var(--accent-hover)] px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition cursor-pointer flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
                    <%= t.overview %>
                </button>
            </div>
        </div>

        <!-- Filter Form -->
        <form id="filterForm" class="panel-surface p-3 px-4 rounded-xl mb-4 flex flex-col gap-2.5 relative z-30">
            <input type="hidden" name="lang" value="<%= currentLang %>">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-2.5 items-end">
                <div>
                    <label class="block text-xs font-black uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="startDate"><%= t.startTime %></label>
                    <input type="datetime-local" id="startDate" name="startDate" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                </div>
                <div>
                    <label class="block text-xs font-black uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="endDate"><%= t.endTime %></label>
                    <input type="datetime-local" id="endDate" name="endDate" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                </div>
                <div id="dirFilterCol">
                    <label class="block text-xs font-black uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="direction"><%= t.direction %></label>
                    <select id="direction" name="direction" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                        <option value="all"><%= t.allDir %></option>
                        <option value="inbound"><%= t.inbound %></option>
                        <option value="outbound"><%= t.outbound %></option>
                    </select>
                </div>
                <div class="md:col-span-2 flex items-end gap-2">
                    <button type="submit" class="btn-primary flex-1 py-1.5 text-xs uppercase tracking-wider"><%= t.apply %></button>
                </div>
            </div>
        </form>
        <div class="flex gap-6 flex-1 min-h-0">
            <!-- Left Extensions List -->
            <div id="extListCol" class="panel-surface rounded-2xl w-60 shrink-0 flex flex-col min-h-0">
                <div class="px-4 py-3.5 border-b border-[#27272a] bg-black/30 shrink-0 flex items-center justify-between <%= isRtl ? 'flex-row-reverse' : '' %>">
                    <span class="text-xs font-bold uppercase tracking-widest text-zinc-400"><%= t.extList %></span>
                </div>
                
                <!-- Navigation Items -->
                <div class="p-2 border-b border-[#27272a]/60 bg-black/10 shrink-0">
                    <div id="btnOverview" class="ext-card panel-surface rounded-xl px-3 py-2.5 text-sm flex items-center gap-3 active font-black tracking-wide text-[var(--accent-color)] border border-[#27272a]" onclick="selectOverview()">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
                        <span><%= t.overview %></span>
                    </div>
                </div>

                <div id="extList" class="flex-1 overflow-y-auto p-2 space-y-1 min-h-0">
                    <% roster.forEach(emp => { %>
                        <div class="ext-card panel-surface rounded-xl px-3 py-2.5 text-sm flex items-center gap-3 <%= !emp.online ? 'opacity-40' : '' %> <%= isRtl ? 'flex-row-reverse' : '' %>" data-ext="<%= emp.extension %>" onclick="selectExtension('<%= emp.extension %>')">
                            <span class="text-[var(--accent-color)] font-bold font-mono text-xs"><%= emp.extension %></span>
                            <span class="text-white font-sans font-bold truncate flex-1"><%= emp.name %></span>
                            <span class="w-2 h-2 rounded-full <%= emp.online ? 'bg-[var(--accent-color)]' : 'bg-zinc-700' %> shrink-0"></span>
                        </div>
                    <% }) %>
                </div>
                <div class="px-4 py-2.5 border-t border-[#27272a] bg-black/30 text-center shrink-0">
                    <span class="text-[10px] font-bold text-zinc-500"><%= t.footerRight %> <span class="text-[var(--accent-color)]"><%= roster.length %></span></span>
                </div>
            </div>

            <!-- Right Detail Panel (Consolidated Table or Deep-dive) -->
            <div id="detailPanel" class="flex-1 panel-surface rounded-2xl overflow-y-auto min-h-0 p-6 flex flex-col">
                <!-- Fallback Loading spinner placeholder -->
                <div class="flex-1 flex items-center justify-center text-zinc-500">
                    <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-[var(--accent-color)]"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentExtension = null;
        let dispositionChart = null;
        let dailyChart = null;
        let hourlyChart = null;
        let durationChart = null;
        let overviewData = [];
        let sortColumn = 'extension';
        let sortDirection = 'asc';
        let overviewPage = 1;
        let overviewPerPage = 25;

        function formatDate(d) {
            const dt = new Date(d);
            return dt.getFullYear() + '-' + String(dt.getMonth()+1).padStart(2,'0') + '-' + String(dt.getDate()).padStart(2,'0') +
                'T' + String(dt.getHours()).padStart(2,'0') + ':' + String(dt.getMinutes()).padStart(2,'0');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const now = new Date();
            const start = new Date(now);
            start.setDate(start.getDate() - 7);
            document.getElementById('startDate').value = formatDate(start);
            document.getElementById('endDate').value = formatDate(now);

            // Initialize Flatpickr on datetime inputs
            flatpickr('input[type="datetime-local"]', {
                enableTime: true,
                dateFormat: "Y-m-d\\TH:i",
                altInput: true,
                altFormat: "m/d/Y h:i K",
                time_24hr: false,
                allowInput: true,
                scrollInputIntoView: false,
                appendTo: document.body,
                monthSelectorType: "dropdown",
                onReady: function(selectedDates, dateStr, instance) {
                    if (instance.altInput) {
                        var origId = instance.input.id || (instance.input.name ? instance.input.name + 'Input' : 'datePicker_' + Math.random().toString(36).substring(2, 7));
                        if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                        instance.input.id = origId + '_raw';
                        instance.altInput.id = origId;
                        instance.altInput.name = (instance.input.name || origId) + '_display';
                        instance.altInput.setAttribute('autocomplete', 'off');
                        var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                        instance.altInput.setAttribute('aria-label', ariaLabel);
                    }
                }
            });
            document.getElementById('filterForm').addEventListener('submit', (e) => {
                e.preventDefault();
                if (currentExtension) {
                    loadStats(currentExtension);
                } else {
                    loadOverview();
                }
            });

            // Initialize digital clock in sidebar
            const clockEl = document.getElementById('digitalClock');
            if (clockEl) { setInterval(() => { clockEl.textContent = new Date().toTimeString().split(' ')[0]; }, 1000); }

            // Default to overview mode on load
            selectOverview();
        });

        function selectOverview() {
            currentExtension = null;
            document.querySelectorAll('.ext-card').forEach(c => c.classList.remove('active'));
            document.getElementById('btnOverview').classList.add('active');
            document.getElementById('overviewHeaderBtn').classList.add('hidden');
            document.getElementById('exportPdfBtn')?.classList.add('hidden');
            document.getElementById('dirFilterCol').classList.add('hidden'); // Hide direction filter since overview spans all
            loadOverview();
        }

        function selectExtension(ext) {
            currentExtension = ext;
            document.querySelectorAll('.ext-card').forEach(c => c.classList.remove('active'));
            document.getElementById('btnOverview').classList.remove('active');
            const card = document.querySelector(`.ext-card[data-ext="${ext}"]`);
            if (card) card.classList.add('active');
            document.getElementById('overviewHeaderBtn').classList.remove('hidden');
            document.getElementById('exportPdfBtn')?.classList.remove('hidden');
            document.getElementById('dirFilterCol').classList.remove('hidden');
            loadStats(ext);
        }

        function loadOverview() {
            overviewPage = 1;
            const startDate = (document.getElementById('startDate_raw') || document.getElementById('startDate')).value;
            const endDate = (document.getElementById('endDate_raw') || document.getElementById('endDate')).value;
            const lang = '<%= currentLang %>';
            const panel = document.getElementById('detailPanel');
            
            panel.innerHTML = `
                <div class="flex-1 flex items-center justify-center text-zinc-500">
                    <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-[var(--accent-color)]"></div>
                </div>
            `;

            const params = new URLSearchParams({ startDate, endDate, lang });
            fetch(`/api/ext-overview?${params}`)
                .then(r => r.json())
                .then(data => {
                    overviewData = data;
                    renderOverview();
                })
                .catch(err => {
                    panel.innerHTML = `<div class="text-center text-red-400 p-8"><p class="text-lg font-bold">Error loading overview</p><p class="text-sm mt-2">${err.message}</p></div>`;
                });
        }

        function sortOverview(col) {
            if (sortColumn === col) {
                sortDirection = sortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                sortColumn = col;
                sortDirection = 'desc'; // Default to desc for metrics
            }
            overviewPage = 1;
            renderOverview();
        }

        function fmtDur(s) {
            s = parseInt(s) || 0;
            const h = Math.floor(s / 3600); const m = Math.floor((s % 3600) / 60); const sec = s % 60;
            return h > 0 ? h + ':' + String(m).padStart(2,'0') + ':' + String(sec).padStart(2,'0')
                         : m + ':' + String(sec).padStart(2,'0');
        }

        function renderOverview() {
            const panel = document.getElementById('detailPanel');
            const lang = '<%= currentLang %>';
            const rtl = <%= isRtl %>;

            // Sort data
            const sorted = [...overviewData].sort((a, b) => {
                let valA = a[sortColumn];
                let valB = b[sortColumn];
                
                // Handle strings vs numbers
                if (typeof valA === 'string') {
                    return sortDirection === 'asc' ? valA.localeCompare(valB) : valB.localeCompare(valA);
                } else {
                    return sortDirection === 'asc' ? valA - valB : valB - valA;
                }
            });

            // Paginate
            overviewPerPage = parseInt(localStorage.getItem('cdrPerPage')) || 25;
            const totalItems = sorted.length;
            const totalPages = Math.max(1, Math.ceil(totalItems / overviewPerPage));
            if (overviewPage > totalPages) overviewPage = totalPages;
            const startIdx = (overviewPage - 1) * overviewPerPage;
            const pageData = sorted.slice(startIdx, startIdx + overviewPerPage);

            const caret = sortDirection === 'asc' ? '▲' : '▼';
            const sortIndicator = (col) => sortColumn === col ? `<span class="text-[var(--accent-color)] ml-1 text-[9px]">${caret}</span>` : '';

            let html = `
                <div class="w-full flex flex-col h-full">
                    <div class="mb-4 flex items-center justify-between shrink-0 ${rtl ? 'flex-row-reverse' : ''}">
                        <div>
                            <h3 class="text-lg font-bold text-white"><%= t.overview %></h3>
                            <p class="text-xs text-zinc-500 mt-0.5"><%= t.interactiveTable %></p>
                        </div>
                    </div>

                    <div class="overflow-x-auto overflow-y-auto flex-1 border border-[#27272a]/50 rounded-xl bg-black/10">
                        <table class="w-full text-start border-collapse">
                            <thead>
                                <tr class="bg-black/40 text-zinc-400 text-xs font-black uppercase border-b border-[#27272a]">
                                    <th class="p-4 tracking-wider text-start cursor-pointer hover:text-white transition select-none" onclick="sortOverview('extension')"><%= t.extension %> ${sortIndicator('extension')}</th>
                                    <th class="p-4 tracking-wider text-start cursor-pointer hover:text-white transition select-none" onclick="sortOverview('name')"><%= t.employee %> ${sortIndicator('name')}</th>
                                    <th class="p-4 tracking-wider text-center cursor-pointer hover:text-white transition select-none" onclick="sortOverview('totalCalls')"><%= t.totalCalls %> ${sortIndicator('totalCalls')}</th>
                                    <th class="p-4 tracking-wider text-center cursor-pointer hover:text-white transition select-none" onclick="sortOverview('inboundCalls')"><%= t.inboundLabel %> ${sortIndicator('inboundCalls')}</th>
                                    <th class="p-4 tracking-wider text-center cursor-pointer hover:text-white transition select-none" onclick="sortOverview('outboundCalls')"><%= t.outboundLabel %> ${sortIndicator('outboundCalls')}</th>
                                    <th class="p-4 tracking-wider text-end cursor-pointer hover:text-white transition select-none" onclick="sortOverview('totalTalkSec')"><%= t.totalDuration %> ${sortIndicator('totalTalkSec')}</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#27272a]/20 text-sm font-mono">
            `;

            if (sorted.length === 0) {
                html += `<tr><td colspan="6" class="p-8 text-center text-zinc-500 font-sans"><%= t.noData %></td></tr>`;
            } else {
                pageData.forEach(row => {
                    const talkMin = Math.round(row.totalTalkSec / 60);
                    
                    html += `
                        <tr class="hover:bg-zinc-900/50 cursor-pointer transition" onclick="selectExtension('${row.extension}')">
                            <td class="p-4 text-[var(--accent-color)] font-black text-sm">${row.extension}</td>
                            <td class="p-4 text-white font-sans font-bold text-sm">${row.name}</td>
                            <td class="p-4 text-center text-white font-bold text-sm">${row.totalCalls}</td>
                            <td class="p-4 text-center text-slate-300">${row.inboundCalls}</td>
                            <td class="p-4 text-center text-slate-300">${row.outboundCalls}</td>
                            <td class="p-4 text-end text-[var(--accent-color)] font-bold text-sm">${talkMin} <%= t.min %> <span class="text-[11px] text-zinc-500">(${row.totalTalkSec}s)</span></td>
                        </tr>
                    `;
                });
            }

            html += `
                            </tbody>
                        </table>
                    </div>
            `;
            // Pagination controls
            if (totalPages > 1) {
                html += '<div class="flex items-center justify-between mt-3 shrink-0">';
                html += '<span class="text-xs text-zinc-500">' + (startIdx + 1) + '-' + Math.min(startIdx + overviewPerPage, totalItems) + ' of ' + totalItems + '</span>';
                html += '<div class="flex gap-1">';
                html += '<button onclick="overviewPage=' + Math.max(1, overviewPage - 1) + ';renderOverview()" class="px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider transition cursor-pointer ' + (overviewPage <= 1 ? 'text-zinc-700 bg-zinc-900/50 cursor-not-allowed' : 'text-zinc-300 bg-zinc-900 hover:bg-zinc-800 hover:text-white') + '" ' + (overviewPage <= 1 ? 'disabled' : '') + '>Prev</button>';
                for (let p = Math.max(1, overviewPage - 2); p <= Math.min(totalPages, overviewPage + 2); p++) {
                    html += '<button onclick="overviewPage=' + p + ';renderOverview()" class="px-2.5 py-1 rounded text-xs font-bold tracking-wider transition cursor-pointer ' + (p === overviewPage ? 'bg-[var(--accent-color)] text-white' : 'text-zinc-400 bg-zinc-900 hover:bg-zinc-800 hover:text-white') + '">' + p + '</button>';
                }
                html += '<button onclick="overviewPage=' + Math.min(totalPages, overviewPage + 1) + ';renderOverview()" class="px-2.5 py-1 rounded text-xs font-bold uppercase tracking-wider transition cursor-pointer ' + (overviewPage >= totalPages ? 'text-zinc-700 bg-zinc-900/50 cursor-not-allowed' : 'text-zinc-300 bg-zinc-900 hover:bg-zinc-800 hover:text-white') + '" ' + (overviewPage >= totalPages ? 'disabled' : '') + '>Next</button>';
                html += '</div></div>';
            }

            html += `</div>`;
            panel.innerHTML = html;
            if (typeof window.dismissLoadingOverlay === 'function') window.dismissLoadingOverlay();
        }

        function loadStats(ext) {
            const startDate = (document.getElementById('startDate_raw') || document.getElementById('startDate')).value;
            const endDate = (document.getElementById('endDate_raw') || document.getElementById('endDate')).value;
            const direction = document.getElementById('direction').value;
            const lang = '<%= currentLang %>';
            const panel = document.getElementById('detailPanel');

            panel.innerHTML = `
                <div class="flex-1 flex items-center justify-center text-zinc-500">
                    <div class="animate-spin rounded-full h-8 w-8 border-t-2 border-b-2 border-[var(--accent-color)]"></div>
                </div>
            `;

            const params = new URLSearchParams({ startDate, endDate, direction, lang });
            fetch(`/api/ext-stats/${ext}?${params}`)
                .then(r => r.json())
                .then(data => renderStats(data))
                .catch(err => {
                    panel.innerHTML = `<div class="text-center text-red-400 p-8"><p class="text-lg font-bold">Error loading telemetry</p><p class="text-sm mt-2">${err.message}</p></div>`;
                });
        }

        function renderStats(data) {
            const panel = document.getElementById('detailPanel');
            const rtl = <%= isRtl %>;
            
            const name = document.querySelector(`.ext-card[data-ext="${data.extension}"]`)?.querySelector('span:nth-child(2)')?.textContent || data.extension;
            data.name = name;
            data.answerRate = data.totalCalls ? Math.round((data.answeredCalls / data.totalCalls) * 100) : 0;
            data.hasDirectionData = data.inboundCalls > 0 || data.outboundCalls > 0;
            data.inboundMin = Math.round(data.inboundTalkSec / 60);
            data.outboundMin = Math.round(data.outboundTalkSec / 60);
            data.contacts = data.uniqueContacts || [];
            data.recentCalls = (data.recentCalls || []).slice(0, 20);

            let html = '<div class="w-full flex flex-col min-h-0 print-block">';
            const startDateVal = document.getElementById('startDate')?.value || '';
            const endDateVal = document.getElementById('endDate')?.value || '';

            // Printable Header Banner with Employee Name & ID
            html += `<div class="print-header-banner flex items-center justify-between pb-4 mb-6 border-b border-[var(--border-primary)] ${rtl ? 'flex-row-reverse' : ''}">
                <div class="flex items-center gap-3 ${rtl ? 'flex-row-reverse' : ''}">
                    <span class="accent-orange font-mono bg-[var(--bg-primary)] border border-[var(--border-primary)] px-3 py-1.5 rounded-xl text-lg font-black">${data.extension}</span>
                    <div>
                        <h3 class="text-2xl font-bold text-[var(--text-primary)] font-sans flex items-center gap-2 ${rtl ? 'flex-row-reverse' : ''}">${data.name}</h3>
                        <p class="text-xs font-semibold text-[var(--text-muted)] tracking-wider uppercase mt-0.5"><%= isRtl ? 'تقرير تحليلات أداء الموظف' : 'Employee Performance Analytics Report' %></p>
                    </div>
                </div>
                <div class="text-end ${rtl ? 'text-start' : 'text-end'} text-xs text-[var(--text-muted)] font-mono">
                    <p class="font-bold text-[var(--text-primary)]">SOKRAT VOIP ANALYTICS</p>
                    <p class="mt-0.5">${startDateVal} &mdash; ${endDateVal}</p>
                </div>
            </div>`;

            // Stat Cards Grid
            html += '<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6 shrink-0">';
            html += `<div class="panel-surface rounded-xl p-4 card-stat border border-[#27272a]/30">
                <p class="text-[9px] font-black uppercase text-zinc-500 tracking-wider"><%= t.totalCalls %></p>
                <p class="text-2xl font-black text-white mt-1">${data.totalCalls}</p>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-4 card-stat border border-[#27272a]/30">
                <p class="text-[9px] font-black uppercase text-zinc-500 tracking-wider"><%= t.answered %></p>
                <p class="text-2xl font-black text-white mt-1">${data.answeredCalls}</p>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-4 card-stat border border-[#27272a]/30">
                <p class="text-[9px] font-black uppercase text-zinc-500 tracking-wider"><%= t.answerRate %></p>
                <p class="text-2xl font-black text-[var(--accent-color)] mt-1">${data.answerRate}%</p>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-4 card-stat border border-[#27272a]/30">
                <p class="text-[9px] font-black uppercase text-zinc-500 tracking-wider"><%= t.uniqueContacts %></p>
                <p class="text-2xl font-black text-zinc-300 mt-1">${data.uniqueContactCount}</p>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-4 card-stat border border-[#27272a]/30">
                <p class="text-[9px] font-black uppercase text-zinc-500 tracking-wider"><%= t.avgTalk %></p>
                <p class="text-2xl font-black text-zinc-400 mt-1">${data.avgTalkSec}<span class="text-xs text-[var(--accent-color)] ml-0.5">s</span></p>
            </div>`;
            html += '</div>';

            // Split metrics
            if (data.hasDirectionData) {
                html += '<div class="grid grid-cols-2 gap-3 mb-6 shrink-0">';
                html += `<div class="panel-surface rounded-xl p-4 border border-[#27272a]/40 flex items-center justify-between ${rtl ? 'flex-row-reverse' : ''}">
                    <div>
                        <p class="text-[10px] font-black uppercase text-white tracking-wider"><%= t.inboundLabel %></p>
                        <p class="text-3xl font-black text-white mt-1">${data.inboundCalls}</p>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-zinc-500 block uppercase font-bold"><%= t.talkTime %></span>
                        <span class="text-base font-black text-white">${data.inboundMin} <%= t.min %></span>
                    </div>
                </div>`;
                html += `<div class="panel-surface rounded-xl p-4 border border-[#27272a]/40 flex items-center justify-between ${rtl ? 'flex-row-reverse' : ''}">
                    <div>
                        <p class="text-[10px] font-black uppercase text-[var(--accent-color)] tracking-wider"><%= t.outboundLabel %></p>
                        <p class="text-3xl font-black text-white mt-1">${data.outboundCalls}</p>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-zinc-500 block uppercase font-bold"><%= t.talkTime %></span>
                        <span class="text-base font-black text-white">${data.outboundMin} <%= t.min %></span>
                    </div>
                </div>`;
                html += '</div>';
            }

            // Charts Grid
            html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6 shrink-0">';
            html += `<div class="panel-surface rounded-xl p-5 border border-[#27272a]/30">
                <h4 class="text-xs font-black uppercase text-zinc-400 tracking-wider mb-4"><%= t.disposition %></h4>
                <div id="dispositionChart" class="w-full h-72 min-h-[280px]"></div>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-5 border border-[#27272a]/30">
                <h4 class="text-xs font-black uppercase text-zinc-400 tracking-wider mb-4"><%= t.daily %></h4>
                <div id="dailyChart" class="w-full h-72 min-h-[280px]"></div>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-5 border border-[#27272a]/30">
                <h4 class="text-xs font-black uppercase text-zinc-400 tracking-wider mb-4"><%= t.hourly %></h4>
                <div id="hourlyChart" class="w-full h-72 min-h-[280px]"></div>
            </div>`;
            html += `<div class="panel-surface rounded-xl p-5 border border-[#27272a]/30">
                <h4 class="text-xs font-black uppercase text-zinc-400 tracking-wider mb-4"><%= t.duration %></h4>
                <div id="durationChart" class="w-full h-72 min-h-[280px]"></div>
            </div>`;
            html += '</div>';

            // Tag Cloud
            if (data.contacts.length) {
                html += `<div class="panel-surface rounded-xl p-4 border border-[#27272a]/30 mb-6 shrink-0">
                    <h4 class="text-xs font-black uppercase text-zinc-400 tracking-wider mb-3"><%= t.uniqueContacts %> (${data.uniqueContactCount})</h4>
                    <div class="flex flex-wrap gap-1.5">`;
                data.contacts.forEach(c => {
                    html += `<span class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs font-mono text-[var(--accent-color)] hover:border-[var(--accent-color)]/50 transition">${c}</span>`;
                });
                html += '</div></div>';
            }

            // Recent Calls Table
            if (data.recentCalls && data.recentCalls.length) {
                html += `<div class="panel-surface rounded-xl border border-[#27272a]/30 overflow-hidden flex-1 flex flex-col min-h-0">
                    <div class="px-4 py-3 border-b border-[#27272a] bg-black/25 shrink-0">
                        <h4 class="text-xs font-black uppercase text-zinc-400 tracking-wider"><%= t.recentCalls %></h4>
                    </div>
                    <div class="overflow-y-auto flex-1 min-h-0">
                        <table class="w-full text-start border-collapse">
                            <thead>
                                <tr class="bg-black/40 text-zinc-500 text-[9px] font-black uppercase border-b border-[#27272a]">
                                    <th class="p-3 tracking-wider text-start"><%= t.src %></th>
                                    <th class="p-3 tracking-wider text-start"><%= t.dst %></th>
                                    <th class="p-3 tracking-wider text-start"><%= t.duration %></th>
                                    <th class="p-3 tracking-wider text-start"><%= t.status %></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#27272a]/10 text-xs font-mono">`;
                const dispMap = {
                    ANSWERED: 'bg-[var(--accent-color)]/10 text-[var(--accent-color)] border border-[var(--accent-color)]/25',
                    BUSY: 'bg-amber-400/10 text-amber-400 border border-amber-400/25',
                    'NO ANSWER': 'bg-teal-400/10 text-teal-400 border border-teal-400/25',
                    FAILED: 'bg-purple-400/10 text-purple-400 border border-purple-400/25'
                };
                data.recentCalls.forEach(call => {
                    html += `
                        <tr class="hover:bg-zinc-900/30 transition">
                            <td class="p-3 text-white font-bold">${call.src}</td>
                            <td class="p-3 text-white">${call.dst}</td>
                            <td class="p-3 text-zinc-400">${fmtDur(call.billsec)}</td>
                            <td class="p-3 whitespace-nowrap">
                                <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded text-[10px] font-black tracking-wider whitespace-nowrap ${dispMap[call.disposition] || 'bg-zinc-800 text-zinc-400 border border-zinc-700/50'}">
                                    ${call.disposition}
                                </span>
                            </td>
                        </tr>
                    `;
                });
                html += '</tbody></table></div></div>';
            }
            html += '</div>';
            panel.className = 'flex-1 panel-surface rounded-2xl overflow-y-auto min-h-0 p-6 flex flex-col';
            panel.innerHTML = html;

            // Trigger ECharts rendering
            setTimeout(() => {
                if (data.dispositionData && data.dispositionData.length) {
                    initDispositionChart(data.dispositionData);
                }
                if (data.dailyData && data.dailyData.length) {
                    initDailyChart(data.dailyData);
                }
                if (data.hourlyData && data.hourlyData.length) {
                    initHourlyChart(data.hourlyData);
                }
                if (data.durationData && data.durationData.length) {
                    initDurationChart(data.durationData);
                }
                requestAnimationFrame(() => {
                    if (dispositionChart) dispositionChart.resize();
                    if (dailyChart) dailyChart.resize();
                    if (hourlyChart) hourlyChart.resize();
                    if (durationChart) durationChart.resize();
                    if (typeof window.dismissLoadingOverlay === 'function') window.dismissLoadingOverlay();
                });
            }, 50);
        }
        function renderPrintChartImages() {
            const chartList = [
                { id: 'dispositionChart', chart: dispositionChart },
                { id: 'dailyChart', chart: dailyChart },
                { id: 'hourlyChart', chart: hourlyChart },
                { id: 'durationChart', chart: durationChart }
            ];
            chartList.forEach(({ id, chart }) => {
                if (!chart) return;
                const container = document.getElementById(id);
                if (!container) return;
                const oldImg = container.querySelector('.print-chart-img');
                if (oldImg) oldImg.remove();
                try {
                    const dataUrl = chart.getDataURL({
                        type: 'png',
                        pixelRatio: 2,
                        backgroundColor: '#ffffff'
                    });
                    const img = document.createElement('img');
                    img.className = 'print-chart-img hidden';
                    img.src = dataUrl;
                    container.appendChild(img);
                } catch (e) {
                    console.error('Error exporting chart image:', e);
                }
            });
        }

        function exportReportPdf() {
            if (!currentExtension) {
                const firstExtCard = document.querySelector('.ext-card[data-ext]');
                if (firstExtCard) {
                    const firstExt = firstExtCard.getAttribute('data-ext');
                    selectExtension(firstExt);
                    setTimeout(() => exportReportPdf(), 400);
                    return;
                } else {
                    alert(<%- JSON.stringify(isRtl ? 'يرجى اختيار موظف لتصدير التقرير الخاص به' : 'Please select an employee to export their report') %>);
                    return;
                }
            }

            renderPrintChartImages();

            setTimeout(() => {
                window.print();
            }, 150);
        }

        function initDispositionChart(data) {
            if (dispositionChart) dispositionChart.dispose();
            const isLight = document.documentElement.classList.contains('light-theme');
            dispositionChart = echarts.init(document.getElementById('dispositionChart'), isLight ? null : 'dark');

            // Matte Solid Palette
            const matteColors = {
                ANSWERED: '#e11d48',
                BUSY: '#d97706',
                'NO ANSWER': '#0284c7',
                FAILED: '#9333ea',
                CANCEL: '#52525b'
            };
            const defaultMatte = isLight ? '#3f3f46' : '#71717a';

            dispositionChart.setOption({
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'item', 
                    formatter: '{b}: {c} ({d}%)',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                legend: { 
                    bottom: '0%', 
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold' } 
                },
                series: [{
                    name: 'Disposition',
                    type: 'pie',
                    center: ['50%', '42%'],
                    radius: ['38%', '62%'],
                    itemStyle: { 
                        borderRadius: 8, 
                        borderColor: isLight ? '#ffffff' : '#1e1e24', 
                        borderWidth: 2
                    },
                    label: { show: false },
                    data: data.map(d => ({
                        value: d.value,
                        name: d.name,
                        itemStyle: { color: matteColors[d.name] || defaultMatte }
                    })),
                    animationType: 'expansion',
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => dispositionChart && dispositionChart.resize());
        }

        function initDailyChart(data) {
            if (dailyChart) dailyChart.dispose();
            const isLight = document.documentElement.classList.contains('light-theme');
            dailyChart = echarts.init(document.getElementById('dailyChart'), isLight ? null : 'dark');

            dailyChart.setOption({
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'axis',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                legend: { 
                    bottom: '0%', 
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold' } 
                },
                grid: { left: '3%', right: '3%', top: '14%', bottom: '12%', containLabel: true },
                xAxis: {
                    type: 'category',
                    data: data.map(d => d.date.slice(5)),
                    axisLabel: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 9, fontWeight: 'bold' },
                    axisLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a' } }
                },
                yAxis: {
                    type: 'value',
                    axisLabel: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 9 },
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } }
                },
                series: [
                    { 
                        name: 'Total', 
                        type: 'bar', 
                        data: data.map(d => d.total), 
                        itemStyle: { 
                            color: '#e11d48', 
                            borderRadius: [4, 4, 0, 0]
                        }, 
                        barWidth: '35%',
                        animationEasing: 'cubicOut',
                        animationDuration: 1000
                    },
                    { 
                        name: 'Answered', 
                        type: 'bar', 
                        data: data.map(d => d.answered), 
                        itemStyle: { 
                            color: '#0284c7', 
                            borderRadius: [4, 4, 0, 0]
                        }, 
                        barWidth: '35%',
                        animationEasing: 'cubicOut',
                        animationDuration: 1200
                    }
                ]
            });
            window.addEventListener('resize', () => dailyChart && dailyChart.resize());
        }

        function initHourlyChart(data) {
            if (hourlyChart) hourlyChart.dispose();
            const isLight = document.documentElement.classList.contains('light-theme');
            hourlyChart = echarts.init(document.getElementById('hourlyChart'), isLight ? null : 'dark');

            hourlyChart.setOption({
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'axis',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                grid: { left: '3%', right: '3%', top: '14%', bottom: '12%', containLabel: true },
                xAxis: {
                    type: 'category',
                    data: data.map(d => d.hour),
                    axisLabel: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 8, interval: 2 },
                    axisLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a' } }
                },
                yAxis: {
                    type: 'value',
                    axisLabel: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 9 },
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } }
                },
                series: [{
                    name: 'Calls',
                    type: 'bar',
                    data: data.map(d => d.count),
                    itemStyle: { 
                        color: '#0d9488', 
                        borderRadius: [4, 4, 0, 0]
                    },
                    barWidth: '50%',
                    animationEasing: 'cubicOut',
                    animationDuration: 1100
                }]
            });
            window.addEventListener('resize', () => hourlyChart && hourlyChart.resize());
        }

        function initDurationChart(data) {
            if (durationChart) durationChart.dispose();
            const isLight = document.documentElement.classList.contains('light-theme');
            durationChart = echarts.init(document.getElementById('durationChart'), isLight ? null : 'dark');

            const durationColors = {
                'Short (<30s)': '#38bdf8',
                'Medium (30s-3m)': '#f59e0b',
                'Long (>3m)': '#e11d48'
            };
            const totalDurVal = data.reduce((acc, curr) => acc + (curr.value || 0), 0) || 1;

            durationChart.setOption({
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'axis',
                    axisPointer: { type: 'shadow' },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 },
                    formatter: function(params) {
                        const p = params[0];
                        const pct = Math.round((p.value / totalDurVal) * 100);
                        return p.name + ': ' + p.value + ' (' + pct + '%)';
                    }
                },
                grid: { left: 110, right: 60, top: 20, bottom: 20, containLabel: true },
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9 }
                },
                yAxis: {
                    type: 'category',
                    data: data.map(d => d.name),
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: { color: isLight ? '#27272a' : '#ffffff', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    name: 'Duration',
                    type: 'bar',
                    barWidth: '45%',
                    itemStyle: {
                        borderRadius: [0, 6, 6, 0]
                    },
                    data: data.map(d => ({
                        value: d.value,
                        name: d.name,
                        itemStyle: { color: durationColors[d.name] || '#64748b' }
                    })),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const pct = Math.round((params.value / totalDurVal) * 100);
                            return params.value + ' (' + pct + '%)';
                        },
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#52525b' : '#a1a1aa'
                    },
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => durationChart && durationChart.resize());
        }
    </script>
    <script>
        (function() {
            function forceMonthSelect() {
                document.querySelectorAll('.flatpickr-current-month').forEach(function(el) {
                    var sel = el.querySelector('.flatpickr-monthDropdown-months');
                    var cur = el.querySelector('.cur-month');
                    if (!sel) return;
                    if (cur) cur.style.setProperty('display', 'none', 'important');
                    sel.style.setProperty('display', 'inline-block', 'important');
                    sel.style.setProperty('pointer-events', 'auto', 'important');
                    sel.style.setProperty('cursor', 'pointer', 'important');
                    sel.style.setProperty('opacity', '1', 'important');
                });
            }
            document.addEventListener('click', function(e) {
                var el = e.target.closest('.flatpickr-current-month');
                if (!el) return;
                var sel = el.querySelector('.flatpickr-monthDropdown-months');
                if (!sel) return;
                if (e.target === sel) return;
                e.preventDefault();
                e.stopPropagation();
                if (typeof sel.showPicker === 'function') {
                    sel.showPicker();
                } else {
                    try { sel.click(); } catch(_) {}
                }
            }, true);
            forceMonthSelect();
            var pollTimer = setInterval(function() { forceMonthSelect(); }, 100);
            setTimeout(function() { clearInterval(pollTimer); }, 3000);
            var obs = new MutationObserver(function(muts) {
                muts.forEach(function(mut) {
                    mut.addedNodes.forEach(function(n) {
                        if (n.nodeType === 1 && n.querySelectorAll) forceMonthSelect();
                    });
                });
            });
            obs.observe(document.body, { childList: true, subtree: true });
        })();
    </script>
</body>
</html>

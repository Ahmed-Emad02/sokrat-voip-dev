        // --- GSM DYNAMIC DID MAPPINGS SUBTAB ---
        async function fetchDongleMappingsTab() {
            try {
                const isRtl = document.documentElement.dir === 'rtl';
                const res = await fetch('/api/config/dongle-mappings');
                const data = await res.json();
                if (!data.success) {
                    showToast(isRtl ? 'فشل تحميل بيانات خريطة DIDs' : 'Failed to load DID mappings', 'error');
                    return;
                }
                const mappings = Array.isArray(data.mappings) ? data.mappings : [];
                const summary = data.summary || {};
                document.getElementById('dmCardTotal').textContent = summary.totalCount || 0;
                document.getElementById('dmCardConnected').textContent = summary.connectedCount || 0;
                document.getElementById('dmCardSynced').textContent = summary.syncedCount || 0;
                document.getElementById('dmCardRoutes').textContent = summary.routeFoundCount || 0;

                const rosterCount = document.getElementById('dmRosterCount');
                if (rosterCount) {
                    rosterCount.textContent = `${mappings.length} ${isRtl ? 'أجهزة' : (mappings.length === 1 ? 'device' : 'devices')}`;
                }

                const tbody = document.getElementById('dmTableBody');
                if (!tbody) return;
                if (mappings.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-[var(--text-muted)] italic">' + (isRtl ? 'لا توجد فتحات شرائح معرفة' : 'No GSM dongle slots found.') + '</td></tr>';
                    return;
                }

                tbody.innerHTML = mappings.map(m => {
                    const rawState = m.state || 'Not Connected';
                    const normalizedState = rawState.toLowerCase();
                    let stateColor = 'red';
                    let stateLabel = rawState;
                    let animate = false;

                    if (normalizedState.includes('not init')) {
                        stateColor = 'yellow';
                        stateLabel = isRtl ? 'لم يتم التهيئة' : 'Not Initialized';
                    } else if (normalizedState.includes('not connect') || normalizedState === 'not_connected' || normalizedState.includes('disconnected') || normalizedState.includes('not responding')) {
                        stateColor = 'red';
                        stateLabel = isRtl ? 'غير متصل' : (normalizedState === 'not_connected' || normalizedState.includes('disconnected') ? 'Not Connected' : rawState);
                    } else if (normalizedState === 'free' || normalizedState === 'idle') {
                        stateColor = 'purple';
                        stateLabel = isRtl ? 'شريحة نشطة (Free)' : 'Free';
                    } else if (normalizedState.includes('outgoing') || normalizedState.includes('incoming') || normalizedState.includes('active') || normalizedState.includes('busy')) {
                        stateColor = 'green';
                        stateLabel = normalizedState.includes('outgoing')
                            ? (isRtl ? 'مكالمة صادرة' : 'Outgoing Call')
                            : (normalizedState.includes('incoming') ? (isRtl ? 'مكالمة واردة' : 'Incoming Call') : (isRtl ? 'مكالمة نشطة' : 'Active Call'));
                        animate = true;
                    } else if (normalizedState.includes('not reg') || normalizedState.includes('searching') || normalizedState.includes('no signal') || normalizedState.includes('gsm')) {
                        stateColor = 'yellow';
                        stateLabel = isRtl ? 'غير مسجل بالشريحة' : 'GSM Not Registered';
                    } else if (normalizedState.includes('dial') || normalizedState.includes('ring') || normalizedState.includes('calling')) {
                        stateColor = 'blue';
                        stateLabel = normalizedState.includes('dial') ? (isRtl ? 'جاري الاتصال' : 'Dialing') : (isRtl ? 'جاري الرنين' : 'Ringing');
                        animate = true;
                    }

                    const badgeClasses = {
                        red: { bg: 'bg-red-500/15', text: 'text-red-400', border: 'border-red-500/30', dot: 'bg-red-500' },
                        purple: { bg: 'bg-purple-500/15', text: 'text-purple-400', border: 'border-purple-500/30', dot: 'bg-purple-400' },
                        green: { bg: 'bg-emerald-500/15', text: 'text-emerald-400', border: 'border-emerald-500/30', dot: 'bg-emerald-400' },
                        yellow: { bg: 'bg-yellow-500/15', text: 'text-yellow-400', border: 'border-yellow-500/30', dot: 'bg-yellow-400' },
                        blue: { bg: 'bg-blue-500/15', text: 'text-blue-400', border: 'border-blue-500/30', dot: 'bg-blue-400' }
                    }[stateColor];

                    const safeDongleName = escapeHtml(m.dongleName || '-');
                    const safePhoneNumber = escapeHtml(m.phoneNumber || '');
                    const safeSimNumber = escapeHtml(m.simNumber || '');
                    const safeImsi = escapeHtml(m.imsi || '-');
                    const safeImei = escapeHtml(m.imei || '-');
                    const safeProvider = escapeHtml(m.provider || (isRtl ? 'غير معروف' : 'Unknown network'));
                    const safeRssi = escapeHtml(m.rssi === undefined || m.rssi === null ? '-' : String(m.rssi));
                    const astdb = m.astdb || {};
                    const stateBadge = `<span class="inline-flex items-center gap-1.5 ${badgeClasses.bg} ${badgeClasses.text} rounded-full px-2 py-0.5 text-[10px] font-bold border ${badgeClasses.border}">
                        <span class="h-1.5 w-1.5 rounded-full ${badgeClasses.dot}${animate ? ' animate-pulse' : ''} shrink-0"></span>
                        <span>${escapeHtml(stateLabel)}</span>
                    </span>`;

                    const perDongleEnabled = m.dynamicEnabled === true;
                    const configuredDidDisplay = safePhoneNumber
                        ? `<div class="font-mono font-bold text-emerald-400 text-sm">${safePhoneNumber}</div>
                           <div class="text-[10px] ${perDongleEnabled ? 'text-cyan-400' : 'text-amber-400'} font-bold uppercase tracking-wider">${perDongleEnabled
                               ? (isRtl ? 'الخريطة الديناميكية مفعلة' : 'Dynamic mapping enabled')
                               : (isRtl ? 'الخريطة الديناميكية معطلة' : 'Dynamic mapping disabled')}</div>`
                        : `<span class="text-[var(--text-muted)] italic text-[11px]">${isRtl ? 'غير مهيأ' : 'Unconfigured'}</span>`;
                    const simReportDisplay = (m.simNumber && m.simNumber !== 'Unknown' && m.simNumber !== '-')
                        ? `<span class="font-mono text-[var(--text-primary)]">${safeSimNumber}</span>`
                        : (m.phoneNumber
                            ? `<span class="text-[10px] font-mono ${perDongleEnabled ? 'text-cyan-300' : 'text-amber-400'}">${perDongleEnabled
                                ? (isRtl ? 'غير مسجلة؛ الخريطة المهيأة مفعلة' : 'Unregistered; configured mapping enabled')
                                : (isRtl ? 'غير مسجلة؛ الخريطة معطلة' : 'Unregistered; mapping off')}</span>`
                            : `<span class="text-[10px] font-mono text-amber-400">${isRtl ? 'غير معروف' : 'Unknown'}</span>`);

                    const astdbDongleOk = Boolean(m.phoneNumber) && astdb.dongle_map === m.phoneNumber;
                    const astdbBadge = astdbDongleOk
                        ? `<span class="inline-flex px-2 py-0.5 text-[10px] font-mono rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">${isRtl ? 'AstDB متزامن' : 'AstDB synced'}</span>`
                        : `<span class="inline-flex px-2 py-0.5 text-[10px] font-mono rounded bg-red-500/10 text-red-400 border border-red-500/20">${isRtl ? 'AstDB يحتاج مزامنة' : 'AstDB needs sync'}</span>`;
                    const routeBadge = m.inboundRoute && m.inboundRoute.found
                        ? `<div class="space-y-1">
                               <div class="text-[11px] font-semibold text-purple-300 break-words">→ ${escapeHtml(m.inboundRoute.description || m.inboundRoute.destination || '-')}</div>
                               <div class="text-[10px] text-emerald-400">${isRtl ? 'مسار وارد مسجل' : 'Registered inbound route'}</div>
                           </div>`
                        : `<div class="text-[11px] font-semibold ${perDongleEnabled ? 'text-amber-400' : 'text-[var(--text-muted)]'}">${perDongleEnabled
                            ? (isRtl ? 'توجيه DID ديناميكي' : 'Dynamic DID routing')
                            : (isRtl ? 'الخريطة الديناميكية معطلة' : 'Dynamic mapping disabled')}</div>`;

                    const perDongleBtnClass = perDongleEnabled
                        ? 'config-action-btn config-action-btn--compact config-action-btn--state-on'
                        : 'config-action-btn config-action-btn--compact config-action-btn--state-off';
                    const perDongleBtnText = perDongleEnabled
                        ? (isRtl ? 'الخريطة مفعلة' : 'Mapping On')
                        : (isRtl ? 'الخريطة معطلة' : 'Mapping Off');

                    return `
                        <tr class="hover:bg-[var(--bg-hover)]/35 transition-colors">
                            <td class="p-3.5 align-top">
                                <div class="font-mono font-black text-[var(--text-primary)]">${safeDongleName}</div>
                                <div class="mt-1.5">${stateBadge}</div>
                                <div class="mt-1.5 text-[10px] text-[var(--text-muted)]">${safeProvider} · ${safeRssi} dBm</div>
                            </td>
                            <td class="p-3.5 align-top">
                                <div class="space-y-2">
                                    <div>${configuredDidDisplay}</div>
                                    <div class="pt-2 border-t border-[var(--border-primary)]">
                                        <span class="text-[9px] uppercase tracking-wider text-[var(--text-muted)] block mb-0.5">SIM</span>
                                        ${simReportDisplay}
                                    </div>
                                </div>
                            </td>
                            <td class="p-3.5 align-top font-mono text-[10px]">
                                <div class="space-y-2">
                                    <div><span class="text-[var(--text-muted)] block">IMSI</span><span class="text-[var(--text-secondary)] whitespace-nowrap">${safeImsi}</span></div>
                                    <div><span class="text-[var(--text-muted)] block">IMEI</span><span class="text-[var(--text-secondary)] whitespace-nowrap">${safeImei}</span></div>
                                </div>
                            </td>
                            <td class="p-3.5 align-top">
                                <div class="space-y-2">
                                    <div>${astdbBadge}</div>
                                    <div>${routeBadge}</div>
                                </div>
                            </td>
                            <td class="p-3.5 align-top text-right">
                                <div class="inline-flex flex-col items-stretch gap-1.5">
                                    <button type="button" onclick="toggleSingleDongleDynamic('${m.dongleName}', ${perDongleEnabled})" class="${perDongleBtnClass}">
                                        ${perDongleBtnText}
                                    </button>
                                    <button type="button" onclick="editDongleTabDid('${m.dongleName}', '${m.imsi || ''}', '${m.phoneNumber || ''}')" class="config-action-btn config-action-btn--compact">
                                        ${isRtl ? 'تعديل DID' : 'Edit DID'}
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                console.error('fetchDongleMappingsTab error:', err);
            }
        }
        window.fetchDongleMappingsTab = fetchDongleMappingsTab;


        async function toggleSingleDongleDynamic(dongleName, currentState) {
            try {
                const targetState = !currentState;
                const res = await fetch(`/api/config/dongle-mappings/${encodeURIComponent(dongleName)}/toggle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: targetState })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to update dongle setting', 'error');
                }
            } catch(err) {
                showToast('Network error: ' + err.message, 'error');
            }
        }
        window.toggleSingleDongleDynamic = toggleSingleDongleDynamic;

        async function editDongleTabDid(dongleId, imsi, currentVal) {
            const isRtl = document.documentElement.dir === 'rtl';
            const newNum = prompt(isRtl ? `أدخل رقم DID المعرف لـ ${dongleId}:` : `Enter configured DID for ${dongleId}:`, currentVal);
            if (newNum === null) return;
            const trimmed = newNum.trim();
            if (!trimmed) return;

            showToast(isRtl ? 'جاري حفظ رقم DID...' : 'Saving DID mapping...', 'info');

            try {
                const res = await fetch('/api/gsm-dongles/save-number', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongleId, imsi, number: trimmed })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ رقم DID ومطابقة AstDB بنجاح' : 'DID saved & AstDB reconciled successfully!', 'success');
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to save DID', 'error');
                }
            } catch (e) {
                showToast(e.message || 'Connection error', 'error');
            }
        }
        window.editDongleTabDid = editDongleTabDid;

        async function reconcileDonglesNow() {
            const isRtl = document.documentElement.dir === 'rtl';
            showToast(isRtl ? 'جاري إعادة مطابقة AstDB...' : 'Reconciling AstDB dongle mappings...', 'info');
            try {
                const res = await fetch('/api/gsm-dongles/redetect', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تمت إعادة مطابقة AstDB بنجاح' : 'AstDB mappings reconciled successfully!', 'success');
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Reconciliation failed', 'error');
                }
            } catch (e) {
                showToast(e.message || 'Network error', 'error');
            }
        }
        window.reconcileDonglesNow = reconcileDonglesNow;

        function ensureAllConfigListsLoaded(force = false) {
            const promises = [];
            if (force || !(Array.isArray(loadedExtensionsList) && loadedExtensionsList.length)) promises.push(fetchExtensions().catch(() => {}));
            if (force || !(Array.isArray(loadedRingGroupsList) && loadedRingGroupsList.length)) promises.push(fetchRingGroups().catch(() => {}));
            if (force || !(Array.isArray(loadedQueuesList) && loadedQueuesList.length)) promises.push(fetchQueues().catch(() => {}));
            if (force || !(Array.isArray(loadedIvrsList) && loadedIvrsList.length)) promises.push(fetchIvrs().catch(() => {}));
            if (force || !(Array.isArray(loadedAnnouncementsList) && loadedAnnouncementsList.length)) promises.push(fetchAnnouncements().catch(() => {}));
            if (force || !(Array.isArray(loadedTimeConditionsList) && loadedTimeConditionsList.length)) promises.push(fetchTimeConditions().catch(() => {}));
            if (force || !(Array.isArray(loadedRecordingsList) && loadedRecordingsList.length)) promises.push(fetchRecordings().catch(() => {}));
            if (force || !(Array.isArray(loadedMohCategories) && loadedMohCategories.length)) promises.push(fetchMohData().catch(() => {}));
            if (force || !(Array.isArray(loadedFederationPeersList) && loadedFederationPeersList.length)) promises.push(fetchFederationPeers().catch(() => {}));
            if (promises.length === 0) return Promise.resolve();
            return Promise.allSettled(promises).then(() => {
                if (typeof enhanceSelectElements === 'function') setTimeout(enhanceSelectElements, 50);
            });
        }
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-red-600' : type === 'warning' ? 'bg-amber-600' : 'bg-slate-800';
            toast.className = `${bgClass} text-white text-xs font-bold px-4 py-3 rounded-lg flex items-center gap-2 border border-white/20 transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        const PBX_CONFIG_MODAL_IDS = [
            'extensionModal',
            'webrtcCredentialsModal',
            'ringGroupModal',
            'queueModal',
            'trunkModal',
            'ivrModal',
            'inboundModal',
            'outboundModal',
            'timeGroupModal',
            'timeConditionModal',
            'announcementModal',
            'mohCategoryModal',
            'addDongleSlotModal',
            'removeDongleSlotModal',
            'sttApiKeyModal',
            'defaultFiltersModal',
            'clientModal',
            'connectPbxModal',
            'editPeerModal',
            'federationSettingsModal',
            'recordingStudioModal'
        ];
        function closeAllModals() {
            PBX_CONFIG_MODAL_IDS.forEach(id => {
                const m = document.getElementById(id);
                if (m) {
                    m.classList.add('hidden');
                    m.style.setProperty('display', 'none', 'important');
                    m.setAttribute('aria-hidden', 'true');
                }
            });
            const inPopup = document.getElementById('inboundDongleInfoPopup');
            if (inPopup) inPopup.classList.add('hidden');
            const donglePopup = document.getElementById('dongleInfoPopup');
            if (donglePopup) donglePopup.classList.add('hidden');
        }
        window.closeAllModals = closeAllModals;

        function switchTab(tabId) {
            closeAllModals();
            document.querySelectorAll('.tab-section').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.config-tab-btn').forEach(btn => {
                btn.classList.remove('config-tab-active');
                btn.classList.add('config-tab-inactive');
            });
            const sec = document.getElementById('section-' + tabId);
            if (sec) sec.classList.remove('hidden');
            const btn = document.getElementById('tab-btn-' + tabId);
            if (btn) {
                btn.classList.remove('config-tab-inactive');
                btn.classList.add('config-tab-active');
            }
            stopRtcpTimer();
            if (tabId === 'extensions') fetchExtensions();
            if (tabId === 'ringgroups') { fetchRecordings(); fetchRingGroups(); fetchExtensions(); fetchQueues(); fetchIvrs(); fetchTimeConditions(); fetchAnnouncements(); fetchMohData(); fetchFederationPeers(); }
            if (tabId === 'queues') { fetchRecordings(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchAnnouncements(); fetchFederationPeers(); }
            if (tabId === 'ivr') { fetchRecordings(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchAnnouncements(); fetchFederationPeers(); }
            if (tabId === 'recordings') fetchRecordings();
            if (tabId === 'trunks') fetchTrunks();
            if (tabId === 'outbound') { fetchOutboundRoutes(); fetchTrunks(); fetchFederationPeers(); }
            if (tabId === 'timegroups') fetchTimeGroups();
            if (tabId === 'timeconditions') { fetchTimeConditions(); fetchTimeGroups(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchAnnouncements(); fetchFederationPeers(); }
            if (tabId === 'announcements') { fetchAnnouncements(); fetchRecordings(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchTimeConditions(); fetchFederationPeers(); }
            if (tabId === 'voicemail') fetchVoicemailExtensions();
            if (tabId === 'modem') { fetchModemConfig(); loadAudioGlobals(); loadSttSettings(); fetchRtcpDiagnostics(); startRtcpTimer(); }
            if (tabId === 'terminal') initTtyTerminal();
            if (tabId === 'diagram') { sizeDiagramCanvas(); fetchDiagramData(); }
            if (tabId === 'inbound') { fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchTimeConditions(); fetchAnnouncements(); fetchInboundRoutes(); fetchDongleMappingsTab(); fetchFederationPeers(); }
            if (tabId === 'federation') { fetchFederationSettings(); fetchFederationPeers(); }
            if (tabId === 'dongles') { switchTab('inbound'); return; }
            if (typeof enhanceSelectElements === 'function') setTimeout(enhanceSelectElements, 100);
        }
        window.switchTab = switchTab;

        function openModal(id) {
            closeAllModals();
            const modal = document.getElementById(id);
            if (!modal) {
                console.warn(`openModal: element #${id} not found`);
                return;
            }
            modal.classList.remove('hidden');
            modal.style.setProperty('display', 'flex', 'important');
            modal.setAttribute('aria-hidden', 'false');
            if (typeof enhanceSelectElements === 'function') setTimeout(enhanceSelectElements, 50);
        }
        window.openModal = openModal;

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (!modal) return;
            modal.classList.add('hidden');
            modal.style.setProperty('display', 'none', 'important');
            modal.setAttribute('aria-hidden', 'true');
        }
        window.closeModal = closeModal;

        // --- RELOAD PBX CONFIG ---
        function reloadPbxConfig() {
            const btn = document.getElementById('reloadPbxBtn');
            const icon = document.getElementById('reloadIcon');
            const btnText = document.getElementById('reloadBtnText');
            
            btn.disabled = true;
            icon.classList.add('animate-spin');
            btnText.textContent = isRtl ? 'جاري تطبيق التغييرات...' : 'Applying PBX Config...';

            fetch('/api/config/reload', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? 'تم تطبيق إعدادات المقسم بنجاح!' : 'PBX Configuration applied successfully!', 'success');
                    } else {
                        showToast(isRtl ? 'فشل تطبيق الإعدادات: ' + (data.error || '') : 'PBX Reload Failed: ' + (data.error || ''), 'error');
                    }
                })
                .catch(err => showToast('Network Error: ' + err.message, 'error'))
                .finally(() => {
                    btn.disabled = false;
                    icon.classList.remove('animate-spin');
                    btnText.textContent = isRtl ? 'تطبيق تغييرات المقسم (Apply PBX Changes)' : 'Apply PBX Configuration';
                });
        }

        // --- 1. EXTENSIONS ---
        function fetchExtensions() {
            const tbody = document.getElementById('extensions-table-body');
            return fetch('/api/config/extensions')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !Array.isArray(data.extensions)) {
                    }
                    loadedExtensionsList = Array.isArray(data.extensions) ? data.extensions : [];
                    const list = loadedExtensionsList;
                    renderQuickPickPills();
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد تحويلات.' : 'No extensions found.') + '</td></tr>';
                        return;
                    }
                    data.extensions.forEach(ext => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const isVmOn = (ext.voicemail === 'default' || ext.voicemail === 'enabled');
                        const vmBadge = isVmOn
                            ? `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">Enabled</span>`
                            : `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-slate-500/15 text-slate-400 border border-slate-500/20">Disabled</span>`;
                        const profileInitial = escapeHtml(String(ext.name || ext.extension || '?').trim().charAt(0).toUpperCase());
                        const profilePhoto = ext.photo
                            ? `<img src="${escapeHtml(ext.photo)}" alt="" class="w-9 h-9 rounded-lg object-cover border border-[var(--border-primary)] shrink-0" onerror="this.remove()">`
                            : `<span class="w-9 h-9 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] flex items-center justify-center text-xs font-black text-[var(--text-secondary)] shrink-0">${profileInitial}</span>`;
                        const titleText = ext.title
                            ? `<span class="text-xs font-bold text-[var(--text-primary)] truncate">${escapeHtml(ext.title)}</span>`
                            : `<span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'بدون مسمى وظيفي' : 'No job title'}</span>`;
                        const adminBadge = ext.is_group_admin ? `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-extrabold bg-amber-500/15 text-amber-400 border border-amber-500/30 font-mono" title="${isRtl ? 'مدير المجموعة (صلاحية التقاط المكالمات)' : 'Group Admin (Call Pickup Authority)'}"><svg class="w-2.5 h-2.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg><span>Admin</span></span>` : '';
                        const groupLabel = ext.emp_group ? escapeHtml(ext.emp_group) : (isRtl ? 'بدون مجموعة' : 'Ungrouped');
                        const groupClass = ext.emp_group ? 'text-red-400 font-bold' : 'text-[var(--text-muted)]';
                        const groupText = `<div class="flex items-center gap-1.5 flex-wrap"><span class="text-[10px] truncate ${groupClass}">${groupLabel}</span>${adminBadge}</div>`;
                        const isWebRtcExt = (ext.tech === 'pjsip' || ext.tech === 'webrtc');
                        const techBadge = isWebRtcExt
                            ? `<span class="ext-tech-badge ext-tech-webrtc"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>WebRTC Softphone</span>`
                            : `<span class="ext-tech-badge ext-tech-sip">Generic SIP Device</span>`;
                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${escapeHtml(ext.extension)}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ext.name || '-')}</td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-2 min-w-[12rem]">
                                    ${profilePhoto}
                                    <div class="min-w-0 flex flex-col">${titleText}${groupText}</div>
                                </div>
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(ext.secret || '-')}</td>
                            <td class="py-3 px-4">${techBadge}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">Yes</span></td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded bg-purple-500/15 text-purple-400 border border-purple-500/20">Always</span></td>
                            <td class="py-3 px-4">${vmBadge}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" data-action="edit" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" data-action="delete" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tr.querySelector('[data-action="edit"]').addEventListener('click', () => {
                            editExtension(ext.extension, ext.name, ext.secret, ext.voicemail, ext.tech, ext.denoise, ext.vad_gate, ext.vad_db);
                        });
                        tr.querySelector('[data-action="delete"]').addEventListener('click', () => {
                            deleteExtension(ext.extension);
                        });
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => {
                    console.error('fetchExtensions error:', err);
                    if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-rose-400 font-semibold">' + (isRtl ? 'خطأ في جلب بيانات التحويلات.' : 'Error fetching extensions.') + '</td></tr>';
                });
        }

        function showEmployeePhotoPreview(url, label) {
            const preview = document.getElementById('extPhotoPreview');
            const fallback = document.getElementById('extPhotoFallback');
            const removeButton = document.getElementById('extPhotoRemove');
            const status = document.getElementById('extPhotoStatus');
            preview.src = url || '';
            preview.classList.toggle('hidden', !url);
            fallback.classList.toggle('hidden', Boolean(url));
            removeButton.classList.toggle('hidden', !url);
            status.textContent = label || (isRtl ? 'لم يتم اختيار صورة' : 'No photo selected');
        }

        function resetEmployeeProfileFields() {
            if (employeePhotoObjectUrl) {
                URL.revokeObjectURL(employeePhotoObjectUrl);
                employeePhotoObjectUrl = null;
            }
            document.getElementById('extPhoto').value = '';
            document.getElementById('extPhotoUrl').value = '';
            document.getElementById('extTitle').value = '';
            const isGroupAdminEl = document.getElementById('extIsGroupAdmin');
            if (isGroupAdminEl) isGroupAdminEl.checked = false;
            showEmployeePhotoPreview('', '');
            const groupSelect = document.getElementById('extGroup');
            groupSelect.disabled = true;
            groupSelect.innerHTML = '<option value="">' + (isRtl ? 'جاري تحميل المجموعات...' : 'Loading groups...') + '</option>';
        }

        function previewEmployeePhoto(input) {
            const file = input.files[0];
            if (!file) return;
            if (file.size > MAX_EMPLOYEE_PHOTO_BYTES) {
                input.value = '';
                showToast(isRtl ? 'يجب ألا يتجاوز حجم الصورة 50 ميجابايت' : 'Employee photo must be 50 MB or smaller', 'error');
                return;
            }
            if (!file.type.startsWith('image/')) {
                input.value = '';
                showToast(isRtl ? 'يرجى اختيار ملف صورة صالح' : 'Please choose a valid image file', 'error');
                return;
            }
            if (employeePhotoObjectUrl) URL.revokeObjectURL(employeePhotoObjectUrl);
            employeePhotoObjectUrl = URL.createObjectURL(file);
            showEmployeePhotoPreview(employeePhotoObjectUrl, file.name);
        }

        function clearEmployeePhoto() {
            if (employeePhotoObjectUrl) {
                URL.revokeObjectURL(employeePhotoObjectUrl);
                employeePhotoObjectUrl = null;
            }
            document.getElementById('extPhoto').value = '';
            document.getElementById('extPhotoUrl').value = '';
            showEmployeePhotoPreview('', '');
        }

        function setEmployeeGroupOptions(groups, selectedValue = '') {
            const select = document.getElementById('extGroup');
            select.innerHTML = '';
            const emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = isRtl ? '(بدون مجموعة)' : '(No Group)';
            select.appendChild(emptyOption);
            groups.forEach(group => {
                const option = document.createElement('option');
                option.value = group.name;
                option.textContent = group.name;
                select.appendChild(option);
            });
            select.value = selectedValue;
            select.disabled = false;
        }

        async function loadEmployeeGroups(selectedValue = '') {
            const response = await fetch('/api/employee/groups');
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Failed to load employee groups');
            }
            setEmployeeGroupOptions(data.groups || [], selectedValue);
        }

        async function openExtensionModal() {
            document.getElementById('extModalTitle').textContent = isRtl ? 'إضافة تحويلة جديدة (WebRTC / Generic SIP)' : 'Add Extension (WebRTC / Generic SIP)';
            document.getElementById('extEditMode').value = 'false';
            document.getElementById('extNum').disabled = false;
            document.getElementById('extensionForm').reset();
            document.getElementById('extVoicemail').value = 'disabled';
            document.getElementById('extTech').value = 'sip';
            document.getElementById('extDenoise').value = 'both';
            document.getElementById('extVoicemail').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extTech').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extDenoise').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadGate').value = '1';
            document.getElementById('extVadGate').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadDb').value = 'off';
            document.getElementById('extVadDb').dispatchEvent(new Event('change', { bubbles: true }));
            resetEmployeeProfileFields();
            openModal('extensionModal');
            try {
                await loadEmployeeGroups();
            } catch (error) {
                showToast(error.message, 'error');
            }
        }

        async function editExtension(extNum, name, secret, voicemail, tech, denoise, vadGate, vadDb) {
            document.getElementById('extModalTitle').textContent = (isRtl ? 'تعديل التحويلة ' : 'Edit Extension ') + extNum;
            document.getElementById('extEditMode').value = 'true';
            document.getElementById('extNum').value = extNum;
            document.getElementById('extNum').disabled = true;
            document.getElementById('extName').value = name || '';
            document.getElementById('extSecret').value = secret || '';
            document.getElementById('extVoicemail').value = (voicemail === 'default' || voicemail === 'enabled') ? 'enabled' : 'disabled';
            document.getElementById('extTech').value = (tech === 'pjsip' || tech === 'webrtc') ? 'webrtc' : 'sip';
            document.getElementById('extDenoise').value = ['both', 'rx', 'tx', 'off'].includes(denoise) ? denoise : 'both';
            document.getElementById('extVadGate').value = (vadGate === '0' || vadGate === 0 || vadGate === false) ? '0' : '1';
            document.getElementById('extVadDb').value = (vadDb && vadDb !== 'undefined') ? String(vadDb).trim() : 'off';
            document.getElementById('extVoicemail').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extTech').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extDenoise').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadGate').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadDb').dispatchEvent(new Event('change', { bubbles: true }));
            resetEmployeeProfileFields();
            openModal('extensionModal');

            try {
                const [groupsResponse, extrasResponse] = await Promise.all([
                    fetch('/api/employee/groups'),
                    fetch('/api/employee/extras/' + encodeURIComponent(extNum))
                ]);
                const [groupsData, extrasData] = await Promise.all([
                    groupsResponse.json(),
                    extrasResponse.json()
                ]);
                if (!groupsResponse.ok || !groupsData.success) {
                    throw new Error(groupsData.error || 'Failed to load employee groups');
                }
                if (!extrasResponse.ok || !extrasData.success) {
                    throw new Error(extrasData.error || 'Failed to load employee profile');
                }

                const extras = extrasData.extras || {};
                setEmployeeGroupOptions(groupsData.groups || [], extras.emp_group || '');
                document.getElementById('extTitle').value = extras.title || '';
                document.getElementById('extPhotoUrl').value = extras.photo || '';
                const isGroupAdminEl = document.getElementById('extIsGroupAdmin');
                if (isGroupAdminEl) isGroupAdminEl.checked = Boolean(extras.is_group_admin);
                if (extras.photo) {
                    showEmployeePhotoPreview(extras.photo, extras.photo.split('/').pop());
                }
            } catch (error) {
                setEmployeeGroupOptions([], '');
                showToast(error.message, 'error');
            }
        }

        async function saveExtension(event) {
            event.preventDefault();
            const wasEdit = document.getElementById('extEditMode').value === 'true';
            const extNum = document.getElementById('extNum').value.trim();
            const name = document.getElementById('extName').value.trim();
            const secret = document.getElementById('extSecret').value.trim();
            const voicemail = document.getElementById('extVoicemail').value;
            const tech = document.getElementById('extTech').value;
            const denoise = document.getElementById('extDenoise').value;
            const vadGate = document.getElementById('extVadGate').value;
            const vadDb = document.getElementById('extVadDb').value;
            const saveButton = document.getElementById('extSaveBtn');
            const saveText = document.getElementById('extSaveBtnText');
            const originalText = saveText.textContent;
            let extensionCreated = false;

            saveButton.disabled = true;
            saveText.textContent = isRtl ? 'جاري الحفظ...' : 'Saving...';

            try {
                const response = await fetch(wasEdit ? '/api/config/extensions/' + extNum : '/api/config/extensions', {
                    method: wasEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ extension: extNum, name, secret, voicemail, tech, denoise, vad_gate: vadGate, vad_db: vadDb })
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.error || 'Failed to save extension');
                }

                if (!wasEdit) {
                    extensionCreated = true;
                    document.getElementById('extEditMode').value = 'true';
                    document.getElementById('extNum').disabled = true;
                }
                await saveEmployeeExtras(extNum);
                showToast(data.message, 'success');
                closeModal('extensionModal');
                fetchExtensions();
                if (tech === 'webrtc' && !wasEdit) {
                    document.getElementById('credExt').textContent = extNum;
                    document.getElementById('credName').textContent = name;
                    document.getElementById('credSecret').textContent = secret;
                    document.getElementById('credWsUrl').textContent = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.hostname + (location.protocol === 'https:' ? ':8089/ws' : ':8088/ws');
                    openModal('webrtcCredentialsModal');
                }
            } catch (error) {
                const prefix = extensionCreated
                    ? (isRtl ? 'تم إنشاء التحويلة، لكن تعذر حفظ بيانات الموظف: ' : 'Extension created, but employee profile failed: ')
                    : '';
                showToast(prefix + error.message, 'error');
            } finally {
                saveButton.disabled = false;
                saveText.textContent = originalText;
            }
        }

        function deleteExtension(extNum) {
            if (!confirm(isRtl ? `حذف التحويلة ${extNum}؟` : `Delete extension ${extNum}?`)) return;
            fetch('/api/config/extensions/' + extNum, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchExtensions();
                    } else {
                        showToast(data.error, 'error');
                    }
                })
                .catch(error => showToast(error.message, 'error'));
        }

        async function saveEmployeeExtras(extNum) {
            const photoFile = document.getElementById('extPhoto').files[0];
            const title = document.getElementById('extTitle').value.trim();
            const empGroup = document.getElementById('extGroup').value;
            let photoUrl = document.getElementById('extPhotoUrl').value || null;

            if (photoFile) {
                if (photoFile.size > MAX_EMPLOYEE_PHOTO_BYTES) {
                    throw new Error(isRtl ? 'يجب ألا يتجاوز حجم الصورة 50 ميجابايت' : 'Employee photo must be 50 MB or smaller');
                }
                const formData = new FormData();
                formData.append('photo', photoFile);
                const uploadResponse = await fetch('/api/employee/photo', { method: 'POST', body: formData });
                const uploadData = await uploadResponse.json();
                if (!uploadResponse.ok || !uploadData.success) {
                    throw new Error(uploadData.error || 'Failed to upload employee photo');
                }
                photoUrl = uploadData.url;
                document.getElementById('extPhotoUrl').value = photoUrl;
            }

            const response = await fetch('/api/employee/extras/' + encodeURIComponent(extNum), {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    photo: photoUrl,
                    title: title || null,
                    emp_group: empGroup || null,
                    is_group_admin: document.getElementById('extIsGroupAdmin')?.checked ? 1 : 0
                })
            });
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Failed to save employee profile');
            }
            return data.extras;
        }
        window.openExtensionModal = openExtensionModal;
        window.editExtension = editExtension;
        window.deleteExtension = deleteExtension;
        window.saveExtension = saveExtension;
        window.fetchExtensions = fetchExtensions;
        window.previewEmployeePhoto = previewEmployeePhoto;
        window.clearEmployeePhoto = clearEmployeePhoto;
        window.resetEmployeeProfileFields = resetEmployeeProfileFields;
        window.showEmployeePhotoPreview = showEmployeePhotoPreview;
        window.setEmployeeGroupOptions = setEmployeeGroupOptions;
        window.loadEmployeeGroups = loadEmployeeGroups;
        window.saveEmployeeExtras = saveEmployeeExtras;

        // --- 2. RING GROUPS ---
        document.addEventListener('DOMContentLoaded', () => {
            const rgNumEl = document.getElementById('rgNum');
            if (rgNumEl) {
                rgNumEl.addEventListener('input', () => {
                    const isEdit = document.getElementById('rgEditMode').value === "true";
                    if (!isEdit) {
                        const num = rgNumEl.value.trim() || '600';
                        const destVal = `ext-group,${num},1`;
                        const noticeNumEl = document.getElementById('rgPostDestCreateNoticeNum');
                        if (noticeNumEl) noticeNumEl.textContent = destVal;
                        document.getElementById('rgPostDestination').value = destVal;
                    }
                });
            }
        });
        function renderQuickPickPills() {
            const container = document.getElementById('rgQuickPickContainer');
            if (!container) return;
            container.innerHTML = '';
            
            const currentSelected = parseRgListArray();

            // 1. Local extensions
            (loadedExtensionsList || []).forEach(ext => {
                const extStr = String(ext.extension);
                const isSelected = currentSelected.includes(extStr);
                const pill = document.createElement('div');
                pill.className = `ext-pill text-xs px-2.5 py-1 rounded-lg border font-mono font-bold cursor-pointer transition-all ${isSelected ? 'active bg-emerald-500/20 text-emerald-400 border-emerald-500/40' : 'bg-[var(--bg-secondary)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-emerald-500/40'}`;
                pill.textContent = `${ext.extension} (${ext.name || 'Ext'})`;
                pill.onclick = () => toggleQuickPickExt(extStr);
                container.appendChild(pill);
            });

            // 2. Remote federation extensions
            (loadedRemoteExtensionsList || []).forEach(re => {
                const peer = (loadedFederationPeersList || []).find(p => Number(p.id) === Number(re.peer_id));
                const peerLabel = peer ? (peer.node_name || 'Site ' + peer.site_code) : 'Remote';
                const targetDial = `${re.dial_alias}#`;
                const isSelected = currentSelected.includes(targetDial) || currentSelected.includes(String(re.dial_alias));
                const pill = document.createElement('div');
                pill.className = `ext-pill text-xs px-2.5 py-1 rounded-lg border font-mono font-bold cursor-pointer transition-all ${isSelected ? 'active bg-purple-500/20 text-purple-400 border-purple-500/40' : 'bg-purple-500/5 text-purple-300 border-purple-500/20 hover:border-purple-500/40'}`;
                pill.textContent = `[${peerLabel}] ${re.native_extension} (${re.display_name || ''}) #${re.dial_alias}`;
                pill.onclick = () => toggleQuickPickExt(targetDial);
                container.appendChild(pill);
            });

            if (container.children.length === 0) {
                container.innerHTML = '<span class="text-[11px] text-[var(--text-muted)]">No extensions available.</span>';
            }
        }

        function parseRgListArray() {
            const val = document.getElementById('rgList').value || '';
            return val.split(/[\s\-,]+/).map(s => s.trim()).filter(Boolean);
        }

        function toggleQuickPickExt(extNum) {
            let list = parseRgListArray();
            if (list.includes(extNum)) {
                list = list.filter(e => e !== extNum);
            } else {
                list.push(extNum);
            }
            document.getElementById('rgList').value = list.join(', ');
            renderQuickPickPills();
        }

        function clearQuickPickExts() {
            document.getElementById('rgList').value = '';
            renderQuickPickPills();
        }

        function populateAnnouncementsDropdown() {
            const sel = document.getElementById('rgAnnMsg');
            if (!sel) return;
            sel.innerHTML = '<option value="0">None / No Announcement</option>';
            (loadedRecordingsList || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = `${r.displayname} (ID: ${r.id})`;
                sel.appendChild(opt);
            });
        }

        function populateMohRingGroupDropdown() {
            const sel = document.getElementById('rgRinging');
            if (!sel) return;
            const currentVal = sel.value || 'Ring';
            sel.innerHTML = `<option value="Ring">${isRtl ? 'نغمة الرنين (افتراضي)' : 'Ring (Default Ringtone)'}</option>`;
            const mohList = typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : [];
            mohList.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.name;
                opt.textContent = `${isRtl ? 'موسيقى الانتظار:' : 'Music on Hold:'} ${cat.name}${cat.fileCount !== undefined ? ` (${cat.fileCount} ${isRtl ? 'مقاطع' : 'tracks'})` : ''}`;
                sel.appendChild(opt);
            });
            sel.value = currentVal;
        }

        function fetchRingGroups() {
            const tbody = document.getElementById('ringgroups-table-body');
            return fetch('/api/config/ringgroups')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    loadedRingGroupsList = Array.isArray(data.ringgroups) ? data.ringgroups : [];
                    const list = loadedRingGroupsList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="10" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد مجموعات اتصال.' : 'No ring groups found.') + '</td></tr>';
                        return;
                    }
                    list.forEach(rg => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const recMatch = (loadedRecordingsList || []).find(r => r.id == rg.annmsg_id);
                        const annText = recMatch ? recMatch.displayname : (rg.annmsg_id ? 'ID #' + rg.annmsg_id : 'None');
                        const mohDisplay = (!rg.ringing || rg.ringing === 'Ring')
                            ? `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-slate-500/15 text-slate-400 border border-slate-500/20">Ring</span>`
                            : `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-amber-500/15 text-amber-300 border border-amber-500/20 truncate max-w-[120px] inline-block align-middle" title="MoH: ${rg.ringing}">MoH: ${rg.ringing}</span>`;

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${rg.grpnum}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${rg.description || '-'}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${rg.strategy || 'ringall'}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${annText}</td>
                            <td class="py-3 px-4">${mohDisplay}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${rg.grplist}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">Yes</span></td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded bg-purple-500/15 text-purple-400 border border-purple-500/20">Always</span></td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-bold">${formatDestination(rg.postdest)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editRingGroup('${rg.grpnum}')" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteRingGroup('${rg.grpnum}')" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function getNextAvailableRingGroupNum() {
            const existingNums = new Set((loadedRingGroupsList || []).map(rg => String(rg.grpnum)));
            let candidate = 600;
            while (existingNums.has(String(candidate))) {
                candidate++;
            }
            return String(candidate);
        }

        function openRingGroupModal() {
            openModal('ringGroupModal');
            document.getElementById('rgModalTitle').textContent = isRtl ? 'إضافة مجموعة جديدة' : 'Add Ring Group';
            document.getElementById('rgEditMode').value = "false";
            document.getElementById('rgNum').disabled = false;
            document.getElementById('ringGroupForm').reset();

            const num = getNextAvailableRingGroupNum();
            document.getElementById('rgNum').value = num;

            populateAnnouncementsDropdown();
            populateMohRingGroupDropdown();
            document.getElementById('rgRinging').value = 'Ring';
            renderQuickPickPills();

            const destVal = `ext-group,${num},1`;
            document.getElementById('rgPostDestination').value = destVal;
            const noticeNumEl = document.getElementById('rgPostDestCreateNoticeNum');
            if (noticeNumEl) noticeNumEl.textContent = destVal;

            initDestinationSelectInstances();
            if (rgPostDestSelectInstance) rgPostDestSelectInstance.setDialplan(destVal);
            if (typeof ensureAllConfigListsLoaded === 'function') {
                ensureAllConfigListsLoaded().then(() => {

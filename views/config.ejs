                if (popup.parentNode !== document.body) {
                    document.body.appendChild(popup);
                }
                window.positionDonglePopup = function() {
                    if (popup.classList.contains('hidden')) return;
                    const rect = dialInput.getBoundingClientRect();
                    const width = Math.min(Math.max(rect.width, 460), window.innerWidth - 16);
                    popup.style.width = width + 'px';
                    let left = rect.left;
                    if (left + width > window.innerWidth - 8) {
                        left = window.innerWidth - width - 8;
                    }
                    if (left < 8) left = 8;
                    popup.style.position = 'fixed';
                    popup.style.left = left + 'px';
                    popup.style.zIndex = '999999';
                    const maxAvailHeight = Math.min(window.innerHeight - 30, 280);
                    popup.style.maxHeight = maxAvailHeight + 'px';
                    const spaceBelow = window.innerHeight - rect.bottom;
                    const spaceAbove = rect.top;
                    const popupEstHeight = Math.min(popup.offsetHeight || 220, maxAvailHeight);
                    if (spaceBelow < popupEstHeight && spaceAbove > spaceBelow) {
                        popup.style.top = 'auto';
                        popup.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
                    } else {
                        popup.style.top = (rect.bottom + 6) + 'px';
                        popup.style.bottom = 'auto';
                    }
                };

                dialInput.addEventListener('focus', () => {
                    popup.classList.remove('hidden');
                    window.positionDonglePopup();
                    loadDongleInfoPopup();
                });
                dialInput.addEventListener('click', () => {
                    popup.classList.remove('hidden');
                    window.positionDonglePopup();
                });
                document.addEventListener('click', (e) => {
                    if (!dialInput.contains(e.target) && !popup.contains(e.target)) {
                        popup.classList.add('hidden');
                    }
                });
                window.addEventListener('scroll', () => {
                    if (!popup.classList.contains('hidden')) window.positionDonglePopup();
                }, true);
                window.addEventListener('resize', () => {
                    if (!popup.classList.contains('hidden')) window.positionDonglePopup();

                    if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-rose-400 font-semibold">' + (isRtl ? 'خطأ في جلب بيانات التحويلات.' : 'Error fetching extensions.') + '</td></tr>';
                });

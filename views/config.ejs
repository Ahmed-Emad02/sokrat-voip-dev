            scroll-behavior: smooth !important;   /* smooth wheel / drag / programmatic scrolling */
            -webkit-overflow-scrolling: touch;
            scroll-padding-inline: 1rem;
            cursor: grab;
            overscroll-behavior-x: contain;
            touch-action: pan-x;
        }
        #configTopPillsScroll::-webkit-scrollbar {
            display: none !important;
        }
        #configTopPillsScroll.is-dragging {
            cursor: grabbing;
            user-select: none;
        }
        /* While we drive the scroll ourselves the CSS smooth scrolling must be
           switched off - an !important declaration beats an inline style, so it
           cannot be done from JavaScript. */
        #configTopPillsScroll.is-gliding {
            scroll-behavior: auto !important;
        }
        /* Edge fades that appear only when there is content to scroll to,
           giving the hidden scrollbar a visual affordance. */
        #configTopPillBar { position: relative; }
        #configTopPillBar::before,

                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="22"/><line x1="2" y1="12" x2="9" y2="12"/><line x1="15" y1="12" x2="22" y2="12"/></svg>
                                <span><%= isRtl ? 'المخطط الدائري (Radial)' : 'Radial Topology' %></span>
                            </button>
                            <button type="button" id="btnDiagramViewPipeline" onclick="setDiagramViewMode('pipeline')" class="px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-muted)] hover:text-white border border-transparent">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h7"/></svg>
                                <span><%= isRtl ? 'مخطط التدفق (Pipeline)' : 'Pipeline Flow' %></span>
                            </button>
                        </div>

                        <!-- Search input -->

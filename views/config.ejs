                    </label>
                    <label for="editPeerAllowReportRead" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="editPeerAllowReportRead" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'قراءة التقارير والسجلات' : 'Read reports &amp; CDR' %></span>
                    </label>
                    <label for="editPeerAllowContactWrite" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="editPeerAllowContactWrite" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بكتابة جهات الاتصال' : 'Allow contact writes' %></span>
                    </label>
                    <label for="editPeerAllowDongleControl" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="editPeerAllowDongleControl" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالتحكم في الشرائح' : 'Allow dongle control' %></span>
                    </label>
                    <label for="editPeerAllowCampaignControl" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="editPeerAllowCampaignControl" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالتحكم في الحملات' : 'Allow campaign control' %></span>
                    </label>
                    <label for="editPeerAllowConfigWrite" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="editPeerAllowConfigWrite" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بتعديل الإعدادات عن بُعد' : 'Allow remote configuration writes' %></span>
                    </label>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('editPeerModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'حفظ التغييرات' : 'Save Changes' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: LOCAL PBX FEDERATION SETTINGS -->
    <div id="federationSettingsModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden shadow-2xl">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إعدادات هوية هذا السيرفر' : 'Local PBX Identity & Central Panel' %></h3>
                <button type="button" onclick="closeModal('federationSettingsModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="saveFederationSettings(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-amber-400 uppercase mb-1" for="localSiteCodeInput"><%= isRtl ? 'كود هذا الموقع (Local Site Code) *' : 'Local Site Code *' %></label>
                    <input type="text" id="localSiteCodeInput" value="<%= fedLocalSite %>" required placeholder="10" maxlength="6" class="config-input w-full font-mono text-xs font-bold text-amber-400">
                    <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'كود موقع هذا السيرفر الذي تستخدمه السيرفرات الأخرى للاتصال به' : 'Numeric site code used by other servers to route calls to this PBX' %></span>
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="localNodeNameInput"><%= isRtl ? 'اسم هذا السيرفر *' : 'Local PBX Name *' %></label>
                    <input type="text" id="localNodeNameInput" value="<%= fedLocalName %>" required placeholder="Main PBX" class="config-input w-full text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="localPanelRoleSelect"><%= isRtl ? 'دور لوحة المراقبة (Operator Panel Role)' : 'Operator Panel Role' %></label>
                    <select id="localPanelRoleSelect" class="config-input w-full text-xs">
                        <option value="local" <%= fedLocalRole === 'local' ? 'selected' : '' %>><%= isRtl ? 'سيرفر محلي عادي — يعرض بياناته فقط (Local PBX)' : 'Local PBX — shows only its own data' %></option>
                        <option value="central" <%= fedLocalRole === 'central' ? 'selected' : '' %>><%= isRtl ? 'سيرفر مركزي — يجمع كل السيرفرات (Central Hub)' : 'Central Hub — aggregates every connected PBX' %></option>
                    </select>
                    <span class="text-[10px] text-[var(--text-muted)] block mt-1 leading-relaxed">
                        <%= isRtl
                            ? 'السيرفر المركزي فقط يعرض قائمة اختيار السيرفرات في الشريط العلوي ويدمج التقارير والشرائح وجهات الاتصال واللوحة المباشرة. السيرفرات المحلية تبقى كما هي بدون أي دمج.'
                            : 'Only the Central Hub shows the PBX multi-select in the top bar and merges reports, dongles, contacts and the live panel from peers. Local PBXs keep their normal single-server view.' %>
                    </span>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('federationSettingsModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'حفظ الإعدادات' : 'Save Settings' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: BUILT-IN LOCAL DEVICE WEB CONSOLE (Live Reverse Proxy) -->
    <div id="deviceWebConsoleModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-2 sm:p-4">
        <div id="deviceWebConsoleDialog" class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] w-full max-w-6xl h-[92vh] flex flex-col shadow-2xl transition-all duration-200 overflow-hidden">
            <!-- Modal Top Bar -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/80 shrink-0 gap-3">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0">
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                    </span>
                    <div class="min-w-0">
                        <h3 id="deviceWebConsoleTitle" class="text-sm font-extrabold text-[var(--text-primary)] truncate">Device Web Console</h3>
                        <div class="flex items-center gap-1.5 text-[10px] text-[var(--text-muted)] font-mono">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            <span id="deviceWebConsoleSubTitle">192.168.100.x:80</span>
                            <span>&bull;</span>
                            <span class="text-cyan-400 font-bold"><%= isRtl ? 'بروكسي محلي مشفر' : 'Local Reverse Proxy' %></span>
                        </div>
                    </div>
                </div>

                <!-- Browser Controls Strip -->
                <div class="flex items-center gap-2 flex-1 max-w-md mx-2">
                    <button type="button" onclick="reloadDeviceWebConsole()" class="p-1.5 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white transition cursor-pointer" title="<%= isRtl ? 'إعادة تحميل' : 'Reload' %>">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </button>
                    <div class="relative flex-1">
                        <input type="text" id="deviceWebConsoleUrlBar" readonly class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1 text-[11px] font-mono text-[var(--text-muted)] focus:outline-none select-all">
                    </div>
                </div>

                <!-- Actions: Expand / New Tab / Close -->
                <div class="flex items-center gap-1.5 shrink-0">
                    <a id="deviceWebConsoleNewTabBtn" href="#" target="_blank" class="px-2.5 py-1 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] hover:text-white transition flex items-center gap-1" title="<%= isRtl ? 'فتح في علامة تبويب جديدة' : 'Open in Dedicated Tab' %>">
                        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                        <span class="hidden sm:inline"><%= isRtl ? 'نافذة جديدة' : 'New Tab' %></span>
                    </a>
                    <button type="button" onclick="toggleDeviceWebConsoleFullscreen()" id="deviceWebConsoleFullscreenBtn" class="p-1.5 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white transition cursor-pointer" title="<%= isRtl ? 'ملء الشاشة' : 'Fullscreen' %>">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0-4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
                    </button>
                    <button type="button" onclick="closeDeviceWebConsoleModal()" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-white hover:border-red-500/40 flex items-center justify-center cursor-pointer transition">✕</button>
                </div>
            </div>

            <!-- Browser View Body (Iframe) -->
            <div class="flex-1 w-full bg-white relative overflow-hidden flex flex-col">
                <div id="deviceWebConsoleLoading" class="absolute inset-0 bg-[var(--bg-card)] flex flex-col items-center justify-center gap-3 z-10 transition-opacity duration-200">
                    <div class="w-8 h-8 rounded-full border-2 border-cyan-500/20 border-t-cyan-500 animate-spin"></div>
                    <span class="text-xs font-mono text-[var(--text-muted)]"><%= isRtl ? 'جاري الاتصال بالجهاز عبر البروكسي المحلي...' : 'Connecting to local device via secure proxy...' %></span>
                </div>
                <iframe id="deviceWebConsoleIframe" class="w-full flex-1 border-0" onload="onDeviceWebConsoleIframeLoaded()"></iframe>
            </div>
        </div>
    </div>
    <!-- CLIENT SCRIPT -->
    <script src="/js/config-page.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : 'dev' %>&lang=<%= isRtl ? 'ar' : 'en' %>"></script>
</body>
</html>

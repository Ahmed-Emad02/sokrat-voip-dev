                        <button onclick="fitDiagramToScreen()" title="<%= isRtl ? 'ملائمة الشاشة' : 'Fit View' %>" class="px-2.5 py-1.5 bg-[var(--bg-card)] border border-[var(--border-primary)] hover:bg-[var(--bg-hover)] text-xs font-semibold rounded-lg cursor-pointer transition flex items-center gap-1 text-[var(--text-primary)]">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 4l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                            <span><%= isRtl ? 'ملائمة الشاشة' : 'Fit View' %></span>
                        </button>
                        <button onclick="resetDiagramZoom()" title="<%= isRtl ? 'إعادة ضبط' : 'Reset Zoom' %>" class="px-2.5 py-1.5 bg-[var(--bg-card)] border border-[var(--border-primary)] hover:bg-[var(--bg-hover)] text-xs font-semibold rounded-lg cursor-pointer transition">
                            <%= isRtl ? 'إعادة ضبط' : 'Reset' %>
                        </button>
                    </div>
                </div>

                <!-- Diagram Color Legend Bar -->
                <div class="flex flex-wrap items-center gap-3 mb-3 p-2 rounded-lg border border-[var(--border-primary)] bg-[var(--bg-card)]/30 text-[11px] font-bold">
                    <span class="text-[var(--text-muted)] uppercase text-[10px]"><%= isRtl ? 'دليل الألوان:' : 'Color Legend:' %></span>
                    <span class="flex items-center gap-1.5 text-emerald-400"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span><%= isRtl ? 'مسارات واردة' : 'Inbound Routes' %></span>
                    <span class="flex items-center gap-1.5 text-yellow-400"><span class="w-2.5 h-2.5 rounded-full bg-yellow-500"></span><%= isRtl ? 'شروط الوقت' : 'Time Conditions' %></span>
                    <span class="flex items-center gap-1.5 text-blue-400"><span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span><%= isRtl ? 'الرد الآلي (IVR)' : 'IVR Menus' %></span>
                    <span class="flex items-center gap-1.5 text-purple-400"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span><%= isRtl ? 'مجموعات الاتصال' : 'Ring Groups' %></span>
                    <span class="flex items-center gap-1.5 text-amber-400"><span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span><%= isRtl ? 'طوابير الانتظار (Queues)' : 'Call Queues' %></span>
                    <span class="flex items-center gap-1.5 text-red-400"><span class="w-2.5 h-2.5 rounded-full bg-red-500"></span><%= isRtl ? 'التحويلات' : 'Extensions' %></span>
                    <span class="flex items-center gap-1.5 text-orange-400"><span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span><%= isRtl ? 'مسارات صادرة' : 'Outbound Routes' %></span>
                    <span class="flex items-center gap-1.5 text-cyan-400"><span class="w-2.5 h-2.5 rounded-full bg-cyan-500"></span><%= isRtl ? 'خطوط الربط' : 'Trunks' %></span>
                </div>

                <!-- Canvas Wrapper -->
                <div id="diagramCanvasContainer" class="relative w-full border border-[var(--border-primary)] rounded-xl overflow-auto bg-[#09090b]" style="height: calc(100vh - 280px); min-height: 700px;">
                    <svg id="diagramSvg" class="w-full h-full cursor-grab active:cursor-grabbing select-none">
                        <!-- Grid pattern definition -->
                        <defs>
                            <pattern id="grid-pattern" width="30" height="30" patternUnits="userSpaceOnUse">
                                <circle cx="2" cy="2" r="1.5" fill="#222" />
                            </pattern>
                            <!-- Drop shadow filter for highlights -->
                            <filter id="glow-filter" x="-40%" y="-40%" width="180%" height="180%" filterUnits="userSpaceOnUse">
                                <feDropShadow dx="0" dy="0" stdDeviation="3" flood-color="#ffffff" flood-opacity="0.8" />
                            </filter>
                        </defs>
                        <!-- Grid rect -->
                        <rect width="100%" height="100%" fill="url(#grid-pattern)" />
                        <!-- Zoom and pan group -->
                        <g id="diagramViewport" transform="translate(0,0) scale(1)">
                            <!-- Connections / Wires -->
                            <g id="diagramConnections"></g>
                            <!-- Nodes / Cards -->
                            <g id="diagramNodes"></g>
                        </g>
                    </svg>
                </div>
            </div>
        </div>
        <% } %>

        <!-- TAB 9: TIME GROUPS -->
        <% if (isTabAllowed('timegroups')) { %>
        <div id="section-timegroups" class="tab-section hidden">

        }
        .trunk-highlighted-red {
            background-color: rgba(239, 68, 68, 0.22) !important;
            border-left: 4px solid #ef4444 !important;
            border-right: 4px solid #ef4444 !important;
            animation: trunkGlowPulse 2.4s ease-in-out infinite;
            transition: background-color 700ms ease, border-color 700ms ease, box-shadow 700ms ease !important;
        }
        .light-theme .trunk-highlighted-red {
            background-color: #fee2e2 !important;
            border-left: 4px solid #dc2626 !important;
            border-right: 4px solid #dc2626 !important;
        }

        /* --- SOKRAT DUAL-RING ROTATING LOADER --- */
        .loader {
            --loader-color: currentColor;
            --loader-thickness: 3px;
            width: 60px;
            height: 30px;
            display: inline-grid;
            vertical-align: middle;
            --c: #0000 calc(100% - var(--loader-thickness)),
                 var(--loader-color) calc(100% - calc(var(--loader-thickness) - 1px)) 96%,
                 #0000;
            background:
                radial-gradient(farthest-side at bottom, var(--c)) 0 0,
                radial-gradient(farthest-side at top   , var(--c)) 100% 100%;
            background-size: calc(50% + 1.5px) 50%;
            background-repeat: no-repeat;
            animation: sokratLoaderRing 1.5s infinite linear;
        }
        .loader::before,
        .loader::after {
            content: "";
            grid-area: 1/1;
            background: inherit;
            animation: inherit;
            animation-duration: 2s;
        }
        .loader::after {
            --s: -1;
        }
        @keyframes sokratLoaderRing {
            100% { transform: rotate(calc(var(--s, 1) * 1turn)); }
        }
        /* Button-Sized Modifier */
        .loader-btn {
            width: 20px;
            height: 10px;
            --loader-thickness: 2px;
            margin-inline-end: 0.35rem;
            flex-shrink: 0;
            display: inline-grid;
        }
        /* Extra Compact */
        .loader-xs {
            width: 16px;
            height: 8px;
            --loader-thickness: 1.6px;
            margin-inline-end: 0.25rem;
            flex-shrink: 0;
            display: inline-grid;
        }
        html.light-theme {
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --bg-card: #f1f5f9;
            --bg-hover: #e2e8f0;
            --border-primary: #cbd5e1;
            --border-accent: #94a3b8;
            --text-primary: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
        }
        /* --- Config top pills: smooth horizontal scrolling -----------------
           The pill bar scrolls horizontally; keep the last pill reachable and
           the scrolling smooth. */
        #configTopPillsScroll > *:last-child {
            margin-inline-end: 0.75rem;
        }
        /* --- Audio player controls -----------------------------------------
           The Tailwind arbitrary-value utilities (bg-[var(--accent-color)])
           are not generated on this page, and the global sidebar stylesheet
           forces every button[data-player-playpause] / [data-player-mute] to
           be borderless and transparent - a white icon then sits on an
           invisible button. These rules are attribute-qualified so they win
           over that global rule. */
        body button[data-player-playpause].audio-play-btn {
            background-color: var(--accent-color) !important;
            color: #ffffff !important;
            border: 0 !important;
        }
        body button[data-player-playpause].audio-play-btn:hover {
            background-color: var(--accent-hover) !important;
        }
        body button[data-player-playpause].audio-play-btn * {
            color: #ffffff !important;
            fill: #ffffff !important;
            stroke: #ffffff !important;
        }
        body button[data-player-mute].audio-icon-btn {
            background-color: var(--bg-card) !important;
            color: var(--text-secondary) !important;
            border: 1px solid var(--border-primary) !important;
        }
        body button[data-player-mute].audio-icon-btn:hover {
            background-color: var(--bg-hover) !important;
            color: #ffffff !important;
        }
        body button[data-player-mute].audio-icon-btn * {
            color: inherit !important;
            stroke: currentColor !important;
        }
        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
            min-height: 100vh;
        }

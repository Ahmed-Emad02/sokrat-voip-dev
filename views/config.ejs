        // Load dongle list for inbound route DID pop-up helper
        function loadInboundDonglePopup() {
            const listContainer = document.getElementById('inboundDongleList');
            if (!listContainer) return;

            listContainer.innerHTML = '<span class="text-[11px] text-[var(--text-muted)]">Loading...</span>';
            const isRtl = '<%= isRtl %>' === 'true';

            fetch('/api/config/dongle-mappings')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.mappings || data.mappings.length === 0) {
                        listContainer.innerHTML = `<span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'لا توجد أجهزة متصلة' : 'No connected dongles found.'}</span>`;
                        return;
                    }

                    listContainer.innerHTML = '';
                    data.mappings.forEach(d => {
                        const div = document.createElement('div');
                        div.className = 'flex flex-col sm:flex-row sm:items-center justify-between p-2.5 hover:bg-[var(--bg-hover)]/30 rounded-lg border border-[var(--border-primary)]/40 gap-2 font-mono text-[11px] flex-wrap whitespace-normal break-all';

                        const stateStr = String(d.state || '').toLowerCase();
                        const statusColor = stateStr === 'free' ? 'text-green-400' : 'text-amber-400';
                        const num = d.phoneNumber || (d.simNumber !== 'Unknown' && d.simNumber !== '-' ? d.simNumber : '');

                        const infoDiv = document.createElement('div');
                        infoDiv.className = 'flex flex-col text-left';

                        const titleSpan = document.createElement('span');
                        titleSpan.className = 'font-bold text-[var(--text-primary)]';
                        titleSpan.textContent = d.dongleName + (num ? ' (' + num + ')' : ' ');

                        const stateSpan = document.createElement('span');
                        stateSpan.className = 'text-[10px] ' + statusColor + ' ml-1.5 font-semibold';
                        stateSpan.textContent = d.state || 'Unknown';
                        titleSpan.appendChild(stateSpan);

                        const providerSpan = document.createElement('span');
                        providerSpan.className = 'text-[10px] text-[var(--text-muted)]';
                        providerSpan.textContent = 'Provider: ' + (d.provider || 'None');

                        infoDiv.appendChild(titleSpan);
                        infoDiv.appendChild(providerSpan);

                        const btnGroup = document.createElement('div');
                        btnGroup.className = 'flex items-center gap-1.5 shrink-0';

                        if (num) {
                            const btnNum = document.createElement('button');
                            btnNum.type = 'button';
                            btnNum.className = 'px-2 py-0.5 text-[9px] bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded cursor-pointer transition-colors';
                            btnNum.textContent = 'Use Number (' + num + ')';
                            btnNum.addEventListener('click', () => selectInboundDid(num));
                            btnGroup.appendChild(btnNum);
                        }

                        div.appendChild(infoDiv);
                        div.appendChild(btnGroup);
                        listContainer.appendChild(div);
                    });
                    if (typeof window.positionInboundDonglePopup === 'function') window.positionInboundDonglePopup();
                })
                .catch(err => {
                    listContainer.innerHTML = `<span class="text-[11px] text-red-400">Error: ${err.message}</span>`;
                    if (typeof window.positionInboundDonglePopup === 'function') window.positionInboundDonglePopup();
                });
        }

        // Load dongle list for custom dial string pop-up helper
        function loadDongleInfoPopup() {
            const listContainer = document.getElementById('dongleInfoList');
            if (!listContainer) return;
            
            listContainer.innerHTML = '<span class="text-[11px] text-[var(--text-muted)]">Loading...</span>';
            const isRtl = '<%= isRtl %>' === 'true';
            
            fetch('/api/gsm-dongles')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.devices || data.devices.length === 0) {
                        listContainer.innerHTML = `<span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'لا توجد أجهزة متصلة' : 'No connected dongles found.'}</span>`;
                        return;
                    }
                    
                    listContainer.innerHTML = '';
                    data.devices.forEach(d => {
                        const div = document.createElement('div');
                        div.className = 'flex flex-col sm:flex-row sm:items-center justify-between p-2.5 hover:bg-[var(--bg-hover)]/30 rounded-lg border border-[var(--border-primary)]/40 gap-2 font-mono text-[11px]';
                        
                        const statusColor = d.State.toLowerCase() === 'free' ? 'text-green-400' : 'text-amber-400';
                        const cleanImei = String(d.IMEI || '').trim();
                        const hasImei = cleanImei && cleanImei !== '-';
                        const provider = d['Provider Name'] || 'None';

                        const dongleIdName = escapeHtml(d.ID || d.dongleName || '');
                        const numStr = d.Number && d.Number !== 'Unknown' && d.Number !== '-' ? ` (${escapeHtml(d.Number)})` : '';
                        div.innerHTML = `
                            <div class="flex flex-col text-left">
                                <span class="font-bold text-[var(--text-primary)]">
                                    ${dongleIdName}${numStr}
                                    <span class="text-[10px] ${statusColor} ml-1.5 font-semibold">${escapeHtml(d.State || '')}</span>
                                </span>
                                <span class="text-[10px] text-[var(--text-muted)]">Provider: ${escapeHtml(provider)} | IMEI: ${escapeHtml(cleanImei)}</span>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="selectDialFormat('dongle/${dongleIdName}/$OUTNUM$')" class="px-2 py-0.5 text-[9px] bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded cursor-pointer transition-colors">
                                    Use ID (${dongleIdName})
                                </button>
                                ${hasImei ? `
                                <button type="button" onclick="selectDialFormat('dongle/i:${escapeHtml(cleanImei)}/$OUTNUM$')" class="px-2 py-0.5 text-[9px] bg-purple-500/10 hover:bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded cursor-pointer transition-colors">
                                    Use IMEI
                                </button>
                                ` : ''}
                            </div>
                        `;
                        listContainer.appendChild(div);
                    });
                    if (typeof window.positionDonglePopup === 'function') window.positionDonglePopup();
                })
                .catch(err => {
                    listContainer.innerHTML = `<span class="text-[11px] text-red-400">Error: ${err.message}</span>`;
                    if (typeof window.positionDonglePopup === 'function') window.positionDonglePopup();
                });
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            const tabButtons = ['extensions', 'ringgroups', 'inbound', 'trunks', 'outbound', 'queues', 'timegroups', 'timeconditions', 'voicemail', 'ivr', 'recordings', 'diagram', 'announcements', 'modem', 'dongles', 'terminal'];
            let defaultTab = null;
            for (const t of tabButtons) {
                if (document.getElementById('tab-btn-' + t)) {
                    defaultTab = t;
                    break;
                }
            }
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam && document.getElementById('tab-btn-' + tabParam)) {
                defaultTab = tabParam;
            }
            if (defaultTab) {
                switchTab(defaultTab);
            }
            const dialInput = document.getElementById('trunkDialString');
            const popup = document.getElementById('dongleInfoPopup');
            if (dialInput && popup) {
                if (popup.parentNode !== document.body) {
                    document.body.appendChild(popup);
                }
                window.positionDonglePopup = function() {
                    if (popup.classList.contains('hidden')) return;
                    const rect = dialInput.getBoundingClientRect();
                    const width = Math.min(Math.max(rect.width, 460), window.innerWidth - 16);
                    popup.style.width = width + 'px';
                    let left = rect.left;
                    if (left + width > window.innerWidth - 8) {
                        left = window.innerWidth - width - 8;
                    }
                    if (left < 8) left = 8;
                    popup.style.position = 'fixed';
                    popup.style.left = left + 'px';
                    popup.style.zIndex = '999999';
                    const maxAvailHeight = Math.min(window.innerHeight - 30, 280);
                    popup.style.maxHeight = maxAvailHeight + 'px';
                    const spaceBelow = window.innerHeight - rect.bottom;
                    const spaceAbove = rect.top;
                    const popupEstHeight = Math.min(popup.offsetHeight || 220, maxAvailHeight);
                    if (spaceBelow < popupEstHeight && spaceAbove > spaceBelow) {
                        popup.style.top = 'auto';
                        popup.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
                    } else {
                        popup.style.top = (rect.bottom + 6) + 'px';
                        popup.style.bottom = 'auto';
                    }
                };

                dialInput.addEventListener('focus', () => {
                    popup.classList.remove('hidden');
                    window.positionDonglePopup();
                    loadDongleInfoPopup();
                });
                dialInput.addEventListener('click', () => {
                    popup.classList.remove('hidden');
                    window.positionDonglePopup();
                });
                document.addEventListener('click', (e) => {
                    if (!dialInput.contains(e.target) && !popup.contains(e.target)) {
                        popup.classList.add('hidden');
                    }
                });
                window.addEventListener('scroll', () => {
                    if (!popup.classList.contains('hidden')) window.positionDonglePopup();
                }, true);
                window.addEventListener('resize', () => {
                    if (!popup.classList.contains('hidden')) window.positionDonglePopup();
                });
            }
            // Inbound route DID dongle popup handlers
            const inExtInput = document.getElementById('inExtension');
            const inPopup = document.getElementById('inboundDongleInfoPopup');
            if (inExtInput && inPopup) {
                if (inPopup.parentNode !== document.body) {
                    document.body.appendChild(inPopup);
                }

                window.positionInboundDonglePopup = function() {
                    if (inPopup.classList.contains('hidden')) return;
                    const rect = inExtInput.getBoundingClientRect();
                    const width = Math.min(Math.max(rect.width, 460), window.innerWidth - 16);
                    inPopup.style.width = width + 'px';
                    let left = rect.left;
                    if (left + width > window.innerWidth - 8) {
                        left = window.innerWidth - width - 8;
                    }
                    if (left < 8) left = 8;

                    inPopup.style.position = 'fixed';
                    inPopup.style.left = left + 'px';
                    inPopup.style.zIndex = '999999';

                    const spaceBelow = window.innerHeight - rect.bottom - 16;
                    const spaceAbove = rect.top - 16;
                    const maxPopupHeight = Math.min(320, Math.max(spaceBelow, spaceAbove, 180));

                    inPopup.style.maxHeight = maxPopupHeight + 'px';
                    inPopup.style.overflow = 'hidden';

                    const listEl = document.getElementById('inboundDongleList');
                    if (listEl) {
                        listEl.style.maxHeight = Math.max(80, maxPopupHeight - 45) + 'px';
                        listEl.style.overflowY = 'auto';
                    }

                    if (spaceBelow < 220 && spaceAbove > spaceBelow) {
                        inPopup.style.top = 'auto';
                        inPopup.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
                    } else {
                        inPopup.style.top = (rect.bottom + 6) + 'px';
                        inPopup.style.bottom = 'auto';
                    }
                };

                inExtInput.addEventListener('focus', () => {
                    inPopup.classList.remove('hidden');
                    window.positionInboundDonglePopup();
                    loadInboundDonglePopup();
                });
                inExtInput.addEventListener('click', () => {
                    inPopup.classList.remove('hidden');
                    window.positionInboundDonglePopup();
                });

                document.addEventListener('click', (e) => {
                    if (!inExtInput.contains(e.target) && !inPopup.contains(e.target)) {
                        inPopup.classList.add('hidden');
                    }
                });

                window.addEventListener('scroll', () => {
                    if (!inPopup.classList.contains('hidden')) window.positionInboundDonglePopup();
                }, true);
                window.addEventListener('resize', () => {
                    if (!inPopup.classList.contains('hidden')) window.positionInboundDonglePopup();
                });
            }
        });

        // --- 7. VOICEMAIL CONFIGURATION ---
        let vmExtensionsList = [];

        function fetchVoicemailExtensions() {
            const checklist = document.getElementById('vmMailboxChecklist');
            if (!checklist) return;

            // Always fetch and populate available system recordings into dropdown
            fetch('/api/config/recordings')
                .then(res => res.json())
                .then(recData => {
                    if (recData.success && recData.recordings) {
                        loadedRecordingsList = recData.recordings;
                        populateVmGreetingSelect();
                    }
                })
                .catch(() => {});
            
            checklist.innerHTML = `<span class="text-xs text-[var(--text-muted)] italic">${isRtl ? 'جاري تحميل صناديق البريد...' : 'Loading mailboxes...'}</span>`;
            
            fetch('/api/config/voicemail/extensions')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.extensions) return;
                    vmExtensionsList = data.extensions;
                    checklist.innerHTML = '';
                    
                    if (data.extensions.length === 0) {
                        checklist.innerHTML = `<span class="text-xs text-[var(--text-muted)] italic">${isRtl ? 'لم يتم العثور على تحويلات مفعل بها البريد الصوتي.' : 'No voicemail-enabled extensions found.'}</span>`;
                        return;
                    }
                    
                    data.extensions.forEach(ext => {
                        const label = document.createElement('label');
                        label.className = 'flex items-center justify-between p-2 hover:bg-[var(--bg-hover)]/40 rounded cursor-pointer text-xs';
                        label.innerHTML = `
                            <span class="flex items-center gap-2 font-mono">
                                <input type="checkbox" name="vm_mailbox" value="${ext.extension}" class="tab-checkbox vm-ext-chk">
                                <span class="font-bold text-[var(--text-primary)]">${ext.extension}</span>
                                <span class="text-[var(--text-muted)]">- ${ext.name}</span>
                            </span>
                            ${ext.hasCustomGreeting ? `<span class="text-[10px] text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 px-1 py-0.5 rounded">${isRtl ? 'ترحيب مخصص' : 'Custom Greeting'}</span>` : `<span class="text-[10px] text-[var(--text-muted)] bg-[var(--bg-card)] border border-[var(--border-primary)] px-1 py-0.5 rounded">${isRtl ? 'ترحيب افتراضي' : 'Default Greeting'}</span>`}
                        `;
                        checklist.appendChild(label);
                    });
                })
                .catch(err => {
                    checklist.innerHTML = `<span class="text-xs text-red-400">Error: ${err.message}</span>`;
                });
        }

        function toggleVmAllMailboxes() {
            const allChecked = document.getElementById('vmAllMailboxes').checked;
            const checkboxes = document.querySelectorAll('.vm-ext-chk');
            checkboxes.forEach(chk => chk.checked = allChecked);
        }

        function populateVmGreetingSelect() {
            const selectEl = document.getElementById('vmGreetingSelect');
            if (!selectEl) return;
            const currentVal = selectEl.value;
            selectEl.innerHTML = '<option value="">-- Choose Recording --</option>';
            loadedRecordingsList.forEach(rec => {
                if (rec.displayname === '__invalid') return;
                const opt = document.createElement('option');
                opt.value = rec.id;
                opt.textContent = `${rec.displayname} (${rec.filename})`;
                if (currentVal && String(rec.id) === String(currentVal)) {
                    opt.selected = true;
                }
                selectEl.appendChild(opt);
            });
        }

        function saveVoicemailGreeting(e) {
            e.preventDefault();
            const recordingId = document.getElementById('vmGreetingSelect').value;
            const checkboxes = document.querySelectorAll('.vm-ext-chk:checked');
            const allEnabled = document.getElementById('vmAllMailboxes').checked;
            
            const extensions = Array.from(checkboxes).map(chk => chk.value);
            
            if (!allEnabled && extensions.length === 0) {
                showToast(isRtl ? 'يرجى اختيار تحويلة واحدة على الأقل.' : 'Please select at least one extension mailbox.', 'error');
                return;
            }

            fetch('/api/config/voicemail/greeting', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recordingId, extensions, allEnabled })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchVoicemailExtensions();
                } else showToast(data.error, 'error');
            });
        }

        function resetVoicemailGreetings() {
            const checkboxes = document.querySelectorAll('.vm-ext-chk:checked');
            const allEnabled = document.getElementById('vmAllMailboxes').checked;
            const extensions = Array.from(checkboxes).map(chk => chk.value);
            
            if (!allEnabled && extensions.length === 0) {
                showToast(isRtl ? 'يرجى اختيار تحويلة واحدة على الأقل للإرجاع للوضع الافتراضي.' : 'Please select at least one mailbox to reset.', 'error');
                return;
            }
            
            fetch('/api/config/voicemail/reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ extensions })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchVoicemailExtensions();
                } else showToast(data.error, 'error');
            });
        }

        // --- 8. CONFIG DIAGRAM ENGINE ---
        let diagramRawData = null;
        let diagramNodesList = [];
        let diagramLinks = [];
        
        let zoomScale = 1.0;
        let panX = 0;
        let panY = 0;
        let isDragging = false;
        let startX, startY;
        let isPanZoomInitialized = false;

        function fetchDiagramData() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            if (!svgNodes || !svgWires) return;

            svgNodes.innerHTML = `<foreignObject x="400" y="300" width="400" height="100">
                <div class="text-center text-[var(--text-muted)] italic text-sm">
                    ${isRtl ? 'جاري تحميل مخطط الإعدادات...' : 'Loading config diagram...'}
                </div>
            </foreignObject>`;
            svgWires.innerHTML = '';

            fetch('/api/config/diagram?t=' + Date.now())
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        showToast(data.error || 'Failed to fetch diagram data', 'error');
                        return;
                    }
                    diagramRawData = data;
                    renderDiagram();
                    if (!isPanZoomInitialized) {
                        initPanZoom();
                        isPanZoomInitialized = true;
                    }
                    setTimeout(fitDiagramToScreen, 50);
                })
                .catch(err => {
                    showToast(err.message, 'error');
                });
        }
        window.fetchDiagramData = fetchDiagramData;

        function renderDiagram() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            const svg = document.getElementById('diagramSvg');
            const canvas = document.getElementById('diagramCanvasContainer');
            if (!svgNodes || !svgWires || !svg || !canvas || !diagramRawData) return;

            svgNodes.innerHTML = '';
            svgWires.innerHTML = '';

            const cardWidth = 280;
            const cardHeight = 135;
            const columnGap = 100;
            const rowGap = 30;
            const colSpacing = cardWidth + columnGap;
            const ySpacing = cardHeight + rowGap;
            const fixedTopMargin = 40;
            const bottomPadding = 40;

            function formatDestination(dest) {
                if (!dest) return isRtl ? 'غير محدد' : 'Not set';
                if (dest.startsWith('ext-group,')) {
                    return `${isRtl ? 'مجموعة:' : 'Group:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                    return `${isRtl ? 'تحويلة:' : 'Extension:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    const ivrObj = (diagramRawData.ivrs || []).find(i => String(i.id) === String(ivrId));
                    return `IVR: ${ivrObj ? ivrObj.name : ivrId}`;
                }
                if (dest.startsWith('ext-queues,')) {
                    return `${isRtl ? 'طابور:' : 'Queue:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                    const conditionId = dest.split(',')[1];
                    const condition = (diagramRawData.timeconditions || [])
                        .find(tc => String(tc.timeconditions_id) === String(conditionId));
                    return `${isRtl ? 'شرط زمني' : 'Time Condition'}: ${condition ? condition.displayname : conditionId}`;
                }
                return dest;
            }

            function resolveTargetNodeId(dest) {
                if (!dest) return null;
                if (dest.startsWith('ext-group,')) return 'ringgroup-' + dest.split(',')[1];
                if (dest.startsWith('ext-queues,')) return 'queue-' + dest.split(',')[1];
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) return 'extension-' + dest.split(',')[1];
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) return 'timecondition-' + dest.split(',')[1];
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    return 'ivr-' + ivrId;
                }
                return null;
            }

            const inbound = diagramRawData.inbound || [];
            const ringgroups = diagramRawData.ringgroups || [];
            const extensions = diagramRawData.extensions || [];
            const outbound = diagramRawData.outbound || [];
            const trunks = diagramRawData.trunks || [];
            const timeconditions = diagramRawData.timeconditions || [];
            const queues = diagramRawData.queues || [];
            const ivrs = diagramRawData.ivrs || [];

            const columns = [inbound, timeconditions, ivrs, ringgroups, queues, extensions, outbound, trunks];
            const maxCount = Math.max(...columns.map(column => column.length), 1);
            const contentHeight = Math.max(550, fixedTopMargin
                + maxCount * cardHeight
                + Math.max(maxCount - 1, 0) * rowGap
                + bottomPadding);
            const contentWidth = Math.max(1400, 50 + columns.length * 380 + 100);
            svg.style.height = `${contentHeight}px`;
            svg.style.width = `${contentWidth}px`;
            svg.setAttribute('height', String(contentHeight));
            svg.setAttribute('width', String(contentWidth));

            diagramNodesList = [];
            
            // 1. Inbound Nodes
            inbound.forEach((route, i) => {
                const startY = fixedTopMargin;
                const nodeId = 'inbound-' + (route.did || 'any') + '-' + i;
                diagramNodesList.push({
                    id: nodeId,
                    x: 50,
                    y: startY + i * ySpacing,
                    type: 'inbound',
                    title: route.did ? `DID: ${route.did}` : (isRtl ? 'أي رقم وارد' : 'Any DID'),
                    subtitle: route.description || (isRtl ? 'مسار وارد' : 'Inbound Route'),
                    desc: route.destination,
                    data: route
                });
            });

            // 2. Ring Groups Nodes
            ringgroups.forEach((rg, i) => {
                const startY = fixedTopMargin;
                diagramNodesList.push({
                    id: 'ringgroup-' + rg.grpnum,
                    x: 50 + colSpacing * 3,
                    y: startY + i * ySpacing,
                    type: 'ringgroup',
                    title: `${isRtl ? 'مجموعة:' : 'Group:'} ${rg.grpnum}`,
                    subtitle: rg.description || (isRtl ? 'مجموعة اتصال' : 'Ring Group'),
                    desc: `${isRtl ? 'الاستراتيجية:' : 'Strategy:'} ${rg.strategy}`,
                    data: rg
                });
            });

            // 2.5 IVR Nodes
            ivrs.forEach((ivr, i) => {
                const startY = fixedTopMargin;
                const entriesCount = Array.isArray(ivr.entries) ? ivr.entries.length : 0;
                diagramNodesList.push({
                    id: 'ivr-' + ivr.id,
                    x: 50 + colSpacing * 2,
                    y: startY + i * ySpacing,
                    type: 'ivr',
                    title: `${isRtl ? 'الرد الآلي:' : 'IVR:'} ${ivr.name}`,
                    subtitle: ivr.description || (isRtl ? 'قائمة الرد الآلي' : 'IVR Menu'),
                    desc: `${isRtl ? 'خيارات:' : 'Options:'} ${entriesCount}`,
                    data: ivr
                });
            });

            // 3. Queues Nodes
            queues.forEach((q, i) => {
                const startY = fixedTopMargin;
                diagramNodesList.push({
                    id: 'queue-' + q.extension,
                    x: 50 + colSpacing * 4,
                    y: startY + i * ySpacing,
                    type: 'queue',
                    title: `${isRtl ? 'طابور:' : 'Queue:'} ${q.extension}`,
                    subtitle: q.descr || (isRtl ? 'طابور انتظار' : 'Call Queue'),
                    desc: `${isRtl ? 'أقصى وقت:' : 'Max Wait:'} ${q.maxwait === '0' || !q.maxwait ? 'Unlimited' : q.maxwait + 's'}`,
                    data: q
                });
            });

            // 4. Extensions Nodes
            extensions.forEach((ext, i) => {
                const startY = fixedTopMargin;
                diagramNodesList.push({
                    id: 'extension-' + ext.extension,
                    x: 50 + colSpacing * 5,
                    y: startY + i * ySpacing,
                    type: 'extension',
                    title: `${isRtl ? 'تحويلة:' : 'Ext:'} ${ext.extension}`,
                    subtitle: ext.name || (isRtl ? 'تحويلة SIP' : 'SIP Extension'),
                    desc: ext.voicemail === 'novm' ? (isRtl ? 'البريد مغلق' : 'Voicemail Off') : (isRtl ? 'البريد مفعل' : 'Voicemail On'),
                    data: ext
                });
            });

            // 5. Outbound Routes Nodes
            outbound.forEach((route, i) => {
                const startY = fixedTopMargin;
                const patternStr = route.patterns.map(p => p.pattern).filter(Boolean).slice(0, 2).join(', ');
                diagramNodesList.push({
                    id: 'outbound-' + route.route_id,
                    x: 50 + colSpacing * 6,
                    y: startY + i * ySpacing,
                    type: 'outbound',
                    title: route.name,
                    subtitle: isRtl ? 'مسار صادر' : 'Outbound Route',
                    desc: patternStr ? `${isRtl ? 'أنماط:' : 'Patterns:'} ${patternStr}` : (isRtl ? 'بلا أنماط' : 'No patterns'),
                    data: route
                });
            });

            // 6. Trunks Nodes
            trunks.forEach((tk, i) => {
                const startY = fixedTopMargin;
                diagramNodesList.push({
                    id: 'trunk-' + tk.trunkid,
                    x: 50 + colSpacing * 7,
                    y: startY + i * ySpacing,
                    type: 'trunk',
                    title: tk.name,
                    subtitle: `${tk.tech ? tk.tech.toUpperCase() : 'SIP'} Trunk`,
                    desc: (tk.disabled === 'on') ? (isRtl ? 'معطل' : 'Disabled') : (isRtl ? 'نشط' : 'Active'),
                    data: tk
                });
            });
            // 7. Time Conditions Nodes
            timeconditions.forEach((tc, i) => {
                const startY = fixedTopMargin;
                const scheduleStr = tc.details ? tc.details.map(d => d.time + ' ' + d.name).join('; ') : '';
                diagramNodesList.push({
                    id: 'timecondition-' + tc.timeconditions_id,
                    x: 50 + colSpacing,
                    y: startY + i * ySpacing,
                    type: 'timecondition',
                    title: tc.displayname || (isRtl ? 'شرط زمني' : 'Time Condition'),
                    subtitle: tc.timegroup_name || (isRtl ? 'غير محدد' : 'No group'),
                    desc: scheduleStr || '',
                    data: tc
                });
            });

            diagramLinks = [];

            // Link 1: Inbound -> Ring Groups, Queues, or Extensions
            // Link 1: Inbound -> Destinations
            inbound.forEach((route, idx) => {
                const dest = route.destination || '';
                const targetId = resolveTargetNodeId(dest);
                let wireType = 'inbound-dest';
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) wireType = 'inbound-tc';
                else if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'inbound-ivr';
                if (targetId) {
                    diagramLinks.push({
                        id: `link-inbound-${idx}`,
                        source: 'inbound-' + (route.did || 'any') + '-' + idx,
                        target: targetId,
                        type: wireType
                    });
                }
            });

            // Link 2: Time Condition -> Destinations
            timeconditions.forEach(tc => {
                const trueDest = tc.truegoto || '';
                const falseDest = tc.falsegoto || '';
                [trueDest, falseDest].forEach((dest, isFalse) => {
                    const targetId = resolveTargetNodeId(dest);
                    let wireType = isFalse ? 'tc-false' : 'tc-true';
                    if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'tc-ivr';
                    if (targetId) {
                        diagramLinks.push({
                            id: 'link-tc-' + tc.timeconditions_id + '-' + (isFalse ? 'false' : 'true') + '-' + targetId,
                            source: 'timecondition-' + tc.timeconditions_id,
                            target: targetId,
                            type: wireType
                        });
                    }
                });
            });

            // Link 2.5: IVR -> Options & Destinations
            ivrs.forEach(ivr => {
                const entries = Array.isArray(ivr.entries) ? ivr.entries : [];
                entries.forEach((entry, idx) => {
                    const targetId = resolveTargetNodeId(entry.dest);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-entry-${entry.selection}-${idx}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-entry'
                        });
                    }
                });
                if (ivr.timeout_destination) {
                    const targetId = resolveTargetNodeId(ivr.timeout_destination);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-timeout-${targetId}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-timeout'
                        });
                    }
                }
                if (ivr.invalid_destination) {
                    const targetId = resolveTargetNodeId(ivr.invalid_destination);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-invalid-${targetId}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-invalid'
                        });
                    }
                }
            });

            // Link 3: Ring Group -> Extensions
            ringgroups.forEach(rg => {
                const members = rg.grplist ? rg.grplist.split('-') : [];
                members.forEach(ext => {
                    const extExists = extensions.some(e => String(e.extension) === String(ext));
                    if (extExists) {
                        diagramLinks.push({
                            id: `link-rg-${rg.grpnum}-${ext}`,
                            source: 'ringgroup-' + rg.grpnum,
                            target: 'extension-' + ext,
                            type: 'rg-member'
                        });
                    }
                });
            });

            // Link 3.5: Queue -> Extensions
            queues.forEach(q => {
                const members = Array.isArray(q.static_members) ? q.static_members : [];
                members.forEach(ext => {
                    const extExists = extensions.some(e => String(e.extension) === String(ext));
                    if (extExists) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-${ext}`,
                            source: 'queue-' + q.extension,
                            target: 'extension-' + ext,
                            type: 'queue-member'
                        });
                    }
                });
            });

            // Link 4: Extension -> Outbound Routes
            extensions.forEach(ext => {
                outbound.forEach(route => {
                    const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                    const hasRestrictedCid = patterns.some(p => String(p.cid) === String(ext.extension));
                    const hasGlobalRoute = patterns.some(p => !p.cid || p.cid === '');
                    if (hasRestrictedCid) {
                        diagramLinks.push({
                            id: `link-ext-outbound-${ext.extension}-${route.route_id}`,
                            source: 'extension-' + ext.extension,
                            target: 'outbound-' + route.route_id,
                            type: 'ext-route-restricted'
                        });
                    } else if (hasGlobalRoute) {
                        diagramLinks.push({
                            id: `link-ext-outbound-global-${ext.extension}-${route.route_id}`,
                            source: 'extension-' + ext.extension,
                            target: 'outbound-' + route.route_id,
                            type: 'ext-route-global'
                        });
                    }
                });
            });

            // Link 5: Outbound Route -> Trunks
            outbound.forEach(route => {
                const routeTrunks = Array.isArray(route.trunks) ? route.trunks : [];
                routeTrunks.forEach(tk => {
                    const tkId = tk.trunk_id || tk.trunkid;
                    const matchedTrunk = trunks.find(t => String(t.trunkid) === String(tkId) || (tk.trunk_name && String(t.name) === String(tk.trunk_name)));
                    const targetTrunkId = matchedTrunk ? matchedTrunk.trunkid : tkId;
                    if (targetTrunkId !== undefined && targetTrunkId !== null) {
                        diagramLinks.push({
                            id: `link-outbound-trunk-${route.route_id}-${targetTrunkId}`,
                            source: 'outbound-' + route.route_id,
                            target: 'trunk-' + targetTrunkId,
                            type: 'route-trunk'
                        });
                    }
                });
            });

            // Render Wires
            diagramLinks.forEach(link => {
                const sourceNode = diagramNodesList.find(n => n.id === link.source);
                const targetNode = diagramNodesList.find(n => n.id === link.target);
                if (!sourceNode || !targetNode) return;

                const x1 = sourceNode.x + cardWidth;
                const y1 = sourceNode.y + cardHeight / 2;
                const x2 = targetNode.x;
                const y2 = targetNode.y + cardHeight / 2;

                const colDistance = Math.abs(x2 - x1);
                let d = '';
                if (colDistance > colSpacing * 1.2) {
                    const arcOffset = (y1 <= y2) ? -55 : 55;
                    const controlY1 = y1 + arcOffset;
                    const controlY2 = y2 + arcOffset;
                    d = `M ${x1} ${y1} C ${x1 + colSpacing * 0.4} ${controlY1}, ${x2 - colSpacing * 0.4} ${controlY2}, ${x2} ${y2}`;
                } else {
                    const dx = colDistance * 0.42;
                    const controlX1 = (x2 >= x1) ? (x1 + dx) : (x1 - dx);
                    const controlX2 = (x2 >= x1) ? (x2 - dx) : (x2 + dx);
                    const dy = y2 - y1;
                    const bow = (dy >= 0 ? 1 : -1) * Math.min(25, Math.abs(dy) * 0.2);
                    const controlY1 = y1 + bow;
                    const controlY2 = y2 - bow;
                    d = `M ${x1} ${y1} C ${controlX1} ${controlY1}, ${controlX2} ${controlY2}, ${x2} ${y2}`;
                }

                let strokeColor = '#3f3f46';
                if (link.type === 'inbound-dest') strokeColor = '#10b981';
                else if (link.type === 'inbound-tc') strokeColor = '#eab308';
                else if (link.type === 'inbound-ivr') strokeColor = '#3b82f6';
                else if (link.type === 'tc-true') strokeColor = '#10b981';
                else if (link.type === 'tc-false') strokeColor = '#ef4444';
                else if (link.type === 'tc-ivr') strokeColor = '#3b82f6';
                else if (link.type === 'ivr-entry') strokeColor = '#3b82f6';
                else if (link.type === 'ivr-timeout') strokeColor = '#f59e0b';
                else if (link.type === 'ivr-invalid') strokeColor = '#ef4444';
                else if (link.type === 'rg-member') strokeColor = '#a855f7';
                else if (link.type === 'queue-member') strokeColor = '#f59e0b';
                else if (link.type === 'queue-dest') strokeColor = '#3b82f6';
                else if (link.type === 'ext-route-restricted') strokeColor = '#f97316';
                else if (link.type === 'ext-route-global') strokeColor = '#64748b';
                else if (link.type === 'route-trunk') strokeColor = '#06b6d4';
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('id', link.id);
                path.setAttribute('class', 'diagram-wire transition-all duration-200');
                path.setAttribute('d', d);
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke', strokeColor);
                path.setAttribute('stroke-width', '2px');
                path.setAttribute('stroke-linecap', 'round');
                path.setAttribute('data-type', link.type);
                path.style.opacity = '0.5';
                
                svgWires.appendChild(path);
            });

            // Render Nodes
            diagramNodesList.forEach(node => {
                let accentColorClass = 'border-emerald-500/20 hover:border-emerald-500';

<%
var activeLang = (typeof currentLang !== 'undefined' && currentLang) ? currentLang : 'en';
var isRtl = (typeof isRtl !== 'undefined') ? isRtl : (activeLang === 'ar');
var canManageGroupAdmin = (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) || (typeof currentUser !== 'undefined' && currentUser && (currentUser.isRoot || currentUser.group_name === 'super admins'));

function isTabAllowed(tabName) {
    if (typeof allowedTabs === 'undefined') return true;
    if (!Array.isArray(allowedTabs)) return true;
    return allowedTabs.includes('config') || allowedTabs.includes('gsm-dongles') || allowedTabs.includes('config-modem') || allowedTabs.includes('config-' + tabName) || allowedTabs.includes(tabName);
}
%>
<!DOCTYPE html>
<html lang="<%= activeLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
        function openModal(id) {
            try {
                if (typeof closeAllModals === 'function') closeAllModals();
                else {
                    document.querySelectorAll('[id$="Modal"]').forEach(function(m) {
                        m.classList.add('hidden');
                        m.style.setProperty('display', 'none', 'important');
                        m.setAttribute('aria-hidden', 'true');
                    });
                }
            } catch (_) {}
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                modal.style.setProperty('display', 'flex', 'important');
                modal.setAttribute('aria-hidden', 'false');
            }
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                modal.style.setProperty('display', 'none', 'important');
                modal.setAttribute('aria-hidden', 'true');
            }
            const inPopup = document.getElementById('inboundDongleInfoPopup');
            if (inPopup) inPopup.classList.add('hidden');
        }
        function openInboundModal() {
            openModal('inboundModal');
        }
        window.openModal = openModal;
        window.closeModal = closeModal;
        window.openInboundModal = openInboundModal;
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - <%= isRtl ? 'إعدادات المقسم' : 'PBX Configuration' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
    <script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #121212;
            --bg-card: #18181b;
            --bg-hover: #27272a;
            --border-primary: #27272a;
            --border-accent: #3f3f46;
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent-color: #ef4444;
            --accent-hover: #dc2626;
        }
        html.light-theme {
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --bg-card: #f1f5f9;
            --bg-hover: #e2e8f0;
            --border-primary: #cbd5e1;
            --border-accent: #94a3b8;
            --text-primary: #0f172a;
            --text-secondary: #334155;
            --text-muted: #64748b;
        }
        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Plus Jakarta Sans', 'Cairo', sans-serif;
            min-height: 100vh;
        }
        .config-card {
            background-color: var(--bg-secondary) !important;
            border: 1px solid var(--border-primary) !important;
            border-radius: 1rem !important;
        }
        .config-input {
            background-color: var(--bg-card) !important;
            border: 1px solid var(--border-primary) !important;
            color: var(--text-primary) !important;
            font-size: 0.875rem !important;
            border-radius: 0.5rem !important;
            padding: 0.5rem 0.75rem !important;
        }
        .config-input:focus {
            outline: none !important;
            border-color: var(--accent-color) !important;
        }
        .config-btn-primary {
            background-color: #991b1b !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            border-radius: 0.5rem !important;
            transition: all 150ms ease-in-out !important;
        }
        .config-btn-primary:hover {
            background-color: #b91c1c !important;
        }
        .config-btn-secondary {
            color: #ffffff !important;
            border: none !important;
            font-weight: 600 !important;
            border-radius: 0.5rem !important;
            transition: all 150ms ease-in-out !important;
        }
        .config-btn-secondary:hover {
            color: #ffffff !important;
        }
        /* Unified action hierarchy for configuration feature cards. */
        .config-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            min-height: 2.25rem;
            padding: 0.5rem 0.8rem;
            color: #ffffff;
            background: none;
            border: none;
            border-radius: 0.625rem;
            font-size: 0.75rem;
            font-weight: 700;
            line-height: 1rem;
            white-space: nowrap;
            cursor: pointer;
            transition: transform 150ms ease, background-color 150ms ease, border-color 150ms ease, color 150ms ease;
        }
        .config-action-btn:hover {
            color: #ffffff;
            border-color: var(--border-accent);
            transform: none;
        }
        .config-action-btn:active {
            transform: none;
        }
        .config-action-btn:focus-visible {
            outline: 2px solid var(--accent-color);
            outline-offset: 2px;
        }
        .config-action-btn:disabled {
            cursor: not-allowed;
            opacity: 0.45;
            transform: none;
        }
        .config-action-btn svg {
            width: 0.875rem;
            height: 0.875rem;
            flex-shrink: 0;
        }
        .config-action-btn--primary {
            color: #ffffff;
            background: #991b1b;
            border-color: rgba(248, 113, 113, 0.55);
        }
        .config-action-btn--primary:hover {
            color: #ffffff;
            background: #b91c1c;
            border-color: rgba(254, 202, 202, 0.7);
        }
        .config-action-btn--positive {
            color: #34d399;
            background: rgba(16, 185, 129, 0.09);
            border-color: rgba(52, 211, 153, 0.28);
        }
        .config-action-btn--positive:hover {
            color: #6ee7b7;
            background: rgba(16, 185, 129, 0.16);
            border-color: rgba(52, 211, 153, 0.45);
        }
        .config-action-btn--danger {
            color: #f87171;
            background: rgba(239, 68, 68, 0.08);
            border-color: rgba(248, 113, 113, 0.25);
        }
        .config-action-btn--danger:hover {
            color: #fca5a5;
            background: rgba(239, 68, 68, 0.15);
            border-color: rgba(248, 113, 113, 0.42);
        }
        .config-action-btn--state-on {
            color: #34d399;
            background: rgba(16, 185, 129, 0.1);
            border-color: rgba(52, 211, 153, 0.3);
        }
        .config-action-btn--state-off {
            color: #f87171;
            background: rgba(239, 68, 68, 0.09);
            border-color: rgba(248, 113, 113, 0.28);
        }
        .config-action-btn--compact {
            min-height: 1.875rem;
            padding: 0.35rem 0.6rem;
            border-radius: 0.5rem;
            font-size: 0.6875rem;
        }
        .config-metric-tile {
            min-width: 0;
            padding: 1rem;
            background: var(--bg-card);
        }
        .config-control-panel {
            padding: 0.875rem;
            background: color-mix(in srgb, var(--bg-primary) 68%, transparent);
            border: 1px solid var(--border-primary);
            border-radius: 0.75rem;
        }
        html.light-theme .config-action-btn {
            border: none;
            color: #000000;
        }
        html.light-theme .config-action-btn:hover {
            color: #000000;
        }
        html.light-theme .config-action-btn--primary {
            color: #ffffff;
            background: #dc2626;
            border-color: #b91c1c;
        }
        html.light-theme .config-action-btn--positive {
            color: #047857;
            background: #ecfdf5;
            border-color: #a7f3d0;
        }
        html.light-theme .config-action-btn--danger,
        html.light-theme .config-action-btn--state-off {
            color: #b91c1c;
            background: #fef2f2;
            border-color: #fecaca;
        }
        html.light-theme .config-action-btn--state-on {
            color: #047857;
            background: #ecfdf5;
            border-color: #a7f3d0;
        }
        /* Extension Device Type Tech Badge Styling & Light Mode High-Contrast Overrides */
        .ext-tech-badge {
            padding: 0.2rem 0.55rem;
            font-size: 0.6875rem;
            font-weight: 800;
            border-radius: 0.375rem;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            width: fit-content;
        }
        .ext-tech-webrtc {
            background-color: rgba(168, 85, 247, 0.15);
            color: #d8b4fe;
            border: 1px solid rgba(168, 85, 247, 0.35);
        }
        .ext-tech-sip {
            background-color: rgba(100, 116, 139, 0.2);
            color: #cbd5e1;
            border: 1px solid rgba(148, 163, 184, 0.35);
        }
        html.light-theme .ext-tech-webrtc {
            background-color: #f3e8ff !important;
            color: #581c87 !important;
            border-color: #c084fc !important;
        }
        html.light-theme .ext-tech-sip {
            background-color: #e2e8f0 !important;
            color: #0f172a !important;
            border-color: #64748b !important;
        }
        .config-tab-btn {
            font-weight: 700;
            font-size: 0.75rem;
            padding: 0.45rem 0.75rem;
            border-radius: 0.6rem !important;
            transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1), background 220ms ease, border-color 220ms ease !important;
            cursor: pointer;
            white-space: nowrap;
        }
        .config-tab-btn:hover {
            transform: none !important;
        }
        .config-tab-btn:active {
            transform: none !important;
        }
        .config-tab-active {
            background: #991b1b !important;
            color: #ffffff !important;
            border: 1px solid rgba(239, 68, 68, 0.4) !important;
        }
        html.light-theme .config-tab-active {
            background: #b91c1c !important;
            border-color: rgba(239, 68, 68, 0.4) !important;
            color: #ffffff !important;
        }
        .config-tab-inactive {
            color: #ffffff !important;
            border: none !important;
        }
        .config-tab-inactive:hover {
            color: #ffffff !important;
        }
        .ext-pill {
            cursor: pointer;
            user-select: none;
            transition: all 0.15s ease;
        }
        .ext-pill.active {
            background-color: rgba(239, 68, 68, 0.2);
            color: var(--accent-color);
            border-color: rgba(239, 68, 68, 0.4);
        }
        select.config-input option {
            background-color: var(--bg-card) !important;
            color: var(--text-primary) !important;
        }
        html.light-theme select.config-input option {
            background-color: #ffffff !important;
            color: #0f172a !important;
        }
        html.light-theme .config-card {
        }

        /* Sub-Sidebar Custom Styles */
        @media (min-width: 768px) {
            #configSubSidebar {
                width: 220px;
                transition: width 200ms ease-in-out, padding 200ms ease-in-out;
            }
            html.config-subsidebar-collapsed #configSubSidebar,
            #configSubSidebar.subsidebar-collapsed {
                width: 72px !important;
                padding-left: 0.35rem !important;
                padding-right: 0.35rem !important;
            }
            html.config-subsidebar-collapsed #configSubSidebar .subsidebar-text,
            html.config-subsidebar-collapsed #configSubSidebar .subsidebar-header-title,
            html.config-subsidebar-collapsed #configSubSidebar .reload-btn-text,
            #configSubSidebar.subsidebar-collapsed .subsidebar-text,
            #configSubSidebar.subsidebar-collapsed .subsidebar-header-title,
            #configSubSidebar.subsidebar-collapsed .reload-btn-text {
                display: none !important;
            }
            html.config-subsidebar-collapsed #configSubSidebar .config-tab-btn,
            #configSubSidebar.subsidebar-collapsed .config-tab-btn {
                justify-content: center !important;
                padding-left: 0.35rem !important;
                padding-right: 0.35rem !important;
            }
            html.config-subsidebar-collapsed #configSubSidebar .config-tab-btn svg,
            #configSubSidebar.subsidebar-collapsed .config-tab-btn svg {
                margin-right: 0 !important;
                margin-left: 0 !important;
            }
            html.config-subsidebar-collapsed #configSubSidebar .subsidebar-header-box,
            #configSubSidebar.subsidebar-collapsed .subsidebar-header-box {
                flex-direction: column !important;
                align-items: center !important;
                justify-content: center !important;
                gap: 0.35rem !important;
            }
            html.config-subsidebar-collapsed #configSubSidebar #toggleConfigSubSidebarBtn,
            #configSubSidebar.subsidebar-collapsed #toggleConfigSubSidebarBtn {
                width: 100% !important;
                justify-content: center !important;
                padding-left: 0.35rem !important;
                padding-right: 0.35rem !important;
            }
            html.config-subsidebar-collapsed #configSubSidebar #reloadPbxBtn,
            #configSubSidebar.subsidebar-collapsed #reloadPbxBtn {
                padding: 0.4rem !important;
                justify-content: center !important;
            }
        }

    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">

    <%- include('sidebar') %>

    <!-- PBX Configuration Sub-Sidebar -->
    <aside id="configSubSidebar" class="config-sub-sidebar w-full md:w-[220px] h-auto md:h-screen md:sticky top-0 z-40 bg-transparent flex flex-col justify-between p-4 shrink-0 transition-all duration-300 border-b md:border-b-0 <%= isRtl ? 'border-l border-[var(--border-primary)] md:border-l md:border-r-0' : 'border-r border-[var(--border-primary)] md:border-r md:border-l-0' %>">
        <script>
            function updateConfigSubCollapseButtonIcon(isCollapsed) {
                const icon = document.getElementById('configSubCollapseIcon');
                const btn = document.getElementById('toggleConfigSubSidebarBtn');
                if (!icon || !btn) return;
                const isRtl = document.documentElement.dir === 'rtl';
                const text = isCollapsed ? (isRtl ? 'توسيع القائمة' : 'Expand Sub Sidebar') : (isRtl ? 'تصغير القائمة' : 'Collapse Sub Sidebar');
                btn.setAttribute('title', text);
                if (isCollapsed) {
                    icon.style.transform = 'rotate(180deg)';
                } else {
                    icon.style.transform = 'none';
                }
            }

            window.toggleConfigSubSidebar = function() {
                const sidebar = document.getElementById('configSubSidebar');
                if (!sidebar) return;
                const isCollapsed = sidebar.classList.toggle('subsidebar-collapsed');
                document.documentElement.classList.toggle('config-subsidebar-collapsed', isCollapsed);
                localStorage.setItem('config_subsidebar_collapsed', String(isCollapsed));
                updateConfigSubCollapseButtonIcon(isCollapsed);
                window.dispatchEvent(new Event('resize'));
            };

            (function() {
                if (localStorage.getItem('config_subsidebar_collapsed') === 'true') {
                    document.getElementById('configSubSidebar')?.classList.add('subsidebar-collapsed');
                    document.documentElement.classList.add('config-subsidebar-collapsed');
                    document.addEventListener('DOMContentLoaded', function() {
                        updateConfigSubCollapseButtonIcon(true);
                    });
                }
            })();
        </script>

        <div class="flex flex-col gap-3 overflow-y-auto no-scrollbar flex-1">
            <!-- Header Box -->
            <div class="subsidebar-header-box relative flex items-center justify-between pb-3 border-b border-[var(--border-primary)] shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                    <div class="p-1.5 bg-red-500/10 text-red-500 rounded-lg border border-red-500/20 shrink-0">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <span class="subsidebar-header-title text-xs font-black text-[var(--text-primary)] uppercase tracking-wider truncate">
                        <%= isRtl ? 'الإعدادات' : 'Configuration' %>
                    </span>
                </div>
            </div>

            <!-- Ordered Navigation Tabs (Top to Bottom: extensions -> ringgroups -> inbound -> trunks -> outbound -> queues -> timegroups -> timeconditions -> voicemail -> ivr -> recordings -> diagram) -->
            <nav class="flex flex-col gap-1">
                <!-- 1. extensions -->
                <% if (isTabAllowed('extensions')) { %>
                <button onclick="switchTab('extensions')" id="tab-btn-extensions" title="<%= isRtl ? 'التحويلات' : 'Extensions' %>" class="config-tab-btn config-tab-active flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-xs font-bold transition-all">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <span class="subsidebar-text truncate"><%= isRtl ? 'التحويلات' : 'Extensions' %></span>
                </button>
                <% } %>

                <!-- 2. ringgroups -->
                <% if (isTabAllowed('ringgroups')) { %>
                <button onclick="switchTab('ringgroups')" id="tab-btn-ringgroups" title="<%= isRtl ? 'مجموعات الاتصال' : 'Ring Groups' %>" class="config-tab-btn config-tab-inactive flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-xs font-bold transition-all">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    <span class="subsidebar-text truncate"><%= isRtl ? 'مجموعات الاتصال' : 'Ring Groups' %></span>
                </button>
                <% } %>

                <!-- 3. inbound routes -->
                <% if (isTabAllowed('inbound')) { %>
                <button onclick="switchTab('inbound')" id="tab-btn-inbound" title="<%= isRtl ? 'المسارات الواردة' : 'Inbound Routes' %>" class="config-tab-btn config-tab-inactive flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-xs font-bold transition-all">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                    <span class="subsidebar-text truncate"><%= isRtl ? 'المسارات الواردة' : 'Inbound Routes' %></span>
                </button>
                <% } %>

                <!-- 4. trunks -->
                <% if (isTabAllowed('trunks')) { %>
                <button onclick="switchTab('trunks')" id="tab-btn-trunks" title="<%= isRtl ? 'خطوط الربط' : 'Trunks' %>" class="config-tab-btn config-tab-inactive flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-xs font-bold transition-all">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <span class="subsidebar-text truncate"><%= isRtl ? 'خطوط الربط' : 'Trunks' %></span>
                </button>
                <% } %>

                <!-- 5. outbound routes -->
                <% if (isTabAllowed('outbound')) { %>
                <button onclick="switchTab('outbound')" id="tab-btn-outbound" title="<%= isRtl ? 'المسارات الصادرة' : 'Outbound Routes' %>" class="config-tab-btn config-tab-inactive flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-xs font-bold transition-all">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                    <span class="subsidebar-text truncate"><%= isRtl ? 'المسارات الصادرة' : 'Outbound Routes' %></span>
                </button>
                <% } %>

                <!-- 6. queues -->
                <% if (isTabAllowed('queues')) { %>
                <button onclick="switchTab('queues')" id="tab-btn-queues" title="<%= isRtl ? 'طوابير الانتظار' : 'Queues' %>" class="config-tab-btn config-tab-inactive flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-xs font-bold transition-all">
                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

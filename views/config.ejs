                                        </span>
                                        <svg class="w-3.5 h-3.5 shrink-0 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                    </button>
                                    <!-- Category Dropdown Menu -->
                                    <div id="destination-cat-dropdown-${this.instanceId}" class="dest-cat-dropdown-menu config-dropdown-menu hidden">
                                        <div class="options-list config-dropdown-options space-y-1 custom-scrollbar flex-1" role="listbox">

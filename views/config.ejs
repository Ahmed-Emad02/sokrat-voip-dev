                            <div><span class="text-white"><%= isRtl ? 'المسار:' : 'Path:' %></span> <span id="mohPathDisplay" class="truncate font-mono text-[11px] text-amber-400">/var/lib/asterisk/moh/</span></div>
                            <div><span class="text-white"><%= isRtl ? 'الفرز:' : 'Sort:' %></span> <span id="mohSortDisplay" class="font-bold text-emerald-400">alpha</span></div>

                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <div>
                        <h3 id="timeConditionModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة شرط وقت' : 'Add Time Condition' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'ربط مجموعة وقت بوجهات المطابقة (مفتوح / مغلق)' : 'Associate time group rules with open and after-hours destinations' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('timeConditionModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="timeConditionForm" onsubmit="saveTimeCondition(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="tcEditMode" value="false">
                <input type="hidden" id="tcId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: TIME CONDITION DEFINITION (Cyan Theme) -->
                    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-cyan-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'تعريف شرط الوقت والمجموعة' : 'Time Condition Identity' %>
                            </span>
                            <span class="text-[10px] text-cyan-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="tcDisplayName"><%= isRtl ? 'الاسم الظاهر *' : 'Display Name *' %></label>
                                <input type="text" id="tcDisplayName" required placeholder="e.g. Office Hours Route" class="config-input w-full text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="tcTimeGroup"><%= isRtl ? 'مجموعة الوقت *' : 'Time Group *' %></label>
                                <select id="tcTimeGroup" required class="config-input w-full text-xs font-semibold">
                                    <option value="">-- Choose Time Group --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: DESTINATIONS MATCH / UNMATCH (Emerald & Rose Split Theme) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Destination if MATCH (True / Open) -->
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <%= isRtl ? 'الوجهة عند المطابقة (مفتوح / True)' : 'Destination if Matched (True / Open)' %>
                                </span>
                                <span class="text-[10px] text-emerald-400/70 font-mono">MATCHED</span>
                            </div>
                            <div id="tcTrueDestComponentContainer"></div>
                            <input type="hidden" id="tcTrueGoto" required>
                        </div>

                        <!-- Destination if NO MATCH (False / Closed) -->
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                    <%= isRtl ? 'الوجهة عند عدم المطابقة (مغلق / False)' : 'Destination if NOT Matched (False / Closed)' %>
                                </span>
                                <span class="text-[10px] text-rose-400/70 font-mono">UNMATCHED</span>
                            </div>
                            <div id="tcFalseDestComponentContainer"></div>
                            <input type="hidden" id="tcFalseGoto" required>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('timeConditionModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ شرط الوقت' : 'Save Time Condition' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ANNOUNCEMENT MODAL -->
    <div id="announcementModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.684A1.76 1.76 0 013 12V8a1.76 1.76 0 012.436-1.684l3.181-1.363A1.76 1.76 0 0111 6.592v10.816a1.76 1.76 0 01-2.383 1.644l-3.181-1.368z" />
                        </svg>
                    </div>
                    <div>
                        <h3 id="announcementModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة إعلان جديد' : 'Add Announcement' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'إعداد رسالة صوتية وإعادة توجيه الاتصال بعد انتهائها' : 'Configure playback recording and post-playback call routing' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('announcementModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Body -->
            <form id="announcementForm" onsubmit="saveAnnouncement(event)" class="flex-1 overflow-y-auto p-6 space-y-5">
                <input type="hidden" id="annEditMode" value="false">
                <input type="hidden" id="annId" value="">

                <!-- 1. Description / Name -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annDescription"><%= isRtl ? 'وصف/اسم الإعلان *' : 'Description / Name *' %></label>
                    <input type="text" id="annDescription" required placeholder="e.g. Welcome Announcement" class="config-input w-full text-xs">
                </div>

                <!-- 2. System Recording -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annRecording"><%= isRtl ? 'التسجيل الصوتي' : 'System Recording' %></label>
                    <select id="annRecording" onchange="onAnnRecordingChange()" class="config-input w-full text-xs font-semibold">
                        <option value="0">== <%= isRtl ? 'بدون تسجيل (استخدام تحويل النص إلى كلام)' : 'None (Use Text-To-Speech TTS)' %> ==</option>
                    </select>
                </div>

                <!-- 3. Repeat Message Key -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annRepeatMsg"><%= isRtl ? 'مفتاح إعادة التكرار' : 'Repeat Message Key' %></label>
                    <select id="annRepeatMsg" class="config-input w-full text-xs font-semibold">
                        <option value=""><%= isRtl ? 'بدون تكرار (None)' : 'None (No repeat key)' %></option>
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="*">*</option>
                        <option value="#">#</option>
                    </select>
                </div>

                <!-- 3.5 Text-to-Speech Engine (TTS) -->
                <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                    <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block"><%= isRtl ? 'تحويل النص إلى كلام (Text-To-Speech)' : 'Text-To-Speech (TTS Engine)' %></span>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annTtsLang"><%= isRtl ? 'اللغة' : 'Language' %></label>
                            <select id="annTtsLang" class="config-input w-full text-xs font-semibold">
                                <option value="en-US">English (en-US)</option>
                                <option value="en-GB">English (en-GB)</option>
                                <option value="es-ES">Spanish (es-ES)</option>
                                <option value="fr-FR">French (fr-FR)</option>
                                <option value="it-IT">Italian (it-IT)</option>
                                <option value="de-DE">German (de-DE)</option>
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annTtsText"><%= isRtl ? 'النص الصوتي (ينشط عند عدم اختيار تسجيل)' : 'TTS Text (used when System Recording is None)' %></label>
                            <input type="text" id="annTtsText" placeholder="e.g. Welcome to our company. Please hold." class="config-input w-full text-xs">
                        </div>
                    </div>
                </div>
                <!-- 4. Playback Behavior Flags -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                    <label for="annAllowSkip" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annAllowSkip" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالتخطي (Allow Skip)' : 'Allow Skip' %></span>
                    </label>
                    <label for="annReturnIvr" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annReturnIvr" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'العودة للرد الآلي (Return IVR)' : 'Return to IVR' %></span>
                    </label>
                    <label for="annNoAnswer" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annNoAnswer" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'عدم الإجابة (Don\'t Answer)' : 'Don\'t Answer' %></span>
                    </label>
                </div>

                <!-- 5. Post Playback Destination -->
                <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                    <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block"><%= isRtl ? 'الوجهة المستهدفة بعد الانتهاء *' : 'Post Playback Destination *' %></span>
                    <div id="annPostDestComponentContainer"></div>
                    <input type="hidden" id="annPostDestination" required>
                </div>
                <!-- Form Action Buttons -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--border-primary)] shrink-0">
                    <button type="button" onclick="closeModal('announcementModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'حفظ الإعلان' : 'Save Announcement' %></button>
                </div>
            </form>
        </div>
    </div>
    <!-- RECORDING STUDIO / SOX DSP MODAL -->
    <div id="recordingStudioModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-4xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden shadow-2xl">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="p-2.5 bg-purple-500/10 text-purple-400 rounded-xl border border-purple-500/20 shrink-0">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-extrabold text-[var(--text-primary)] truncate flex items-center gap-2">
                            <span><%= isRtl ? 'استوديو معالجة الصوت المتقدم (SoX DSP)' : 'Audio Studio & Voice Optimization (SoX DSP)' %></span>
                            <span id="dspTargetNameBadge" class="text-xs px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 font-mono font-bold"></span>
                        </h3>
                        <p class="text-[11px] text-[var(--text-muted)] truncate"><%= isRtl ? 'تحسين وضوح الصوت، ضبط الهامش الديناميكي، معادلة الترددات، والتحويل إلى صيغ الهواتف' : 'Acoustic filters, dynamic leveler, frequency equalization & zero-transcoding codec export' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('recordingStudioModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors shrink-0">✕</button>
            </div>

            <!-- Body -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                <input type="hidden" id="dspRecId" value="">
                <input type="hidden" id="dspRecFilename" value="">

                <!-- Audio Player Hero & Waveform Stats -->
                <div class="rounded-xl border border-[var(--border-primary)] bg-[var(--bg-primary)]/40 p-4 space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <button type="button" id="dspPlayBtn" onclick="toggleStudioAudioPreview()" class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center justify-center hover:bg-emerald-500/25 transition cursor-pointer shrink-0">
                                <svg id="dspPlayIcon" class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            </button>
                            <div>
                                <span id="dspDisplayTitle" class="text-sm font-extrabold text-[var(--text-primary)] block font-mono"></span>
                                <span id="dspFileStatsText" class="text-[11px] text-[var(--text-muted)] font-mono">8000Hz • 16-bit Mono PCM</span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
                            <span class="px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)]">
                                <%= isRtl ? 'المدة:' : 'Length:' %> <b id="dspStatDuration" class="text-white">-</b>
                            </span>
                            <span class="px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)]">
                                <%= isRtl ? 'أعلى سعة:' : 'Peak:' %> <b id="dspStatPeak" class="text-white">-</b>
                            </span>
                            <span class="px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)]">
                                <%= isRtl ? 'متوسط الطاقة:' : 'RMS:' %> <b id="dspStatRms" class="text-white">-</b>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 1-Click Optimization Presets -->
                <div>
                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-2">
                        <%= isRtl ? 'قوالب التحسين الجاهزة بنقرة واحدة (1-Click Presets)' : '1-Click Voice Optimization Presets' %>
                    </span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        <button type="button" onclick="applyDspPreset('dongle')" class="p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 hover:bg-amber-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-amber-400 block group-hover:underline">📱 <%= isRtl ? 'مخصص للدونجل' : 'GSM Dongle' %></span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'هامش -18dB + فلتر G.711' : 'Norm -18dB + G.711 bandpass' %></span>
                        </button>
                        <button type="button" onclick="applyDspPreset('broadcast')" class="p-3 rounded-xl border border-blue-500/30 bg-blue-500/5 hover:bg-blue-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-blue-400 block group-hover:underline">🎙️ <%= isRtl ? 'تسوية إذاعية' : 'Radio Leveler' %></span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'ضغط ديناميكي + تضخيم الصوت' : 'Compand + Bass/Treble boost' %></span>
                        </button>
                        <button type="button" onclick="applyDspPreset('clean')" class="p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-emerald-400 block group-hover:underline">✂️ <%= isRtl ? 'تنظيف وقص الصمت' : 'Clean & Trim' %></span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'قص الصمت + تلاشي ناعم' : 'Trim dead air + Fade in/out' %></span>
                        </button>
                        <button type="button" onclick="applyDspPreset('reset')" class="p-3 rounded-xl border border-red-500/30 bg-red-500/5 hover:bg-red-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-red-400 block group-hover:underline">🔄 <%= isRtl ? 'الملف الأصلي الخام' : 'Reset to Master' %></span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'إلغاء جميع الفلاتر والمؤثرات' : 'Revert to untouched .orig.wav' %></span>
                        </button>
                    </div>
                </div>

                <!-- DSP Controls Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Column 1: Dynamics & Levels -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'مستويات الصوت والديناميكية' : 'Volume, Headroom & Dynamics' %></h4>
                        </div>

                        <!-- Peak Normalizer -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspNormDb" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'الموازنة التلقائية للقمة (Peak Normalizer)' : 'Peak Normalizer (Norm)' %></label>
                                <span class="text-[10px] text-amber-400 font-mono font-bold"><%= isRtl ? 'موصى به' : 'Recommended' %></span>
                            </div>
                            <select id="dspNormDb" class="config-input w-full text-xs">
                                <option value=""><%= isRtl ? 'معطل (استخدام شريط الكسب اليدوي)' : 'Disabled (Use Manual Gain Slider)' %></option>
                                <option value="-18" selected>-18 dBFS (<%= isRtl ? 'موصى به للبوابات والدونجل' : 'Recommended for Dongles' %>)</option>
                                <option value="-12">-12 dBFS (<%= isRtl ? 'تخفيض معتدل' : 'Moderate Headroom' %>)</option>
                                <option value="-6">-6 dBFS (<%= isRtl ? 'تخفيض خفيف' : 'Light Headroom' %>)</option>
                                <option value="0">0 dBFS (<%= isRtl ? 'أقصى سعة قياسية' : 'Full Scale Ceiling' %>)</option>
                            </select>
                        </div>

                        <!-- Manual Gain Slider -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspGainDb" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'مستوى الكسب اليدوي (Manual Gain)' : 'Manual Gain Adjustment (Vol)' %></label>
                                <span id="dspGainBadge" class="text-xs font-bold text-amber-400 font-mono">0 dB</span>
                            </div>
                            <input type="range" id="dspGainDb" min="-50" max="20" step="1" value="0"
                                oninput="document.getElementById('dspGainBadge').textContent = (this.value > 0 ? '+' : '') + this.value + ' dB'; if(this.value != 0) document.getElementById('dspNormDb').value = '';"
                                class="w-full accent-amber-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1">
                                <span>-50 dB</span><span>0 dB</span><span>+20 dB</span>
                            </div>
                        </div>

                        <!-- Voice Compander / Leveler -->
                        <div>
                            <label for="dspCompand" class="text-xs font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'ضاغط ومسوي الصوت (Voice Compander / Leveler)' : 'Voice Leveler (Compand)' %></label>
                            <select id="dspCompand" class="config-input w-full text-xs">
                                <option value="off"><%= isRtl ? 'معطل (Off)' : 'Off (No compression)' %></option>
                                <option value="broadcast"><%= isRtl ? 'بث إذاعي قوي (Broadcast - صوت موحد ومسموع)' : 'Broadcast (Tight, uniform vocal loudness)' %></option>
                                <option value="soft"><%= isRtl ? 'تحسين صوتي خفيف (Soft Vocal Polish)' : 'Soft Vocal Polish (Gentle dynamic smoothing)' %></option>
                            </select>
                        </div>

                        <!-- Fade In & Fade Out -->
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div>
                                <label for="dspFadeIn" class="text-[11px] font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'تلاشي البداية (Fade In)' : 'Fade In (sec)' %></label>
                                <input type="number" id="dspFadeIn" min="0" max="2.0" step="0.05" value="0.05" class="config-input w-full text-xs font-mono">
                            </div>
                            <div>
                                <label for="dspFadeOut" class="text-[11px] font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'تلاشي النهاية (Fade Out)' : 'Fade Out (sec)' %></label>
                                <input type="number" id="dspFadeOut" min="0" max="2.0" step="0.05" value="0.05" class="config-input w-full text-xs font-mono">
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Clarity & EQ -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-blue-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'الفلاتر ونقاء الصوت ومعادلة الترددات' : 'Clarity, Filters & Frequency EQ' %></h4>
                        </div>

                        <!-- Bandpass Filter -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'فلتر الاتصالات القياسي (G.711 Bandpass)' : 'G.711 Telecom Bandpass (300-3400 Hz)' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'عزل ضوضاء الترددات غير الهاتفية وقص فرقعة المايك' : 'Cuts sub-bass rumble (<300Hz) & high hiss (>3.4kHz)' %></span>
                            </div>
                            <input type="checkbox" id="dspBandpass" checked class="w-4 h-4 accent-purple-500 rounded cursor-pointer">
                        </div>

                        <!-- Background Hiss Filter -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'فلتر إزالة صفير وهسيس الخلفية (Hiss / Rumble Filter)' : 'Hiss & Room Noise Filter' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'فلترة أصوات أجهزة التكييف والمراوح في التسجيل' : 'Removes fan hum and air conditioning noise' %></span>
                            </div>
                            <input type="checkbox" id="dspHissFilter" class="w-4 h-4 accent-purple-500 rounded cursor-pointer">
                        </div>

                        <!-- Bass EQ -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspBass" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'تضخيم/تخفيف الباس (Bass EQ)' : 'Bass Equalization' %></label>
                                <span id="dspBassBadge" class="text-xs font-bold text-blue-400 font-mono">0 dB</span>
                            </div>
                            <input type="range" id="dspBass" min="-12" max="12" step="1" value="0"
                                oninput="document.getElementById('dspBassBadge').textContent = (this.value > 0 ? '+' : '') + this.value + ' dB';"
                                class="w-full accent-blue-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1"><span>-12 dB</span><span>0 dB</span><span>+12 dB</span></div>
                        </div>

                        <!-- Treble EQ -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspTreble" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'حدة ووضوح الحروف (Treble EQ)' : 'Treble / Voice Presence' %></label>
                                <span id="dspTrebleBadge" class="text-xs font-bold text-blue-400 font-mono">0 dB</span>
                            </div>
                            <input type="range" id="dspTreble" min="-12" max="12" step="1" value="0"
                                oninput="document.getElementById('dspTrebleBadge').textContent = (this.value > 0 ? '+' : '') + this.value + ' dB';"
                                class="w-full accent-blue-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1"><span>-12 dB</span><span>0 dB</span><span>+12 dB</span></div>
                        </div>
                    </div>

                    <!-- Column 3: Timing & Pacing -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'السرعة وضبط فترات الصمت' : 'Timing, Speed & Silence Trimming' %></h4>
                        </div>

                        <!-- Auto-trim silence -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'قص الصمت تلقائيًا (Auto-Trim Silence)' : 'Auto-Trim Silence (Start & End)' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'حذف الفراغات الصامتة في بداية ونهاية التسجيل' : 'Strips dead air before speech begins and after it ends' %></span>
                            </div>
                            <input type="checkbox" id="dspTrimSilence" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer">
                        </div>

                        <!-- Tempo / Speech Pacing -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspTempo" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'سرعة الإلقاء (Speech Tempo)' : 'Speech Pacing / Speed (Pitch-Preserved)' %></label>
                                <span id="dspTempoBadge" class="text-xs font-bold text-emerald-400 font-mono">1.00x</span>
                            </div>
                            <input type="range" id="dspTempo" min="0.70" max="1.40" step="0.05" value="1.00"
                                oninput="document.getElementById('dspTempoBadge').textContent = parseFloat(this.value).toFixed(2) + 'x';"
                                class="w-full accent-emerald-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1"><span>0.70x</span><span>1.00x</span><span>1.40x</span></div>
                        </div>

                        <!-- Lead & Trail Padding -->
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div>
                                <label for="dspPadLead" class="text-[11px] font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'صمت قبل البدء (Start Pad)' : 'Start Pad (sec)' %></label>
                                <input type="number" id="dspPadLead" min="0" max="3.0" step="0.1" value="0.2" class="config-input w-full text-xs font-mono">
                            </div>
                            <div>
                                <label for="dspPadTrail" class="text-[11px] font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'صمت في النهاية (End Pad)' : 'End Pad (sec)' %></label>
                                <input type="number" id="dspPadTrail" min="0" max="3.0" step="0.1" value="0.2" class="config-input w-full text-xs font-mono">
                            </div>
                        </div>
                    </div>

                    <!-- Column 4: Codecs & Asterisk Performance -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-purple-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'أداء المقسم وتوليد الصيغ المباشرة' : 'PBX Performance & Multi-Codec Cache' %></h4>
                        </div>

                        <!-- Pre-render Multi-Codec -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'توليد الصيغ الأصلية (Multi-Codec Cache)' : 'Multi-Codec Direct Cache' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'توليد صيغ GSM و ALAW و ULAW لمنع استهلاك معالج المقسم' : 'Pre-renders .gsm, .alaw, .ulaw for 0% CPU transcoding' %></span>
                            </div>
                            <input type="checkbox" id="dspGenerateCodecs" checked class="w-4 h-4 accent-purple-500 rounded cursor-pointer">
                        </div>

                        <!-- Codec Status Indicators -->
                        <div>
                            <span class="text-xs font-bold text-[var(--text-secondary)] block mb-2"><%= isRtl ? 'حالة الصيغ المولدة على القرص:' : 'Rendered Codec Files on Disk:' %></span>
                            <div class="grid grid-cols-2 gap-2 text-xs font-mono" id="dspCodecPillsContainer">
                                <div id="dspCodecWav" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.wav (PCM)</span>
                                    <span class="text-emerald-400 font-bold">✓</span>
                                </div>
                                <div id="dspCodecGsm" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.gsm (Mobile)</span>
                                    <span id="dspGsmStatus" class="text-[var(--text-muted)]">-</span>
                                </div>
                                <div id="dspCodecAlaw" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.alaw (ISDN/SIP)</span>
                                    <span id="dspAlawStatus" class="text-[var(--text-muted)]">-</span>
                                </div>
                                <div id="dspCodecUlaw" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.ulaw (G.711u)</span>
                                    <span id="dspUlawStatus" class="text-[var(--text-muted)]">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <button type="button" onclick="closeModal('recordingStudioModal')" class="px-4 py-2 rounded-xl text-xs font-bold text-[var(--text-secondary)] hover:bg-[var(--bg-card)] border border-[var(--border-primary)] cursor-pointer">
                    <%= isRtl ? 'إلغاء' : 'Close' %>
                </button>
                <div class="flex items-center gap-2.5">
                    <button type="button" onclick="resetRecordingStudioMaster()" class="px-3 py-2 rounded-xl text-xs font-bold text-red-400 hover:bg-red-500/10 border border-red-500/30 flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        <span><%= isRtl ? 'استعادة الأصل' : 'Revert to Original' %></span>
                    </button>
                    <button type="button" id="dspApplyBtn" onclick="saveRecordingStudioDsp()" class="config-btn-primary px-5 py-2 text-xs flex items-center gap-2 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        <span><%= isRtl ? 'تطبيق وحفظ المؤثرات' : 'Apply & Save Audio DSP' %></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: ADD MOH CATEGORY -->
    <div id="mohCategoryModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة فئة موسيقى جديدة' : 'Add MoH Category' %></h3>
                <button type="button" onclick="closeModal('mohCategoryModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="saveMohCategory(event)" class="p-6 space-y-4">
                <div>
                    <label for="mohCatName" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اسم الفئة *' : 'Category Name *' %></label>
                    <input type="text" id="mohCatName" required placeholder="e.g. promo_music" class="config-input w-full font-mono text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="mohCatSort"><%= isRtl ? 'طريقة الفرز (Sort Order)' : 'Sort Order' %></label>
                    <select id="mohCatSort" class="config-input w-full text-xs font-mono">
                        <option value="alpha">alpha (Alphabetical)</option>
                        <option value="rand">rand (Random order)</option>
                        <option value="random_start">random_start (Random start position)</option>
                    </select>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('mohCategoryModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'إنشاء الفئة' : 'Create Category' %></button>
                </div>
            </form>
    </div>
    </div>

    <!-- MODAL: ADD DONGLE SLOT (ROOT USER ONLY) -->
    <div id="addDongleSlotModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة شريحة/مودم جديد لـ Asterisk' : 'Add Dongle Slot(s) to Asterisk' %></h3>
                <button type="button" onclick="closeModal('addDongleSlotModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="saveNewDongleSlot(event)" class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotCount"><%= isRtl ? 'عدد الشرائح (Quantity) *' : 'Quantity to Add *' %></label>
                        <input type="number" id="newSlotCount" value="1" min="1" max="32" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs font-bold text-emerald-400">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotPrefix"><%= isRtl ? 'سابقة الاسم (Prefix)' : 'Name Prefix' %></label>
                        <input type="text" id="newSlotPrefix" value="dongle" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotName"><%= isRtl ? 'اسم الفتحة الأولى (Custom Name if Qty=1)' : 'Custom Slot Name (Single Slot)' %></label>
                    <input type="text" id="newSlotName" placeholder="e.g. dongle1" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotAudio"><%= isRtl ? 'منفذ الصوت الأولي' : 'Base Audio TTY Port' %></label>
                        <input type="text" id="newSlotAudio" placeholder="/dev/ttyUSB1" class="config-input w-full font-mono text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotData"><%= isRtl ? 'منفذ البيانات الأولي' : 'Base Data TTY Port' %></label>
                        <input type="text" id="newSlotData" placeholder="/dev/ttyUSB2" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotRxGain">Rx Gain (dB)</label>
                        <input type="number" id="newSlotRxGain" value="3" min="-10" max="10" class="config-input w-full font-mono text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotTxGain">Tx Gain (dB)</label>
                        <input type="number" id="newSlotTxGain" value="3" min="-10" max="10" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div class="p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase mb-0.5"><%= isRtl ? 'معاينة الفتحات المضافة' : 'Preview Slots To Create' %>:</span>
                    <span id="newSlotPreviewText" class="font-bold">dongle0</span>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('addDongleSlotModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'إضافة الشرائح' : 'Add Slot(s)' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: REMOVE DONGLE SLOT (ROOT USER ONLY) -->
    <div id="removeDongleSlotModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'حذف شرائح/مودم من Asterisk' : 'Remove Dongle Slot(s) from Asterisk' %></h3>
                <button type="button" onclick="closeModal('removeDongleSlotModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="executeRemoveDongleSlot(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="removeSlotCount"><%= isRtl ? 'عدد الشرائح المراد حذفها (من الأخيرة)' : 'Quantity of Slots to Remove (From Last)' %></label>
                    <input type="number" id="removeSlotCount" value="1" min="1" max="32" class="config-input w-full font-mono text-xs text-red-400 font-bold mb-2">
                </div>
                <div>
                    <span class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'أو اختر فتحات محددة لحذفها' : 'Or Select Specific Dongle Slots to Remove' %></span>
                    <div id="removeSlotChecklist" class="space-y-1.5 max-h-40 overflow-y-auto p-2.5 bg-[var(--bg-card)] rounded-lg border border-[var(--border-primary)] font-mono text-xs custom-scrollbar">
                        <!-- Populated dynamically -->
                    </div>
                </div>
                <p class="text-xs text-amber-400 font-semibold leading-relaxed">
                    <%= isRtl ? 'ملاحظة: سيتم حذف الفتحات المحددة من dongle.conf وتنظيف مطابقات AstDB وتحديث Asterisk.' : 'Notice: This will remove the selected dongle sections from dongle.conf and reload Asterisk.' %>
                </p>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('removeDongleSlotModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold bg-red-600 hover:bg-red-700"><%= isRtl ? 'تأكيد الحذف' : 'Confirm Delete' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: CONNECT NEW PBX (1-CLICK SSH BOOTSTRAP) -->
    <div id="connectPbxModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-xl w-full flex flex-col text-[var(--text-primary)] overflow-hidden shadow-2xl">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'ربط سيرفر أستيركس جديد' : 'Connect New Asterisk PBX' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'إعداد النفق والتبادل المشفر ومزامنة التحويلات تلقائياً عبر SSH' : 'Automated IAX2 tunnel provisioning, bilateral keys, and entity discovery over SSH' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('connectPbxModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form id="connectPbxForm" onsubmit="submitBootstrapPbx(event)" class="p-6 space-y-4">
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="sm:col-span-2">
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="connRemoteHost"><%= isRtl ? 'عنوان السيرفر البعيد (Host / IP) *' : 'Remote Host / IP *' %></label>
                        <input type="text" id="connRemoteHost" required placeholder="192.168.100.228" class="config-input w-full font-mono text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="connRemoteSshPort"><%= isRtl ? 'منفذ SSH' : 'SSH Port' %></label>
                        <input type="number" id="connRemoteSshPort" value="22" required class="config-input w-full font-mono text-xs">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="connRemoteSshUser"><%= isRtl ? 'مستخدم SSH *' : 'SSH Username *' %></label>
                        <input type="text" id="connRemoteSshUser" value="root" required class="config-input w-full font-mono text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="connRemoteSshPass"><%= isRtl ? 'كلمة مرور SSH *' : 'SSH Password *' %></label>
                        <input type="password" id="connRemoteSshPass" required autocomplete="current-password" placeholder="••••••••" class="config-input w-full font-mono text-xs">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-[var(--border-primary)]">
                    <div>
                        <label class="block text-xs font-bold text-amber-400 uppercase mb-1" for="connRemoteSiteCode"><%= isRtl ? 'كود الموقع البعيد (Site Code) *' : 'Remote Site Code (Prefix) *' %></label>
                        <input type="text" id="connRemoteSiteCode" required placeholder="20" maxlength="6" class="config-input w-full font-mono text-xs font-bold text-amber-400">
                        <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'البادئة للاتصال بتحويلات هذا السيرفر (مثال 20)' : 'Prefix used to dial this server (e.g. 20 -> 20101)' %></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="connRemoteNodeName"><%= isRtl ? 'اسم السيرفر / الفرع *' : 'Remote PBX Name *' %></label>
                        <input type="text" id="connRemoteNodeName" required placeholder="Branch Office" class="config-input w-full text-xs">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                    <label for="connAllowInternal" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="connAllowInternal" checked class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالاتصال الداخلي' : 'Allow Internal Dialing' %></span>
                    </label>
                    <label for="connAllowEgress" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="connAllowEgress" checked class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'مشاركة خطوط GSM والصادر' : 'Allow Outbound / GSM Egress' %></span>
                    </label>
                </div>

                <!-- Status Output / Spinner Area -->
                <div id="connBootstrapStatusArea" class="hidden p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs font-mono text-amber-400">
                    <div class="flex items-center gap-2">
                        <svg class="animate-spin h-4 w-4 text-amber-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                        </svg>
                        <span id="connBootstrapStatusText"><%= isRtl ? 'جاري الاتصال بالسيرفر وإعداد نفق IAX2...' : 'Connecting via SSH and provisioning bilateral IAX2 link...' %></span>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('connectPbxModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" id="connBootstrapSubmitBtn" class="config-btn-primary px-5 py-2 text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <span><%= isRtl ? 'بدء الربط الآلي (Bootstrap)' : 'Bootstrap & Connect' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: EDIT FEDERATION PEER -->
    <div id="editPeerModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden shadow-2xl">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'تعديل السيرفر المرتبط' : 'Edit Connected PBX' %></h3>
                <button type="button" onclick="closeModal('editPeerModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>

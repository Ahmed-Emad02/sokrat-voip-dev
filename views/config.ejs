        window.deleteMohCategory = deleteMohCategory;
        window.uploadMohFile = uploadMohAudio;
        function openAddDongleSlotModal() {
            openModal('addDongleSlotModal');
            const cards = document.querySelectorAll('#modemDonglesGrid [data-dongle-id]');
            const existingNames = Array.from(cards).map(c => c.getAttribute('data-dongle-id'));
            let nextIndex = 0;
            while (existingNames.includes(`dongle${nextIndex}`)) {
                nextIndex++;
            }
            const countEl = document.getElementById('newSlotCount');
            if (countEl) countEl.value = '1';
            const prefixEl = document.getElementById('newSlotPrefix');
            if (prefixEl) prefixEl.value = 'dongle';
            const nameEl = document.getElementById('newSlotName');
            if (nameEl) nameEl.value = `dongle${nextIndex}`;
            const audioEl = document.getElementById('newSlotAudio');
            if (audioEl) audioEl.value = `/dev/ttyUSB${nextIndex * 3 + 1}`;
            const dataEl = document.getElementById('newSlotData');
            if (dataEl) dataEl.value = `/dev/ttyUSB${nextIndex * 3 + 2}`;
            updateDongleSlotPreview();
        }
        window.openAddDongleSlotModal = openAddDongleSlotModal;

        function updateDongleSlotPreview() {
            const count = Math.max(1, parseInt(document.getElementById('newSlotCount')?.value, 10) || 1);
            const prefix = (document.getElementById('newSlotPrefix')?.value || 'dongle').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_') || 'dongle';
            const customName = document.getElementById('newSlotName')?.value.trim().toLowerCase();
            const cards = document.querySelectorAll('#modemDonglesGrid [data-dongle-id]');
            const existingSlotNames = new Set(Array.from(cards).map(c => c.getAttribute('data-dongle-id')));

            const previews = [];
            let nextIndex = 0;
            for (let i = 0; i < count; i++) {
                let targetName = '';
                if (count === 1 && customName) {
                    targetName = customName;
                } else {
                    while (existingSlotNames.has(`${prefix}${nextIndex}`)) {
                        nextIndex++;
                    }
                    targetName = `${prefix}${nextIndex}`;
                    existingSlotNames.add(targetName);
                }
                previews.push(targetName);
            }
            const previewEl = document.getElementById('newSlotPreviewText');
            if (previewEl) previewEl.textContent = previews.join(', ');
        }
        window.updateDongleSlotPreview = updateDongleSlotPreview;

        async function saveNewDongleSlot(e) {
            e.preventDefault();
            const count = Math.max(1, parseInt(document.getElementById('newSlotCount').value, 10) || 1);
            const prefix = document.getElementById('newSlotPrefix').value.trim();
            const dongleName = document.getElementById('newSlotName').value.trim().toLowerCase();
            const audio = document.getElementById('newSlotAudio').value.trim();
            const dataPort = document.getElementById('newSlotData').value.trim();
            const rxgain = parseInt(document.getElementById('newSlotRxGain').value, 10) || 0;
            const txgain = parseInt(document.getElementById('newSlotTxGain').value, 10) || 0;

            showToast(isRtl ? `جاري إضافة ${count} فتحة مودم جديدة...` : `Adding ${count} new dongle slot(s) to dongle.conf...`, 'info');

            try {
                const res = await fetch('/api/config/modem/dongle-slot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ count, prefix, dongleName, audio, data: dataPort, rxgain, txgain })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('addDongleSlotModal');
                    fetchModemConfig();
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to add dongle slot(s)', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.saveNewDongleSlot = saveNewDongleSlot;

        function openRemoveDongleSlotModal() {
            openModal('removeDongleSlotModal');
            const container = document.getElementById('removeSlotChecklist');
            if (!container) return;
            container.innerHTML = '<div class="text-center text-xs text-[var(--text-muted)] py-2">' + (isRtl ? 'جاري تحميل الشرائح...' : 'Loading slots...') + '</div>';
            const countEl = document.getElementById('removeSlotCount');
            if (countEl) countEl.value = '1';
            fetch('/api/config/modem')
                .then(res => res.json())
                .then(data => {
                    const dongles = data && data.dongles ? Object.keys(data.dongles) : [];
                    container.innerHTML = '';
                    if (dongles.length === 0) {
                        container.innerHTML = '<div class="text-center text-xs text-[var(--text-muted)] py-2">' + (isRtl ? 'لا توجد فتحات شرائح في dongle.conf' : 'No dongle slots found in dongle.conf') + '</div>';
                    } else {
                        dongles.forEach(dId => {
                            const label = document.createElement('label');
                            label.className = 'flex items-center gap-2 text-xs cursor-pointer hover:text-white';
                            label.innerHTML = `<input type="checkbox" name="removeDongleSlot" value="${dId}" class="rounded border-[var(--border-primary)] text-red-500 focus:ring-red-500"> <span>${dId}</span>`;
                            container.appendChild(label);
                        });
                    }
                })
                .catch(() => {
                    container.innerHTML = '<div class="text-center text-xs text-red-400 py-2">' + (isRtl ? 'فشل تحميل الشرائح' : 'Failed to load slots') + '</div>';
                });
        }
        window.openRemoveDongleSlotModal = openRemoveDongleSlotModal;

        async function executeRemoveDongleSlot(e) {
            e.preventDefault();
            const checked = Array.from(document.querySelectorAll('input[name="removeDongleSlot"]:checked')).map(cb => cb.value);
            const count = Math.max(1, parseInt(document.getElementById('removeSlotCount').value, 10) || 1);

            const payload = {};
            if (checked.length > 0) {
                payload.dongleNames = checked;
            } else {
                payload.count = count;
            }

            const targetText = checked.length > 0 ? checked.join(', ') : `${count} last slot(s)`;
            if (!confirm(isRtl ? `حذف الفتحات '${targetText}' نهائياً من dongle.conf؟` : `Remove dongle slot(s) '${targetText}' permanently from dongle.conf?`)) return;

            showToast(isRtl ? 'جاري حذف الشرائح...' : 'Removing dongle slot(s)...', 'info');

            try {
                const res = await fetch('/api/config/modem/dongle-slot', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('removeDongleSlotModal');
                    fetchModemConfig();
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to remove dongle slot(s)', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.executeRemoveDongleSlot = executeRemoveDongleSlot;
        function fetchAnnouncements() {
            fetchMohData();
            return fetch('/api/config/announcements')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.announcements) return;
                    loadedAnnouncementsList = Array.isArray(data.announcements) ? data.announcements : [];
                    const list = loadedAnnouncementsList;
                    const tbody = document.getElementById('announcements-table-body');
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد إعلانات مسجلة.' : 'No Announcements found.') + '</td></tr>';
                        return;
                    }

                    list.forEach(ann => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors border-b border-[var(--border-primary)]/40 text-xs';

                        const opts = [];
                        if (ann.allow_skip) opts.push('<span class="px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold">Skip</span>');
                        if (ann.return_ivr) opts.push('<span class="px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold">Return IVR</span>');
                        if (ann.noanswer) opts.push('<span class="px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 text-[10px] font-bold">No Answer</span>');
                        const optsHtml = opts.length ? opts.join(' ') : '<span class="text-[var(--text-muted)]">-</span>';

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${ann.announcement_id}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ann.description || '')}</td>
                            <td class="py-3 px-4 text-emerald-400 font-semibold">${escapeHtml(ann.recording_name || 'None (ID: ' + ann.recording_id + ')')}</td>
                            <td class="py-3 px-4 font-mono font-bold text-amber-400">${ann.repeat_msg ? escapeHtml(ann.repeat_msg) : '-'}</td>
                            <td class="py-3 px-4 flex items-center gap-1 flex-wrap">${optsHtml}</td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-bold">${formatDestination(ann.post_dest)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editAnnouncement(${ann.announcement_id})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 transition cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteAnnouncement(${ann.announcement_id})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 transition cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }
        window.fetchAnnouncements = fetchAnnouncements;

        function populateAnnouncementRecordingsDropdown(selectedId = 0) {
            const sel = document.getElementById('annRecording');
            if (!sel) return;
            sel.innerHTML = '<option value="0">== ' + (isRtl ? 'بدون تسجيل (استخدام تحويل النص إلى كلام)' : 'None (Use Text-To-Speech TTS)') + ' ==</option>';
            (loadedRecordingsList || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = r.displayname + ' (ID: ' + r.id + ')';
                if (String(r.id) === String(selectedId)) opt.selected = true;
                sel.appendChild(opt);
            });
        }
        window.populateAnnouncementRecordingsDropdown = populateAnnouncementRecordingsDropdown;

        function onAnnRecordingChange() {
            const recId = parseInt(document.getElementById('annRecording').value, 10) || 0;
            const ttsLang = document.getElementById('annTtsLang');
            const ttsText = document.getElementById('annTtsText');
            const allowSkip = document.getElementById('annAllowSkip');

            if (!ttsLang || !ttsText || !allowSkip) return;

            if (recId === 0) {
                ttsLang.disabled = false;
                ttsText.disabled = false;
                ttsLang.classList.remove('opacity-40');
                ttsText.classList.remove('opacity-40');

                allowSkip.checked = false;
                allowSkip.disabled = true;
                allowSkip.closest('label').classList.add('opacity-40', 'cursor-not-allowed');
            } else {
                ttsLang.disabled = true;
                ttsText.disabled = true;
                ttsLang.classList.add('opacity-40');
                ttsText.classList.add('opacity-40');

                allowSkip.disabled = false;
                allowSkip.closest('label').classList.remove('opacity-40', 'cursor-not-allowed');
            }
        }
        window.onAnnRecordingChange = onAnnRecordingChange;

        function openAnnouncementModal() {
            openModal('announcementModal');
            document.getElementById('announcementForm').reset();
            document.getElementById('annEditMode').value = 'false';
            document.getElementById('annId').value = '';
            document.getElementById('annDescription').value = '';
            document.getElementById('annRepeatMsg').value = '';
            document.getElementById('annTtsLang').value = 'en-US';
            document.getElementById('annTtsText').value = '';
            document.getElementById('annAllowSkip').checked = false;
            document.getElementById('annReturnIvr').checked = false;
            document.getElementById('annNoAnswer').checked = false;
            populateAnnouncementRecordingsDropdown();
            document.getElementById('annPostDestination').value = 'app-blackhole,hangup,1';

            initDestinationSelectInstances();
            if (annPostDestSelectInstance) annPostDestSelectInstance.setDialplan('app-blackhole,hangup,1');

            document.getElementById('announcementModalTitle').textContent = isRtl ? 'إضافة إعلان جديد' : 'Add Announcement';
            ensureAllConfigListsLoaded().then(() => {
                populateAnnouncementRecordingsDropdown();
                if (annPostDestSelectInstance) annPostDestSelectInstance.render();
            }).catch(() => {});
        }
        window.openAnnouncementModal = openAnnouncementModal;

        function editAnnouncement(id) {
            openModal('announcementModal');
            const ann = (loadedAnnouncementsList || []).find(a => String(a.announcement_id) === String(id));
            if (!ann) {
                openAnnouncementModal();
                return;
            }
            document.getElementById('annEditMode').value = 'true';
            document.getElementById('annId').value = ann.announcement_id;
            document.getElementById('annDescription').value = ann.description || '';
            document.getElementById('annRepeatMsg').value = ann.repeat_msg || '';
            document.getElementById('annTtsLang').value = ann.tts_lang || 'en-US';
            document.getElementById('annTtsText').value = ann.tts_text || '';
            document.getElementById('annAllowSkip').checked = !!ann.allow_skip;
            document.getElementById('annReturnIvr').checked = !!ann.return_ivr;
            document.getElementById('annNoAnswer').checked = !!ann.noanswer;
            populateAnnouncementRecordingsDropdown(ann.recording_id || 0);
            document.getElementById('annPostDestination').value = ann.post_dest || 'app-blackhole,hangup,1';

            initDestinationSelectInstances();
            if (annPostDestSelectInstance) annPostDestSelectInstance.setDialplan(ann.post_dest || 'app-blackhole,hangup,1');

            document.getElementById('announcementModalTitle').textContent = (isRtl ? 'تعديل الإعلان: ' : 'Edit Announcement: ') + (ann.description || '');
            ensureAllConfigListsLoaded().then(() => {
                populateAnnouncementRecordingsDropdown(ann.recording_id || 0);
                if (annPostDestSelectInstance) annPostDestSelectInstance.render();
            }).catch(() => {});
        }
        window.editAnnouncement = editAnnouncement;

        function saveAnnouncement(e) {
            e.preventDefault();
            const editMode = document.getElementById('annEditMode').value === 'true';
            const id = document.getElementById('annId').value;
            const description = document.getElementById('annDescription').value.trim();
            const recording_id = document.getElementById('annRecording').value;
            const recId = parseInt(recording_id, 10) || 0;
            const repeat_msg = document.getElementById('annRepeatMsg').value;
            const tts_lang = recId === 0 ? (document.getElementById('annTtsLang').value || 'en-US') : 'en-US';
            const tts_text = recId === 0 ? document.getElementById('annTtsText').value.trim() : '';
            const allow_skip = recId === 0 ? 0 : (document.getElementById('annAllowSkip').checked ? 1 : 0);
            const return_ivr = document.getElementById('annReturnIvr').checked ? 1 : 0;
            const noanswer = document.getElementById('annNoAnswer').checked ? 1 : 0;
            const post_dest = document.getElementById('annPostDestination').value.trim();

            if (!description) {
                showToast('Please enter an Announcement Description.', 'error');
                return;
            }

            const method = editMode ? 'PUT' : 'POST';
            const url = editMode ? '/api/config/announcements/' + id : '/api/config/announcements';

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ description, recording_id, allow_skip, post_dest, return_ivr, noanswer, repeat_msg, tts_lang, tts_text })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeModal('announcementModal');
                    showToast(editMode ? 'Announcement updated successfully.' : 'Announcement added successfully.', 'success');
                    fetchAnnouncements();
                } else {
                    showToast(data.error || 'Failed to save Announcement.', 'error');
                }
            })
            .catch(err => {
                showToast('Failed to connect to server.', 'error');
            });
        }
        window.saveAnnouncement = saveAnnouncement;

        function deleteAnnouncement(id) {
            if (!confirm(isRtl ? 'هل أنت متأكد من حذف هذا الإعلان؟' : 'Are you sure you want to delete this Announcement?')) return;
            fetch(`/api/config/announcements/${id}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast('Announcement deleted successfully.', 'success');
                        fetchAnnouncements();
                    } else {
                        showToast(data.error || 'Failed to delete Announcement.', 'error');
                    }
                });
        }
        window.deleteAnnouncement = deleteAnnouncement;

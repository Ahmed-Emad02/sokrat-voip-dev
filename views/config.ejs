                                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /></svg>
                                        </div>
                                        <div>
                                            <label for="txRange_${id}" class="text-xs font-bold text-[var(--text-primary)] block">${isRtl ? 'الإرسال (Tx)' : 'Transmit (Tx)'}</label>
                                            <span class="text-[9px] text-[var(--text-muted)]">${isRtl ? 'الصوت الصادر' : 'Outgoing audio'}</span>
                                        </div>
                                    </div>
                                    <span id="txValBadge_${id}" class="font-mono font-black text-[11px] text-blue-400">${formatDb(txValue)}</span>
                                </div>
                                <div class="flex items-center gap-2.5">
                                    <input type="range" id="txRange_${id}" min="-10" max="10" value="${txValue}" step="1"
                                        oninput="document.getElementById('txValBadge_${id}').textContent = (this.value > 0 ? '+' + this.value : this.value) + ' dB'; document.getElementById('txInput_${id}').value = this.value"
                                        class="w-full accent-blue-500 bg-[var(--bg-primary)] h-2 rounded-lg cursor-pointer">
                                    <input type="number" id="txInput_${id}" min="-10" max="10" value="${txValue}"
                                        oninput="let v = Math.max(-10, Math.min(10, parseInt(this.value)||0)); this.value = v; document.getElementById('txRange_${id}').value = v; document.getElementById('txValBadge_${id}').textContent = (v > 0 ? '+' + v : v) + ' dB';"
                                        class="config-input w-16 text-center font-mono font-bold text-xs py-1">
                                </div>
                                <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)]"><span>-10</span><span>0</span><span>+10</span></div>

                    <div>
                        <label for="mohCategorySelect" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'فئة الموسيقى (Category)' : 'Select MoH Category' %></label>
                        <select id="mohCategorySelect" onchange="onMohCategoryChange()" class="config-input w-full text-xs font-mono font-bold">
                            <!-- Populated dynamically -->
                        </select>
                    </div>
                    <div>
                        <span class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'معلومات الفئة' : 'Category Info' %></span>
                        <div id="mohCategoryInfo" class="text-xs text-[var(--text-muted)] space-y-1 font-mono pt-1">
                            <div><span class="text-white"><%= isRtl ? 'المسار:' : 'Path:' %></span> <span id="mohPathDisplay" class="truncate font-mono text-[11px] text-amber-400">/var/lib/asterisk/moh/</span></div>
                            <div><span class="text-white"><%= isRtl ? 'الفرز:' : 'Sort:' %></span> <span id="mohSortDisplay" class="font-bold text-emerald-400">alpha</span></div>
                            <div id="mohCategoryDeleteContainer" class="pt-1"></div>
                        </div>
                    </div>
                    <div class="flex flex-col justify-end">
                        <form id="mohUploadForm" onsubmit="uploadMohAudio(event)" class="flex items-center gap-2">
                            <input type="file" id="mohAudioFile" accept=".wav,.mp3,.gsm,.ogg" class="hidden" onchange="updateMohFileLabel()">
                            <button type="button" onclick="document.getElementById('mohAudioFile').click()" class="config-btn-secondary px-3 py-2 text-xs flex-1 truncate font-mono">
                                <span id="mohFileLabel"><%= isRtl ? 'اختر ملف صوتی...' : 'Choose audio file...' %></span>
                            </button>
                            <button type="submit" class="config-btn-primary px-4 py-2 text-xs flex items-center gap-1.5 font-bold cursor-pointer shrink-0">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                                <span><%= isRtl ? 'رفع' : 'Upload' %></span>

                    stroke: #475569 !important;
                    opacity: 0.6 !important;
                }
            </style>
            <div class="config-card p-6 relative">
                <!-- Header of Diagram tab -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'مخطط الإعدادات (Config Diagram)' : 'Config Diagram' %></h2>
                        <p class="text-xs text-[var(--text-muted)]"><%= isRtl ? 'عرض مرئي تفاعلي للعلاقات بين المسارات، مجموعات الاتصال، التحويلات، وخطوط الربط' : 'Interactive visual diagram of the connections between inbound routes, ring groups, extensions, outbound routes, and trunks' %></p>
                    </div>
                    <!-- Toolbar controls -->
                    <div class="flex items-center gap-2">
                        <!-- Search input -->
                        <div class="relative">
                            <input type="text" id="diagramSearch" oninput="filterDiagramNodes()" placeholder="<%= isRtl ? 'ابحث عن عنصر...' : 'Search node...' %>" class="config-input pl-8 pr-3 py-1.5 text-xs w-48 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg">
                            <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">

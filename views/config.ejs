                            <div class="flex justify-between"><span>${isRtl ? 'الزمن:' : 'Time:'}</span> <span class="text-white">${rg.grptime}s</span></div>
                            <div class="flex justify-between"><span>${isRtl ? 'الوجهة البديلة:' : 'Failover:'}</span> <span class="text-purple-400 truncate max-w-[170px]">${formatDestination(rg.postdest)}</span></div>

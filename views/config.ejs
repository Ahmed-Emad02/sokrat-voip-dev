<%
var activeLang = (typeof currentLang !== 'undefined' && currentLang) ? currentLang : 'en';
var isRtl = (typeof isRtl !== 'undefined') ? isRtl : (activeLang === 'ar');
var canManageGroupAdmin = (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) || (typeof currentUser !== 'undefined' && currentUser && (currentUser.isRoot || currentUser.group_name === 'super admins'));

function isTabAllowed(tabName) {
    if (tabName === 'stt' || tabName === 'audioprocessing') return true;
    if (typeof allowedTabs === 'undefined') return true;
    if (!Array.isArray(allowedTabs)) return true;
    if (tabName === 'callcodes') return allowedTabs.includes('config') || allowedTabs.includes('config-extensions') || allowedTabs.includes('extensions') || allowedTabs.includes('callcodes');
    return allowedTabs.includes('config') || allowedTabs.includes('gsm-dongles') || allowedTabs.includes('config-modem') || allowedTabs.includes('config-' + tabName) || allowedTabs.includes(tabName);
}
%>
<!DOCTYPE html>
<html lang="<%= activeLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
        function openModal(id) {
            try {
                if (typeof closeAllModals === 'function') closeAllModals();
                else {
                    document.querySelectorAll('[id$="Modal"]').forEach(function(m) {
                        m.classList.add('hidden');
                        m.style.setProperty('display', 'none', 'important');
                        m.setAttribute('aria-hidden', 'true');
                    });
                }
            } catch (_) {}
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.remove('hidden');
                modal.style.setProperty('display', 'flex', 'important');
                modal.setAttribute('aria-hidden', 'false');
            }
        }
        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) {
                modal.classList.add('hidden');
                modal.style.setProperty('display', 'none', 'important');
                modal.setAttribute('aria-hidden', 'true');
            }
            const inPopup = document.getElementById('inboundDongleInfoPopup');
            if (inPopup) inPopup.classList.add('hidden');
        }
        function openInboundModal() {
            openModal('inboundModal');
        }
        window.openModal = openModal;
        window.closeModal = closeModal;
        window.openInboundModal = openInboundModal;
    </script>

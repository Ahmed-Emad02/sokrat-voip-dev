            bindEvents() {
                const catTrigger = this.container.querySelector('.dest-cat-trigger');
                const catMenu = this.container.querySelector('.dest-cat-dropdown-menu');
                const customInput = this.container.querySelector('.dest-custom-input');
                const trigger = this.container.querySelector('.dest-combobox-trigger');
                const menu = this.container.querySelector('.dest-dropdown-menu');
                const searchInput = this.container.querySelector('.dest-search-input');

                if (catMenu && catMenu.parentNode !== document.body) {
                    document.body.appendChild(catMenu);
                    this.currentCatMenu = catMenu;
                }

                if (menu && menu.parentNode !== document.body) {
                    document.body.appendChild(menu);
                    this.currentMenu = menu;
                }

                const positionCatMenu = () => {
                    if (!catTrigger || !catMenu) return;
                    if (typeof window.positionConfigDropdown === 'function') {
                        window.positionConfigDropdown(catTrigger, catMenu);
                    }
                };
                const hideCatMenu = () => {
                    if (!catMenu) return;
                    if (typeof window.closeConfigDropdownMenu === 'function') {
                        window.closeConfigDropdownMenu(catMenu);
                    } else {
                        catMenu.classList.add('hidden');
                        catTrigger?.setAttribute('aria-expanded', 'false');
                    }
                };
                const chooseCategory = item => {
                    this.selectedCategory = item.getAttribute('data-cat-id');
                    const categories = DestinationSelect.getCategories();
                    const category = categories.find(c => c.id === this.selectedCategory);
                    if (this.selectedCategory === 'custom') {
                        this.selectedTarget = 'custom';
                        this.dialplanString = this.customDialplanString || '';
                    } else if (this.selectedCategory === 'external') {
                        this.selectedTarget = (this.selectedTarget && this.selectedTarget !== 'external') ? this.selectedTarget : '';
                        this.dialplanString = this.selectedTarget ? `ext-external-failover,${this.selectedTarget},1` : 'app-blackhole,hangup,1';
                    } else if (category && category.targets && category.targets.length) {
                        this.selectedTarget = category.targets[0].id;
                        this.dialplanString = category.targets[0].dialplanString;
                    } else {
                        this.selectedTarget = '';
                        this.dialplanString = '';
                    }
                    this.searchTerm = '';
                    hideCatMenu();
                    this.render();
                    this.emitChange();
                };

                if (catTrigger && catMenu) {
                    catMenu._reposition = positionCatMenu;
                    catMenu._trigger = catTrigger;
                    catTrigger.addEventListener('click', event => {
                        event.stopPropagation();
                        const isOpening = catMenu.classList.contains('hidden');
                        if (!isOpening) {
                            hideCatMenu();
                            return;
                        }
                        if (typeof window.closeConfigDropdowns === 'function') {
                            window.closeConfigDropdowns(catMenu);
                        }
                        catMenu.classList.remove('hidden');
                        catTrigger.setAttribute('aria-expanded', 'true');
                        positionCatMenu();
                    });
                    catMenu.addEventListener('click', event => event.stopPropagation());
                    catMenu.querySelectorAll('.dest-cat-option-item').forEach(item => {
                        item.addEventListener('click', () => chooseCategory(item));
                    });
                }

                if (customInput) {
                    customInput.addEventListener('input', event => {
                        this.customDialplanString = event.target.value.trim();
                        this.dialplanString = this.customDialplanString;
                        this.emitChange();
                    });
                }

                const externalInput = this.container.querySelector('.dest-external-input');
                const externalDongleSelect = this.container.querySelector('.dest-external-dongle');

                const updateExternalDialplan = () => {
                    const rawNum = externalInput ? externalInput.value.trim().replace(/\s+/g, '') : '';
                    const dongle = externalDongleSelect ? externalDongleSelect.value.trim() : '';
                    this.selectedTarget = rawNum;
                    this.selectedDongle = dongle;
                    if (!rawNum) {
                        this.dialplanString = 'app-blackhole,hangup,1';
                    } else if (dongle) {
                        this.dialplanString = `ext-external-failover,${rawNum}/${dongle},1`;
                    } else {
                        this.dialplanString = `ext-external-failover,${rawNum},1`;
                    }
                    this.emitChange();
                };

                if (externalInput) externalInput.addEventListener('input', updateExternalDialplan);
                if (externalDongleSelect) externalDongleSelect.addEventListener('change', updateExternalDialplan);

                const positionMenu = () => {
                    if (!trigger || !menu) return;
                    if (typeof window.positionConfigDropdown === 'function') {
                        window.positionConfigDropdown(trigger, menu);
                    }
                };
                const hideMenu = () => {
                    if (!menu) return;
                    if (typeof window.closeConfigDropdownMenu === 'function') {
                        window.closeConfigDropdownMenu(menu);
                    } else {
                        menu.classList.add('hidden');
                        trigger?.setAttribute('aria-expanded', 'false');
                    }
                };
                const chooseTarget = item => {
                    this.selectedTarget = item.getAttribute('data-target-id');
                    this.dialplanString = item.getAttribute('data-dialplan');
                    this.searchTerm = '';
                    hideMenu();
                    this.render();
                    this.emitChange();
                };
                const bindTargetItems = root => {
                    if (!root) return;
                    root.querySelectorAll('.dest-option-item').forEach(item => {
                        item.addEventListener('click', () => chooseTarget(item));
                    });
                };

                if (trigger && menu) {
                    menu._reposition = positionMenu;
                    menu._trigger = trigger;
                    trigger.addEventListener('click', event => {
                        event.stopPropagation();
                        const isOpening = menu.classList.contains('hidden');
                        if (!isOpening) {
                            hideMenu();
                            return;
                        }

                        if (typeof window.closeConfigDropdowns === 'function') {
                            window.closeConfigDropdowns(menu);
                        }
                        if (searchInput) {
                            this.searchTerm = '';
                            searchInput.value = '';
                            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
                        }
                        menu.classList.remove('hidden');
                        trigger.setAttribute('aria-expanded', 'true');
                        positionMenu();
                        if (searchInput) setTimeout(() => searchInput.focus(), 0);
                    });
                    menu.addEventListener('click', event => event.stopPropagation());
                }

                if (searchInput && menu) {
                    searchInput.addEventListener('input', event => {
                        this.searchTerm = event.target.value;
                        const categories = DestinationSelect.getCategories();
                        const category = categories.find(item => item.id === this.selectedCategory) || categories[0];
                        let filtered = category.targets || [];
                        if (this.searchTerm.trim()) {
                            const term = this.searchTerm.toLowerCase().trim();
                            filtered = filtered.filter(target =>
                                target.label.toLowerCase().includes(term) ||
                                target.id.toLowerCase().includes(term) ||
                                target.dialplanString.toLowerCase().includes(term)
                            );
                        }

                        const optionsList = menu.querySelector('.options-list');
                        if (!optionsList) return;
                        optionsList.innerHTML = filtered.length === 0 ? `
                            <div class="px-3 py-2 text-center text-[var(--text-muted)] text-[11px] italic">${this.isRtl ? 'لا توجد نتائج مطابقة' : 'No matching targets'}</div>
                        ` : filtered.map(target => `
                            <button type="button" role="option" aria-selected="${String(target.id === this.selectedTarget)}" data-target-id="${escapeHtml(target.id)}" data-dialplan="${escapeHtml(target.dialplanString)}" class="dest-option-item custom-select-option config-dropdown-option flex items-start justify-between gap-2 transition-colors ${target.id === this.selectedTarget ? 'is-selected font-bold' : ''}">
                                <span class="flex-1 min-w-0 whitespace-normal break-words">${escapeHtml(target.label)}</span>
                                <span class="font-mono text-[10px] opacity-60 shrink-0">${escapeHtml(target.dialplanString.split(',')[0])}</span>
                            </button>
                        `).join('');
                        bindTargetItems(optionsList);
                        if (!menu.classList.contains('hidden')) positionMenu();
                    });
                    searchInput.addEventListener('keydown', event => {
                        if (event.key === 'Escape') {
                            event.stopPropagation();
                            hideMenu();
                            trigger?.focus();
                        } else if (event.key === 'Enter') {
                            event.preventDefault();
                            const firstMatch = menu.querySelector('.dest-option-item');
                            if (firstMatch) firstMatch.click();
                        }
                    });
                }

                bindTargetItems(menu);
            }
        }
        window.DestinationSelect = DestinationSelect;
        let inboundDestSelectInstance = null;
        let rgPostDestSelectInstance = null;

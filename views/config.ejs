                        <input type="number" id="newSlotCount" value="1" min="1" max="32" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs font-bold text-emerald-400">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotPrefix"><%= isRtl ? 'سابقة الاسم (Prefix)' : 'Name Prefix' %></label>
                        <input type="text" id="newSlotPrefix" value="dongle" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="newSlotName"><%= isRtl ? 'اسم الفتحة الأولى (Custom Name if Qty=1)' : 'Custom Slot Name (Single Slot)' %></label>
                    <input type="text" id="newSlotName" placeholder="e.g. dongle1" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs">

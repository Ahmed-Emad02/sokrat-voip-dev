        // --- 2.5 QUEUES MANAGEMENT JS ---
        function renderQueueAgentChecklist() {
            const container = document.getElementById('queueAgentsChecklistContainer');
            if (!container) return;
            container.innerHTML = '';

            const currentStatic = parseQueueExtArray('queueStaticList');
            const currentDyn = parseQueueExtArray('queueDynList');
            const filterTerm = (document.getElementById('queueAgentSearch')?.value || '').toLowerCase().trim();

            const allAgentsToRender = [];

            // 1. Local extensions
            (loadedExtensionsList || []).forEach(ext => {
                allAgentsToRender.push({
                    extStr: String(ext.extension),
                    nameStr: String(ext.name || 'Ext'),
                    badgeLabel: null,
                    isRemote: false
                });
            });

            // 2. Remote federation extensions
            (loadedRemoteExtensionsList || []).forEach(re => {
                const peer = (loadedFederationPeersList || []).find(p => Number(p.id) === Number(re.peer_id));
                const peerLabel = peer ? (peer.node_name || 'Site ' + peer.site_code) : 'Remote';
                allAgentsToRender.push({
                    extStr: String(re.dial_alias),
                    nameStr: `[${peerLabel}] ${re.display_name || re.native_extension}`,
                    badgeLabel: `#${peer ? peer.site_code : ''}`,
                    isRemote: true
                });
            });

            if (allAgentsToRender.length === 0) {
                container.innerHTML = `<span class="text-xs text-[var(--text-muted)] italic">${isRtl ? 'لا توجد تحويلات مسجلة بالمجمّع' : 'No extensions found.'}</span>`;
                return;
            }

            allAgentsToRender.forEach(agent => {
                if (filterTerm && !agent.extStr.toLowerCase().includes(filterTerm) && !agent.nameStr.toLowerCase().includes(filterTerm)) {
                    return;
                }

                const isStatic = currentStatic.includes(agent.extStr);
                const isDyn = currentDyn.includes(agent.extStr);
                const isAssigned = isStatic || isDyn;

                let badgeStyle = 'bg-slate-200/80 text-slate-700 dark:bg-zinc-800/80 dark:text-zinc-400 border-slate-300 dark:border-zinc-700 hover:border-amber-500/50';
                let badgeText = 'Off';

                if (isStatic && isDyn) {
                    badgeStyle = 'bg-gradient-to-r from-amber-500 to-indigo-600 text-white font-black border-purple-600';
                    badgeText = 'static + dyn';
                } else if (isStatic) {
                    badgeStyle = 'bg-amber-500 text-black font-black border-amber-600';
                    badgeText = 'Static';
                } else if (isDyn) {
                    badgeStyle = 'bg-indigo-600 text-white font-black border-indigo-700';
                    badgeText = 'Dynamic';
                }

                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-2 rounded-xl border border-[var(--border-primary)]/60 bg-[var(--bg-secondary)] hover:border-blue-500/40 transition-all gap-2';
                
                const remoteBadgeHtml = agent.isRemote ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-purple-500/20 text-purple-400 border border-purple-500/30 shrink-0">${agent.badgeLabel}</span>` : '';

                item.innerHTML = `
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="px-2 py-0.5 rounded-md font-mono text-xs font-bold bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-primary)] shrink-0">${agent.extStr}</span>
                        ${remoteBadgeHtml}
                        <span class="text-xs font-semibold text-[var(--text-primary)] truncate">${escapeHtml(agent.nameStr)}</span>
                    </div>
                    <button type="button" onclick="cycleQueueAgentRole('${agent.extStr}')" class="px-3 py-1 text-xs rounded-lg border font-bold cursor-pointer transition-all shrink-0 ${badgeStyle}">
                        ${badgeText}
                    </button>
                `;
                container.appendChild(item);
            });
        }

        function filterQueueAgentChecklist() {
            renderQueueAgentChecklist();
        }

        function cycleQueueAgentRole(extStr) {
            let staticList = parseQueueExtArray('queueStaticList');
            let dynList = parseQueueExtArray('queueDynList');

            const isStatic = staticList.includes(extStr);
            const isDyn = dynList.includes(extStr);

            if (isStatic || isDyn) {
                // Currently ON -> Turn OFF (remove from both)
                staticList = staticList.filter(e => e !== extStr);
                dynList = dynList.filter(e => e !== extStr);
            } else {
                // Currently OFF -> Turn ON (add to static + dyn)
                staticList.push(extStr);
                dynList.push(extStr);
            }

            document.getElementById('queueStaticList').value = staticList.join(', ');
            document.getElementById('queueDynList').value = dynList.join(', ');
            renderQueueAgentChecklist();
        }

        function parseQueueExtArray(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return [];
            const val = el.value || '';
            return val.split(/[\r\n\s\-,]+/).map(s => {
                const clean = s.trim().replace(/^[A-Za-z]+\//, '').replace(/@.*/, '');
                const match = clean.match(/(\d+)/);
                return match ? match[1] : clean;
            }).filter(Boolean);
        }


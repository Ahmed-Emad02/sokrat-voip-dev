                } else if (node.type === 'extension') {
                    const ext = node.data;
                    const vmBadge = ext.voicemail !== 'novm' ? 
                        `<span class="px-1.5 py-0.5 rounded text-[8px] font-black uppercase bg-red-950/40 text-red-400 border border-red-500/10 ml-auto">${isRtl ? 'بريد' : 'VM'}</span>` : '';
                    
                    cardBodyHTML = `

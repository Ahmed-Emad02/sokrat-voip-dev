                    const patternsJoined = patternList.slice(0, 3).join(', ') + (patternList.length > 3 ? '...' : '');
                    const trunksJoined = route.trunks.map(t => t.trunk_name).join(' ➜ ');
                    
                    cardBodyHTML = `

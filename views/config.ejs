            content: "";
            position: absolute;
            top: 0.625rem;
            bottom: 0.625rem;
            width: 2.25rem;
            pointer-events: none;
            opacity: 0;
            transition: opacity 220ms ease;
            z-index: 5;
        }
        #configTopPillBar::before {
            inset-inline-start: 0;
            background: linear-gradient(to right, var(--bg-secondary), transparent);
        }
        #configTopPillBar::after {
            inset-inline-end: 0;
            background: linear-gradient(to left, var(--bg-secondary), transparent);
        }
        #configTopPillBar.can-scroll-start::before { opacity: 1; }
        #configTopPillBar.can-scroll-end::after { opacity: 1; }
        #configTopPillsScroll:focus-visible {
            outline: 2px solid var(--accent-color, #dc2626);
            outline-offset: 3px;
            border-radius: 0.75rem;

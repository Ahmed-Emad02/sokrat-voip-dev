                                    <span class="px-1.5 py-0.5 rounded text-[8px] font-black bg-amber-950/40 text-amber-400 border border-amber-500/10 ml-auto">${staticCount} ${isRtl ? 'وكلاء' : 'agents'}</span>
                                </div>

        async function openRecordingStudioModal(id) {
            closeAllModals();
            const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(id));
            if (!rec) return;

            document.getElementById('dspRecId').value = id;
            document.getElementById('dspRecFilename').value = rec.filename || '';
            document.getElementById('dspDisplayTitle').textContent = rec.displayname || ('#' + id);
            document.getElementById('dspTargetNameBadge').textContent = '#' + id + ' ' + (rec.displayname || '');

            if (studioPreviewAudio) {
                studioPreviewAudio.pause();
                studioPreviewAudio = null;
            }
            const playIcon = document.getElementById('dspPlayIcon');
            if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';

            // Reset UI controls to defaults before fetching
            document.getElementById('dspNormDb').value = '-18';
            document.getElementById('dspGainDb').value = '0';
            document.getElementById('dspGainBadge').textContent = '0 dB';
            document.getElementById('dspCompand').value = 'off';
            document.getElementById('dspFadeIn').value = '0.05';
            document.getElementById('dspFadeOut').value = '0.05';
            document.getElementById('dspBandpass').checked = true;
            document.getElementById('dspHissFilter').checked = false;
            document.getElementById('dspBass').value = '0';
            document.getElementById('dspBassBadge').textContent = '0 dB';
            document.getElementById('dspTreble').value = '0';
            document.getElementById('dspTrebleBadge').textContent = '0 dB';
            document.getElementById('dspTrimSilence').checked = true;
            document.getElementById('dspTempo').value = '1.00';
            document.getElementById('dspTempoBadge').textContent = '1.00x';
            document.getElementById('dspPadLead').value = '0.2';
            document.getElementById('dspPadTrail').value = '0.2';
            document.getElementById('dspGenerateCodecs').checked = true;

            try {
                const res = await fetch(`/api/config/recordings/${id}/info`);
                if (res.ok) {
                    const data = await res.json();
                    if (data.stat) {
                        document.getElementById('dspStatDuration').textContent = data.stat.length ? data.stat.length + 's' : '-';
                        document.getElementById('dspStatPeak').textContent = data.stat.maxAmplitude ? data.stat.maxAmplitude : '-';
                        document.getElementById('dspStatRms').textContent = data.stat.rmsAmplitude ? data.stat.rmsAmplitude : '-';
                    }
                    if (data.codecs) {
                        document.getElementById('dspGsmStatus').innerHTML = data.codecs.gsm ? '<span class="text-emerald-400 font-bold">✓</span>' : '<span class="text-[var(--text-muted)]">-</span>';
                        document.getElementById('dspAlawStatus').innerHTML = data.codecs.alaw ? '<span class="text-emerald-400 font-bold">✓</span>' : '<span class="text-[var(--text-muted)]">-</span>';
                        document.getElementById('dspUlawStatus').innerHTML = data.codecs.ulaw ? '<span class="text-emerald-400 font-bold">✓</span>' : '<span class="text-[var(--text-muted)]">-</span>';
                    }
                    if (data.dspSettings && typeof data.dspSettings === 'object') {
                        const s = data.dspSettings;
                        if (s.normDb !== undefined && s.normDb !== null) document.getElementById('dspNormDb').value = String(s.normDb);
                        if (s.gainDb !== undefined && s.gainDb !== null) {
                            document.getElementById('dspGainDb').value = s.gainDb;
                            document.getElementById('dspGainBadge').textContent = (s.gainDb > 0 ? '+' : '') + s.gainDb + ' dB';
                        }
                        if (s.compand) document.getElementById('dspCompand').value = s.compand;
                        if (s.fadeIn !== undefined) document.getElementById('dspFadeIn').value = s.fadeIn;
                        if (s.fadeOut !== undefined) document.getElementById('dspFadeOut').value = s.fadeOut;
                        if (s.bandpass !== undefined) document.getElementById('dspBandpass').checked = Boolean(s.bandpass);
                        if (s.hissFilter !== undefined) document.getElementById('dspHissFilter').checked = Boolean(s.hissFilter);
                        if (s.bass !== undefined) {
                            document.getElementById('dspBass').value = s.bass;
                            document.getElementById('dspBassBadge').textContent = (s.bass > 0 ? '+' : '') + s.bass + ' dB';
                        }
                        if (s.treble !== undefined) {
                            document.getElementById('dspTreble').value = s.treble;
                            document.getElementById('dspTrebleBadge').textContent = (s.treble > 0 ? '+' : '') + s.treble + ' dB';
                        }
                        if (s.trimSilence !== undefined) document.getElementById('dspTrimSilence').checked = Boolean(s.trimSilence);
                        if (s.tempo !== undefined) {
                            document.getElementById('dspTempo').value = s.tempo;
                            document.getElementById('dspTempoBadge').textContent = parseFloat(s.tempo).toFixed(2) + 'x';
                        }
                        if (s.padLead !== undefined) document.getElementById('dspPadLead').value = s.padLead;
                        if (s.padTrail !== undefined) document.getElementById('dspPadTrail').value = s.padTrail;
                        if (s.generateCodecs !== undefined) document.getElementById('dspGenerateCodecs').checked = Boolean(s.generateCodecs);
                    }
                }
            } catch (_) {}

            openModal('recordingStudioModal');
        }


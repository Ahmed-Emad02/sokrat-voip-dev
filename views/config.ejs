                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    activeMohCategoryName = 'default';
                    fetchMohData();
                } else {
                    showToast(data.error || 'Failed to delete MoH Category', 'error');

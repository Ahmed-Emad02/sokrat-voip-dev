        function populateIvrTargetSelect(selectEl, type, currentDest) {
            if (!selectEl) return;
            selectEl.innerHTML = '<option value="">== ' + (isRtl ? 'اختر الهدف Target' : 'choose target') + ' ==</option>';
            if (type === 'extensions') {
                loadedExtensionsList.forEach(e => {
                    const opt = document.createElement('option');
                    opt.value = `from-did-direct,${e.extension},1`;
                    opt.textContent = `${e.extension} - ${e.name}`;
                    if (currentDest === opt.value || currentDest === `ext-local,${e.extension},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'ringgroups') {
                loadedRingGroupsList.forEach(rg => {
                    const opt = document.createElement('option');
                    opt.value = `ext-group,${rg.grpnum},1`;
                    opt.textContent = `Group ${rg.grpnum} - ${rg.description}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'queues') {
                loadedQueuesList.forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = `ext-queues,${q.extension},1`;
                    opt.textContent = `Queue ${q.extension} - ${q.descr}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'ivr') {
                loadedIvrsList.forEach(i => {
                    const opt = document.createElement('option');
                    opt.value = `ivr-${i.id},s,1`;
                    opt.textContent = `IVR #${i.id} - ${i.name}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'voicemail') {
                loadedExtensionsList.forEach(e => {
                    const opt = document.createElement('option');
                    opt.value = `ext-local,vmu${e.extension},1`;
                    opt.textContent = `VM: ${e.extension} - ${e.name}`;
                    if (currentDest === opt.value || currentDest === `ext-withvm,${e.extension},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'announcements') {
                loadedAnnouncementsList.forEach(a => {
                    const opt = document.createElement('option');
                    opt.value = `app-announcement-${a.announcement_id},s,1`;
                    opt.textContent = `Announcement: ${a.description}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'timeconditions') {
                loadedTimeConditionsList.forEach(tc => {
                    const opt = document.createElement('option');
                    opt.value = `timeconditions,${tc.timeconditions_id},1`;
                    opt.textContent = `Time Condition: ${tc.displayname}`;
                    if (currentDest === opt.value || currentDest === `ext-timeconditions,${tc.timeconditions_id},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'musiconhold') {
                const mohList = typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : [];
                if (mohList.length === 0) {
                    const optDef = document.createElement('option');
                    optDef.value = 'musiconhold,default,1';
                    optDef.textContent = 'Default MoH Class';
                    if (currentDest === optDef.value || currentDest === 'app-blackhole,musiconhold,1') optDef.selected = true;
                    selectEl.appendChild(optDef);
                } else {
                    mohList.forEach(cat => {
                        const opt = document.createElement('option');
                        opt.value = `musiconhold,${cat.name},1`;
                        opt.textContent = `MoH: ${cat.name} (${cat.fileCount || 0} tracks)${cat.isDefault ? ' [System]' : ''}`;
                        if (currentDest === opt.value) opt.selected = true;
                        selectEl.appendChild(opt);
                    });
                }
                const optHold = document.createElement('option');
                optHold.value = 'app-blackhole,musiconhold,1';
                optHold.textContent = isRtl ? 'وضع المتصل في الانتظار الدائم (Hold Forever)' : 'Hold Forever (Blackhole MoH)';
                if (currentDest === optHold.value) optHold.selected = true;
                selectEl.appendChild(optHold);
            } else if (type === 'terminate') {
                const opt = document.createElement('option');
                opt.value = 'app-blackhole,hangup,1';
                opt.textContent = isRtl ? 'إنهاء المكالمة (Hangup)' : 'Terminate Call (Hangup)';
                opt.selected = true;
                selectEl.appendChild(opt);
            }
        }


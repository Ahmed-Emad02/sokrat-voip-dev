        window.applyRulePreset = applyRulePreset;
        window.removeTimeGroupRuleFromModal = removeTimeGroupRuleFromModal;
        window.editTimeGroup = editTimeGroup;
        window.saveTimeGroup = saveTimeGroup;
        window.deleteTimeGroup = deleteTimeGroup;



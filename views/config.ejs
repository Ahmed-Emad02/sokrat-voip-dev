                        <input type="checkbox" id="editPeerAllowEgress" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'مشاركة خطوط GSM والصادر' : 'Allow Outbound / GSM Egress' %></span>
                    </label>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('editPeerModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'حفظ التغييرات' : 'Save Changes' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: LOCAL PBX FEDERATION SETTINGS -->
    <div id="federationSettingsModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden shadow-2xl">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إعدادات هوية هذا السيرفر' : 'Local PBX Identity & Central Panel' %></h3>
                <button type="button" onclick="closeModal('federationSettingsModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="saveFederationSettings(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-amber-400 uppercase mb-1" for="localSiteCodeInput"><%= isRtl ? 'كود هذا الموقع (Local Site Code) *' : 'Local Site Code *' %></label>
                    <input type="text" id="localSiteCodeInput" value="<%= fedLocalSite %>" required placeholder="10" maxlength="6" class="config-input w-full font-mono text-xs font-bold text-amber-400">
                    <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'كود موقع هذا السيرفر الذي تستخدمه السيرفرات الأخرى للاتصال به' : 'Numeric site code used by other servers to route calls to this PBX' %></span>
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="localNodeNameInput"><%= isRtl ? 'اسم هذا السيرفر *' : 'Local PBX Name *' %></label>
                    <input type="text" id="localNodeNameInput" value="<%= fedLocalName %>" required placeholder="Main PBX" class="config-input w-full text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="localPanelRoleSelect"><%= isRtl ? 'دور لوحة المراقبة (Operator Panel Role)' : 'Operator Panel Role' %></label>
                    <select id="localPanelRoleSelect" class="config-input w-full text-xs">
                        <option value="local" <%= fedLocalRole === 'local' ? 'selected' : '' %>><%= isRtl ? 'سيرفر محلي عادي (Local PBX)' : 'Local PBX (Default)' %></option>
                        <option value="central" <%= fedLocalRole === 'central' ? 'selected' : '' %>><%= isRtl ? 'لوحة مركزية موحدة لجميع السيرفرات (Central Live Panel Hub)' : 'Central Live Panel Hub (Aggregates All Nodes)' %></option>
                    </select>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('federationSettingsModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'حفظ الإعدادات' : 'Save Settings' %></button>
                </div>
            </form>
        </div>
    </div>
    <!-- CLIENT SCRIPT -->
    <script>
        const isRtl = <%= isRtl ? 'true' : 'false' %>;
        window.addEventListener('error', function(e) {
            console.error('[PBX Config Runtime Error]:', e.message, 'at', e.filename, 'line', e.lineno);
            try { if (typeof showToast === 'function') showToast('Error: ' + e.message, 'error'); } catch (_) {}
        });
        window.addEventListener('unhandledrejection', function(e) {
            console.error('[PBX Config Unhandled Rejection]:', e.reason);
        });
        const MAX_EMPLOYEE_PHOTO_BYTES = 50 * 1024 * 1024;
        let employeePhotoObjectUrl = null;
        let loadedTrunksList = [];
        let loadedRecordingsList = [];
        let loadedExtensionsList = [];
        let loadedRingGroupsList = [];
        let loadedQueuesList = [];
        let loadedAnnouncementsList = [];
        let loadedIvrsList = [];
        let loadedInboundRoutesList = [];
        let loadedOutboundRoutesList = [];
        let loadedTimeGroupsList = [];
        let loadedTimeConditionsList = [];
        let loadedMohCategories = [];
        let activeMohCategoryName = 'default';
        let vmExtensionsList = [];
        let modalPatternsList = [];
        let modalTrunksSequence = [];
        let editingPatternIndex = -1;

        // --- DYNAMIC NESTED PBX DESTINATION SELECTOR COMPONENT (DestinationSelect) ---
        let destinationSelectCounter = 0;
        class DestinationSelect {
            constructor(containerEl, options = {}) {
                this.container = typeof containerEl === 'string' ? document.getElementById(containerEl) : containerEl;
                this.instanceId = ++destinationSelectCounter;
                this.initialDialplan = options.initialDialplan || 'app-blackhole,hangup,1';
                this.onChangeCallback = options.onChange || null;
                this.inputName = options.inputName || null;
                this.isRtl = Boolean(options.isRtl || (typeof isRtl !== 'undefined' ? isRtl : false));

                this.selectedCategory = 'terminate';
                this.selectedTarget = 'hangup';
                this.dialplanString = this.initialDialplan;
                this.customDialplanString = '';
                this.searchTerm = '';

                this.init();
            }

            static getCategories() {
                const rtl = typeof isRtl !== 'undefined' ? isRtl : false;
                
                const localExtTargets = (typeof loadedExtensionsList !== 'undefined' ? loadedExtensionsList : []).map(e => ({
                    id: String(e.extension),
                    label: `${e.extension} - ${e.name || ''}`,
                    dialplanString: `from-did-direct,${e.extension},1`
                }));

                const remoteExtTargets = (typeof loadedRemoteExtensionsList !== 'undefined' ? loadedRemoteExtensionsList : []).map(re => {
                    const peer = (typeof loadedFederationPeersList !== 'undefined' ? loadedFederationPeersList : []).find(p => Number(p.id) === Number(re.peer_id));
                    const peerName = peer ? (peer.node_name || 'Site ' + peer.site_code) : 'Remote';
                    return {
                        id: String(re.dial_alias),
                        label: `[${peerName}] ${re.native_extension} (${re.display_name || ''}) #${re.dial_alias}`,
                        dialplanString: `sokrat-federation-out,${re.dial_alias},1`
                    };
                });

                const extTargets = [...localExtTargets, ...remoteExtTargets];

                const ringTargets = (typeof loadedRingGroupsList !== 'undefined' ? loadedRingGroupsList : []).map(rg => ({
                    id: String(rg.grpnum),
                    label: `Group ${rg.grpnum} - ${rg.description || ''}`,
                    dialplanString: `ext-group,${rg.grpnum},1`
                }));

                const queueTargets = (typeof loadedQueuesList !== 'undefined' ? loadedQueuesList : []).map(q => ({
                    id: String(q.extension),
                    label: `Queue ${q.extension} - ${q.descr || ''}`,
                    dialplanString: `ext-queues,${q.extension},1`
                }));

                const ivrTargets = (typeof loadedIvrsList !== 'undefined' ? loadedIvrsList : []).map(i => ({
                    id: String(i.id),
                    label: `IVR #${i.id} - ${i.name || ''}`,
                    dialplanString: `ivr-${i.id},s,1`
                }));

                const annTargets = (typeof loadedAnnouncementsList !== 'undefined' ? loadedAnnouncementsList : []).map(a => ({
                    id: String(a.announcement_id),
                    label: `Announcement: ${a.description || ''} (ID: ${a.announcement_id})`,
                    dialplanString: `app-announcement-${a.announcement_id},s,1`
                }));

                const vmTargets = (typeof loadedExtensionsList !== 'undefined' ? loadedExtensionsList : []).map(e => ({
                    id: `vmu${e.extension}`,
                    label: `VM: ${e.extension} - ${e.name || ''}`,
                    dialplanString: `ext-local,vmu${e.extension},1`
                }));

                const tcTargets = (typeof loadedTimeConditionsList !== 'undefined' ? loadedTimeConditionsList : []).map(tc => ({
                    id: String(tc.timeconditions_id),
                    label: `Time Condition: ${tc.displayname || ''}`,
                    dialplanString: `timeconditions,${tc.timeconditions_id},1`
                }));

                const mohTargets = (typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : []).map(cat => ({
                    id: String(cat.name),
                    label: `MoH Class: ${cat.name} (${cat.fileCount || 0} tracks)${cat.isDefault ? ' [System]' : ''}`,
                    dialplanString: `ext-moh,${cat.name},1`
                }));

                const trunkTargets = (typeof loadedTrunksList !== 'undefined' ? loadedTrunksList : []).map(t => ({
                    id: String(t.trunkid),
                    label: `Trunk: ${t.name || ''} (${t.tech || ''})`,
                    dialplanString: `ext-trunk,${t.trunkid},1`
                }));
                const federationTargets = (typeof loadedFederationPeersList !== 'undefined' ? loadedFederationPeersList : []).flatMap(peer => {
                    const peerExts = (typeof loadedRemoteExtensionsList !== 'undefined' ? loadedRemoteExtensionsList : []).filter(re => Number(re.peer_id) === Number(peer.id));
                    if (peerExts.length > 0) {
                        return peerExts.map(re => ({
                            id: `fed_${re.dial_alias}`,
                            label: `[${peer.node_name || 'Site ' + peer.site_code}] ${re.display_name} (${re.dial_alias})`,
                            dialplanString: `sokrat-federation-out,${re.dial_alias},1`
                        }));
                    }
                    return [{
                        id: `fed_peer_${peer.site_code}`,
                        label: `[${peer.node_name || 'Site ' + peer.site_code}] Direct Site Egress (9${peer.site_code})`,
                        dialplanString: `sokrat-federation-out,9${peer.site_code},1`
                    }];
                });

                return [
                    {
                        id: 'federation',
                        label: rtl ? 'السيرفرات المرتبطة (Federated PBXs)' : 'Federated PBXs',
                        targets: federationTargets
                    },
                    {
                        id: 'terminate',
                        label: rtl ? 'إنهاء المكالمة (Terminate Call)' : 'Terminate Call',
                        targets: [
                            { id: 'hangup', label: rtl ? 'قطع الخط (Hangup)' : 'Hangup', dialplanString: 'app-blackhole,hangup,1' },
                            { id: 'congestion', label: rtl ? 'نغمة ازدحام (Congestion)' : 'Congestion', dialplanString: 'app-blackhole,congestion,1' },
                            { id: 'busy', label: rtl ? 'نغمة مشغول (Busy)' : 'Busy', dialplanString: 'app-blackhole,busy,1' },
                            { id: 'zapateller', label: rtl ? 'تشغيل نغمة SIT (Zapateller)' : 'Play SIT Tone (Zapateller)', dialplanString: 'app-blackhole,zapateller,1' },
                            { id: 'musiconhold', label: rtl ? 'وضع المتصل في الانتظار الدائم' : 'Put caller on hold forever', dialplanString: 'app-blackhole,musiconhold,1' },
                            { id: 'ringback', label: rtl ? 'تشغيل نغمة رنين حتى قطع الخط' : 'Play ringtones to caller until they hangup', dialplanString: 'app-blackhole,ringing,1' }
                        ]
                    },
                    {
                        id: 'extensions',
                        label: rtl ? 'الهواتف الفرعية (Extensions)' : 'Extensions',
                        targets: extTargets
                    },
                    {
                        id: 'ringgroups',
                        label: rtl ? 'مجموعات الرنين (Ring Groups)' : 'Ring Groups',
                        targets: ringTargets
                    },
                    {
                        id: 'queues',
                        label: rtl ? 'طوابير الانتظار (Queues)' : 'Queues',
                        targets: queueTargets
                    },
                    {
                        id: 'ivr',
                        label: rtl ? 'قائمة الرد الآلي (IVR Menu)' : 'IVR Menu',
                        targets: ivrTargets
                    },
                    {
                        id: 'announcements',
                        label: rtl ? 'الإعلانات الصوتية (Announcements)' : 'Announcements',
                        targets: annTargets
                    },
                    {
                        id: 'voicemail',
                        label: rtl ? 'البريد الصوتي (Voicemail)' : 'Voicemail',
                        targets: vmTargets
                    },
                    {
                        id: 'timeconditions',
                        label: rtl ? 'شروط الوقت (Time Conditions)' : 'Time Conditions',
                        targets: tcTargets
                    },
                    {
                        id: 'musiconhold',
                        label: rtl ? 'الموسيقى أثناء الانتظار (Music on Hold - MoH)' : 'Music on Hold (MoH)',
                        targets: mohTargets.length ? mohTargets : [
                            { id: 'default', label: 'Default MoH Class', dialplanString: 'ext-moh,default,1' },
                            { id: 'none', label: 'None (Silence)', dialplanString: 'app-blackhole,musiconhold,1' }
                        ]
                    },
                    {
                        id: 'trunks',
                        label: rtl ? 'خطوط الربط (Trunks)' : 'Trunks',
                        targets: trunkTargets
                    },
                    {
                        id: 'external',
                        label: rtl ? 'رقم خارجي / جوال (External Number / Mobile)' : 'External Number / Mobile',
                        targets: []
                    },
                    {
                        id: 'custom',
                        label: rtl ? 'تطبيق مخصص (Custom App)' : 'Custom App',
                        targets: []
                    }
                ];
            }

            static parseDialplanString(destStr) {
                const dest = String(destStr || '').trim();
                if (!dest || dest === 'app-blackhole,hangup,1') return { category: 'terminate', target: 'hangup', dialplan: 'app-blackhole,hangup,1' };
                if (dest === 'app-blackhole,congestion,1') return { category: 'terminate', target: 'congestion', dialplan: 'app-blackhole,congestion,1' };
                if (dest === 'app-blackhole,busy,1') return { category: 'terminate', target: 'busy', dialplan: 'app-blackhole,busy,1' };
                if (dest === 'app-blackhole,zapateller,1') return { category: 'terminate', target: 'zapateller', dialplan: 'app-blackhole,zapateller,1' };
                if (dest === 'app-blackhole,musiconhold,1') return { category: 'terminate', target: 'musiconhold', dialplan: 'app-blackhole,musiconhold,1' };
                if (dest === 'app-blackhole,ringing,1') return { category: 'terminate', target: 'ringback', dialplan: 'app-blackhole,ringing,1' };
                if (dest.startsWith('musiconhold,') || dest.startsWith('ext-moh,')) {
                    const catName = dest.split(',')[1] || 'default';
                    return { category: 'musiconhold', target: catName, dialplan: dest };
                }
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                    const ext = dest.split(',')[1];
                    if (ext && ext.startsWith('vmu')) {
                        return { category: 'voicemail', target: ext, dialplan: dest };
                    }
                    return { category: 'extensions', target: ext, dialplan: dest };
                }
                if (dest.startsWith('ext-group,')) return { category: 'ringgroups', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('ext-queues,')) return { category: 'queues', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('ivr-')) return { category: 'ivr', target: dest.split(',')[0].replace('ivr-', ''), dialplan: dest };
                if (dest.startsWith('app-announcement-')) return { category: 'announcements', target: dest.split(',')[0].replace('app-announcement-', ''), dialplan: dest };
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) return { category: 'timeconditions', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('ext-trunk,')) return { category: 'trunks', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('sokrat-federation-out,')) {
                    const target = dest.split(',')[1] || '';
                    return { category: 'federation', target: `fed_${target}`, dialplan: dest };
                }
                if (dest.startsWith('ext-external-failover,') || (dest.startsWith('from-internal,') && !dest.startsWith('from-internal-xfer,'))) {
                    const rawTarget = dest.split(',')[1] || '';
                    const num = rawTarget.split('/')[0].split('@')[0];
                    const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                    if (num && /^[0-9+*#]{3,25}$/.test(num) && !/^[1-9][0-9]{1,3}$/.test(num)) {
                        return { category: 'external', target: num, dongle, dialplan: dest };
                    }
                }

                return { category: 'custom', target: 'custom', dialplan: dest };
            }

            init() {
                const parsed = DestinationSelect.parseDialplanString(this.initialDialplan);
                this.selectedCategory = parsed.category;
                this.selectedTarget = parsed.target;
                this.selectedDongle = parsed.dongle || '';
                this.dialplanString = parsed.dialplan;
                if (this.selectedCategory === 'custom') {
                    this.customDialplanString = parsed.dialplan;
                }

                this.render();
            }

            setDialplan(destStr) {
                this.initialDialplan = destStr;
                const parsed = DestinationSelect.parseDialplanString(destStr);
                this.selectedCategory = parsed.category;
                this.selectedTarget = parsed.target;
                this.selectedDongle = parsed.dongle || '';
                this.dialplanString = parsed.dialplan;
                if (this.selectedCategory === 'custom') {
                    this.customDialplanString = parsed.dialplan;
                } else {
                    this.customDialplanString = '';
                }
                this.searchTerm = '';
                this.render();
            }

            emitChange() {
                const payload = {
                    category: this.selectedCategory,
                    target: this.selectedTarget,
                    dialplan: this.dialplanString
                };
                if (typeof this.onChangeCallback === 'function') {
                    this.onChangeCallback(payload);
                }
            }

            render() {

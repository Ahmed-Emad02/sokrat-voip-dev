        window.openTimeConditionModal = openTimeConditionModal;
        window.editTimeCondition = editTimeCondition;
        window.saveTimeCondition = saveTimeCondition;
        window.deleteTimeCondition = deleteTimeCondition;


        // --- MUSIC ON HOLD (MOH) CLIENT MODULE ---

        function fetchMohData() {
            return fetch('/api/config/moh')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !Array.isArray(data.categories)) return;
                    loadedMohCategories = data.categories;
                    populateMohCategorySelect();
                    renderMohFilesTable();
                    if (typeof populateMohRingGroupDropdown === 'function') populateMohRingGroupDropdown();
                })
                .catch(err => {
                    showToast('Failed to load Music on Hold data: ' + err.message, 'error');
                });
        }
        window.fetchMohData = fetchMohData;

        function populateMohCategorySelect() {
            const sel = document.getElementById('mohCategorySelect');
            if (!sel) return;
            sel.innerHTML = '';
            (loadedMohCategories || []).forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.name;
                opt.textContent = `${cat.name} (${cat.fileCount} tracks)${cat.isDefault ? ' [System]' : ''}`;
                if (cat.name === activeMohCategoryName) opt.selected = true;
                sel.appendChild(opt);
            });
            if (!(loadedMohCategories || []).some(c => c.name === activeMohCategoryName) && loadedMohCategories.length > 0) {
                activeMohCategoryName = loadedMohCategories[0].name;
                sel.value = activeMohCategoryName;
            }
            updateMohCategoryInfo();
        }

        function updateMohCategoryInfo() {
            const cat = (loadedMohCategories || []).find(c => c.name === activeMohCategoryName);
            const pathEl = document.getElementById('mohPathDisplay');
            const sortEl = document.getElementById('mohSortDisplay');
            const delContainer = document.getElementById('mohCategoryDeleteContainer');
            if (cat) {
                if (pathEl) pathEl.textContent = cat.directory || `/var/lib/asterisk/moh/${cat.name}/`;
                if (sortEl) sortEl.textContent = cat.sort || 'alpha';
                if (delContainer) {
                    if (!cat.isDefault && cat.name !== 'default' && cat.name !== 'none') {
                        delContainer.innerHTML = `<button type="button" onclick="deleteMohCategory('${escapeHtml(cat.name)}')" class="px-2 py-0.5 text-[11px] font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 transition cursor-pointer flex items-center gap-1"><span>${isRtl ? 'حذف هذه الفئة' : 'Delete Category'}</span></button>`;
                    } else {
                        delContainer.innerHTML = '';
                    }
                }
            }
        }

        function onMohCategoryChange() {
            const sel = document.getElementById('mohCategorySelect');
            if (sel) {
                activeMohCategoryName = sel.value;
                updateMohCategoryInfo();
                renderMohFilesTable();
            }
        }
        window.onMohCategoryChange = onMohCategoryChange;

        function renderMohFilesTable() {
            const tbody = document.getElementById('moh-files-table-body');
            if (!tbody) return;
            const cat = (loadedMohCategories || []).find(c => c.name === activeMohCategoryName);
            tbody.innerHTML = '';

            if (!cat || !cat.files || cat.files.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-[var(--text-muted)] italic">' + (isRtl ? 'لا توجد مقاطع صوتية في هذه الفئة حالياً' : 'No audio tracks in this MoH category yet.') + '</td></tr>';
                return;
            }

            cat.files.forEach(f => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-[var(--bg-hover)] transition-colors border-b border-[var(--border-primary)]/40 text-xs';
                tr.innerHTML = `
                    <td class="py-3 px-4 font-mono font-bold text-white">${escapeHtml(f.filename)}</td>
                    <td class="py-3 px-4"><span class="px-2 py-0.5 text-[10px] font-bold rounded bg-amber-500/10 text-amber-400 border border-amber-500/20">${f.format}</span></td>
                    <td class="py-3 px-4 font-mono text-[var(--text-secondary)]">${f.sizeFormatted}</td>
                    <td class="py-3 px-4">
                        <audio controls preload="none" class="h-8 max-w-xs rounded border border-[var(--border-primary)] bg-[var(--bg-card)]">
                            <source src="${f.streamUrl}" type="audio/wav">
                            Your browser does not support audio preview.
                        </audio>
                    </td>
                    <td class="py-3 px-4 text-center">
                        <button type="button" onclick="deleteMohFile('${escapeHtml(cat.name)}', '${escapeHtml(f.filename)}')" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

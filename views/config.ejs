                        <h2 class="text-lg font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                            <svg class="w-5 h-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                            <span><%= isRtl ? 'رفع تسجيل صوتي جديد' : 'Upload System Recording' %></span>
                        </h2>
                        <p class="text-xs text-[var(--text-muted)] mt-1"><%= isRtl ? 'صيغ الملفات المقبولة: MP3, WAV, M4A, OGG, FLAC (سيتم تحويلها تلقائيًا إلى 8kHz WAV)' : 'Accepted formats: MP3, WAV, M4A, OGG, FLAC (auto-converted to 8kHz WAV)' %></p>
                    </div>
                </div>
                <form id="systemRecordingUploadForm" onsubmit="uploadSystemRecording(event)" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-start">
                        <div>
                            <label for="sysRecName" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اسم التسجيل (Display Name) *' : 'Recording Name *' %></label>
                            <input type="text" id="sysRecName" required placeholder="e.g. Welcome Announcement" class="config-input w-full text-xs">
                        </div>
                        <div>
                            <label for="sysRecFile" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'ملف الصوت *' : 'Audio File *' %></label>
                            <input type="file" id="sysRecFile" accept="audio/*,.mpeg,.mpg" required class="w-full text-xs text-[var(--text-secondary)] file:mr-3 rtl:file:mr-0 rtl:file:ml-3 file:py-2 file:px-3 file:rounded-lg file:border file:border-[var(--border-primary)] file:bg-[var(--bg-card)] file:text-xs file:font-bold file:text-[var(--text-primary)] hover:file:bg-[var(--bg-hover)] file:cursor-pointer transition cursor-pointer">
                        </div>
                        <div>
                            <label for="sysRecGain" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'مستوى الصوت الأولي / الهامش' : 'Initial Volume / Headroom' %></label>
                            <select id="sysRecGain" class="config-input w-full text-xs">
                                <option value="6">+6 dB</option>
                                <option value="0"><%= isRtl ? '0 dB (المستوى القياسي الأصلي)' : '0 dB (Standard / Original)' %></option>
                                <option value="-6">-6 dB</option>
                                <option value="-12">-12 dB</option>
                                <option value="-18" selected><%= isRtl ? '-18 dB (موصى به لبوابات GSM والدونجل)' : '-18 dB (Recommended for GSM Dongles)' %></option>
                                <option value="-24">-24 dB</option>
                                <option value="-30">-30 dB</option>
                                <option value="-36">-36 dB</option>
                                <option value="-42">-42 dB</option>
                            </select>
                            <span class="text-[10px] text-[var(--text-muted)] mt-1 block">
                                <%= isRtl ? 'يمنع تشويش وتكسير الصوت عند تشغيل التسجيل في IVR عبر الدونجل.' : 'Prevents voice distortion when played through GSM dongles with high volume gain.' %>
                            </span>
                        </div>
                    </div>
                    <!-- Upload Progress Bar -->
                    <div id="sysRecProgressWrap" class="hidden space-y-1">
                        <div class="flex justify-between text-[11px] font-semibold text-[var(--text-muted)]">
                            <span id="sysRecStatus">Uploading & converting...</span>
                            <span id="sysRecPercent">0%</span>
                        </div>
                        <div class="w-full h-1.5 bg-[var(--bg-card)] rounded-full overflow-hidden">
                            <div id="sysRecProgressBar" class="h-full bg-[var(--accent-color)] rounded-full transition-all duration-300" style="width:0%"></div>
                        </div>
                    </div>
                    <div class="flex justify-end pt-1">
                        <button type="submit" id="sysRecSubmitBtn" class="config-btn-primary px-6 py-2.5 text-xs flex items-center justify-center gap-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                            <span><%= isRtl ? 'رفع وحفظ التسجيل' : 'Upload Recording' %></span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- 2. Existing Recordings List Table Card (Full Width) -->
            <div class="config-card p-6">
                <div class="mb-5 pb-3 border-b border-[var(--border-primary)] flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'التسجيلات الصوتية المسجلة في المقسم' : 'System Recordings List' %></h2>
                        <p class="text-xs text-[var(--text-muted)] mt-1"><%= isRtl ? 'إدارة التسجيلات الصوتية، مستويات الهامش لكل ملف، والاستوديو المتقدم لمعالجة الصوت' : 'Manage audio prompts, per-file headroom gain, and advanced DSP studio processing' %></p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-[var(--bg-card)] border-b border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                                <th class="py-3 px-4 w-16">ID</th>
                                <th class="py-3 px-4 min-w-[200px]"><%= isRtl ? 'اسم التسجيل' : 'Recording Name' %></th>
                                <th class="py-3 px-4 min-w-[200px]"><%= isRtl ? 'مسار الملف' : 'System Filename' %></th>
                                <th class="py-3 px-4 text-center min-w-[280px]"><%= isRtl ? 'مستوى الصوت / الهامش' : 'Volume / Headroom' %></th>
                                <th class="py-3 px-4 text-center min-w-[220px]"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="recordings-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">
                            <tr><td colspan="5" class="py-8 text-center text-[var(--text-muted)]">Loading recordings...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
        <% } %>

        <!-- TAB 4: TRUNKS MANAGEMENT -->
        <% if (isTabAllowed('trunks')) { %>
        <div id="section-trunks" class="tab-section hidden">
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'خطوط الربط (Trunks)' : 'Trunks' %></h2>
                    </div>
                    <button type="button" onclick="openTrunkModal()" class="config-btn-primary px-4 py-2 flex items-center gap-2 text-xs cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                        <span><%= isRtl ? 'إضافة خط ربط جديد' : 'Add Trunk' %></span>
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-[var(--bg-card)] border-b border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                                <th class="py-3 px-4">ID</th>
                                <th class="py-3 px-4"><%= isRtl ? 'اسم الخط' : 'Trunk Name' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'التقنية' : 'Tech' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'عنوان الخادم / سلسلة الطلب' : 'Host / Dial String' %></th>
                                <th class="py-3 px-4 text-center"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="trunks-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">
                            <tr><td colspan="5" class="py-8 text-center text-[var(--text-muted)]">Loading trunks...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <% } %>

        <!-- TAB 5: INBOUND ROUTES -->
        <% if (isTabAllowed('inbound')) { %>
        <div id="section-inbound" class="tab-section hidden space-y-6">
            <!-- 1. INBOUND ROUTES MANAGEMENT CARD -->
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'المسارات الواردة (Inbound Routes)' : 'Inbound Routes' %></h2>
                    </div>
                    <button type="button" id="openInboundRouteBtn" onclick="openInboundModal()" class="config-btn-primary px-4 py-2 flex items-center gap-2 text-xs cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                        <span><%= isRtl ? 'إضافة مسار وارد' : 'Add Inbound Route' %></span>
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-[var(--bg-card)] border-b border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                                <th class="py-3 px-4"><%= isRtl ? 'الوصف' : 'Description' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'رقم DID' : 'DID Number' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الوجهة' : 'Destination' %></th>
                                <th class="py-3 px-4 text-center"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="inbound-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">
                            <tr><td colspan="4" class="py-8 text-center text-[var(--text-muted)]">Loading inbound routes...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. GSM DYNAMIC DID MAPPINGS PANEL -->
            <div class="config-card overflow-hidden">
                <div class="p-5 sm:p-6 border-b border-[var(--border-primary)]">
                    <div class="flex flex-col xl:flex-row xl:items-start justify-between gap-5">
                        <div class="flex items-start gap-3 min-w-0">
                            <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                                </svg>
                            </div>
                            <div class="min-w-0">
                                <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'خريطة الشرائح التلقائية (GSM Dynamic DIDs)' : 'GSM Dynamic DID Mappings' %></h2>
                                <p class="text-xs text-[var(--text-muted)] mt-1 max-w-3xl leading-relaxed">
                                    <%= isRtl ? 'إدارة أرقام DIDs الديناميكية للشرائح غير المسجلة بمسارات واردة صريحة. الأرقام المسجلة تستمر بالتوجيه الطبيعي عبر Asterisk.' : 'Manage dynamic DIDs for GSM SIMs without explicit inbound routes. Registered DIDs continue through normal Asterisk routing.' %>
                                </p>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 xl:justify-end">
                            <button type="button" onclick="fetchDongleMappingsTab()" class="config-action-btn">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                <span><%= isRtl ? 'تحديث' : 'Refresh' %></span>
                            </button>
                            <button type="button" onclick="reconcileDonglesNow()" class="config-action-btn config-action-btn--primary">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                                <span><%= isRtl ? 'إعادة مطابقة AstDB' : 'Re-Sync AstDB' %></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="p-4 sm:p-5 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/25">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-xl border border-[var(--border-primary)] bg-[var(--border-primary)]">
                        <div class="config-metric-tile">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider block"><%= isRtl ? 'فتحات GSM' : 'Dongle Slots' %></span>
                            <div id="dmCardTotal" class="text-2xl font-extrabold font-mono text-[var(--text-primary)] mt-1">-</div>
                        </div>
                        <div class="config-metric-tile">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider block"><%= isRtl ? 'الأجهزة المتصلة' : 'Connected' %></span>
                            <div id="dmCardConnected" class="text-2xl font-extrabold font-mono text-emerald-400 mt-1">-</div>
                        </div>
                        <div class="config-metric-tile">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider block"><%= isRtl ? 'مفاتيح AstDB' : 'AstDB Synced' %></span>
                            <div id="dmCardSynced" class="text-2xl font-extrabold font-mono text-cyan-400 mt-1">-</div>
                        </div>
                        <div class="config-metric-tile">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider block"><%= isRtl ? 'المسارات المرتبطة' : 'Routes Linked' %></span>
                            <div id="dmCardRoutes" class="text-2xl font-extrabold font-mono text-purple-400 mt-1">-</div>
                        </div>
                    </div>
                </div>

                <div class="p-5 sm:p-6">
                    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-4">
                        <div>
                            <h3 class="text-sm font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'سجل مطابقة DIDs والشرائح' : 'Dynamic DID Mapping Roster' %></h3>
                            <p class="text-[11px] text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'حالة الجهاز والهوية ومسار التوجيه في عرض واحد.' : 'Device identity, SIM assignment, and routing health in one view.' %></p>
                        </div>
                        <span id="dmRosterCount" class="self-start sm:self-auto px-2.5 py-1 text-[10px] font-mono font-bold rounded-lg bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-primary)]">0 <%= isRtl ? 'أجهزة' : 'devices' %></span>
                    </div>
                    <div class="overflow-x-auto rounded-xl border border-[var(--border-primary)]">
                        <table class="w-full min-w-[780px] text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-[var(--bg-card)] border-b border-[var(--border-primary)] text-[var(--text-muted)] uppercase tracking-wider font-bold">
                                    <th class="p-3.5 w-[18%]"><%= isRtl ? 'الجهاز' : 'Device' %></th>
                                    <th class="p-3.5 w-[22%]"><%= isRtl ? 'رقم DID والشريحة' : 'DID & SIM' %></th>
                                    <th class="p-3.5 w-[20%]"><%= isRtl ? 'معرفات العتاد' : 'Hardware' %></th>
                                    <th class="p-3.5 w-[26%]"><%= isRtl ? 'حالة التوجيه' : 'Routing' %></th>
                                    <th class="p-3.5 text-right w-[14%]"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                                </tr>
                            </thead>
                            <tbody id="dmTableBody" class="divide-y divide-[var(--border-primary)]">
                                <tr>
                                    <td colspan="5" class="p-6 text-center text-[var(--text-muted)] italic">Loading GSM dynamic mappings...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- TAB 6: OUTBOUND ROUTES -->
        <% if (isTabAllowed('outbound')) { %>
        <div id="section-outbound" class="tab-section hidden">
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'المسارات الصادرة (Outbound Routes)' : 'Outbound Routes' %></h2>
                        <p class="text-xs text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'يتم تقييم المسارات من الأعلى إلى الأسفل. يمكنك سحب وإفلات الصفوف لتغيير أولوية المسار.' : 'Routes are evaluated top-to-bottom. Drag and drop rows or use arrows to reorder priority.' %></p>
                    </div>
                    <button type="button" onclick="openOutboundModal()" class="config-btn-primary px-4 py-2 flex items-center gap-2 text-xs cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                        <span><%= isRtl ? 'إضافة مسار صادر' : 'Add Outbound Route' %></span>
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-[var(--bg-card)] border-b border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider select-none">
                                <th class="py-3 px-3 text-center w-20"><%= isRtl ? 'الأولوية' : 'Priority' %></th>
                                <th class="py-3 px-4">ID</th>
                                <th class="py-3 px-4"><%= isRtl ? 'اسم المسار' : 'Route Name' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'أنماط الاتصال' : 'Dial Patterns' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'تسلسل خطوط الربط' : 'Trunk Sequence' %></th>
                                <th class="py-3 px-4 text-center"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="outbound-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">
                            <tr><td colspan="6" class="py-8 text-center text-[var(--text-muted)]">Loading outbound routes...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <% } %>

        <!-- TAB 7: VOICEMAIL GREETINGS -->
        <% if (isTabAllowed('voicemail')) { %>
        <div id="section-voicemail" class="tab-section hidden">
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'رسائل البريد الصوتي (Voicemail Greetings)' : 'Voicemail Greetings' %></h2>
                    </div>
                </div>

                <form onsubmit="saveVoicemailGreeting(event)" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Left card: Select Greeting -->
                        <div class="border border-[var(--border-primary)] rounded-xl p-5 bg-[var(--bg-card)]/20 space-y-4">
                            <h3 class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider"><%= isRtl ? '١. اختر تسجيل الترحيب' : '1. Choose Greeting Recording' %></h3>
                            <div>
                                <label class="block text-xs font-semibold text-[var(--text-secondary)] mb-1" for="vmGreetingSelect"><%= isRtl ? 'تسجيل النظام *' : 'System Recording *' %></label>
                                <select id="vmGreetingSelect" class="config-input w-full" required>
                                    <option value=""><%= isRtl ? '-- اختر التسجيل --' : '-- Choose Recording --' %></option>
                                </select>
                            </div>
                        </div>

                        <!-- Right card: Apply to Mailboxes -->
                        <div class="border border-[var(--border-primary)] rounded-xl p-5 bg-[var(--bg-card)]/20 space-y-4">
                            <h3 class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider"><%= isRtl ? '٢. حدد صناديق البريد الصوتي' : '2. Select Mailboxes' %></h3>
                            
                            <div class="flex items-center gap-4">
                                <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-[var(--text-secondary)]" for="vmAllMailboxes">
                                    <input type="checkbox" id="vmAllMailboxes" onchange="toggleVmAllMailboxes()" class="tab-checkbox">
                                    <span><%= isRtl ? 'تحديد الكل (المفعل بها البريد الصوتي)' : 'Select All (voicemail-enabled)' %></span>
                                </label>
                            </div>

                            <div class="border border-[var(--border-primary)] rounded-lg p-3 bg-[var(--bg-secondary)] max-h-48 overflow-y-auto space-y-2" id="vmMailboxChecklist">
                                <!-- Prepopulated checklist of voicemail enabled extensions -->
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                        <button type="button" onclick="resetVoicemailGreetings()" class="px-4 py-2 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 transition cursor-pointer">
                            <%= isRtl ? 'إعادة ضبط للافتراضي' : 'Reset to Default' %>
                        </button>
                        <button type="submit" class="config-btn-primary px-5 py-2.5 text-xs flex items-center gap-2">
                            <span><%= isRtl ? 'حفظ ترحيب البريد الصوتي' : 'Save Voicemail Greeting' %></span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <% } %>
        
        <!-- TAB 8: CONFIG DIAGRAM -->
        <% if (isTabAllowed('diagram')) { %>
        <div id="section-diagram" class="tab-section hidden">
            <style>
                /* Light theme override styling for Config Diagram */
                .light-theme #diagramCanvasContainer {
                    background-color: #f8fafc !important;
                    border-color: #cbd5e1 !important;
                }
                .light-theme #grid-pattern circle {
                    fill: #64748b !important;
                    fill-opacity: 0.45 !important;
                }

                /* Cards styling in Light Theme — solid surface, stronger separation */
                .light-theme .diagram-card {
                    background-color: #ffffff !important;
                    border-color: #94a3b8 !important;
                    border-width: 1.5px !important;
                    box-shadow: 0 3px 12px rgba(15, 23, 42, 0.12) !important;
                }
                .light-theme .diagram-card:hover {
                    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.20) !important;
                }
                /* Per-type accent borders so node categories stay readable */
                .light-theme .diagram-card[data-node-type="inbound"]       { border-color: #059669 !important; }
                .light-theme .diagram-card[data-node-type="timecondition"] { border-color: #ca8a04 !important; }
                .light-theme .diagram-card[data-node-type="ivr"]           { border-color: #2563eb !important; }
                .light-theme .diagram-card[data-node-type="ringgroup"]     { border-color: #9333ea !important; }
                .light-theme .diagram-card[data-node-type="queue"]         { border-color: #d97706 !important; }
                .light-theme .diagram-card[data-node-type="extension"]     { border-color: #dc2626 !important; }
                .light-theme .diagram-card[data-node-type="outbound"]      { border-color: #ea580c !important; }
                .light-theme .diagram-card[data-node-type="trunk"]         { border-color: #0891b2 !important; }

                /* Text colors overrides inside card — white for high contrast on filled color cards */
                .light-theme .diagram-card span.text-white,
                .light-theme .diagram-card .text-white {
                    color: #ffffff !important;
                    font-weight: 800 !important;
                }
                .light-theme .diagram-card .text-gray-400,
                .light-theme .diagram-card .text-gray-300,
                .light-theme .diagram-card div.text-\[10px\] {
                    color: #f1f5f9 !important;
                    font-weight: 600 !important;
                }

                /* Details box overrides in Light Theme */
                .light-theme .diagram-card div.font-mono {
                    color: #ffffff !important;
                }
                .light-theme .diagram-card div.font-mono span {
                    color: #f1f5f9 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-white {
                    color: #ffffff !important;
                    font-weight: 700 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-emerald-400 {
                    color: #6ee7b7 !important;
                    font-weight: 700 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-purple-400 {
                    color: #d8b4fe !important;
                    font-weight: 700 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-red-400 {
                    color: #b91c1c !important;
                    font-weight: 700 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-cyan-400 {
                    color: #0e7490 !important;
                    font-weight: 700 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-orange-400 {
                    color: #c2410c !important;
                    font-weight: 700 !important;
                }
                .light-theme .diagram-card div.font-mono span.text-yellow-400 {
                    color: #854d0e !important;
                    font-weight: 700 !important;
                }

                /* Port circle style */
                .light-theme .diagram-card .absolute.rounded-full {
                    border-color: #ffffff !important;
                    background-color: #475569 !important;
                }

                /* Wires read better on a light canvas */
                .light-theme .diagram-wire {
                    opacity: 0.8 !important;
                }
                .light-theme .diagram-wire[data-type="ext-route-global"] {
                    stroke: #475569 !important;
                    opacity: 0.38 !important;
                }

                /* While dragging a card, wires must track it instantly —
                   otherwise the transitioned path (and its arrowhead) lags
                   behind and appears split from the line */
                #diagramSvg.wires-live .diagram-wire {
                    transition: none !important;
                }

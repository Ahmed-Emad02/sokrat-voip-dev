        function updateRulePreviewChip(elem) {
            const card = elem.closest ? elem.closest('.rule-card') : elem;
            if (!card) return;

            const startTime = card.querySelector('.rule-start-time').value;
            const finishTime = card.querySelector('.rule-finish-time').value;
            
            const activeButtons = Array.from(card.querySelectorAll('.day-toggle-btn.bg-blue-600'));
            const activeDays = activeButtons.map(b => b.getAttribute('data-day'));

            const startMthday = card.querySelector('.rule-start-monthday').value;
            const finishMthday = card.querySelector('.rule-finish-monthday').value;
            const startMth = card.querySelector('.rule-start-month').value;
            const finishMth = card.querySelector('.rule-finish-month').value;

            let timeText = isRtl ? 'طوال اليوم' : 'All Day';
            if (startTime && finishTime) timeText = `${startTime}-${finishTime}`;
            else if (startTime) timeText = startTime;

            let wkText = isRtl ? 'كل الأيام' : 'All Weekdays';
            if (activeDays.length > 0 && activeDays.length < 7) {
                wkText = activeDays.map(d => d.toUpperCase()).join(',');
            }

            let mthdayText = '*';
            if (startMthday !== '*' && finishMthday !== '*') {
                mthdayText = startMthday === finishMthday ? startMthday : `${startMthday}-${finishMthday}`;
            } else if (startMthday !== '*') mthdayText = startMthday;

            let mthText = '*';
            if (startMth !== '*' && finishMth !== '*') {
                mthText = startMth === finishMth ? startMth : `${startMth}-${finishMth}`;
            } else if (startMth !== '*') mthText = startMth;

            const chip = card.querySelector('.rule-chip-preview');
            if (chip) {
                chip.textContent = `${timeText} | ${wkText} | ${mthdayText} | ${mthText}`;
            }
        }

        function applyRulePreset(btn, preset) {
            const card = btn.closest('.rule-card');
            if (!card) return;

            const dayBtns = card.querySelectorAll('.day-toggle-btn');
            
            function setDaysActive(targetDays) {
                dayBtns.forEach(b => {
                    const day = b.getAttribute('data-day');
                    const isActive = targetDays.includes(day);
                    if (isActive) {
                        b.className = 'day-toggle-btn px-3 py-1.5 text-xs rounded-lg border border-[var(--border-primary)] bg-blue-600 text-white font-black hover:text-white cursor-pointer transition-all';
                    } else {
                        b.className = 'day-toggle-btn px-3 py-1.5 text-xs rounded-lg border border-[var(--border-primary)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] font-bold hover:text-white cursor-pointer transition-all';
                    }
                });
            }

            if (preset === 'satthu_work') {
                card.querySelector('.rule-start-time').value = '09:00';
                card.querySelector('.rule-finish-time').value = '17:00';
                setDaysActive(['sat', 'sun', 'mon', 'tue', 'wed', 'thu']);
                card.querySelector('.rule-start-monthday').value = '*';
                card.querySelector('.rule-finish-monthday').value = '*';
                card.querySelector('.rule-start-month').value = '*';
                card.querySelector('.rule-finish-month').value = '*';
            } else if (preset === 'monfri_work') {
                card.querySelector('.rule-start-time').value = '09:00';
                card.querySelector('.rule-finish-time').value = '17:00';
                setDaysActive(['mon', 'tue', 'wed', 'thu', 'fri']);
                card.querySelector('.rule-start-monthday').value = '*';
                card.querySelector('.rule-finish-monthday').value = '*';
                card.querySelector('.rule-start-month').value = '*';
                card.querySelector('.rule-finish-month').value = '*';
            } else if (preset === 'allday') {
                card.querySelector('.rule-start-time').value = '';
                card.querySelector('.rule-finish-time').value = '';
                setDaysActive(['sat', 'sun', 'mon', 'tue', 'wed', 'thu', 'fri']);
                card.querySelector('.rule-start-monthday').value = '*';
                card.querySelector('.rule-finish-monthday').value = '*';
                card.querySelector('.rule-start-month').value = '*';
                card.querySelector('.rule-finish-month').value = '*';
            }

            updateRulePreviewChip(card);
        }

        function removeTimeGroupRuleFromModal(btn) {
            const card = btn.closest('.rule-card');
            if (card) card.remove();
        }

        function editTimeGroup(id) {
            openModal('timeGroupModal');
            const tg = (loadedTimeGroupsList || []).find(g => String(g.id) === String(id));
            if (!tg) {
                openTimeGroupModal();
                return;
            }
            document.getElementById('tgEditMode').value = 'true';
            document.getElementById('tgId').value = tg.id;
            document.getElementById('tgDescription').value = tg.description;
            
            const container = document.getElementById('timeGroupRulesListContainer');
            container.innerHTML = '';
            
            if (tg.rules && tg.rules.length > 0) {
                tg.rules.forEach(rule => {
                    addTimeGroupRuleToModal(rule);
                });
            } else {
                addTimeGroupRuleToModal();
            }
            
            document.getElementById('timeGroupModalTitle').textContent = (isRtl ? 'تعديل مجموعة الوقت: ' : 'Edit Time Group: ') + tg.description;
        }

        function saveTimeGroup(e) {
            e.preventDefault();
            const editMode = document.getElementById('tgEditMode').value === 'true';
            const id = document.getElementById('tgId').value;
            const description = document.getElementById('tgDescription').value.trim();
            
            const rules = [];
            const ruleCards = document.querySelectorAll('#timeGroupRulesListContainer .rule-card');
            
            ruleCards.forEach(card => {
                const startTime = card.querySelector('.rule-start-time').value;
                const finishTime = card.querySelector('.rule-finish-time').value;

                const activeButtons = Array.from(card.querySelectorAll('.day-toggle-btn.bg-blue-600'));
                const activeDays = activeButtons.map(b => b.getAttribute('data-day'));

                const startMthday = card.querySelector('.rule-start-monthday').value;
                const finishMthday = card.querySelector('.rule-finish-monthday').value;
                const startMth = card.querySelector('.rule-start-month').value;
                const finishMth = card.querySelector('.rule-finish-month').value;
                
                rules.push({
                    start_time: startTime,
                    finish_time: finishTime,
                    active_days: activeDays,
                    start_monthday: startMthday,
                    finish_monthday: finishMthday,
                    start_month: startMth,
                    finish_month: finishMth
                });
            });
            
            const method = editMode ? 'PUT' : 'POST';
            const url = editMode ? `/api/config/timegroups/${id}` : '/api/config/timegroups';
            
            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ description, rules })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeModal('timeGroupModal');
                    showToast(editMode ? 'Time Group updated successfully.' : 'Time Group added successfully.', 'success');
                    fetchTimeGroups();
                } else {
                    showToast(data.error || 'Failed to save Time Group.', 'error');
                }
            })
            .catch(err => {
                showToast('Failed to connect to server.', 'error');
            });
        }

        function deleteTimeGroup(id) {
            if (!confirm(isRtl ? 'هل أنت متأكد من حذف مجموعة الوقت هذه؟' : 'Are you sure you want to delete this Time Group?')) return;
            fetch(`/api/config/timegroups/${id}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast('Time Group deleted successfully.', 'success');
                        fetchTimeGroups();
                    } else {
                        showToast(data.error || 'Failed to delete Time Group.', 'error');
                    }
                });
        }

        async function uploadSystemRecording(e) {
            e.preventDefault();
            const nameInput = document.getElementById('sysRecName');
            const fileInput = document.getElementById('sysRecFile');
            const submitBtn = document.getElementById('sysRecSubmitBtn');
            const progressWrap = document.getElementById('sysRecProgressWrap');
            const progressBar = document.getElementById('sysRecProgressBar');
            const percentText = document.getElementById('sysRecPercent');
            const statusText = document.getElementById('sysRecStatus');

            if (!fileInput.files.length) {
                showToast('Please select an audio file.', 'error');
                return;
            }

            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            formData.append('name', nameInput.value.trim());
            const gainSelect = document.getElementById('sysRecGain');
            if (gainSelect) {
                formData.append('gainDb', gainSelect.value || '0');
            }
            submitBtn.disabled = true;
            progressWrap.classList.remove('hidden');
            progressBar.style.width = '0%';
            percentText.textContent = '0%';
            statusText.textContent = 'Uploading & converting...';

            try {
                const xhr = new XMLHttpRequest();
                const result = await new Promise((resolve, reject) => {
                    xhr.upload.addEventListener('progress', (ev) => {
                        if (ev.lengthComputable) {
                            const pct = Math.round((ev.loaded / ev.total) * 100);
                            progressBar.style.width = pct + '%';
                            percentText.textContent = pct + '%';
                        }
                    });
                    xhr.addEventListener('load', () => {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            resolve(JSON.parse(xhr.responseText));
                        } else {
                            try { reject(JSON.parse(xhr.responseText)); }
                            catch (err) { reject({ error: 'HTTP ' + xhr.status }); }
                        }
                    });
                    xhr.addEventListener('error', () => reject({ error: 'Network error' }));
                    xhr.open('POST', '/api/settings/recordings/upload');
                    xhr.send(formData);
                });

                if (result.success) {
                    showToast(result.message, 'success');
                    document.getElementById('systemRecordingUploadForm').reset();
                    fetchRecordings();
                } else {
                    showToast(result.error || 'Upload failed', 'error');
                }
            } catch (err) {
                showToast(err.error || err.message || 'Upload failed', 'error');
            } finally {
                submitBtn.disabled = false;
                setTimeout(() => {
                    progressWrap.classList.add('hidden');
                    progressBar.style.width = '0%';
                }, 3000);
            }
        }

        let activeRecordingAudio = null;
        let activeRecordingBtn = null;

        function togglePlayRecording(id, btn) {
            const url = `/api/config/recordings/audio/${id}`;
            
            if (activeRecordingAudio && activeRecordingBtn === btn) {
                if (activeRecordingAudio.paused) {
                    activeRecordingAudio.play();
                    setPlayBtnState(btn, true);
                } else {
                    activeRecordingAudio.pause();
                    setPlayBtnState(btn, false);
                }
                return;
            }

            if (activeRecordingAudio) {
                activeRecordingAudio.pause();
                if (activeRecordingBtn) setPlayBtnState(activeRecordingBtn, false);
            }

            activeRecordingAudio = new Audio(url);
            activeRecordingBtn = btn;

            activeRecordingAudio.addEventListener('play', () => setPlayBtnState(btn, true));
            activeRecordingAudio.addEventListener('pause', () => setPlayBtnState(btn, false));
            activeRecordingAudio.addEventListener('ended', () => {
                setPlayBtnState(btn, false);
                activeRecordingAudio = null;
                activeRecordingBtn = null;
            });

            activeRecordingAudio.play().catch(err => {
                showToast("Playback error: " + err.message, "error");
                setPlayBtnState(btn, false);
            });
        }

        function setPlayBtnState(btn, isPlaying) {
            if (!btn) return;
            const span = btn.querySelector('span');
            const svg = btn.querySelector('svg');
            const isRtl = '<%= isRtl %>' === 'true';
            
            if (isPlaying) {
                if (span) span.textContent = isRtl ? 'إيقاف' : 'Pause';
                if (svg) {
                    svg.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
                    svg.setAttribute('class', 'w-3 h-3 fill-emerald-400');
                    svg.setAttribute('viewBox', '0 0 24 24');
                }
            } else {
                if (span) span.textContent = isRtl ? 'تشغيل' : 'Play';
                if (svg) {
                    svg.innerHTML = '<path d="M8 5v14l11-7z"/>';
                    svg.setAttribute('class', 'w-3 h-3 fill-emerald-400');
                    svg.setAttribute('viewBox', '0 0 24 24');
                }
            }
        }

        function deleteRecording(id) {
            const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(id));
            const name = rec ? (rec.displayname || ('#' + id)) : ('#' + id);
            const confirmMsg = isRtl
                ? `هل أنت متأكد من حذف التسجيل الصوتي '${name}' (رقم #${id})؟`
                : `Delete system recording '${name}' (ID #${id})?`;
            if (!confirm(confirmMsg)) return;
            fetch('/api/config/recordings/' + id, { method: 'DELETE' })
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    return res.json();
                })
                .then(data => {
                    if (data.success) {
                        showToast(data.message || (isRtl ? 'تم حذف التسجيل بنجاح' : 'Recording deleted successfully'), 'success');
                        fetchRecordings();
                    } else {
                        showToast(data.error || (isRtl ? 'فشل حذف التسجيل' : 'Failed to delete recording'), 'error');
                    }
                })
                .catch(err => {
                    if (err.message !== 'Unauthorized') {
                        showToast(err.message || (isRtl ? 'خطأ في الاتصال بالخادم' : 'Server connection error'), 'error');
                    }
                });
        }
        window.fetchRecordings = fetchRecordings;
        window.uploadSystemRecording = uploadSystemRecording;
        window.uploadRecording = uploadSystemRecording;
        window.togglePlayRecording = togglePlayRecording;
        window.deleteRecording = deleteRecording;
        window.setPlayBtnState = setPlayBtnState;
        async function saveRecordingVolume(id) {
            const input = document.getElementById('recGainRange_' + id);
            if (!input) return;
            const gainDb = parseInt(input.value, 10);
            const isRtl = '<%= isRtl %>' === 'true';

            try {
                const res = await fetch(`/api/config/recordings/${id}/volume`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gainDb })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || (isRtl ? 'تم تحديث مستوى الصوت بنجاح' : 'Volume updated successfully'), 'success');
                    const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(id));
                    if (rec) rec.gain_db = data.gainDb;
                    const badge = document.getElementById('recGainBadge_' + id);
                    if (badge) {
                        badge.textContent = (data.gainDb > 0 ? '+' : '') + data.gainDb + ' dB';
                        badge.className = 'font-mono font-bold text-xs ' + (data.gainDb === 0 ? 'text-[var(--text-muted)]' : (data.gainDb < 0 ? 'text-amber-400' : 'text-emerald-400'));
                    }
                } else {
                    showToast(data.error || 'Failed to update volume', 'error');
                }
            } catch (err) {
                showToast(err.message || 'Error updating volume', 'error');
            }
        }

        function setRecordingGainQuick(id, gainDb) {
            const input = document.getElementById('recGainRange_' + id);
            const badge = document.getElementById('recGainBadge_' + id);
            if (input) input.value = gainDb;
            if (badge) {
                badge.textContent = (gainDb > 0 ? '+' : '') + gainDb + ' dB';
                badge.className = 'font-mono font-bold text-xs ' + (gainDb === 0 ? 'text-[var(--text-muted)]' : (gainDb < 0 ? 'text-amber-400' : 'text-emerald-400'));
            }
            saveRecordingVolume(id);
        }

        window.saveRecordingVolume = saveRecordingVolume;
        window.setRecordingGainQuick = setRecordingGainQuick;


                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0-4a3 3 0 003-3V7a3 3 0 10-6 0v8a3 3 0 003 3z"/></svg>
                        </div>
                        <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'التفريغ الصوتي بالذكاء الاصطناعي (Cloud AI STT)' : 'Cloud AI Speech-to-Text (STT)' %></h2>
                                <span id="sttOverviewStatusBadge" class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-blue-500/10 text-blue-400 border border-blue-500/20">Groq Active</span>
                            </div>
                            <p class="text-[11px] text-[var(--text-muted)] mt-1"><%= isRtl ? 'تفريغ المكالمات المسجلة والبريد الصوتي باستخدام نماذج الذكاء الاصطناعي السحابية (Groq Whisper-Large-V3 / OpenAI / Deepgram).' : 'Automated call and voicemail transcription using Cloud AI models (Groq Whisper-Large-V3, OpenAI, Deepgram).' %></p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 self-start sm:self-auto shrink-0 flex-wrap">
                        <button type="button" onclick="scanAndTranscribeQueue()" class="config-action-btn config-action-btn--secondary">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            <span><%= isRtl ? 'فحص السجلات غير المفرغة' : 'Scan & Queue Audio' %></span>
                        </button>
                        <button type="button" onclick="openSttApiKeyModal()" class="config-action-btn config-action-btn--primary">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/></svg>
                            <span><%= isRtl ? 'إدارة مفاتيح ومزود الذكاء الاصطناعي' : 'Configure AI & API Keys' %></span>
                        </button>
                    </div>
                </div>
                <div class="p-5 sm:p-6 grid grid-cols-1 sm:grid-cols-3 gap-4 bg-[var(--bg-primary)]/30">
                    <div class="flex items-center gap-3 p-3 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center font-bold text-xs">AI</div>
                        <div class="min-w-0">
                            <span class="text-[10px] uppercase font-bold text-[var(--text-muted)] block"><%= isRtl ? 'المزود والنموذج' : 'Active Provider & Model' %></span>
                            <span id="sttOverviewProvider" class="text-xs font-mono font-bold text-white truncate block">Groq: whisper-large-v3</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="w-8 h-8 rounded-lg bg-purple-500/10 text-purple-400 flex items-center justify-center font-bold text-xs">AR</div>
                        <div class="min-w-0">
                            <span class="text-[10px] uppercase font-bold text-[var(--text-muted)] block"><%= isRtl ? 'اللغة واللهجة' : 'Language & Dialect' %></span>
                            <span id="sttOverviewLanguage" class="text-xs font-bold text-white truncate block"><%= isRtl ? 'العامية المصرية (Auto)' : 'Egyptian Arabic (Auto)' %></span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-xs">AUTO</div>
                        <div class="min-w-0">
                            <span class="text-[10px] uppercase font-bold text-[var(--text-muted)] block"><%= isRtl ? 'التفريغ التلقائي' : 'Auto-Transcription' %></span>
                            <span id="sttOverviewTriggers" class="text-xs font-bold text-white truncate block"><%= isRtl ? 'مفعل للمكالمات والبريد الصوتي' : 'Calls & Voicemails Active' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RTCP Real-Time Audio Diagnostics Panel -->
            <div class="config-card overflow-hidden">
                <div class="p-5 sm:p-6 border-b border-[var(--border-primary)]">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z" />
                                </svg>
                            </div>
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="text-sm font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'تشخيص الصوت المباشر' : 'RTCP Audio Diagnostics' %></h3>
                                    <span id="rtcpActiveBadge" class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-purple-500/10 text-purple-400 border border-purple-500/20">0 Active Streams</span>
                                </div>
                                <p class="text-xs text-[var(--text-muted)] mt-1"><%= isRtl ? 'مراقبة جودة الصوت وفقدان الحزم وزمن الاستجابة للتدفقات النشطة.' : 'Monitor audio quality, packet loss, latency, and codecs for active channels.' %></p>
                            </div>
                        </div>
                        <button type="button" onclick="fetchRtcpDiagnostics()" class="config-action-btn self-start">
                            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                            <span><%= isRtl ? 'تحديث المقاييس' : 'Refresh Metrics' %></span>
                        </button>
                    </div>
                </div>
                <div id="rtcpDiagnosticsContainer" class="p-5 sm:p-6">
                    <!-- Rendered dynamically by fetchRtcpDiagnostics() -->
                </div>
            </div>

            <!-- Dongle & SIM State Duration Reports Panel -->
            <div class="config-card overflow-hidden">
                <div class="p-5 sm:p-6 border-b border-[var(--border-primary)]">
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                        <div class="flex items-start gap-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z" />
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-sm font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'تقارير مدة حالات المودم والشرائح' : 'Dongle & SIM State Duration Reports' %></h3>
                                <p class="text-xs text-[var(--text-muted)] mt-1"><%= isRtl ? 'تحليل الزمن المستغرق لكل مودم وشريحة في كل حالة (جاهز، في مكالمة، غير مهيأ، غير متصل).' : 'Track exact duration spent in each state (Free, Busy, Not Initialized, Disconnected) per Dongle and SIM Number.' %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters Bar -->
                <div class="p-4 sm:px-6 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/25 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
                        <div>
                            <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1" for="dongleReportStartDate"><%= isRtl ? 'من تاريخ/وقت' : 'Start Time' %></label>
                            <input type="datetime-local" id="dongleReportStartDate" name="dongleReportStartDate" class="config-input w-full text-xs font-mono">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1" for="dongleReportEndDate"><%= isRtl ? 'إلى تاريخ/وقت' : 'End Time' %></label>
                            <input type="datetime-local" id="dongleReportEndDate" name="dongleReportEndDate" class="config-input w-full text-xs font-mono">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1" for="dongleReportDongleSelect"><%= isRtl ? 'المودم' : 'Dongle' %></label>
                            <select id="dongleReportDongleSelect" class="config-input w-full text-xs font-mono">
                                <option value="ALL"><%= isRtl ? 'جميع الأجهزة (ALL)' : 'All Dongles (ALL)' %></option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1" for="dongleReportSimSelect"><%= isRtl ? 'رقم الشريحة (DID)' : 'SIM Number (DID)' %></label>
                            <select id="dongleReportSimSelect" class="config-input w-full text-xs font-mono">
                                <option value="ALL"><%= isRtl ? 'جميع الشرائح (ALL)' : 'All SIM Numbers (ALL)' %></option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                        <div class="flex flex-wrap items-center gap-1.5">
                            <span class="text-[11px] font-bold text-[var(--text-secondary)] me-1"><%= isRtl ? 'فترات سريعة:' : 'Quick Presets:' %></span>
                            <button type="button" onclick="setDongleReportPreset('today')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= isRtl ? 'اليوم' : 'Today' %></button>
                            <button type="button" onclick="setDongleReportPreset('yesterday')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= isRtl ? 'الأمس' : 'Yesterday' %></button>
                            <button type="button" onclick="setDongleReportPreset('7days')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= isRtl ? 'آخر 7 أيام' : 'Last 7 Days' %></button>
                            <button type="button" onclick="setDongleReportPreset('30days')" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= isRtl ? 'آخر 30 يوماً' : 'Last 30 Days' %></button>
                        </div>

                        <button type="button" onclick="fetchDongleStateReports()" class="config-action-btn config-action-btn--primary px-4 py-2 text-xs cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <span><%= isRtl ? 'توليد التقرير' : 'Generate Report' %></span>
                        </button>
                    </div>
                </div>

                <!-- Report Summary Cards & Detailed Tables -->
                <div class="p-5 sm:p-6 space-y-6">
                    <div id="dongleReportSummaryContainer" class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <!-- Summary metrics populated dynamically -->
                    </div>

                    <div id="dongleReportTablesContainer" class="space-y-6">
                        <!-- Reports tables populated dynamically -->
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <!-- 16. TTY TERMINAL SHELL TAB SECTION (root super user only) -->
        <% if (typeof isRoot !== 'undefined' && isRoot) { %>
        <div id="section-terminal" class="tab-section hidden space-y-4">
            <div class="config-card p-6 flex flex-col space-y-4">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-[var(--border-primary)] pb-4">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                            <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span><%= isRtl ? 'طرفية النظام (TTY Shell Terminal)' : 'TTY Shell Terminal' %></span>
                        </h2>
                    </div>
                    <!-- Controls Toolbar -->
                    <div class="flex flex-wrap items-center gap-2">
                        <!-- Status Badge -->
                        <span id="ttyStatusBadge" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 flex items-center gap-1.5">
                            <span id="ttyStatusDot" class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
                            <span id="ttyStatusText">Disconnected</span>
                        </span>
                        <!-- Copy Selected Button -->
                        <button onclick="copySelectedTextFromTerminal()" title="<%= isRtl ? 'نسخ النص المحدد' : 'Copy Selected Text' %>" class="px-3 py-1.5 bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 text-xs font-bold rounded-lg cursor-pointer transition flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                            <span><%= isRtl ? 'نسخ المحدد' : 'Copy Selected' %></span>
                        </button>
                        <!-- Paste Clipboard Button -->
                        <button onclick="pasteClipboardToTerminal()" title="<%= isRtl ? 'لصق من الحافظة' : 'Paste from Clipboard' %>" class="px-3 py-1.5 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-bold rounded-lg cursor-pointer transition flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                            <span><%= isRtl ? 'لصق الحافظة' : 'Paste Clipboard' %></span>
                        </button>
                        <!-- Run Last Command Button -->
                        <button onclick="runLastTtyCommand()" title="<%= isRtl ? 'تشغيل آخر أمر (سهم للأعلى + إدخال)' : 'Run Last Command (Up + Enter)' %>" class="px-3 py-1.5 bg-amber-500/10 hover:bg-amber-500/20 text-amber-400 border border-amber-500/30 text-xs font-bold rounded-lg cursor-pointer transition flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" /></svg>
                            <span><%= isRtl ? 'آخر أمر' : 'Run Last Cmd' %></span>
                        </button>
                        <button onclick="clearTerminalScreen()" class="px-3 py-1.5 bg-[var(--bg-card)] border border-[var(--border-primary)] hover:bg-[var(--bg-hover)] text-xs font-semibold rounded-lg cursor-pointer transition text-[var(--text-primary)]">
                            <%= isRtl ? 'مسح الشاشة' : 'Clear' %>
                        </button>
                        <!-- Restart Shell Button -->
                        <button onclick="restartTtyShell()" class="px-3 py-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/30 text-xs font-semibold rounded-lg cursor-pointer transition">
                            <%= isRtl ? 'إعادة تشغيل الطرفية' : 'Restart Shell' %>
                        </button>
                    </div>
                </div>

                <!-- Terminal Container Window -->
                <div id="ttyTerminalWrapper" class="relative w-full border border-[var(--border-primary)] rounded-xl bg-[#09090b] p-3 overflow-hidden" style="height: calc(100vh - 280px); min-height: 550px;">
                    <div id="terminalContainer" class="w-full h-full font-mono text-xs text-emerald-400 overflow-auto focus:outline-none select-text" tabindex="0"></div>
                </div>
            </div>
        </div>
        <% } %>
        <!-- SECTION 15: SOKRAT IAX2 MULTI-SERVER PBX FEDERATION -->
        <div id="section-federation" class="tab-section hidden space-y-6">
            <!-- 1. Top Identity & Federation Settings Banner -->
            <div class="config-card p-6 border-l-4 border-l-amber-500">
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <%
                            const fedLocalSite = (typeof federationSettings !== 'undefined' && federationSettings.local_site_code) ? federationSettings.local_site_code : '10';
                            const fedLocalName = (typeof federationSettings !== 'undefined' && federationSettings.local_node_name) ? federationSettings.local_node_name : 'Main PBX';
                            const fedLocalRole = (typeof federationSettings !== 'undefined' && federationSettings.panel_role) ? federationSettings.panel_role : 'local';
                            %>
                            <div class="flex items-center gap-2.5 flex-wrap">
                                <h2 class="text-lg font-black text-[var(--text-primary)] tracking-tight">
                                    <%= isRtl ? 'الربط السحابي بين السيرفرات (IAX2 PBX Federation)' : 'Multi-Server PBX Federation (IAX2)' %>
                                </h2>
                                <span id="fedLocalSiteBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                                    Site <%= fedLocalSite %>
                                </span>
                                <span id="fedLocalRoleBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold <%= fedLocalRole === 'central' ? 'bg-purple-500/20 text-purple-400 border border-purple-500/30' : 'bg-blue-500/20 text-blue-400 border border-blue-500/30' %>">
                                    <%= fedLocalRole === 'central' ? (isRtl ? 'لوحة مركزية موحدة' : 'Central Live Panel') : (isRtl ? 'سيرفر محلي' : 'Local PBX') %>
                                </span>
                            </div>
                            <p class="text-xs text-[var(--text-muted)] mt-1">
                                <%= isRtl ? 'ربط موحد بين سيرفرات أستيركس عبر بروتوكول IAX2 مع اتصال داخلي مباشر بالبادئة، ومشاركة خطوط GSM ومجموعات الرنين واللوحة الموحدة.' : 'Seamless inter-server VoIP federation over IAX2 with prefix site codes, shared GSM dongle egress, unified queues/ring groups, and central operator live panel.' %>
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 shrink-0 flex-wrap">
                        <button type="button" onclick="openFederationSettingsModal()" class="config-btn-secondary px-4 py-2.5 flex items-center gap-2 text-xs cursor-pointer">
                            <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span><%= isRtl ? 'إعدادات هذا السيرفر' : 'Local PBX Settings' %></span>
                        </button>
                        <button type="button" onclick="openConnectPbxModal()" class="config-btn-primary px-4 py-2.5 flex items-center gap-2 text-xs cursor-pointer shadow-lg shadow-amber-500/10">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <span class="font-extrabold"><%= isRtl ? 'ربط سيرفر جديد (1-Click)' : 'Connect New PBX' %></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. Connected Peers Table Card -->
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 border-b border-[var(--border-primary)] pb-4">
                    <div>
                        <h3 class="text-base font-extrabold text-[var(--text-primary)]">
                            <%= isRtl ? 'السيرفرات المرتبطة المتصلة' : 'Connected PBX Nodes' %>
                        </h3>
                        <p class="text-xs text-[var(--text-muted)]">
                            <%= isRtl ? 'قائمة السيرفرات المتصلة عبر نفق IAX2 المشفر مع حالة الاتصال والتحويلات والخطوط' : 'Active Asterisk peer nodes connected via encrypted IAX2 link with live status and synced entities' %>
                        </p>
                    </div>
                    <button type="button" onclick="fetchFederationPeers()" class="px-3 py-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-1.5 transition">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span><%= isRtl ? 'تحديث الحالة' : 'Refresh' %></span>
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-[var(--border-primary)] text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider">
                                <th class="py-3 px-4"><%= isRtl ? 'السيرفر' : 'Node / PBX' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'كود الموقع (Site Code)' : 'Site Code' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'العنوان / IP' : 'Host / IP' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الحالة (Latency)' : 'Status' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'التحويلات المرتبطة' : 'Remote Extensions' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'خطوط GSM المشاركة' : 'Shared GSM' %></th>
                                <th class="py-3 px-4 text-center"><%= isRtl ? 'إجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="federationPeersTableBody" class="divide-y divide-[var(--border-primary)] text-xs text-[var(--text-primary)]">
                            <tr>
                                <td colspan="7" class="py-8 text-center text-xs text-[var(--text-muted)]">
                                    <%= isRtl ? 'جاري تحميل السيرفرات المرتبطة...' : 'Loading connected PBX nodes...' %>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Synced Remote Extensions Grid -->
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h3 class="text-base font-extrabold text-[var(--text-primary)]">
                            <%= isRtl ? 'دليل التحويلات البعيدة (Remote Extensions Directory)' : 'Remote Extensions Directory' %>
                        </h3>
                        <p class="text-xs text-[var(--text-muted)]">
                            <%= isRtl ? 'التحويلات المتاحة للاتصال المباشر عبر بادئة كود الموقع (مثل 20101 للاتصال بتحويلة 101 في الموقع 20)' : 'Remote extensions reachable via site code prefix dialing (e.g. dial 20101 to reach ext 101 on Site 20)' %>
                        </p>
                    </div>
                    <div class="relative w-full sm:w-64">
                        <input type="text" id="fedRemoteExtSearchInput" oninput="filterRemoteExtensionsDirectory()" placeholder="<%= isRtl ? 'بحث في التحويلات البعيدة...' : 'Search remote extensions...' %>" class="config-input w-full pl-9 pr-3 py-2 text-xs rounded-xl">
                        <svg class="w-4 h-4 text-[var(--text-muted)] absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>

                <div id="fedRemoteExtensionsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
                    <div class="col-span-full py-8 text-center text-xs text-[var(--text-muted)]">
                        <%= isRtl ? 'لا توجد تحويلات بعيدة مسجلة حتى الآن.' : 'No remote extensions registered yet.' %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL 1: EXTENSION FORM -->
    <div id="extensionModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    </div>
                    <div>
                        <h3 id="extModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة تحويلة' : 'Add Extension' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تكوين بيانات التحويلة والتقنية وملف الموظف' : 'Configure extension credentials, device technology, and employee profile' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('extensionModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="extensionForm" onsubmit="saveExtension(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="extEditMode" value="false">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: EXTENSION CREDENTIALS & TECH (Cyan Theme) -->
                    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-cyan-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'بيانات التحويلة والجهاز' : 'Extension Credentials & Device' %>
                            </span>
                            <span class="text-[10px] text-cyan-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extNum"><%= isRtl ? 'رقم التحويلة *' : 'User Extension ID *' %></label>
                                <input type="text" id="extNum" required placeholder="e.g. 105" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extName"><%= isRtl ? 'الاسم الظاهر *' : 'Display Name *' %></label>
                                <input type="text" id="extName" required placeholder="e.g. Sales Desk 1" class="config-input w-full text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extSecret"><%= isRtl ? 'كلمة السر *' : 'Secret (Password) *' %></label>
                                <input type="text" id="extSecret" autocomplete="new-password" required placeholder="e.g. P@ssword123!" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extTech"><%= isRtl ? 'نوع جهاز التحويلة *' : 'Extension Tech / Device Type *' %></label>
                                <select id="extTech" class="config-input w-full text-xs font-semibold">
                                    <option value="sip" selected><%= isRtl ? 'هاتف شبكة اعتيادي (Generic SIP Device - UDP / Port 5060)' : 'Generic SIP Device (Hardware / Port 5060)' %></option>
                                    <option value="webrtc"><%= isRtl ? 'هاتف المتصفح البرمجي (WebRTC Softphone - WSS / Port 5066)' : 'WebRTC Softphone (Browser WSS / Port 5066)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extVoicemail"><%= isRtl ? 'البريد الصوتي' : 'Voicemail Option' %></label>
                                <select id="extVoicemail" class="config-input w-full text-xs font-semibold">
                                    <option value="disabled"><%= isRtl ? 'معطل (Disabled / No Voicemail)' : 'Disabled (No Voicemail)' %></option>
                                    <option value="enabled"><%= isRtl ? 'مفعل (Enabled / Active)' : 'Enabled (Voicemail Active)' %></option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extDenoise"><%= isRtl ? 'عزل الضوضاء (AI RNNoise)' : 'AI Noise Suppression (RNNoise)' %></label>
                                <select id="extDenoise" class="config-input w-full text-xs font-semibold">
                                    <option value="both" selected><%= isRtl ? 'مفعل (إرسال واستقبال - Both RX & TX)' : 'Enabled (Both RX & TX)' %></option>
                                    <option value="rx"><%= isRtl ? 'مفعل للميكروفون فقط (RX Only)' : 'Microphone Only (RX Only)' %></option>
                                    <option value="tx"><%= isRtl ? 'مفعل للسماعة فقط (TX Only)' : 'Speaker Only (TX Only)' %></option>
                                    <option value="off"><%= isRtl ? 'معطل (Disabled / Off)' : 'Disabled (Off)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extVadGate"><%= isRtl ? 'بوابة كتم الصمت (VAD Noise Gate)' : 'VAD Silence Gate (100% Silence on Pauses)' %></label>
                                <select id="extVadGate" class="config-input w-full text-xs font-semibold">
                                    <option value="1" selected><%= isRtl ? 'مفعل (صمت 100% عند التوقف عن الكلام)' : 'Enabled (100% Silence on Pauses)' %></option>
                                    <option value="0"><%= isRtl ? 'معطل (عزل مستمر دون كتم)' : 'Disabled (Continuous Filter)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extVadDb"><%= isRtl ? 'عتبة كتم الديسيبل (dB Cutoff)' : 'Decibel Cutoff (dBFS Noise Gate)' %></label>
                                <select id="extVadDb" class="config-input w-full text-xs font-semibold">
                                    <option value="off" selected><%= isRtl ? 'تلقائي / عصبي فقط (Auto / Neural)' : 'Auto / Neural Only (Default)' %></option>
                                    <option value="-55">-55 dBFS (<%= isRtl ? 'هادئ جداً' : 'Very Soft Noise' %>)</option>
                                    <option value="-50">-50 dBFS (<%= isRtl ? 'خافت / متوازن' : 'Soft / Balanced' %>)</option>
                                    <option value="-45">-45 dBFS (<%= isRtl ? 'متوسط / مكتب هادئ' : 'Moderate / Quiet Office' %>)</option>
                                    <option value="-42">-42 dBFS (<%= isRtl ? 'عالي / مكتب نشط' : 'High / Busy Office' %>)</option>
                                    <option value="-38">-38 dBFS (<%= isRtl ? 'صارم / ضوضاء قوية' : 'Strict / Heavy Noise' %>)</option>
                                    <option value="-35">-35 dBFS (<%= isRtl ? 'عدواني / ضوضاء شديدة' : 'Aggressive / Loud Noise' %>)</option>
                                    <option value="-30">-30 dBFS (<%= isRtl ? 'أقصى كتم / أصوات عالية' : 'Maximum / Extreme Noise' %>)</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: EMPLOYEE PROFILE & PHOTO (Emerald Theme) -->
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'ملف الموظف والصورة' : 'Employee Profile & Media' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono"><%= isRtl ? 'اختياري' : 'OPTIONAL' %></span>
                        </div>

                        <div class="flex flex-col md:flex-row gap-4 items-start">
                            <div class="md:w-[18rem] shrink-0">
                                <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'صورة الموظف' : 'Employee photo' %></span>
                                <div class="flex items-center gap-3">
                                    <div class="relative w-16 h-16 rounded-xl overflow-hidden border border-emerald-500/20 bg-black/40 shrink-0 flex items-center justify-center">
                                        <svg id="extPhotoFallback" class="w-7 h-7 text-emerald-400/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232a4 4 0 11-5.657 5.657 4 4 0 015.657-5.657zM4 20a8 8 0 0116 0"/></svg>
                                        <img id="extPhotoPreview" class="hidden absolute inset-0 w-full h-full object-cover" src="" alt="<%= isRtl ? 'معاينة صورة الموظف' : 'Employee photo preview' %>">
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <input type="file" id="extPhoto" accept=".jpg,.jpeg,.png,.gif,.webp,.bmp,image/jpeg,image/png,image/gif,image/webp,image/bmp" class="sr-only" onchange="previewEmployeePhoto(this)">
                                        <div class="flex flex-wrap gap-1.5">
                                            <label for="extPhoto" class="config-btn-secondary px-2.5 py-1.5 text-[11px] cursor-pointer"><%= isRtl ? 'اختيار صورة' : 'Choose photo' %></label>
                                            <button id="extPhotoRemove" type="button" onclick="clearEmployeePhoto()" class="hidden px-2.5 py-1.5 text-[11px] font-bold text-rose-400 hover:text-rose-300 cursor-pointer"><%= isRtl ? 'إزالة' : 'Remove' %></button>
                                        </div>
                                        <p id="extPhotoStatus" class="mt-1.5 text-[11px] text-[var(--text-muted)] truncate"><%= isRtl ? 'لم يتم اختيار صورة' : 'No photo selected' %></p>
                                        <p class="mt-0.5 text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'الحد الأقصى 50 ميجابايت' : 'Maximum 50 MB' %></p>
                                        <input type="hidden" id="extPhotoUrl" value="">
                                    </div>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 flex-1 min-w-0 w-full">
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extTitle"><%= isRtl ? 'المسمى الوظيفي' : 'Job title' %></label>
                                    <input type="text" id="extTitle" maxlength="255" placeholder="<%= isRtl ? 'مثال: مدير المبيعات' : 'e.g. Sales Manager' %>" class="config-input w-full text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extGroup"><%= isRtl ? 'مجموعة الموظفين' : 'Employee group' %></label>
                                    <select id="extGroup" class="config-input w-full text-xs font-semibold" disabled>
                                        <option value=""><%= isRtl ? 'جاري تحميل المجموعات...' : 'Loading groups...' %></option>
                                    </select>
                                    <p class="mt-1 text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'تُدار المجموعات من لوحة المراقبة المباشرة' : 'Groups are managed from the Live Panel' %></p>
                                </div>
                                <div class="sm:col-span-2 pt-1">
                                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-emerald-500/20 bg-black/20 <%= canManageGroupAdmin ? 'hover:bg-black/30 cursor-pointer' : 'opacity-60 cursor-not-allowed' %> text-xs">
                                        <input type="checkbox" id="extIsGroupAdmin" class="tab-checkbox" <%= canManageGroupAdmin ? '' : 'disabled' %>>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between">
                                                <span class="font-bold text-white flex items-center gap-1.5">
                                                    <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                                                    <span><%= isRtl ? 'مدير المجموعة (Group Admin)' : 'Group Admin (Call Pickup Authority)' %></span>
                                                </span>
                                                <% if (!canManageGroupAdmin) { %>
                                                    <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/40 uppercase">
                                                        <%= isRtl ? 'مدراء النظام فقط' : 'Super Admin Only' %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] text-[var(--text-muted)] mt-0.5">
                                                <%= isRtl ? 'عند التفعيل، يحصل هذا الموظف وحده على صلاحية التقاط مكالمات أعضاء مجموعته (*) — صلاحية خاصة بمدراء النظام' : 'When enabled, only this extension has authority to pick up ringing calls from its group members (*) — Super Admin permission required' %>
                                            </p>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- System Defaults Information Banner -->
                    <div class="p-3.5 bg-cyan-500/5 border border-cyan-500/20 rounded-xl text-xs space-y-1.5">
                        <div class="font-bold text-cyan-400 flex items-center gap-2 text-xs uppercase tracking-wider">
                            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span><%= isRtl ? 'الإعدادات التلقائية المطبقة للنظام:' : 'Automatic System Extension Defaults:' %></span>
                        </div>
                        <ul class="text-[var(--text-muted)] list-disc list-inside text-[11px] space-y-0.5 font-medium">
                            <li><strong>Device Port:</strong> 5066 (WebRTC / WSS) or 5060 (SIP / UDP)</li>
                            <li><strong>NAT Setting:</strong> Enabled (nat = yes)</li>
                            <li><strong>Call Recording:</strong> ALWAYS (Inbound/Outbound Internal & External)</li>
                        </ul>
                    </div>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('extensionModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button id="extSaveBtn" type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span id="extSaveBtnText"><%= isRtl ? 'حفظ التحويلة' : 'Save Extension' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL: WEBRTC CREDENTIALS DISPLAY -->
    <div id="webrtcCredentialsModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[99999] flex items-center justify-center hidden p-4">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full p-6 text-[var(--text-primary)]">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-[var(--border-primary)]">
                <h3 class="text-base font-extrabold text-purple-400 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    <span><%= isRtl ? 'بيانات اتصال هاتف WebRTC' : 'WebRTC Softphone Credentials' %></span>
                </h3>
                <button type="button" onclick="closeModal('webrtcCredentialsModal')" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer">✕</button>
            </div>
            <p class="text-xs text-[var(--text-muted)] mb-4">
                <%= isRtl ? 'تم إنشاء تحويلة WebRTC بنجاح. يمكنك استخدام هذه البيانات لتسجيل الدخول في هاتف المتصفح.' : 'WebRTC softphone extension created successfully. Use these details to configure your WebRTC device.' %>
            </p>
            <div class="space-y-2 bg-[var(--bg-card)] p-4 rounded-xl border border-[var(--border-primary)] text-xs font-mono">
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">Extension:</span><span id="credExt" class="font-bold text-white"></span></div>
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">Name:</span><span id="credName" class="font-bold text-white"></span></div>
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">Secret (Password):</span><span id="credSecret" class="font-bold text-amber-400"></span></div>
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">WebSocket Server:</span><span id="credWsUrl" class="font-bold text-purple-400"></span></div>
            </div>
            <div class="flex justify-end mt-5">
                <button type="button" onclick="closeModal('webrtcCredentialsModal')" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'تم' : 'Done' %></button>
            </div>
        </div>
    </div>

    <!-- MODAL 2: RING GROUP FORM -->
    <div id="ringGroupModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    </div>
                    <div>
                        <h3 id="rgModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة مجموعة اتصال' : 'Add Ring Group' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تجميع عدة تحويلات للرنين التزامني أو التتابعي' : 'Group multiple extensions for simultaneous or hunt ring strategies' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('ringGroupModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="ringGroupForm" onsubmit="saveRingGroup(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="rgEditMode" value="false">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: RING GROUP IDENTITY & STRATEGY (Emerald Theme) -->
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'هوية مجموعة الاتصال والاستراتيجية' : 'Ring Group Identity & Strategy' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgNum"><%= isRtl ? 'رقم مجموعة الاتصال *' : 'Ring Group Number *' %></label>
                                <input type="text" id="rgNum" required placeholder="e.g. 600" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgDesc"><%= isRtl ? 'وصف المجموعة *' : 'Group Description *' %></label>
                                <input type="text" id="rgDesc" required placeholder="e.g. Sales Support Team" class="config-input w-full text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: RING STRATEGY & TIMING -->
                    <div class="rounded-xl border border-sky-500/20 bg-sky-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-sky-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-sky-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                                <%= isRtl ? 'استراتيجية الرنين والتوقيت' : 'Ring Strategy & Timing' %>
                            </span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgStrategy"><%= isRtl ? 'استراتيجية الرنين' : 'Ring Strategy' %></label>
                                <select id="rgStrategy" class="config-input w-full text-xs">
                                    <option value="ringall"><%= isRtl ? 'الكل معًا' : 'Ring All' %></option>
                                    <option value="hunt"><%= isRtl ? 'تسلسلي (Hunt)' : 'Hunt' %></option>
                                    <option value="memoryhunt"><%= isRtl ? 'تسلسلي مع التذكر' : 'Memory Hunt' %></option>
                                    <option value="random"><%= isRtl ? 'عشوائي' : 'Random' %></option>
                                    <option value="firstavailable"><%= isRtl ? 'أول متاح' : 'First Available' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgTime"><%= isRtl ? 'مدة الرنين (ثوانٍ)' : 'Ring Time (seconds)' %></label>
                                <input type="number" id="rgTime" min="5" max="120" placeholder="20" class="config-input w-full text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: MEMBERS EXTENSIONS -->
                    <div class="rounded-xl border border-violet-500/20 bg-violet-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-violet-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-violet-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                                <%= isRtl ? 'قائمة الأعضاء' : 'Member Extensions' %>
                            </span>
                            <button type="button" onclick="clearQuickPickExts()" class="text-[11px] font-bold text-rose-400 hover:text-rose-300 underline cursor-pointer"><%= isRtl ? 'مسح' : 'Clear' %></button>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgList"><%= isRtl ? 'الأرقام (مفصولة بفواصل)' : 'Numbers (comma-separated)' %></label>
                            <input type="text" id="rgList" placeholder="e.g. 101,102,103" class="config-input w-full text-xs font-mono">
                        </div>
                                                <div id="rgQuickPickContainer" class="flex flex-wrap gap-1.5"></div>
                    </div>

                    <!-- SECTION 4: ANNOUNCEMENT & MUSIC ON HOLD -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                    <%= isRtl ? 'الإعلان الصوتي' : 'Announcement' %>
                                </span>
                            </div>
                            <select id="rgAnnMsg" class="config-input w-full text-xs">
                                <option value="0"><%= isRtl ? 'بدون إعلان' : 'None / No Announcement' %></option>
                            </select>
                        </div>
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zM9 10l12-2" /></svg>
                                    <%= isRtl ? 'الموسيقى أثناء الانتظار' : 'Play Music On Hold' %>
                                </span>
                            </div>
                            <select id="rgRinging" class="config-input w-full text-xs font-mono font-bold">
                                <option value="Ring"><%= isRtl ? 'نغمة الرنين (افتراضي)' : 'Ring (Default Ringtone)' %></option>
                            </select>
                        </div>
                    </div>

                    <!-- SECTION 5: DESTINATION IF NO ANSWER (Post Destination) -->
                    <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block"><%= isRtl ? 'الوجهة عند عدم الرد *' : 'Destination if No Answer *' %></span>
                        
                        <!-- Create Mode Auto-Destination Banner -->
                        <div id="rgPostDestCreateNotice" class="hidden p-3 rounded-lg border border-emerald-500/20 bg-emerald-500/10 text-xs text-emerald-300 font-semibold flex items-center gap-2">
                            <svg class="w-4 h-4 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span><%= isRtl ? 'الوجهة التلقائية عند إنشاء المجموعة: مجموعة الاتصال نفسها' : 'Default destination upon creation: Automatically set to this Ring Group itself' %> (<span id="rgPostDestCreateNoticeNum" class="font-mono text-white">ext-group,600,1</span>)</span>
                        </div>

                        <!-- Edit Mode Editable Selectors -->
                        <!-- Edit Mode Editable DestinationSelect Component -->
                        <div id="rgPostDestComponentContainer"></div>
                        <input type="hidden" id="rgPostDestination">
                    </div>

                </div>
                <!-- Footer Buttons -->
                <div class="flex justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('ringGroupModal')" class="config-btn-secondary px-5 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'حفظ' : 'Save' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2.5: QUEUE FORM -->
    <div id="queueModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    </div>
                    <div>
                        <h3 id="queueModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة طابور انتظار' : 'Add Queue' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تحديد رقم طابور الانتظار، الاستراتيجية، وإدارة وكلاء الخدمة' : 'Configure ACD queue parameters, ring strategy, and active agents' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('queueModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="queueForm" onsubmit="saveQueue(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="queueEditMode" value="false">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: QUEUE IDENTITY (Amber Theme) -->
                    <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <%= isRtl ? 'هوية طابور الانتظار' : 'Queue Identity & Definition' %>
                            </span>
                            <span class="text-[10px] text-amber-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueNum"><%= isRtl ? 'رقم طابور الانتظار *' : 'Queue Number *' %></label>
                                <input type="text" id="queueNum" required placeholder="e.g. 800" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueDesc"><%= isRtl ? 'اسم طابور الانتظار *' : 'Queue Name *' %></label>
                                <input type="text" id="queueDesc" required placeholder="<%= isRtl ? 'مثال: طابور خدمة العملاء' : 'e.g. Support Queue' %>" class="config-input w-full text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: QUEUE AGENTS CHECKLIST (Indigo Theme) -->
                    <div class="rounded-xl border border-indigo-500/20 bg-indigo-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-indigo-500/15">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                                <h4 class="text-xs font-black text-indigo-400 uppercase tracking-wider"><%= isRtl ? 'قائمة وكلاء طابور الانتظار' : 'Queue Agents Checklist' %></h4>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <input type="text" id="queueAgentSearch" oninput="filterQueueAgentChecklist()" placeholder="<%= isRtl ? 'بحث...' : 'Search...' %>" class="config-input py-1 px-2.5 text-xs w-36">
                                <button type="button" onclick="clearAllQueueAgents()" class="text-[11px] font-bold text-rose-400 hover:text-rose-300 underline cursor-pointer whitespace-nowrap"><%= isRtl ? 'إعادة ضبط الكل' : 'Clear All' %></button>
                            </div>
                        </div>

                        <!-- Scrollable Agent Checklist Container -->
                        <div id="queueAgentsChecklistContainer" class="space-y-1.5 max-h-52 overflow-y-auto pr-1 mb-2 custom-scrollbar bg-black/40 p-3 rounded-xl border border-indigo-500/10">
                            <!-- Populated dynamically -->
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-indigo-500/15">
                            <div>
                                <label class="block text-[10px] font-bold text-amber-400 uppercase mb-1" for="queueStaticList"><%= isRtl ? 'ملخص الوكلاء الثابتين (Static)' : 'Static Agents Summary' %></label>
                                <input type="text" id="queueStaticList" oninput="renderQueueAgentChecklist()" placeholder="e.g. 101, 102" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-indigo-400 uppercase mb-1" for="queueDynList"><%= isRtl ? 'ملخص الوكلاء الديناميكيين (Dynamic)' : 'Dynamic Agents Summary' %></label>
                                <input type="text" id="queueDynList" oninput="renderQueueAgentChecklist()" placeholder="e.g. 104, 105" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: RING STRATEGY & MEDIA (Sky Theme) -->
                    <div class="rounded-xl border border-sky-500/20 bg-sky-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-sky-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-sky-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                                <%= isRtl ? 'استراتيجية التوزيع والإعلانات' : 'Strategy & Media Configuration' %>
                            </span>
                            <span class="text-[10px] text-sky-400/70 font-mono">MEDIA</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueStrategy"><%= isRtl ? 'استراتيجية الاتصال' : 'Ring Strategy' %></label>
                                <select id="queueStrategy" class="config-input w-full text-xs font-semibold">
                                    <option value="rrmemory" selected><%= isRtl ? 'rrmemory (التدوير مع الذاكرة - موصى به)' : 'rrmemory (Round Robin Memory - Recommended)' %></option>
                                    <option value="ringall"><%= isRtl ? 'ringall (رنين جميع الهواتف)' : 'ringall (Ring All)' %></option>
                                    <option value="leastrecent"><%= isRtl ? 'leastrecent (الأقل استقبالاً مؤخراً)' : 'leastrecent (Least Recent)' %></option>
                                    <option value="fewestcalls"><%= isRtl ? 'fewestcalls (الأقل في عدد المكالمات)' : 'fewestcalls (Fewest Calls)' %></option>
                                    <option value="random"><%= isRtl ? 'random (رنين عشوائي)' : 'random (Random)' %></option>
                                    <option value="linear"><%= isRtl ? 'linear (رنين خطي حسب الترتيب)' : 'linear (Linear)' %></option>
                                    <option value="wrandom"><%= isRtl ? 'wrandom (عشوائي موزون)' : 'wrandom (Weighted Random)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueMoh"><%= isRtl ? 'موسيقى الانتظار' : 'Music On Hold' %></label>
                                <select id="queueMoh" class="config-input w-full text-xs font-semibold">
                                    <option value="default" selected><%= isRtl ? 'default (الموسيقى الافتراضية)' : 'default (Default MoH)' %></option>
                                    <option value="none"><%= isRtl ? 'none (بدون موسيقى / صمت)' : 'none (Silence / No Music)' %></option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueAnnMsg"><%= isRtl ? 'رسالة الترحيب / الإعلان' : 'Join Announcement' %></label>
                                <select id="queueAnnMsg" class="config-input w-full text-xs font-semibold">
                                    <option value="0"><%= isRtl ? 'بدون إعلان / لا يوجد' : 'None / No Announcement' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueRecording"><%= isRtl ? 'وضع تسجيل المكالمات' : 'Call Recording' %></label>
                                <select id="queueRecording" class="config-input w-full text-xs font-semibold">
                                    <option value="yes" selected><%= isRtl ? 'نعم (تسجيل المكالمات في الخلفية)' : 'Yes (Background Recording)' %></option>
                                    <option value="no"><%= isRtl ? 'لا (إيقاف التسجيل)' : 'No (Disable Recording)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueMaxWait"><%= isRtl ? 'أقصى وقت انتظار (ثواني)' : 'Max Wait Time (sec)' %></label>
                                <input type="number" id="queueMaxWait" min="0" value="0" placeholder="0 = Unlimited" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: AGENT TIMEOUT & RETRY (Violet Theme) -->
                    <div class="rounded-xl border border-violet-500/20 bg-violet-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-violet-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-violet-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                                <%= isRtl ? 'إعدادات الوكلاء والتكرار' : 'Agent Timeout, Retry & Autofill' %>
                            </span>
                            <span class="text-[10px] text-violet-400/70 font-mono">ADVANCED</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueAgentTimeout"><%= isRtl ? 'مهلة الوكيل (ثوانٍ)' : 'Agent Timeout (seconds)' %></label>
                                <input type="number" id="queueAgentTimeout" min="1" value="15" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueRetry"><%= isRtl ? 'إعادة المحاولة (ثوانٍ)' : 'Retry (seconds)' %></label>
                                <input type="number" id="queueRetry" min="1" value="5" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueAutofill"><%= isRtl ? 'ملء تلقائي' : 'Autofill' %></label>
                                <select id="queueAutofill" class="config-input w-full text-xs font-semibold">
                                    <option value="yes"><%= isRtl ? 'نعم' : 'Yes' %></option>
                                    <option value="no"><%= isRtl ? 'لا' : 'No' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueSkipBusy"><%= isRtl ? 'تجاهل المشغول' : 'Skip Busy Agent' %></label>
                                <select id="queueSkipBusy" class="config-input w-full text-xs font-semibold">
                                    <option value="yes"><%= isRtl ? 'نعم' : 'Yes' %></option>
                                    <option value="no"><%= isRtl ? 'لا' : 'No' %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 5: QUEUE DESTINATIONS (Fail Over & Continue) -->
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- 1. Fail Over Destination -->
                            <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                                <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                    <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                        <%= isRtl ? 'الوجهة عند الإخفاق (Fail Over Destination)' : 'Fail Over Destination' %>
                                    </span>
                                    <span class="text-[10px] text-rose-400/70 font-mono">FAILOVER</span>
                                </div>
                                <div>
                                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'تحديد الوجهة عند عدم الرد أو انتهاء الوقت *' : 'Fail Over Destination *' %></span>
                                    <div id="queueDestComponentContainer"></div>
                                    <input type="hidden" id="queueDestination" required>
                                </div>
                            </div>

                            <!-- 2. Queue Continue Destination -->
                            <div class="rounded-xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-3">
                                <div class="flex items-center justify-between pb-2 border-b border-blue-500/15">
                                    <span class="text-xs font-black uppercase tracking-wider text-blue-400 flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                        <%= isRtl ? 'الوجهة عند مواصلة الطابور (Queue Continue Destination)' : 'Queue Continue Destination' %>
                                    </span>
                                    <span class="text-[10px] text-blue-400/70 font-mono">CONTINUE</span>
                                </div>
                                <div>
                                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'تحديد الوجهة عند خروج المتصل أو مواصلة الطابور *' : 'Queue Continue Destination *' %></span>
                                    <div id="queueContinueDestComponentContainer"></div>
                                    <input type="hidden" id="queueContinueDestination" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('queueModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ طابور الانتظار' : 'Save Queue' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL 3: TRUNK FORM -->
    <div id="trunkModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-4xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    <div>
                        <h3 id="trunkModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة خط ربط' : 'Add Trunk' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تكوين خطوط الربط المخصصة أو SIP أو IAX2 للمكالمات الخارجية والواردة' : 'Configure Custom, SIP, or IAX2 trunks for outbound and inbound VoIP calls' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('trunkModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="trunkForm" onsubmit="saveTrunk(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="trunkEditId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: IDENTITY & CORE TECH (Blue Theme) -->
                    <div class="rounded-xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-blue-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-blue-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                <%= isRtl ? 'هوية خط الربط والتقنية' : 'Identity & Core Technology' %>
                            </span>
                            <span class="text-[10px] text-blue-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkName"><%= isRtl ? 'اسم خط الربط *' : 'Trunk Name *' %></label>
                                <input type="text" id="trunkName" required placeholder="e.g. vodafone_trunk" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkTech"><%= isRtl ? 'تقنية خط الربط *' : 'Trunk Technology *' %></label>
                                <select id="trunkTech" onchange="onTrunkTechChange()" class="config-input w-full text-xs font-bold">
                                    <option value="custom"><%= isRtl ? 'خط مخصص (Custom / Dongle / Dahdi)' : 'Custom Trunk (Dongle / Local / Dahdi)' %></option>
                                    <option value="sip"><%= isRtl ? 'خط ربط SIP (chan_sip)' : 'SIP Trunk (chan_sip)' %></option>
                                    <option value="iax2"><%= isRtl ? 'خط ربط IAX2 (chan_iax2)' : 'IAX2 Trunk (chan_iax2)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkDisabled"><%= isRtl ? 'حالة الخط' : 'Trunk Status' %></label>
                                <select id="trunkDisabled" class="config-input w-full text-xs font-bold">
                                    <option value="off"><%= isRtl ? 'مفعل (Enabled)' : 'Enabled' %></option>
                                    <option value="on"><%= isRtl ? 'معطل (Disabled)' : 'Disabled' %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: OUTBOUND & CALLER ID (Amber Theme) -->
                    <div id="trunkCidSection" class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <%= isRtl ? 'إعدادات هوية المتصل والقنوات' : 'Outbound CID & Capacity Rules' %>
                            </span>
                            <span class="text-[10px] text-amber-400/70 font-mono"><%= isRtl ? 'توجيه' : 'ROUTING' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkOutcid"><%= isRtl ? 'رقم هوية المتصل الخارجي' : 'Outbound CallerID' %></label>
                                <input type="text" id="trunkOutcid" placeholder='e.g. "Vodafone" <01027826232>' class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkKeepCid"><%= isRtl ? 'خيارات هوية المتصل' : 'CID Options' %></label>
                                <select id="trunkKeepCid" class="config-input w-full text-xs">
                                    <option value="off"><%= isRtl ? 'السماح بأي هوية (Allow Any CID)' : 'Allow Any CID' %></option>
                                    <option value="on"><%= isRtl ? 'حظر الهويات الخارجية (Block Foreign CIDs)' : 'Block Foreign CIDs' %></option>
                                    <option value="cnum"><%= isRtl ? 'إزالة اسم المتصل (Remove CNAM)' : 'Remove CNAM' %></option>
                                    <option value="all"><%= isRtl ? 'فرض هوية الخط (Force Trunk CID)' : 'Force Trunk CID' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkMaxChans"><%= isRtl ? 'أقصى عدد قنوات' : 'Maximum Channels' %></label>
                                <input type="number" id="trunkMaxChans" min="0" placeholder="e.g. 10 (blank = unlimited)" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkDialPrefix"><%= isRtl ? 'بادئة الاتصال (Dial Prefix)' : 'Outbound Dial Prefix' %></label>
                                <input type="text" id="trunkDialPrefix" placeholder="e.g. 9" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkDialOpts"><%= isRtl ? 'خيارات الاتصال (Asterisk Dial Options)' : 'Asterisk Trunk Dial Options' %></label>
                                <input type="text" id="trunkDialOpts" placeholder="e.g. Ww" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkContinue"><%= isRtl ? 'متابعة عند الانشغال' : 'Continue if Busy' %></label>
                                <select id="trunkContinue" class="config-input w-full text-xs font-bold">
                                    <option value="off"><%= isRtl ? 'لا (No)' : 'No' %></option>
                                    <option value="on"><%= isRtl ? 'نعم (Yes)' : 'Yes' %></option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkFailScript"><%= isRtl ? 'سكربت مراقبة الأعطال (Monitor Failures)' : 'Monitor Trunk Failures Script' %></label>
                            <input type="text" id="trunkFailScript" placeholder="e.g. /usr/local/bin/failover.sh" class="config-input w-full font-mono text-xs">
                        </div>

                        <!-- Dialed Number Manipulation Rules Section -->
                        <div class="pt-3 border-t border-amber-500/15 space-y-2">
                            <div class="flex items-center justify-between">
                                <div>
                                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase"><%= isRtl ? 'قواعد تعديل أرقام الاتصال (Dialed Number Manipulation Rules)' : 'Dialed Number Manipulation Rules' %></span>
                                    <p class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'قواعد تعديل الأرقام قبل إرسالها إلى خط الربط (Prepend + Prefix | Match Pattern)' : 'Prepend, prefix, and match pattern rules applied to calls on this trunk' %></p>
                                </div>
                                <button type="button" onclick="addTrunkDialRuleRow()" class="px-2.5 py-1 text-[10px] font-bold text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 rounded-lg transition cursor-pointer">
                                    + <%= isRtl ? 'إضافة قاعدة' : 'Add Rule' %>
                                </button>
                            </div>
                            <div id="trunkDialRulesContainer" class="space-y-2">
                                <!-- Populated dynamically by renderTrunkDialRules() -->
                            </div>
                        </div>
                    </div>

                    <!-- CUSTOM TRUNK SECTION -->
                    <div id="trunkCustomFields" class="relative rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'إعدادات الاتصال المخصص (Custom Dial String)' : 'Custom Connection Settings' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono">CUSTOM</span>
                        </div>
                        <div>
                            <label for="trunkDialString" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'سلسلة الاتصال المخصصة *' : 'Custom Dial String *' %></label>
                            <input type="text" id="trunkDialString" placeholder="e.g. dongle/dongle0/$OUTNUM$" class="config-input w-full font-mono text-xs" autocomplete="off">
                            
                            <!-- DONGLE FLOATING POPUP -->
                            <div id="dongleInfoPopup" class="fixed bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-xl p-4 z-[999999] hidden space-y-2">
                                <div class="text-[11px] font-bold text-[var(--text-secondary)] uppercase flex items-center justify-between">
                                    <span><%= isRtl ? 'أجهزة Dongle المتصلة:' : 'Connected Dongles:' %></span>
                                    <button type="button" onclick="loadDongleInfoPopup()" class="text-[10px] text-blue-400 hover:underline">Refresh</button>
                                </div>
                                <div id="dongleInfoList" class="text-xs space-y-1.5 max-h-[160px] overflow-y-auto pr-1">
                                    <span class="text-[11px] text-[var(--text-muted)]">Loading...</span>
                                </div>
                            </div>

                            <p class="text-[11px] text-[var(--text-muted)] mt-1.5 font-mono">
                                Format: <code>dongle/dongle0/$OUTNUM$</code> or <code>dongle/i:359767037813558/$OUTNUM$</code>
                            </p>
                        </div>
                    </div>

                    <!-- SIP / IAX2 TRUNK SECTION -->
                    <div id="trunkSipIaxFields" class="hidden space-y-5">
                        
                        <!-- SECTION 3: OUTGOING PEER SETTINGS (Emerald Theme) -->
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <%= isRtl ? 'إعدادات الاتصال الخارجي (Outgoing PEER Details)' : 'Outgoing Connection & PEER Details' %>
                                </span>
                                <span class="text-[10px] text-emerald-400/70 font-mono">PEER</span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkChannelId"><%= isRtl ? 'اسم خط الربط الصادر *' : 'Outgoing Trunk Name *' %></label>
                                    <input type="text" id="trunkChannelId" placeholder="e.g. issabel_provider" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkHost"><%= isRtl ? 'عنوان الخادم البعيد *' : 'Remote Host (IP / Domain) *' %></label>
                                    <input type="text" id="trunkHost" placeholder="e.g. 192.168.100.50" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkContext"><%= isRtl ? 'سياق الخروج (Context) *' : 'Context *' %></label>
                                    <input type="text" id="trunkContext" placeholder="from-trunk" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkUsername"><%= isRtl ? 'اسم المستخدم' : 'Username' %></label>
                                    <input type="text" id="trunkUsername" placeholder="e.g. 01027826232" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkSecret"><%= isRtl ? 'كلمة السر (Secret)' : 'Secret / Password' %></label>
                                    <input type="password" id="trunkSecret" autocomplete="current-password" placeholder="••••••••" class="config-input w-full font-mono text-xs">
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label for="trunkPeerDetails" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase"><%= isRtl ? 'تفاصيل الخروج (PEER Details)' : 'Outgoing Settings (PEER Details)' %></label>
                                    <span class="text-[10px] font-mono text-emerald-400">key=value</span>
                                </div>
                                <textarea id="trunkPeerDetails" rows="4" placeholder="host=192.168.100.50&#10;username=user&#10;secret=pass&#10;type=peer&#10;context=from-trunk&#10;insecure=port,invite&#10;qualify=yes" class="config-input w-full font-mono text-xs py-2 px-3 leading-relaxed resize-y bg-black/40 border-emerald-500/20 focus:border-emerald-500"></textarea>
                            </div>
                        </div>

                        <!-- SECTION 4: INCOMING USER SETTINGS & REGISTRATION (Purple Theme) -->
                        <div class="rounded-xl border border-purple-500/20 bg-purple-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-purple-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-purple-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                                    <%= isRtl ? 'إعدادات الدخول والتسجيل (Incoming USER & Register)' : 'Incoming User Context & Registration' %>
                                </span>
                                <span class="text-[10px] text-purple-400/70 font-mono">USER & REG</span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                <div>
                                    <label for="trunkUserContext" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'سياق المستخدم الوارد' : 'User Context (Incoming)' %></label>
                                    <input type="text" id="trunkUserContext" placeholder="e.g. from-trunk" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkRegister"><%= isRtl ? 'نص التسجيل (Register String)' : 'Register String' %></label>
                                    <input type="text" id="trunkRegister" placeholder="e.g. user:secret@host" class="config-input w-full font-mono text-xs">
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label for="trunkUserDetails" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase"><%= isRtl ? 'تفاصيل الدخول (USER Details)' : 'Incoming Settings (USER Details)' %></label>
                                    <span class="text-[10px] font-mono text-purple-400">key=value</span>
                                </div>
                                <textarea id="trunkUserDetails" rows="3" placeholder="secret=pass&#10;type=user&#10;context=from-trunk" class="config-input w-full font-mono text-xs py-2 px-3 leading-relaxed resize-y bg-black/40 border-purple-500/20 focus:border-purple-500"></textarea>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('trunkModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ خط الربط' : 'Save Trunk' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL IVR: IVR FORM -->
    <div id="ivrModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    </div>
                    <div>
                        <h3 id="ivrModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة قائمة رد آلي' : 'Add IVR Menu' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تكوين قائمة الرد الآلي التفاعلية وخيارات الضغط والأخطاء' : 'Configure interactive voice response menu, keypress options, and failovers' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('ivrModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="ivrForm" onsubmit="saveIvr(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="ivrEditId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: IVR IDENTITY & GREETING (Purple Theme) -->
                    <div class="rounded-xl border border-purple-500/20 bg-purple-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-purple-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-purple-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                                <%= isRtl ? 'هوية قائمة الرد الآلي والترحيب' : 'IVR Menu Definition & Greeting' %>
                            </span>
                            <span class="text-[10px] text-purple-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label for="ivrName" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اسم القائمة *' : 'IVR Name *' %></label>
                                <input type="text" id="ivrName" required placeholder="e.g. Main_IVR" class="config-input w-full text-xs font-mono">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ivrDescription"><%= isRtl ? 'الوصف' : 'Description' %></label>
                                <input type="text" id="ivrDescription" placeholder="e.g. Main Company IVR Menu" class="config-input w-full text-xs">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ivrAnnouncement"><%= isRtl ? 'الرسالة الصوتية (Announcement)' : 'Announcement Greeting' %></label>
                                <select id="ivrAnnouncement" class="config-input w-full text-xs font-semibold">
                                    <option value="0">None / Default</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ivrDirectDial"><%= isRtl ? 'الطلب المباشر للأرقام الفرعية' : 'Direct Dial' %></label>
                                <select id="ivrDirectDial" class="config-input w-full text-xs font-semibold">
                                    <option value="disabled"><%= isRtl ? 'معطل (Disabled)' : 'Disabled' %></option>
                                    <option value="ext-local,vmu,1"><%= isRtl ? 'مفعل للهواتف الفرعية (Extensions)' : 'Extensions' %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: TIMEOUT & INVALID FAILOVERS (Amber & Rose Split Theme) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Timeout Section (Amber) -->
                        <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                    <%= isRtl ? 'مهلة الانتظار (Timeout)' : 'Timeout Settings' %>
                                </span>
                                <span class="text-[10px] text-amber-400/70 font-mono">TIMEOUT</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1" for="ivrTimeoutTime"><%= isRtl ? 'المهلة (ثواني)' : 'Timeout (sec)' %></label>
                                    <input type="number" id="ivrTimeoutTime" value="10" min="1" max="60" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1" for="ivrTimeoutLoops"><%= isRtl ? 'المحاولات' : 'Retries' %></label>
                                    <input type="number" id="ivrTimeoutLoops" value="3" min="0" max="10" class="config-input w-full font-mono text-xs">
                                </div>
                            </div>
                            <div>
                                <span class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'وجهة انتهاء المهلة' : 'Timeout Destination' %></span>
                                <div id="ivrTimeoutDestComponentContainer"></div>
                                <input type="hidden" id="ivrTimeoutDestination" value="app-blackhole,hangup,1">
                            </div>
                        </div>

                        <!-- Invalid Section (Rose) -->
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                    <%= isRtl ? 'الإدخال الخاطئ (Invalid)' : 'Invalid Input Settings' %>
                                </span>
                                <span class="text-[10px] text-rose-400/70 font-mono">INVALID</span>
                            </div>
                            <div>

                            </div>
                        </div>
                        <div class="mt-2 text-[10px] text-gray-300 font-semibold space-y-0.5 bg-[#16161c] p-1.5 rounded border border-white/5 font-mono">
                            <div class="flex justify-between"><span>DID:</span> <span class="text-white">${route.did || (isRtl ? 'أي رقم' : 'Any')}</span></div>
                            <div class="flex justify-between"><span>MOH:</span> <span class="text-white">${route.mohclass || 'default'}</span></div>
                            <div class="flex justify-between"><span>Dest:</span> <span class="text-emerald-400 truncate max-w-[170px]">${formatDestination(route.destination)}</span></div>
                        </div>
                    `;
                } else if (node.type === 'ringgroup') {
                    const rg = node.data;
                    const membersCount = rg.grplist ? rg.grplist.split('-').length : 0;
                    
                    cardBodyHTML = `

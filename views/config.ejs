                        <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 shrink-0">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div>
                            <%
                            const fedLocalSite = (typeof federationSettings !== 'undefined' && federationSettings.local_site_code) ? federationSettings.local_site_code : '10';
                            const fedLocalName = (typeof federationSettings !== 'undefined' && federationSettings.local_node_name) ? federationSettings.local_node_name : 'Main PBX';
                            const fedLocalRole = (typeof federationSettings !== 'undefined' && federationSettings.panel_role) ? federationSettings.panel_role : 'local';
                            %>
                            <div class="flex items-center gap-2.5 flex-wrap">
                                <h2 class="text-lg font-black text-[var(--text-primary)] tracking-tight">
                                    <%= isRtl ? 'الربط السحابي بين السيرفرات (IAX2 PBX Federation)' : 'Multi-Server PBX Federation (IAX2)' %>
                                </h2>
                                <span id="fedLocalSiteBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-amber-500/20 text-amber-400 border border-amber-500/30">
                                    Site <%= fedLocalSite %>
                                </span>
                                <span id="fedLocalRoleBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold <%= fedLocalRole === 'central' ? 'bg-purple-500/20 text-purple-400 border border-purple-500/30' : 'bg-blue-500/20 text-blue-400 border border-blue-500/30' %>">
                                    <%= fedLocalRole === 'central' ? (isRtl ? 'لوحة مركزية موحدة' : 'Central Live Panel') : (isRtl ? 'سيرفر محلي' : 'Local PBX') %>
                                </span>
                            </div>
                            <p class="text-xs text-[var(--text-muted)] mt-1">
                                <%= isRtl ? 'ربط موحد بين سيرفرات أستيركس عبر بروتوكول IAX2 مع اتصال داخلي مباشر بالبادئة، ومشاركة خطوط GSM ومجموعات الرنين واللوحة الموحدة.' : 'Seamless inter-server VoIP federation over IAX2 with prefix site codes, shared GSM dongle egress, unified queues/ring groups, and central operator live panel.' %>
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 shrink-0 flex-wrap">
                        <button type="button" onclick="openFederationSettingsModal()" class="config-btn-secondary px-4 py-2.5 flex items-center gap-2 text-xs cursor-pointer">
                            <svg class="w-4 h-4 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span><%= isRtl ? 'إعدادات هذا السيرفر' : 'Local PBX Settings' %></span>
                        </button>
                        <button type="button" onclick="openConnectPbxModal()" class="config-btn-primary px-4 py-2.5 flex items-center gap-2 text-xs cursor-pointer shadow-lg shadow-amber-500/10">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <span class="font-extrabold"><%= isRtl ? 'ربط سيرفر جديد (1-Click)' : 'Connect New PBX' %></span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- 2. Connected Peers Table Card -->
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 border-b border-[var(--border-primary)] pb-4">
                    <div>
                        <h3 class="text-base font-extrabold text-[var(--text-primary)]">
                            <%= isRtl ? 'السيرفرات المرتبطة المتصلة' : 'Connected PBX Nodes' %>
                        </h3>
                        <p class="text-xs text-[var(--text-muted)]">
                            <%= isRtl ? 'قائمة السيرفرات المتصلة عبر نفق IAX2 المشفر مع حالة الاتصال والتحويلات والخطوط' : 'Active Asterisk peer nodes connected via encrypted IAX2 link with live status and synced entities' %>
                        </p>
                    </div>
                    <button type="button" onclick="fetchFederationPeers()" class="px-3 py-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center gap-1.5 transition">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span><%= isRtl ? 'تحديث الحالة' : 'Refresh' %></span>
                    </button>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="border-b border-[var(--border-primary)] text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider">
                                <th class="py-3 px-4"><%= isRtl ? 'السيرفر' : 'Node / PBX' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'كود الموقع (Site Code)' : 'Site Code' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'العنوان / IP' : 'Host / IP' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الحالة (Latency)' : 'Status' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'التحويلات المرتبطة' : 'Remote Extensions' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'خطوط GSM المشاركة' : 'Shared GSM' %></th>
                                <th class="py-3 px-4 text-center"><%= isRtl ? 'إجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="federationPeersTableBody" class="divide-y divide-[var(--border-primary)] text-xs text-[var(--text-primary)]">
                            <tr>
                                <td colspan="7" class="py-8 text-center text-xs text-[var(--text-muted)]">
                                    <%= isRtl ? 'جاري تحميل السيرفرات المرتبطة...' : 'Loading connected PBX nodes...' %>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Synced Remote Extensions Grid -->
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h3 class="text-base font-extrabold text-[var(--text-primary)]">
                            <%= isRtl ? 'دليل التحويلات البعيدة (Remote Extensions Directory)' : 'Remote Extensions Directory' %>
                        </h3>
                        <p class="text-xs text-[var(--text-muted)]">
                            <%= isRtl ? 'التحويلات المتاحة للاتصال المباشر عبر بادئة كود الموقع (مثل 20101 للاتصال بتحويلة 101 في الموقع 20)' : 'Remote extensions reachable via site code prefix dialing (e.g. dial 20101 to reach ext 101 on Site 20)' %>
                        </p>
                    </div>
                    <div class="relative w-full sm:w-64">
                        <input type="text" id="fedRemoteExtSearchInput" oninput="filterRemoteExtensionsDirectory()" placeholder="<%= isRtl ? 'بحث في التحويلات البعيدة...' : 'Search remote extensions...' %>" class="config-input w-full pl-9 pr-3 py-2 text-xs rounded-xl">
                        <svg class="w-4 h-4 text-[var(--text-muted)] absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>

                <div id="fedRemoteExtensionsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
                    <div class="col-span-full py-8 text-center text-xs text-[var(--text-muted)]">
                        <%= isRtl ? 'لا توجد تحويلات بعيدة مسجلة حتى الآن.' : 'No remote extensions registered yet.' %>
                    </div>
                </div>
            </div>
        </div>

        <!-- 17. IP SCAN TAB SECTION (Local Network Device & Port Discovery) -->
        <% if (isTabAllowed('ipscan')) { %>
        <div id="section-ipscan" class="tab-section hidden space-y-6">
            <!-- Header & Control Bar -->
            <div class="config-card p-6 flex flex-col space-y-4">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-[var(--border-primary)] pb-4">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                            <span class="w-8 h-8 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                            </span>
                            <span><%= isRtl ? 'فحص الشبكة المحلية والأجهزة (IP & Port Scanner)' : 'Local Network Device & Port Scanner' %></span>
                        </h2>
                        <p class="text-xs text-[var(--text-muted)] mt-1">
                            <%= isRtl ? 'فحص أجهزة وهواتف السنترال (Grandstream / Yealink / Cisco) والمنافذ المفتوحة عبر nmap للشبكة الفيزيائية المحلية فقط (مستبعد منها شبكات VPN كلياً)' : 'Fast nmap discovery of live VoIP endpoints, hardware vendors, and open ports strictly on physical local LAN (all VPNs excluded)' %>
                        </p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <button type="button" onclick="exportIpscanCsv()" id="btn-ipscan-export" class="config-btn-secondary px-3 py-1.5 flex items-center gap-1.5 text-xs font-bold rounded-lg cursor-pointer transition">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            <span><%= isRtl ? 'تصدير CSV' : 'Export CSV' %></span>
                        </button>
                        <button type="button" onclick="stopIpScan()" id="btn-ipscan-stop" class="hidden px-3.5 py-1.5 rounded-lg bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/30 text-rose-300 text-xs font-bold transition flex items-center gap-1.5 cursor-pointer shadow-sm">
                            <svg class="w-3.5 h-3.5 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
                            <span><%= isRtl ? 'إيقاف الفحص' : 'Stop Scan' %></span>
                        </button>
                        <button type="button" onclick="startIpScan()" id="btn-ipscan-start" class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-700 font-extrabold text-xs transition flex items-center gap-2 cursor-pointer shadow-md">
                            <svg id="icon-ipscan-radar" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                            <span id="btn-ipscan-start-text"><%= isRtl ? 'بدء فحص الشبكة' : 'Start Network Scan' %></span>
                        </button>
                    </div>
                </div>

                <!-- Parameters Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                    <!-- 1. Physical Local Interface & Subnet -->
                    <div class="flex flex-col gap-1">
                        <label for="ipscan-iface-select" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                            <span><%= isRtl ? 'كارت الشبكة والمدى (Local LAN)' : 'Local LAN Interface' %></span>
                        </label>
                        <select id="ipscan-iface-select" onchange="onIpscanIfaceChange()" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-cyan-500">
                            <option value="">Loading local subnets...</option>
                        </select>
                    </div>

                    <!-- 2. Scan Profile -->
                    <div class="flex flex-col gap-1">
                        <label for="ipscan-profile-select" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
                            <span><%= isRtl ? 'نوع الفحص (Profile)' : 'Scan Profile' %></span>
                        </label>
                        <select id="ipscan-profile-select" onchange="onIpscanProfileChange()" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-cyan-500">
                            <option value="voip"><%= isRtl ? 'فحص هواتف ومنافذ السنترال (VoIP & Web: 5060, 80, 443, 22)' : 'VoIP & Management (5060, 80, 443, 22)' %></option>
                            <option value="quick"><%= isRtl ? 'اكتشاف سريع للأجهزة الحية (ARP / Ping Scan - ثواني)' : 'Fast Host Discovery (ARP Ping only - 2s)' %></option>
                            <option value="ports"><%= isRtl ? 'فحص شامل لأشهر 100 منفذ (Top 100 Ports)' : 'Top 100 Ports Scan' %></option>
                            <option value="custom"><%= isRtl ? 'منافذ مخصصة (Custom Ports)' : 'Custom Ports...' %></option>
                        </select>
                    </div>

                    <!-- 3. Target Range Input -->
                    <div class="flex flex-col gap-1">
                        <label for="ipscan-target-input" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="22" y1="12" x2="18" y2="12"/><line x1="6" y1="12" x2="2" y2="12"/><line x1="12" y1="6" x2="12" y2="2"/><line x1="12" y1="22" x2="12" y2="18"/></svg>
                            <span><%= isRtl ? 'المدى المستهدف (Target CIDR / IP)' : 'Target Subnet or IP' %></span>
                        </label>
                        <input type="text" id="ipscan-target-input" placeholder="e.g. 192.168.100.0/24 or 192.168.100.1-50" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-3 py-1.5 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-cyan-500">
                    </div>

                    <!-- 4. Custom Ports Input (conditionally visible) -->
                    <div id="ipscan-custom-ports-wrap" class="hidden flex flex-col gap-1">
                        <label for="ipscan-custom-ports" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                            <%= isRtl ? 'المنافذ المخصصة' : 'Custom Ports' %>
                        </label>
                        <input type="text" id="ipscan-custom-ports" placeholder="e.g. 5060,80,443,8080" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-3 py-1.5 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-cyan-500">
                    </div>
                </div>

                <!-- VPN Safe Guarantee Notice Strip -->
                <div class="flex items-center justify-between text-[11px] bg-[var(--bg-primary)]/60 px-3.5 py-2 rounded-lg border border-[var(--border-primary)] text-[var(--text-muted)] flex-wrap gap-2">
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span class="font-bold text-[var(--text-secondary)]"><%= isRtl ? 'حماية العزل الصارم:' : 'Strict Network Isolation:' %></span>
                        <span><%= isRtl ? 'شبكات VPN والأنفاق (Tailscale / ZeroTier) وشبكات Docker الافتراضية معزولة ومستبعدة برمجياً.' : 'VPN tunnels (Tailscale / ZeroTier) and container bridges are strictly blocked from scan.' %></span>
                    </div>
                    <span id="ipscan-timer-badge" class="font-mono text-cyan-400 font-bold">Idle</span>
                </div>
            </div>

            <!-- KPI Cards Strip -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
                <div class="config-card p-4 flex flex-col justify-between">
                    <span class="text-[10px] font-bold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'الأجهزة المتصلة (Live Hosts)' : 'Live Hosts' %></span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span id="ipscan-kpi-hosts" class="text-2xl font-black font-mono text-cyan-400">0</span>
                    </div>
                </div>
                <div class="config-card p-4 flex flex-col justify-between">
                    <span class="text-[10px] font-bold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'هواتف السنترال (VoIP Endpoints)' : 'VoIP Devices' %></span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span id="ipscan-kpi-voip" class="text-2xl font-black font-mono text-purple-400">0</span>
                    </div>
                </div>
                <div class="config-card p-4 flex flex-col justify-between">
                    <span class="text-[10px] font-bold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'المنافذ المفتوحة (Open Ports)' : 'Open Ports' %></span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span id="ipscan-kpi-ports" class="text-2xl font-black font-mono text-emerald-400">0</span>
                    </div>
                </div>
                <div class="config-card p-4 flex flex-col justify-between">
                    <span class="text-[10px] font-bold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'مدة الفحص' : 'Scan Duration' %></span>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span id="ipscan-kpi-duration" class="text-2xl font-black font-mono text-[var(--text-primary)]">0s</span>
                    </div>
                </div>
            </div>

            <!-- Results Table Card -->
            <div class="config-card p-6 space-y-4">
                <!-- Search & Filter Controls -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="relative w-full sm:w-80">
                        <input type="text" id="ipscan-search-input" oninput="filterIpscanResults()" placeholder="<%= isRtl ? 'بحث بـ IP أو اسم الجهاز أو الشركة أو المنفذ...' : 'Search by IP, vendor, hostname, port...' %>" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl pl-9 pr-3 py-2 text-xs text-[var(--text-primary)] w-full focus:outline-none focus:border-cyan-500">
                        <svg class="w-4 h-4 text-[var(--text-muted)] absolute left-3 top-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>

                    <!-- Filter Chips -->
                    <div class="flex items-center gap-1.5 flex-wrap text-xs">
                        <button type="button" onclick="setIpscanChipFilter('all')" data-chip="all" class="ipscan-chip-btn px-3 py-1.5 rounded-lg font-bold border transition bg-cyan-600 border-cyan-500">
                            <%= isRtl ? 'الكل' : 'All Devices' %>
                        </button>
                        <button type="button" onclick="setIpscanChipFilter('voip')" data-chip="voip" class="ipscan-chip-btn px-3 py-1.5 rounded-lg font-bold border transition bg-[var(--bg-primary)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-purple-500/50">
                            <%= isRtl ? 'هواتف VoIP فقط' : 'VoIP Phones' %>
                        </button>
                        <button type="button" onclick="setIpscanChipFilter('web')" data-chip="web" class="ipscan-chip-btn px-3 py-1.5 rounded-lg font-bold border transition bg-[var(--bg-primary)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-cyan-500/50">
                            <%= isRtl ? 'واجهة ويب (80/443)' : 'Web UI (80/443)' %>
                        </button>
                        <button type="button" onclick="setIpscanChipFilter('ssh')" data-chip="ssh" class="ipscan-chip-btn px-3 py-1.5 rounded-lg font-bold border transition bg-[var(--bg-primary)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-amber-500/50">
                            <%= isRtl ? 'منفذ SSH (22)' : 'SSH (22)' %>
                        </button>
                    </div>
                </div>

                <!-- Results Table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-[var(--border-primary)] text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider bg-[var(--bg-primary)]/40">
                                <th class="py-3 px-3.5"><%= isRtl ? 'الحالة' : 'Status' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'عنوان IP' : 'IP Address' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'الشركة المصنعة / الموديل' : 'Vendor / Hardware' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'اسم المضيف (Hostname)' : 'Hostname' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'خادم الويب (HTTP / Web Title)' : 'Web Server / HTTP Title' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'عنوان MAC' : 'MAC Address' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'زمن الاستجابة' : 'Latency' %></th>
                                <th class="py-3 px-3.5"><%= isRtl ? 'المنافذ والخدمات المفتوحة' : 'Open Ports & Services' %></th>
                                <th class="py-3 px-3.5 text-center"><%= isRtl ? 'إجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="ipscan-table-body" class="divide-y divide-[var(--border-primary)] text-[var(--text-primary)]">
                            <tr>
                                <td colspan="9" class="py-10 text-center text-xs text-[var(--text-muted)]">
                                    <%= isRtl ? 'اضغط على "بدء فحص الشبكة" لبدء اكتشاف الأجهزة والمنافذ المفتوحة في الشبكة المحلية.' : 'Click "Start Network Scan" above to discover active devices and open ports on your local LAN.' %>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <% } %>
    </div>

    <!-- MODAL 1: EXTENSION FORM -->
    <div id="extensionModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    </div>
                    <div>
                        <h3 id="extModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة تحويلة' : 'Add Extension' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تكوين بيانات التحويلة والتقنية وملف الموظف' : 'Configure extension credentials, device technology, and employee profile' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('extensionModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="extensionForm" onsubmit="saveExtension(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="extEditMode" value="false">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: EXTENSION CREDENTIALS & TECH (Cyan Theme) -->
                    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-cyan-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'بيانات التحويلة والجهاز' : 'Extension Credentials & Device' %>
                            </span>
                            <span class="text-[10px] text-cyan-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extNum"><%= isRtl ? 'رقم التحويلة *' : 'User Extension ID *' %></label>
                                <input type="text" id="extNum" required placeholder="e.g. 105" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extName"><%= isRtl ? 'الاسم الظاهر *' : 'Display Name *' %></label>
                                <input type="text" id="extName" required placeholder="e.g. Sales Desk 1" class="config-input w-full text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extSecret"><%= isRtl ? 'كلمة السر *' : 'Secret (Password) *' %></label>
                                <input type="text" id="extSecret" autocomplete="new-password" required placeholder="e.g. P@ssword123!" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extTech"><%= isRtl ? 'نوع جهاز التحويلة *' : 'Extension Tech / Device Type *' %></label>
                                <select id="extTech" class="config-input w-full text-xs font-semibold">
                                    <option value="sip" selected><%= isRtl ? 'هاتف شبكة اعتيادي (Generic SIP Device - UDP / Port 5060)' : 'Generic SIP Device (Hardware / Port 5060)' %></option>
                                    <option value="webrtc"><%= isRtl ? 'هاتف WebRTC (موبايل / متصفح - WS 8088 أو WSS 8089)' : 'WebRTC Softphone (Mobile / Browser - WS 8088, WSS 8089)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extVoicemail"><%= isRtl ? 'البريد الصوتي' : 'Voicemail Option' %></label>
                                <select id="extVoicemail" class="config-input w-full text-xs font-semibold">
                                    <option value="disabled"><%= isRtl ? 'معطل (Disabled / No Voicemail)' : 'Disabled (No Voicemail)' %></option>
                                    <option value="enabled"><%= isRtl ? 'مفعل (Enabled / Active)' : 'Enabled (Voicemail Active)' %></option>
                                </select>
                            </div>
                        </div>

                        <!-- Audio DSP & AI Noise Suppression Controls Sub-Card -->
                        <div class="mt-3.5 pt-3.5 border-t border-cyan-500/20">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-xs font-extrabold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5">
                                    <svg class="w-4 h-4 text-cyan-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/></svg>
                                    <%= isRtl ? 'معالجة الصوت وعزل الضوضاء بالذكاء الاصطناعي (Audio DSP & RNNoise)' : 'AI Voice Processing & Audio DSP' %>
                                </span>
                                <span class="text-[10px] text-cyan-300 font-semibold bg-cyan-500/10 border border-cyan-500/20 px-2 py-0.5 rounded">
                                    <%= isRtl ? 'فلتر حي مخصص للتحويلة' : 'Real-time Per-Extension Filter' %>
                                </span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extDenoise">
                                        <%= isRtl ? 'عزل الضوضاء (AI RNNoise)' : 'AI Noise Suppression (RNNoise)' %>
                                    </label>
                                    <select id="extDenoise" class="config-input w-full text-xs font-semibold h-[38px]">
                                        <option value="both" selected><%= isRtl ? 'مفعل (إرسال واستقبال - Both RX & TX)' : 'Enabled (Both RX & TX)' %></option>
                                        <option value="rx"><%= isRtl ? 'مفعل للميكروفون فقط (RX Only)' : 'Microphone Only (RX Only)' %></option>
                                        <option value="tx"><%= isRtl ? 'مفعل للسماعة فقط (TX Only)' : 'Speaker Only (TX Only)' %></option>
                                        <option value="off"><%= isRtl ? 'معطل (Disabled / Off)' : 'Disabled (Off)' %></option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extVadGate">
                                        <%= isRtl ? 'بوابة كتم الصمت (VAD Silence Gate)' : 'VAD Silence Gate (100% Silence on Pauses)' %>
                                    </label>
                                    <select id="extVadGate" class="config-input w-full text-xs font-semibold h-[38px]">
                                        <option value="1" selected><%= isRtl ? 'مفعل (صمت 100% عند التوقف عن الكلام)' : 'Enabled (100% Silence on Pauses)' %></option>
                                        <option value="0"><%= isRtl ? 'معطل (عزل مستمر دون كتم)' : 'Disabled (Continuous Filter)' %></option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extVadDb">
                                        <%= isRtl ? 'عتبة كتم الديسيبل (dB Cutoff Gate)' : 'Decibel Cutoff (dBFS Noise Gate)' %>
                                    </label>
                                    <select id="extVadDb" class="config-input w-full text-xs font-semibold h-[38px]">
                                        <option value="off" selected><%= isRtl ? 'تلقائي / عصبي فقط (Auto / Neural Only)' : 'Auto / Neural Only (Default)' %></option>
                                        <option value="-55">-55 dBFS (<%= isRtl ? 'هادئ جداً' : 'Very Soft Noise' %>)</option>
                                        <option value="-50">-50 dBFS (<%= isRtl ? 'خافت / متوازن' : 'Soft / Balanced' %>)</option>
                                        <option value="-45">-45 dBFS (<%= isRtl ? 'متوسط / مكتب هادئ' : 'Moderate / Quiet Office' %>)</option>
                                        <option value="-42">-42 dBFS (<%= isRtl ? 'عالي / مكتب نشط' : 'High / Busy Office' %>)</option>
                                        <option value="-38">-38 dBFS (<%= isRtl ? 'صارم / ضوضاء قوية' : 'Strict / Heavy Noise' %>)</option>
                                        <option value="-35">-35 dBFS (<%= isRtl ? 'عدواني / ضوضاء شديدة' : 'Aggressive / Loud Noise' %>)</option>
                                        <option value="-30">-30 dBFS (<%= isRtl ? 'أقصى كتم / أصوات عالية' : 'Maximum / Extreme Noise' %>)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extAgc">
                                        <%= isRtl ? 'تطبيع الصوت التلقائي (Speex AGC)' : 'Auto Gain Control (Speex AGC)' %>
                                    </label>
                                    <select id="extAgc" class="config-input w-full text-xs font-semibold h-[38px]">
                                        <option value="8000" selected><%= isRtl ? 'مفعل (8000 - متوازن / قياسي)' : 'Enabled (8000 - Balanced)' %></option>
                                        <option value="6000"><%= isRtl ? 'مفعل (6000 - هادئ / خافت)' : 'Enabled (6000 - Gentle / Soft)' %></option>
                                        <option value="10000"><%= isRtl ? 'مفعل (10000 - مرتفع)' : 'Enabled (10000 - Loud)' %></option>
                                        <option value="12000"><%= isRtl ? 'مفعل (12000 - أقصى تضخيم)' : 'Enabled (12000 - Boosted)' %></option>
                                        <option value="off"><%= isRtl ? 'معطل (Disabled / Off)' : 'Disabled (Off)' %></option>
                                    </select>
                                </div>
                            </div>
                        </div>


                    </div>

                    <!-- SECTION 2: EMPLOYEE PROFILE (Emerald Theme) -->
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'ملف الموظف' : 'Employee Profile' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono"><%= isRtl ? 'اختياري' : 'OPTIONAL' %></span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 w-full">
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extTitle"><%= isRtl ? 'المسمى الوظيفي' : 'Job title' %></label>
                                    <input type="text" id="extTitle" maxlength="255" placeholder="<%= isRtl ? 'مثال: مدير المبيعات' : 'e.g. Sales Manager' %>" class="config-input w-full text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="extGroup"><%= isRtl ? 'مجموعة الموظفين' : 'Employee group' %></label>
                                    <select id="extGroup" class="config-input w-full text-xs font-semibold" disabled>
                                        <option value=""><%= isRtl ? 'جاري تحميل المجموعات...' : 'Loading groups...' %></option>
                                    </select>
                                    <p class="mt-1 text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'تُدار المجموعات من لوحة المراقبة المباشرة' : 'Groups are managed from the Live Panel' %></p>
                                </div>
                                <div class="sm:col-span-2 pt-1">
                                    <label class="flex items-center gap-2.5 p-2.5 rounded-xl border border-emerald-500/20 bg-black/20 <%= canManageGroupAdmin ? 'hover:bg-black/30 cursor-pointer' : 'opacity-60 cursor-not-allowed' %> text-xs">
                                        <input type="checkbox" id="extIsGroupAdmin" class="tab-checkbox" <%= canManageGroupAdmin ? '' : 'disabled' %>>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between">
                                                <span class="font-bold text-white flex items-center gap-1.5">
                                                    <svg class="w-3.5 h-3.5 text-amber-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
                                                    <span><%= isRtl ? 'مدير المجموعة (Group Admin)' : 'Group Admin (Call Pickup Authority)' %></span>
                                                </span>
                                                <% if (!canManageGroupAdmin) { %>
                                                    <span class="text-[9px] font-extrabold px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/40 uppercase">
                                                        <%= isRtl ? 'مدراء النظام فقط' : 'Super Admin Only' %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] text-[var(--text-muted)] mt-0.5">
                                                <%= isRtl ? 'عند التفعيل، يحصل هذا الموظف وحده على صلاحية التقاط مكالمات أعضاء مجموعته (*) — صلاحية خاصة بمدراء النظام' : 'When enabled, only this extension has authority to pick up ringing calls from its group members (*) — Super Admin permission required' %>
                                            </p>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        </div>

                    <!-- System Defaults Information Banner -->
                    <div class="p-3.5 bg-cyan-500/5 border border-cyan-500/20 rounded-xl text-xs space-y-1.5">
                        <div class="font-bold text-cyan-400 flex items-center gap-2 text-xs uppercase tracking-wider">
                            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span><%= isRtl ? 'الإعدادات التلقائية المطبقة للنظام:' : 'Automatic System Extension Defaults:' %></span>
                        </div>
                        <ul class="text-[var(--text-muted)] list-disc list-inside text-[11px] space-y-0.5 font-medium">
                            <li><strong>Device Port:</strong> 8088 (WebRTC / WS, default) or 8089 (WSS); 5060 (SIP / UDP)</li>
                            <li><strong>NAT Setting:</strong> Enabled (nat = yes)</li>
                            <li><strong>Call Recording:</strong> ALWAYS (Inbound/Outbound Internal & External)</li>
                        </ul>
                    </div>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('extensionModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button id="extSaveBtn" type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span id="extSaveBtnText"><%= isRtl ? 'حفظ التحويلة' : 'Save Extension' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL: WEBRTC CREDENTIALS DISPLAY -->
    <div id="webrtcCredentialsModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[99999] flex items-center justify-center hidden p-4">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full p-6 text-[var(--text-primary)]">
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-[var(--border-primary)]">
                <h3 class="text-base font-extrabold text-purple-400 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    <span><%= isRtl ? 'بيانات اتصال هاتف WebRTC' : 'WebRTC Softphone Credentials' %></span>
                </h3>
                <button type="button" onclick="closeModal('webrtcCredentialsModal')" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer">✕</button>
            </div>
            <p class="text-xs text-[var(--text-muted)] mb-4">
                <%= isRtl ? 'تم إنشاء تحويلة WebRTC بنجاح. يمكنك استخدام هذه البيانات لتسجيل الدخول في هاتف المتصفح.' : 'WebRTC softphone extension created successfully. Use these details to configure your WebRTC device.' %>
            </p>
            <div class="space-y-2 bg-[var(--bg-card)] p-4 rounded-xl border border-[var(--border-primary)] text-xs font-mono">
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">Extension:</span><span id="credExt" class="font-bold text-white"></span></div>
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">Name:</span><span id="credName" class="font-bold text-white"></span></div>
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">Secret (Password):</span><span id="credSecret" class="font-bold text-amber-400"></span></div>
                <div class="flex justify-between"><span class="text-[var(--text-muted)]">WebSocket Server:</span><span id="credWsUrl" class="font-bold text-purple-400"></span></div>
            </div>
            <div class="flex justify-end mt-5">
                <button type="button" onclick="closeModal('webrtcCredentialsModal')" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'تم' : 'Done' %></button>
            </div>
        </div>
    </div>

    <!-- MODAL: WEBRTC EXTENSION POLICIES (SUPER ADMIN ONLY) -->
    <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
    <div id="policyManagerModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] w-full max-w-5xl p-6 text-[var(--text-primary)] animate-fade-in flex flex-col max-h-[92vh]">
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 mb-4">
                <div class="flex items-center gap-2.5">
                    <span class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                    <div>
                        <h3 class="text-base font-extrabold text-white"><%= isRtl ? 'سياسات وقفل تحويلات WebRTC' : 'WebRTC Extension Policies & Feature Locks' %></h3>
                        <p class="text-xs text-[var(--text-muted)]"><%= isRtl ? 'قفل أو منع الرد التلقائي و DND على تحويلات WebRTC فقط (خاص بمدراء النظام)' : 'Enforce or prohibit Auto-Answer and DND on WebRTC extensions only (Super Admins)' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('policyManagerModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Per-Extension Notice -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 mb-4 p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)]">
                <span class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'إدارة وقفل سياسات كل تحويلة بشكل مستقل:' : 'Manage policies per extension individually:' %></span>
                <span class="text-[11px] text-emerald-400 font-semibold flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <%= isRtl ? 'اضغط "حفظ" أمام أي تحويلة لتطبيق سياساتها فوراً' : 'Click "Save" beside any extension to apply its policy immediately' %>
                </span>
            </div>

            <!-- Policies Table -->
            <div class="overflow-x-auto max-h-[62vh] mb-4 border border-[var(--border-primary)] rounded-xl custom-scrollbar">
                <table class="w-full text-start text-xs min-w-[860px]">
                    <thead>
                        <tr class="border-b border-[var(--border-primary)] bg-[var(--bg-card)] text-[10px] font-extrabold uppercase text-[var(--text-muted)] tracking-wider">
                            <th class="py-2.5 px-3.5 w-32"><%= isRtl ? 'التحويلة (WebRTC)' : 'WebRTC Ext' %></th>
                            <th class="py-2.5 px-3.5 w-36"><%= isRtl ? 'الاسم' : 'Name' %></th>
                            <th class="py-2.5 px-3.5"><%= isRtl ? 'الرد التلقائي' : 'Auto Answer' %></th>
                            <th class="py-2.5 px-3.5"><%= isRtl ? 'عدم الإزعاج (DND)' : 'DND' %></th>
                            <th class="py-2.5 px-3.5"><%= isRtl ? 'منع إنهاء الرنين الصادر' : 'Block Ring Cancel' %></th>
                            <th class="py-2.5 px-3.5 text-end w-24"><%= isRtl ? 'إجراء' : 'Action' %></th>
                        </tr>
                    </thead>
                    <tbody id="policyManagerTbody" class="divide-y divide-[var(--border-primary)]">
                        <tr>
                            <td colspan="6" class="py-6 text-center text-zinc-500 font-bold"><%= isRtl ? 'جاري تحميل تحويلات WebRTC...' : 'Loading WebRTC extensions...' %></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="flex items-center justify-between border-t border-[var(--border-primary)] pt-3">
                <span id="policyModalStatus" class="text-xs font-bold text-emerald-400"></span>
                <button type="button" onclick="closeModal('policyManagerModal')" class="config-btn-secondary text-xs px-4 py-2 cursor-pointer">
                    <%= isRtl ? 'إغلاق' : 'Close' %>
                </button>
            </div>
        </div>
    </div>
    <% } %>

    <!-- MODAL 2: RING GROUP FORM -->
    <div id="ringGroupModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                    </div>
                    <div>
                        <h3 id="rgModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة مجموعة اتصال' : 'Add Ring Group' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تجميع عدة تحويلات للرنين التزامني أو التتابعي' : 'Group multiple extensions for simultaneous or hunt ring strategies' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('ringGroupModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="ringGroupForm" onsubmit="saveRingGroup(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="rgEditMode" value="false">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: RING GROUP IDENTITY & STRATEGY (Emerald Theme) -->
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'هوية مجموعة الاتصال والاستراتيجية' : 'Ring Group Identity & Strategy' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgNum"><%= isRtl ? 'رقم مجموعة الاتصال *' : 'Ring Group Number *' %></label>
                                <input type="text" id="rgNum" required placeholder="e.g. 600" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgDesc"><%= isRtl ? 'وصف المجموعة *' : 'Group Description *' %></label>
                                <input type="text" id="rgDesc" required placeholder="e.g. Sales Support Team" class="config-input w-full text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: RING STRATEGY & TIMING -->
                    <div class="rounded-xl border border-sky-500/20 bg-sky-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-sky-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-sky-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                                <%= isRtl ? 'استراتيجية الرنين والتوقيت' : 'Ring Strategy & Timing' %>
                            </span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgStrategy"><%= isRtl ? 'استراتيجية الرنين' : 'Ring Strategy' %></label>
                                <select id="rgStrategy" class="config-input w-full text-xs">
                                    <option value="ringall"><%= isRtl ? 'الكل معًا' : 'Ring All' %></option>
                                    <option value="hunt"><%= isRtl ? 'تسلسلي (Hunt)' : 'Hunt' %></option>
                                    <option value="memoryhunt"><%= isRtl ? 'تسلسلي مع التذكر' : 'Memory Hunt' %></option>
                                    <option value="random"><%= isRtl ? 'عشوائي' : 'Random' %></option>
                                    <option value="firstavailable"><%= isRtl ? 'أول متاح' : 'First Available' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgTime"><%= isRtl ? 'مدة الرنين (ثوانٍ)' : 'Ring Time (seconds)' %></label>
                                <input type="number" id="rgTime" min="5" max="120" placeholder="20" class="config-input w-full text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: MEMBERS EXTENSIONS -->
                    <div class="rounded-xl border border-violet-500/20 bg-violet-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-violet-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-violet-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                                <%= isRtl ? 'قائمة الأعضاء' : 'Member Extensions' %>
                            </span>
                            <button type="button" onclick="clearQuickPickExts()" class="text-[11px] font-bold text-rose-400 hover:text-rose-300 underline cursor-pointer"><%= isRtl ? 'مسح' : 'Clear' %></button>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="rgList"><%= isRtl ? 'الأرقام (مفصولة بفواصل)' : 'Numbers (comma-separated)' %></label>
                            <input type="text" id="rgList" placeholder="e.g. 101,102,103" class="config-input w-full text-xs font-mono">
                        </div>
                                                <div id="rgQuickPickContainer" class="flex flex-wrap gap-1.5"></div>
                    </div>

                    <!-- SECTION 4: ANNOUNCEMENT & MUSIC ON HOLD -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                    <%= isRtl ? 'الإعلان الصوتي' : 'Announcement' %>
                                </span>
                            </div>
                            <select id="rgAnnMsg" class="config-input w-full text-xs">
                                <option value="0"><%= isRtl ? 'بدون إعلان' : 'None / No Announcement' %></option>
                            </select>
                        </div>
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-2v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zM9 10l12-2" /></svg>
                                    <%= isRtl ? 'الموسيقى أثناء الانتظار' : 'Play Music On Hold' %>
                                </span>
                            </div>
                            <select id="rgRinging" class="config-input w-full text-xs font-mono font-bold">
                                <option value="Ring"><%= isRtl ? 'نغمة الرنين (افتراضي)' : 'Ring (Default Ringtone)' %></option>
                            </select>
                        </div>
                    </div>

                    <!-- SECTION 5: DESTINATION IF NO ANSWER (Post Destination) -->
                    <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                        <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block"><%= isRtl ? 'الوجهة عند عدم الرد *' : 'Destination if No Answer *' %></span>

                        <!-- Create Mode Auto-Destination Banner -->
                        <div id="rgPostDestCreateNotice" class="hidden p-3 rounded-lg border border-emerald-500/20 bg-emerald-500/10 text-xs text-emerald-300 font-semibold flex items-center gap-2">
                            <svg class="w-4 h-4 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <span><%= isRtl ? 'الوجهة التلقائية عند إنشاء المجموعة: مجموعة الاتصال نفسها' : 'Default destination upon creation: Automatically set to this Ring Group itself' %> (<span id="rgPostDestCreateNoticeNum" class="font-mono text-white">ext-group,600,1</span>)</span>
                        </div>

                        <!-- Edit Mode Editable Selectors -->
                        <!-- Edit Mode Editable DestinationSelect Component -->
                        <div id="rgPostDestComponentContainer"></div>
                        <input type="hidden" id="rgPostDestination">
                    </div>

                </div>
                <!-- Footer Buttons -->
                <div class="flex justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('ringGroupModal')" class="config-btn-secondary px-5 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'حفظ' : 'Save' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 2.5: QUEUE FORM -->
    <div id="queueModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                    </div>
                    <div>
                        <h3 id="queueModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة طابور انتظار' : 'Add Queue' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تحديد رقم طابور الانتظار، الاستراتيجية، وإدارة وكلاء الخدمة' : 'Configure ACD queue parameters, ring strategy, and active agents' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('queueModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="queueForm" onsubmit="saveQueue(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="queueEditMode" value="false">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: QUEUE IDENTITY (Amber Theme) -->
                    <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <%= isRtl ? 'هوية طابور الانتظار' : 'Queue Identity & Definition' %>
                            </span>
                            <span class="text-[10px] text-amber-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueNum"><%= isRtl ? 'رقم طابور الانتظار *' : 'Queue Number *' %></label>
                                <input type="text" id="queueNum" required placeholder="e.g. 800" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueDesc"><%= isRtl ? 'اسم طابور الانتظار *' : 'Queue Name *' %></label>
                                <input type="text" id="queueDesc" required placeholder="<%= isRtl ? 'مثال: طابور خدمة العملاء' : 'e.g. Support Queue' %>" class="config-input w-full text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: QUEUE AGENTS CHECKLIST (Indigo Theme) -->
                    <div class="rounded-xl border border-indigo-500/20 bg-indigo-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-indigo-500/15">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                                <h4 class="text-xs font-black text-indigo-400 uppercase tracking-wider"><%= isRtl ? 'قائمة وكلاء طابور الانتظار' : 'Queue Agents Checklist' %></h4>
                            </div>
                            <div class="flex items-center gap-2 shrink-0">
                                <input type="text" id="queueAgentSearch" oninput="filterQueueAgentChecklist()" placeholder="<%= isRtl ? 'بحث...' : 'Search...' %>" class="config-input py-1 px-2.5 text-xs w-36">
                                <button type="button" onclick="clearAllQueueAgents()" class="text-[11px] font-bold text-rose-400 hover:text-rose-300 underline cursor-pointer whitespace-nowrap"><%= isRtl ? 'إعادة ضبط الكل' : 'Clear All' %></button>
                            </div>
                        </div>

                        <!-- Scrollable Agent Checklist Container -->
                        <div id="queueAgentsChecklistContainer" class="space-y-1.5 max-h-52 overflow-y-auto pr-1 mb-2 custom-scrollbar bg-black/40 p-3 rounded-xl border border-indigo-500/10">
                            <!-- Populated dynamically -->
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-indigo-500/15">
                            <div>
                                <label class="block text-[10px] font-bold text-amber-400 uppercase mb-1" for="queueStaticList"><%= isRtl ? 'ملخص الوكلاء الثابتين (Static)' : 'Static Agents Summary' %></label>
                                <input type="text" id="queueStaticList" oninput="renderQueueAgentChecklist()" placeholder="e.g. 101, 102" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-indigo-400 uppercase mb-1" for="queueDynList"><%= isRtl ? 'ملخص الوكلاء الديناميكيين (Dynamic)' : 'Dynamic Agents Summary' %></label>
                                <input type="text" id="queueDynList" oninput="renderQueueAgentChecklist()" placeholder="e.g. 104, 105" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: RING STRATEGY & MEDIA (Sky Theme) -->
                    <div class="rounded-xl border border-sky-500/20 bg-sky-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-sky-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-sky-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                                <%= isRtl ? 'استراتيجية التوزيع والإعلانات' : 'Strategy & Media Configuration' %>
                            </span>
                            <span class="text-[10px] text-sky-400/70 font-mono">MEDIA</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueStrategy"><%= isRtl ? 'استراتيجية الاتصال' : 'Ring Strategy' %></label>
                                <select id="queueStrategy" class="config-input w-full text-xs font-semibold">
                                    <option value="rrmemory" selected><%= isRtl ? 'rrmemory (التدوير مع الذاكرة - موصى به)' : 'rrmemory (Round Robin Memory - Recommended)' %></option>
                                    <option value="ringall"><%= isRtl ? 'ringall (رنين جميع الهواتف)' : 'ringall (Ring All)' %></option>
                                    <option value="leastrecent"><%= isRtl ? 'leastrecent (الأقل استقبالاً مؤخراً)' : 'leastrecent (Least Recent)' %></option>
                                    <option value="fewestcalls"><%= isRtl ? 'fewestcalls (الأقل في عدد المكالمات)' : 'fewestcalls (Fewest Calls)' %></option>
                                    <option value="random"><%= isRtl ? 'random (رنين عشوائي)' : 'random (Random)' %></option>
                                    <option value="linear"><%= isRtl ? 'linear (رنين خطي حسب الترتيب)' : 'linear (Linear)' %></option>
                                    <option value="wrandom"><%= isRtl ? 'wrandom (عشوائي موزون)' : 'wrandom (Weighted Random)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueMoh"><%= isRtl ? 'موسيقى الانتظار' : 'Music On Hold' %></label>
                                <select id="queueMoh" class="config-input w-full text-xs font-semibold">
                                    <option value="default" selected><%= isRtl ? 'default (الموسيقى الافتراضية)' : 'default (Default MoH)' %></option>
                                    <option value="none"><%= isRtl ? 'none (بدون موسيقى / صمت)' : 'none (Silence / No Music)' %></option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueAnnMsg"><%= isRtl ? 'رسالة الترحيب / الإعلان' : 'Join Announcement' %></label>
                                <select id="queueAnnMsg" class="config-input w-full text-xs font-semibold">
                                    <option value="0"><%= isRtl ? 'بدون إعلان / لا يوجد' : 'None / No Announcement' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueRecording"><%= isRtl ? 'وضع تسجيل المكالمات' : 'Call Recording' %></label>
                                <select id="queueRecording" class="config-input w-full text-xs font-semibold">
                                    <option value="yes" selected><%= isRtl ? 'نعم (تسجيل المكالمات في الخلفية)' : 'Yes (Background Recording)' %></option>
                                    <option value="no"><%= isRtl ? 'لا (إيقاف التسجيل)' : 'No (Disable Recording)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueMaxWait"><%= isRtl ? 'أقصى وقت انتظار (ثواني)' : 'Max Wait Time (sec)' %></label>
                                <input type="number" id="queueMaxWait" min="0" value="0" placeholder="0 = Unlimited" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 4: AGENT TIMEOUT & RETRY (Violet Theme) -->
                    <div class="rounded-xl border border-violet-500/20 bg-violet-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-violet-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-violet-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                                <%= isRtl ? 'إعدادات الوكلاء والتكرار' : 'Agent Timeout, Retry & Autofill' %>
                            </span>
                            <span class="text-[10px] text-violet-400/70 font-mono">ADVANCED</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueAgentTimeout"><%= isRtl ? 'مهلة الوكيل (ثوانٍ)' : 'Agent Timeout (seconds)' %></label>
                                <input type="number" id="queueAgentTimeout" min="1" value="15" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueRetry"><%= isRtl ? 'إعادة المحاولة (ثوانٍ)' : 'Retry (seconds)' %></label>
                                <input type="number" id="queueRetry" min="1" value="5" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueAutofill"><%= isRtl ? 'ملء تلقائي' : 'Autofill' %></label>
                                <select id="queueAutofill" class="config-input w-full text-xs font-semibold">
                                    <option value="yes"><%= isRtl ? 'نعم' : 'Yes' %></option>
                                    <option value="no"><%= isRtl ? 'لا' : 'No' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="queueSkipBusy"><%= isRtl ? 'تجاهل المشغول' : 'Skip Busy Agent' %></label>
                                <select id="queueSkipBusy" class="config-input w-full text-xs font-semibold">
                                    <option value="yes"><%= isRtl ? 'نعم' : 'Yes' %></option>
                                    <option value="no"><%= isRtl ? 'لا' : 'No' %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 5: QUEUE DESTINATIONS (Fail Over & Continue) -->
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- 1. Fail Over Destination -->
                            <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                                <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                    <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                        <%= isRtl ? 'الوجهة عند الإخفاق (Fail Over Destination)' : 'Fail Over Destination' %>
                                    </span>
                                    <span class="text-[10px] text-rose-400/70 font-mono">FAILOVER</span>
                                </div>
                                <div>
                                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'تحديد الوجهة عند عدم الرد أو انتهاء الوقت *' : 'Fail Over Destination *' %></span>
                                    <div id="queueDestComponentContainer"></div>
                                    <input type="hidden" id="queueDestination" required>
                                </div>
                            </div>

                            <!-- 2. Queue Continue Destination -->
                            <div class="rounded-xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-3">
                                <div class="flex items-center justify-between pb-2 border-b border-blue-500/15">
                                    <span class="text-xs font-black uppercase tracking-wider text-blue-400 flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                        <%= isRtl ? 'الوجهة عند مواصلة الطابور (Queue Continue Destination)' : 'Queue Continue Destination' %>
                                    </span>
                                    <span class="text-[10px] text-blue-400/70 font-mono">CONTINUE</span>
                                </div>
                                <div>
                                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'تحديد الوجهة عند خروج المتصل أو مواصلة الطابور *' : 'Queue Continue Destination *' %></span>
                                    <div id="queueContinueDestComponentContainer"></div>
                                    <input type="hidden" id="queueContinueDestination" required>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('queueModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ طابور الانتظار' : 'Save Queue' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL 3: TRUNK FORM -->
    <div id="trunkModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-4xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                    </div>
                    <div>
                        <h3 id="trunkModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة خط ربط' : 'Add Trunk' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تكوين خطوط الربط المخصصة أو SIP أو IAX2 للمكالمات الخارجية والواردة' : 'Configure Custom, SIP, or IAX2 trunks for outbound and inbound VoIP calls' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('trunkModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="trunkForm" onsubmit="saveTrunk(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="trunkEditId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: IDENTITY & CORE TECH (Blue Theme) -->
                    <div class="rounded-xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-blue-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-blue-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                <%= isRtl ? 'هوية خط الربط والتقنية' : 'Identity & Core Technology' %>
                            </span>
                            <span class="text-[10px] text-blue-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkName"><%= isRtl ? 'اسم خط الربط *' : 'Trunk Name *' %></label>
                                <input type="text" id="trunkName" required placeholder="e.g. vodafone_trunk" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkTech"><%= isRtl ? 'تقنية خط الربط *' : 'Trunk Technology *' %></label>
                                <select id="trunkTech" onchange="onTrunkTechChange()" class="config-input w-full text-xs font-bold">
                                    <option value="custom"><%= isRtl ? 'خط مخصص (Custom / Dongle / Dahdi)' : 'Custom Trunk (Dongle / Local / Dahdi)' %></option>
                                    <option value="sip"><%= isRtl ? 'خط ربط SIP (chan_sip)' : 'SIP Trunk (chan_sip)' %></option>
                                    <option value="iax2"><%= isRtl ? 'خط ربط IAX2 (chan_iax2)' : 'IAX2 Trunk (chan_iax2)' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkDisabled"><%= isRtl ? 'حالة الخط' : 'Trunk Status' %></label>
                                <select id="trunkDisabled" class="config-input w-full text-xs font-bold">
                                    <option value="off"><%= isRtl ? 'مفعل (Enabled)' : 'Enabled' %></option>
                                    <option value="on"><%= isRtl ? 'معطل (Disabled)' : 'Disabled' %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: OUTBOUND & CALLER ID (Amber Theme) -->
                    <div id="trunkCidSection" class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <%= isRtl ? 'إعدادات هوية المتصل والقنوات' : 'Outbound CID & Capacity Rules' %>
                            </span>
                            <span class="text-[10px] text-amber-400/70 font-mono"><%= isRtl ? 'توجيه' : 'ROUTING' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkOutcid"><%= isRtl ? 'رقم هوية المتصل الخارجي' : 'Outbound CallerID' %></label>
                                <input type="text" id="trunkOutcid" placeholder='e.g. "Vodafone" <01027826232>' class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkKeepCid"><%= isRtl ? 'خيارات هوية المتصل' : 'CID Options' %></label>
                                <select id="trunkKeepCid" class="config-input w-full text-xs">
                                    <option value="off"><%= isRtl ? 'السماح بأي هوية (Allow Any CID)' : 'Allow Any CID' %></option>
                                    <option value="on"><%= isRtl ? 'حظر الهويات الخارجية (Block Foreign CIDs)' : 'Block Foreign CIDs' %></option>
                                    <option value="cnum"><%= isRtl ? 'إزالة اسم المتصل (Remove CNAM)' : 'Remove CNAM' %></option>
                                    <option value="all"><%= isRtl ? 'فرض هوية الخط (Force Trunk CID)' : 'Force Trunk CID' %></option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkMaxChans"><%= isRtl ? 'أقصى عدد قنوات' : 'Maximum Channels' %></label>
                                <input type="number" id="trunkMaxChans" min="0" placeholder="e.g. 10 (blank = unlimited)" class="config-input w-full font-mono text-xs">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkDialPrefix"><%= isRtl ? 'بادئة الاتصال (Dial Prefix)' : 'Outbound Dial Prefix' %></label>
                                <input type="text" id="trunkDialPrefix" placeholder="e.g. 9" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkDialOpts"><%= isRtl ? 'خيارات الاتصال (Asterisk Dial Options)' : 'Asterisk Trunk Dial Options' %></label>
                                <input type="text" id="trunkDialOpts" placeholder="e.g. Ww" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkContinue"><%= isRtl ? 'متابعة عند الانشغال' : 'Continue if Busy' %></label>
                                <select id="trunkContinue" class="config-input w-full text-xs font-bold">
                                    <option value="off"><%= isRtl ? 'لا (No)' : 'No' %></option>
                                    <option value="on"><%= isRtl ? 'نعم (Yes)' : 'Yes' %></option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkFailScript"><%= isRtl ? 'سكربت مراقبة الأعطال (Monitor Failures)' : 'Monitor Trunk Failures Script' %></label>
                            <input type="text" id="trunkFailScript" placeholder="e.g. /usr/local/bin/failover.sh" class="config-input w-full font-mono text-xs">
                        </div>

                        <!-- Dialed Number Manipulation Rules Section -->
                        <div class="pt-3 border-t border-amber-500/15 space-y-2">
                            <div class="flex items-center justify-between">
                                <div>
                                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase"><%= isRtl ? 'قواعد تعديل أرقام الاتصال (Dialed Number Manipulation Rules)' : 'Dialed Number Manipulation Rules' %></span>
                                    <p class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'قواعد تعديل الأرقام قبل إرسالها إلى خط الربط (Prepend + Prefix | Match Pattern)' : 'Prepend, prefix, and match pattern rules applied to calls on this trunk' %></p>
                                </div>
                                <button type="button" onclick="addTrunkDialRuleRow()" class="px-2.5 py-1 text-[10px] font-bold text-amber-400 bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 rounded-lg transition cursor-pointer">
                                    + <%= isRtl ? 'إضافة قاعدة' : 'Add Rule' %>
                                </button>
                            </div>
                            <div id="trunkDialRulesContainer" class="space-y-2">
                                <!-- Populated dynamically by renderTrunkDialRules() -->
                            </div>
                        </div>
                    </div>

                    <!-- CUSTOM TRUNK SECTION -->
                    <div id="trunkCustomFields" class="relative rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'إعدادات الاتصال المخصص (Custom Dial String)' : 'Custom Connection Settings' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono">CUSTOM</span>
                        </div>
                        <div>
                            <label for="trunkDialString" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'سلسلة الاتصال المخصصة *' : 'Custom Dial String *' %></label>
                            <input type="text" id="trunkDialString" placeholder="e.g. dongle/dongle0/$OUTNUM$" class="config-input w-full font-mono text-xs" autocomplete="off">

                            <!-- DONGLE FLOATING POPUP -->
                            <div id="dongleInfoPopup" class="fixed bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-xl p-4 z-[999999] hidden space-y-2">
                                <div class="text-[11px] font-bold text-[var(--text-secondary)] uppercase flex items-center justify-between">
                                    <span><%= isRtl ? 'أجهزة Dongle المتصلة:' : 'Connected Dongles:' %></span>
                                    <button type="button" onclick="loadDongleInfoPopup()" class="text-[10px] text-blue-400 hover:underline">Refresh</button>
                                </div>
                                <div id="dongleInfoList" class="text-xs space-y-1.5 max-h-[160px] overflow-y-auto pr-1">
                                    <span class="text-[11px] text-[var(--text-muted)]">Loading...</span>
                                </div>
                            </div>

                            <p class="text-[11px] text-[var(--text-muted)] mt-1.5 font-mono">
                                Format: <code>dongle/dongle0/$OUTNUM$</code> or <code>dongle/i:359767037813558/$OUTNUM$</code>
                            </p>
                        </div>
                    </div>

                    <!-- SIP / IAX2 TRUNK SECTION -->
                    <div id="trunkSipIaxFields" class="hidden space-y-5">

                        <!-- SECTION 3: OUTGOING PEER SETTINGS (Emerald Theme) -->
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <%= isRtl ? 'إعدادات الاتصال الخارجي (Outgoing PEER Details)' : 'Outgoing Connection & PEER Details' %>
                                </span>
                                <span class="text-[10px] text-emerald-400/70 font-mono">PEER</span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkChannelId"><%= isRtl ? 'اسم خط الربط الصادر *' : 'Outgoing Trunk Name *' %></label>
                                    <input type="text" id="trunkChannelId" placeholder="e.g. issabel_provider" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkHost"><%= isRtl ? 'عنوان الخادم البعيد *' : 'Remote Host (IP / Domain) *' %></label>
                                    <input type="text" id="trunkHost" placeholder="e.g. 192.168.100.50" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkContext"><%= isRtl ? 'سياق الخروج (Context) *' : 'Context *' %></label>
                                    <input type="text" id="trunkContext" placeholder="from-trunk" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkUsername"><%= isRtl ? 'اسم المستخدم' : 'Username' %></label>
                                    <input type="text" id="trunkUsername" placeholder="e.g. 01027826232" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkSecret"><%= isRtl ? 'كلمة السر (Secret)' : 'Secret / Password' %></label>
                                    <input type="password" id="trunkSecret" autocomplete="current-password" placeholder="••••••••" class="config-input w-full font-mono text-xs">
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label for="trunkPeerDetails" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase"><%= isRtl ? 'تفاصيل الخروج (PEER Details)' : 'Outgoing Settings (PEER Details)' %></label>
                                    <span class="text-[10px] font-mono text-emerald-400">key=value</span>
                                </div>
                                <textarea id="trunkPeerDetails" rows="4" placeholder="host=192.168.100.50&#10;username=user&#10;secret=pass&#10;type=peer&#10;context=from-trunk&#10;insecure=port,invite&#10;qualify=yes" class="config-input w-full font-mono text-xs py-2 px-3 leading-relaxed resize-y bg-black/40 border-emerald-500/20 focus:border-emerald-500"></textarea>
                            </div>
                        </div>

                        <!-- SECTION 4: INCOMING USER SETTINGS & REGISTRATION (Purple Theme) -->
                        <div class="rounded-xl border border-purple-500/20 bg-purple-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-purple-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-purple-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                                    <%= isRtl ? 'إعدادات الدخول والتسجيل (Incoming USER & Register)' : 'Incoming User Context & Registration' %>
                                </span>
                                <span class="text-[10px] text-purple-400/70 font-mono">USER & REG</span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                <div>
                                    <label for="trunkUserContext" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'سياق المستخدم الوارد' : 'User Context (Incoming)' %></label>
                                    <input type="text" id="trunkUserContext" placeholder="e.g. from-trunk" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="trunkRegister"><%= isRtl ? 'نص التسجيل (Register String)' : 'Register String' %></label>
                                    <input type="text" id="trunkRegister" placeholder="e.g. user:secret@host" class="config-input w-full font-mono text-xs">
                                </div>
                            </div>

                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label for="trunkUserDetails" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase"><%= isRtl ? 'تفاصيل الدخول (USER Details)' : 'Incoming Settings (USER Details)' %></label>
                                    <span class="text-[10px] font-mono text-purple-400">key=value</span>
                                </div>
                                <textarea id="trunkUserDetails" rows="3" placeholder="secret=pass&#10;type=user&#10;context=from-trunk" class="config-input w-full font-mono text-xs py-2 px-3 leading-relaxed resize-y bg-black/40 border-purple-500/20 focus:border-purple-500"></textarea>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('trunkModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ خط الربط' : 'Save Trunk' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL IVR: IVR FORM -->
    <div id="ivrModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                    </div>
                    <div>
                        <h3 id="ivrModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة قائمة رد آلي' : 'Add IVR Menu' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تكوين قائمة الرد الآلي التفاعلية وخيارات الضغط والأخطاء' : 'Configure interactive voice response menu, keypress options, and failovers' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('ivrModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="ivrForm" onsubmit="saveIvr(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="ivrEditId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: IVR IDENTITY & GREETING (Purple Theme) -->
                    <div class="rounded-xl border border-purple-500/20 bg-purple-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-purple-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-purple-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                                <%= isRtl ? 'هوية قائمة الرد الآلي والترحيب' : 'IVR Menu Definition & Greeting' %>
                            </span>
                            <span class="text-[10px] text-purple-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label for="ivrName" class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اسم القائمة *' : 'IVR Name *' %></label>
                                <input type="text" id="ivrName" required placeholder="e.g. Main_IVR" class="config-input w-full text-xs font-mono">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ivrDescription"><%= isRtl ? 'الوصف' : 'Description' %></label>
                                <input type="text" id="ivrDescription" placeholder="e.g. Main Company IVR Menu" class="config-input w-full text-xs">
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ivrAnnouncement"><%= isRtl ? 'الرسالة الصوتية (Announcement)' : 'Announcement Greeting' %></label>
                                <select id="ivrAnnouncement" class="config-input w-full text-xs font-semibold">
                                    <option value="0">None / Default</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ivrDirectDial"><%= isRtl ? 'الطلب المباشر للأرقام الفرعية' : 'Direct Dial' %></label>
                                <select id="ivrDirectDial" class="config-input w-full text-xs font-semibold">
                                    <option value="disabled"><%= isRtl ? 'معطل (Disabled)' : 'Disabled' %></option>
                                    <option value="ext-local,vmu,1"><%= isRtl ? 'مفعل للهواتف الفرعية (Extensions)' : 'Extensions' %></option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: TIMEOUT & INVALID FAILOVERS (Amber & Rose Split Theme) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Timeout Section (Amber) -->
                        <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                    <%= isRtl ? 'مهلة الانتظار (Timeout)' : 'Timeout Settings' %>
                                </span>
                                <span class="text-[10px] text-amber-400/70 font-mono">TIMEOUT</span>
                            </div>
                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1" for="ivrTimeoutTime"><%= isRtl ? 'المهلة (ثواني)' : 'Timeout (sec)' %></label>
                                    <input type="number" id="ivrTimeoutTime" value="10" min="1" max="60" class="config-input w-full font-mono text-xs">
                                </div>
                                <div>
                                    <label class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1" for="ivrTimeoutLoops"><%= isRtl ? 'المحاولات' : 'Retries' %></label>
                                    <input type="number" id="ivrTimeoutLoops" value="3" min="0" max="10" class="config-input w-full font-mono text-xs">
                                </div>
                            </div>
                            <div>
                                <span class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'وجهة انتهاء المهلة' : 'Timeout Destination' %></span>
                                <div id="ivrTimeoutDestComponentContainer"></div>
                                <input type="hidden" id="ivrTimeoutDestination" value="app-blackhole,hangup,1">
                            </div>
                        </div>

                        <!-- Invalid Section (Rose) -->
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                    <%= isRtl ? 'الإدخال الخاطئ (Invalid)' : 'Invalid Input Settings' %>
                                </span>
                                <span class="text-[10px] text-rose-400/70 font-mono">INVALID</span>
                            </div>
                            <div>
                                <label class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1" for="ivrInvalidLoops"><%= isRtl ? 'محاولات الإدخال الخاطئ' : 'Invalid Retries' %></label>
                                <input type="number" id="ivrInvalidLoops" value="3" min="0" max="10" class="config-input w-full font-mono text-xs">
                            </div>
                            <div>
                                <span class="block text-[10px] text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'وجهة الإدخال الخاطئ' : 'Invalid Destination' %></span>
                                <div id="ivrInvalidDestComponentContainer"></div>
                                <input type="hidden" id="ivrInvalidDestination" value="app-blackhole,hangup,1">
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 3: DIGIT KEYPRESS ENTRIES (Cyan Theme) -->
                    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-cyan-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'خيارات أزرار الرد الآلي (Digits 0-9, *, #)' : 'IVR Keypress Options (Digits 0-9, *, #)' %>
                            </span>
                            <button type="button" onclick="addIvrEntryRow()" class="text-xs bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-400 border border-cyan-500/30 px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer font-bold transition">
                                <span>+ <%= isRtl ? 'إضافة زر جديد' : 'Add Key Option' %></span>
                            </button>
                        </div>

                        <div id="ivrEntriesContainer" class="space-y-2 bg-black/40 p-3 rounded-xl border border-cyan-500/10">
                            <!-- Dynamic IVR Entry Rows rendered here -->
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('ivrModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ الرد الآلي' : 'Save IVR Menu' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>


    <!-- MODAL 4: INBOUND ROUTE FORM -->
    <div id="inboundModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-2xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>
                    </div>
                    <div>
                        <h3 id="inboundModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة مسار وارد' : 'Add Inbound Route' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'توجيه المكالمات الواردة حسب رقم DID أو الوجهة' : 'Route incoming call traffic by DID number matching' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('inboundModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="inboundForm" onsubmit="saveInboundRoute(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="inboundEditExt" value="">
                <input type="hidden" id="inboundEditCid" value="">
                <input type="hidden" id="inboundEditDesc" value="">
                <input type="hidden" id="inboundEditDest" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: INBOUND MATCHING RULES (Emerald Theme) -->
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'شروط المطابقة والوصف' : 'Inbound Route Matching Rules' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono"><%= isRtl ? 'قواعد التوجيه' : 'RULES' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="inDescription"><%= isRtl ? 'وصف المسار' : 'Description' %></label>
                                <input type="text" id="inDescription" placeholder="e.g. Sales Inbound (optional)" class="config-input w-full text-xs">
                            </div>
                            <div class="relative">
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="inExtension"><%= isRtl ? 'رقم DID (المستهدف)' : 'DID Number' %></label>
                                <input type="text" id="inExtension" placeholder="e.g. 01012345678, _01., +20... (blank = ANY)" class="config-input w-full font-mono text-xs" autocomplete="off">

                                <!-- DONGLE DID FLOATING POPUP FOR INBOUND ROUTES -->
                                <div id="inboundDongleInfoPopup" class="fixed bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-xl p-4 z-[999999] hidden space-y-2 max-h-[320px] flex flex-col">
                                    <div class="text-[11px] font-bold text-[var(--text-secondary)] uppercase flex items-center justify-between shrink-0">
                                        <span><%= isRtl ? 'أجهزة Dongle والأرقام المعرفة:' : 'Connected Dongles & Numbers:' %></span>
                                        <button type="button" onclick="loadInboundDonglePopup()" class="text-[10px] text-blue-400 hover:underline">Refresh</button>
                                    </div>
                                    <div id="inboundDongleList" class="text-xs space-y-2 flex flex-col overflow-y-auto max-h-[260px] pr-1 custom-scrollbar flex-1">
                                        <span class="text-[11px] text-[var(--text-muted)]">Loading...</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="inCidNum"><%= isRtl ? 'رقم هوية المتصل (CallerID Number)' : 'CallerID Number' %></label>
                            <input type="text" id="inCidNum" placeholder="e.g. 01012345678 or pattern (blank = ANY)" class="config-input w-full font-mono text-xs" autocomplete="off">
                            <p class="text-[10px] text-[var(--text-muted)] mt-1"><%= isRtl ? 'تحديد رقم المتصل لتوجيه مخصص (اختياري - اتركه فارغاً لأي متصل)' : 'Route calls from a specific caller number (optional - leave blank for ANY)' %></p>
                        </div>
                    </div>

                    <!-- SECTION 2: DESTINATION TARGET (Blue Theme) -->
                    <div class="rounded-xl border border-blue-500/20 bg-blue-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-blue-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-blue-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                <%= isRtl ? 'تحديد الوجهة عند استقبال المكالمة' : 'Target Destination Configuration' %>
                            </span>
                            <span class="text-[10px] text-blue-400/70 font-mono">TARGET</span>
                        </div>
                        <div>
                            <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'تحديد الوجهة *' : 'Set Destination *' %></span>
                            <div id="inDestComponentContainer"></div>
                            <input type="hidden" id="inDestination" required>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('inboundModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ المسار الوارد' : 'Save Inbound Route' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- MODAL 5: OUTBOUND ROUTE FORM -->
    <div id="outboundModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
                    </div>
                    <div>
                        <h3 id="outboundModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة مسار صادر' : 'Add Outbound Route' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تحديد اسم المسار، أنماط الطلب، وتسلسل خطوط الربط المستهدفة' : 'Configure route name, dial rules, and targeted trunk failover sequence' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('outboundModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="outboundForm" onsubmit="saveOutboundRoute(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="outboundEditId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: ROUTE DEFINITION (Violet Theme) -->
                    <div class="rounded-xl border border-violet-500/20 bg-violet-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-violet-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-violet-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-violet-400"></span>
                                <%= isRtl ? 'تعريف المسار الصادر' : 'Outbound Route Definition' %>
                            </span>
                            <span class="text-[10px] text-violet-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="outName"><%= isRtl ? 'اسم المسار *' : 'Route Name *' %></label>
                            <input type="text" id="outName" required placeholder="e.g. Outbound-All" class="config-input w-full text-xs font-mono">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                            <div class="sm:col-span-2">
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="outCid"><%= isRtl ? 'رقم هوية المتصل للمسار (Route CID - اختياري)' : 'Route CID (Optional)' %></label>
                                <input type="text" id="outCid" placeholder='<%= isRtl ? "اختياري - اتركه فارغاً لاستخدام هوية كل تحويلة" : "e.g. \"Company\" <01012345678> (blank = use extension CID)" %>' class="config-input w-full text-xs font-mono">
                                <p class="text-[10px] text-[var(--text-muted)] mt-1"><%= isRtl ? 'اتركه فارغاً للسماح لجميع التحويلات بالاتصال باستخدام هويتها الخاصة.' : 'Optional. Leave blank to allow all extensions to send their own Caller ID.' %></p>
                            </div>
                            <div class="flex flex-col justify-center pt-2 sm:pt-4">
                                <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-[var(--text-secondary)]">
                                    <input type="checkbox" id="outCidOverride" value="override_extension" class="rounded border-[var(--border-primary)] text-violet-600 focus:ring-violet-500">
                                    <span><%= isRtl ? 'فرض هوية المسار (Override)' : 'Override Extension' %></span>
                                </label>
                                <p class="text-[9px] text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'تجاهل هوية التحويلة وفرض هوية المسار أعلاه' : 'Ignore extension CID in favor of this Route CID' %></p>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: DIAL PATTERNS (Amber Theme) -->
                    <div class="rounded-xl border border-amber-500/20 bg-amber-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-amber-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-amber-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <%= isRtl ? 'أنماط الاتصال وقواعد الأرقام' : 'Dial Patterns & Prefix Rules' %>
                            </span>
                            <span class="text-[10px] text-amber-400/70 font-mono">PATTERNS</span>
                        </div>

                        <div id="outboundPatternsList" class="space-y-2 mb-2">
                            <!-- Rendered dynamically -->
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 bg-black/40 p-3 rounded-xl border border-amber-500/15">
                            <div>
                                <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="patPrepend">Prepend</label>
                                <input type="text" id="patPrepend" placeholder="prepend" class="config-input w-full text-xs font-mono py-1 px-2.5">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="patPrefix">Prefix</label>
                                <input type="text" id="patPrefix" placeholder="prefix" class="config-input w-full text-xs font-mono py-1 px-2.5">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="patPattern">Match Pattern *</label>
                                <input type="text" id="patPattern" placeholder="e.g. X." class="config-input w-full text-xs font-mono py-1 px-2.5">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="patCid" title="<%= isRtl ? 'اتركه فارغاً لجميع التحويلات' : 'Leave blank for all extensions' %>"><%= isRtl ? 'معرف المتصل (اختياري)' : 'CallerID (Optional)' %></label>
                                <input type="text" id="patCid" class="config-input w-full text-xs font-mono py-1 px-2.5">
                            </div>
                        </div>
                        <p class="text-[10px] text-[var(--text-muted)] px-1"><%= isRtl ? 'ملاحظة: اترك حقل CallerID فارغاً دائماً لتمكين جميع التحويلات من استخدام هذا المسار. تحديده يقصر المسار على رقم محدد فقط.' : 'Note: Leave CallerID blank so all extensions can use this route. Specifying a CID restricts this pattern exclusively to that caller.' %></p>

                        <div class="flex justify-end pt-1">
                            <button type="button" onclick="addDialPatternToModalList()" class="text-xs bg-amber-500/15 hover:bg-amber-500/25 text-amber-400 border border-amber-500/30 px-3 py-1.5 rounded-lg flex items-center gap-1.5 cursor-pointer font-bold transition">
                                <span id="addPatternBtn">+ Add Pattern</span>
                            </button>
                        </div>
                    </div>

                    <!-- SECTION 3: TRUNK SEQUENCE (Emerald Theme) -->
                    <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'تسلسل خطوط الربط المستخدمة' : 'Target Trunk Failover Sequence' %>
                            </span>
                            <span class="text-[10px] text-emerald-400/70 font-mono">TRUNKS</span>
                        </div>

                        <div id="outboundTrunksSequenceList" class="space-y-2 mb-2">
                            <!-- Rendered dynamically -->
                        </div>

                        <div class="flex flex-col sm:flex-row items-center gap-2.5 bg-black/40 p-3 rounded-xl border border-emerald-500/15">
                            <select id="sequenceTrunkSelect" class="config-input w-full text-xs font-semibold">
                                <option value="">-- Choose Trunk --</option>
                            </select>
                            <button type="button" onclick="addTrunkToModalSequence()" class="w-full sm:w-auto px-4 py-2 text-xs bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-400 border border-emerald-500/30 rounded-lg cursor-pointer font-bold transition shrink-0 whitespace-nowrap">
                                + Add Trunk to Sequence
                            </button>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('outboundModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ المسار الصادر' : 'Save Outbound Route' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 8: TIME GROUP FORM -->
    <div id="timeGroupModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    </div>
                    <div>
                        <h3 id="timeGroupModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة مجموعة وقت' : 'Add Time Group' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'تحديد فترات وساعات وأيام العمل الرسمية والتوجيه الزمني' : 'Define business hours, days, and time interval rules for call routing' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('timeGroupModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="timeGroupForm" onsubmit="saveTimeGroup(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="tgEditMode" value="false">
                <input type="hidden" id="tgId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: TIME GROUP DEFINITION (Indigo Theme) -->
                    <div class="rounded-xl border border-indigo-500/20 bg-indigo-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-indigo-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-indigo-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                                <%= isRtl ? 'تعريف مجموعة الوقت' : 'Time Group Definition' %>
                            </span>
                            <span class="text-[10px] text-indigo-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="tgDescription"><%= isRtl ? 'وصف المجموعة *' : 'Group Description *' %></label>
                            <input type="text" id="tgDescription" required placeholder="e.g. Working Hours" class="config-input w-full text-xs font-mono">
                        </div>
                    </div>

                    <!-- SECTION 2: TIME INTERVAL RULES (Sky Theme) -->
                    <div class="rounded-xl border border-sky-500/20 bg-sky-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-sky-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-sky-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-sky-400"></span>
                                <%= isRtl ? 'قواعد الوقت المحددة' : 'Configured Time Rules' %>
                            </span>
                            <span class="text-[10px] text-sky-400/70 font-mono">RULES</span>
                        </div>

                        <div id="timeGroupRulesListContainer" class="space-y-3 max-h-[320px] overflow-y-auto pr-1 mb-2 custom-scrollbar bg-black/40 p-3 rounded-xl border border-sky-500/15">
                            <!-- Populated dynamically -->
                        </div>

                        <button type="button" onclick="addTimeGroupRuleToModal()" class="w-full py-2.5 border border-dashed border-sky-500/30 hover:border-sky-500/60 rounded-xl text-xs font-bold text-sky-400 bg-sky-500/10 hover:bg-sky-500/20 cursor-pointer transition flex items-center justify-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>+ <%= isRtl ? 'إضافة قاعدة فترة زمنية جديدة' : 'Add Time Interval Rule' %></span>
                        </button>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('timeGroupModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ مجموعة الوقت' : 'Save Time Group' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 9: TIME CONDITION FORM -->
    <div id="timeConditionModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <div>
                        <h3 id="timeConditionModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة شرط وقت' : 'Add Time Condition' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'ربط مجموعة وقت بوجهات المطابقة (مفتوح / مغلق)' : 'Associate time group rules with open and after-hours destinations' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('timeConditionModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="timeConditionForm" onsubmit="saveTimeCondition(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="tcEditMode" value="false">
                <input type="hidden" id="tcId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">

                    <!-- SECTION 1: TIME CONDITION DEFINITION (Cyan Theme) -->
                    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-cyan-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'تعريف شرط الوقت والمجموعة' : 'Time Condition Identity' %>
                            </span>
                            <span class="text-[10px] text-cyan-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="tcDisplayName"><%= isRtl ? 'الاسم الظاهر *' : 'Display Name *' %></label>
                                <input type="text" id="tcDisplayName" required placeholder="e.g. Office Hours Route" class="config-input w-full text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="tcTimeGroup"><%= isRtl ? 'مجموعة الوقت *' : 'Time Group *' %></label>
                                <select id="tcTimeGroup" required class="config-input w-full text-xs font-semibold">
                                    <option value="">-- Choose Time Group --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: DESTINATIONS MATCH / UNMATCH (Emerald & Rose Split Theme) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Destination if MATCH (True / Open) -->
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <%= isRtl ? 'الوجهة عند المطابقة (مفتوح / True)' : 'Destination if Matched (True / Open)' %>
                                </span>
                                <span class="text-[10px] text-emerald-400/70 font-mono">MATCHED</span>
                            </div>
                            <div id="tcTrueDestComponentContainer"></div>
                            <input type="hidden" id="tcTrueGoto" required>
                        </div>

                        <!-- Destination if NO MATCH (False / Closed) -->
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                    <%= isRtl ? 'الوجهة عند عدم المطابقة (مغلق / False)' : 'Destination if NOT Matched (False / Closed)' %>
                                </span>
                                <span class="text-[10px] text-rose-400/70 font-mono">UNMATCHED</span>
                            </div>
                            <div id="tcFalseDestComponentContainer"></div>
                            <input type="hidden" id="tcFalseGoto" required>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('timeConditionModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ شرط الوقت' : 'Save Time Condition' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ANNOUNCEMENT MODAL -->
    <div id="announcementModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.684A1.76 1.76 0 013 12V8a1.76 1.76 0 012.436-1.684l3.181-1.363A1.76 1.76 0 0111 6.592v10.816a1.76 1.76 0 01-2.383 1.644l-3.181-1.368z" />
                        </svg>
                    </div>
                    <div>
                        <h3 id="announcementModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة إعلان جديد' : 'Add Announcement' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'إعداد رسالة صوتية وإعادة توجيه الاتصال بعد انتهائها' : 'Configure playback recording and post-playback call routing' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('announcementModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Body -->
            <form id="announcementForm" onsubmit="saveAnnouncement(event)" class="flex-1 overflow-y-auto p-6 space-y-5">
                <input type="hidden" id="annEditMode" value="false">
                <input type="hidden" id="annId" value="">

                <!-- 1. Description / Name -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annDescription"><%= isRtl ? 'وصف/اسم الإعلان *' : 'Description / Name *' %></label>
                    <input type="text" id="annDescription" required placeholder="e.g. Welcome Announcement" class="config-input w-full text-xs">
                </div>

                <!-- 2. System Recording (with the audio studio) -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annRecording"><%= isRtl ? 'التسجيل الصوتي' : 'System Recording' %></label>
                    <select id="annRecording" onchange="onAnnRecordingChange()" class="config-input w-full text-xs font-semibold">
                        <option value="0">== <%= isRtl ? 'بدون تسجيل (استخدام تحويل النص إلى كلام)' : 'None (Use Text-To-Speech TTS)' %> ==</option>
                    </select>
                    <div class="flex items-center gap-1.5 mt-2 flex-wrap">
                        <button type="button" id="annStudioBtn" onclick="openAnnouncementStudio()" class="px-2 py-1 text-[10px] font-bold rounded-lg border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1" title="<%= isRtl ? 'فتح الاستوديو لمعالجة صوت هذا التسجيل' : 'Open the audio studio to process this recording' %>">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l10-3v13M9 19a3 3 0 11-6 0 3 3 0 016 0zm10-3a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            <span><%= isRtl ? 'الاستوديو' : 'Studio' %></span>
                        </button>
                        <button type="button" id="annPreviewBtn" onclick="previewAnnouncementRecording()" class="px-2 py-1 text-[10px] font-bold rounded-lg border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1" title="<%= isRtl ? 'استماع للتسجيل' : 'Preview the recording' %>">
                            <svg class="w-3.5 h-3.5" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                            <span><%= isRtl ? 'استماع' : 'Preview' %></span>
                        </button>
                        <button type="button" id="annUploadBtn" onclick="openRecordingUploadModal()" class="px-2 py-1 text-[10px] font-bold rounded-lg border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition cursor-pointer flex items-center gap-1" title="<%= isRtl ? 'رفع تسجيل صوتي جديد واستخدامه' : 'Upload a new recording and use it' %>">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0l-4 4m4-4l4 4M4 17v2a1 1 0 001 1h14a1 1 0 001-1v-2"/></svg>
                            <span><%= isRtl ? 'رفع تسجيل' : 'Upload' %></span>
                        </button>
                    </div>
                    <p id="annRecordingState" class="text-[10px] text-[var(--text-muted)] mt-1.5"></p>
                </div>

                <!-- 3. Repeat Message Key -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annRepeatMsg"><%= isRtl ? 'مفتاح إعادة التكرار' : 'Repeat Message Key' %></label>
                    <select id="annRepeatMsg" class="config-input w-full text-xs font-semibold">
                        <option value=""><%= isRtl ? 'بدون تكرار (None)' : 'None (No repeat key)' %></option>
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="*">*</option>
                        <option value="#">#</option>
                    </select>
                </div>

                <!-- 3.5 Text-to-Speech Engine (TTS) -->
                <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                    <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block"><%= isRtl ? 'تحويل النص إلى كلام (Text-To-Speech)' : 'Text-To-Speech (TTS Engine)' %></span>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annTtsLang"><%= isRtl ? 'اللغة' : 'Language' %></label>
                            <select id="annTtsLang" class="config-input w-full text-xs font-semibold">
                                <option value="en-US">English (en-US)</option>
                                <option value="en-GB">English (en-GB)</option>
                                <option value="es-ES">Spanish (es-ES)</option>
                                <option value="fr-FR">French (fr-FR)</option>
                                <option value="it-IT">Italian (it-IT)</option>
                                <option value="de-DE">German (de-DE)</option>
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="annTtsText"><%= isRtl ? 'النص الصوتي (ينشط عند عدم اختيار تسجيل)' : 'TTS Text (used when System Recording is None)' %></label>
                            <input type="text" id="annTtsText" placeholder="e.g. Welcome to our company. Please hold." class="config-input w-full text-xs">
                        </div>
                    </div>
                </div>
                <!-- 4. Playback Behavior Flags -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                    <label for="annAllowSkip" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annAllowSkip" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالتخطي (Allow Skip)' : 'Allow Skip' %></span>
                    </label>
                    <label for="annReturnIvr" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annReturnIvr" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'العودة للرد الآلي (Return IVR)' : 'Return to IVR' %></span>
                    </label>
                    <label for="annNoAnswer" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annNoAnswer" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'عدم الإجابة (Don\'t Answer)' : 'Don\'t Answer' %></span>
                    </label>
                </div>

                <!-- 5. Post Playback Destination -->
                <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                    <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block"><%= isRtl ? 'الوجهة المستهدفة بعد الانتهاء *' : 'Post Playback Destination *' %></span>
                    <div id="annPostDestComponentContainer"></div>
                    <input type="hidden" id="annPostDestination" required>
                </div>
                <!-- Form Action Buttons -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--border-primary)] shrink-0">
                    <button type="button" onclick="closeModal('announcementModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'حفظ الإعلان' : 'Save Announcement' %></button>
                </div>
            </form>
        </div>
    </div>
    <!-- SHARED SYSTEM RECORDING UPLOAD MODAL (used by Announcements) -->
    <div id="recordingUploadModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-lg w-full flex flex-col text-[var(--text-primary)] shadow-2xl">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="min-w-0">
                    <h3 class="text-base font-extrabold text-[var(--text-primary)] truncate"><%= isRtl ? 'رفع تسجيل صوتي جديد' : 'Upload New System Recording' %></h3>
                    <p class="text-[11px] text-[var(--text-muted)] truncate"><%= isRtl ? 'سيُضاف التسجيل إلى مكتبة التسجيلات الصوتية ويُختار تلقائياً' : 'The recording is added to the System Recordings library and selected automatically' %></p>
                </div>
                <button type="button" onclick="closeModal('recordingUploadModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors shrink-0">✕</button>
            </div>
            <form id="recordingUploadModalForm" onsubmit="submitRecordingUploadModal(event)" class="flex-1 overflow-y-auto p-6 space-y-4">
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ruName"><%= isRtl ? 'اسم التسجيل' : 'Recording Name' %> *</label>
                    <input type="text" id="ruName" required placeholder="e.g. Welcome Announcement" class="config-input w-full text-xs">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ruFile"><%= isRtl ? 'ملف الصوت' : 'Audio File' %> *</label>
                    <input type="file" id="ruFile" accept="audio/*,.mpeg,.mpg,.wav" required class="w-full text-xs text-[var(--text-secondary)] file:mr-3 rtl:file:mr-0 file:file:ml-3 file:py-2 file:px-3 file:rounded-lg file:border file:border-[var(--border-primary)] file:bg-[var(--bg-card)] file:text-xs file:font-bold file:text-[var(--text-primary)] hover:file:bg-[var(--bg-hover)] file:cursor-pointer transition cursor-pointer">
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1" for="ruGain"><%= isRtl ? 'الهامش الأولي' : 'Initial Headroom' %></label>
                    <select id="ruGain" class="config-input w-full text-xs font-semibold">
                        <option value="0">0 dB</option>
                        <option value="-3">-3 dB</option>
                        <option value="-6">-6 dB</option>
                        <option value="-9">-9 dB</option>
                        <option value="-12">-12 dB</option>
                    </select>
                </div>
                <div id="ruProgressWrap" class="hidden space-y-1">
                    <div class="h-1.5 w-full rounded-full bg-[var(--bg-primary)] overflow-hidden">
                        <div id="ruProgressBar" class="h-full bg-emerald-500 transition-all duration-200" style="width:0%"></div>
                    </div>
                    <div class="flex items-center justify-between text-[10px] text-[var(--text-muted)] font-mono">
                        <span id="ruStatus"><%= isRtl ? 'جارٍ الرفع والتحويل...' : 'Uploading & converting...' %></span>
                        <span id="ruPercent">0%</span>
                    </div>
                </div>
                <div class="flex items-center justify-end gap-2 pt-1">
                    <button type="button" onclick="closeModal('recordingUploadModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" id="ruSubmitBtn" class="config-btn-primary px-4 py-2 text-xs flex items-center gap-2">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0l-4 4m4-4l4 4M4 17v2a1 1 0 001 1h14a1 1 0 001-1v-2"/></svg>
                        <span><%= isRtl ? 'رفع' : 'Upload' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>
    <!-- RECORDING STUDIO / SOX DSP MODAL -->
    <div id="recordingStudioModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-4xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden shadow-2xl">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3 min-w-0">
                    <div class="p-2.5 bg-purple-500/10 text-purple-400 rounded-xl border border-purple-500/20 shrink-0">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-base font-extrabold text-[var(--text-primary)] truncate flex items-center gap-2">
                            <span><%= isRtl ? 'استوديو معالجة الصوت المتقدم (SoX DSP)' : 'Audio Studio & Voice Optimization (SoX DSP)' %></span>
                            <span id="dspTargetNameBadge" class="text-xs px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 font-mono font-bold"></span>
                        </h3>
                        <p class="text-[11px] text-[var(--text-muted)] truncate"><%= isRtl ? 'تحسين وضوح الصوت، ضبط الهامش الديناميكي، معادلة الترددات، والتحويل إلى صيغ الهواتف' : 'Acoustic filters, dynamic leveler, frequency equalization & zero-transcoding codec export' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('recordingStudioModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors shrink-0">✕</button>
            </div>

            <!-- Body -->
            <div class="flex-1 overflow-y-auto p-6 space-y-6">
                <input type="hidden" id="dspRecId" value="">
                <input type="hidden" id="dspRecFilename" value="">

                <!-- Audio Player Hero & Waveform Stats -->
                <div class="rounded-xl border border-[var(--border-primary)] bg-[var(--bg-primary)]/40 p-4 space-y-3">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <button type="button" id="dspPlayBtn" onclick="toggleStudioAudioPreview()" class="w-10 h-10 rounded-xl bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center justify-center hover:bg-emerald-500/25 transition cursor-pointer shrink-0">
                                <svg id="dspPlayIcon" class="w-4 h-4 fill-emerald-400" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                            </button>
                            <div>
                                <span id="dspDisplayTitle" class="text-sm font-extrabold text-[var(--text-primary)] block font-mono"></span>
                                <span id="dspFileStatsText" class="text-[11px] text-[var(--text-muted)] font-mono">8000Hz • 16-bit Mono PCM</span>
                            </div>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 font-mono text-xs">
                            <span class="px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)]">
                                <%= isRtl ? 'المدة:' : 'Length:' %> <b id="dspStatDuration" class="text-white">-</b>
                            </span>
                            <span class="px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)]">
                                <%= isRtl ? 'أعلى سعة:' : 'Peak:' %> <b id="dspStatPeak" class="text-white">-</b>
                            </span>
                            <span class="px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)]">
                                <%= isRtl ? 'متوسط الطاقة:' : 'RMS:' %> <b id="dspStatRms" class="text-white">-</b>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- 1-Click Optimization Presets -->
                <div>
                    <span class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-2">
                        <%= isRtl ? 'قوالب التحسين الجاهزة بنقرة واحدة (1-Click Presets)' : '1-Click Voice Optimization Presets' %>
                    </span>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
                        <button type="button" onclick="applyDspPreset('dongle')" class="p-3 rounded-xl border border-amber-500/30 bg-amber-500/5 hover:bg-amber-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-amber-400 flex items-center gap-1.5 group-hover:underline">
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                <%= isRtl ? 'مخصص للدونجل' : 'GSM Dongle' %>
                            </span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'هامش -18dB + فلتر G.711' : 'Norm -18dB + G.711 bandpass' %></span>
                        </button>
                        <button type="button" onclick="applyDspPreset('broadcast')" class="p-3 rounded-xl border border-blue-500/30 bg-blue-500/5 hover:bg-blue-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-blue-400 flex items-center gap-1.5 group-hover:underline">
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
                                <%= isRtl ? 'تسوية إذاعية' : 'Radio Leveler' %>
                            </span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'ضغط ديناميكي + تضخيم الصوت' : 'Compand + Bass/Treble boost' %></span>
                        </button>
                        <button type="button" onclick="applyDspPreset('clean')" class="p-3 rounded-xl border border-emerald-500/30 bg-emerald-500/5 hover:bg-emerald-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-emerald-400 flex items-center gap-1.5 group-hover:underline">
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"/></svg>
                                <%= isRtl ? 'تنظيف وقص الصمت' : 'Clean & Trim' %>
                            </span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'قص الصمت + تلاشي ناعم' : 'Trim dead air + Fade in/out' %></span>
                        </button>
                        <button type="button" onclick="applyDspPreset('reset')" class="p-3 rounded-xl border border-red-500/30 bg-red-500/5 hover:bg-red-500/15 text-left rtl:text-right transition cursor-pointer group">
                            <span class="text-xs font-bold text-red-400 flex items-center gap-1.5 group-hover:underline">
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                <%= isRtl ? 'الملف الأصلي الخام' : 'Reset to Master' %>
                            </span>
                            <span class="text-[10px] text-[var(--text-muted)] block mt-0.5"><%= isRtl ? 'إلغاء جميع الفلاتر والمؤثرات' : 'Revert to untouched .orig.wav' %></span>
                        </button>
                    </div>
                </div>
                <!-- DSP Controls Grid -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Column 1: Dynamics & Levels -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'مستويات الصوت والديناميكية' : 'Volume, Headroom & Dynamics' %></h4>
                        </div>

                        <!-- Peak Normalizer -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspNormDb" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'الموازنة التلقائية للقمة (Peak Normalizer)' : 'Peak Normalizer (Norm)' %></label>
                                <span class="text-[10px] text-amber-400 font-mono font-bold"><%= isRtl ? 'موصى به' : 'Recommended' %></span>
                            </div>
                            <select id="dspNormDb" class="config-input w-full text-xs">
                                <option value=""><%= isRtl ? 'معطل (استخدام شريط الكسب اليدوي)' : 'Disabled (Use Manual Gain Slider)' %></option>
                                <option value="-18" selected>-18 dBFS (<%= isRtl ? 'موصى به للبوابات والدونجل' : 'Recommended for Dongles' %>)</option>
                                <option value="-12">-12 dBFS (<%= isRtl ? 'تخفيض معتدل' : 'Moderate Headroom' %>)</option>
                                <option value="-6">-6 dBFS (<%= isRtl ? 'تخفيض خفيف' : 'Light Headroom' %>)</option>
                                <option value="0">0 dBFS (<%= isRtl ? 'أقصى سعة قياسية' : 'Full Scale Ceiling' %>)</option>
                            </select>
                        </div>

                        <!-- Manual Gain Slider -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspGainDb" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'مستوى الكسب اليدوي (Manual Gain)' : 'Manual Gain Adjustment (Vol)' %></label>
                                <span id="dspGainBadge" class="text-xs font-bold text-amber-400 font-mono">0 dB</span>
                            </div>
                            <input type="range" id="dspGainDb" min="-50" max="20" step="1" value="0"
                                oninput="document.getElementById('dspGainBadge').textContent = (this.value > 0 ? '+' : '') + this.value + ' dB'; if(this.value != 0) document.getElementById('dspNormDb').value = '';"
                                class="w-full accent-amber-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1">
                                <span>-50 dB</span><span>0 dB</span><span>+20 dB</span>
                            </div>
                        </div>

                        <!-- Voice Compander / Leveler -->
                        <div>
                            <label for="dspCompand" class="text-xs font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'ضاغط ومسوي الصوت (Voice Compander / Leveler)' : 'Voice Leveler (Compand)' %></label>
                            <select id="dspCompand" class="config-input w-full text-xs">
                                <option value="off"><%= isRtl ? 'معطل (Off)' : 'Off (No compression)' %></option>
                                <option value="broadcast"><%= isRtl ? 'بث إذاعي قوي (Broadcast - صوت موحد ومسموع)' : 'Broadcast (Tight, uniform vocal loudness)' %></option>
                                <option value="soft"><%= isRtl ? 'تحسين صوتي خفيف (Soft Vocal Polish)' : 'Soft Vocal Polish (Gentle dynamic smoothing)' %></option>
                            </select>
                        </div>

                        <!-- Fade In & Fade Out -->
                        <div class="grid grid-cols-2 gap-3 pt-1">
                            <div>
                                <label for="dspFadeIn" class="text-[11px] font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'تلاشي البداية (Fade In)' : 'Fade In (sec)' %></label>
                                <input type="number" id="dspFadeIn" min="0" max="2.0" step="0.05" value="0.05" class="config-input w-full text-xs font-mono">
                            </div>
                            <div>
                                <label for="dspFadeOut" class="text-[11px] font-bold text-[var(--text-secondary)] block mb-1"><%= isRtl ? 'تلاشي النهاية (Fade Out)' : 'Fade Out (sec)' %></label>
                                <input type="number" id="dspFadeOut" min="0" max="2.0" step="0.05" value="0.05" class="config-input w-full text-xs font-mono">
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Clarity & EQ -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-blue-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'الفلاتر ونقاء الصوت ومعادلة الترددات' : 'Clarity, Filters & Frequency EQ' %></h4>
                        </div>

                        <!-- Bandpass Filter -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'فلتر الاتصالات القياسي (G.711 Bandpass)' : 'G.711 Telecom Bandpass (300-3400 Hz)' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'عزل ضوضاء الترددات غير الهاتفية وقص فرقعة المايك' : 'Cuts sub-bass rumble (<300Hz) & high hiss (>3.4kHz)' %></span>
                            </div>
                            <input type="checkbox" id="dspBandpass" checked class="w-4 h-4 accent-purple-500 rounded cursor-pointer">
                        </div>

                        <!-- Background Hiss Filter -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'فلتر إزالة صفير وهسيس الخلفية (Hiss / Rumble Filter)' : 'Hiss & Room Noise Filter' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'فلترة أصوات أجهزة التكييف والمراوح في التسجيل' : 'Removes fan hum and air conditioning noise' %></span>
                            </div>
                            <input type="checkbox" id="dspHissFilter" class="w-4 h-4 accent-purple-500 rounded cursor-pointer">
                        </div>

                        <!-- Bass EQ -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspBass" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'تضخيم/تخفيف الباس (Bass EQ)' : 'Bass Equalization' %></label>
                                <span id="dspBassBadge" class="text-xs font-bold text-blue-400 font-mono">0 dB</span>
                            </div>
                            <input type="range" id="dspBass" min="-12" max="12" step="1" value="0"
                                oninput="document.getElementById('dspBassBadge').textContent = (this.value > 0 ? '+' : '') + this.value + ' dB';"
                                class="w-full accent-blue-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1"><span>-12 dB</span><span>0 dB</span><span>+12 dB</span></div>
                        </div>

                        <!-- Treble EQ -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspTreble" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'حدة ووضوح الحروف (Treble EQ)' : 'Treble / Voice Presence' %></label>
                                <span id="dspTrebleBadge" class="text-xs font-bold text-blue-400 font-mono">0 dB</span>
                            </div>
                            <input type="range" id="dspTreble" min="-12" max="12" step="1" value="0"
                                oninput="document.getElementById('dspTrebleBadge').textContent = (this.value > 0 ? '+' : '') + this.value + ' dB';"
                                class="w-full accent-blue-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1"><span>-12 dB</span><span>0 dB</span><span>+12 dB</span></div>
                        </div>
                    </div>

                    <!-- Column 3: Timing & Silence Control -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'السرعة وفترات الصمت قبل/بعد التسجيل' : 'Timing & Silence Padding (Pre/Post-Roll)' %></h4>
                        </div>

                        <!-- Auto-trim silence -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'قص الصمت الأولي (Auto-Trim Silence)' : 'Auto-Trim Silence (Start & End)' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'حذف الفراغات الصامتة القديمة قبل إضافة الصمت النقي الجديد' : 'Strips room noise/dead air before injecting clean silence' %></span>
                            </div>
                            <input type="checkbox" id="dspTrimSilence" checked class="w-4 h-4 accent-emerald-500 rounded cursor-pointer">
                        </div>

                        <!-- Silence Sequence Timeline Preview -->
                        <div class="p-2.5 rounded-lg bg-[var(--bg-primary)] border border-emerald-500/20 text-[10px] font-mono">
                            <div class="text-[9px] font-bold text-[var(--text-muted)] uppercase mb-1.5"><%= isRtl ? 'المخطط الزمني للتسجيل (Timeline Preview)' : 'Audio Timeline Structure' %></div>
                            <div class="flex items-center justify-between gap-1 text-center font-bold">
                                <div id="timelinePreRoll" class="flex-1 py-1 px-1.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 truncate transition-all">
                                    <span>⏸️ <%= isRtl ? 'صمت البداية' : 'Pre' %>:</span> <span id="timelinePreRollVal">+0.20s</span>
                                </div>
                                <span class="text-[var(--text-muted)]">➜</span>
                                <div class="flex-[1.5] py-1 px-1.5 rounded bg-purple-500/10 border border-purple-500/30 text-purple-300 truncate">
                                    <span>🎙️ <%= isRtl ? 'محتوى الصوت' : 'Audio' %></span>
                                </div>
                                <span class="text-[var(--text-muted)]">➜</span>
                                <div id="timelinePostRoll" class="flex-1 py-1 px-1.5 rounded bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 truncate transition-all">
                                    <span>⏸️ <%= isRtl ? 'صمت النهاية' : 'Post' %>:</span> <span id="timelinePostRollVal">+0.20s</span>
                                </div>
                            </div>
                        </div>

                        <!-- Silence Before Recording (Pre-Roll Pad) -->
                        <div class="p-3 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)] space-y-2">
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <input type="checkbox" id="dspEnablePadLead" checked onchange="syncStudioSilenceControls()" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer">
                                    <label for="dspEnablePadLead" class="text-xs font-bold text-[var(--text-primary)] cursor-pointer"><%= isRtl ? 'إضافة صمت قبل بدء التسجيل (Pre-Roll)' : 'Silence Before Recording (Start Pad)' %></label>
                                </div>
                                <span id="dspPadLeadBadge" class="text-xs font-bold text-emerald-400 font-mono">0.20s</span>
                            </div>
                            <div class="grid grid-cols-3 gap-2 items-center">
                                <input type="range" id="dspPadLeadRange" min="0" max="10" step="0.05" value="0.20"
                                    oninput="syncStudioSilenceFromRange('lead')"
                                    class="col-span-2 w-full accent-emerald-500 bg-[var(--bg-card)] h-1.5 rounded-lg cursor-pointer">
                                <div class="flex items-center gap-1">
                                    <input type="number" id="dspPadLead" min="0" max="10" step="0.05" value="0.2"
                                        oninput="syncStudioSilenceFromInput('lead')"
                                        class="config-input w-full text-xs font-mono py-1 px-2 text-center">
                                    <span class="text-[10px] text-[var(--text-muted)] font-mono">s</span>
                                </div>
                            </div>
                            <!-- Quick duration chips -->
                            <div class="flex items-center gap-1.5 pt-0.5 font-mono">
                                <span class="text-[10px] font-bold text-[var(--text-secondary)]"><%= isRtl ? 'فترات سريعة:' : 'Quick:' %></span>
                                <button type="button" onclick="setStudioSilenceQuick('lead', 0.2)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">0.2s</button>
                                <button type="button" onclick="setStudioSilenceQuick('lead', 0.5)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">0.5s</button>
                                <button type="button" onclick="setStudioSilenceQuick('lead', 1.0)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">1.0s</button>
                                <button type="button" onclick="setStudioSilenceQuick('lead', 2.0)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">2.0s</button>
                                <button type="button" onclick="setStudioSilenceQuick('lead', 3.0)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">3.0s</button>
                            </div>
                        </div>

                        <!-- Silence After Recording (Post-Roll Pad) -->
                        <div class="p-3 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)] space-y-2">
                            <div class="flex justify-between items-center">
                                <div class="flex items-center gap-2">
                                    <input type="checkbox" id="dspEnablePadTrail" checked onchange="syncStudioSilenceControls()" class="w-4 h-4 accent-emerald-500 rounded cursor-pointer">
                                    <label for="dspEnablePadTrail" class="text-xs font-bold text-[var(--text-primary)] cursor-pointer"><%= isRtl ? 'إضافة صمت بعد نهاية التسجيل (Post-Roll)' : 'Silence After Recording (End Pad)' %></label>
                                </div>
                                <span id="dspPadTrailBadge" class="text-xs font-bold text-emerald-400 font-mono">0.20s</span>
                            </div>
                            <div class="grid grid-cols-3 gap-2 items-center">
                                <input type="range" id="dspPadTrailRange" min="0" max="10" step="0.05" value="0.20"
                                    oninput="syncStudioSilenceFromRange('trail')"
                                    class="col-span-2 w-full accent-emerald-500 bg-[var(--bg-card)] h-1.5 rounded-lg cursor-pointer">
                                <div class="flex items-center gap-1">
                                    <input type="number" id="dspPadTrail" min="0" max="10" step="0.05" value="0.2"
                                        oninput="syncStudioSilenceFromInput('trail')"
                                        class="config-input w-full text-xs font-mono py-1 px-2 text-center">
                                    <span class="text-[10px] text-[var(--text-muted)] font-mono">s</span>
                                </div>
                            </div>
                            <!-- Quick duration chips -->
                            <div class="flex items-center gap-1.5 pt-0.5 font-mono">
                                <span class="text-[10px] font-bold text-[var(--text-secondary)]"><%= isRtl ? 'فترات سريعة:' : 'Quick:' %></span>
                                <button type="button" onclick="setStudioSilenceQuick('trail', 0.2)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">0.2s</button>
                                <button type="button" onclick="setStudioSilenceQuick('trail', 0.5)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">0.5s</button>
                                <button type="button" onclick="setStudioSilenceQuick('trail', 1.0)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">1.0s</button>
                                <button type="button" onclick="setStudioSilenceQuick('trail', 2.0)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">2.0s</button>
                                <button type="button" onclick="setStudioSilenceQuick('trail', 3.0)" class="px-2 py-0.5 rounded text-[11px] font-black font-mono text-emerald-400 bg-emerald-500/15 hover:bg-emerald-500 hover:text-white border border-emerald-500/30 hover:border-emerald-400 transition-all cursor-pointer">3.0s</button>
                            </div>
                        </div>

                        <!-- Tempo / Speech Pacing -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label for="dspTempo" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'سرعة الإلقاء (Speech Tempo)' : 'Speech Pacing / Speed (Pitch-Preserved)' %></label>
                                <span id="dspTempoBadge" class="text-xs font-bold text-emerald-400 font-mono">1.00x</span>
                            </div>
                            <input type="range" id="dspTempo" min="0.70" max="1.40" step="0.05" value="1.00"
                                oninput="document.getElementById('dspTempoBadge').textContent = parseFloat(this.value).toFixed(2) + 'x';"
                                class="w-full accent-emerald-500 bg-[var(--bg-primary)] h-1.5 rounded-lg cursor-pointer">
                            <div class="flex justify-between text-[9px] font-mono text-[var(--text-muted)] mt-1"><span>0.70x</span><span>1.00x</span><span>1.40x</span></div>
                        </div>
                    </div>

                    <!-- Column 4: Codecs & Asterisk Performance -->
                    <div class="space-y-4 p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)]">
                        <div class="flex items-center gap-2 pb-2 border-b border-[var(--border-primary)]">
                            <div class="w-2 h-2 rounded-full bg-purple-400"></div>
                            <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= isRtl ? 'أداء المقسم وتوليد الصيغ المباشرة' : 'PBX Performance & Multi-Codec Cache' %></h4>
                        </div>

                        <!-- Pre-render Multi-Codec -->
                        <div class="flex items-center justify-between gap-3 p-2.5 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)]">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'توليد الصيغ الأصلية (Multi-Codec Cache)' : 'Multi-Codec Direct Cache' %></span>
                                <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'توليد صيغ GSM و ALAW و ULAW لمنع استهلاك معالج المقسم' : 'Pre-renders .gsm, .alaw, .ulaw for 0% CPU transcoding' %></span>
                            </div>
                            <input type="checkbox" id="dspGenerateCodecs" checked class="w-4 h-4 accent-purple-500 rounded cursor-pointer">
                        </div>

                        <!-- Codec Status Indicators -->
                        <div>
                            <span class="text-xs font-bold text-[var(--text-secondary)] block mb-2"><%= isRtl ? 'حالة الصيغ المولدة على القرص:' : 'Rendered Codec Files on Disk:' %></span>
                            <div class="grid grid-cols-2 gap-2 text-xs font-mono" id="dspCodecPillsContainer">
                                <div id="dspCodecWav" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.wav (PCM)</span>
                                    <span class="text-emerald-400 font-bold">✓</span>
                                </div>
                                <div id="dspCodecGsm" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.gsm (Mobile)</span>
                                    <span id="dspGsmStatus" class="text-[var(--text-muted)]">-</span>
                                </div>
                                <div id="dspCodecAlaw" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.alaw (ISDN/SIP)</span>
                                    <span id="dspAlawStatus" class="text-[var(--text-muted)]">-</span>
                                </div>
                                <div id="dspCodecUlaw" class="p-2 rounded bg-[var(--bg-primary)] border border-[var(--border-primary)] flex items-center justify-between">
                                    <span>.ulaw (G.711u)</span>
                                    <span id="dspUlawStatus" class="text-[var(--text-muted)]">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="flex items-center justify-between px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <button type="button" onclick="closeModal('recordingStudioModal')" class="px-4 py-2 rounded-xl text-xs font-bold text-[var(--text-secondary)] hover:bg-[var(--bg-card)] border border-[var(--border-primary)] cursor-pointer">
                    <%= isRtl ? 'إلغاء' : 'Close' %>
                </button>
                <div class="flex items-center gap-2.5">
                    <button type="button" onclick="resetRecordingStudioMaster()" class="px-3 py-2 rounded-xl text-xs font-bold text-red-400 hover:bg-red-500/10 border border-red-500/30 flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        <span><%= isRtl ? 'استعادة الأصل' : 'Revert to Original' %></span>
                    </button>
                    <button type="button" id="dspApplyBtn" onclick="saveRecordingStudioDsp()" class="config-btn-primary px-5 py-2 text-xs flex items-center gap-2 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        <span><%= isRtl ? 'تطبيق وحفظ المؤثرات' : 'Apply & Save Audio DSP' %></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL: EDIT CALL CONTROL CODE -->
    <div id="callCodeModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-[99999] flex items-center justify-center hidden p-4 sm:p-6" onclick="if(event.target===this)closeModal('callCodeModal')">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] max-w-md w-full p-5 sm:p-6 text-[var(--text-primary)] shadow-2xl flex flex-col animate-fade-in" onclick="event.stopPropagation()">
            <!-- Header -->
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 mb-4">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="p-2 rounded-xl bg-rose-500/15 text-rose-400 border border-rose-500/30 shrink-0">
                        <svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                    </span>
                    <div class="min-w-0">
                        <h4 id="cfgCallCodeModalTitle" class="text-sm sm:text-base font-extrabold text-[var(--text-primary)] truncate">Edit Call Code</h4>
                        <p id="cfgCallCodeModalSubtitle" class="text-[11px] text-[var(--text-muted)] truncate"></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('callCodeModal')" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1.5 rounded-lg hover:bg-[var(--bg-hover)] transition cursor-pointer shrink-0">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Body -->
            <form id="cfgCallCodeEditForm" onsubmit="event.preventDefault(); saveConfigCallCodeEdit();" class="space-y-3.5">
                <input type="hidden" id="cfgEditCallCodeId">

                <!-- Code input -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label for="cfgEditCallCodeInput" class="text-xs font-bold text-[var(--text-secondary)]"><%= isRtl ? 'الكود الرقمي' : 'Dial Code / Prefix' %></label>
                        <span id="cfgEditCallCodeDefaultBadge" class="text-[10px] font-mono text-[var(--text-muted)] bg-[var(--bg-card)] px-2 py-0.5 rounded border border-[var(--border-primary)]"></span>
                    </div>
                    <div class="flex items-center gap-2">
                        <input type="text" id="cfgEditCallCodeInput" required class="flex-1 font-mono font-bold text-sm bg-[var(--bg-card)] border border-[var(--border-primary)] focus:border-rose-500 rounded-xl px-3 py-2 text-[var(--text-primary)] focus:outline-none transition">
                        <button type="button" onclick="revertConfigCallCodeToDefault()" class="px-2.5 py-2 text-xs font-black bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/30 rounded-xl transition cursor-pointer shadow-sm" title="<%= isRtl ? 'استعادة القيمة الافتراضية' : 'Revert to default' %>">
                            <span><%= isRtl ? 'الافتراضي' : 'Default' %></span>
                        </button>
                    </div>
                    <p class="text-[10px] text-[var(--text-muted)] mt-1"><%= isRtl ? 'أدخل الكود المطلوب ثم اضغط حفظ لتطبيقه مباشرة في أستيركس.' : 'Enter new code/prefix and save to apply immediately in Asterisk.' %></p>
                </div>

                <!-- Example string -->
                <div>
                    <label for="cfgEditCallCodeExampleInput" class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5"><%= isRtl ? 'المثال التوضيحي' : 'Usage Example' %></label>

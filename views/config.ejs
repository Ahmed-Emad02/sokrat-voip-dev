        // --- 8. CONFIG DIAGRAM ENGINE ---
        let diagramRawData = null;
        let diagramNodesList = [];
        let diagramLinks = [];
        let diagramRenderCtx = null; // { cardWidth, cardHeight, makeWirePath } set by renderDiagram
        let diagramCardDrag = null;

        let zoomScale = 1.0;
        let panX = 0;
        let panY = 0;
        let isDragging = false;
        let startX, startY;
        let isPanZoomInitialized = false;

        const DIAGRAM_LAYOUT_KEY = 'config_diagram_layout_v1';

        const WIRE_COLORS = {
            'inbound-dest': '#10b981', 'inbound-tc': '#eab308', 'inbound-ivr': '#3b82f6',
            'tc-true': '#10b981', 'tc-false': '#ef4444', 'tc-ivr': '#3b82f6',
            'ivr-entry': '#3b82f6', 'ivr-timeout': '#f59e0b', 'ivr-invalid': '#ef4444',
            'rg-member': '#a855f7', 'queue-member': '#f59e0b', 'queue-failover': '#ef4444',
            'queue-continue': '#38bdf8', 'ext-route-restricted': '#f97316', 'ext-route-global': '#64748b',
            'route-trunk': '#06b6d4'
        };
        const FAILING_WIRES = new Set(['tc-false', 'ivr-invalid', 'queue-failover']);

        function saveDiagramNodePosition(nodeId, x, y) {
            try {
                const saved = JSON.parse(localStorage.getItem(DIAGRAM_LAYOUT_KEY)) || {};
                saved[nodeId] = { x: Math.round(x), y: Math.round(y) };
                localStorage.setItem(DIAGRAM_LAYOUT_KEY, JSON.stringify(saved));
            } catch (_) {}
        }

        window.resetDiagramLayout = function () {
            try { localStorage.removeItem(DIAGRAM_LAYOUT_KEY); } catch (_) {}
            renderDiagram();
            sizeDiagramCanvas();
            setTimeout(fitDiagramToScreen, 50);
        };

        // Stretch the diagram canvas to consume all remaining viewport space
        function sizeDiagramCanvas() {
            const section = document.getElementById('section-diagram');
            const container = document.getElementById('diagramCanvasContainer');
            if (!section || !container || section.classList.contains('hidden')) return;
            const top = container.getBoundingClientRect().top;
            const available = window.innerHeight - top - 24;
            container.style.height = Math.max(560, Math.floor(available)) + 'px';
        }
        window.sizeDiagramCanvas = sizeDiagramCanvas;
        window.addEventListener('resize', () => {
            sizeDiagramCanvas();
            if (typeof fitDiagramToScreen === 'function' && diagramNodesList.length) fitDiagramToScreen();
        });

        function initDiagramNodeDragging() {
            const svgNodes = document.getElementById('diagramNodes');
            if (!svgNodes || svgNodes.dataset.dragInit === '1') return;
            svgNodes.dataset.dragInit = '1';

            const toSvgCoords = (clientX, clientY) => {
                const svg = document.getElementById('diagramSvg');
                const rect = svg.getBoundingClientRect();
                return {
                    x: (clientX - rect.left - panX) / zoomScale,
                    y: (clientY - rect.top - panY) / zoomScale
                };
            };

            svgNodes.addEventListener('pointerdown', (e) => {
                if (e.button !== 0) return;
                const cardEl = e.target.closest && e.target.closest('[data-node-id]');
                if (!cardEl) return;
                const nodeId = cardEl.getAttribute('data-node-id');
                const node = diagramNodesList.find(n => n.id === nodeId);
                if (!node || !diagramRenderCtx) return;
                e.stopPropagation();
                const pt = toSvgCoords(e.clientX, e.clientY);
                diagramCardDrag = {
                    node,
                    fo: cardEl.closest('foreignObject'),
                    dx: pt.x - node.x,
                    dy: pt.y - node.y,
                    moved: false
                };
                const svgEl = document.getElementById('diagramSvg');
                if (svgEl) svgEl.classList.add('wires-live');
                try { cardEl.setPointerCapture(e.pointerId); } catch (_) {}
            }, true);

            svgNodes.addEventListener('pointermove', (e) => {
                if (!diagramCardDrag) return;
                const ctx = diagramRenderCtx;
                const pt = toSvgCoords(e.clientX, e.clientY);
                let nx = pt.x - diagramCardDrag.dx;
                let ny = pt.y - diagramCardDrag.dy;
                if (!diagramCardDrag.moved && (Math.abs(nx - diagramCardDrag.node.x) > 2 || Math.abs(ny - diagramCardDrag.node.y) > 2)) {
                    diagramCardDrag.moved = true;
                    document.body.style.userSelect = 'none';
                }
                if (!diagramCardDrag.moved) return;

                // No invisible walls: the coordinate space starts at (0,0), so dragging
                // past the top/left edge shifts the WHOLE board (nodes, cards, wires)
                // instead of blocking the card.
                const EDGE_PAD = 60;
                if (nx < EDGE_PAD || ny < EDGE_PAD) {
                    const shiftX = nx < EDGE_PAD ? Math.ceil(EDGE_PAD - nx) : 0;
                    const shiftY = ny < EDGE_PAD ? Math.ceil(EDGE_PAD - ny) : 0;
                    if (shiftX || shiftY) {
                        diagramNodesList.forEach(n => { n.x += shiftX; n.y += shiftY; });
                        const nodeById = new Map(diagramNodesList.map(n => [n.id, n]));
                        svgNodes.querySelectorAll('foreignObject').forEach(fo => {
                            const div = fo.querySelector && fo.querySelector('[data-node-id]');
                            const n = div ? nodeById.get(div.getAttribute('data-node-id')) : null;
                            if (n) {
                                fo.setAttribute('x', n.x);
                                fo.setAttribute('y', n.y);
                            }
                        });
                        document.querySelectorAll('.diagram-wire').forEach(wire => {
                            const src = nodeById.get(wire.getAttribute('data-src'));
                            const tgt = nodeById.get(wire.getAttribute('data-tgt'));
                            if (src && tgt) {
                                wire.removeAttribute('stroke-dasharray');
                                wire.removeAttribute('stroke-dashoffset');
                                wire.setAttribute('d', ctx.makeWirePath(src, tgt));
                            }
                        });
                        nx += shiftX;
                        ny += shiftY;
                    }
                }

                diagramCardDrag.node.x = nx;
                diagramCardDrag.node.y = ny;
                if (diagramCardDrag.fo) {
                    diagramCardDrag.fo.setAttribute('x', nx);
                    diagramCardDrag.fo.setAttribute('y', ny);
                }

                // Grow the canvas on demand — dragging toward any edge expands the
                // drawable area instead of clipping the card.
                const svgEl = document.getElementById('diagramSvg');
                if (svgEl) {
                    const curW = parseFloat(svgEl.getAttribute('width')) || 0;
                    const curH = parseFloat(svgEl.getAttribute('height')) || 0;
                    const needW = nx + ctx.cardWidth + 160;
                    const needH = ny + ctx.cardHeight + 160;
                    if (needW > curW) {
                        svgEl.setAttribute('width', String(Math.ceil(needW)));
                        svgEl.style.width = Math.ceil(needW) + 'px';
                    }
                    if (needH > curH) {
                        svgEl.setAttribute('height', String(Math.ceil(needH)));
                        svgEl.style.height = Math.ceil(needH) + 'px';
                    }
                }

                const attached = document.querySelectorAll(
                    `.diagram-wire[data-src="${CSS.escape(diagramCardDrag.node.id)}"], .diagram-wire[data-tgt="${CSS.escape(diagramCardDrag.node.id)}"]`
                );
                attached.forEach(wire => {
                    const src = diagramNodesList.find(n => n.id === wire.getAttribute('data-src'));
                    const tgt = diagramNodesList.find(n => n.id === wire.getAttribute('data-tgt'));
                    if (src && tgt) {
                        // Stale draw-in dash state (attribute OR style) would break the
                        // stretched path into pieces
                        wire.removeAttribute('stroke-dasharray');
                        wire.removeAttribute('stroke-dashoffset');
                        wire.style.removeProperty('stroke-dasharray');
                        wire.style.removeProperty('stroke-dashoffset');
                        wire.setAttribute('d', ctx.makeWirePath(src, tgt));
                    }
                });
            }, true);

            const endDrag = (e) => {
                if (!diagramCardDrag) return;
                if (diagramCardDrag.moved) {
                    saveDiagramNodePosition(diagramCardDrag.node.id, diagramCardDrag.node.x, diagramCardDrag.node.y);
                }
                diagramCardDrag = null;
                document.body.style.userSelect = '';
                const svgEl = document.getElementById('diagramSvg');
                if (svgEl) svgEl.classList.remove('wires-live');
            };
            svgNodes.addEventListener('pointerup', endDrag, true);
            svgNodes.addEventListener('pointercancel', endDrag, true);
        }

        function fetchDiagramData() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            if (!svgNodes || !svgWires) return;

            svgNodes.innerHTML = `<foreignObject x="400" y="300" width="400" height="100">
                <div class="text-center text-[var(--text-muted)] italic text-sm">
                    ${isRtl ? 'جاري تحميل مخطط الإعدادات...' : 'Loading config diagram...'}
                </div>
            </foreignObject>`;
            svgWires.innerHTML = '';

            fetch('/api/config/diagram?t=' + Date.now())
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        showToast(data.error || 'Failed to fetch diagram data', 'error');
                        return;
                    }
                    diagramRawData = data;
                    renderDiagram();
                    sizeDiagramCanvas();
                    if (!isPanZoomInitialized) {
                        initPanZoom();
                        isPanZoomInitialized = true;
                    }
                    setTimeout(fitDiagramToScreen, 50);
                })
                .catch(err => {
                    showToast(err.message, 'error');
                });
        }
        window.fetchDiagramData = fetchDiagramData;
        function renderDiagramPipeline() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            const svg = document.getElementById('diagramSvg');
            const canvas = document.getElementById('diagramCanvasContainer');
            if (!svgNodes || !svgWires || !svg || !canvas || !diagramRawData) return;

            svgNodes.innerHTML = '';
            svgWires.innerHTML = '';

            const cardWidth = 280;
            const cardHeight = 135;

            function formatDestination(dest) {
                if (!dest) return isRtl ? 'غير محدد' : 'Not set';
                if (dest.startsWith('ext-group,')) {
                    return `${isRtl ? 'مجموعة:' : 'Group:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                    return `${isRtl ? 'تحويلة:' : 'Extension:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    const ivrObj = (diagramRawData.ivrs || []).find(i => String(i.id) === String(ivrId));
                    return `IVR: ${ivrObj ? ivrObj.name : ivrId}`;
                }
                if (dest.startsWith('ext-queues,')) {
                    return `${isRtl ? 'طابور:' : 'Queue:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                    const conditionId = dest.split(',')[1];
                    const condition = (diagramRawData.timeconditions || [])
                        .find(tc => String(tc.timeconditions_id) === String(conditionId));
                    return `${isRtl ? 'شرط زمني' : 'Time Condition'}: ${condition ? condition.displayname : conditionId}`;
                }
                if (dest.startsWith('ext-external-failover,') || dest.startsWith('from-internal,')) {
                    const rawTarget = dest.split(',')[1] || '';
                    const phone = rawTarget.split('/')[0].split('@')[0];
                    const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                    if (phone) {
                        const dongleLabel = dongle ? ` (${dongle})` : '';
                        return `${isRtl ? 'رقم خارجي:' : 'External:'} ${phone}${dongleLabel}`;
                    }
                }
                return dest;
            }

            function resolveTargetNodeId(dest) {
                if (!dest) return null;
                if (dest.startsWith('ext-group,')) return 'ringgroup-' + dest.split(',')[1];
                if (dest.startsWith('ext-queues,')) return 'queue-' + dest.split(',')[1];
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) return 'extension-' + dest.split(',')[1];
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) return 'timecondition-' + dest.split(',')[1];
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    return 'ivr-' + ivrId;
                }
                return null;
            }

            const inbound = diagramRawData.inbound || [];
            const ringgroups = diagramRawData.ringgroups || [];
            const extensions = diagramRawData.extensions || [];
            const outbound = diagramRawData.outbound || [];
            const trunks = diagramRawData.trunks || [];
            const timeconditions = diagramRawData.timeconditions || [];
            const queues = diagramRawData.queues || [];
            const ivrs = diagramRawData.ivrs || [];

            diagramNodesList = [];

            // 1. Inbound Nodes
            inbound.forEach((route, i) => {
                const nodeId = 'inbound-' + (route.did || 'any') + '-' + i;
                diagramNodesList.push({
                    id: nodeId,
                    type: 'inbound',
                    title: route.did ? `DID: ${route.did}` : (isRtl ? 'أي رقم وارد' : 'Any DID'),
                    subtitle: route.description || (isRtl ? 'مسار وارد' : 'Inbound Route'),
                    desc: route.destination,
                    data: route
                });
            });

            // 2. Ring Groups Nodes
            ringgroups.forEach((rg, i) => {
                diagramNodesList.push({
                    id: 'ringgroup-' + rg.grpnum,
                    type: 'ringgroup',
                    title: `${isRtl ? 'مجموعة:' : 'Group:'} ${rg.grpnum}`,
                    subtitle: rg.description || (isRtl ? 'مجموعة اتصال' : 'Ring Group'),
                    desc: `${isRtl ? 'الاستراتيجية:' : 'Strategy:'} ${rg.strategy}`,
                    data: rg
                });
            });

            // 2.5 IVR Nodes
            ivrs.forEach((ivr, i) => {
                const entriesCount = Array.isArray(ivr.entries) ? ivr.entries.length : 0;
                diagramNodesList.push({
                    id: 'ivr-' + ivr.id,
                    type: 'ivr',
                    title: `${isRtl ? 'الرد الآلي:' : 'IVR:'} ${ivr.name}`,
                    subtitle: ivr.description || (isRtl ? 'قائمة الرد الآلي' : 'IVR Menu'),
                    desc: `${isRtl ? 'خيارات:' : 'Options:'} ${entriesCount}`,
                    data: ivr
                });
            });

            // 3. Queues Nodes
            queues.forEach((q, i) => {
                diagramNodesList.push({
                    id: 'queue-' + q.extension,
                    type: 'queue',
                    title: `${isRtl ? 'طابور:' : 'Queue:'} ${q.extension}`,
                    subtitle: q.descr || (isRtl ? 'طابور انتظار' : 'Call Queue'),
                    desc: `${isRtl ? 'أقصى وقت:' : 'Max Wait:'} ${q.maxwait === '0' || !q.maxwait ? 'Unlimited' : q.maxwait + 's'}`,
                    data: q
                });
            });

            // 4. Extensions Nodes
            extensions.forEach((ext, i) => {
                diagramNodesList.push({
                    id: 'extension-' + ext.extension,
                    type: 'extension',
                    title: `${isRtl ? 'تحويلة:' : 'Ext:'} ${ext.extension}`,
                    subtitle: ext.name || (isRtl ? 'تحويلة SIP' : 'SIP Extension'),
                    desc: ext.voicemail === 'novm' ? (isRtl ? 'البريد مغلق' : 'Voicemail Off') : (isRtl ? 'البريد مفعل' : 'Voicemail On'),
                    data: ext
                });
            });

            // 5. Outbound Routes Nodes
            outbound.forEach((route, i) => {
                const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                const patternStr = patterns.map(p => p.pattern).filter(Boolean).slice(0, 2).join(', ');
                diagramNodesList.push({
                    id: 'outbound-' + route.route_id,
                    type: 'outbound',
                    title: route.name,
                    subtitle: isRtl ? 'مسار صادر' : 'Outbound Route',
                    desc: patternStr ? `${isRtl ? 'أنماط:' : 'Patterns:'} ${patternStr}` : (isRtl ? 'بلا أنماط' : 'No patterns'),
                    data: route
                });
            });

            // 6. Trunks Nodes
            trunks.forEach((tk, i) => {
                diagramNodesList.push({
                    id: 'trunk-' + tk.trunkid,
                    type: 'trunk',
                    title: tk.name,
                    subtitle: `${tk.tech ? tk.tech.toUpperCase() : 'SIP'} Trunk`,
                    desc: (tk.disabled === 'on') ? (isRtl ? 'معطل' : 'Disabled') : (isRtl ? 'نشط' : 'Active'),
                    data: tk
                });
            });
            // 7. Time Conditions Nodes
            timeconditions.forEach((tc, i) => {
                const scheduleStr = tc.details ? tc.details.map(d => d.time + ' ' + d.name).join('; ') : '';
                diagramNodesList.push({
                    id: 'timecondition-' + tc.timeconditions_id,
                    type: 'timecondition',
                    title: tc.displayname || (isRtl ? 'شرط زمني' : 'Time Condition'),
                    subtitle: tc.timegroup_name || (isRtl ? 'غير محدد' : 'No group'),
                    desc: scheduleStr || '',
                    data: tc
                });
            });

            diagramLinks = [];

            // Link 1: Inbound -> Ring Groups, Queues, or Extensions
            // Link 1: Inbound -> Destinations
            inbound.forEach((route, idx) => {
                const dest = route.destination || '';
                const targetId = resolveTargetNodeId(dest);
                let wireType = 'inbound-dest';
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) wireType = 'inbound-tc';
                else if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'inbound-ivr';
                if (targetId) {
                    diagramLinks.push({
                        id: `link-inbound-${idx}`,
                        source: 'inbound-' + (route.did || 'any') + '-' + idx,
                        target: targetId,
                        type: wireType
                    });
                }
            });

            // Link 2: Time Condition -> Destinations
            timeconditions.forEach(tc => {
                const trueDest = tc.truegoto || '';
                const falseDest = tc.falsegoto || '';
                [trueDest, falseDest].forEach((dest, isFalse) => {
                    const targetId = resolveTargetNodeId(dest);
                    let wireType = isFalse ? 'tc-false' : 'tc-true';
                    if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'tc-ivr';
                    if (targetId) {
                        diagramLinks.push({
                            id: 'link-tc-' + tc.timeconditions_id + '-' + (isFalse ? 'false' : 'true') + '-' + targetId,
                            source: 'timecondition-' + tc.timeconditions_id,
                            target: targetId,
                            type: wireType
                        });
                    }
                });
            });

            // Link 2.5: IVR -> Options & Destinations
            ivrs.forEach(ivr => {
                const entries = Array.isArray(ivr.entries) ? ivr.entries : [];
                entries.forEach((entry, idx) => {
                    const targetId = resolveTargetNodeId(entry.dest);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-entry-${entry.selection}-${idx}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-entry'
                        });
                    }
                });
                if (ivr.timeout_destination) {
                    const targetId = resolveTargetNodeId(ivr.timeout_destination);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-timeout-${targetId}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-timeout'
                        });
                    }
                }
                if (ivr.invalid_destination) {
                    const targetId = resolveTargetNodeId(ivr.invalid_destination);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-invalid-${targetId}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-invalid'
                        });
                    }
                }
            });

            // Link 3: Ring Group -> Extensions
            ringgroups.forEach(rg => {
                const members = rg.grplist ? rg.grplist.split('-') : [];
                members.forEach(ext => {
                    const extExists = extensions.some(e => String(e.extension) === String(ext));
                    if (extExists) {
                        diagramLinks.push({
                            id: `link-rg-${rg.grpnum}-${ext}`,
                            source: 'ringgroup-' + rg.grpnum,
                            target: 'extension-' + ext,
                            type: 'rg-member'
                        });
                    }
                });
            });

            // Link 3.5: Queue -> Extensions
            queues.forEach(q => {
                const members = Array.isArray(q.static_members) ? q.static_members : [];
                members.forEach(ext => {
                    const extExists = extensions.some(e => String(e.extension) === String(ext));
                    if (extExists) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-${ext}`,
                            source: 'queue-' + q.extension,
                            target: 'extension-' + ext,
                            type: 'queue-member'
                        });
                    }
                });
            });

            // Link 3.6: Queue -> Failover and Continue Destinations
            queues.forEach(q => {
                if (q.dest) {
                    const targetId = resolveTargetNodeId(q.dest);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-failover-${targetId}`,
                            source: 'queue-' + q.extension,
                            target: targetId,
                            type: 'queue-failover'
                        });
                    }
                }
                if (q.destcontinue) {
                    const targetId = resolveTargetNodeId(q.destcontinue);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-continue-${targetId}`,
                            source: 'queue-' + q.extension,
                            target: targetId,
                            type: 'queue-continue'
                        });
                    }
                }
            });

            // Link 4: Extension -> Outbound Routes
            extensions.forEach(ext => {
                outbound.forEach(route => {
                    const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                    const hasRestrictedCid = patterns.some(p => String(p.cid) === String(ext.extension));
                    const hasGlobalRoute = patterns.some(p => !p.cid || p.cid === '');
                    if (hasRestrictedCid) {
                        diagramLinks.push({
                            id: `link-ext-outbound-${ext.extension}-${route.route_id}`,
                            source: 'extension-' + ext.extension,
                            target: 'outbound-' + route.route_id,
                            type: 'ext-route-restricted'
                        });
                    } else if (hasGlobalRoute) {
                        diagramLinks.push({
                            id: `link-ext-outbound-global-${ext.extension}-${route.route_id}`,
                            source: 'extension-' + ext.extension,
                            target: 'outbound-' + route.route_id,
                            type: 'ext-route-global'
                        });
                    }
                });
            });

            // Link 5: Outbound Route -> Trunks
            outbound.forEach(route => {
                const routeTrunks = Array.isArray(route.trunks) ? route.trunks : [];
                routeTrunks.forEach(tk => {
                    const tkId = tk.trunk_id || tk.trunkid;
                    const matchedTrunk = trunks.find(t => String(t.trunkid) === String(tkId) || (tk.trunk_name && String(t.name) === String(tk.trunk_name)));
                    const targetTrunkId = matchedTrunk ? matchedTrunk.trunkid : tkId;
                    if (targetTrunkId !== undefined && targetTrunkId !== null) {
                        diagramLinks.push({
                            id: `link-outbound-trunk-${route.route_id}-${targetTrunkId}`,
                            source: 'outbound-' + route.route_id,
                            target: 'trunk-' + targetTrunkId,
                            type: 'route-trunk'
                        });
                    }
                });
            });

            // -----------------------------------------------------------------
            // Layered auto-layout (Sugiyama-lite):
            //   1) layer = longest path from any source (cycle tolerant)
            //   2) barycenter ordering sweeps to reduce wire crossings
            //   3) x by layer, vertically centered stacks per layer
            // Manual drags are persisted in localStorage and win over auto layout.
            // -----------------------------------------------------------------
            function computeDiagramLayout() {
                const columnGap = 110;
                const rowGap = 34;
                const colSpacing = cardWidth + columnGap;
                const ySpacing = cardHeight + rowGap;
                const marginX = 60;
                const marginTop = 50;
                const bottomPadding = 50;

                const nodeById = new Map(diagramNodesList.map(n => [n.id, n]));

                // 1) Longest-path layering
                const layerOf = new Map(diagramNodesList.map(n => [n.id, 0]));
                const maxIters = diagramNodesList.length + 2;
                for (let iter = 0; iter < maxIters; iter++) {
                    let changed = false;
                    diagramLinks.forEach(link => {
                        const s = layerOf.get(link.source) || 0;
                        const cur = layerOf.get(link.target) || 0;
                        if (s >= cur && s < diagramNodesList.length) {
                            layerOf.set(link.target, s + 1);
                            changed = true;
                        }
                    });
                    if (!changed) break;
                }

                // 2) Group by layer + barycenter ordering
                const maxLayer = Math.max(0, ...layerOf.values());
                const layers = [];
                for (let l = 0; l <= maxLayer; l++) layers.push([]);
                diagramNodesList.forEach(n => layers[layerOf.get(n.id)].push(n));

                const posInLayer = new Map();
                layers.forEach(nodes => nodes.forEach((n, i) => posInLayer.set(n.id, i)));
                const preds = new Map(diagramNodesList.map(n => [n.id, []]));
                const succs = new Map(diagramNodesList.map(n => [n.id, []]));
                diagramLinks.forEach(l => {
                    if (nodeById.has(l.source) && nodeById.has(l.target)) {
                        succs.get(l.source).push(l.target);
                        preds.get(l.target).push(l.source);
                    }
                });
                const bary = ids => ids.length
                    ? ids.reduce((sum, id) => sum + (posInLayer.get(id) || 0), 0) / ids.length
                    : Infinity;

                for (let sweep = 0; sweep < 4; sweep++) {
                    const down = sweep % 2 === 0;
                    const order = down
                        ? layers.map((_, i) => i).slice(1)
                        : layers.map((_, i) => i).reverse().slice(0, -1);
                    order.forEach(li => {
                        layers[li]
                            .map((n, i) => ({ n, i, b: down ? bary(preds.get(n.id)) : bary(succs.get(n.id)) }))
                            .sort((a, b2) => (a.b === b2.b ? a.i - b2.i : a.b - b2.b))
                            .forEach((entry, i) => {
                                layers[li][i] = entry.n;
                                posInLayer.set(entry.n.id, i);
                            });
                    });
                }

                // 3) Coordinates — each layer stack centered on the shared midline
                const densest = Math.max(1, ...layers.map(l => l.length));
                const contentHeight = Math.max(560, marginTop + densest * ySpacing - rowGap + bottomPadding);
                const midY = contentHeight / 2 - cardHeight / 2;
                layers.forEach((nodes, li) => {
                    const stackHeight = nodes.length * ySpacing - rowGap;
                    const startY = midY - stackHeight / 2 + (nodes.length ? rowGap / 2 : 0);
                    nodes.forEach((n, i) => {
                        n.x = Math.round(marginX + li * colSpacing);
                        n.y = Math.round(startY + i * ySpacing);
                    });
                });

                // Saved manual positions override the auto layout
                let saved = null;
                try { saved = JSON.parse(localStorage.getItem('config_diagram_layout_v1')); } catch (_) {}
                if (saved && typeof saved === 'object') {
                    diagramNodesList.forEach(n => {
                        if (saved[n.id] && Number.isFinite(saved[n.id].x) && Number.isFinite(saved[n.id].y)) {
                            n.x = saved[n.id].x;
                            n.y = saved[n.id].y;
                        }
                    });
                }

                const maxUsedLayer = layers.reduce((m, l, li) => l.length ? Math.max(m, li) : m, 0);
                return {
                    width: marginX * 2 + maxUsedLayer * colSpacing + cardWidth,
                    height: contentHeight
                };
            }

            const layoutSize = computeDiagramLayout();
            svg.style.height = `${layoutSize.height}px`;
            svg.style.width = `${layoutSize.width}px`;
            svg.setAttribute('height', String(layoutSize.height));
            svg.setAttribute('width', String(layoutSize.width));

            diagramRenderCtx = {
                cardWidth,
                cardHeight,
                makeWirePath
            };
            initDiagramNodeDragging();

            const colSpacing = cardWidth + 110;

            // Arrowhead markers — one per stroke color used by the wires
            const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
            defs.innerHTML = Object.entries(WIRE_COLORS).map(([type, color]) =>
                `<marker id="arrow-${type}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 1 L 9 5 L 0 9 z" fill="${color}"/></marker>`
            ).join('');
            svgWires.appendChild(defs);

            function makeWirePath(sourceNode, targetNode) {
                const x1 = sourceNode.x + cardWidth;
                const y1 = sourceNode.y + cardHeight / 2;
                const x2 = targetNode.x - 4;
                const y2 = targetNode.y + cardHeight / 2;

                const colDistance = Math.abs(x2 - x1);
                if (colDistance > colSpacing * 1.2) {
                    const arcOffset = (y1 <= y2) ? -55 : 55;
                    const controlY1 = y1 + arcOffset;
                    const controlY2 = y2 + arcOffset;
                    return `M ${x1} ${y1} C ${x1 + colSpacing * 0.4} ${controlY1}, ${x2 - colSpacing * 0.4} ${controlY2}, ${x2} ${y2}`;
                }
                const dx = colDistance * 0.42;
                const controlX1 = (x2 >= x1) ? (x1 + dx) : (x1 - dx);
                const controlX2 = (x2 >= x1) ? (x2 - dx) : (x2 + dx);
                const dy = y2 - y1;
                const bow = (dy >= 0 ? 1 : -1) * Math.min(25, Math.abs(dy) * 0.2);
                return `M ${x1} ${y1} C ${controlX1} ${y1 + bow}, ${controlX2} ${y2 - bow}, ${x2} ${y2}`;

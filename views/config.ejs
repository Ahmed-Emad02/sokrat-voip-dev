                            </div>
                        </div>
                        <div class="mt-2 text-[10px] text-gray-300 font-semibold space-y-0.5 bg-[#16161c] p-1.5 rounded border border-white/5 font-mono">
                            <div class="flex justify-between"><span>${isRtl ? 'الاستراتيجية:' : 'Strategy:'}</span> <span class="text-white">${q.strategy || 'rrmemory'}</span></div>
                            <div class="flex justify-between"><span>${isRtl ? 'الموسيقى:' : 'Music:'}</span> <span class="text-white">${q.musicclass || 'default'}</span></div>
                            <div class="flex justify-between"><span>${isRtl ? 'الانقطاع:' : 'Failover:'}</span> <span class="text-amber-400 truncate max-w-[170px]">${formatDestination(q.dest)}</span></div>

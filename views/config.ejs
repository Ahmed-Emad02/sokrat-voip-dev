                    <input type="text" id="editPeerHost" required class="config-input w-full font-mono text-xs">
                </div>
                <div class="space-y-2 pt-2">
                    <label for="editPeerAllowInternal" class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="editPeerAllowInternal" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالاتصال الداخلي' : 'Allow Internal Dialing' %></span>

            }
        }
        window.fetchDongleStateReports = fetchDongleStateReports;
        let rtcpTimer = null;
        function startRtcpTimer() {
            stopRtcpTimer();
            rtcpTimer = setInterval(fetchRtcpDiagnostics, 3000);
        }
        function stopRtcpTimer() {
            if (rtcpTimer) {
                clearInterval(rtcpTimer);
                rtcpTimer = null;
            }
        }
        window.fetchRtcpDiagnostics = fetchRtcpDiagnostics;
        // =========================================================================
        // --- TTY TERMINAL SHELL MODULE WITH CLIPBOARD PASTE ---
        // =========================================================================
        let ttySocket = null;
        let ttyXterm = null;
        let ttyFitAddon = null;
        let isTtyInitialized = false;

        function initTtyTerminal() {
            if (isTtyInitialized) {
                if (ttyFitAddon) try { ttyFitAddon.fit(); } catch(_) {}
                return;
            }
            isTtyInitialized = true;

            const container = document.getElementById('terminalContainer');
            if (!container) return;

            if (typeof io !== 'undefined') {
                ttySocket = io();
                window.ttySocket = ttySocket;
            } else {
                updateTtyStatus(false, 'Socket.IO unavailable');
                return;
            }

            if (typeof window.Terminal !== 'undefined') {
                ttyXterm = new window.Terminal({
                    cursorStyle: 'block',
                    fontFamily: '"JetBrains Mono", "Courier New", monospace',
                    fontSize: 13,
                    theme: {
                        background: '#09090b',
                        foreground: '#34d399',
                        cursor: '#10b981',
                        selectionBackground: 'rgba(16, 185, 129, 0.3)',
                        black: '#18181b',
                        red: '#f87171',
                        green: '#34d399',
                        yellow: '#fbbf24',
                        blue: '#60a5fa',
                        magenta: '#c084fc',
                        cyan: '#22d3ee',
                        white: '#f4f4f5'
                    }
                });
                window.ttyXterm = ttyXterm;
                if (typeof window.FitAddon !== 'undefined' && window.FitAddon.FitAddon) {
                    ttyFitAddon = new window.FitAddon.FitAddon();
                    ttyXterm.loadAddon(ttyFitAddon);
                }

                ttyXterm.open(container);
                if (ttyFitAddon) try { ttyFitAddon.fit(); } catch(_) {}

                ttyXterm.attachCustomKeyEventHandler((arg) => {
                    if ((arg.ctrlKey || arg.metaKey) && arg.code === 'KeyC' && arg.type === 'keydown') {
                        if (ttyXterm.hasSelection()) {
                            const selected = ttyXterm.getSelection();
                            if (navigator.clipboard && navigator.clipboard.writeText) {
                                navigator.clipboard.writeText(selected);
                                showToast(isRtl ? 'تم نسخ النص إلى الحافظة' : 'Copied selected text to clipboard', 'success');
                            }
                            return false;
                        }
                    }
                    if ((arg.ctrlKey || arg.metaKey) && arg.code === 'KeyV' && arg.type === 'keydown') {
                        pasteClipboardToTerminal();
                        return false;
                    }
                    return true;
                });
                ttyXterm.onSelectionChange(() => {
                    const text = ttyXterm.getSelection();
                    if (text && navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).catch(() => {});
                    }
                });

                ttyXterm.onData(data => {
                    if (ttySocket) ttySocket.emit('tty_input', data);
                });
                window.addEventListener('resize', () => {
                    if (ttyFitAddon && ttyXterm) {
                        try {
                            ttyFitAddon.fit();
                            ttySocket.emit('tty_resize', { cols: ttyXterm.cols, rows: ttyXterm.rows });
                        } catch(_) {}
                    }
                });
            } else {
                container.innerHTML = '<div id="ttyOutput" class="whitespace-pre-wrap font-mono text-xs leading-relaxed text-emerald-400 p-2"></div>';
                container.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        if (ttySocket) ttySocket.emit('tty_input', '\r');
                    } else if (e.key === 'Backspace') {
                        if (ttySocket) ttySocket.emit('tty_input', '\b');
                    } else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
                        if (ttySocket) ttySocket.emit('tty_input', e.key);
                    }
                });
            }

            const handlePasteEvent = (e) => {
                e.preventDefault();
                const pasteText = (e.clipboardData || window.clipboardData).getData('text');
                if (pasteText && ttySocket) {
                    ttySocket.emit('tty_input', pasteText);
                }
            };
            container.addEventListener('paste', handlePasteEvent);
            if (ttyXterm && ttyXterm.element) {
                ttyXterm.element.addEventListener('paste', handlePasteEvent);
            }
            ttySocket.on('tty_output', (data) => {
                if (ttyXterm) {
                    ttyXterm.write(data);
                } else {
                    const output = document.getElementById('ttyOutput');
                    if (output) {
                        output.textContent += data;
                        container.scrollTop = container.scrollHeight;
                    }
                }
            });

            ttySocket.on('tty_status', (status) => {
                if (status && status.connected) {
                    updateTtyStatus(true, 'Connected (PID: ' + (status.pid || 'live') + ')');
                } else {
                    updateTtyStatus(false, 'Disconnected');
                }
            });

            const cols = ttyXterm ? ttyXterm.cols : 100;
            const rows = ttyXterm ? ttyXterm.rows : 30;
            ttySocket.emit('tty_init', { cols, rows });
        }

        function updateTtyStatus(connected, text) {
            const badge = document.getElementById('ttyStatusBadge');
            const dot = document.getElementById('ttyStatusDot');
            const txt = document.getElementById('ttyStatusText');
            if (!badge || !dot || !txt) return;
            txt.textContent = text;
            if (connected) {
                badge.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5';
                dot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
            } else {
                badge.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-red-500/10 text-red-400 border border-red-500/20 flex items-center gap-1.5';
                dot.className = 'w-2 h-2 rounded-full bg-red-400';
            }
        }

        async function copySelectedTextFromTerminal() {
            try {
                let selected = '';
                if (ttyXterm && ttyXterm.hasSelection()) {
                    selected = ttyXterm.getSelection();
                } else if (window.getSelection) {
                    selected = window.getSelection().toString();
                }
                if (!selected) {
                    showToast(isRtl ? 'يرجى تحديد النص في الطرفية لنسخه' : 'Please select text in the terminal to copy', 'info');
                    return;
                }
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(selected);
                    showToast(isRtl ? 'تم نسخ النص إلى الحافظة' : 'Copied selected text to clipboard', 'success');
                } else {
                    showToast(isRtl ? 'تعذر الوصول إلى الحافظة' : 'Clipboard access restricted', 'error');
                }
            } catch(err) {
                showToast(isRtl ? 'تعذر النسخ' : 'Failed to copy text', 'error');
            }
        }
        window.copySelectedTextFromTerminal = copySelectedTextFromTerminal;

        async function pasteClipboardToTerminal() {
            try {
                let pasteText = '';
                if (navigator.clipboard && navigator.clipboard.readText) {
                    pasteText = await navigator.clipboard.readText();
                }
                if (!pasteText) {
                    pasteText = prompt(isRtl ? 'قم بلصق النص هنا لإرساله إلى الطرفية:' : 'Paste text here to send to TTY terminal:');
                }
                if (pasteText && ttySocket) {
                    ttySocket.emit('tty_input', pasteText);
                    showToast(isRtl ? 'تم إرسال النص إلى الطرفية' : 'Pasted text sent to terminal', 'success');
                }
            } catch(err) {
                const pasteText = prompt(isRtl ? 'قم بلصق النص هنا لإرساله إلى الطرفية:' : 'Paste text here to send to TTY terminal:');
                if (pasteText && ttySocket) {
                    ttySocket.emit('tty_input', pasteText);
                    showToast(isRtl ? 'تم إرسال النص إلى الطرفية' : 'Pasted text sent to terminal', 'success');
                }
            }
        }
        window.pasteClipboardToTerminal = pasteClipboardToTerminal;

        function clearTerminalScreen() {
            if (ttyXterm) {
                ttyXterm.clear();
            } else {
                const output = document.getElementById('ttyOutput');
                if (output) output.textContent = '';
            }
            if (ttySocket) ttySocket.emit('tty_input', '\x0c');
        }
        window.clearTerminalScreen = clearTerminalScreen;

        function restartTtyShell() {
            if (ttyXterm) ttyXterm.clear();
            const cols = ttyXterm ? ttyXterm.cols : 100;
            const rows = ttyXterm ? ttyXterm.rows : 30;
            if (ttySocket) ttySocket.emit('tty_restart', { cols, rows });
        }
        window.restartTtyShell = restartTtyShell;

        function runLastTtyCommand() {
            if (ttySocket) {
                ttySocket.emit('tty_input', '\x1b[A\r');
                showToast(isRtl ? 'تم إرسال الأمر السابق' : 'Executed last command (Up + Enter)', 'info');
            } else {
                showToast(isRtl ? 'الطرفية غير متصلة' : 'Terminal not connected', 'error');
            }
        }
        window.runLastTtyCommand = runLastTtyCommand;
        window.restartTtyShell = restartTtyShell;

        // ====================================================================
        // SOKRAT IAX2 MULTI-SERVER PBX FEDERATION CLIENT LOGIC
        // ====================================================================
        let loadedFederationSettings = null;
        let loadedFederationPeersList = [];
        let loadedRemoteExtensionsList = [];

        function fetchFederationSettings() {
            return fetch('/api/config/federation/settings')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.settings) {
                        loadedFederationSettings = data.settings;
                        const siteBadge = document.getElementById('fedLocalSiteBadge');
                        if (siteBadge) siteBadge.textContent = `Site ${data.settings.local_site_code || '10'}`;
                        const roleBadge = document.getElementById('fedLocalRoleBadge');
                        if (roleBadge) {
                            if (data.settings.panel_role === 'central') {
                                roleBadge.textContent = isRtl ? 'لوحة مركزية موحدة' : 'Central Live Panel';
                                roleBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-purple-500/20 text-purple-400 border border-purple-500/30';
                            } else {
                                roleBadge.textContent = isRtl ? 'سيرفر محلي' : 'Local PBX';
                                roleBadge.className = 'px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-blue-500/20 text-blue-400 border border-blue-500/30';
                            }
                        }
                    }
                })
                .catch(err => console.error('fetchFederationSettings error:', err));
        }

        function fetchFederationPeers() {
            const tbody = document.getElementById('federationPeersTableBody');
            return fetch('/api/config/federation/peers')
                .then(res => res.json())
                .then(data => {
                    if (data.success && Array.isArray(data.peers)) {
                        loadedFederationPeersList = data.peers;
                        loadedRemoteExtensionsList = data.remoteExtensions || [];
                        renderFederationPeersTable(data.peers);
                        fetchRemoteExtensionsDirectory();
                        if (typeof renderQuickPickPills === 'function') renderQuickPickPills();
                        if (typeof renderQueueAgentChecklist === 'function') renderQueueAgentChecklist();
                    } else {
                        if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-xs text-red-400">${data.error || 'Failed to load peers.'}</td></tr>`;
                    }
                })
                .catch(err => {
                    console.error('fetchFederationPeers error:', err);
                    if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-xs text-red-400">Connection error loading peers.</td></tr>`;
                });
        }

        function renderFederationPeersTable(peers) {
            const tbody = document.getElementById('federationPeersTableBody');
            if (!tbody) return;

            if (peers.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="py-8 text-center text-xs text-[var(--text-muted)]">
                            <div class="flex flex-col items-center justify-center gap-2">
                                <span class="text-base font-bold text-[var(--text-secondary)]">${isRtl ? 'لا توجد سيرفرات مرتبطة حالياً' : 'No connected PBX nodes yet'}</span>
                                <span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'اضغط على "ربط سيرفر جديد" لإعداد نفق IAX2 والتبادل التلقائي بنقرة واحدة.' : 'Click "Connect New PBX" to link a secondary server over an encrypted IAX2 tunnel.'}</span>
                            </div>
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = peers.map(peer => {
                const isOnline = peer.qualifyStatus === 'online' || peer.status === 'online';
                const latency = peer.latencyMs ? `${peer.latencyMs}ms` : '';
                const statusBadge = isOnline
                    ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>${isRtl ? 'متصل (Online)' : 'Online'} ${latency ? '(' + latency + ')' : ''}</span>
                       </span>`
                    : `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-extrabold bg-red-500/20 text-red-400 border border-red-500/30">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                        <span>${isRtl ? 'غير متصل (Offline)' : 'Offline'}</span>
                       </span>`;

                return `
                    <tr class="hover:bg-[var(--bg-hover)] transition-colors">
                        <td class="py-3 px-4">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-bold text-xs">
                                    ${peer.site_code}
                                </div>
                                <div>
                                    <span class="font-extrabold text-[var(--text-primary)] block">${peer.node_name || 'Site ' + peer.site_code}</span>
                                    <span class="text-[10px] font-mono text-[var(--text-muted)]">IAX2: ${peer.iax_peer_outbound || 'fed_out'}</span>
                                </div>
                            </div>
                        </td>
                        <td class="py-3 px-4">
                            <span class="px-2 py-0.5 rounded font-mono font-black text-xs bg-amber-500/20 text-amber-400 border border-amber-500/30">
                                ${peer.site_code}
                            </span>
                        </td>
                        <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">
                            ${peer.host}:${peer.iax_port || 4569}
                        </td>
                        <td class="py-3 px-4">
                            ${statusBadge}
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md font-mono text-xs font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                                <span>${peer.extensionsCount || 0} ${isRtl ? 'تحويلة' : 'exts'}</span>
                            </span>
                        </td>
                        <td class="py-3 px-4">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md font-mono text-xs font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z" /></svg>
                                <span>${peer.donglesCount || 0} ${isRtl ? 'شريحة' : 'dongles'}</span>
                            </span>
                        </td>
                        <td class="py-3 px-4">
                            <div class="flex items-center justify-center gap-1.5">
                                <button type="button" onclick="syncFederationPeer(${peer.id})" title="${isRtl ? 'إعادة مزامنة التحويلات والخطوط' : 'Re-sync Extensions & Dongles'}" class="p-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-cyan-400 hover:border-cyan-500/40 transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                                    </svg>
                                </button>
                                <button type="button" onclick="qualifyFederationPeer(${peer.id})" title="${isRtl ? 'اختبار الاستجابة (Qualify Ping)' : 'Qualify Ping Test'}" class="p-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-emerald-400 hover:border-emerald-500/40 transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                                    </svg>
                                </button>
                                <button type="button" onclick="openEditPeerModal(${peer.id})" title="${isRtl ? 'تعديل الصلاحيات' : 'Edit Permissions'}" class="p-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-amber-400 hover:border-amber-500/40 transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button type="button" onclick="deleteFederationPeer(${peer.id})" title="${isRtl ? 'حذف الربط' : 'Delete Connection'}" class="p-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-red-400 hover:border-red-500/40 transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function fetchRemoteExtensionsDirectory() {
            fetch('/api/config/federation/peers')
                .then(() => {
                    renderRemoteExtensionsGrid(loadedFederationPeersList);
                })
                .catch(err => console.error('fetchRemoteExtensionsDirectory error:', err));
        }

        function renderRemoteExtensionsGrid(peers) {
            const grid = document.getElementById('fedRemoteExtensionsGrid');
            if (!grid) return;

            let allCards = [];
            for (const peer of (peers || [])) {
                allCards.push(`
                    <div class="panel-surface p-3.5 rounded-xl border border-[var(--border-primary)] hover:border-amber-500/30 transition flex flex-col justify-between gap-3">
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="text-xs font-bold text-[var(--text-primary)] block">${peer.node_name || 'Site ' + peer.site_code}</span>
                                <span class="text-[10px] text-[var(--text-muted)] font-mono">${peer.host}</span>
                            </div>
                            <span class="px-2 py-0.5 rounded text-[10px] font-black bg-amber-500/20 text-amber-400 font-mono">
                                Site ${peer.site_code}
                            </span>
                        </div>
                        <div class="p-2 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[11px] font-mono text-[var(--text-secondary)]">
                            <span class="text-[10px] text-[var(--text-muted)] block uppercase mb-0.5">${isRtl ? 'نمط الاتصال الداخلي' : 'Dial Format'}:</span>
                            <span class="text-amber-400 font-bold">${peer.site_code}XXX</span> ${isRtl ? '(مثال 20101)' : '(e.g. ' + peer.site_code + '101)'}
                        </div>
                    </div>
                `);
            }

            if (allCards.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-8 text-center text-xs text-[var(--text-muted)]">${isRtl ? 'لا توجد سيرفرات مرتبطة مسجلة.' : 'No connected PBX nodes registered yet.'}</div>`;
            } else {
                grid.innerHTML = allCards.join('');
            }
        }

        function filterRemoteExtensionsDirectory() {
            const query = (document.getElementById('fedRemoteExtSearchInput')?.value || '').toLowerCase().trim();
            const grid = document.getElementById('fedRemoteExtensionsGrid');
            if (!grid) return;
            grid.querySelectorAll('.panel-surface').forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function openConnectPbxModal() {
            openModal('connectPbxModal');
            const statusArea = document.getElementById('connBootstrapStatusArea');
            if (statusArea) statusArea.classList.add('hidden');
            const btn = document.getElementById('connBootstrapSubmitBtn');
            if (btn) btn.disabled = false;
        }

        function submitBootstrapPbx(e) {
            e.preventDefault();
            const host = document.getElementById('connRemoteHost').value.trim();
            const sshPort = parseInt(document.getElementById('connRemoteSshPort').value, 10) || 22;
            const sshUser = document.getElementById('connRemoteSshUser').value.trim() || 'root';
            const sshPassword = document.getElementById('connRemoteSshPass').value;
            const siteCode = document.getElementById('connRemoteSiteCode').value.trim();
            const nodeName = document.getElementById('connRemoteNodeName').value.trim();
            const allowInternal = document.getElementById('connAllowInternal').checked ? 1 : 0;
            const allowEgress = document.getElementById('connAllowEgress').checked ? 1 : 0;

            const statusArea = document.getElementById('connBootstrapStatusArea');
            const statusText = document.getElementById('connBootstrapStatusText');
            const submitBtn = document.getElementById('connBootstrapSubmitBtn');

            if (statusArea) statusArea.classList.remove('hidden');
            if (statusText) statusText.textContent = isRtl ? 'جاري الاتصال بالسيرفر وإعداد النفق ومزامنة البيانات...' : 'Connecting via SSH, provisioning bilateral IAX2 link and syncing entities...';
            if (submitBtn) submitBtn.disabled = true;

            fetch('/api/config/federation/bootstrap', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    host,
                    sshPort,
                    sshUser,
                    sshPassword,
                    siteCode,
                    nodeName,
                    allowInternalDialing: allowInternal,
                    allowOutboundEgress: allowEgress
                })
            })
            .then(res => res.json())
            .then(data => {
                if (submitBtn) submitBtn.disabled = false;
                if (data.success) {
                    showToast(isRtl ? `تم ربط السيرفر بنجاح! الاستجابة: ${data.latencyMs || 1}ms (${data.extensionsSynced || 0} تحويلة)` : `PBX connected successfully! Latency: ${data.latencyMs || 1}ms (${data.extensionsSynced || 0} exts)`, 'success');
                    closeModal('connectPbxModal');
                    fetchFederationSettings();
                    fetchFederationPeers();
                } else {
                    if (statusText) statusText.textContent = data.error || 'Bootstrap failed';
                    showToast(data.error || 'Bootstrap failed', 'error');
                }
            })
            .catch(err => {
                if (submitBtn) submitBtn.disabled = false;
                if (statusText) statusText.textContent = err.message;
                showToast(err.message, 'error');
            });
        }

        async function openFederationSettingsModal() {
            try {
                const res = await fetch('/api/config/federation/settings');
                const data = await res.json();
                if (data.success && data.settings) {
                    loadedFederationSettings = data.settings;
                }
            } catch (_) {}
            if (loadedFederationSettings) {
                const codeInp = document.getElementById('localSiteCodeInput');
                if (codeInp) codeInp.value = loadedFederationSettings.local_site_code || '10';
                const nameInp = document.getElementById('localNodeNameInput');
                if (nameInp) nameInp.value = loadedFederationSettings.local_node_name || 'Main PBX';
                const roleSel = document.getElementById('localPanelRoleSelect');
                if (roleSel) roleSel.value = loadedFederationSettings.panel_role || 'local';
            }
            openModal('federationSettingsModal');
        }

        function saveFederationSettings(e) {
            e.preventDefault();
            const local_site_code = document.getElementById('localSiteCodeInput').value.trim();
            const local_node_name = document.getElementById('localNodeNameInput').value.trim();
            const panel_role = document.getElementById('localPanelRoleSelect').value;

            fetch('/api/config/federation/settings', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ local_site_code, local_node_name, panel_role })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ إعدادات السيرفر وتحديث النفق بنجاح' : 'Local PBX settings updated and IAX2 configuration reloaded', 'success');
                    closeModal('federationSettingsModal');
                    fetchFederationSettings();
                    fetchFederationPeers();
                } else {
                    showToast(data.error || 'Failed to update settings', 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'));
        }

        function openEditPeerModal(peerId) {
            const peer = loadedFederationPeersList.find(p => Number(p.id) === Number(peerId));
            if (!peer) return;
            document.getElementById('editPeerId').value = peer.id;
            document.getElementById('editPeerNodeName').value = peer.node_name || '';
            document.getElementById('editPeerHost').value = peer.host || '';
            document.getElementById('editPeerAllowInternal').checked = Number(peer.allow_internal_dialing) !== 0;
            document.getElementById('editPeerAllowEgress').checked = Number(peer.allow_outbound_egress) !== 0;
            openModal('editPeerModal');
        }

        function savePeerEdit(e) {
            e.preventDefault();
            const id = document.getElementById('editPeerId').value;
            const node_name = document.getElementById('editPeerNodeName').value.trim();
            const host = document.getElementById('editPeerHost').value.trim();
            const allow_internal_dialing = document.getElementById('editPeerAllowInternal').checked ? 1 : 0;
            const allow_outbound_egress = document.getElementById('editPeerAllowEgress').checked ? 1 : 0;

            fetch(`/api/config/federation/peers/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ node_name, host, allow_internal_dialing, allow_outbound_egress })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(isRtl ? 'تم تحديث بيانات السيرفر بنجاح' : 'Peer updated successfully', 'success');
                    closeModal('editPeerModal');
                    fetchFederationPeers();
                } else {
                    showToast(data.error || 'Failed to update peer', 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'));
        }

        function syncFederationPeer(peerId) {
            showToast(isRtl ? 'جاري مزامنة التحويلات والخطوط من السيرفر...' : 'Syncing extensions & dongles from remote peer...', 'info');
            fetch(`/api/config/federation/peers/${peerId}/sync`, { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? `تمت المزامنة: ${data.extensionsCount || 0} تحويلة و ${data.donglesCount || 0} شريحة` : `Sync complete: ${data.extensionsCount || 0} extensions and ${data.donglesCount || 0} dongles`, 'success');
                        fetchFederationPeers();
                    } else {
                        showToast(data.error || 'Sync failed', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }

        function qualifyFederationPeer(peerId) {
            showToast(isRtl ? 'جاري فحص استجابة السيرفر (Qualify)...' : 'Checking peer latency (Qualify)...', 'info');
            fetch(`/api/config/federation/peers/${peerId}/qualify`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const lat = data.latencyMs ? `${data.latencyMs}ms` : data.status;
                        showToast(isRtl ? `حالة السيرفر: ${data.status} (الاستجابة: ${lat})` : `Peer status: ${data.status} (${lat})`, data.status === 'online' ? 'success' : 'warning');
                        fetchFederationPeers();
                    } else {
                        showToast(data.error || 'Qualify failed', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }

        function deleteFederationPeer(peerId) {
            if (!confirm(isRtl ? 'هل أنت متأكد من حذف هذا السيرفر وإلغاء الربط بينهما؟' : 'Are you sure you want to disconnect and remove this PBX node?')) {
                return;
            }
            fetch(`/api/config/federation/peers/${peerId}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? 'تم حذف السيرفر وتحديث إعدادات أستيركس بنجاح' : 'Peer removed and Asterisk reloaded successfully', 'success');
                        fetchFederationPeers();
                    } else {
                        showToast(data.error || 'Delete failed', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }

        window.fetchFederationSettings = fetchFederationSettings;
        window.fetchFederationPeers = fetchFederationPeers;
        window.openConnectPbxModal = openConnectPbxModal;
        window.submitBootstrapPbx = submitBootstrapPbx;
        window.openFederationSettingsModal = openFederationSettingsModal;
        window.saveFederationSettings = saveFederationSettings;
        window.openEditPeerModal = openEditPeerModal;
        window.savePeerEdit = savePeerEdit;
        window.syncFederationPeer = syncFederationPeer;
        window.qualifyFederationPeer = qualifyFederationPeer;
        window.deleteFederationPeer = deleteFederationPeer;
        window.filterRemoteExtensionsDirectory = filterRemoteExtensionsDirectory;
    </script>
</body>
</html>

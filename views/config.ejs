                                <th class="py-3 px-4"><%= isRtl ? 'مفتاح التكرار' : 'Repeat Key' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الخيارات' : 'Options' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الوجهة المستهدفة' : 'Post Destination' %></th>
                                <th class="py-3 px-4 text-center w-36"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="announcements-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">

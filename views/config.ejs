                            <span class="text-xs font-bold text-[var(--text-primary)] block"><%= isRtl ? 'إدارة فتحات المودم' : 'Dongle Slot Management' %></span>
                            <span class="text-[10px] text-[var(--text-muted)]"><%= isRtl ? 'إضافة أو إزالة تعريفات الأجهزة وإعادة ضبط مستويات الكسب.' : 'Add or remove device definitions, or reset all gain values.' %></span>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <% if ((typeof isRoot !== 'undefined' && isRoot) || (typeof currentUser !== 'undefined' && currentUser === 'root')) { %>
                                <button type="button" onclick="openAddDongleSlotModal()" class="config-action-btn config-action-btn--positive">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                                    <span><%= isRtl ? 'إضافة فتحة' : 'Add Slot' %></span>
                                </button>
                                <button type="button" onclick="openRemoveDongleSlotModal()" class="config-action-btn config-action-btn--danger">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" /></svg>
                                    <span><%= isRtl ? 'إزالة فتحة' : 'Remove Slot' %></span>
                                </button>
                            <% } %>
                            <button type="button" onclick="resetAllDongleGains()" class="config-action-btn config-action-btn--danger">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                                <span><%= isRtl ? 'إعادة ضبط الكسب' : 'Reset Gains' %></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="p-5 sm:p-6">
                    <div class="flex items-center justify-between gap-3 mb-4">
                        <div>
                            <h3 class="text-sm font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'مستويات الكسب لكل جهاز' : 'Per-Device Gain Controls' %></h3>
                            <p class="text-[11px] text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'Rx للصوت الوارد، وTx للصوت المرسل.' : 'Rx controls incoming audio; Tx controls transmitted audio.' %></p>
                        </div>
                        <span id="modemDongleCount" class="px-2.5 py-1 text-[10px] font-mono font-bold rounded-lg bg-[var(--bg-card)] text-[var(--text-secondary)] border border-[var(--border-primary)]">0 <%= isRtl ? 'أجهزة' : 'devices' %></span>
                    </div>
                    <div id="modemDonglesGrid" class="grid grid-cols-1 xl:grid-cols-2 gap-4">
                        <!-- Rendered dynamically by fetchModemConfig() -->
                    </div>
                </div>
            </div>

            <!-- Universal Voice Processing (RNNoise / VAD) — system-wide defaults, applied per-extension -->
            <div class="config-card overflow-hidden">
                <div class="p-5 sm:p-6 border-b border-[var(--border-primary)] flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div class="flex items-start gap-3 min-w-0">
                        <div class="w-11 h-11 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0-4a3 3 0 003-3V7a3 3 0 10-6 0v8a3 3 0 003 3z"/></svg>
                        </div>
                        <div class="min-w-0">
                            <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'معالجة الصوت الشاملة (AI RNNoise & VAD)' : 'Universal Voice Processing (AI RNNoise & VAD)' %></h2>
                            <p class="text-[11px] text-[var(--text-muted)] mt-1"><%= isRtl ? 'إعدادات عامة لحساسية كشف الكلام ومدة الاحتفاظ بالصوت تُطبق على جميع التحويلات. لا يزال تفعيل العزل واتجاهه يُدار لكل تحويلة من إعدادات المقسم.' : 'System-wide speech detection sensitivity and hold time applied to every extension. Enabling suppression and its direction remain per-extension in PBX Config.' %></p>
                        </div>
                    </div>
                    <button type="button" onclick="saveAudioGlobals()" class="config-action-btn config-action-btn--primary self-start sm:self-auto shrink-0">
                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ الإعدادات العامة' : 'Save Universal Settings' %></span>
                    </button>
                </div>
                <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label for="globalVadThreshold" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase block mb-1.5 tracking-wider"><%= isRtl ? 'حساسية كشف الكلام (Threshold)' : 'Speech Detection Threshold' %></label>
                        <select id="globalVadThreshold" class="config-input w-full text-xs font-semibold">
                            <option value="0.05">0.05 (<%= isRtl ? 'أقصى حساسية - يلتقط همساً خافتاً' : 'Maximum sensitivity - catches faint whispers' %>)</option>
                            <option value="0.10">0.10 (<%= isRtl ? 'حساسية عالية / صوت خافت' : 'High Sensitivity / Soft Voice' %>)</option>
                            <option value="0.15">0.15 (<%= isRtl ? 'حساسية مرتفعة' : 'Elevated Sensitivity' %>)</option>
                            <option value="0.20"><%= isRtl ? '0.20 (متوازن - افتراضي موصى به)' : '0.20 (Balanced - Recommended Default)' %></option>
                            <option value="0.30">0.30 (<%= isRtl ? 'متوسط / بيئة هادئة نسبياً' : 'Moderate / Fairly Quiet Environment' %>)</option>
                            <option value="0.45">0.45 (<%= isRtl ? 'صارم - ضوضاء خلفية عالية فقط' : 'Strict - Only Strong Speech' %>)</option>
                        </select>
                    </div>
                    <div>
                        <label for="globalVadHangover" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase block mb-1.5 tracking-wider"><%= isRtl ? 'مهلة الاحتفاظ بالصوت (Hangover)' : 'Hangover Hold Time' %></label>
                        <select id="globalVadHangover" class="config-input w-full text-xs font-semibold">
                            <option value="100">100 ms (<%= isRtl ? 'قصائر جداً - كتم فوري بين الكلمات' : 'Very short - instant gating between words' %>)</option>
                            <option value="150">150 ms (<%= isRtl ? 'سريع' : 'Quick' %>)</option>
                            <option value="250"><%= isRtl ? '250 ms (طبيعي - افتراضي)' : '250 ms (Natural - Default)' %></option>
                            <option value="350">350 ms (<%= isRtl ? 'ناعم' : 'Soft Hold' %>)</option>
                            <option value="500">500 ms (<%= isRtl ? 'طويل - يحافظ على سلاسة الكلام' : 'Long - smooths speech pauses' %>)</option>
                            <option value="750">750 ms (<%= isRtl ? 'الأطول - أقل كتم ممكن' : 'Longest - minimal muting' %>)</option>
                        </select>
                    </div>
                    <div>
                        <label for="globalVadDbThreshold" class="text-[11px] font-bold text-[var(--text-secondary)] uppercase block mb-1.5 tracking-wider"><%= isRtl ? 'عتبة كتم الديسيبل العامة (dB Cutoff)' : 'Universal dBFS Gate Cutoff' %></label>
                        <select id="globalVadDbThreshold" class="config-input w-full text-xs font-semibold">
                            <option value="-90" selected><%= isRtl ? 'تلقائي / عصبي فقط (Auto / Neural Only)' : 'Auto / Neural Only (Default -90 dBFS)' %></option>
                            <option value="-55">-55 dBFS (<%= isRtl ? 'هادئ جداً' : 'Very Soft Noise' %>)</option>
                            <option value="-50">-50 dBFS (<%= isRtl ? 'خافت / متوازن' : 'Soft / Balanced' %>)</option>
                            <option value="-45">-45 dBFS (<%= isRtl ? 'متوسط / مكتب هادئ' : 'Moderate / Quiet Office' %>)</option>
                            <option value="-42">-42 dBFS (<%= isRtl ? 'عالي / مكتب نشط' : 'High / Busy Office' %>)</option>
                            <option value="-38">-38 dBFS (<%= isRtl ? 'صارم / ضوضاء قوية' : 'Strict / Heavy Noise' %>)</option>
                            <option value="-35">-35 dBFS (<%= isRtl ? 'عدواني / ضوضاء شديدة' : 'Aggressive / Loud Noise' %>)</option>
                            <option value="-30">-30 dBFS (<%= isRtl ? 'أقصى كتم / أصوات عالية' : 'Maximum / Extreme Noise' %>)</option>
                        </select>
                    </div>
                </div>
            </div>
            <!-- Cloud AI Speech-to-Text Transcription Overview Card -->
            <div class="config-card overflow-hidden">
                <div class="p-5 sm:p-6 border-b border-[var(--border-primary)] flex flex-col sm:flex-row sm:items-start justify-between gap-4">

        async function editExtension(extNum, name, secret, voicemail, tech) {
            document.getElementById('extModalTitle').textContent = (isRtl ? 'تعديل التحويلة ' : 'Edit Extension ') + extNum;
            document.getElementById('extEditMode').value = 'true';
            document.getElementById('extNum').value = extNum;
            document.getElementById('extNum').disabled = true;
            document.getElementById('extName').value = name || '';
            document.getElementById('extSecret').value = secret || '';
            document.getElementById('extVoicemail').value = (voicemail === 'default' || voicemail === 'enabled') ? 'enabled' : 'disabled';
            document.getElementById('extTech').value = (tech === 'pjsip' || tech === 'webrtc') ? 'webrtc' : 'sip';
            document.getElementById('extVoicemail').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extTech').dispatchEvent(new Event('change', { bubbles: true }));
            resetEmployeeProfileFields();
            openModal('extensionModal');

            try {
                const [groupsResponse, extrasResponse] = await Promise.all([
                    fetch('/api/employee/groups'),
                    fetch('/api/employee/extras/' + encodeURIComponent(extNum))
                ]);
                const [groupsData, extrasData] = await Promise.all([
                    groupsResponse.json(),
                    extrasResponse.json()
                ]);
                if (!groupsResponse.ok || !groupsData.success) {
                    throw new Error(groupsData.error || 'Failed to load employee groups');
                }
                if (!extrasResponse.ok || !extrasData.success) {
                    throw new Error(extrasData.error || 'Failed to load employee profile');
                }

                const extras = extrasData.extras || {};
                setEmployeeGroupOptions(groupsData.groups || [], extras.emp_group || '');
                document.getElementById('extTitle').value = extras.title || '';
                document.getElementById('extPhotoUrl').value = extras.photo || '';
                if (extras.photo) {
                    showEmployeePhotoPreview(extras.photo, extras.photo.split('/').pop());
                }
            } catch (error) {
                setEmployeeGroupOptions([], '');
                showToast(error.message, 'error');
            }
        }

        async function saveExtension(event) {
            event.preventDefault();
            const wasEdit = document.getElementById('extEditMode').value === 'true';
            const extNum = document.getElementById('extNum').value.trim();
            const name = document.getElementById('extName').value.trim();
            const secret = document.getElementById('extSecret').value.trim();
            const voicemail = document.getElementById('extVoicemail').value;
            const tech = document.getElementById('extTech').value;
            const saveButton = document.getElementById('extSaveBtn');
            const saveText = document.getElementById('extSaveBtnText');
            const originalText = saveText.textContent;
            let extensionCreated = false;

            saveButton.disabled = true;
            saveText.textContent = isRtl ? 'جاري الحفظ...' : 'Saving...';

            try {
                const response = await fetch(wasEdit ? '/api/config/extensions/' + extNum : '/api/config/extensions', {
                    method: wasEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ extension: extNum, name, secret, voicemail, tech })
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.error || 'Failed to save extension');
                }

                if (!wasEdit) {
                    extensionCreated = true;
                    document.getElementById('extEditMode').value = 'true';
                    document.getElementById('extNum').disabled = true;
                }
                await saveEmployeeExtras(extNum);
                showToast(data.message, 'success');
                closeModal('extensionModal');
                fetchExtensions();
                if (tech === 'webrtc' && !wasEdit) {
                    document.getElementById('credExt').textContent = extNum;
                    document.getElementById('credName').textContent = name;
                    document.getElementById('credSecret').textContent = secret;
                    document.getElementById('credWsUrl').textContent = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.hostname + (location.protocol === 'https:' ? ':8089/ws' : ':8088/ws');
                    openModal('webrtcCredentialsModal');
                }
            } catch (error) {
                const prefix = extensionCreated
                    ? (isRtl ? 'تم إنشاء التحويلة، لكن تعذر حفظ بيانات الموظف: ' : 'Extension created, but employee profile failed: ')
                    : '';
                showToast(prefix + error.message, 'error');
            } finally {
                saveButton.disabled = false;
                saveText.textContent = originalText;
            }
        }

        function deleteExtension(extNum) {
            if (!confirm(isRtl ? `حذف التحويلة ${extNum}؟` : `Delete extension ${extNum}?`)) return;
            fetch('/api/config/extensions/' + extNum, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchExtensions();
                    } else {
                        showToast(data.error, 'error');
                    }
                })
                .catch(error => showToast(error.message, 'error'));
        }

        async function saveEmployeeExtras(extNum) {
            const photoFile = document.getElementById('extPhoto').files[0];
            const title = document.getElementById('extTitle').value.trim();
            const empGroup = document.getElementById('extGroup').value;
            let photoUrl = document.getElementById('extPhotoUrl').value || null;

            if (photoFile) {
                if (photoFile.size > MAX_EMPLOYEE_PHOTO_BYTES) {
                    throw new Error(isRtl ? 'يجب ألا يتجاوز حجم الصورة 50 ميجابايت' : 'Employee photo must be 50 MB or smaller');
                }
                const formData = new FormData();
                formData.append('photo', photoFile);
                const uploadResponse = await fetch('/api/employee/photo', { method: 'POST', body: formData });
                const uploadData = await uploadResponse.json();
                if (!uploadResponse.ok || !uploadData.success) {
                    throw new Error(uploadData.error || 'Failed to upload employee photo');
                }
                photoUrl = uploadData.url;
                document.getElementById('extPhotoUrl').value = photoUrl;
            }

            const response = await fetch('/api/employee/extras/' + encodeURIComponent(extNum), {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    photo: photoUrl,
                    title: title || null,
                    emp_group: empGroup || null
                })
            });
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Failed to save employee profile');
            }
            return data.extras;
        }


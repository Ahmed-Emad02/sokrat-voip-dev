                    <div id="cfgCallCodesEmptyState" class="hidden text-center py-12 text-[var(--text-muted)] space-y-2">
                        <svg class="w-10 h-10 mx-auto opacity-40 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <p class="text-xs font-bold"><%= isRtl ? 'لم يتم العثور على أكواد مطابقة لبحثك' : 'No matching call control codes found' %></p>
                    </div>
                </div>
        </div>
        <% } %>

        <!-- SECTION 15: SOKRAT IAX2 MULTI-SERVER PBX FEDERATION -->
        <div id="section-federation" class="tab-section hidden space-y-6">

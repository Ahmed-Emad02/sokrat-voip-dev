                        <div class="flex items-center justify-between gap-3 px-4 py-3 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/20">
                            <span class="text-[10px] text-[var(--text-muted)]">${isRtl ? 'النطاق المسموح: -10 إلى +10 dB' : 'Allowed range: -10 to +10 dB'}</span>
                            <button type="button" onclick="saveSingleDongleGain('${id}')" class="config-action-btn config-action-btn--compact">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                <span>${isRtl ? 'حفظ الجهاز' : 'Save Device'}</span>
                            </button>
                        </div>
                    `;
                    grid.appendChild(card);
                });
            } catch (error) {
                if (countBadge) countBadge.textContent = isRtl ? '0 أجهزة' : '0 devices';
                grid.innerHTML = `<div class="col-span-full text-center text-xs text-red-400 py-8">Error loading modem config: ${escapeHtml(error.message)}</div>`;
            }
        }
        window.fetchModemConfig = fetchModemConfig;

        async function saveSingleDongleGain(dongleId) {
            const rxInput = document.getElementById(`rxInput_${dongleId}`);
            const txInput = document.getElementById(`txInput_${dongleId}`);
            if (!rxInput || !txInput) return;

            const rxgain = Math.max(-10, Math.min(10, parseInt(rxInput.value, 10) || 0));
            const txgain = Math.max(-10, Math.min(10, parseInt(txInput.value, 10) || 0));

            try {
                const res = await fetch('/api/config/modem/gain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongleId, rxgain, txgain })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || `${dongleId} volume gain updated successfully!`, 'success');
                } else {
                    showToast(data.error || 'Failed to update volume gain.', 'error');
                }
            } catch (e) {
                showToast('Error updating volume gain: ' + e.message, 'error');
            }
        }
        window.saveSingleDongleGain = saveSingleDongleGain;

        async function saveAllDongleGains() {
            const cards = document.querySelectorAll('#modemDonglesGrid [data-dongle-id]');
            if (!cards.length) return;

            const gains = {};
            cards.forEach(card => {
                const dongleId = card.getAttribute('data-dongle-id');
                const rxInput = document.getElementById(`rxInput_${dongleId}`);
                const txInput = document.getElementById(`txInput_${dongleId}`);
                if (dongleId && rxInput && txInput) {
                    gains[dongleId] = {
                        rxgain: Math.max(-10, Math.min(10, parseInt(rxInput.value, 10) || 0)),
                        txgain: Math.max(-10, Math.min(10, parseInt(txInput.value, 10) || 0))
                    };
                }
            });

            try {
                const res = await fetch('/api/config/modem/gain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gains })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'All dongle volume gains updated successfully!', 'success');
                } else {
                    showToast(data.error || 'Failed to update volume gains.', 'error');
                }
            } catch (e) {
                showToast('Error saving all gains: ' + e.message, 'error');
            }
        }
        window.saveAllDongleGains = saveAllDongleGains;
        window.saveModemConfig = saveAllDongleGains;

        async function loadAudioGlobals() {
            const threshEl = document.getElementById('globalVadThreshold');
            const hangEl = document.getElementById('globalVadHangover');
            const dbThreshEl = document.getElementById('globalVadDbThreshold');
            if (!threshEl || !hangEl) return;
            try {
                const res = await fetch('/api/config/audio-globals');
                const data = await res.json();
                if (data.success) {
                    threshEl.value = String(parseFloat(data.globals.vad_threshold).toFixed(2));
                    hangEl.value = String(parseInt(data.globals.vad_hangover, 10));
                    if (dbThreshEl && data.globals.vad_db_threshold) {
                        dbThreshEl.value = String(data.globals.vad_db_threshold);
                    }
                    if (!threshEl.value || threshEl.selectedIndex === -1) threshEl.value = '0.20';
                    if (!hangEl.value || hangEl.selectedIndex === -1) hangEl.value = '250';
                    if (dbThreshEl && (!dbThreshEl.value || dbThreshEl.selectedIndex === -1)) dbThreshEl.value = '-90';
                }
            } catch (_) {}
        }
        window.loadAudioGlobals = loadAudioGlobals;

        async function saveAudioGlobals() {
            const threshEl = document.getElementById('globalVadThreshold');
            const hangEl = document.getElementById('globalVadHangover');
            const dbThreshEl = document.getElementById('globalVadDbThreshold');
            if (!threshEl || !hangEl) return;
            try {
                const payload = {
                    vad_threshold: threshEl.value,
                    vad_hangover: hangEl.value
                };
                if (dbThreshEl) {
                    payload.vad_db_threshold = dbThreshEl.value;
                }
                const res = await fetch('/api/config/audio-globals', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ إعدادات معالجة الصوت الشاملة.' : 'Universal voice processing settings saved.', 'success');
                } else {
                    showToast(data.error || 'Failed to save universal voice processing settings.', 'error');
                }
            } catch (e) {
                showToast('Error saving universal settings: ' + e.message, 'error');
            }
        }
        window.saveAudioGlobals = saveAudioGlobals;


        async function scanAndTranscribeQueue() {
            try {
                const res = await fetch('/api/transcripts/scan', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تم فحص وإضافة التسجيلات غير المفرغة لقائمة الانتظار.' : 'Un-transcribed recordings queued for transcription.', 'success');
                } else {
                    showToast(data.error || 'Failed to scan recordings', 'error');
                }
            } catch (e) {
                showToast('Error: ' + e.message, 'error');
            }
        }
        window.scanAndTranscribeQueue = scanAndTranscribeQueue;
        async function resetAllDongleGains() {
            if (!confirm(isRtl ? 'هل أنت تأكد من إعادة ضبط مستويات كسب جميع الشرائح إلى (txgain=0 و rxgain=0) في dongle.conf؟' : 'Are you sure you want to reset all dongle gains to txgain=0 and rxgain=0 in dongle.conf?')) return;

            try {
                const res = await fetch('/api/config/modem/reset', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'All dongle gains reset to 0 in dongle.conf!', 'success');
                    fetchModemConfig();
                } else {
                    showToast(data.error || 'Failed to reset gains.', 'error');
                }
            } catch (e) {
                showToast('Error resetting gains: ' + e.message, 'error');
            }
        }
        window.resetAllDongleGains = resetAllDongleGains;
        async function fetchRtcpDiagnostics() {
            const container = document.getElementById('rtcpDiagnosticsContainer');
            const badge = document.getElementById('rtcpActiveBadge');
            if (!container) return;

            try {
                const res = await fetch('/api/config/modem/rtcp');
                const data = await res.json();
                if (!data.success) {
                    container.innerHTML = `<div class="text-center py-6 text-xs text-red-400">Failed to fetch RTCP diagnostics: ${escapeHtml(data.error)}</div>`;
                    return;
                }

                fetchDongleStateReports();

                if (badge) badge.textContent = `${data.activeCount || 0} Active Streams`;

                if (!data.channels || data.channels.length === 0) {
                    container.innerHTML = `
                        <div class="p-6 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-primary)]/40 flex flex-col items-center text-center space-y-3">
                            <div class="w-10 h-10 rounded-full bg-gray-500/10 text-gray-400 flex items-center justify-center">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" /></svg>
                            </div>
                            <div>
                                <h4 class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">${isRtl ? 'لا توجد مكالمات صوتية نشطة حالياً' : 'No Active Call Streams'}</h4>
                                <p class="text-[11px] text-[var(--text-muted)] mt-0.5">${isRtl ? 'يتم تحديث مقاييس RTCP تلقائياً بمجرد إجابة أي مكالمة صوتية على السنترال.' : 'Real-time RTCP audio diagnostics automatically stream metrics during live active calls.'}</p>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 w-full max-w-xl pt-2 text-[11px] font-mono">
                                <div class="p-2.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]"><span class="text-[var(--text-muted)] block text-[10px]">TARGET JITTER</span><span class="text-emerald-400 font-bold">&lt; 20 ms</span></div>
                                <div class="p-2.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]"><span class="text-[var(--text-muted)] block text-[10px]">PACKET LOSS</span><span class="text-emerald-400 font-bold">0%</span></div>
                                <div class="p-2.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]"><span class="text-[var(--text-muted)] block text-[10px]">LATENCY (RTT)</span><span class="text-emerald-400 font-bold">&lt; 100 ms</span></div>
                                <div class="p-2.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]"><span class="text-[var(--text-muted)] block text-[10px]">PRIMARY CODEC</span><span class="text-sky-400 font-bold">G.722 / Opus</span></div>
                            </div>
                        </div>
                    `;
                    return;
                }

                let html = '<div class="space-y-3">';
                data.channels.forEach(ch => {
                    const hasJitter = ch.jitterMs !== null && ch.jitterMs !== undefined && typeof ch.jitterMs === 'number';
                    const hasLoss = ch.packetLoss !== null && ch.packetLoss !== undefined && typeof ch.packetLoss === 'number';
                    const hasRtt = ch.rttMs !== null && ch.rttMs !== undefined && typeof ch.rttMs === 'number';
                    const isDongle = String(ch.channel || '').startsWith('Dongle/');
                    const naText = isDongle ? 'N/A (GSM Direct)' : 'N/A (Non-RTP)';

                    const jitterText = hasJitter ? `${ch.jitterMs} ms` : naText;
                    const lossText = hasLoss ? `${ch.packetLoss}%` : naText;
                    const rttText = hasRtt ? `${ch.rttMs} ms` : naText;

                    const neutralClass = 'text-[var(--text-muted)] bg-[var(--bg-card)] border-[var(--border-primary)]';
                    const jitterClass = !hasJitter ? neutralClass : (ch.jitterMs < 20 ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' : (ch.jitterMs < 50 ? 'text-amber-400 bg-amber-500/10 border-amber-500/20' : 'text-red-400 bg-red-500/10 border-red-500/20'));
                    const lossClass = !hasLoss ? neutralClass : (ch.packetLoss === 0 ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' : (ch.packetLoss < 3 ? 'text-amber-400 bg-amber-500/10 border-amber-500/20' : 'text-red-400 bg-red-500/10 border-red-500/20'));
                    const rttClass = !hasRtt ? neutralClass : (ch.rttMs < 100 ? 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20' : (ch.rttMs < 200 ? 'text-amber-400 bg-amber-500/10 border-amber-500/20' : 'text-red-400 bg-red-500/10 border-red-500/20'));

                    html += `
                        <div class="p-4 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-primary)]/40 flex flex-col md:flex-row md:items-center justify-between gap-3 text-xs">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono font-black text-sm text-[var(--text-primary)]">${escapeHtml(ch.extension)}</span>
                                    <span class="px-2 py-0.5 text-[10px] font-bold rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 font-mono">${escapeHtml(ch.state)}</span>
                                </div>
                                <div class="font-mono text-[11px] text-[var(--text-muted)] truncate max-w-md">${escapeHtml(ch.channel)} • Duration: ${escapeHtml(ch.duration)}</div>
                            </div>
                            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center font-mono">
                                <div class="px-3 py-1.5 rounded-lg border ${jitterClass}"><span class="text-[10px] block opacity-70">JITTER</span><span class="font-bold">${jitterText}</span></div>
                                <div class="px-3 py-1.5 rounded-lg border ${lossClass}"><span class="text-[10px] block opacity-70">LOSS</span><span class="font-bold">${lossText}</span></div>
                                <div class="px-3 py-1.5 rounded-lg border ${rttClass}"><span class="text-[10px] block opacity-70">RTT</span><span class="font-bold">${rttText}</span></div>
                                <div class="px-3 py-1.5 rounded-lg border text-sky-400 bg-sky-500/10 border-sky-500/20"><span class="text-[10px] block opacity-70">FORMAT</span><span class="font-bold">${escapeHtml(ch.format)}</span></div>
                            </div>
                        </div>
                    `;
                });
                html += '</div>';
                container.innerHTML = html;
            } catch (e) {
                container.innerHTML = `<div class="text-center py-6 text-xs text-red-400">Error fetching RTCP diagnostics: ${escapeHtml(e.message)}</div>`;
            }
        }
        window.fetchRtcpDiagnostics = fetchRtcpDiagnostics;

        function populateDongleReportFilterSelects(donglesObj) {
            const dSelect = document.getElementById('dongleReportDongleSelect');
            const sSelect = document.getElementById('dongleReportSimSelect');
            if (!dSelect || !sSelect) return;

            const currD = dSelect.value || 'ALL';
            const currS = sSelect.value || 'ALL';

            dSelect.innerHTML = `<option value="ALL">${isRtl ? 'جميع الأجهزة (ALL)' : 'All Dongles (ALL)'}</option>`;
            sSelect.innerHTML = `<option value="ALL">${isRtl ? 'جميع الشرائح (ALL)' : 'All SIM Numbers (ALL)'}</option>`;

            const simSet = new Set();
            if (donglesObj) {
                Object.keys(donglesObj).sort().forEach(dId => {
                    const opt = document.createElement('option');
                    opt.value = dId;
                    opt.textContent = dId;
                    dSelect.appendChild(opt);

                    const dInfo = donglesObj[dId];
                    if (dInfo && dInfo.phone_number) simSet.add(dInfo.phone_number);
                });
            }

            simSet.forEach(num => {
                const opt = document.createElement('option');
                opt.value = num;
                opt.textContent = num;
                sSelect.appendChild(opt);
            });

            dSelect.value = currD;
            sSelect.value = currS;
        }

        let dongleReportStartPicker = null;
        let dongleReportEndPicker = null;

        function initDongleReportPickers() {
            if (typeof flatpickr !== 'undefined') {
                const startEl = document.getElementById('dongleReportStartDate');
                const endEl = document.getElementById('dongleReportEndDate');
                if (startEl && !dongleReportStartPicker) {
                    dongleReportStartPicker = flatpickr(startEl, {
                        enableTime: true,
                        dateFormat: "Y-m-d H:i:S",
                        altInput: true,
                        altFormat: "m/d/Y h:i K",
                        time_24hr: false,
                        allowInput: true,
                        monthSelectorType: "dropdown",
                        onReady: function(selectedDates, dateStr, instance) {
                            if (instance.altInput) {
                                var origId = instance.input.id || 'dongleReportStartDate';
                                if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                                instance.input.id = origId + '_raw';
                                instance.altInput.id = origId;
                                instance.altInput.name = (instance.input.name || origId) + '_display';
                                instance.altInput.setAttribute('autocomplete', 'off');
                                var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                                instance.altInput.setAttribute('aria-label', ariaLabel);
                            }
                        }
                    });
                }
                if (endEl && !dongleReportEndPicker) {
                    dongleReportEndPicker = flatpickr(endEl, {
                        enableTime: true,
                        dateFormat: "Y-m-d H:i:S",
                        altInput: true,
                        altFormat: "m/d/Y h:i K",
                        time_24hr: false,
                        allowInput: true,
                        monthSelectorType: "dropdown",
                        onReady: function(selectedDates, dateStr, instance) {
                            if (instance.altInput) {
                                var origId = instance.input.id || 'dongleReportEndDate';
                                if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                                instance.input.id = origId + '_raw';
                                instance.altInput.id = origId;
                                instance.altInput.name = (instance.input.name || origId) + '_display';
                                instance.altInput.setAttribute('autocomplete', 'off');
                                var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                                instance.altInput.setAttribute('aria-label', ariaLabel);
                            }
                        }
                    });
                }
            }
        }

        function formatDateTimeStr(d) {
            const pad = (n) => String(n).padStart(2, '0');
            return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
        }

        function setDongleReportPreset(preset) {
            initDongleReportPickers();

            const startD = new Date();
            const endD = new Date();

            if (preset === 'today') {
                startD.setHours(0, 0, 0, 0);
                endD.setHours(23, 59, 59, 999);
            } else if (preset === 'yesterday') {
                startD.setDate(startD.getDate() - 1);
                startD.setHours(0, 0, 0, 0);
                endD.setDate(endD.getDate() - 1);
                endD.setHours(23, 59, 59, 999);
            } else if (preset === '7days') {
                startD.setDate(startD.getDate() - 6);
                startD.setHours(0, 0, 0, 0);
                endD.setHours(23, 59, 59, 999);
            } else if (preset === '30days') {
                startD.setDate(startD.getDate() - 29);
                startD.setHours(0, 0, 0, 0);
                endD.setHours(23, 59, 59, 999);
            }

            const startStr = formatDateTimeStr(startD);
            const endStr = formatDateTimeStr(endD);

            if (dongleReportStartPicker) dongleReportStartPicker.setDate(startD, true);
            else {
                const el = document.getElementById('dongleReportStartDate');
                if (el) el.value = startStr;
            }

            if (dongleReportEndPicker) dongleReportEndPicker.setDate(endD, true);
            else {
                const el = document.getElementById('dongleReportEndDate');
                if (el) el.value = endStr;
            }

            fetchDongleStateReports();
        }
        window.setDongleReportPreset = setDongleReportPreset;

        async function fetchDongleStateReports() {
            initDongleReportPickers();

            const startInput = document.getElementById('dongleReportStartDate_raw') || document.getElementById('dongleReportStartDate');
            const endInput = document.getElementById('dongleReportEndDate_raw') || document.getElementById('dongleReportEndDate');
            const dongleSelect = document.getElementById('dongleReportDongleSelect');
            const simSelect = document.getElementById('dongleReportSimSelect');

            const summaryContainer = document.getElementById('dongleReportSummaryContainer');
            const tablesContainer = document.getElementById('dongleReportTablesContainer');
            if (!summaryContainer || !tablesContainer) return;

            if (startInput && !startInput.value) {
                const d = new Date(); d.setHours(0, 0, 0, 0);
                if (dongleReportStartPicker) dongleReportStartPicker.setDate(d, true);
                else startInput.value = formatDateTimeStr(d);
            }
            if (endInput && !endInput.value) {
                const d = new Date(); d.setHours(23, 59, 59, 999);
                if (dongleReportEndPicker) dongleReportEndPicker.setDate(d, true);
                else endInput.value = formatDateTimeStr(d);
            }

            const startDate = startInput ? startInput.value : '';
            const endDate = endInput ? endInput.value : '';
            const dongleId = dongleSelect ? dongleSelect.value : 'ALL';
            const simNumber = simSelect ? simSelect.value : 'ALL';

            summaryContainer.innerHTML = `<div class="col-span-full text-center text-xs text-[var(--text-muted)] py-4">${isRtl ? 'جاري تحميل تفاصيل التقرير...' : 'Loading state duration report metrics...'}</div>`;
            tablesContainer.innerHTML = '';

            try {
                const url = `/api/config/modem/reports?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}&dongleId=${encodeURIComponent(dongleId)}&simNumber=${encodeURIComponent(simNumber)}`;
                const res = await fetch(url);
                const data = await res.json();

                if (!data.success) {
                    summaryContainer.innerHTML = `<div class="col-span-full text-center text-xs text-red-400 py-4">Error: ${escapeHtml(data.error)}</div>`;
                    return;
                }

                const g = data.globalSummary || {};
                summaryContainer.innerHTML = `
                    <div class="panel-surface rounded-xl p-4 border border-[var(--border-primary)] bg-emerald-500/5">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-400">${isRtl ? 'جاهز / متاح' : 'Ready (Free)'}</span>
                            <span class="text-xs font-mono font-bold text-emerald-400">${g.Free?.pct || 0}%</span>

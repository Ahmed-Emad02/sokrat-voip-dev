                                <th class="py-3 px-4"><%= isRtl ? 'رسالة الترحيب' : 'Announcement' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'أقصى وقت' : 'Max Wait' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الوجهة عند الإخفاق' : 'Fail Over Destination' %></th>
                                <th class="py-3 px-4"><%= isRtl ? 'الوجهة عند المواصلة' : 'Continue Destination' %></th>
                                <th class="py-3 px-4 text-center"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="queues-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">
                            <tr><td colspan="10" class="py-8 text-center text-[var(--text-muted)]">Loading queues...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <% } %>

        <!-- TAB IVR: IVR MANAGEMENT -->
        <% if (isTabAllowed('ivr')) { %>
        <div id="section-ivr" class="tab-section hidden">
            <div class="config-card p-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'الرد الآلي (IVR Menu)' : 'IVR Menus (Interactive Voice Response)' %></h2>
                    </div>
                    <button type="button" onclick="openIvrModal()" class="config-btn-primary px-4 py-2 text-xs flex items-center gap-2 cursor-pointer">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                        <span><%= isRtl ? 'إضافة قائمة رد آلي جديدة' : 'Add IVR Menu' %></span>

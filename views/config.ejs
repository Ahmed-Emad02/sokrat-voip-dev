                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.timegroups) return;
                    loadedTimeGroupsList = Array.isArray(data.timegroups) ? data.timegroups : [];
                    const list = loadedTimeGroupsList;
                    populateTcTimeGroupsSelect();

                    const countBadge = document.getElementById('timegroups-count-badge');
                    if (countBadge) countBadge.textContent = `${data.timegroups.length} ${data.timegroups.length === 1 ? 'Group' : 'Groups'}`;

                    renderTimeGroupsTable(data.timegroups);
                });

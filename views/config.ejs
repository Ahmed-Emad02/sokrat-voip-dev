                                        <div class="flex items-center gap-1.5">
                                            <label for="dest-dongle-${this.instanceId}" class="text-[10px] text-[var(--text-muted)] font-bold shrink-0">${this.isRtl ? 'المنفذ:' : 'Trunk:'}</label>
                                            <select id="dest-dongle-${this.instanceId}" name="dest_dongle_${this.instanceId}" aria-label="${this.isRtl ? 'منفذ الشريحة' : 'Failover Trunk'}" class="dest-external-dongle config-input w-full text-[11px] py-1 font-mono">
                                                <option value="" ${!this.selectedDongle ? 'selected' : ''}>${this.isRtl ? 'تلقائي (تسلسل المسارات الصادرة)' : 'Auto (Outbound Routes Sequence)'}</option>

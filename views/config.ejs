        async function editQueue(extNum) {
            await ensureAllConfigListsLoaded();
            const q = loadedQueuesList.find(item => String(item.extension) === String(extNum));
            if (!q) return;

            document.getElementById('queueModalTitle').textContent = (isRtl ? 'تعديل طابور الانتظار ' : 'Edit Queue ') + q.extension;
            document.getElementById('queueEditMode').value = "true";
            document.getElementById('queueNum').value = q.extension;
            document.getElementById('queueNum').disabled = true;
            document.getElementById('queueDesc').value = q.descr || '';
            document.getElementById('queueStrategy').value = q.strategy || 'rrmemory';
            document.getElementById('queueMoh').value = q.musicclass || 'default';
            document.getElementById('queueRecording').value = (q.monitor_type === 'bgrnd' || q.monitor_type === 'yes') ? 'yes' : (q.monitor_type === '' ? 'no' : 'yes');
            document.getElementById('queueMaxWait').value = q.maxwait || 0;
            document.getElementById('queueAgentTimeout').value = q.timeout || 15;
            document.getElementById('queueRetry').value = q.retry || 5;
            document.getElementById('queueAutofill').value = q.autofill || 'yes';
            document.getElementById('queueSkipBusy').value = (q.cwignore == 1 || q.cwignore === '1') ? 'yes' : 'no';

            const staticArr = Array.isArray(q.static_members) ? q.static_members : (q.static_members ? String(q.static_members).split(/[\r\n, ]+/) : []);
            const dynArr = Array.isArray(q.dynmembers) ? q.dynmembers : (q.dynmembers ? String(q.dynmembers).split(/[\r\n, ]+/) : []);
            const allAgents = Array.from(new Set([...staticArr, ...dynArr].map(e => String(e).trim()).filter(Boolean)));
            const agentsStr = allAgents.join(', ');

            document.getElementById('queueStaticList').value = agentsStr;
            document.getElementById('queueDynList').value = agentsStr;

            populateQueueAnnouncementsDropdown();
            document.getElementById('queueAnnMsg').value = q.joinannounce_id || 0;

            const destVal = q.dest || 'app-blackhole,hangup,1';
            document.getElementById('queueDestination').value = destVal;

            renderQueueAgentChecklist();

            initDestinationSelectInstances();
            if (queueDestSelectInstance) queueDestSelectInstance.setDialplan(destVal);

            openModal('queueModal');
        }

        function saveQueue(e) {
            e.preventDefault();
            const isEdit = document.getElementById('queueEditMode').value === "true";
            const extension = document.getElementById('queueNum').value.trim();
            const descr = document.getElementById('queueDesc').value.trim();
            const static_members = document.getElementById('queueStaticList').value.trim();
            const dynmembers = document.getElementById('queueDynList').value.trim();
            const strategy = document.getElementById('queueStrategy').value;
            const musicclass = document.getElementById('queueMoh').value;
            const joinannounce_id = document.getElementById('queueAnnMsg').value;
            const recording = document.getElementById('queueRecording').value;
            const maxwait = document.getElementById('queueMaxWait').value;
            const timeout = document.getElementById('queueAgentTimeout').value;
            const retry = document.getElementById('queueRetry').value;
            const autofill = document.getElementById('queueAutofill').value;
            const skip_busy = document.getElementById('queueSkipBusy').value;
            const dest = document.getElementById('queueDestination').value;

            const url = isEdit ? '/api/config/queues/' + extension : '/api/config/queues';
            const method = isEdit ? 'PUT' : 'POST';

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    extension, descr, static_members, dynmembers, strategy, musicclass,
                    joinannounce_id, recording, maxwait, timeout, retry, autofill, skip_busy, dest
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('queueModal');
                    fetchQueues();
                } else {
                    showToast(data.error, 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'));
        }

        function deleteQueue(extension) {
            if (!confirm(`Delete Queue ${extension}?`)) return;
            fetch('/api/config/queues/' + extension, { method: 'DELETE' })

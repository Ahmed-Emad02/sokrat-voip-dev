                        </div>
                        
                        <button type="button" onclick="addTimeGroupRuleToModal()" class="w-full py-2.5 border border-dashed border-sky-500/30 hover:border-sky-500/60 rounded-xl text-xs font-bold text-sky-400 bg-sky-500/10 hover:bg-sky-500/20 cursor-pointer transition flex items-center justify-center gap-2">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>+ <%= isRtl ? 'إضافة قاعدة فترة زمنية جديدة' : 'Add Time Interval Rule' %></span>
                        </button>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('timeGroupModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ مجموعة الوقت' : 'Save Time Group' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL 9: TIME CONDITION FORM -->
    <div id="timeConditionModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] shadow-2xl max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    </div>
                    <div>
                        <h3 id="timeConditionModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة شرط وقت' : 'Add Time Condition' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'ربط مجموعة وقت بوجهات المطابقة (مفتوح / مغلق)' : 'Associate time group rules with open and after-hours destinations' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('timeConditionModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Scrollable Body -->
            <form id="timeConditionForm" onsubmit="saveTimeCondition(event)" class="flex flex-col flex-1 overflow-hidden">
                <input type="hidden" id="tcEditMode" value="false">
                <input type="hidden" id="tcId" value="">
                <div class="flex-1 overflow-y-auto p-6 space-y-5 custom-scrollbar">
                    
                    <!-- SECTION 1: TIME CONDITION DEFINITION (Cyan Theme) -->
                    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/5 p-4 space-y-3">
                        <div class="flex items-center justify-between pb-2 border-b border-cyan-500/15">
                            <span class="text-xs font-black uppercase tracking-wider text-cyan-400 flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'تعريف شرط الوقت والمجموعة' : 'Time Condition Identity' %>
                            </span>
                            <span class="text-[10px] text-cyan-400/70 font-mono"><%= isRtl ? 'أساسي' : 'REQUIRED' %></span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'الاسم الظاهر *' : 'Display Name *' %></label>
                                <input type="text" id="tcDisplayName" required placeholder="e.g. Office Hours Route" class="config-input w-full text-xs">
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'مجموعة الوقت *' : 'Time Group *' %></label>
                                <select id="tcTimeGroup" required class="config-input w-full text-xs font-semibold">
                                    <option value="">-- Choose Time Group --</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- SECTION 2: DESTINATIONS MATCH / UNMATCH (Emerald & Rose Split Theme) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Destination if MATCH (True / Open) -->
                        <div class="rounded-xl border border-emerald-500/20 bg-emerald-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-emerald-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-emerald-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                    <%= isRtl ? 'الوجهة عند المطابقة (مفتوح / True)' : 'Destination if Matched (True / Open)' %>
                                </span>
                                <span class="text-[10px] text-emerald-400/70 font-mono">MATCHED</span>
                            </div>
                            <div id="tcTrueDestComponentContainer"></div>
                            <input type="hidden" id="tcTrueGoto" required>
                        </div>

                        <!-- Destination if NO MATCH (False / Closed) -->
                        <div class="rounded-xl border border-rose-500/20 bg-rose-500/5 p-4 space-y-3">
                            <div class="flex items-center justify-between pb-2 border-b border-rose-500/15">
                                <span class="text-xs font-black uppercase tracking-wider text-rose-400 flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                    <%= isRtl ? 'الوجهة عند عدم المطابقة (مغلق / False)' : 'Destination if NOT Matched (False / Closed)' %>
                                </span>
                                <span class="text-[10px] text-rose-400/70 font-mono">UNMATCHED</span>
                            </div>
                            <div id="tcFalseDestComponentContainer"></div>
                            <input type="hidden" id="tcFalseGoto" required>
                        </div>
                    </div>

                </div>

                <!-- Footer -->
                <div class="flex items-center justify-end gap-3 px-6 py-4 border-t border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                    <button type="button" onclick="closeModal('timeConditionModal')" class="config-btn-secondary px-5 py-2.5 text-xs font-semibold"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-6 py-2.5 text-xs font-bold flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        <span><%= isRtl ? 'حفظ شرط الوقت' : 'Save Time Condition' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ANNOUNCEMENT MODAL -->
    <div id="announcementModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] shadow-2xl max-w-3xl w-full flex flex-col text-[var(--text-primary)] max-h-[92vh] overflow-hidden">
            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-500/10 text-amber-400 rounded-xl border border-amber-500/20">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.684A1.76 1.76 0 013 12V8a1.76 1.76 0 012.436-1.684l3.181-1.363A1.76 1.76 0 0111 6.592v10.816a1.76 1.76 0 01-2.383 1.644l-3.181-1.368z" />
                        </svg>
                    </div>
                    <div>
                        <h3 id="announcementModalTitle" class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة إعلان جديد' : 'Add Announcement' %></h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= isRtl ? 'إعداد رسالة صوتية وإعادة توجيه الاتصال بعد انتهائها' : 'Configure playback recording and post-playback call routing' %></p>
                    </div>
                </div>
                <button type="button" onclick="closeModal('announcementModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:border-red-500/40 flex items-center justify-center cursor-pointer transition-colors">✕</button>
            </div>

            <!-- Body -->
            <form id="announcementForm" onsubmit="saveAnnouncement(event)" class="flex-1 overflow-y-auto p-6 space-y-5">
                <input type="hidden" id="annEditMode" value="false">
                <input type="hidden" id="annId" value="">

                <!-- 1. Description / Name -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'وصف/اسم الإعلان *' : 'Description / Name *' %></label>
                    <input type="text" id="annDescription" required placeholder="e.g. Welcome Announcement" class="config-input w-full text-xs">
                </div>

                <!-- 2. System Recording -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'التسجيل الصوتي' : 'System Recording' %></label>
                    <select id="annRecording" onchange="onAnnRecordingChange()" class="config-input w-full text-xs font-semibold">
                        <option value="0">== <%= isRtl ? 'بدون تسجيل (استخدام تحويل النص إلى كلام)' : 'None (Use Text-To-Speech TTS)' %> ==</option>
                    </select>
                </div>

                <!-- 3. Repeat Message Key -->
                <div>
                    <label class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'مفتاح إعادة التكرار' : 'Repeat Message Key' %></label>
                    <select id="annRepeatMsg" class="config-input w-full text-xs font-semibold">
                        <option value=""><%= isRtl ? 'بدون تكرار (None)' : 'None (No repeat key)' %></option>
                        <option value="0">0</option>
                        <option value="1">1</option>
                        <option value="2">2</option>
                        <option value="3">3</option>
                        <option value="4">4</option>
                        <option value="5">5</option>
                        <option value="6">6</option>
                        <option value="7">7</option>
                        <option value="8">8</option>
                        <option value="9">9</option>
                        <option value="*">*</option>
                        <option value="#">#</option>
                    </select>
                </div>

                <!-- 3.5 Text-to-Speech Engine (TTS) -->
                <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                    <span class="text-xs font-bold text-sky-400 uppercase tracking-wider block"><%= isRtl ? 'تحويل النص إلى كلام (Text-To-Speech)' : 'Text-To-Speech (TTS Engine)' %></span>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                        <div>
                            <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اللغة' : 'Language' %></label>
                            <select id="annTtsLang" class="config-input w-full text-xs font-semibold">
                                <option value="en-US">English (en-US)</option>
                                <option value="en-GB">English (en-GB)</option>
                                <option value="es-ES">Spanish (es-ES)</option>
                                <option value="fr-FR">French (fr-FR)</option>
                                <option value="it-IT">Italian (it-IT)</option>
                                <option value="de-DE">German (de-DE)</option>
                            </select>
                        </div>
                        <div class="sm:col-span-2">
                            <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'النص الصوتي (ينشط عند عدم اختيار تسجيل)' : 'TTS Text (used when System Recording is None)' %></label>
                            <input type="text" id="annTtsText" placeholder="e.g. Welcome to our company. Please hold." class="config-input w-full text-xs">
                        </div>
                    </div>
                </div>
                <!-- 4. Playback Behavior Flags -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
                    <label class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annAllowSkip" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'السماح بالتخطي (Allow Skip)' : 'Allow Skip' %></span>
                    </label>
                    <label class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annReturnIvr" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'العودة للرد الآلي (Return IVR)' : 'Return to IVR' %></span>
                    </label>
                    <label class="flex items-center gap-2 p-3 bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl cursor-pointer hover:border-[var(--border-accent)] transition">
                        <input type="checkbox" id="annNoAnswer" class="rounded border-zinc-700 text-amber-500 focus:ring-amber-500 bg-zinc-900">
                        <span class="text-xs font-bold text-[var(--text-primary)]"><%= isRtl ? 'عدم الإجابة (Don\'t Answer)' : 'Don\'t Answer' %></span>
                    </label>
                </div>

                <!-- 5. Post Playback Destination -->
                <div class="panel-surface p-4 rounded-xl border border-[var(--border-primary)] space-y-3">
                    <span class="text-xs font-bold text-amber-400 uppercase tracking-wider block"><%= isRtl ? 'الوجهة المستهدفة بعد الانتهاء *' : 'Post Playback Destination *' %></span>
                    <div id="annPostDestComponentContainer"></div>
                    <input type="hidden" id="annPostDestination" required>
                </div>
                <!-- Form Action Buttons -->
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-[var(--border-primary)] shrink-0">
                    <button type="button" onclick="closeModal('announcementModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs"><%= isRtl ? 'حفظ الإعلان' : 'Save Announcement' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: ADD MOH CATEGORY -->
    <div id="mohCategoryModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] shadow-2xl max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة فئة موسيقى جديدة' : 'Add MoH Category' %></h3>
                <button type="button" onclick="closeModal('mohCategoryModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="saveMohCategory(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اسم الفئة *' : 'Category Name *' %></label>
                    <input type="text" id="mohCatName" required placeholder="e.g. promo_music" class="config-input w-full font-mono text-xs">
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'طريقة الفرز (Sort Order)' : 'Sort Order' %></label>
                    <select id="mohCatSort" class="config-input w-full text-xs font-mono">
                        <option value="alpha">alpha (Alphabetical)</option>
                        <option value="rand">rand (Random order)</option>
                        <option value="random_start">random_start (Random start position)</option>
                    </select>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('mohCategoryModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'إنشاء الفئة' : 'Create Category' %></button>
                </div>
            </form>
    </div>
    </div>

    <!-- MODAL: ADD DONGLE SLOT (ROOT USER ONLY) -->
    <div id="addDongleSlotModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] shadow-2xl max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إضافة شريحة/مودم جديد لـ Asterisk' : 'Add Dongle Slot(s) to Asterisk' %></h3>
                <button type="button" onclick="closeModal('addDongleSlotModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="saveNewDongleSlot(event)" class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'عدد الشرائح (Quantity) *' : 'Quantity to Add *' %></label>
                        <input type="number" id="newSlotCount" value="1" min="1" max="32" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs font-bold text-emerald-400">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'سابقة الاسم (Prefix)' : 'Name Prefix' %></label>
                        <input type="text" id="newSlotPrefix" value="dongle" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'اسم الفتحة الأولى (Custom Name if Qty=1)' : 'Custom Slot Name (Single Slot)' %></label>
                    <input type="text" id="newSlotName" placeholder="e.g. dongle1" oninput="updateDongleSlotPreview()" class="config-input w-full font-mono text-xs">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'منفذ الصوت الأولي' : 'Base Audio TTY Port' %></label>
                        <input type="text" id="newSlotAudio" placeholder="/dev/ttyUSB1" class="config-input w-full font-mono text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'منفذ البيانات الأولي' : 'Base Data TTY Port' %></label>
                        <input type="text" id="newSlotData" placeholder="/dev/ttyUSB2" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1">Rx Gain (dB)</label>
                        <input type="number" id="newSlotRxGain" value="0" min="-10" max="10" class="config-input w-full font-mono text-xs">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1">Tx Gain (dB)</label>
                        <input type="number" id="newSlotTxGain" value="0" min="-10" max="10" class="config-input w-full font-mono text-xs">
                    </div>
                </div>
                <div class="p-2.5 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-xs font-mono text-emerald-400">
                    <span class="block text-[10px] text-[var(--text-muted)] uppercase mb-0.5"><%= isRtl ? 'معاينة الفتحات المضافة' : 'Preview Slots To Create' %>:</span>
                    <span id="newSlotPreviewText" class="font-bold">dongle0</span>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('addDongleSlotModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold"><%= isRtl ? 'إضافة الشرائح' : 'Add Slot(s)' %></button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: REMOVE DONGLE SLOT (ROOT USER ONLY) -->
    <div id="removeDongleSlotModal" class="fixed inset-0 bg-black/75 backdrop-blur-md z-50 flex items-center justify-center hidden p-4 sm:p-6">
        <div class="bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] shadow-2xl max-w-md w-full flex flex-col text-[var(--text-primary)] overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 shrink-0">
                <h3 class="text-base font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'حذف شرائح/مودم من Asterisk' : 'Remove Dongle Slot(s) from Asterisk' %></h3>
                <button type="button" onclick="closeModal('removeDongleSlotModal')" class="w-8 h-8 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-muted)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer">✕</button>
            </div>
            <form onsubmit="executeRemoveDongleSlot(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'عدد الشرائح المراد حذفها (من الأخيرة)' : 'Quantity of Slots to Remove (From Last)' %></label>
                    <input type="number" id="removeSlotCount" value="1" min="1" max="32" class="config-input w-full font-mono text-xs text-red-400 font-bold mb-2">
                </div>
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= isRtl ? 'أو اختر فتحات محددة لحذفها' : 'Or Select Specific Dongle Slots to Remove' %></label>
                    <div id="removeSlotChecklist" class="space-y-1.5 max-h-40 overflow-y-auto p-2.5 bg-[var(--bg-card)] rounded-lg border border-[var(--border-primary)] font-mono text-xs custom-scrollbar">
                        <!-- Populated dynamically -->
                    </div>
                </div>
                <p class="text-xs text-amber-400 font-semibold leading-relaxed">
                    <%= isRtl ? 'ملاحظة: سيتم حذف الفتحات المحددة من dongle.conf وتنظيف مطابقات AstDB وتحديث Asterisk.' : 'Notice: This will remove the selected dongle sections from dongle.conf and reload Asterisk.' %>
                </p>
                <div class="flex justify-end gap-3 pt-4 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeModal('removeDongleSlotModal')" class="config-btn-secondary px-4 py-2 text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="config-btn-primary px-5 py-2 text-xs font-bold bg-red-600 hover:bg-red-700"><%= isRtl ? 'تأكيد الحذف' : 'Confirm Delete' %></button>
                </div>
            </form>
        </div>
    </div>
    <!-- CLIENT SCRIPT -->
    <script>
        const isRtl = <%= isRtl ? 'true' : 'false' %>;
        const MAX_EMPLOYEE_PHOTO_BYTES = 50 * 1024 * 1024;
        let employeePhotoObjectUrl = null;
        let loadedTrunksList = [];
        let loadedRecordingsList = [];
        let loadedExtensionsList = [];
        let loadedRingGroupsList = [];
        let loadedQueuesList = [];
        let loadedAnnouncementsList = [];
        let modalPatternsList = [];
        let modalTrunksSequence = [];
        let editingPatternIndex = -1;

        // --- DYNAMIC NESTED PBX DESTINATION SELECTOR COMPONENT (DestinationSelect) ---
        let destinationSelectCounter = 0;
        class DestinationSelect {
            constructor(containerEl, options = {}) {
                this.container = typeof containerEl === 'string' ? document.getElementById(containerEl) : containerEl;
                this.instanceId = ++destinationSelectCounter;
                this.initialDialplan = options.initialDialplan || 'app-blackhole,hangup,1';
                this.onChangeCallback = options.onChange || null;
                this.inputName = options.inputName || null;
                this.isRtl = Boolean(options.isRtl || (typeof isRtl !== 'undefined' ? isRtl : false));

                this.selectedCategory = 'terminate';
                this.selectedTarget = 'hangup';
                this.dialplanString = this.initialDialplan;
                this.customDialplanString = '';
                this.searchTerm = '';

                this.init();
            }

            static getCategories() {
                const rtl = typeof isRtl !== 'undefined' ? isRtl : false;
                
                const extTargets = (typeof loadedExtensionsList !== 'undefined' ? loadedExtensionsList : []).map(e => ({
                    id: String(e.extension),
                    label: `${e.extension} - ${e.name || ''}`,
                    dialplanString: `from-did-direct,${e.extension},1`
                }));

                const ringTargets = (typeof loadedRingGroupsList !== 'undefined' ? loadedRingGroupsList : []).map(rg => ({
                    id: String(rg.grpnum),
                    label: `Group ${rg.grpnum} - ${rg.description || ''}`,
                    dialplanString: `ext-group,${rg.grpnum},1`
                }));

                const queueTargets = (typeof loadedQueuesList !== 'undefined' ? loadedQueuesList : []).map(q => ({
                    id: String(q.extension),
                    label: `Queue ${q.extension} - ${q.descr || ''}`,
                    dialplanString: `ext-queues,${q.extension},1`
                }));

                const ivrTargets = (typeof loadedIvrsList !== 'undefined' ? loadedIvrsList : []).map(i => ({
                    id: String(i.id),
                    label: `IVR #${i.id} - ${i.name || ''}`,
                    dialplanString: `ivr-${i.id},s,1`
                }));

                const annTargets = (typeof loadedAnnouncementsList !== 'undefined' ? loadedAnnouncementsList : []).map(a => ({
                    id: String(a.announcement_id),
                    label: `Announcement: ${a.description || ''} (ID: ${a.announcement_id})`,
                    dialplanString: `app-announcement-${a.announcement_id},s,1`
                }));

                const vmTargets = (typeof loadedExtensionsList !== 'undefined' ? loadedExtensionsList : []).map(e => ({
                    id: `vmu${e.extension}`,
                    label: `VM: ${e.extension} - ${e.name || ''}`,
                    dialplanString: `ext-local,vmu${e.extension},1`
                }));

                const tcTargets = (typeof loadedTimeConditionsList !== 'undefined' ? loadedTimeConditionsList : []).map(tc => ({
                    id: String(tc.timeconditions_id),
                    label: `Time Condition: ${tc.displayname || ''}`,
                    dialplanString: `timeconditions,${tc.timeconditions_id},1`
                }));

                const mohTargets = (typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : []).map(cat => ({
                    id: String(cat.name),
                    label: `MoH Class: ${cat.name} (${cat.fileCount || 0} tracks)${cat.isDefault ? ' [System]' : ''}`,
                    dialplanString: `ext-moh,${cat.name},1`
                }));

                const trunkTargets = (typeof loadedTrunksList !== 'undefined' ? loadedTrunksList : []).map(t => ({
                    id: String(t.trunkid),
                    label: `Trunk: ${t.name || ''} (${t.tech || ''})`,
                    dialplanString: `ext-trunk,${t.trunkid},1`
                }));

                return [
                    {
                        id: 'terminate',
                        label: rtl ? 'إنهاء المكالمة (Terminate Call)' : 'Terminate Call',
                        targets: [
                            { id: 'hangup', label: rtl ? 'قطع الخط (Hangup)' : 'Hangup', dialplanString: 'app-blackhole,hangup,1' },
                            { id: 'congestion', label: rtl ? 'نغمة ازدحام (Congestion)' : 'Congestion', dialplanString: 'app-blackhole,congestion,1' },
                            { id: 'busy', label: rtl ? 'نغمة مشغول (Busy)' : 'Busy', dialplanString: 'app-blackhole,busy,1' },
                            { id: 'zapateller', label: rtl ? 'تشغيل نغمة SIT (Zapateller)' : 'Play SIT Tone (Zapateller)', dialplanString: 'app-blackhole,zapateller,1' },
                            { id: 'musiconhold', label: rtl ? 'وضع المتصل في الانتظار الدائم' : 'Put caller on hold forever', dialplanString: 'app-blackhole,musiconhold,1' },
                            { id: 'ringback', label: rtl ? 'تشغيل نغمة رنين حتى قطع الخط' : 'Play ringtones to caller until they hangup', dialplanString: 'app-blackhole,ringing,1' }
                        ]
                    },
                    {
                        id: 'extensions',
                        label: rtl ? 'الهواتف الفرعية (Extensions)' : 'Extensions',
                        targets: extTargets
                    },
                    {
                        id: 'ringgroups',
                        label: rtl ? 'مجموعات الرنين (Ring Groups)' : 'Ring Groups',
                        targets: ringTargets
                    },
                    {
                        id: 'queues',
                        label: rtl ? 'طوابير الانتظار (Queues)' : 'Queues',
                        targets: queueTargets
                    },
                    {
                        id: 'ivr',
                        label: rtl ? 'قائمة الرد الآلي (IVR Menu)' : 'IVR Menu',
                        targets: ivrTargets
                    },
                    {
                        id: 'announcements',
                        label: rtl ? 'الإعلانات الصوتية (Announcements)' : 'Announcements',
                        targets: annTargets
                    },
                    {
                        id: 'voicemail',
                        label: rtl ? 'البريد الصوتي (Voicemail)' : 'Voicemail',
                        targets: vmTargets
                    },
                    {
                        id: 'timeconditions',
                        label: rtl ? 'شروط الوقت (Time Conditions)' : 'Time Conditions',
                        targets: tcTargets
                    },
                    {
                        id: 'musiconhold',
                        label: rtl ? 'الموسيقى أثناء الانتظار (Music on Hold - MoH)' : 'Music on Hold (MoH)',
                        targets: mohTargets.length ? mohTargets : [
                            { id: 'default', label: 'Default MoH Class', dialplanString: 'ext-moh,default,1' },
                            { id: 'none', label: 'None (Silence)', dialplanString: 'app-blackhole,musiconhold,1' }
                        ]
                    },
                    {
                        id: 'trunks',
                        label: rtl ? 'خطوط الربط (Trunks)' : 'Trunks',
                        targets: trunkTargets
                    },
                    {
                        id: 'custom',
                        label: rtl ? 'تطبيق مخصص (Custom App)' : 'Custom App',
                        targets: []
                    }
                ];
            }

            static parseDialplanString(destStr) {
                const dest = String(destStr || '').trim();
                if (!dest || dest === 'app-blackhole,hangup,1') return { category: 'terminate', target: 'hangup', dialplan: 'app-blackhole,hangup,1' };
                if (dest === 'app-blackhole,congestion,1') return { category: 'terminate', target: 'congestion', dialplan: 'app-blackhole,congestion,1' };
                if (dest === 'app-blackhole,busy,1') return { category: 'terminate', target: 'busy', dialplan: 'app-blackhole,busy,1' };
                if (dest === 'app-blackhole,zapateller,1') return { category: 'terminate', target: 'zapateller', dialplan: 'app-blackhole,zapateller,1' };
                if (dest === 'app-blackhole,musiconhold,1') return { category: 'terminate', target: 'musiconhold', dialplan: 'app-blackhole,musiconhold,1' };
                if (dest === 'app-blackhole,ringing,1') return { category: 'terminate', target: 'ringback', dialplan: 'app-blackhole,ringing,1' };
                if (dest.startsWith('musiconhold,') || dest.startsWith('ext-moh,')) {
                    const catName = dest.split(',')[1] || 'default';
                    return { category: 'musiconhold', target: catName, dialplan: dest };
                }
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                    const ext = dest.split(',')[1];
                    if (ext && ext.startsWith('vmu')) {
                        return { category: 'voicemail', target: ext, dialplan: dest };
                    }
                    return { category: 'extensions', target: ext, dialplan: dest };
                }
                if (dest.startsWith('ext-group,')) return { category: 'ringgroups', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('ext-queues,')) return { category: 'queues', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('ivr-')) return { category: 'ivr', target: dest.split(',')[0].replace('ivr-', ''), dialplan: dest };
                if (dest.startsWith('app-announcement-')) return { category: 'announcements', target: dest.split(',')[0].replace('app-announcement-', ''), dialplan: dest };
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) return { category: 'timeconditions', target: dest.split(',')[1], dialplan: dest };
                if (dest.startsWith('ext-trunk,')) return { category: 'trunks', target: dest.split(',')[1], dialplan: dest };

                return { category: 'custom', target: 'custom', dialplan: dest };
            }

            init() {
                const parsed = DestinationSelect.parseDialplanString(this.initialDialplan);
                this.selectedCategory = parsed.category;
                this.selectedTarget = parsed.target;
                this.dialplanString = parsed.dialplan;
                if (this.selectedCategory === 'custom') {
                    this.customDialplanString = parsed.dialplan;
                }

                this.render();
            }

            setDialplan(destStr) {
                this.initialDialplan = destStr;
                const parsed = DestinationSelect.parseDialplanString(destStr);
                this.selectedCategory = parsed.category;
                this.selectedTarget = parsed.target;
                this.dialplanString = parsed.dialplan;
                if (this.selectedCategory === 'custom') {
                    this.customDialplanString = parsed.dialplan;
                } else {
                    this.customDialplanString = '';
                }
                this.searchTerm = '';
                this.render();
            }

            emitChange() {
                const payload = {
                    category: this.selectedCategory,
                    target: this.selectedTarget,
                    dialplan: this.dialplanString
                };
                if (typeof this.onChangeCallback === 'function') {
                    this.onChangeCallback(payload);
                }
            }

            render() {
                if (!this.container) return;
                if (this.currentMenu && this.currentMenu.parentNode) {
                    try { this.currentMenu.parentNode.removeChild(this.currentMenu); } catch(_) {}
                    this.currentMenu = null;
                }
                const categories = DestinationSelect.getCategories();
                const currentCatObj = categories.find(c => c.id === this.selectedCategory) || categories[0];
                let filteredTargets = currentCatObj ? (currentCatObj.targets || []) : [];
                if (this.searchTerm.trim()) {
                    const term = this.searchTerm.toLowerCase().trim();
                    filteredTargets = filteredTargets.filter(t =>
                        t.label.toLowerCase().includes(term) ||
                        t.id.toLowerCase().includes(term) ||
                        t.dialplanString.toLowerCase().includes(term)
                    );
                }

                const isCustom = this.selectedCategory === 'custom';

                this.container.innerHTML = `
                    <div class="destination-select-wrapper space-y-2 text-xs">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <!-- Primary Category Select -->
                            <div>
                                <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1">
                                    ${this.isRtl ? 'فئة الوجهة (Category)' : 'Category'}
                                </label>
                                <select class="dest-primary-select config-input w-full font-bold text-xs py-1.5">
                                    ${categories.map(c => `<option value="${c.id}" ${c.id === this.selectedCategory ? 'selected' : ''}>${escapeHtml(c.label)}</option>`).join('')}
                                </select>
                            </div>

                            <!-- Secondary Target Select / Custom Input -->
                            <div>
                                <label class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-1">
                                    ${this.isRtl ? 'الهدف / الإجراء (Target)' : 'Target'}
                                </label>
                                ${isCustom ? `
                                    <input type="text" value="${escapeHtml(this.customDialplanString)}" placeholder="e.g. custom-app,s,1" class="dest-custom-input config-input w-full font-mono text-xs py-1.5">
                                ` : `
                                    <div class="relative dest-combobox-wrapper">
                                        <button type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="destination-dropdown-${this.instanceId}" class="dest-combobox-trigger custom-select-trigger config-dropdown-trigger w-full border rounded-lg px-3 py-2 flex items-center justify-between gap-2 cursor-pointer select-none transition">
                                            <span class="config-dropdown-label flex-1 text-[var(--text-primary)]">
                                                ${escapeHtml((currentCatObj.targets.find(t => t.id === this.selectedTarget) || currentCatObj.targets[0])?.label || 'Choose Target')}
                                            </span>
                                            <svg class="w-3.5 h-3.5 shrink-0 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                                        </button>
                                        <!-- Searchable Combobox Dropdown -->
                                        <div id="destination-dropdown-${this.instanceId}" class="dest-dropdown-menu config-dropdown-menu hidden">
                                            <div class="p-1 shrink-0">
                                                <input type="text" value="${escapeHtml(this.searchTerm)}" placeholder="${this.isRtl ? 'بحث في الخيارات...' : 'Search targets...'}" class="dest-search-input config-dropdown-search">
                                            </div>
                                            <div class="options-list config-dropdown-options space-y-1 custom-scrollbar flex-1" role="listbox">
                                                ${filteredTargets.length === 0 ? `
                                                    <div class="px-3 py-2 text-center text-[var(--text-muted)] text-[11px] italic">${this.isRtl ? 'لا توجد نتائج مطابقة' : 'No matching targets'}</div>
                                                ` : filteredTargets.map(t => `
                                                    <button type="button" role="option" aria-selected="${String(t.id === this.selectedTarget)}" data-target-id="${escapeHtml(t.id)}" data-dialplan="${escapeHtml(t.dialplanString)}" class="dest-option-item custom-select-option config-dropdown-option flex items-start justify-between gap-2 transition-colors ${t.id === this.selectedTarget ? 'is-selected font-bold' : ''}">
                                                        <span class="flex-1 min-w-0 whitespace-normal break-words">${escapeHtml(t.label)}</span>
                                                        <span class="font-mono text-[10px] opacity-60 shrink-0">${escapeHtml(t.dialplanString.split(',')[0])}</span>
                                                    </button>
                                                `).join('')}
                                            </div>
                                        </div>
                                    </div>
                                `}
                            </div>
                        </div>
                        ${this.inputName ? `<input type="hidden" name="${this.inputName}" class="dest-hidden-output" value="${escapeHtml(this.dialplanString)}">` : ''}
                    </div>
                `;

                this.bindEvents();
            }

            bindEvents() {
                const primarySelect = this.container.querySelector('.dest-primary-select');
                const customInput = this.container.querySelector('.dest-custom-input');
                const trigger = this.container.querySelector('.dest-combobox-trigger');
                const menu = this.container.querySelector('.dest-dropdown-menu');
                const searchInput = this.container.querySelector('.dest-search-input');

                if (menu && menu.parentNode !== document.body) {
                    document.body.appendChild(menu);
                    this.currentMenu = menu;
                }

                if (primarySelect) {
                    primarySelect.addEventListener('change', event => {
                        this.selectedCategory = event.target.value;
                        const categories = DestinationSelect.getCategories();
                        const category = categories.find(item => item.id === this.selectedCategory);
                        this.selectedTarget = category && category.targets.length
                            ? category.targets[0].id
                            : (this.selectedCategory === 'custom' ? 'custom' : '');
                        this.searchTerm = '';
                        this.render();
                        this.emitChange();
                    });
                }

                if (customInput) {
                    customInput.addEventListener('input', event => {
                        this.customDialplanString = event.target.value.trim();
                        this.dialplanString = this.customDialplanString;
                        this.emitChange();
                    });
                }

                const positionMenu = () => {
                    if (!trigger || !menu) return;
                    if (typeof window.positionConfigDropdown === 'function') {
                        window.positionConfigDropdown(trigger, menu);
                    }
                };
                const hideMenu = () => {
                    if (!menu) return;
                    if (typeof window.closeConfigDropdownMenu === 'function') {
                        window.closeConfigDropdownMenu(menu);
                    } else {
                        menu.classList.add('hidden');
                        trigger?.setAttribute('aria-expanded', 'false');
                    }
                };
                const chooseTarget = item => {
                    this.selectedTarget = item.getAttribute('data-target-id');
                    this.dialplanString = item.getAttribute('data-dialplan');
                    this.searchTerm = '';
                    hideMenu();
                    this.render();
                    this.emitChange();
                };
                const bindTargetItems = root => {
                    if (!root) return;
                    root.querySelectorAll('.dest-option-item').forEach(item => {
                        item.addEventListener('click', () => chooseTarget(item));
                    });
                };

                if (trigger && menu) {
                    menu._reposition = positionMenu;
                    menu._trigger = trigger;
                    trigger.addEventListener('click', event => {
                        event.stopPropagation();
                        const isOpening = menu.classList.contains('hidden');
                        if (!isOpening) {
                            hideMenu();
                            return;
                        }

                        if (typeof window.closeConfigDropdowns === 'function') {
                            window.closeConfigDropdowns(menu);
                        }
                        if (searchInput) {
                            this.searchTerm = '';
                            searchInput.value = '';
                            searchInput.dispatchEvent(new Event('input', { bubbles: true }));
                        }
                        menu.classList.remove('hidden');
                        trigger.setAttribute('aria-expanded', 'true');
                        positionMenu();
                        if (searchInput) setTimeout(() => searchInput.focus(), 0);
                    });
                    menu.addEventListener('click', event => event.stopPropagation());
                }

                if (searchInput && menu) {
                    searchInput.addEventListener('input', event => {
                        this.searchTerm = event.target.value;
                        const categories = DestinationSelect.getCategories();
                        const category = categories.find(item => item.id === this.selectedCategory) || categories[0];
                        let filtered = category.targets || [];
                        if (this.searchTerm.trim()) {
                            const term = this.searchTerm.toLowerCase().trim();
                            filtered = filtered.filter(target =>
                                target.label.toLowerCase().includes(term) ||
                                target.id.toLowerCase().includes(term) ||
                                target.dialplanString.toLowerCase().includes(term)
                            );
                        }

                        const optionsList = menu.querySelector('.options-list');
                        if (!optionsList) return;
                        optionsList.innerHTML = filtered.length === 0 ? `
                            <div class="px-3 py-2 text-center text-[var(--text-muted)] text-[11px] italic">${this.isRtl ? 'لا توجد نتائج مطابقة' : 'No matching targets'}</div>
                        ` : filtered.map(target => `
                            <button type="button" role="option" aria-selected="${String(target.id === this.selectedTarget)}" data-target-id="${escapeHtml(target.id)}" data-dialplan="${escapeHtml(target.dialplanString)}" class="dest-option-item custom-select-option config-dropdown-option flex items-start justify-between gap-2 transition-colors ${target.id === this.selectedTarget ? 'is-selected font-bold' : ''}">
                                <span class="flex-1 min-w-0 whitespace-normal break-words">${escapeHtml(target.label)}</span>
                                <span class="font-mono text-[10px] opacity-60 shrink-0">${escapeHtml(target.dialplanString.split(',')[0])}</span>
                            </button>
                        `).join('');
                        bindTargetItems(optionsList);
                        if (!menu.classList.contains('hidden')) positionMenu();
                    });
                    searchInput.addEventListener('keydown', event => {
                        if (event.key === 'Escape') {
                            event.stopPropagation();
                            hideMenu();
                            trigger?.focus();
                        } else if (event.key === 'Enter') {
                            event.preventDefault();
                            const firstMatch = menu.querySelector('.dest-option-item');
                            if (firstMatch) firstMatch.click();
                        }
                    });
                }

                bindTargetItems(menu);
            }
        }
        window.DestinationSelect = DestinationSelect;
        let inboundDestSelectInstance = null;
        let rgPostDestSelectInstance = null;
        let queueDestSelectInstance = null;
        let annPostDestSelectInstance = null;
        let tcTrueDestSelectInstance = null;
        let tcFalseDestSelectInstance = null;
        let ivrTimeoutDestSelectInstance = null;
        let ivrInvalidDestSelectInstance = null;

        function initDestinationSelectInstances() {
            const inContainer = document.getElementById('inDestComponentContainer');
            if (inContainer && !inboundDestSelectInstance) {
                inboundDestSelectInstance = new DestinationSelect(inContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('inDestination').value = p.dialplan; }
                });
            }
            const rgContainer = document.getElementById('rgPostDestComponentContainer');
            if (rgContainer && !rgPostDestSelectInstance) {
                rgPostDestSelectInstance = new DestinationSelect(rgContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('rgPostDestination').value = p.dialplan; }
                });
            }
            const queueContainer = document.getElementById('queueDestComponentContainer');
            if (queueContainer && !queueDestSelectInstance) {
                queueDestSelectInstance = new DestinationSelect(queueContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('queueDestination').value = p.dialplan; }
                });
            }
            const annContainer = document.getElementById('annPostDestComponentContainer');
            if (annContainer && !annPostDestSelectInstance) {
                annPostDestSelectInstance = new DestinationSelect(annContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('annPostDestination').value = p.dialplan; }
                });
            }
            const tcTrueContainer = document.getElementById('tcTrueDestComponentContainer');
            if (tcTrueContainer && !tcTrueDestSelectInstance) {
                tcTrueDestSelectInstance = new DestinationSelect(tcTrueContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('tcTrueGoto').value = p.dialplan; }
                });
            }
            const tcFalseContainer = document.getElementById('tcFalseDestComponentContainer');
            if (tcFalseContainer && !tcFalseDestSelectInstance) {
                tcFalseDestSelectInstance = new DestinationSelect(tcFalseContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('tcFalseGoto').value = p.dialplan; }
                });
            }
            const ivrTimeoutContainer = document.getElementById('ivrTimeoutDestComponentContainer');
            if (ivrTimeoutContainer && !ivrTimeoutDestSelectInstance) {
                ivrTimeoutDestSelectInstance = new DestinationSelect(ivrTimeoutContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('ivrTimeoutDestination').value = p.dialplan; }
                });
            }
            const ivrInvalidContainer = document.getElementById('ivrInvalidDestComponentContainer');
            if (ivrInvalidContainer && !ivrInvalidDestSelectInstance) {
                ivrInvalidDestSelectInstance = new DestinationSelect(ivrInvalidContainer, {
                    initialDialplan: 'app-blackhole,hangup,1',
                    onChange: (p) => { document.getElementById('ivrInvalidDestination').value = p.dialplan; }
                });
            }
        }
        // --- GSM DYNAMIC DID MAPPINGS SUBTAB ---
        async function fetchDongleMappingsTab() {
            try {
                const isRtl = document.documentElement.dir === 'rtl';
                const res = await fetch('/api/config/dongle-mappings');
                const data = await res.json();
                if (!data.success) {
                    showToast(isRtl ? 'فشل تحميل بيانات خريطة DIDs' : 'Failed to load DID mappings', 'error');
                    return;
                }
                const mappings = Array.isArray(data.mappings) ? data.mappings : [];
                document.getElementById('dmCardTotal').textContent = data.summary.totalCount || 0;
                document.getElementById('dmCardConnected').textContent = data.summary.connectedCount || 0;
                document.getElementById('dmCardSynced').textContent = data.summary.syncedCount || 0;
                document.getElementById('dmCardRoutes').textContent = data.summary.routeFoundCount || 0;

                const rosterCount = document.getElementById('dmRosterCount');
                if (rosterCount) {
                    rosterCount.textContent = `${mappings.length} ${isRtl ? 'أجهزة' : (mappings.length === 1 ? 'device' : 'devices')}`;
                }

                const tbody = document.getElementById('dmTableBody');
                if (!tbody) return;
                if (mappings.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" class="p-6 text-center text-[var(--text-muted)] italic">' + (isRtl ? 'لا توجد فتحات شرائح معرفة' : 'No GSM dongle slots found.') + '</td></tr>';
                    return;
                }

                tbody.innerHTML = mappings.map(m => {
                    const rawState = m.state || 'Not Connected';
                    const normalizedState = rawState.toLowerCase();
                    let stateColor = 'red';
                    let stateLabel = rawState;
                    let animate = false;

                    if (normalizedState.includes('not init')) {
                        stateColor = 'yellow';
                        stateLabel = isRtl ? 'لم يتم التهيئة' : 'Not Initialized';
                    } else if (normalizedState.includes('not connect') || normalizedState === 'not_connected' || normalizedState.includes('disconnected') || normalizedState.includes('not responding')) {
                        stateColor = 'red';
                        stateLabel = isRtl ? 'غير متصل' : (normalizedState === 'not_connected' || normalizedState.includes('disconnected') ? 'Not Connected' : rawState);
                    } else if (normalizedState === 'free' || normalizedState === 'idle') {
                        stateColor = 'purple';
                        stateLabel = isRtl ? 'شريحة نشطة (Free)' : 'Free';
                    } else if (normalizedState.includes('outgoing') || normalizedState.includes('incoming') || normalizedState.includes('active') || normalizedState.includes('busy')) {
                        stateColor = 'green';
                        stateLabel = normalizedState.includes('outgoing')
                            ? (isRtl ? 'مكالمة صادرة' : 'Outgoing Call')
                            : (normalizedState.includes('incoming') ? (isRtl ? 'مكالمة واردة' : 'Incoming Call') : (isRtl ? 'مكالمة نشطة' : 'Active Call'));
                        animate = true;
                    } else if (normalizedState.includes('not reg') || normalizedState.includes('searching') || normalizedState.includes('no signal') || normalizedState.includes('gsm')) {
                        stateColor = 'yellow';
                        stateLabel = isRtl ? 'غير مسجل بالشريحة' : 'GSM Not Registered';
                    } else if (normalizedState.includes('dial') || normalizedState.includes('ring') || normalizedState.includes('calling')) {
                        stateColor = 'blue';
                        stateLabel = normalizedState.includes('dial') ? (isRtl ? 'جاري الاتصال' : 'Dialing') : (isRtl ? 'جاري الرنين' : 'Ringing');
                        animate = true;
                    }

                    const badgeClasses = {
                        red: { bg: 'bg-red-500/15', text: 'text-red-400', border: 'border-red-500/30', dot: 'bg-red-500' },
                        purple: { bg: 'bg-purple-500/15', text: 'text-purple-400', border: 'border-purple-500/30', dot: 'bg-purple-400' },
                        green: { bg: 'bg-emerald-500/15', text: 'text-emerald-400', border: 'border-emerald-500/30', dot: 'bg-emerald-400' },
                        yellow: { bg: 'bg-yellow-500/15', text: 'text-yellow-400', border: 'border-yellow-500/30', dot: 'bg-yellow-400' },
                        blue: { bg: 'bg-blue-500/15', text: 'text-blue-400', border: 'border-blue-500/30', dot: 'bg-blue-400' }
                    }[stateColor];

                    const safeDongleName = escapeHtml(m.dongleName || '-');
                    const safePhoneNumber = escapeHtml(m.phoneNumber || '');
                    const safeSimNumber = escapeHtml(m.simNumber || '');
                    const safeImsi = escapeHtml(m.imsi || '-');
                    const safeImei = escapeHtml(m.imei || '-');
                    const safeProvider = escapeHtml(m.provider || (isRtl ? 'غير معروف' : 'Unknown network'));
                    const safeRssi = escapeHtml(m.rssi === undefined || m.rssi === null ? '-' : String(m.rssi));
                    const astdb = m.astdb || {};
                    const stateBadge = `<span class="inline-flex items-center gap-1.5 ${badgeClasses.bg} ${badgeClasses.text} rounded-full px-2 py-0.5 text-[10px] font-bold border ${badgeClasses.border}">
                        <span class="h-1.5 w-1.5 rounded-full ${badgeClasses.dot}${animate ? ' animate-pulse' : ''} shrink-0"></span>
                        <span>${escapeHtml(stateLabel)}</span>
                    </span>`;

                    const perDongleEnabled = m.dynamicEnabled === true;
                    const configuredDidDisplay = safePhoneNumber
                        ? `<div class="font-mono font-bold text-emerald-400 text-sm">${safePhoneNumber}</div>
                           <div class="text-[10px] ${perDongleEnabled ? 'text-cyan-400' : 'text-amber-400'} font-bold uppercase tracking-wider">${perDongleEnabled
                               ? (isRtl ? 'الخريطة الديناميكية مفعلة' : 'Dynamic mapping enabled')
                               : (isRtl ? 'الخريطة الديناميكية معطلة' : 'Dynamic mapping disabled')}</div>`
                        : `<span class="text-[var(--text-muted)] italic text-[11px]">${isRtl ? 'غير مهيأ' : 'Unconfigured'}</span>`;
                    const simReportDisplay = (m.simNumber && m.simNumber !== 'Unknown' && m.simNumber !== '-')
                        ? `<span class="font-mono text-[var(--text-primary)]">${safeSimNumber}</span>`
                        : (m.phoneNumber
                            ? `<span class="text-[10px] font-mono ${perDongleEnabled ? 'text-cyan-300' : 'text-amber-400'}">${perDongleEnabled
                                ? (isRtl ? 'غير مسجلة؛ الخريطة المهيأة مفعلة' : 'Unregistered; configured mapping enabled')
                                : (isRtl ? 'غير مسجلة؛ الخريطة معطلة' : 'Unregistered; mapping off')}</span>`
                            : `<span class="text-[10px] font-mono text-amber-400">${isRtl ? 'غير معروف' : 'Unknown'}</span>`);

                    const astdbDongleOk = Boolean(m.phoneNumber) && astdb.dongle_map === m.phoneNumber;
                    const astdbBadge = astdbDongleOk
                        ? `<span class="inline-flex px-2 py-0.5 text-[10px] font-mono rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">${isRtl ? 'AstDB متزامن' : 'AstDB synced'}</span>`
                        : `<span class="inline-flex px-2 py-0.5 text-[10px] font-mono rounded bg-red-500/10 text-red-400 border border-red-500/20">${isRtl ? 'AstDB يحتاج مزامنة' : 'AstDB needs sync'}</span>`;
                    const routeBadge = m.inboundRoute && m.inboundRoute.found
                        ? `<div class="space-y-1">
                               <div class="text-[11px] font-semibold text-purple-300 break-words">→ ${escapeHtml(m.inboundRoute.description || m.inboundRoute.destination || '-')}</div>
                               <div class="text-[10px] text-emerald-400">${isRtl ? 'مسار وارد مسجل' : 'Registered inbound route'}</div>
                           </div>`
                        : `<div class="text-[11px] font-semibold ${perDongleEnabled ? 'text-amber-400' : 'text-[var(--text-muted)]'}">${perDongleEnabled
                            ? (isRtl ? 'توجيه DID ديناميكي' : 'Dynamic DID routing')
                            : (isRtl ? 'الخريطة الديناميكية معطلة' : 'Dynamic mapping disabled')}</div>`;

                    const perDongleBtnClass = perDongleEnabled
                        ? 'config-action-btn config-action-btn--compact config-action-btn--state-on'
                        : 'config-action-btn config-action-btn--compact config-action-btn--state-off';
                    const perDongleBtnText = perDongleEnabled
                        ? (isRtl ? 'الخريطة مفعلة' : 'Mapping On')
                        : (isRtl ? 'الخريطة معطلة' : 'Mapping Off');

                    return `
                        <tr class="hover:bg-[var(--bg-hover)]/35 transition-colors">
                            <td class="p-3.5 align-top">
                                <div class="font-mono font-black text-[var(--text-primary)]">${safeDongleName}</div>
                                <div class="mt-1.5">${stateBadge}</div>
                                <div class="mt-1.5 text-[10px] text-[var(--text-muted)]">${safeProvider} · ${safeRssi} dBm</div>
                            </td>
                            <td class="p-3.5 align-top">
                                <div class="space-y-2">
                                    <div>${configuredDidDisplay}</div>
                                    <div class="pt-2 border-t border-[var(--border-primary)]">
                                        <span class="text-[9px] uppercase tracking-wider text-[var(--text-muted)] block mb-0.5">SIM</span>
                                        ${simReportDisplay}
                                    </div>
                                </div>
                            </td>
                            <td class="p-3.5 align-top font-mono text-[10px]">
                                <div class="space-y-2">
                                    <div><span class="text-[var(--text-muted)] block">IMSI</span><span class="text-[var(--text-secondary)] whitespace-nowrap">${safeImsi}</span></div>
                                    <div><span class="text-[var(--text-muted)] block">IMEI</span><span class="text-[var(--text-secondary)] whitespace-nowrap">${safeImei}</span></div>
                                </div>
                            </td>
                            <td class="p-3.5 align-top">
                                <div class="space-y-2">
                                    <div>${astdbBadge}</div>
                                    <div>${routeBadge}</div>
                                </div>
                            </td>
                            <td class="p-3.5 align-top text-right">
                                <div class="inline-flex flex-col items-stretch gap-1.5">
                                    <button type="button" onclick="toggleSingleDongleDynamic('${m.dongleName}', ${perDongleEnabled})" class="${perDongleBtnClass}">
                                        ${perDongleBtnText}
                                    </button>
                                    <button type="button" onclick="editDongleTabDid('${m.dongleName}', '${m.imsi || ''}', '${m.phoneNumber || ''}')" class="config-action-btn config-action-btn--compact">
                                        ${isRtl ? 'تعديل DID' : 'Edit DID'}
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (err) {
                console.error('fetchDongleMappingsTab error:', err);
            }
        }
        window.fetchDongleMappingsTab = fetchDongleMappingsTab;


        async function toggleSingleDongleDynamic(dongleName, currentState) {
            try {
                const targetState = !currentState;
                const res = await fetch(`/api/config/dongle-mappings/${encodeURIComponent(dongleName)}/toggle`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: targetState })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to update dongle setting', 'error');
                }
            } catch(err) {
                showToast('Network error: ' + err.message, 'error');
            }
        }
        window.toggleSingleDongleDynamic = toggleSingleDongleDynamic;

        async function editDongleTabDid(dongleId, imsi, currentVal) {
            const isRtl = document.documentElement.dir === 'rtl';
            const newNum = prompt(isRtl ? `أدخل رقم DID المعرف لـ ${dongleId}:` : `Enter configured DID for ${dongleId}:`, currentVal);
            if (newNum === null) return;
            const trimmed = newNum.trim();
            if (!trimmed) return;

            showToast(isRtl ? 'جاري حفظ رقم DID...' : 'Saving DID mapping...', 'info');

            try {
                const res = await fetch('/api/gsm-dongles/save-number', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongleId, imsi, number: trimmed })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ رقم DID ومطابقة AstDB بنجاح' : 'DID saved & AstDB reconciled successfully!', 'success');
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to save DID', 'error');
                }
            } catch (e) {
                showToast(e.message || 'Connection error', 'error');
            }
        }
        window.editDongleTabDid = editDongleTabDid;

        async function reconcileDonglesNow() {
            const isRtl = document.documentElement.dir === 'rtl';
            showToast(isRtl ? 'جاري إعادة مطابقة AstDB...' : 'Reconciling AstDB dongle mappings...', 'info');
            try {
                const res = await fetch('/api/gsm-dongles/redetect', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تمت إعادة مطابقة AstDB بنجاح' : 'AstDB mappings reconciled successfully!', 'success');
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Reconciliation failed', 'error');
                }
            } catch (e) {
                showToast(e.message || 'Network error', 'error');
            }
        }
        window.reconcileDonglesNow = reconcileDonglesNow;

        function ensureAllConfigListsLoaded() {
            return Promise.allSettled([
                fetchExtensions(),
                fetchRingGroups(),
                fetchQueues(),
                fetchIvrs(),
                fetchAnnouncements(),
                fetchTimeConditions(),
                fetchRecordings(),
                fetchMohData()
            ]).then(() => {
                if (typeof enhanceSelectElements === 'function') setTimeout(enhanceSelectElements, 50);
            });
        }
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            const bgClass = type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-red-600' : type === 'warning' ? 'bg-amber-600' : 'bg-slate-800';
            toast.className = `${bgClass} text-white text-xs font-bold px-4 py-3 rounded-lg shadow-xl flex items-center gap-2 border border-white/20 transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);
            setTimeout(() => {
                toast.classList.add('opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        function switchTab(tabId) {
            document.querySelectorAll('.tab-section').forEach(el => el.classList.add('hidden'));
            document.querySelectorAll('.config-tab-btn').forEach(btn => {
                btn.classList.remove('config-tab-active');
                btn.classList.add('config-tab-inactive');
            });
            const sec = document.getElementById('section-' + tabId);
            if (sec) sec.classList.remove('hidden');
            const btn = document.getElementById('tab-btn-' + tabId);
            if (btn) {
                btn.classList.remove('config-tab-inactive');
                btn.classList.add('config-tab-active');
            }
            stopRtcpTimer();
            if (tabId === 'extensions') fetchExtensions();
            if (tabId === 'ringgroups') { fetchRecordings(); fetchRingGroups(); fetchExtensions(); fetchQueues(); fetchIvrs(); fetchTimeConditions(); fetchAnnouncements(); }
            if (tabId === 'queues') { fetchRecordings(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchAnnouncements(); }
            if (tabId === 'ivr') { fetchRecordings(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchAnnouncements(); }
            if (tabId === 'recordings') fetchRecordings();
            if (tabId === 'trunks') fetchTrunks();
            if (tabId === 'outbound') { fetchOutboundRoutes(); fetchTrunks(); }
            if (tabId === 'timegroups') fetchTimeGroups();
            if (tabId === 'timeconditions') { fetchTimeConditions(); fetchTimeGroups(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchAnnouncements(); }
            if (tabId === 'announcements') { fetchAnnouncements(); fetchRecordings(); fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchTimeConditions(); }
            if (tabId === 'voicemail') fetchVoicemailExtensions();
            if (tabId === 'modem') fetchModemConfig();
            if (tabId === 'terminal') initTtyTerminal();
            if (tabId === 'diagram') fetchDiagramData();
            if (tabId === 'inbound') { fetchExtensions(); fetchRingGroups(); fetchQueues(); fetchIvrs(); fetchTimeConditions(); fetchAnnouncements(); fetchInboundRoutes(); fetchDongleMappingsTab(); }
            if (tabId === 'dongles') { switchTab('inbound'); return; }
            if (typeof enhanceSelectElements === 'function') setTimeout(enhanceSelectElements, 100);
        }
        window.switchTab = switchTab;

        function openModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.remove('hidden');
            if (typeof enhanceSelectElements === 'function') setTimeout(enhanceSelectElements, 50);
        }
        window.openModal = openModal;

        function closeModal(id) {
            const modal = document.getElementById(id);
            if (modal) modal.classList.add('hidden');
        }
        window.closeModal = closeModal;

        // --- RELOAD PBX CONFIG ---
        function reloadPbxConfig() {
            const btn = document.getElementById('reloadPbxBtn');
            const icon = document.getElementById('reloadIcon');
            const btnText = document.getElementById('reloadBtnText');
            
            btn.disabled = true;
            icon.classList.add('animate-spin');
            btnText.textContent = isRtl ? 'جاري تطبيق التغييرات...' : 'Applying PBX Config...';

            fetch('/api/config/reload', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? 'تم تطبيق إعدادات المقسم بنجاح!' : 'PBX Configuration applied successfully!', 'success');
                    } else {
                        showToast(isRtl ? 'فشل تطبيق الإعدادات: ' + (data.error || '') : 'PBX Reload Failed: ' + (data.error || ''), 'error');
                    }
                })
                .catch(err => showToast('Network Error: ' + err.message, 'error'))
                .finally(() => {
                    btn.disabled = false;
                    icon.classList.remove('animate-spin');
                    btnText.textContent = isRtl ? 'تطبيق تغييرات المقسم (Apply PBX Changes)' : 'Apply PBX Configuration';
                });
        }

        // --- 1. EXTENSIONS ---
        function fetchExtensions() {
            const tbody = document.getElementById('extensions-table-body');
            return fetch('/api/config/extensions')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !Array.isArray(data.extensions)) {
                    }
                    loadedExtensionsList = data.extensions;
                    renderQuickPickPills();
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (data.extensions.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد تحويلات.' : 'No extensions found.') + '</td></tr>';
                        return;
                    }
                    data.extensions.forEach(ext => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const isVmOn = (ext.voicemail === 'default' || ext.voicemail === 'enabled');
                        const vmBadge = isVmOn
                            ? `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">Enabled</span>`
                            : `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-slate-500/15 text-slate-400 border border-slate-500/20">Disabled</span>`;
                        const profileInitial = escapeHtml(String(ext.name || ext.extension || '?').trim().charAt(0).toUpperCase());
                        const profilePhoto = ext.photo
                            ? `<img src="${escapeHtml(ext.photo)}" alt="" class="w-9 h-9 rounded-lg object-cover border border-[var(--border-primary)] shrink-0" onerror="this.remove()">`
                            : `<span class="w-9 h-9 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] flex items-center justify-center text-xs font-black text-[var(--text-secondary)] shrink-0">${profileInitial}</span>`;
                        const titleText = ext.title
                            ? `<span class="text-xs font-bold text-[var(--text-primary)] truncate">${escapeHtml(ext.title)}</span>`
                            : `<span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'بدون مسمى وظيفي' : 'No job title'}</span>`;
                        const groupText = ext.emp_group
                            ? `<span class="text-[10px] font-bold text-red-400 truncate">${escapeHtml(ext.emp_group)}</span>`
                            : `<span class="text-[10px] text-[var(--text-muted)]">${isRtl ? 'بدون مجموعة' : 'No group'}</span>`;
                        const isWebRtcExt = (ext.tech === 'pjsip' || ext.tech === 'webrtc');
                        const techBadge = isWebRtcExt
                            ? `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-purple-500/15 text-purple-300 border border-purple-500/30 flex items-center gap-1 w-fit"><svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>WebRTC Softphone</span>`
                            : `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-slate-500/15 text-slate-300">Generic SIP Device</span>`;

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${escapeHtml(ext.extension)}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ext.name || '-')}</td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-2 min-w-[12rem]">
                                    ${profilePhoto}
                                    <div class="min-w-0 flex flex-col">${titleText}${groupText}</div>
                                </div>
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(ext.secret || '-')}</td>
                            <td class="py-3 px-4">${techBadge}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">Yes</span></td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded bg-purple-500/15 text-purple-400 border border-purple-500/20">Always</span></td>
                            <td class="py-3 px-4">${vmBadge}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" data-action="edit" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30">Edit</button>
                                    <button type="button" data-action="delete" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30">Delete</button>
                                </div>
                            </td>
                        `;
                        tr.querySelector('[data-action="edit"]').addEventListener('click', () => {
                            editExtension(ext.extension, ext.name, ext.secret, ext.voicemail, ext.tech);
                        });
                        tr.querySelector('[data-action="delete"]').addEventListener('click', () => {
                            deleteExtension(ext.extension);
                        });
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => {

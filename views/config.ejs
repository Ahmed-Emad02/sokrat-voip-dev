        async function saveRecordingStudioDsp() {
            const id = document.getElementById('dspRecId').value;
            if (!id) return;
            const applyBtn = document.getElementById('dspApplyBtn');
            const isRtl = '<%= isRtl %>' === 'true';

            const payload = {
                normDb: document.getElementById('dspNormDb').value !== '' ? parseInt(document.getElementById('dspNormDb').value, 10) : null,
                gainDb: parseInt(document.getElementById('dspGainDb').value, 10) || 0,
                compand: document.getElementById('dspCompand').value,
                fadeIn: parseFloat(document.getElementById('dspFadeIn').value) || 0,
                fadeOut: parseFloat(document.getElementById('dspFadeOut').value) || 0,
                bandpass: document.getElementById('dspBandpass').checked,
                hissFilter: document.getElementById('dspHissFilter').checked,
                bass: parseInt(document.getElementById('dspBass').value, 10) || 0,
                treble: parseInt(document.getElementById('dspTreble').value, 10) || 0,
                trimSilence: document.getElementById('dspTrimSilence').checked,
                tempo: parseFloat(document.getElementById('dspTempo').value) || 1.0,
                padLead: parseFloat(document.getElementById('dspPadLead').value) || 0,
                padTrail: parseFloat(document.getElementById('dspPadTrail').value) || 0,
                generateCodecs: document.getElementById('dspGenerateCodecs').checked
            };

            applyBtn.disabled = true;
            applyBtn.innerHTML = `<span class="inline-block animate-spin">⏳</span> <span>${isRtl ? 'جاري معالجة الصوت...' : 'Processing audio...'}</span>`;

            try {
                const res = await fetch(`/api/config/recordings/${id}/dsp`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || (isRtl ? 'تم تطبيق ومعالجة الصوت بنجاح' : 'Audio effects applied successfully!'), 'success');
                    if (data.stat) {
                        document.getElementById('dspStatDuration').textContent = data.stat.length ? data.stat.length + 's' : '-';
                        document.getElementById('dspStatPeak').textContent = data.stat.maxAmplitude ? data.stat.maxAmplitude : '-';
                        document.getElementById('dspStatRms').textContent = data.stat.rmsAmplitude ? data.stat.rmsAmplitude : '-';
                    }
                    if (studioPreviewAudio) {
                        studioPreviewAudio.pause();
                        studioPreviewAudio = null;
                    }
                    fetchRecordings();
                } else {
                    showToast(data.error || 'Failed to process DSP audio', 'error');
                }
            } catch (err) {
                showToast(err.message || 'Error processing audio', 'error');
            } finally {
                applyBtn.disabled = false;
                applyBtn.innerHTML = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>${isRtl ? 'تطبيق وحفظ المؤثرات' : 'Apply & Save Audio DSP'}</span>`;
            }
        }

        async function resetRecordingStudioMaster() {
            const id = document.getElementById('dspRecId').value;
            if (!id) return;
            const isRtl = '<%= isRtl %>' === 'true';
            if (!confirm(isRtl ? 'هل أنت متأكد من استعادة الملف الأصلي الخام وإلغاء جميع الفلاتر والمؤثرات؟' : 'Revert audio to untouched original master and clear all DSP effects?')) return;

            try {
                const res = await fetch(`/api/config/recordings/${id}/dsp`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ resetToOriginal: true })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تمت استعادة الملف الأصلي بنجاح' : 'Reverted to original master audio', 'success');
                    if (studioPreviewAudio) {
                        studioPreviewAudio.pause();
                        studioPreviewAudio = null;
                    }
                    openRecordingStudioModal(id);
                    fetchRecordings();
                } else {
                    showToast(data.error || 'Failed to reset recording', 'error');
                }
            } catch (err) {
                showToast(err.message || 'Error resetting recording', 'error');
            }
        }

        window.openRecordingStudioModal = openRecordingStudioModal;
        window.toggleStudioAudioPreview = toggleStudioAudioPreview;
        window.applyDspPreset = applyDspPreset;
        window.saveRecordingStudioDsp = saveRecordingStudioDsp;
        window.resetRecordingStudioMaster = resetRecordingStudioMaster;
        // --- IVR MENUS ---
        let ivrEntryCounter = 0;

        function fetchIvrs() {
            const tbody = document.getElementById('ivrs-table-body');
            return fetch('/api/config/ivrs')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    loadedIvrsList = Array.isArray(data.ivrs) ? data.ivrs : [];
                    const list = loadedIvrsList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد قوائم رد آلي.' : 'No IVR menus found.') + '</td></tr>';
                        return;
                    }
                    list.forEach((ivr) => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const recMatch = (loadedRecordingsList || []).find(r => r.id == ivr.announcement);
                        const recName = recMatch ? escapeHtml(recMatch.displayname || recMatch.filename) : (ivr.announcement ? `Recording #${ivr.announcement}` : 'None');
                        const optionsCount = (ivr.entries || []).length;
                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono text-xs font-bold text-amber-400">#${ivr.id}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ivr.name || '')}</td>
                            <td class="py-3 px-4 text-xs text-[var(--text-secondary)]">${escapeHtml(ivr.description || '-')}</td>
                            <td class="py-3 px-4 text-xs text-purple-400 font-mono">${recName}</td>
                            <td class="py-3 px-4 text-xs font-mono">${ivr.directdial === 'disabled' ? '<span class="text-rose-400">Disabled</span>' : '<span class="text-emerald-400">Extensions</span>'}</td>
                            <td class="py-3 px-4 text-xs font-mono text-cyan-400 font-bold">${optionsCount} ${optionsCount === 1 ? 'option' : 'options'}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="openIvrModal(${ivr.id})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteIvr(${ivr.id})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function populateIvrAnnouncementSelect(selectedId) {
            const sel = document.getElementById('ivrAnnouncement');
            if (!sel) return;
            sel.innerHTML = '<option value="0">== None / Default ==</option>';
            (loadedRecordingsList || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = `${r.displayname || r.filename} (#${r.id})`;
                if (r.id == selectedId) opt.selected = true;
                sel.appendChild(opt);
            });
        }

        function populateIvrTargetSelect(selectEl, type, currentDest) {
            if (!selectEl) return;
            selectEl.innerHTML = '<option value="">== ' + (isRtl ? 'اختر الهدف Target' : 'choose target') + ' ==</option>';
            if (type === 'extensions') {
                (loadedExtensionsList || []).forEach(e => {
                    const opt = document.createElement('option');
                    opt.value = `from-did-direct,${e.extension},1`;
                    opt.textContent = `${e.extension} - ${e.name}`;
                    if (currentDest === opt.value || currentDest === `ext-local,${e.extension},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'ringgroups') {
                (loadedRingGroupsList || []).forEach(rg => {
                    const opt = document.createElement('option');
                    opt.value = `ext-group,${rg.grpnum},1`;
                    opt.textContent = `Group ${rg.grpnum} - ${rg.description}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'queues') {
                (loadedQueuesList || []).forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = `ext-queues,${q.extension},1`;
                    opt.textContent = `Queue ${q.extension} - ${q.descr}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'ivr') {
                (loadedIvrsList || []).forEach(i => {
                    const opt = document.createElement('option');
                    opt.value = `ivr-${i.id},s,1`;
                    opt.textContent = `IVR #${i.id} - ${i.name}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'voicemail') {
                (loadedExtensionsList || []).forEach(e => {
                    const opt = document.createElement('option');
                    opt.value = `ext-local,vmu${e.extension},1`;
                    opt.textContent = `VM: ${e.extension} - ${e.name}`;
                    if (currentDest === opt.value || currentDest === `ext-withvm,${e.extension},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'announcements') {
                (loadedAnnouncementsList || []).forEach(a => {
                    const opt = document.createElement('option');
                    opt.value = `app-announcement-${a.announcement_id},s,1`;
                    opt.textContent = `Announcement: ${a.description}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'timeconditions') {
                (loadedTimeConditionsList || []).forEach(tc => {
                    const opt = document.createElement('option');
                    opt.value = `timeconditions,${tc.timeconditions_id},1`;
                    opt.textContent = `Time Condition: ${tc.displayname}`;
                    if (currentDest === opt.value || currentDest === `ext-timeconditions,${tc.timeconditions_id},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'musiconhold') {
                const mohList = typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : [];
                if (mohList.length === 0) {
                    const optDef = document.createElement('option');
                    optDef.value = 'musiconhold,default,1';
                    optDef.textContent = 'Default MoH Class';
                    if (currentDest === optDef.value || currentDest === 'app-blackhole,musiconhold,1') optDef.selected = true;
                    selectEl.appendChild(optDef);
                } else {
                    mohList.forEach(cat => {
                        const opt = document.createElement('option');
                        opt.value = `musiconhold,${cat.name},1`;
                        opt.textContent = `MoH: ${cat.name} (${cat.fileCount || 0} tracks)${cat.isDefault ? ' [System]' : ''}`;
                        if (currentDest === opt.value) opt.selected = true;
                        selectEl.appendChild(opt);
                    });
                }
                const optHold = document.createElement('option');
                optHold.value = 'app-blackhole,musiconhold,1';
                optHold.textContent = isRtl ? 'وضع المتصل في الانتظار الدائم (Hold Forever)' : 'Hold Forever (Blackhole MoH)';
                if (currentDest === optHold.value) optHold.selected = true;
                selectEl.appendChild(optHold);
            } else if (type === 'terminate') {
                const opt = document.createElement('option');
                opt.value = 'app-blackhole,hangup,1';
                opt.textContent = isRtl ? 'إنهاء المكالمة (Hangup)' : 'Terminate Call (Hangup)';
                opt.selected = true;
                selectEl.appendChild(opt);
            }
        }

        function addIvrEntryRow(selection = '1', dest = '') {
            const container = document.getElementById('ivrEntriesContainer');
            if (!container) return;
            const rowId = 'ivr-entry-row-' + (++ivrEntryCounter);
            
            const div = document.createElement('div');
            div.id = rowId;
            div.className = 'grid grid-cols-1 sm:grid-cols-12 gap-2 items-center bg-[var(--bg-secondary)] p-2.5 border border-[var(--border-primary)] rounded-lg text-xs';
            
            const digits = ['1','2','3','4','5','6','7','8','9','0','*','#','t','i'];
            const optionHtml = digits.map(d => `<option value="${d}" ${d === String(selection) ? 'selected' : ''}>Press ${d}</option>`).join('');

            div.innerHTML = `
                <div class="sm:col-span-3">
                    <span class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-0.5">Digit Key</span>
                    <select name="ivr_entry_key[]" id="ivr_key_${rowId}" aria-label="Digit Key" class="ivr-entry-selection config-input w-full py-1 text-xs font-bold text-cyan-400">
                        ${optionHtml}
                    </select>
                </div>
                <div class="sm:col-span-4">
                    <span class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-0.5">Destination Type</span>
                    <select name="ivr_entry_type[]" id="ivr_type_${rowId}" aria-label="Destination Type" onchange="onIvrEntryTypeChange('${rowId}')" class="ivr-entry-type config-input w-full py-1 text-xs">
                        <option value="extensions">Extensions</option>
                        <option value="ringgroups">Ring Groups</option>
                        <option value="queues">Queues</option>
                        <option value="ivr">IVR Menu</option>
                        <option value="voicemail">Voicemail</option>
                        <option value="announcements">Announcements</option>
                        <option value="timeconditions">Time Conditions</option>
                        <option value="musiconhold">Music on Hold (MoH)</option>
                        <option value="terminate">Terminate Call (Hangup)</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>
                <div class="sm:col-span-4">
                    <span class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-0.5">Target</span>
                    <select name="ivr_entry_target[]" id="ivr_target_${rowId}" aria-label="Target" onchange="updateIvrEntryDestValue('${rowId}')" class="ivr-entry-target-select config-input w-full py-1 text-xs font-medium">
                        <option value="">== choose target ==</option>
                    </select>
                    <input type="text" name="ivr_entry_custom[]" id="ivr_custom_${rowId}" aria-label="Custom Target" oninput="updateIvrEntryDestValue('${rowId}')" placeholder="e.g. custom,s,1" class="ivr-entry-target-input config-input w-full py-1 text-xs font-mono hidden">
                    <input type="hidden" name="ivr_entry_dest[]" id="ivr_dest_${rowId}" class="ivr-entry-dest-hidden" value="${escapeHtml(dest)}">
                </div>
                <div class="sm:col-span-1 flex justify-end pt-3 sm:pt-0">
                    <button type="button" onclick="document.getElementById('${rowId}').remove()" class="text-rose-400 hover:text-rose-300 font-bold text-sm px-1.5 py-0.5 hover:bg-rose-500/10 rounded cursor-pointer" aria-label="Remove Entry">✕</button>
                </div>
            `;
            
            container.appendChild(div);

            const typeSelect = div.querySelector('.ivr-entry-type');
            if (dest.startsWith('ext-local,vmu')) {
                typeSelect.value = 'voicemail';
            } else if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                typeSelect.value = 'extensions';
            } else if (dest.startsWith('ext-group,')) {
                typeSelect.value = 'ringgroups';
            } else if (dest.startsWith('ext-queues,')) {
                typeSelect.value = 'queues';
            } else if (dest.startsWith('ivr-')) {
                typeSelect.value = 'ivr';
            } else if (dest.startsWith('app-announcement-')) {
                typeSelect.value = 'announcements';
            } else if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                typeSelect.value = 'timeconditions';
            } else if (dest.startsWith('musiconhold,') || dest.startsWith('ext-moh,') || dest === 'app-blackhole,musiconhold,1') {
                typeSelect.value = 'musiconhold';
            } else if (dest === 'app-blackhole,hangup,1') {
                typeSelect.value = 'terminate';
            } else if (dest) {
                typeSelect.value = 'custom';
            }
            
            onIvrEntryTypeChange(rowId);
        }

        function onIvrEntryTypeChange(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const type = row.querySelector('.ivr-entry-type').value;
            const targetSelect = row.querySelector('.ivr-entry-target-select');
            const targetInput = row.querySelector('.ivr-entry-target-input');
            const hiddenDest = row.querySelector('.ivr-entry-dest-hidden');

            if (['extensions', 'ringgroups', 'queues', 'ivr', 'voicemail', 'announcements', 'timeconditions', 'musiconhold'].includes(type)) {
                targetInput.classList.add('hidden');
                populateIvrTargetSelect(targetSelect, type, hiddenDest.value);
            } else if (type === 'terminate') {
                targetSelect.classList.add('hidden');
                targetInput.classList.add('hidden');
                hiddenDest.value = 'app-blackhole,hangup,1';
            } else if (type === 'custom') {
                targetSelect.classList.add('hidden');
                targetInput.classList.remove('hidden');
                targetInput.value = hiddenDest.value;
            }
            updateIvrEntryDestValue(rowId);
        }

        function updateIvrEntryDestValue(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const type = row.querySelector('.ivr-entry-type').value;
            const targetSelect = row.querySelector('.ivr-entry-target-select');
            const targetInput = row.querySelector('.ivr-entry-target-input');
            const hiddenDest = row.querySelector('.ivr-entry-dest-hidden');

            if (['extensions', 'ringgroups', 'queues', 'ivr', 'voicemail', 'announcements', 'timeconditions', 'musiconhold'].includes(type)) {
            } else if (type === 'terminate') {
                hiddenDest.value = 'app-blackhole,hangup,1';
            } else if (type === 'custom') {
                hiddenDest.value = targetInput.value.trim();
            }
        }

        function setIvrTimeoutDest(destVal) {
            initDestinationSelectInstances();
            if (ivrTimeoutDestSelectInstance) ivrTimeoutDestSelectInstance.setDialplan(destVal || 'app-blackhole,hangup,1');
            const hidden = document.getElementById('ivrTimeoutDestination');
            if (hidden) hidden.value = destVal || 'app-blackhole,hangup,1';
        }

        function setIvrInvalidDest(destVal) {
            initDestinationSelectInstances();
            if (ivrInvalidDestSelectInstance) ivrInvalidDestSelectInstance.setDialplan(destVal || 'app-blackhole,hangup,1');
            const hidden = document.getElementById('ivrInvalidDestination');
            if (hidden) hidden.value = destVal || 'app-blackhole,hangup,1';
        }

        function openIvrModal(id = null) {
            openModal('ivrModal');
            const form = document.getElementById('ivrForm');
            const title = document.getElementById('ivrModalTitle');
            const editId = document.getElementById('ivrEditId');
            const container = document.getElementById('ivrEntriesContainer');

            if (form) form.reset();
            if (container) container.innerHTML = '';

            populateIvrAnnouncementSelect(0);
            if (id) {
                const ivr = (loadedIvrsList || []).find(i => i.id == id);
                if (ivr) {
                    title.textContent = isRtl ? `تعديل قائمة الرد الآلي #${ivr.id}` : `Edit IVR Menu #${ivr.id}`;
                    editId.value = ivr.id;
                    document.getElementById('ivrName').value = ivr.name || '';
                    document.getElementById('ivrDescription').value = ivr.description || '';
                    populateIvrAnnouncementSelect(ivr.announcement || 0);
                    document.getElementById('ivrDirectDial').value = ivr.directdial || 'disabled';

                    document.getElementById('ivrTimeoutTime').value = ivr.timeout_time || 10;
                    document.getElementById('ivrTimeoutLoops').value = ivr.timeout_loops || 3;
                    setIvrTimeoutDest(ivr.timeout_destination || 'app-blackhole,hangup,1');

                    document.getElementById('ivrInvalidLoops').value = ivr.invalid_loops || 3;
                    setIvrInvalidDest(ivr.invalid_destination || 'app-blackhole,hangup,1');

                    if (ivr.entries && ivr.entries.length) {
                        ivr.entries.forEach(e => addIvrEntryRow(e.selection, e.dest));
                    } else {
                        addIvrEntryRow('1', '');
                    }
                }
            } else {
                title.textContent = isRtl ? 'إضافة قائمة رد آلي جديدة' : 'Add IVR Menu';
                editId.value = '';
                document.getElementById('ivrTimeoutTime').value = 10;
                document.getElementById('ivrTimeoutLoops').value = 3;
                setIvrTimeoutDest('app-blackhole,hangup,1');
                document.getElementById('ivrInvalidLoops').value = 3;
                setIvrInvalidDest('app-blackhole,hangup,1');

                addIvrEntryRow('1', '');
                addIvrEntryRow('2', '');
            }

            if (typeof ensureAllConfigListsLoaded === 'function') {
                ensureAllConfigListsLoaded().then(() => {
                    if (id) {
                        const ivr = (loadedIvrsList || []).find(i => i.id == id);
                        if (ivr) {
                            populateIvrAnnouncementSelect(ivr.announcement || 0);
                            setIvrTimeoutDest(ivr.timeout_destination || 'app-blackhole,hangup,1');
                            setIvrInvalidDest(ivr.invalid_destination || 'app-blackhole,hangup,1');
                        }
                    } else {
                        populateIvrAnnouncementSelect(0);
                    }
                }).catch(() => {});
            }
        }
        function saveIvr(e) {
            e.preventDefault();
            const editId = document.getElementById('ivrEditId').value;
            const name = document.getElementById('ivrName').value.trim();
            const description = document.getElementById('ivrDescription').value.trim();
            const announcement = document.getElementById('ivrAnnouncement').value;
            const directdial = document.getElementById('ivrDirectDial').value;

            const timeout_time = document.getElementById('ivrTimeoutTime').value;
            const timeout_loops = document.getElementById('ivrTimeoutLoops').value;
            const timeout_destination = document.getElementById('ivrTimeoutDestination').value;

            const invalid_loops = document.getElementById('ivrInvalidLoops').value;
            const invalid_destination = document.getElementById('ivrInvalidDestination').value;

            const entries = [];
            document.querySelectorAll('#ivrEntriesContainer > div').forEach(row => {
                const sel = row.querySelector('.ivr-entry-selection').value;
                const dest = row.querySelector('.ivr-entry-dest-hidden').value;
                if (sel && dest) {
                    entries.push({ selection: sel, dest: dest });
                }
            });

            const body = {
                name, description, announcement, directdial,
                timeout_time, timeout_loops, timeout_destination,
                invalid_loops, invalid_destination,
                entries
            };

            const url = editId ? `/api/config/ivrs/${editId}` : '/api/config/ivrs';
            const method = editId ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message || 'IVR saved successfully', 'success');
                    closeModal('ivrModal');
                    fetchIvrs();
                } else {
                    showToast(data.error || 'Failed to save IVR', 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'));
        }

        function deleteIvr(id) {
            if (!confirm(isRtl ? `هل أنت متأكد من حذف قائمة الرد الآلي #${id}؟` : `Are you sure you want to delete IVR #${id}?`)) return;
            fetch(`/api/config/ivrs/${id}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message || 'IVR deleted successfully', 'success');
                        fetchIvrs();
                    } else {
                        showToast(data.error || 'Failed to delete IVR', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }
        window.openIvrModal = openIvrModal;
        window.editIvr = openIvrModal;
        window.saveIvr = saveIvr;
        window.deleteIvr = deleteIvr;
        window.fetchIvrs = fetchIvrs;
        window.addIvrEntryRow = addIvrEntryRow;
        window.onIvrEntryTypeChange = onIvrEntryTypeChange;
        window.updateIvrEntryDestValue = updateIvrEntryDestValue;
        window.populateIvrAnnouncementSelect = populateIvrAnnouncementSelect;
        window.populateIvrTargetSelect = populateIvrTargetSelect;
        window.setIvrTimeoutDest = setIvrTimeoutDest;
        window.setIvrInvalidDest = setIvrInvalidDest;

        // --- 4. TRUNKS ---
        function onTrunkTechChange() {
            const tech = document.getElementById('trunkTech').value;
            const customDiv = document.getElementById('trunkCustomFields');
            const sipIaxDiv = document.getElementById('trunkSipIaxFields');
            const cidSection = document.getElementById('trunkCidSection');
            const dialInput = document.getElementById('trunkDialString');
            const hostInput = document.getElementById('trunkHost');
            const channelIdInput = document.getElementById('trunkChannelId');

            if (tech === 'custom') {
                customDiv.classList.remove('hidden');
                sipIaxDiv.classList.add('hidden');
                if (cidSection) cidSection.classList.add('hidden');
                if (dialInput) dialInput.required = true;
                if (hostInput) hostInput.required = false;
                if (channelIdInput) channelIdInput.required = false;
            } else {
                customDiv.classList.add('hidden');
                sipIaxDiv.classList.remove('hidden');
                if (cidSection) cidSection.classList.remove('hidden');
                if (dialInput) dialInput.required = false;
                if (hostInput) hostInput.required = false;
                if (channelIdInput) channelIdInput.required = false;
            }
        }

        function fetchTrunks() {
            const tbody = document.getElementById('trunks-table-body');
            return fetch('/api/config/trunks')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.trunks) return;
                    loadedTrunksList = Array.isArray(data.trunks) ? data.trunks : [];
                    const list = loadedTrunksList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد خطوط ربط.' : 'No trunks found.') + '</td></tr>';
                        return;
                    }
                    list.forEach(t => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const techUpper = String(t.tech || 'custom').toUpperCase();
                        let techBadgeClass = 'bg-slate-500/15 text-slate-300 border-slate-500/20';
                        if (techUpper === 'SIP') techBadgeClass = 'bg-cyan-500/15 text-cyan-400 border-cyan-500/20';
                        else if (techUpper === 'IAX2' || techUpper === 'IAX') techBadgeClass = 'bg-purple-500/15 text-purple-400 border-purple-500/20';
                        else if (techUpper === 'CUSTOM') techBadgeClass = 'bg-amber-500/15 text-amber-400 border-amber-500/20';

                        const targetStr = (t.tech === 'custom' ? t.channelid : t.host) || '-';

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-muted)]">${escapeHtml(t.trunkid)}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)] font-mono">${escapeHtml(t.name)}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[10px] font-extrabold rounded border ${techBadgeClass}">${techUpper}</span></td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-semibold">${escapeHtml(targetStr)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editTrunkByIndex(${t.trunkid})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteTrunk(${t.trunkid})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function editTrunkByIndex(trunkid) {
            const t = (loadedTrunksList || []).find(x => String(x.trunkid) === String(trunkid));
            if (t) {
                editTrunk(t);
            } else {
                openTrunkModal();
            }
        }

        function renderTrunkDialRules(rules = []) {
            const container = document.getElementById('trunkDialRulesContainer');
            if (!container) return;
            container.innerHTML = '';
            const list = Array.isArray(rules) && rules.length ? rules : [{ prepend: '', prefix: '', pattern: '' }];
            list.forEach(r => addTrunkDialRuleRow(r.prepend || '', r.prefix || '', r.pattern || r.match_pattern || ''));
        }

        function addTrunkDialRuleRow(prepend = '', prefix = '', pattern = '') {
            const container = document.getElementById('trunkDialRulesContainer');
            if (!container) return;
            const row = document.createElement('div');
            row.className = 'trunk-dial-rule-row grid grid-cols-12 gap-2 items-center bg-black/20 p-2 rounded-lg border border-[var(--border-primary)]/40';
            row.innerHTML = `
                <div class="col-span-3">
                    <input type="text" name="trunk_prepend[]" aria-label="Prepend" placeholder="( ${isRtl ? 'إضافة' : 'prepend'} )" value="${escapeHtml(prepend)}" class="trunk-rule-prepend config-input w-full font-mono text-[11px] px-2 py-1">
                </div>
                <div class="col-span-1 text-center font-bold text-amber-400 text-xs">+</div>
                <div class="col-span-3">
                    <input type="text" name="trunk_prefix[]" aria-label="Prefix" placeholder="prefix" value="${escapeHtml(prefix)}" class="trunk-rule-prefix config-input w-full font-mono text-[11px] px-2 py-1">
                </div>
                <div class="col-span-1 text-center font-bold text-amber-400 text-xs">|</div>
                <div class="col-span-3">
                    <input type="text" name="trunk_pattern[]" aria-label="Match Pattern" placeholder="[ ${isRtl ? 'نمط المطابقة' : 'match pattern'} ]" value="${escapeHtml(pattern)}" class="trunk-rule-pattern config-input w-full font-mono text-[11px] px-2 py-1">
                </div>
                <div class="col-span-1 text-center">
                    <button type="button" onclick="this.closest('.trunk-dial-rule-row').remove()" class="text-red-400 hover:text-red-300 text-xs font-bold p-1 cursor-pointer" title="${isRtl ? 'حذف' : 'Remove'}" aria-label="Remove Rule">✕</button>
                </div>
            `;
            container.appendChild(row);
        }

        function getTrunkDialRulesFromForm() {
            const rows = document.querySelectorAll('.trunk-dial-rule-row');
            const rules = [];
            rows.forEach(row => {
                const prepend = (row.querySelector('.trunk-rule-prepend')?.value || '').trim();
                const prefix = (row.querySelector('.trunk-rule-prefix')?.value || '').trim();
                const pattern = (row.querySelector('.trunk-rule-pattern')?.value || '').trim();
                if (prepend || prefix || pattern) {
                    rules.push({ prepend, prefix, pattern });
                }
            });
            return rules;
        }
        function openTrunkModal() {
            openModal('trunkModal');
            document.getElementById('trunkModalTitle').textContent = isRtl ? 'إضافة خط ربط جديد' : 'Add Trunk';
            document.getElementById('trunkEditId').value = "";
            document.getElementById('trunkForm').reset();
            document.getElementById('trunkTech').value = "custom";
            document.getElementById('trunkContext').value = "from-trunk";
            document.getElementById('trunkKeepCid').value = "off";
            document.getElementById('trunkMaxChans').value = "";
            document.getElementById('trunkDialPrefix').value = "";
            document.getElementById('trunkDisabled').value = "off";
            document.getElementById('trunkDialOpts').value = "";
            document.getElementById('trunkContinue').value = "off";
            document.getElementById('trunkFailScript').value = "";
            renderTrunkDialRules([]);
            onTrunkTechChange();
        }

        function editTrunk(t) {
            openModal('trunkModal');
            document.getElementById('trunkModalTitle').textContent = (isRtl ? 'تعديل خط الربط ' : 'Edit Trunk ') + (t.name || '');
            document.getElementById('trunkEditId').value = t.trunkid;
            document.getElementById('trunkName').value = t.name || '';
            document.getElementById('trunkTech').value = t.tech || 'custom';
            document.getElementById('trunkDialString').value = (t.tech || 'custom') === 'custom' ? (t.channelid || '') : '';
            document.getElementById('trunkChannelId').value = (t.tech || 'custom') === 'custom' ? '' : (t.channelid || t.name || '');
            document.getElementById('trunkHost').value = t.host || '';
            document.getElementById('trunkUsername').value = t.username || '';
            document.getElementById('trunkSecret').value = t.secret || '';
            document.getElementById('trunkContext').value = t.context || 'from-trunk';
            document.getElementById('trunkRegister').value = t.register || '';
            document.getElementById('trunkOutcid').value = t.outcid || '';
            document.getElementById('trunkKeepCid').value = t.keepcid || 'off';
            document.getElementById('trunkMaxChans').value = t.maxchans || '';
            document.getElementById('trunkDialPrefix').value = t.dialoutprefix || '';
            document.getElementById('trunkDisabled').value = t.disabled || 'off';
            document.getElementById('trunkDialOpts').value = t.dialopts || '';
            document.getElementById('trunkContinue').value = t.continue || 'off';
            document.getElementById('trunkFailScript').value = t.failscript || '';
            document.getElementById('trunkUserContext').value = t.usercontext || '';
            document.getElementById('trunkPeerDetails').value = t.peerdetails || '';
            document.getElementById('trunkUserDetails').value = t.userdetails || '';
            renderTrunkDialRules(t.dialpatterns || t.dialrules || []);
            onTrunkTechChange();
        }


        function saveTrunk(e) {
            e.preventDefault();
            const editId = document.getElementById('trunkEditId').value;
            const name = document.getElementById('trunkName').value.trim();
            const tech = document.getElementById('trunkTech').value;
            let channelid = tech === 'custom'
                ? document.getElementById('trunkDialString').value.trim()
                : document.getElementById('trunkChannelId').value.trim();
            if (!channelid && tech !== 'custom') {
                channelid = name;
            }

            let host = document.getElementById('trunkHost').value.trim();
            let username = document.getElementById('trunkUsername').value.trim();
            let secret = document.getElementById('trunkSecret').value.trim();
            let context = document.getElementById('trunkContext').value.trim() || 'from-trunk';
            const register = document.getElementById('trunkRegister').value.trim();
            const outcid = document.getElementById('trunkOutcid').value.trim();
            const keepcid = document.getElementById('trunkKeepCid').value;
            const maxchans = document.getElementById('trunkMaxChans').value.trim();
            const dialoutprefix = document.getElementById('trunkDialPrefix').value.trim();
            const disabled = document.getElementById('trunkDisabled').value;
            const dialopts = document.getElementById('trunkDialOpts').value.trim();
            const continueVal = document.getElementById('trunkContinue').value;
            const failscript = document.getElementById('trunkFailScript').value.trim();
            const usercontext = document.getElementById('trunkUserContext').value.trim();
            const peerdetails = document.getElementById('trunkPeerDetails').value.trim();
            const userdetails = document.getElementById('trunkUserDetails').value.trim();

            if (!host && peerdetails) {
                const m = peerdetails.match(/^host\s*=\s*(.+)$/im);
                if (m) host = m[1].trim();
            }
            if (!username && peerdetails) {
                const m = peerdetails.match(/^username\s*=\s*(.+)$/im);
                if (m) username = m[1].trim();
            }
            if (!secret && peerdetails) {
                const m = peerdetails.match(/^secret\s*=\s*(.+)$/im);
                if (m) secret = m[1].trim();
            }
            if (!context && peerdetails) {
                const m = peerdetails.match(/^context\s*=\s*(.+)$/im);
                if (m) context = m[1].trim();
            }

            const dialrules = getTrunkDialRulesFromForm();
            if (tech === 'custom' && channelid && Array.isArray(loadedTrunksList)) {
                const existingTrunk = (loadedTrunksList || []).find(t => String(t.trunkid) !== String(editId) && String(t.tech || '').toLowerCase() === 'custom' && String(t.channelid || '').trim() === channelid);
                if (existingTrunk) {
                    showToast(isRtl ? ("تحذير: نص طلب الاتصال المخصص " + channelid + " مستخدم بالفعل في خط الربط " + (existingTrunk.name || existingTrunk.trunkid)) : ("Warning: Custom dial string " + channelid + " already exists in another trunk (" + (existingTrunk.name || existingTrunk.trunkid) + ")"), "warning");
                }
            }

            const url = editId ? '/api/config/trunks/' + editId : '/api/config/trunks';
            const method = editId ? 'PUT' : 'POST';

            fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, tech, channelid, host, username, secret, context, register, outcid, keepcid, maxchans, dialoutprefix, disabled, dialopts, continue: continueVal, failscript, usercontext, peerdetails, userdetails, dialrules })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.warningMessage) {
                        showToast(data.warningMessage, 'warning');
                    } else if (data.applied === false) {
                        showToast((data.message || 'Trunk saved') + ' (PBX Apply Warning: ' + (data.reloadError || '') + ')', 'warning');
                    } else {
                        showToast(data.message, 'success');
                    }
                    closeModal('trunkModal');
                    fetchTrunks();
                } else showToast(data.error, 'error');
            });
        }
        function deleteTrunk(trunkid) {
            if (!confirm(isRtl ? `حذف خط الربط ${trunkid}؟` : `Delete trunk ID ${trunkid}?`)) return;
            fetch('/api/config/trunks/' + trunkid, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        if (data.applied === false) {
                            showToast((data.message || 'Trunk deleted') + ' (PBX Apply Warning: ' + (data.reloadError || '') + ')', 'warning');
                        } else {
                            showToast(data.message, 'success');
                        }
                        fetchTrunks();
                    } else showToast(data.error, 'error');
                });
        }
        window.fetchTrunks = fetchTrunks;
        window.editTrunkByIndex = editTrunkByIndex;
        window.editTrunk = editTrunk;
        window.deleteTrunk = deleteTrunk;
        window.saveTrunk = saveTrunk;
        window.openTrunkModal = openTrunkModal;
        window.onTrunkTechChange = onTrunkTechChange;
        window.renderTrunkDialRules = renderTrunkDialRules;
        window.addTrunkDialRuleRow = addTrunkDialRuleRow;
        window.getTrunkDialRulesFromForm = getTrunkDialRulesFromForm;

        // --- 5. INBOUND ROUTES ---
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatDestination(dest) {
            if (!dest) return '-';
            
            if (dest.startsWith('from-did-direct,')) {
                const parts = dest.split(',');
                const extNum = parts[1];
                const extMatch = (typeof loadedExtensionsList !== 'undefined' ? loadedExtensionsList : []).find(e => String(e.extension) === String(extNum));
                const nameStr = extMatch ? ` - ${extMatch.name}` : '';
                return `Extension: ${extNum}${nameStr}`;
            }
            
            if (dest.startsWith('ext-group,')) {
                const parts = dest.split(',');
                const grpNum = parts[1];
                const rgMatch = (typeof loadedRingGroupsList !== 'undefined' ? loadedRingGroupsList : []).find(rg => String(rg.grpnum) === String(grpNum));
                const descStr = rgMatch ? ` - ${rgMatch.description}` : '';
                return `Ring Group: ${grpNum}${descStr}`;
            }
            
            if (dest.startsWith('ext-queues,')) {
                const parts = dest.split(',');
                const qNum = parts[1];
                const qMatch = (typeof loadedQueuesList !== 'undefined' ? loadedQueuesList : []).find(q => String(q.extension) === String(qNum));
                const descStr = qMatch ? ` - ${qMatch.descr}` : '';
                return `Queue: ${qNum}${descStr}`;
            }

            if (dest.startsWith('ext-external-failover,') || dest.startsWith('from-internal,')) {
                const rawTarget = dest.split(',')[1] || '';
                const phone = rawTarget.split('/')[0].split('@')[0];
                const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                if (phone) {
                    const dongleLabel = dongle ? ` (${dongle})` : '';
                    return `${isRtl ? 'رقم خارجي / جوال:' : 'External / Mobile:'} ${phone}${dongleLabel}`;
                }
            }
            if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                const parts = dest.split(',');
                const conditionId = parts[1];
                const condition = (typeof loadedTimeConditionsList !== 'undefined' ? loadedTimeConditionsList : []).find(tc => String(tc.timeconditions_id) === String(conditionId));
                const name = condition ? condition.displayname : conditionId;
                return `${isRtl ? 'شرط زمني' : 'Time Condition'}: ${name}`;
            }

            if (dest.startsWith('app-announcement-')) {
                const parts = dest.split(',');
                const annId = parts[0].replace('app-announcement-', '');
                const ann = (typeof loadedAnnouncementsList !== 'undefined' ? loadedAnnouncementsList : []).find(a => String(a.announcement_id) === String(annId));
                const name = ann ? ann.description : annId;
                return `${isRtl ? 'إعلان' : 'Announcement'}: ${name}`;
            }

            if (dest.startsWith('ivr-')) {
                const parts = dest.split(',');
                const ivrId = parts[0].replace('ivr-', '');
                const ivr = (typeof loadedIvrsList !== 'undefined' ? loadedIvrsList : []).find(i => String(i.id) === String(ivrId));
                const name = ivr ? ivr.name : ivrId;
                return `IVR: ${name}`;
            }

            if (dest.startsWith('ext-local,vmu')) {
                const ext = dest.substring(13).split(',')[0];
                return `Voicemail: ${ext}`;
            }

            if (dest.startsWith('musiconhold,') || dest.startsWith('ext-moh,')) {
                const parts = dest.split(',');
                const catName = parts[1] || 'default';
                return `Music on Hold: ${catName}`;
            }
            if (dest.startsWith('ext-trunk,')) {
                const parts = dest.split(',');
                const trunkId = parts[1];
                const trunk = (typeof loadedTrunksList !== 'undefined' ? loadedTrunksList : []).find(t => String(t.trunkid) === String(trunkId));
                const name = trunk ? `${trunk.name} (${trunk.tech})` : trunkId;
                return `Trunk: ${name}`;
            }
            if (dest.startsWith('app-blackhole,hangup') || dest === 'app-blackhole,hangup,1') return isRtl ? 'إنهاء المكالمة (Hangup)' : 'Terminate Call (Hangup)';
            if (dest.startsWith('app-blackhole,congestion')) return isRtl ? 'نغمة ازدحام (Congestion)' : 'Play Congestion';
            if (dest.startsWith('app-blackhole,busy')) return isRtl ? 'نغمة مشغول (Busy)' : 'Play Busy';
            if (dest.startsWith('app-blackhole,zapateller')) return isRtl ? 'نغمة SIT (Zapateller)' : 'Play SIT Tone (Zapateller)';
            if (dest.startsWith('app-blackhole,musiconhold')) return isRtl ? 'الموسيقى في الانتظار (MoH)' : 'Hold Forever (MoH)';
            if (dest.startsWith('app-blackhole,ringing')) return isRtl ? 'رنين دائم' : 'Ring Forever';

            return dest;
        }


        // --- 5. INBOUND ROUTES ---
        function fetchInboundRoutes() {
            const tbody = document.getElementById('inbound-table-body');
            return fetch('/api/config/routes/inbound')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.routes) return;
                    loadedInboundRoutesList = Array.isArray(data.routes) ? data.routes : [];
                    const list = loadedInboundRoutesList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد مسارات واردة.' : 'No inbound routes found.') + '</td></tr>';
                        return;
                    }
                    list.forEach((r, idx) => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const extText = r.extension || '(ANY)';
                        const destText = formatDestination(r.destination);

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(r.description || '')}</td>
                            <td class="py-3 px-4 font-mono font-bold text-emerald-400">${escapeHtml(extText)}</td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-semibold">${escapeHtml(destText)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editInboundRouteByIndex(${idx})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteInboundRouteByIndex(${idx})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function editInboundRouteByIndex(idx) {
            const r = (loadedInboundRoutesList || [])[idx];
            if (r) {
                editInboundRoute(r.extension || '', r.description || '', r.destination || '');
            } else {
                openInboundModal();
            }
        }

        function deleteInboundRouteByIndex(idx) {
            const r = loadedInboundRoutesList[idx];
            if (!r) return;
            deleteInboundRoute(r.extension || '', r.description || '', r.destination || '');
        }


        function openInboundModal() {
            try {
                openModal('inboundModal');
                const title = document.getElementById('inboundModalTitle');
                if (title) title.textContent = isRtl ? 'إضافة مسار وارد' : 'Add Inbound Route';
                const form = document.getElementById('inboundForm');
                if (form) form.reset();
                const editExt = document.getElementById('inboundEditExt');
                if (editExt) editExt.value = "";
                const editDesc = document.getElementById('inboundEditDesc');
                if (editDesc) editDesc.value = "";
                const editDest = document.getElementById('inboundEditDest');
                if (editDest) editDest.value = "";
                const inExt = document.getElementById('inExtension');
                if (inExt) inExt.value = "";
                const inDesc = document.getElementById('inDescription');
                if (inDesc) inDesc.value = "";
                const inDest = document.getElementById('inDestination');
                if (inDest) inDest.value = "app-blackhole,hangup,1";
                initDestinationSelectInstances();
                if (inboundDestSelectInstance) inboundDestSelectInstance.setDialplan('app-blackhole,hangup,1');
                if (typeof ensureAllConfigListsLoaded === 'function') {
                    ensureAllConfigListsLoaded().then(() => {
                        if (inboundDestSelectInstance) inboundDestSelectInstance.setDialplan('app-blackhole,hangup,1');
                    }).catch(() => {});
                }
            } catch (err) {
                console.error('[openInboundModal Error]:', err);
                openModal('inboundModal');
            }
        }

        function editInboundRoute(extension, description, destination) {
            try {
                openModal('inboundModal');
                const title = document.getElementById('inboundModalTitle');
                if (title) title.textContent = isRtl ? 'تعديل مسار وارد' : 'Edit Inbound Route';
                const form = document.getElementById('inboundForm');
                if (form) form.reset();
                const editExt = document.getElementById('inboundEditExt');
                if (editExt) editExt.value = extension || '';
                const editDesc = document.getElementById('inboundEditDesc');
                if (editDesc) editDesc.value = description || '';
                const editDest = document.getElementById('inboundEditDest');
                if (editDest) editDest.value = destination || '';
                const inExt = document.getElementById('inExtension');
                if (inExt) inExt.value = extension || '';
                const inDesc = document.getElementById('inDescription');
                if (inDesc) inDesc.value = description || '';
                const inDest = document.getElementById('inDestination');
                const targetDest = destination || 'app-blackhole,hangup,1';
                if (inDest) inDest.value = targetDest;
                initDestinationSelectInstances();
                if (inboundDestSelectInstance) inboundDestSelectInstance.setDialplan(targetDest);
                if (typeof ensureAllConfigListsLoaded === 'function') {
                    ensureAllConfigListsLoaded().then(() => {
                        if (inboundDestSelectInstance) inboundDestSelectInstance.setDialplan(targetDest);
                    }).catch(() => {});
                }
            } catch (err) {
                console.error('[editInboundRoute Error]:', err);
                openModal('inboundModal');
            }
        }

        function saveInboundRoute(e) {
            e.preventDefault();
            const editExt = document.getElementById('inboundEditExt').value;
            const editDesc = document.getElementById('inboundEditDesc').value;
            const editDest = document.getElementById('inboundEditDest').value;
            
            const description = document.getElementById('inDescription').value.trim();
            const extension = document.getElementById('inExtension').value.trim();
            const destination = document.getElementById('inDestination').value.trim();

            if (!destination) {
                showToast(isRtl ? 'يرجى اختيار الوجهة.' : 'Please select a destination.', 'error');
                return;
            }
            if (extension && Array.isArray(loadedInboundRoutesList)) {
                const normExt = extension.trim();
                const existingRoute = (loadedInboundRoutesList || []).find(r => {
                    const origExt = (editExt || '').trim();
                    const origDesc = (editDesc || '').trim();
                    if (origExt || origDesc) {
                        if (String(r.extension || '').trim() === origExt && String(r.description || '').trim() === origDesc) {
                            return false;
                        }
                    }
                    const rExt = String(r.extension || '').trim();
                    if (!rExt) return false;
                    if (rExt === normExt) return true;
                    const alt1 = normExt.startsWith('+20') ? ('0' + normExt.substring(3)) : (normExt.startsWith('01') ? ('+20' + normExt.substring(1)) : normExt);
                    const alt2 = normExt.startsWith('+') ? normExt.substring(1) : ('+' + normExt);
                    return rExt === alt1 || rExt === alt2;
                });
                if (existingRoute) {
                    showToast(isRtl ? ("تحذير: رقم DID " + extension + " مستخدم بالفعل في مسار وارد آخر (" + (existingRoute.description || existingRoute.extension) + ")") : ("Warning: DID number " + extension + " already exists in another inbound route (" + (existingRoute.description || existingRoute.extension) + ")"), "warning");
                }
            }

            const url = '/api/config/routes/inbound';
            const method = (editDesc || editExt || editDest) ? 'PUT' : 'POST';
            
            const bodyData = { description, extension, destination };
            if (method === 'PUT') {
                bodyData.originalExtension = editExt;
                bodyData.originalDescription = editDesc;
                bodyData.originalDestination = editDest;
            }

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(bodyData)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.warningMessage) {
                        showToast(data.warningMessage, 'warning');
                    } else {
                        showToast(data.message, 'success');
                    }
                    closeModal('inboundModal');
                    fetchInboundRoutes();
                } else showToast(data.error, 'error');
            });
        }

        function deleteInboundRoute(extension, description, destination) {
            const label = description || extension || 'Inbound Route';
            if (!confirm(isRtl ? `حذف المسار الوارد '${label}'؟` : `Delete inbound route '${label}'?`)) return;
            fetch('/api/config/routes/inbound', {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ extension, description, destination })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchInboundRoutes();
                } else showToast(data.error, 'error');
            });
        }
        window.fetchInboundRoutes = fetchInboundRoutes;
        window.editInboundRouteByIndex = editInboundRouteByIndex;
        window.deleteInboundRouteByIndex = deleteInboundRouteByIndex;
        window.openInboundModal = openInboundModal;
        window.editInboundRoute = editInboundRoute;
        window.saveInboundRoute = saveInboundRoute;
        window.deleteInboundRoute = deleteInboundRoute;
        window.loadInboundDonglePopup = loadInboundDonglePopup;
        // --- 6. OUTBOUND ROUTES ---
        function renderModalPatterns() {
            const listEl = document.getElementById('outboundPatternsList');
            if (!listEl) return;
            listEl.innerHTML = '';
            if (modalPatternsList.length === 0) {
                listEl.innerHTML = '<span class="text-xs text-[var(--text-muted)] italic">No patterns added yet.</span>';
                return;
            }
            modalPatternsList.forEach((pat, idx) => {
                const div = document.createElement('div');
                if (idx === editingPatternIndex) {
                    div.className = 'flex items-center justify-between bg-blue-500/5 border border-blue-500/50 px-3 py-2 rounded-lg text-xs ring-1 ring-blue-500/60';
                } else {
                    div.className = 'flex items-center justify-between bg-[var(--bg-secondary)] border border-[var(--border-primary)] px-3 py-2 rounded-lg text-xs';
                }
                
                let htmlParts = [];
                if (pat.prepend) htmlParts.push(`<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-1 py-0.5 rounded font-mono font-bold">prepend: ${pat.prepend}</span>`);
                if (pat.prefix) htmlParts.push(`<span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 px-1 py-0.5 rounded font-mono font-bold">prefix: ${pat.prefix}</span>`);
                htmlParts.push(`<span class="bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] px-1.5 py-0.5 rounded font-mono font-extrabold text-blue-300">pattern: ${pat.pattern}</span>`);
                if (pat.cid) htmlParts.push(`<span class="bg-purple-500/10 text-purple-400 border border-purple-500/20 px-1 py-0.5 rounded font-mono font-bold">CID: ${pat.cid}</span>`);
                
                div.innerHTML = `
                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                        ${htmlParts.join('')}
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" onclick="editDialPatternInModalList(${idx})" class="text-blue-400 hover:underline text-[11px] cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                        <button type="button" onclick="removeDialPatternFromModalList(${idx})" class="text-red-400 hover:underline text-[11px] cursor-pointer"><span>${isRtl ? 'حذف' : 'Remove'}</span></button>
                    </div>
                `;
                listEl.appendChild(div);
            });
        }

        function editDialPatternInModalList(idx) {
            editingPatternIndex = idx;
            const pat = modalPatternsList[idx];
            document.getElementById('patPrepend').value = pat.prepend || '';
            document.getElementById('patPrefix').value = pat.prefix || '';
            document.getElementById('patPattern').value = pat.pattern || '';
            document.getElementById('patCid').value = pat.cid || '';
            
            renderModalPatterns();
            
            const btn = document.getElementById('addPatternBtn');
            if (btn) btn.textContent = isRtl ? 'تحديث النمط' : 'Update Pattern';
        }

        function addDialPatternToModalList() {
            const patternInput = document.getElementById('patPattern');
            const pattern = patternInput.value.trim();
            if (!pattern) {
                showToast(isRtl ? 'حقل النمط مطلوب.' : 'Pattern field is required.', 'error');
                return;
            }
            const prepend = document.getElementById('patPrepend').value.trim();
            const prefix = document.getElementById('patPrefix').value.trim();
            const cid = document.getElementById('patCid').value.trim();
            
            if (editingPatternIndex > -1) {
                modalPatternsList[editingPatternIndex] = { prepend, prefix, pattern, cid };
                editingPatternIndex = -1;
                const btn = document.getElementById('addPatternBtn');
                if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';
            } else {
                modalPatternsList.push({ prepend, prefix, pattern, cid });
            }
            
            renderModalPatterns();
            
            patternInput.value = '';
            document.getElementById('patPrepend').value = '';
            document.getElementById('patPrefix').value = '';
            document.getElementById('patCid').value = '';
        }

        function removeDialPatternFromModalList(idx) {
            modalPatternsList.splice(idx, 1);
            if (editingPatternIndex === idx) {
                editingPatternIndex = -1;
                const btn = document.getElementById('addPatternBtn');
                if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';
                document.getElementById('patPattern').value = '';
                document.getElementById('patPrepend').value = '';
                document.getElementById('patPrefix').value = '';
                document.getElementById('patCid').value = '';
            } else if (editingPatternIndex > idx) {
                editingPatternIndex--;
            }
            renderModalPatterns();
        }

        function renderModalTrunksSequence() {
            const listEl = document.getElementById('outboundTrunksSequenceList');
            if (!listEl) return;
            listEl.innerHTML = '';
            if (modalTrunksSequence.length === 0) {
                listEl.innerHTML = '<span class="text-xs text-[var(--text-muted)] italic">No trunks in sequence yet.</span>';
                return;
            }
            modalTrunksSequence.forEach((trunkId, idx) => {
                const trunkMatch = (loadedTrunksList || []).find(t => String(t.trunkid) === String(trunkId));
                let trunkName = trunkMatch ? trunkMatch.name : '';
                if (!trunkName && String(trunkId).startsWith('fed_peer_')) {
                    const pid = String(trunkId).replace('fed_peer_', '');
                    const peerMatch = (loadedFederationPeersList || []).find(p => String(p.id) === pid);
                    trunkName = peerMatch ? `[Remote PBX] ${peerMatch.node_name || 'Site ' + peerMatch.site_code}` : `Remote PBX #${pid}`;
                }
                if (!trunkName) trunkName = `Trunk ID #${trunkId}`;
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between bg-[var(--bg-secondary)] border border-[var(--border-primary)] px-3 py-1.5 rounded-lg text-xs';
                div.innerHTML = `
                    <span class="font-bold text-[var(--text-primary)] font-mono">${idx + 1}. ${trunkName}</span>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="moveTrunkInSequence(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="text-blue-400 hover:text-blue-500 disabled:opacity-35 disabled:cursor-not-allowed text-[11px] cursor-pointer">▲</button>
                        <button type="button" onclick="moveTrunkInSequence(${idx}, 1)" ${idx === modalTrunksSequence.length - 1 ? 'disabled' : ''} class="text-blue-400 hover:text-blue-500 disabled:opacity-35 disabled:cursor-not-allowed text-[11px] cursor-pointer">▼</button>
                        <button type="button" onclick="removeTrunkFromModalSequence(${idx})" class="text-red-400 hover:text-red-500 ml-2 cursor-pointer">✕</button>
                    </div>
                `;
                listEl.appendChild(div);
            });
        }

        function addTrunkToModalSequence() {
            const selectEl = document.getElementById('sequenceTrunkSelect');
            const trunkId = selectEl.value;
            if (!trunkId) return;
            if (modalTrunksSequence.includes(trunkId)) {
                showToast(isRtl ? 'خط الربط موجود بالفعل في التسلسل.' : 'Trunk is already in the sequence.', 'error');
                return;
            }
            modalTrunksSequence.push(trunkId);
            renderModalTrunksSequence();
            selectEl.value = '';
        }

        function moveTrunkInSequence(idx, dir) {
            const targetIdx = idx + dir;
            if (targetIdx < 0 || targetIdx >= modalTrunksSequence.length) return;
            const temp = modalTrunksSequence[idx];
            modalTrunksSequence[idx] = modalTrunksSequence[targetIdx];
            modalTrunksSequence[targetIdx] = temp;
            renderModalTrunksSequence();
        }

        function removeTrunkFromModalSequence(idx) {
            modalTrunksSequence.splice(idx, 1);
            renderModalTrunksSequence();
        }


        let draggedOutboundRouteIndex = null;

        function fetchOutboundRoutes() {
            return fetch('/api/config/routes/outbound')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.routes) return;
                    loadedOutboundRoutesList = Array.isArray(data.routes) ? data.routes : [];
                    renderOutboundRoutesTable();
                })
                .catch(err => console.error(err));
        }

        function renderOutboundRoutesTable() {
            const tbody = document.getElementById('outbound-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            const list = loadedOutboundRoutesList || [];
            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد مسارات صادرة.' : 'No outbound routes found.') + '</td></tr>';
                return;
            }

            list.forEach((r, idx) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-[var(--bg-hover)] transition-colors border-b border-[var(--border-primary)]/50 group select-none cursor-grab active:cursor-grabbing';
                tr.dataset.routeId = r.route_id;
                tr.dataset.index = idx;
                tr.setAttribute('draggable', 'true');

                const priorityNumber = idx + 1;
                const patterns = Array.isArray(r.patterns) ? r.patterns : [];
                const patHtml = patterns.map(p => {
                    const textParts = [];
                    if (p.prepend) textParts.push(`<span class="text-emerald-400 font-bold font-mono" title="Prepend">(${p.prepend})</span>`);
                    if (p.prefix) textParts.push(`<span class="text-amber-400 font-mono" title="Prefix">${p.prefix} |</span>`);
                    textParts.push(`<span class="text-[var(--text-primary)] font-extrabold font-mono" title="Match Pattern">${p.pattern}</span>`);
                    if (p.cid) textParts.push(`<span class="text-purple-400 font-mono" title="Caller ID">/ ${p.cid}</span>`);
                    return `<div class="font-mono text-xs bg-[var(--bg-secondary)] px-2.5 py-1 rounded border border-[var(--border-primary)]/80 inline-flex items-center gap-1 mr-1.5 mb-1.5">${textParts.join('')}</div>`;
                }).join(' ') || '<span class="text-[var(--text-muted)]">-</span>';
                
                const trunks = Array.isArray(r.trunks) ? r.trunks : [];
                const trunkHtml = trunks.map(t => {
                    return `<div class="font-mono text-xs text-emerald-400 font-semibold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 w-fit inline-block mr-1 mb-1">${escapeHtml(t.trunk_name || t.name || t.trunk_id || '')}</div>`;
                }).join(' ➔ ') || '<span class="text-[var(--text-muted)]">-</span>';

                tr.innerHTML = `
                    <td class="py-3 px-3 text-center">
                        <div class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-[var(--bg-secondary)] border border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] group-hover:border-blue-500/40 group-hover:text-blue-400 transition-colors" title="${isRtl ? 'اسحب لإعادة الترتيب' : 'Drag to reorder priority'}">
                            <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-blue-400 shrink-0 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
                            </svg>
                            <span>#${priorityNumber}</span>
                        </div>
                    </td>
                    <td class="py-3 px-4 font-mono font-bold text-[var(--text-muted)]">${r.route_id}</td>
                    <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(r.name)}</td>
                    <td class="py-3 px-4">${patHtml}</td>
                    <td class="py-3 px-4">${trunkHtml}</td>
                    <td class="py-3 px-4 text-center">
                        <div class="flex items-center justify-center gap-1.5">
                            <button type="button" title="${isRtl ? 'تحريك للأعلى' : 'Move Up'}" onclick="moveOutboundRoute(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="p-1 text-xs font-semibold ${idx === 0 ? 'opacity-25 cursor-not-allowed text-[var(--text-muted)]' : 'text-blue-400 hover:bg-blue-500/10 cursor-pointer'} rounded border border-[var(--border-primary)] transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
                            </button>
                            <button type="button" title="${isRtl ? 'تحريك للأسفل' : 'Move Down'}" onclick="moveOutboundRoute(${idx}, 1)" ${idx === list.length - 1 ? 'disabled' : ''} class="p-1 text-xs font-semibold ${idx === list.length - 1 ? 'opacity-25 cursor-not-allowed text-[var(--text-muted)]' : 'text-blue-400 hover:bg-blue-500/10 cursor-pointer'} rounded border border-[var(--border-primary)] transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                            </button>
                            <button type="button" onclick="editOutboundRouteByIndex(${idx})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer transition-colors"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                            <button type="button" onclick="deleteOutboundRoute(${r.route_id})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer transition-colors"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                        </div>
                    </td>
                `;

                // Drag and Drop Event Listeners
                tr.addEventListener('dragstart', (e) => {
                    draggedOutboundRouteIndex = idx;
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', String(idx));
                    tr.classList.add('opacity-40', 'bg-blue-500/10');
                });

                tr.addEventListener('dragend', () => {
                    tr.classList.remove('opacity-40', 'bg-blue-500/10');
                    document.querySelectorAll('#outbound-table-body tr').forEach(row => {
                        row.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                    });
                });

                tr.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    const rect = tr.getBoundingClientRect();
                    const offset = e.clientY - rect.top;
                    document.querySelectorAll('#outbound-table-body tr').forEach(row => {
                        if (row !== tr) row.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                    });
                    if (offset < rect.height / 2) {
                        tr.classList.add('border-t-2', 'border-blue-500');
                        tr.classList.remove('border-b-2');
                    } else {
                        tr.classList.add('border-b-2', 'border-blue-500');
                        tr.classList.remove('border-t-2');
                    }
                });

                tr.addEventListener('dragleave', () => {
                    tr.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                });

                tr.addEventListener('drop', (e) => {
                    e.preventDefault();
                    tr.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                    const fromIdx = draggedOutboundRouteIndex;
                    if (fromIdx === null || fromIdx === undefined || isNaN(fromIdx)) return;
                    
                    const rect = tr.getBoundingClientRect();
                    const offset = e.clientY - rect.top;
                    let toIdx = idx;

                    if (fromIdx === toIdx) return;

                    const movedItem = loadedOutboundRoutesList.splice(fromIdx, 1)[0];
                    let targetInsertIdx = toIdx;
                    if (offset >= rect.height / 2) {
                        targetInsertIdx = fromIdx < toIdx ? toIdx : toIdx + 1;
                    } else {
                        targetInsertIdx = fromIdx < toIdx ? toIdx - 1 : toIdx;
                    }
                    if (targetInsertIdx < 0) targetInsertIdx = 0;
                    if (targetInsertIdx > loadedOutboundRoutesList.length) targetInsertIdx = loadedOutboundRoutesList.length;

                    loadedOutboundRoutesList.splice(targetInsertIdx, 0, movedItem);
                    saveOutboundRoutesOrder();
                });

                tbody.appendChild(tr);
            });
        }

        function moveOutboundRoute(idx, direction) {
            const targetIdx = idx + direction;
            if (!loadedOutboundRoutesList || targetIdx < 0 || targetIdx >= loadedOutboundRoutesList.length) return;
            const temp = loadedOutboundRoutesList[idx];
            loadedOutboundRoutesList[idx] = loadedOutboundRoutesList[targetIdx];
            loadedOutboundRoutesList[targetIdx] = temp;
            saveOutboundRoutesOrder();
        }

        function saveOutboundRoutesOrder() {
            const routeIds = (loadedOutboundRoutesList || []).map(r => r.route_id);
            renderOutboundRoutesTable();

            fetch('/api/config/routes/outbound/reorder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ route_ids: routeIds })
            })
            .then(res => {
                if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ أولوية المسارات الصادرة بنجاح.' : 'Outbound routes priority reordered successfully.', 'success');
                } else {
                    showToast(data.error || 'Failed to reorder routes', 'error');
                    fetchOutboundRoutes();
                }
            })
            .catch(err => {
                console.error(err);
                showToast('Network error while reordering routes', 'error');
                fetchOutboundRoutes();
            });
        }

        function editOutboundRouteByIndex(idx) {
            const r = (loadedOutboundRoutesList || [])[idx] || (loadedOutboundRoutesList || []).find(x => String(x.route_id) === String(idx));
            if (r) {
                editOutboundRoute(r.route_id, r.name, r.patterns, r.trunks);
            } else {
                openOutboundModal();
            }
        }

        function openOutboundModal() {
            openModal('outboundModal');
            document.getElementById('outboundModalTitle').textContent = isRtl ? 'إضافة مسار صادر' : 'Add Outbound Route';
            document.getElementById('outboundEditId').value = "";
            document.getElementById('outboundForm').reset();
            modalPatternsList = [];
            modalTrunksSequence = [];
            editingPatternIndex = -1;
            
            const btn = document.getElementById('addPatternBtn');
            if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';
            
            const sel = document.getElementById('sequenceTrunkSelect');
            if (sel) {
                sel.innerHTML = '<option value="">-- Choose Trunk --</option>';
                (loadedTrunksList || []).forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.trunkid;
                    opt.textContent = `${t.name} (${t.tech})`;
                    sel.appendChild(opt);
                });
            }

            renderModalPatterns();
            renderModalTrunksSequence();
        }

        function editOutboundRoute(routeId, name, patterns, trunks) {
            openModal('outboundModal');
            document.getElementById('outboundModalTitle').textContent = (isRtl ? 'تعديل المسار الصادر ' : 'Edit Outbound Route ') + (name || '');
            document.getElementById('outboundEditId').value = routeId;
            document.getElementById('outName').value = name || '';
            editingPatternIndex = -1;
            
            const btn = document.getElementById('addPatternBtn');
            if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';

            if (Array.isArray(patterns)) {
                modalPatternsList = patterns;
            } else {
                try { modalPatternsList = JSON.parse(patterns) || []; } catch(e) { modalPatternsList = []; }
            }

            if (Array.isArray(trunks)) {
                const trs = [...trunks].sort((a,b) => (a.seq || 0) - (b.seq || 0));
                modalTrunksSequence = trs.map(t => String(t.trunk_id));
            } else {
                try {
                    const trs = JSON.parse(trunks) || [];
                    trs.sort((a,b) => (a.seq || 0) - (b.seq || 0));
                    modalTrunksSequence = trs.map(t => String(t.trunk_id));
                } catch(e) { modalTrunksSequence = []; }
            }
            const sel = document.getElementById('sequenceTrunkSelect');
            if (sel) {
                sel.innerHTML = '<option value="">-- Choose Trunk --</option>';
                (loadedTrunksList || []).forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.trunkid;
                    opt.textContent = `${t.name} (${t.tech})`;
                    sel.appendChild(opt);
                });
            }

            renderModalPatterns();
            renderModalTrunksSequence();
        }

        function saveOutboundRoute(e) {
            e.preventDefault();
            const editId = document.getElementById('outboundEditId').value;
            const name = document.getElementById('outName').value.trim();

            if (modalPatternsList.length === 0) {
                showToast(isRtl ? 'يرجى إضافة نمط اتصال واحد على الأقل.' : 'Please add at least one Dial Pattern.', 'error');
                return;
            }
            const sel = document.getElementById('sequenceTrunkSelect');
            if (modalTrunksSequence.length === 0 && sel && sel.value) {
                addTrunkToModalSequence();
            }

            if (modalTrunksSequence.length === 0) {
                showToast(isRtl ? 'يرجى إضافة خط ربط واحد على الأقل في التسلسل (اضغط "Add").' : 'Please add at least one Trunk to the sequence (click "Add").', 'error');
                return;
            }

            const url = editId ? '/api/config/routes/outbound/' + editId : '/api/config/routes/outbound';
            const method = editId ? 'PUT' : 'POST';

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name,
                    patterns: modalPatternsList,
                    trunks: modalTrunksSequence
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('outboundModal');
                    fetchOutboundRoutes();
                } else showToast(data.error, 'error');
            });
        }

        function deleteOutboundRoute(routeId) {
            if (!confirm(isRtl ? `حذف المسار الصادر #${routeId}؟` : `Delete outbound route ID ${routeId}?`)) return;
            fetch('/api/config/routes/outbound/' + routeId, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchOutboundRoutes();
                    } else showToast(data.error, 'error');
                });
        }

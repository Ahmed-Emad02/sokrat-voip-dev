                            <span><%= isRtl ? 'حفظ جميع التغييرات' : 'Save All Changes' %></span>
                        </button>
                    </div>
                </div>

                <div class="p-4 sm:px-6 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/25">

            </button>
        </div>
        <% if (isTabAllowed('extensions')) { %>
        <div id="section-extensions" class="tab-section">
            <div class="config-card p-6">
                    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
                        <div>
                            <h2 class="text-lg font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'إدارة التحويلات (SIP Extensions)' : 'SIP Extensions' %></h2>
                        </div>
                        <div class="flex items-center gap-2 flex-wrap">
                            <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                            <button type="button" onclick="openPolicyManagerModal()" class="config-btn-secondary px-3.5 py-2 flex items-center gap-2 text-xs font-bold cursor-pointer border border-emerald-500/30 text-emerald-400 hover:text-emerald-300 hover:border-emerald-500/50">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                                <span><%= isRtl ? 'سياسات وقفل WebRTC' : 'WebRTC Policies' %></span>
                            </button>
                            <% } %>
                            <button type="button" onclick="openExtensionModal()" class="config-btn-primary px-4 py-2 flex items-center gap-2 text-xs cursor-pointer">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                                <span><%= isRtl ? 'إضافة تحويلة جديدة' : 'Add New Extension' %></span>
                            </button>

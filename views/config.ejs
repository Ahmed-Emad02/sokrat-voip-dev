        function filterTimeConditionsTable() {
            const input = document.getElementById('timeconditions-search-input') || document.getElementById('timecondition-search-input');
            if (!input) return;
            const q = input.value.trim().toLowerCase();
            const rows = document.querySelectorAll('.timecondition-row');
            rows.forEach(row => {
                const search = row.getAttribute('data-search') || '';
                const text = row.textContent.toLowerCase();
                if (!q || search.includes(q) || text.includes(q)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        }

        function populateTcTimeGroupsSelect() {
            const select = document.getElementById('tcTimeGroup');
            if (!select) return;
            const currentVal = select.value;
            select.innerHTML = '<option value="">' + (isRtl ? '-- اختر مجموعة الوقت --' : '-- Select Time Group --') + '</option>';
            if (Array.isArray(loadedTimeGroupsList)) {
                (loadedTimeGroupsList || []).forEach(tg => {
                    const opt = document.createElement('option');
                    opt.value = tg.id;
                    opt.textContent = `${tg.description || 'Time Group'} (ID: ${tg.id})`;
                    select.appendChild(opt);
                });
            }
            if (currentVal) select.value = currentVal;
        }

        function openTimeConditionModal() {
            openModal('timeConditionModal');
            document.getElementById('timeConditionForm').reset();
            document.getElementById('tcEditMode').value = 'false';
            document.getElementById('tcId').value = '';
            document.getElementById('tcDisplayName').value = '';
            document.getElementById('tcTimeGroup').value = '';
            document.getElementById('tcTrueGoto').value = 'app-blackhole,hangup,1';
            document.getElementById('tcFalseGoto').value = 'app-blackhole,hangup,1';

            initDestinationSelectInstances();
            if (tcTrueDestSelectInstance) tcTrueDestSelectInstance.setDialplan('app-blackhole,hangup,1');

                                <th class="py-3 px-4"><%= isRtl ? 'الوجهة المستهدفة' : 'Post Destination' %></th>
                                <th class="py-3 px-4 text-center w-36"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody id="announcements-table-body" class="divide-y divide-[var(--border-primary)] text-sm font-medium text-[var(--text-primary)]">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- MUSIC ON HOLD (MOH) MANAGEMENT CARD -->
            <div class="config-card p-6 mt-6">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 border-b border-[var(--border-primary)] pb-4">
                    <div>
                        <h2 class="text-lg font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                            <svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 .895-2 3-2 3 .895 3 2zM9 10l12-3" />
                            </svg>
                            <span><%= isRtl ? 'الموسيقى أثناء الانتظار (Music on Hold - MoH)' : 'Music on Hold (MoH)' %></span>
                        </h2>
                        <p class="text-xs text-[var(--text-muted)] mt-1">
                            <%= isRtl ? 'إدارة فئات الموسيقى أثناء الانتظار، رفع مقاطع الصوت، والتحكم بخيارات Asterisk MoH' : 'Manage Music on Hold categories, upload audio tracks, and preview hold music classes' %>
                        </p>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <button onclick="openMohCategoryModal()" class="config-btn-secondary px-3.5 py-2 text-xs flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
                            <span><%= isRtl ? 'إضافة فئة جديدة' : 'Add MoH Category' %></span>
                        </button>
                        <button onclick="fetchMohData()" class="config-btn-secondary px-3.5 py-2 text-xs flex items-center gap-1.5 cursor-pointer">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                            <span><%= isRtl ? 'تحديث' : 'Refresh MoH' %></span>
                        </button>
                    </div>
                </div>

                <!-- MoH Category Selector & Upload Toolbar -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6 bg-[var(--bg-card)] p-4 rounded-xl border border-[var(--border-primary)]">
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'فئة الموسيقى (Category)' : 'Select MoH Category' %></label>
                        <select id="mohCategorySelect" onchange="onMohCategoryChange()" class="config-input w-full text-xs font-mono font-bold">
                            <!-- Populated dynamically -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1.5"><%= isRtl ? 'معلومات الفئة' : 'Category Info' %></label>
                        <div id="mohCategoryInfo" class="text-xs text-[var(--text-muted)] space-y-1 font-mono pt-1">
                            <div><span class="text-white"><%= isRtl ? 'المسار:' : 'Path:' %></span> <span id="mohPathDisplay" class="truncate font-mono text-[11px] text-amber-400">/var/lib/asterisk/moh/</span></div>
                            <div><span class="text-white"><%= isRtl ? 'الفرز:' : 'Sort:' %></span> <span id="mohSortDisplay" class="font-bold text-emerald-400">alpha</span></div>
                        </div>
                    </div>
                    <div class="flex flex-col justify-end">

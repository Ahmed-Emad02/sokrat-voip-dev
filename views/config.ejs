                                        <th class="py-2.5 px-4">${isRtl ? 'جاهز (Free)' : 'Free (Ready)'}</th>
                                        <th class="py-2.5 px-4">${isRtl ? 'مشغول (Busy)' : 'Busy (In Call)'}</th>
                                        <th class="py-2.5 px-4">${isRtl ? 'غير مهيأ' : 'Not Initialized'}</th>
                                        <th class="py-2.5 px-4">${isRtl ? 'غير متصل' : 'Disconnected'}</th>

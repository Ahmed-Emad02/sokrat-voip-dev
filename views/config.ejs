                                </thead>
                                <tbody class="divide-y divide-[var(--border-primary)] text-xs font-mono">
                `;

                if (!data.dongleReports || data.dongleReports.length === 0) {
                    donglesHTML += `<tr><td colspan="8" class="py-6 text-center text-[var(--text-muted)]">${isRtl ? 'لا توجد بيانات مسجلة في هذه الفترة الزمانية.' : 'No dongle state logs recorded in this timeframe.'}</td></tr>`;

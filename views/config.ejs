                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.timeconditions) return;
                    loadedTimeConditionsList = Array.isArray(data.timeconditions) ? data.timeconditions : [];
                    const list = loadedTimeConditionsList;

                    const countBadge = document.getElementById('timeconditions-count-badge');

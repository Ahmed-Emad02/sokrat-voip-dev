<!-- Theme Handler Script -->
<script>
    // Prevent theme flickering
    (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        if (theme === 'light') {
            document.documentElement.classList.add('light-theme');
            document.addEventListener('DOMContentLoaded', () => {
                document.body.classList.add('light-theme');
                updateThemeUI(true);
            });
        } else {
            document.addEventListener('DOMContentLoaded', () => {
                updateThemeUI(false);
            });
        }
    })();

    function updateThemeUI(isLight) {
        const thumb = document.getElementById('themeThumb');
        const track = document.getElementById('themeToggleBtn');
        const logo = document.getElementById('brandLogo');
        const modeLabel = document.getElementById('themeModeLabel');
        if (thumb) {
            thumb.classList.toggle('translate-x-5', isLight);
            thumb.classList.toggle('translate-x-0', !isLight);
        }
        if (track) {
            track.style.backgroundColor = isLight ? '#e4e4e7' : 'rgba(204, 9, 12, 0.3)';
            track.setAttribute('aria-checked', String(!isLight));
        }
        if (modeLabel) {
            modeLabel.textContent = isLight ? modeLabel.dataset.lightLabel : modeLabel.dataset.darkLabel;
        }
        if (logo) {
            logo.src = isLight ? '/logo.png' : '/logo_light_text.png';
        }
    }

    function toggleTheme(e) {
        const isLight = document.body.classList.toggle('light-theme');
        document.documentElement.classList.toggle('light-theme', isLight);
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        updateThemeUI(isLight);
        
        // Anime.js ripple & spring animation on theme toggle
        if (typeof anime !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            const thumb = document.getElementById('themeThumb');
            if (thumb) {
                anime({
                    targets: thumb,
                    scale: [0.75, 1.15, 1],
                    rotate: isLight ? [0, 180] : [180, 0],
                    duration: 350,
                    easing: 'easeOutElastic(1, .7)'
                });
            }

            const ripple = document.createElement('div');
            ripple.className = 'fixed rounded-full pointer-events-none z-[999998]';
            const btn = document.getElementById('themeToggleBtn') || document.body;
            const rect = btn.getBoundingClientRect();
            const radius = Math.hypot(Math.max(rect.left, window.innerWidth - rect.left), Math.max(rect.top, window.innerHeight - rect.top));
            
            ripple.style.left = (rect.left + rect.width / 2 - radius) + 'px';
            ripple.style.top = (rect.top + rect.height / 2 - radius) + 'px';
            ripple.style.width = (radius * 2) + 'px';
            ripple.style.height = (radius * 2) + 'px';
            ripple.style.backgroundColor = isLight ? 'rgba(249, 250, 251, 0.85)' : 'rgba(5, 5, 7, 0.85)';
            ripple.style.backdropFilter = 'blur(12px)';
            ripple.style.transform = 'scale(0)';
            document.body.appendChild(ripple);

            anime({
                targets: ripple,
                scale: [0, 1],
                opacity: [0.8, 0],
                duration: 450,
                easing: 'easeOutQuint',
                complete: function() {
                    if (ripple && ripple.parentNode) ripple.parentNode.removeChild(ripple);
                }
            });
        }

        if (window.pieChart) {
            location.reload();
        }
        if (window.location.pathname === '/ext-stats') {
            if (window.currentExtension) {
                window.loadStats(window.currentExtension);
            } else {
                window.loadOverview();
            }
        }
    }

    // Settings dropdown
    function initSidebarControls() {
        updateThemeUI(localStorage.getItem('theme') === 'light');

        const settingsBtn = document.getElementById('settingsBtn');
        const settingsMenu = document.getElementById('settingsMenu');
        if (settingsBtn && settingsMenu) {
            function positionMenu() {
                settingsMenu.style.width = ''; // reset to auto first
                const rect = settingsBtn.getBoundingClientRect();
                const gap = 8;
                let left = rect.left;
                if (left + settingsMenu.offsetWidth > window.innerWidth - gap) {
                    left = window.innerWidth - settingsMenu.offsetWidth - gap;
                }
                if (left < gap) left = gap;
                settingsMenu.style.left = left + 'px';
                
                let top = rect.top - settingsMenu.offsetHeight - gap;
                if (top < gap) {
                    top = rect.bottom + gap;
                }
                settingsMenu.style.top = top + 'px';
            }
            function setSettingsMenuOpen(isOpen) {
                if (isOpen) positionMenu();
                settingsMenu.classList.toggle('visible', isOpen);
                settingsMenu.classList.toggle('invisible', !isOpen);
                settingsMenu.classList.toggle('opacity-0', !isOpen);
                settingsMenu.classList.toggle('scale-95', !isOpen);
                settingsMenu.classList.toggle('opacity-100', isOpen);
                settingsMenu.classList.toggle('scale-100', isOpen);
                settingsMenu.style.pointerEvents = isOpen ? 'auto' : 'none';
                settingsBtn.setAttribute('aria-expanded', String(isOpen));
            }
            settingsBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                setSettingsMenuOpen(!settingsMenu.classList.contains('visible'));
            });
            document.addEventListener('click', () => setSettingsMenuOpen(false));
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && settingsMenu.classList.contains('visible')) {
                    setSettingsMenuOpen(false);
                    settingsBtn.focus();
                }
            });
            settingsMenu.addEventListener('click', (e) => e.stopPropagation());
            settingsMenu.querySelectorAll('.settings-action').forEach(action => {
                action.addEventListener('click', () => setSettingsMenuOpen(false));
            });
            window.addEventListener('scroll', () => {
                if (settingsMenu.classList.contains('visible')) positionMenu();
            });
            window.addEventListener('resize', () => {
                if (settingsMenu.classList.contains('visible')) positionMenu();
            });
        }

        // Sidebar Collapse / Expand Toggle
        function updateCollapseButtonIcon(isCollapsed) {
            const icon = document.getElementById('collapseIcon');
            const btn = document.getElementById('toggleSidebarCollapseBtn');
            if (!icon || !btn) return;
            const isRtl = document.documentElement.dir === 'rtl';
            btn.setAttribute('title', isCollapsed ? (isRtl ? 'توسيع القائمة' : 'Maximize Sidebar') : (isRtl ? 'تصغير القائمة' : 'Minimize Sidebar'));
            if (isCollapsed) {
                icon.style.transform = 'rotate(180deg)';
            } else {
                icon.style.transform = 'none';
            }
        }

        window.toggleSidebarCollapse = function() {
            const sidebar = document.getElementById('appSidebar');
            if (!sidebar) return;
            const isCollapsed = sidebar.classList.toggle('sidebar-collapsed');
            document.documentElement.classList.toggle('sidebar-collapsed', isCollapsed);
            localStorage.setItem('sidebar_collapsed', String(isCollapsed));
            updateCollapseButtonIcon(isCollapsed);
            window.dispatchEvent(new Event('resize'));
        };

        if (localStorage.getItem('sidebar_collapsed') === 'true') {
            const sidebar = document.getElementById('appSidebar');
            if (sidebar) sidebar.classList.add('sidebar-collapsed');
            document.documentElement.classList.add('sidebar-collapsed');
            updateCollapseButtonIcon(true);
        }

        // Mobile Sidebar Drawer Toggle
        const sidebar = document.getElementById('appSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const openBtn = document.getElementById('mobileMenuBtn');
        const closeBtn = document.getElementById('closeSidebarBtn');
        const isRtl = document.documentElement.dir === 'rtl';

        function openSidebar() {
            if (sidebar && overlay) {
                sidebar.classList.remove(isRtl ? 'translate-x-full' : '-translate-x-full');
                sidebar.classList.add('translate-x-0');
                overlay.classList.remove('hidden');
            }
        }

        function closeSidebar() {
            if (sidebar && overlay) {
                sidebar.classList.remove('translate-x-0');
                sidebar.classList.add(isRtl ? 'translate-x-full' : '-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        if (openBtn) openBtn.addEventListener('click', openSidebar);
        if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
        if (overlay) overlay.addEventListener('click', closeSidebar);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSidebarControls);
    } else {
        initSidebarControls();
    }
</script>

<script>
function updateClock() {
    var el = document.getElementById('digitalClock');
    if (!el) return;
    var d = new Date();
    el.textContent = d.getHours().toString().padStart(2,'0') + ':' + d.getMinutes().toString().padStart(2,'0') + ':' + d.getSeconds().toString().padStart(2,'0');
}
document.addEventListener('DOMContentLoaded', function() { updateClock(); setInterval(updateClock, 1000); });
</script>


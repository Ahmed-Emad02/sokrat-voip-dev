    <!-- Sidebar Footer Action Panel -->
    <div class="flex flex-col gap-4 border-t border-[var(--border-primary)] pt-4 mt-auto">
        <!-- System Clock & User info -->
        <div class="sidebar-info-row flex flex-col gap-1 px-1">
            <div class="flex items-center justify-between text-xs font-semibold text-[var(--text-secondary)]">
                <span class="text-[9px] font-black uppercase text-[var(--text-muted)] tracking-wider"><%= sbT.liveClock %></span>
                <span id="digitalClock" class="font-mono text-sm tracking-tight text-[var(--accent-color)]">00:00:00</span>
            </div>
            <div class="flex items-center justify-between text-[11px] font-semibold text-[var(--text-muted)] mt-1">
                <span>USER:</span>
                <span class="text-[var(--text-primary)]"><%= typeof currentUser !== 'undefined' ? currentUser : '' %></span>
            </div>
        </div>

        <!-- Action Switches -->
        <div class="flex items-center px-1">
            <!-- Settings Button with Dropdown -->
            <div class="relative w-full" id="settingsDropdown">
                <button id="settingsBtn" type="button" class="settings-launcher cursor-pointer" title="<%= sbT.settingsTitle %>" aria-haspopup="dialog" aria-expanded="false" aria-controls="settingsMenu">
                    <svg class="w-4 h-4 text-[var(--text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                    <span class="settings-launcher-label"><%= sbT.settingsTitle %></span>
                    <svg class="settings-launcher-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
                </button>
            </div>
        </div>
    </div>
</aside>

<!-- Settings Dropdown Menu (Open above) -->
<div id="settingsMenu" class="settings-menu fixed opacity-0 invisible scale-95 transition-all duration-150 z-50" style="pointer-events:none" role="dialog" aria-label="<%= sbT.settingsTitle %>">
    <div class="settings-menu-header">
        <span class="settings-menu-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.05.05-2.83 2.83-.05-.05A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 1.55V21h-4v-.05A1.7 1.7 0 0 0 9 19.4a1.7 1.7 0 0 0-1.88.34l-.05.05-2.83-2.83.05-.05A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.55-1H3v-4h.05A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.88l-.05-.05 2.83-2.83.05.05A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.55V3h4v.05A1.7 1.7 0 0 0 15 4.6a1.7 1.7 0 0 0 1.88-.34l.05-.05 2.83 2.83-.05.05A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.55 1H21v4h-.05A1.7 1.7 0 0 0 19.4 15Z"></path>
            </svg>
        </span>
        <div>
            <h2 class="settings-menu-title"><%= sbT.settingsTitle %></h2>
            <p class="settings-menu-subtitle"><%= sbT.settingsSubtitle %></p>
        </div>
    </div>

    <div class="settings-menu-body">
        <p class="settings-section-label"><%= sbT.preferencesLabel %></p>
        <section class="settings-group" aria-label="<%= sbT.preferencesLabel %>">
            <div class="settings-control-row">
                <div class="settings-control-copy">
                    <span class="settings-control-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
                    </span>
                    <span class="settings-control-text">
                        <span class="settings-control-title"><%= sbT.appearanceLabel %></span>
                        <span id="themeModeLabel" class="settings-control-subtitle" data-light-label="<%= sbT.lightModeLabel %>" data-dark-label="<%= sbT.darkModeLabel %>"><%= sbT.darkModeLabel %></span>
                    </span>
                </div>
                <button id="themeToggleBtn" type="button" onclick="toggleTheme(event)" class="settings-theme-switch cursor-pointer" role="switch" aria-checked="true" aria-label="<%= sbT.themeLabel %>">
                    <span id="themeThumb" class="settings-switch-thumb translate-x-0"></span>
                </button>
            </div>

            <div class="settings-control-block">
                <div class="settings-control-copy">
                    <span class="settings-control-icon">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20M12 2a15.3 15.3 0 0 0 0 20"></path></svg>
                    </span>
                    <span class="settings-control-title"><%= sbT.langLabel %></span>
                </div>
                <div class="settings-segmented" role="group" aria-label="<%= sbT.langLabel %>">
                    <button type="button" onclick="location.href=window.location.pathname + '?lang=en'" class="settings-segment-btn cursor-pointer <%= currentLang === 'en' ? 'is-active' : '' %>" aria-pressed="<%= currentLang === 'en' %>">EN</button>
                    <button type="button" onclick="location.href=window.location.pathname + '?lang=ar'" class="settings-segment-btn cursor-pointer <%= currentLang === 'ar' ? 'is-active' : '' %>" aria-pressed="<%= currentLang === 'ar' %>">AR</button>
                </div>
            </div>

            <div class="settings-control-block">
                <div class="settings-range-head">
                    <div class="settings-control-copy">
                        <span class="settings-control-icon">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"></path><circle cx="3" cy="6" r="1"></circle><circle cx="3" cy="12" r="1"></circle><circle cx="3" cy="18" r="1"></circle></svg>
                        </span>
                        <span class="settings-control-title"><%= sbT.rowsLabel %></span>
                    </div>
                    <span id="rowsPerPageValue" class="settings-range-value">25</span>
                </div>
                <input type="range" id="rowsPerPageSlider" min="1" max="200" value="25" class="settings-range" aria-label="<%= sbT.rowsLabel %>">
                <script>
                    (function() {
                        const slider = document.getElementById('rowsPerPageSlider');
                        const valSpan = document.getElementById('rowsPerPageValue');
                        if (slider) {
                            const saved = localStorage.getItem('cdrPerPage') || '25';
                            slider.value = saved;
                            if (valSpan) valSpan.textContent = saved;
                            slider.addEventListener('input', function() {
                                if (valSpan) valSpan.textContent = this.value;
                            });
                            slider.addEventListener('change', function() {
                                const val = this.value;
                                localStorage.setItem('cdrPerPage', val);
                                if (valSpan) valSpan.textContent = val;
                                if (window.location.pathname === '/cdr') {
                                    const url = new URL(window.location);
                                    url.searchParams.set('perPage', val);
                                    url.searchParams.set('page', '1');
                                    window.location.replace(url.toString());
                                }
                            });
                        }
                    })();
                </script>
            </div>
        </section>

        <p class="settings-section-label"><%= sbT.systemLabel %></p>
        <section class="settings-group" aria-label="<%= sbT.systemLabel %>">
            <% if (isSuper) { %>
            <button type="button" onclick="openSmtpModal()" class="settings-action cursor-pointer">
                <span class="settings-action-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg></span>
                <span class="settings-action-label"><%= sbT.smtpSettings %></span>
                <svg class="settings-action-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
            <% } %>
            <button type="button" onclick="openNetworkModal()" class="settings-action cursor-pointer">
                <span class="settings-action-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M8 9h8M8 15h8"></path><circle cx="8" cy="9" r=".5" fill="currentColor"></circle><circle cx="8" cy="15" r=".5" fill="currentColor"></circle></svg></span>
                <span class="settings-action-label"><%= sbT.netInfo %></span>
                <svg class="settings-action-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
            <% if (isSuper) { %>
            <button type="button" onclick="openTimeModal()" class="settings-action cursor-pointer">
                <span class="settings-action-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span>
                <span class="settings-action-label"><%= sbT.timeSettings %></span>
                <svg class="settings-action-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
            <button type="button" onclick="triggerDashboardUpdate()" id="updateDashboardBtn" class="settings-action cursor-pointer text-emerald-400 hover:text-emerald-300">
                <span class="settings-action-icon"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg></span>
                <span class="settings-action-label"><%= currentLang === 'ar' ? 'تحديث النظام (Update Dashboard)' : 'Update Dashboard' %></span>
                <svg class="settings-action-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
            </button>
            <% } %>
        </section>

        <a href="/logout" class="settings-signout">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="m16 17 5-5-5-5M21 12H9"></path></svg>
            <span><%= sbT.logoutLabel %></span>
        </a>
    </div>
</div>


<!-- Recording Upload Modal -->
<div id="recordingModal" class="fixed inset-0 z-[200] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 invisible transition-all duration-200" style="pointer-events:none">
    <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl shadow-2xl shadow-black/50 w-full max-w-md mx-4 overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--border-primary)]">
            <h3 class="text-sm font-black uppercase tracking-wider text-[var(--text-primary)]"><%= sbT.recTitle %></h3>
            <button onclick="closeRecordingModal()" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition p-1">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <form id="recordingForm" onsubmit="return submitRecording(event)" class="p-5 space-y-4">
            <div>
                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5"><%= sbT.recName %></label>
                <input type="text" id="recordingName" name="name" required placeholder="<%= sbT.recPlaceholder %>" class="w-full px-3 py-2 rounded-lg text-sm bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)] transition">
            </div>
            <div>
                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5"><%= sbT.recFile %></label>
                <div class="relative">
                    <input type="file" id="recordingFile" name="file" accept="audio/*,.mpeg,.mpg" required class="w-full text-xs text-[var(--text-secondary)] file:mr-3 rtl:file:mr-0 rtl:file:ml-3 file:py-1.5 file:px-3 file:rounded-lg file:border file:border-[var(--border-primary)] file:bg-[var(--bg-card)] file:text-xs file:font-bold file:text-[var(--text-primary)] hover:file:bg-[var(--bg-hover)] file:cursor-pointer file:transition cursor-pointer">
                </div>
                <p class="text-[10px] text-[var(--text-muted)] mt-1"><%= sbT.recNote %></p>
            </div>
            <!-- Progress Bar -->
            <div id="uploadProgressWrap" class="hidden space-y-1">
                <div class="flex justify-between text-[10px] font-semibold text-[var(--text-muted)]">
                    <span id="uploadStatus"><%= sbT.recUploadStatus %></span>
                    <span id="uploadPercent">0%</span>
                </div>
                <div class="w-full h-1.5 bg-[var(--bg-card)] rounded-full overflow-hidden">

<!-- Toast Notification -->
<div id="toastContainer" class="fixed bottom-5 z-[999999] flex flex-col gap-2 pointer-events-none <%= isRtl ? 'left-5' : 'right-5' %>" style="min-width:280px;max-width:420px"></div>

<div id="flashData" data-success="<%= typeof success !== 'undefined' ? success : '' %>" data-error="<%= typeof error !== 'undefined' ? error : '' %>" style="display:none"></div>

<style>
.success-msg, .error-msg { display: none !important; }
</style>

<script>
function openRecordingModal() {
    document.getElementById('recordingModal').classList.remove('opacity-0', 'invisible');
    document.getElementById('recordingModal').style.pointerEvents = 'auto';
    document.getElementById('settingsMenu').classList.remove('visible', 'opacity-100', 'scale-100');
    document.getElementById('settingsMenu').classList.add('invisible', 'opacity-0', 'scale-95');
    document.getElementById('settingsMenu').style.pointerEvents = 'none';
}

function closeRecordingModal() {
    document.getElementById('recordingModal').classList.add('opacity-0', 'invisible');
    document.getElementById('recordingModal').style.pointerEvents = 'none';
    document.getElementById('recordingForm').reset();
    document.getElementById('uploadProgressWrap').classList.add('hidden');
    document.getElementById('uploadProgressBar').style.width = '0%';
}

function showToast(msg, type) {
    var toastContainer = document.getElementById('toastContainer') || document.getElementById('toast-container');
    if (!toastContainer) return;
    var el = document.createElement('div');
    el.className = 'pointer-events-auto px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl shadow-black/40';
    var isRtl = document.documentElement.dir === 'rtl';
    var initialX = isRtl ? 'translateX(-120%)' : 'translateX(120%)';
    el.style.transform = initialX;
    el.style.opacity = '0';
    el.style.transition = 'all 0.3s';
    if (type === 'error') {
        el.style.backgroundColor = 'rgba(255,59,48,0.15)';
        el.style.border = '1px solid rgba(255,59,48,0.35)';
        el.style.color = '#ff6b6b';
    } else if (type === 'warning') {
        el.style.backgroundColor = 'rgba(245,158,11,0.15)';
        el.style.border = '1px solid rgba(245,158,11,0.35)';
        el.style.color = '#fbbf24';
    } else {
        el.style.backgroundColor = 'rgba(34,197,94,0.15)';
        el.style.border = '1px solid rgba(34,197,94,0.35)';
        el.style.color = '#4ade80';
    }
    el.textContent = msg;
    toastContainer.appendChild(el);
    requestAnimationFrame(function() {
        el.style.transform = 'translateX(0)';
        el.style.opacity = '1';
    });
    setTimeout(function() {
        el.style.transform = initialX;
        el.style.opacity = '0';
        setTimeout(function() { if (el && el.parentNode) el.parentNode.removeChild(el); }, 300);
    }, 5000);
}

const recWords = {
    uploading: "<%= sbT.recUploadStatus %>",
    complete: "<%= sbT.recComplete %>",
    failed: "<%= sbT.recFailed %>",
    selectFileErr: "<%= sbT.recSelectFileErr %>",
    nameErr: "<%= sbT.recNameErr %>",
    uploadBtn: "<%= sbT.recUpload %>"
};

async function submitRecording(event) {
    event.preventDefault();
    var fileInput = document.getElementById('recordingFile');
    var nameInput = document.getElementById('recordingName');
    var submitBtn = document.getElementById('recordingSubmitBtn');
    var progressWrap = document.getElementById('uploadProgressWrap');
    var progressBar = document.getElementById('uploadProgressBar');
    var progressPercent = document.getElementById('uploadPercent');
    var uploadStatus = document.getElementById('uploadStatus');

    if (!fileInput.files.length) { showToast(recWords.selectFileErr, 'error'); return; }
    if (!nameInput.value.trim()) { showToast(recWords.nameErr, 'error'); return; }

    submitBtn.disabled = true;
    submitBtn.textContent = recWords.uploading;
    progressWrap.classList.remove('hidden');

    var formData = new FormData();
    formData.append('file', fileInput.files[0]);
    formData.append('name', nameInput.value.trim());

    try {
        var xhr = new XMLHttpRequest();
        var result = await new Promise(function(resolve, reject) {
            xhr.upload.addEventListener('progress', function(e) {
                if (e.lengthComputable) {
                    var pct = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = pct + '%';
                    progressPercent.textContent = pct + '%';
                }
            });
            xhr.addEventListener('load', function() {
                if (xhr.status >= 200 && xhr.status < 300) {
                    resolve(JSON.parse(xhr.responseText));
                } else {
                    try { reject(JSON.parse(xhr.responseText)); }
                    catch(e) { reject({ error: recWords.failed + ' (HTTP ' + xhr.status + ')' }); }
                }
            });
            xhr.addEventListener('error', function() { reject({ error: 'Network error' }); });
            xhr.open('POST', '/api/settings/recordings/upload');
            xhr.send(formData);
        });

        progressBar.style.width = '100%';
        uploadStatus.textContent = recWords.complete;
        if (result.success) {
            showToast(result.message, 'success');
            setTimeout(closeRecordingModal, 1000);
        } else {
            showToast(result.error || recWords.failed, 'error');
        }
    } catch (err) {
        showToast(err.error || recWords.failed, 'error');
        uploadStatus.textContent = recWords.failed;
    } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = recWords.uploadBtn;
        setTimeout(function() {
            progressWrap.classList.add('hidden');
            progressBar.style.width = '0%';
        }, 3000);
    }
    return false;
}



document.addEventListener('DOMContentLoaded', function() {
    var toastContainer = document.getElementById('toastContainer');
    if (!toastContainer) return;

    var flash = document.getElementById('flashData');
    var msg = flash ? (flash.dataset.success || flash.dataset.error) : '';
    var type = flash && flash.dataset.error ? 'error' : 'success';
    if (!msg) return;

    function showToast(msg, type) {
        var el = document.createElement('div');
        el.className = 'pointer-events-auto px-5 py-3 rounded-xl text-sm font-semibold shadow-2xl shadow-black/40';
        el.style.transform = 'translateX(120%)';
        el.style.opacity = '0';
        el.style.transition = 'all 0.3s';
        if (type === 'error') {
            el.style.backgroundColor = 'rgba(255,59,48,0.15)';
            el.style.border = '1px solid rgba(255,59,48,0.35)';
            el.style.color = '#ff6b6b';
        } else if (type === 'warning') {
            el.style.backgroundColor = 'rgba(245,158,11,0.15)';
            el.style.border = '1px solid rgba(245,158,11,0.35)';
            el.style.color = '#fbbf24';
        } else {
            el.style.backgroundColor = 'rgba(34,197,94,0.15)';
            el.style.border = '1px solid rgba(34,197,94,0.35)';
            el.style.color = '#4ade80';
        }
        el.textContent = msg;
        toastContainer.appendChild(el);

        requestAnimationFrame(function() {
            el.style.transform = 'translateX(0)';
            el.style.opacity = '1';
        });

        setTimeout(function() {
            el.style.transform = 'translateX(120%)';
            el.style.opacity = '0';
            setTimeout(function() { if (el.parentNode) el.parentNode.removeChild(el); }, 300);
        }, 5000);
    }

    window.showToast = showToast;
    showToast(msg, type);
});
</script>

<script>

function openTimeModal() {
    document.getElementById('settingsMenu').classList.remove('visible', 'opacity-100', 'scale-100');
    document.getElementById('settingsMenu').classList.add('invisible', 'opacity-0', 'scale-95');
    document.getElementById('settingsMenu').style.pointerEvents = 'none';
    document.getElementById('timeModal').classList.remove('opacity-0', 'invisible');
    document.getElementById('timeModal').style.pointerEvents = 'auto';
    document.getElementById('timeModalFooter').style.display = 'none';
    document.getElementById('timeModalBody').innerHTML = '<div class="text-center py-8 text-[var(--text-muted)] text-xs"><svg class="animate-spin inline-block w-5 h-5 mr-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" stroke-dasharray="31.4 31.4" stroke-linecap="round"/></svg> <%= sbT.loadingTimezone %></div>';
    loadTimeSettings();
}

function closeTimeModal() {
    document.getElementById('timeModal').classList.add('opacity-0', 'invisible');
    document.getElementById('timeModal').style.pointerEvents = 'none';
}

async function loadTimeSettings() {
    try {
        const resp = await fetch('/api/settings/time');
        const data = await resp.json();
        if (!data.success) throw new Error(data.error);
        renderTimeModal(data);
    } catch (e) {
        document.getElementById('timeModalBody').innerHTML = '<div class="text-center text-red-400 text-sm py-8">Failed to load: ' + e.message + '</div>';
    }
}

let currentTimezone = '';
let currentNtp = false;

function renderTimeModal(data) {
    currentTimezone = data.timezone;
    currentNtp = data.ntpActive;

    var tzOptions = data.timezoneList.map(function(tz) {
        var sel = tz === data.timezone ? 'selected' : '';
        return '<option value="' + tz + '" ' + sel + '>' + tz + '</option>';
    }).join('');

    var ntpChecked = data.ntpActive ? 'checked' : '';
    var manualDisabled = data.ntpActive ? 'disabled' : '';

    var now = new Date(data.timestamp);
    var dateStr = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(now.getDate()).padStart(2,'0');
    var timeStr = String(now.getHours()).padStart(2,'0') + ':' + String(now.getMinutes()).padStart(2,'0');

    var html =
        '<div class="flex items-center justify-between p-3 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]">' +
            '<span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider"><%= sbT.currentTime %></span>' +
            '<span class="text-sm font-mono text-[var(--text-primary)] font-bold" id="timeDisplay">' + data.localTime + '</span>' +
        '</div>' +

        '<div>' +
            '<label class="block text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-1.5"><%= sbT.timezone %></label>' +
            '<div class="relative">' +
                '<input type="text" id="tzSearch" oninput="filterTimezones()" placeholder="<%= sbT.searchTimezone %>" class="w-full px-3 py-2 rounded-lg text-sm bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)] transition mb-1.5">' +
                '<select id="timezoneSelect" size="6" class="w-full px-2 py-1 rounded-lg text-sm bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] focus:outline-none focus:border-[var(--accent-color)] transition" style="scrollbar-width:thin">' + tzOptions + '</select>' +
            '</div>' +
        '</div>' +

        '<div class="flex items-center justify-between p-3 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]">' +
            '<div>' +
                '<span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider"><%= sbT.ntpSync %></span>' +
                '<p class="text-[10px] text-[var(--text-muted)] mt-0.5">' + (data.ntpActive ? 'Active' : 'Inactive') + '</p>' +
            '</div>' +
            '<label class="relative inline-flex items-center cursor-pointer">' +
                '<input type="checkbox" id="ntpToggle" onchange="onNtpToggle()" class="sr-only peer" ' + ntpChecked + '>' +
                '<div class="w-9 h-5 rounded-full bg-[var(--bg-card)] border border-[var(--border-primary)] peer-checked:bg-[var(--accent-color)]/40 peer-checked:border-[var(--accent-color)] transition after:content-[\'\'] after:absolute after:top-0.5 after:left-0.5 after:w-3.5 after:h-3.5 after:rounded-full after:bg-[var(--text-secondary)] after:transition-all peer-checked:after:translate-x-full peer-checked:after:bg-white"></div>' +
            '</label>' +
        '</div>' +

        '<div id="manualTimeSection" class="space-y-3 p-3 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] ' + (data.ntpActive ? 'opacity-40' : '') + '">' +
            '<span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider"><%= sbT.setManually %></span>' +
            '<div class="flex gap-3">' +
                '<div class="flex-1">' +
                    '<label class="block text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-1"><%= sbT.dateLabel %></label>' +
                    '<input type="date" id="manualDate" value="' + dateStr + '" ' + manualDisabled + ' class="w-full px-3 py-2 rounded-lg text-sm bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] focus:outline-none focus:border-[var(--accent-color)] transition">' +
                '</div>' +
                '<div class="flex-1">' +
                    '<label class="block text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider mb-1"><%= sbT.timeLabel %></label>' +
                    '<input type="time" id="manualTime" value="' + timeStr + '" ' + manualDisabled + ' class="w-full px-3 py-2 rounded-lg text-sm bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] focus:outline-none focus:border-[var(--accent-color)] transition">' +
                '</div>' +
            '</div>' +
        '</div>';

    document.getElementById('timeModalBody').innerHTML = html;
    document.getElementById('timeModalFooter').style.display = 'flex';
}

function filterTimezones() {
    var query = document.getElementById('tzSearch').value.toLowerCase();
    var select = document.getElementById('timezoneSelect');
    var options = select.options;
    for (var i = 0; i < options.length; i++) {
        var text = options[i].text.toLowerCase();
        options[i].style.display = text.indexOf(query) > -1 ? '' : 'none';
    }
    // Select first visible
    for (var i = 0; i < options.length; i++) {
        if (options[i].style.display !== 'none') {
            select.value = options[i].value;
            break;
        }
    }
}

function onNtpToggle() {
    var ntpOn = document.getElementById('ntpToggle').checked;
    document.getElementById('manualDate').disabled = ntpOn;
    document.getElementById('manualTime').disabled = ntpOn;
    document.getElementById('manualTimeSection').style.opacity = ntpOn ? '0.4' : '1';
}

async function saveTimeSettings() {
    var btn = document.getElementById('timeSaveBtn');
    var origText = btn.textContent;
    btn.textContent = '<%= sbT.saving %>';
    btn.disabled = true;

    var body = {};
    var tzSelect = document.getElementById('timezoneSelect');
    if (tzSelect) {
        var newTz = tzSelect.value;
        if (newTz !== currentTimezone) body.timezone = newTz;
    }

    var ntpCheckbox = document.getElementById('ntpToggle');
    var newNtp = ntpCheckbox ? ntpCheckbox.checked : currentNtp;
    if (newNtp !== currentNtp) body.ntp = newNtp;

    var ntpIsOrBecomingOff = (body.ntp === false) || (body.ntp === undefined && !currentNtp);
    if (ntpIsOrBecomingOff) {
        var manualDate = document.getElementById('manualDate');
        var manualTime = document.getElementById('manualTime');
        if (manualDate && manualTime) {
            body.manualDate = manualDate.value;
            body.manualTime = manualTime.value;
        }
    }

    if (Object.keys(body).length === 0) {
        btn.textContent = origText;
        btn.disabled = false;
        closeTimeModal();
        return;
    }

    try {
        var resp = await fetch('/api/settings/time', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        var data = await resp.json();
        btn.textContent = origText;
        btn.disabled = false;
        if (data.success) {
            if (typeof window.showToast === 'function') window.showToast('<%= sbT.savedSuccess %>', 'success');
            closeTimeModal();
        } else {
            if (typeof window.showToast === 'function') window.showToast(data.error || '<%= sbT.saveFailed %>', 'error');
        }
    } catch (e) {
        btn.textContent = origText;
        btn.disabled = false;
        if (typeof window.showToast === 'function') window.showToast('<%= sbT.saveFailed %>', 'error');
    }
}

function copyAddr(btn) {
    var span = btn.parentElement.querySelector('span.font-mono');
    if (!span) return;
    var text = span.textContent.trim();
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(function(){});
    }
    var range = document.createRange();
    range.selectNodeContents(span);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
    var orig = btn.innerHTML;
    btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>';
    setTimeout(function() { btn.innerHTML = orig; }, 1500);
}

function addrRow(label, value) {
    var copySvg = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    return '<div class="flex items-center gap-2 text-xs text-[var(--text-muted)] pl-5 py-1">' +
        '<span class="text-[11px] uppercase tracking-wider font-bold text-[var(--text-muted)]">' + label + ':</span>' +
        '<span class="text-sm font-mono text-[var(--text-secondary)] tracking-tight">' + value + '</span>' +
        '<button onclick="copyAddr(this)" class="ml-auto p-0.5 rounded hover:bg-[var(--bg-hover)] transition cursor-pointer opacity-40 hover:opacity-100" title="Copy ' + label + '">' + copySvg + '</button></div>';
}

function openSmtpModal() {
    document.getElementById('settingsMenu').classList.remove('visible', 'opacity-100', 'scale-100');
    document.getElementById('settingsMenu').classList.add('invisible', 'opacity-0', 'scale-95');
    document.getElementById('settingsMenu').style.pointerEvents = 'none';
    document.getElementById('smtpModal').classList.remove('opacity-0', 'invisible');
    document.getElementById('smtpModal').style.pointerEvents = 'auto';
    loadSmtpSettings();
}

function closeSmtpModal() {
    document.getElementById('smtpModal').classList.add('opacity-0', 'invisible');
    document.getElementById('smtpModal').style.pointerEvents = 'none';
}

async function loadSmtpSettings() {
    try {
        const resp = await fetch('/api/settings/smtp');
        const data = await resp.json();
        if (data.success) {
            if (data.email) {
                document.getElementById('smtpEmail').value = data.email;
            }
            if (data.hasPassword) {
                document.getElementById('smtpPassword').placeholder = '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022 (Saved)';
                document.getElementById('smtpPassword').value = '';
                document.getElementById('smtpPassword').required = false;
            } else {
                document.getElementById('smtpPassword').placeholder = 'App Password';
                document.getElementById('smtpPassword').required = true;
            }
        }
    } catch (e) {
        console.error('Failed to load SMTP settings:', e);
    }
}

async function saveSmtpSettings(event) {
    event.preventDefault();
    const email = document.getElementById('smtpEmail').value;
    const password = document.getElementById('smtpPassword').value;
    const msgEl = document.getElementById('smtpStatusMsg');
    
    msgEl.classList.remove('hidden');
    msgEl.className = 'text-xs text-zinc-400 text-center';
    msgEl.textContent = 'Saving...';
    
    try {
        const resp = await fetch('/api/settings/smtp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
        });
        const data = await resp.json();
        if (data.success) {
            msgEl.className = 'text-xs text-green-400 text-center';
            msgEl.textContent = 'Saved successfully!';
            document.getElementById('smtpPassword').value = '';
            document.getElementById('smtpPassword').placeholder = '\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022 (Saved)';
            document.getElementById('smtpPassword').required = false;
            if (typeof window.showToast === 'function') {
                window.showToast('SMTP settings saved', 'success');
            }
            setTimeout(closeSmtpModal, 1200);
        } else {
            msgEl.className = 'text-xs text-red-400 text-center';
            msgEl.textContent = data.error || 'Failed to save settings.';
        }
    } catch (e) {
        msgEl.className = 'text-xs text-red-400 text-center';
        msgEl.textContent = 'Error saving settings.';
    }
}

function openNetworkModal() {
    document.getElementById('networkModal').classList.remove('opacity-0', 'invisible');
    document.getElementById('networkModal').style.pointerEvents = 'auto';
    document.getElementById('settingsMenu').classList.remove('visible', 'opacity-100', 'scale-100');
    document.getElementById('settingsMenu').classList.add('invisible', 'opacity-0', 'scale-95');
    document.getElementById('settingsMenu').style.pointerEvents = 'none';
    loadNetworkInfo();
}

function closeNetworkModal() {
    document.getElementById('networkModal').classList.add('opacity-0', 'invisible');
    document.getElementById('networkModal').style.pointerEvents = 'none';
}
function triggerDashboardUpdate() {
    if (!confirm('<%= currentLang === "ar" ? "هل أنت متأكد من تحديث النظام لأحدث إصدار؟" : "Are you sure you want to update Sokrat VoIP to the latest version?" %>')) return;
    
    document.getElementById('settingsMenu').classList.remove('visible', 'opacity-100', 'scale-100');
    document.getElementById('settingsMenu').classList.add('invisible', 'opacity-0', 'scale-95');
    document.getElementById('settingsMenu').style.pointerEvents = 'none';

    fetch('/api/system/update', { method: 'POST' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                alert(data.message || 'Update initiated successfully. Reloading page in 5 seconds...');
                setTimeout(() => {
                    window.location.reload();
                }, 5000);
            } else {
                alert(data.error || 'Failed to trigger update');
            }
        })
        .catch(err => {
            alert('Update started. Reloading page in 5 seconds...');
            setTimeout(() => {
                window.location.reload();
            }, 5000);
        });
}

async function loadNetworkInfo() {
    var container = document.getElementById('networkInfoContent');
    try {
        var resp = await fetch('/api/network-info');
        var data = await resp.json();
        if (!data.success) throw new Error(data.error);
        if (!data.interfaces || data.interfaces.length === 0) {
            container.innerHTML = '<div class="text-center text-[var(--text-muted)] text-sm py-8">No network interfaces found</div>';
            return;
        }
        var html = '';
        if (data.gateway) {
            html += '<div class="flex items-center gap-2.5 px-3 py-2.5 mb-3 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]">';
            html += '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--accent-color)" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>';
            html += '<span class="text-[11px] font-bold text-[var(--text-muted)] uppercase tracking-wider">Gateway:</span>';
            html += '<span class="text-sm font-mono text-[var(--text-primary)] tracking-tight">' + data.gateway + '</span>';
            html += '<button onclick="copyAddr(this)" class="ml-auto p-0.5 rounded hover:bg-[var(--bg-hover)] transition cursor-pointer opacity-40 hover:opacity-100" title="Copy gateway"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg></button></div>';
        }
        html += '<div class="space-y-2.5">';
        for (var i = 0; i < data.interfaces.length; i++) {
            var iface = data.interfaces[i];
            html += '<div class="px-3 py-3 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)]">';
            html += '<div class="flex items-center justify-between mb-2">';
            html += '<div class="flex items-center gap-2.5">';
            html += '<span class="w-2.5 h-2.5 rounded-full z-10 ' + (iface.state === 'up' ? 'bg-green-400' : 'bg-red-400') + '"></span>';
            html += '<span class="text-sm font-bold text-[var(--text-primary)] font-mono">' + iface.name + '</span>';
            html += '<span class="text-[11px] ' + (iface.state === 'up' ? 'text-green-400' : 'text-red-400') + ' uppercase font-bold">' + iface.state + '</span>';
            html += '</div></div>';
            if (iface.mac) html += addrRow('MAC', iface.mac);
            if (iface.ip4) html += addrRow('IPv4', iface.ip4);
            if (iface.ip6) html += addrRow('IPv6', iface.ip6);
            html += '</div>';
        }
        html += '</div>';
        container.innerHTML = html;
    } catch (e) {
        container.innerHTML = '<div class="text-center text-red-400 text-sm py-8">Failed to load network info: ' + e.message + '</div>';
    }
}

window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeNetworkModal();
        if (typeof closeTimeModal === 'function') closeTimeModal();
        if (typeof closeRecordingModal === 'function') closeRecordingModal();
    }
});
</script>


<script>
// Custom Theme-Matched Select Enhancer (replaces OS blue highlight picker)
function enhanceSelectElements() {
    document.querySelectorAll('select:not(.enhanced-select):not(.no-enhance):not(.flatpickr-monthDropdown-months)').forEach(select => {
        select.classList.add('enhanced-select');
        
        const wrapper = document.createElement('div');
        wrapper.className = 'custom-select-wrapper relative inline-block w-full';
        if (select.parentNode) {
            select.parentNode.insertBefore(wrapper, select);
            wrapper.appendChild(select);
        }
        
        select.style.position = 'absolute';
        select.style.opacity = '0';
        select.style.width = '1px';
        select.style.height = '1px';
        select.style.padding = '0';
        select.style.margin = '0';
        select.style.border = 'none';
        select.style.clip = 'rect(0,0,0,0)';
        select.style.pointerEvents = 'none';

        select.addEventListener('invalid', () => {
            trigger.classList.add('border-red-500', 'ring-2', 'ring-red-500/50');
            trigger.focus();
        });
        
        const trigger = document.createElement('button');
        trigger.type = 'button';
        trigger.setAttribute('aria-haspopup', 'listbox');
        trigger.setAttribute('aria-expanded', 'false');
        trigger.className = 'custom-select-trigger w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-3 py-2 text-xs font-mono text-[var(--text-primary)] flex items-center justify-between cursor-pointer select-none transition hover:border-[var(--border-accent)]';
        
        const labelSpan = document.createElement('span');
        labelSpan.className = 'truncate';
        const selectedOpt = select.options[select.selectedIndex] || select.options[0];
        labelSpan.textContent = selectedOpt ? selectedOpt.textContent : '';
        
        const arrowSvg = document.createElement('div');
        arrowSvg.innerHTML = `<svg class="w-3.5 h-3.5 text-zinc-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>`;
        
        trigger.appendChild(labelSpan);
        trigger.appendChild(arrowSvg.firstChild);
        wrapper.appendChild(trigger);
        
        const menu = document.createElement('div');
        menu.className = 'custom-select-menu fixed bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-xl shadow-2xl z-[999999] max-h-60 overflow-y-auto hidden no-scrollbar p-1 space-y-0.5';
        document.body.appendChild(menu);
        
        function positionMenuFixed() {
            const rect = trigger.getBoundingClientRect();
            const width = Math.min(Math.max(rect.width, 280), window.innerWidth - 16);
            menu.style.width = width + 'px';

            let left = rect.left;
            if (left + width > window.innerWidth - 8) {
                left = window.innerWidth - width - 8;
            }
            if (left < 8) left = 8;
            
            menu.style.left = left + 'px';
            const spaceBelow = window.innerHeight - rect.bottom;
            const spaceAbove = rect.top;
            const menuEstHeight = Math.min(select.options.length * 36 + 12, 240);
            
            if (spaceBelow < menuEstHeight && spaceAbove > spaceBelow) {
                menu.style.top = 'auto';
                menu.style.bottom = (window.innerHeight - rect.top + 4) + 'px';
            } else {
                menu.style.top = (rect.bottom + 4) + 'px';
                menu.style.bottom = 'auto';
            }
        }
        
        function buildOptions() {
            menu.innerHTML = '';
            Array.from(select.options).forEach((opt, idx) => {
                if (opt.disabled && opt.hidden) return;
                const item = document.createElement('div');
                const isSelected = select.selectedIndex === idx;
                item.className = `custom-select-option px-3 py-2 text-xs font-mono rounded-lg cursor-pointer transition-colors flex items-center justify-between ${isSelected ? 'is-selected font-bold' : ''}`;
                item.setAttribute('role', 'option');
                item.setAttribute('aria-selected', String(isSelected));
                item.textContent = opt.textContent;
                item.addEventListener('click', (e) => {
                    e.stopPropagation();
                    select.selectedIndex = idx;
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                    syncState();
                    menu.classList.add('hidden');
                    trigger.setAttribute('aria-expanded', 'false');
                    trigger.classList.remove('border-[var(--accent-color)]');
                    buildOptions();
                });
                menu.appendChild(item);
            });
        }
        buildOptions();
        
        
        function syncState() {
            const isDisabled = select.disabled || select.hasAttribute('disabled');
            trigger.disabled = isDisabled;
            trigger.setAttribute('aria-disabled', String(isDisabled));
            if (isDisabled) {
                trigger.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                trigger.setAttribute('aria-expanded', 'false');
                menu.classList.add('hidden');
            } else {
                trigger.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
            }
            const selectedOpt = select.options[select.selectedIndex] || select.options[0];
            if (selectedOpt) labelSpan.textContent = selectedOpt.textContent;
        }

        select.addEventListener('change', () => {
            trigger.classList.remove('border-red-500', 'ring-2', 'ring-red-500/50');
            syncState();
        });
        try {
            const observer = new MutationObserver(syncState);
            observer.observe(select, { attributes: true, attributeFilter: ['disabled'] });
        } catch(_) {}
        syncState();
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            syncState();
            if (select.disabled || select.hasAttribute('disabled')) return;
            
            const isOpening = menu.classList.contains('hidden');
            
            document.querySelectorAll('.custom-select-menu').forEach(m => {
                if (m !== menu) m.classList.add('hidden');
            });
            document.querySelectorAll('.custom-select-trigger').forEach(t => {
                if (t !== trigger) t.setAttribute('aria-expanded', 'false');
            });
            
            if (isOpening) {
                buildOptions();
                positionMenuFixed();
                menu.classList.remove('hidden');
                trigger.setAttribute('aria-expanded', 'true');
                trigger.classList.add('border-[var(--accent-color)]');
            } else {
                menu.classList.add('hidden');
                trigger.setAttribute('aria-expanded', 'false');
                trigger.classList.remove('border-[var(--accent-color)]');
            }
        });
    });
}

document.addEventListener('DOMContentLoaded', function() {
    setTimeout(enhanceSelectElements, 150);
});
document.addEventListener('click', function() {
    document.querySelectorAll('.custom-select-menu').forEach(m => m.classList.add('hidden'));
    document.querySelectorAll('.custom-select-trigger').forEach(t => t.setAttribute('aria-expanded', 'false'));
});
window.addEventListener('scroll', function() {
    document.querySelectorAll('.custom-select-menu').forEach(m => m.classList.add('hidden'));
    document.querySelectorAll('.custom-select-trigger').forEach(t => t.setAttribute('aria-expanded', 'false'));
}, true);
window.addEventListener('resize', function() {
    document.querySelectorAll('.custom-select-menu').forEach(m => m.classList.add('hidden'));
    document.querySelectorAll('.custom-select-trigger').forEach(t => t.setAttribute('aria-expanded', 'false'));
});

// ─── Floating Softphone Widget (Disabled / Commented out for later) ───
(function(){
    return; // Disabled for later work
    var root = document.createElement('div');
    root.id = 'spwRoot';
    // Collapsed dot (shows status color)
    // Expanded panel with dialpad + call controls
    root.innerHTML = ''
        + '<div id="spwDotBtn" onclick="spwToggle()" class="fixed bottom-6 right-6 z-[9999] w-14 h-14 rounded-full shadow-xl flex items-center justify-center cursor-pointer transition-all duration-200 hover:scale-110 border-2" style="background:var(--bg-card,#1e293b);border-color:var(--border-primary,#334155)">'
        + '<span id="spwDot" class="w-4 h-4 rounded-full bg-zinc-500 transition-colors"></span>'
        + '</div>'
        + '<div id="spwPanel" class="fixed bottom-24 right-6 z-[9999] hidden rounded-2xl shadow-2xl overflow-hidden border" style="background:var(--bg-secondary,#0f172a);border-color:var(--border-primary,#334155);width:280px">'
        /* Header */
        + '<div class="flex items-center justify-between px-4 py-3 border-b" style="border-color:var(--border-primary,#334155)">'
        + '<div class="flex items-center gap-2">'
        + '<span id="spwPnlDot" class="w-2.5 h-2.5 rounded-full bg-zinc-500"></span>'
        + '<span id="spwPnlStatus" class="text-xs font-bold" style="color:var(--text-primary,#f1f5f9)">Offline</span>'
        + '</div>'
        + '<button onclick="spwToggle()" class="text-lg leading-none" style="color:var(--text-muted,#64748b)">×</button>'
        + '</div>'
        /* Active Call Banner */
        + '<div id="spwCallBanner" class="hidden p-3 m-3 rounded-xl text-center" style="background:rgba(124,58,237,0.15);border:1px solid rgba(124,58,237,0.3)">'
        + '<div id="spwCallState" class="text-xs mb-1 font-bold" style="color:var(--text-muted,#94a3b8)"></div>'
        + '<div id="spwCallerDisplay" class="font-mono text-sm font-black" style="color:var(--text-primary,#f1f5f9)"></div>'
        + '<div class="flex gap-2 justify-center mt-2">'
        + '<button id="spwAnswerBtn" onclick="spwCmd(\'answer\')" class="hidden px-6 py-2 rounded-xl font-bold text-white text-xs" style="background:#059669">Answer</button>'
        + '<button id="spwHangupBtn" onclick="spwCmd(\'hangup\')" class="hidden px-6 py-2 rounded-xl font-bold text-white text-xs" style="background:#dc2626">Hang Up</button>'
        + '</div>'
        + '</div>'
        /* Dialpad */
        + '<div id="spwDialpad" class="px-3 pb-3">'
        + '<div class="flex gap-2 mb-2">'
        + '<input id="spwDtmf" type="tel" placeholder="Enter number" class="flex-1 px-3 py-2 rounded-xl border text-sm font-mono" style="background:var(--bg-primary,#0f172a);border-color:var(--border-primary,#334155);color:var(--text-primary,#f1f5f9)" onkeydown="if(event.key===\'Enter\')spwCmd(\'dial\')">'
        + '<button id="spwCallBtn" onclick="spwCmd(\'dial\')" class="px-4 py-2 rounded-xl font-extrabold text-white text-xs" style="background:#059669">Call</button>'
        + '</div>'
        + '<div class="grid grid-cols-3 gap-1.5">'
        + '123456789*0#'.split('').map(function(d){return '<button onclick="spwDtmfTap(\''+d+'\')" class="py-2.5 rounded-lg font-bold text-sm" style="background:var(--bg-tertiary,#1e293b);color:var(--text-primary,#f1f5f9)">'+d+'</button>';}).join('')
        + '</div>'
        + '</div>'
        /* Footer: open softphone link */
        + '<div class="px-4 pb-3 text-center">'
        + '<button onclick="spwOpenSoftphone()" class="text-xs font-bold" style="color:var(--text-muted,#64748b)">Open full softphone →</button>'
        + '</div>'
        + '</div>';
    document.body.appendChild(root);

    /* BroadcastChannel for popup communication */
    var bc;
    try { bc = new BroadcastChannel('sokrat-softphone'); } catch(e){}

    var spwState = { status: 'offline', activeCall: false, lastHeartbeat: 0 };

    /* Heartbeat stale check: only for command gate, NOT for UI status */
    /* UI status comes from explicit status/ callStarted/ callEnded broadcasts */
    setInterval(function(){
        if (spwState.lastHeartbeat && Date.now() - spwState.lastHeartbeat > 15000) {
            // Don't change spwState.status to offline — keep last known status
            // Just flag that popup may be unresponsive (used by spwCmd)
        }
    }, 15000);

    function spwUpdateUI() {
        var s = spwState.status;
        var dot = document.getElementById('spwDot');
        var pnlDot = document.getElementById('spwPnlDot');
        var pnlStatus = document.getElementById('spwPnlStatus');
        var colors = {online:'#10b981',offline:'#71717a',ringing:'#f59e0b',incall:'#a855f7',registering:'#3b82f6'};
        var labels = {online:'Online',offline:'Offline',ringing:'Ringing...',incall:'In Call',registering:'Connecting...'};
        var c = colors[s] || '#71717a';
        if (dot) dot.style.background = c;
        if (pnlDot) pnlDot.style.background = c;
        if (pnlStatus) pnlStatus.textContent = labels[s] || 'Offline';

        /* Show call banner when active */
        var banner = document.getElementById('spwCallBanner');
        var answerBtn = document.getElementById('spwAnswerBtn');
        var hangupBtn = document.getElementById('spwHangupBtn');
        var callState = document.getElementById('spwCallState');
        var callerDisp = document.getElementById('spwCallerDisplay');
        if (!banner) return;

        if (s === 'ringing' && spwState.incomingCaller) {
            banner.classList.remove('hidden');
            answerBtn.classList.remove('hidden');
            hangupBtn.classList.remove('hidden');
            if (callState) callState.textContent = 'Incoming Call';
            if (callerDisp) callerDisp.textContent = spwState.incomingCaller;
        } else if (s === 'incall' && spwState.remoteParty) {
            banner.classList.remove('hidden');
            answerBtn.classList.add('hidden');
            hangupBtn.classList.remove('hidden');
            if (callState) callState.textContent = spwState.callState || 'Call with';
            if (callerDisp) callerDisp.textContent = spwState.remoteParty;
        } else {
            banner.classList.add('hidden');
            answerBtn.classList.add('hidden');
            hangupBtn.classList.add('hidden');
            spwState.incomingCaller = null;
        }
    }

    window.spwToggle = function() {
        var panel = document.getElementById('spwPanel');
        var dotBtn = document.getElementById('spwDotBtn');
        if (!panel) return;
        var open = !panel.classList.contains('hidden');
        panel.classList.toggle('hidden', open);
        dotBtn.classList.toggle('hidden', !open);
        if (open) { spwUpdateUI(); }
    };

    window.spwCmd = function(cmd) {
        if (!bc || !spwState.lastHeartbeat || Date.now() - spwState.lastHeartbeat > 15000) {
            spwOpenSoftphone();
            return;
        }
        if (cmd === 'dial' || cmd === 'answer') {
            // Only proceed if SIP is registered
            var readyStates = {online:1, incall:1, ringing:1};
            if (!readyStates[spwState.status]) {
                spwOpenSoftphone();
                return;
            }
        }
        var inp = document.getElementById('spwDtmf');
        if (cmd === 'dial') {
            var num = inp ? inp.value.trim().replace(/[^0-9*#+]/g,'') : '';
            if (!num) return;
            bc.postMessage({type:'dial', number: num});
            inp.value = '';
        } else if (cmd === 'answer') {
            bc.postMessage({type:'answer'});
        } else if (cmd === 'hangup') {
            bc.postMessage({type:'hangup'});
        }
    };

    window.spwDtmfTap = function(d) {
        var inp = document.getElementById('spwDtmf');
        if (inp) inp.value += d;
    };

    window.spwOpenSoftphone = function() {
        spwToggle();
        var w = window.open('/softphone', 'sokratSoftphone', 'width=450,height=700,scrollbars=0');
        if (!w) { window.location.href = '/softphone'; }
    };

    /* Listen for BroadcastChannel messages from softphone */
    if (bc) {
        bc.onmessage = function(e) {
            var d = e.data || {};
            if (d.type === 'heartbeat') {
                spwState.lastHeartbeat = Date.now();
            }
            if (d.type === 'status') {
                spwState.status = d.status;
                spwUpdateUI();
            }
            if (d.type === 'incoming') {
                spwState.status = 'ringing';
                spwState.incomingCaller = d.caller || 'Unknown';
                spwState.remoteParty = null;
                spwUpdateUI();
                showFullScreenCallModal(d.caller || 'Unknown');
            }
            if (d.type === 'callStarted') {
                spwState.status = 'incall';
                spwState.callState = 'In Call';
                spwState.remoteParty = d.remote || 'Connected';
                spwState.incomingCaller = null;
                spwUpdateUI();
                hideFullScreenCallModal();
            }
            if (d.type === 'callProgress') {
                spwState.status = 'incall';
                spwState.callState = 'Calling';
                spwState.remoteParty = d.remote || 'Dialing';
                spwState.incomingCaller = null;
                spwUpdateUI();
            }
            if (d.type === 'callEnded') {
                spwState.status = 'online';
                spwState.remoteParty = null;
                spwState.incomingCaller = null;
                spwUpdateUI();
                hideFullScreenCallModal();
            }
        };
        setTimeout(function(){ bc.postMessage({type:'requestStatus'}); }, 200);
    }

    /* Hide widget on softphone page itself */
    if (location.pathname === '/softphone' || location.pathname === '/softphone/') {
        root.style.display = 'none';
    }
})();
</script>
<!-- Full-Screen Incoming Call Overlay Modal -->
<div id="fullScreenCallModal" class="fixed inset-0 z-[999999] flex items-center justify-center bg-black/85 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300">
    <div class="relative w-full max-w-md mx-4 p-8 rounded-3xl bg-[#121215] border border-white/10 shadow-2xl text-center flex flex-col items-center overflow-hidden">
        <!-- Animated Ringing Aura -->
        <div class="absolute -top-24 -left-24 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-purple-500/15 rounded-full blur-3xl animate-pulse"></div>

        <!-- Incoming Call Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-extrabold uppercase tracking-widest mb-6">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
            <span id="callModalBadge"><%= isRtl ? 'مكالمة واردة' : 'Incoming Call' %></span>
        </div>

        <!-- Large Ringing Icon Avatar -->
        <div class="relative mb-6">
            <div class="absolute -inset-4 rounded-full bg-emerald-500/20 animate-ping opacity-75"></div>
            <div class="relative w-24 h-24 rounded-full bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center shadow-2xl shadow-emerald-500/40 border-2 border-white/20">
                <svg class="w-12 h-12 text-white animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
            </div>
        </div>

        <!-- Caller Info -->
        <h2 id="callModalCallerName" class="text-2xl font-black text-white tracking-tight font-mono mb-1">Unknown</h2>
        <p id="callModalCallerSub" class="text-xs font-semibold text-[var(--text-muted)] mb-8"><%= isRtl ? 'مكالمة صوتية واردة' : 'Incoming Audio Call' %></p>

        <!-- Action Buttons -->
        <div class="flex items-center justify-center gap-4 w-full">
            <!-- Decline Button -->
            <button type="button" onclick="handleCallModalDecline(event)" class="flex-1 py-4 px-6 rounded-2xl bg-rose-600 hover:bg-rose-500 text-white font-extrabold text-sm flex items-center justify-center gap-2 transition cursor-pointer shadow-lg shadow-rose-600/30 active:scale-95">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <span><%= isRtl ? 'رفض' : 'Decline' %></span>
            </button>

            <!-- Answer Button -->
            <button type="button" onclick="handleCallModalAnswer(event)" class="flex-1 py-4 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-sm flex items-center justify-center gap-2 transition cursor-pointer shadow-lg shadow-emerald-600/30 active:scale-95">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span><%= isRtl ? 'رد' : 'Answer' %></span>
            </button>
        </div>
    </div>
</div>

<script>
    window.showFullScreenCallModal = function(callerName) {
        const modal = document.getElementById('fullScreenCallModal');
        const nameEl = document.getElementById('callModalCallerName');
        if (nameEl && callerName) nameEl.textContent = callerName;
        if (modal) {
            modal.style.display = 'flex';
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');
        }
    };

    window.hideFullScreenCallModal = function() {
        const modal = document.getElementById('fullScreenCallModal');
        if (modal) {
            modal.classList.remove('opacity-100', 'pointer-events-auto');
            modal.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(function() {
                if (modal.classList.contains('opacity-0')) {
                    modal.style.display = 'none';
                }
            }, 300);
        }
    };

    window.handleCallModalAnswer = function(e) {
        if (e) { e.preventDefault(); e.stopPropagation(); }
        hideFullScreenCallModal();
        if (typeof window.answerCall === 'function') {
            window.answerCall();
        } else if (typeof answerCall === 'function') {
            answerCall();
        } else {
            try {
                if (!window._spwBc) window._spwBc = new BroadcastChannel('sokrat-softphone');
                window._spwBc.postMessage({ type: 'answer' });
            } catch (_) {}
        }
    };

    window.handleCallModalDecline = function(e) {
        if (e) { e.preventDefault(); e.stopPropagation(); }
        hideFullScreenCallModal();
        if (typeof window.hangupCall === 'function') {
            window.hangupCall();
        } else if (typeof hangupCall === 'function') {
            hangupCall();
        } else {
            try {
                if (!window._spwBc) window._spwBc = new BroadcastChannel('sokrat-softphone');
                window._spwBc.postMessage({ type: 'hangup' });
            } catch (_) {}
        }
    };
</script>

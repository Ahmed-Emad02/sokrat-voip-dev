<!-- Prevent theme/JIT flickering loading screen overlay -->
<style>
    @keyframes smoothBarMove {
        0% { transform: translateX(-100%); }
        50% { transform: translateX(35%); }
        100% { transform: translateX(100%); }
    }
    .smooth-loading-fill {
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent 0%, #dc2626 30%, #ef4444 50%, #dc2626 70%, transparent 100%);
        border-radius: 9999px;
        animation: smoothBarMove 1.2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        box-shadow: 0 0 12px rgba(220, 38, 38, 0.8);
    }
</style>
<div id="theme-loading-overlay" class="fixed inset-0 z-[999999] flex flex-col items-center justify-center bg-[#050507] transition-all duration-300 pointer-events-none overflow-hidden">
    <div class="flex flex-col items-center justify-center gap-6">
        <img id="loadingLogo" src="/logo_light_text.png" alt="Sokrat VOIP" class="w-44 h-44 object-contain transition-all duration-300">
        <div class="w-52 h-1 bg-zinc-800/80 rounded-full overflow-hidden relative">
            <div class="smooth-loading-fill"></div>
        </div>
    </div>
</div>
<script>
    (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        const collapsed = localStorage.getItem('sidebar_collapsed') === 'true';
        if (collapsed) {
            document.documentElement.classList.add('sidebar-collapsed');
        } else {
            document.documentElement.classList.remove('sidebar-collapsed');
        }
        const overlay = document.getElementById('theme-loading-overlay');
        const logo = document.getElementById('loadingLogo');
        if (theme === 'light') {
            document.documentElement.classList.add('light-theme');
            if (overlay) overlay.style.backgroundColor = '#f9fafb';
            if (logo) logo.src = '/logo.png';
        } else {
            document.documentElement.classList.remove('light-theme');
            if (overlay) overlay.style.backgroundColor = '#050507';
            if (logo) logo.src = '/logo_light_text.png';
        }
    })();

    function dismissLoadingOverlay() {
        const overlay = document.getElementById('theme-loading-overlay');
        if (!overlay) return;
        overlay.style.opacity = '0';
        overlay.style.transform = 'translateY(-100%)';
        setTimeout(() => { if (overlay && overlay.parentNode) overlay.parentNode.removeChild(overlay); }, 300);
    }

    window.addEventListener('load', function() {
        setTimeout(dismissLoadingOverlay, 100);
    });
    setTimeout(dismissLoadingOverlay, 600); // Fail-safe auto close
</script>


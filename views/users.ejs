<% const isRtl = currentLang === 'ar'; %>
<!DOCTYPE html>
<html lang="<%= currentLang === 'ar' ? 'ar' : 'en' %>" dir="<%= currentLang === 'ar' ? 'rtl' : 'ltr' %>">
<head>
    <!-- Prevent theme flickering -->
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - <%= isRtl ? 'إدارة المستخدمين' : 'User Management' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #121212;
            --bg-card: #18181b;
            --bg-hover: #27272a;
            --border-primary: #27272a;
            --border-accent: #3f3f46;
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent-color: var(--accent-color);
            --accent-hover: var(--accent-hover);
        }
        body {
            background-color: var(--bg-primary);
            font-family: 'Plus Jakarta Sans', 'Cairo', sans-serif;
            color: var(--text-primary);
            min-height: 100vh;
            background-image:
                radial-gradient(circle at 10% 20%, rgba(255, 59, 48, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.01) 0%, transparent 45%);
        }
        .panel-surface {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-primary);
            border-radius: 1.25rem;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
        }
        .user-input {
            background-color: #09090b;
            border: 1px solid #27272a;
            color: var(--text-primary);
            border-radius: 0.75rem;
            padding: 0.625rem 0.875rem;
            width: 100%;
            outline: none;
            transition: all 0.15s ease-in-out;
            font-size: 0.8125rem;
        }
        .user-input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.15);
        }
        .btn-primary {
            background-color: var(--accent-color);
            color: #fff;
            border: none;
            border-radius: 0.75rem;
            padding: 0.625rem 1.25rem;
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            cursor: pointer;
            transition: all 0.15s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.375rem;
        }
        .btn-primary:hover {
            background-color: var(--accent-hover);
            transform: translateY(-1px);
        }
        .btn-ghost {
            background-color: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-primary);
            border-radius: 0.625rem;
            padding: 0.4rem 0.75rem;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.15s;
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
        }
        .btn-ghost:hover {
            background-color: var(--bg-hover);
            color: var(--text-primary);
            border-color: var(--border-accent);
        }
        .tab-checkbox {
            accent-color: var(--accent-color);
            width: 1.1rem;
            height: 1.1rem;
            cursor: pointer;
            border-radius: 0.25rem;
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <div class="flex-1 p-6 md:p-8 relative flex flex-col min-h-screen">
        <div class="max-w-6xl mx-auto w-full space-y-6">

            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <a href="/?lang=<%= currentLang %>" class="text-xs font-semibold text-zinc-400 hover:text-white transition flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M9 5l7 7-7 7' : 'M15 19l-7-7 7-7' %>"/></svg>
                            <span><%= isRtl ? 'الرئيسية' : 'Dashboard' %></span>
                        </a>
                        <span class="text-zinc-600 text-xs">/</span>
                        <span class="text-xs text-[var(--accent-color)] font-bold"><%= isRtl ? 'المستخدمين' : 'Users' %></span>
                    </div>
                    <h1 class="text-2xl md:text-3xl font-black tracking-tight flex items-center gap-2">
                        <span><%= isRtl ? 'إدارة المستخدمين والصلاحيات' : 'User & Access Control' %></span>
                    </h1>
                    <p class="text-xs text-[var(--text-muted)] mt-1">
                        <%= isRtl ? 'إدارة حسابات مستخدمي اللوحة وتعيين مجموعات الصلاحيات' : 'Manage dashboard user accounts, assign group access permissions, and reset passwords' %>
                    </p>
                </div>
            </div>

            <!-- Alert Notifications -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold flex items-center justify-between shadow-lg">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        <span><%= success %></span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="text-emerald-400 hover:text-white text-sm">✕</button>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold flex items-center justify-between shadow-lg">
                    <div class="flex items-center gap-2">
                        <svg class="w-4 h-4 text-red-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        <span><%= error %></span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="text-red-400 hover:text-white text-sm">✕</button>
                </div>
            <% } %>

            <!-- Stats Overview Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="panel-surface p-5 flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-extrabold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'إجمالي المستخدمين' : 'Total Users' %></p>
                        <p class="text-2xl font-black text-white mt-1"><%= (typeof users !== 'undefined' && users) ? users.length : 0 %></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-[var(--accent-color)]/10 border border-[var(--accent-color)]/20 flex items-center justify-center text-[var(--accent-color)]">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    </div>
                </div>
                <div class="panel-surface p-5 flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-extrabold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'المجموعات المعرفة' : 'Configured Groups' %></p>
                        <p class="text-2xl font-black text-white mt-1"><%= (typeof groups !== 'undefined' && groups) ? groups.length : 0 %></p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    </div>
                </div>
                <div class="panel-surface p-5 flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-extrabold uppercase text-[var(--text-muted)] tracking-wider"><%= isRtl ? 'مدراء النظام' : 'Super Admins' %></p>
                        <p class="text-2xl font-black text-white mt-1">
                            <%= (typeof users !== 'undefined' && users) ? users.filter(u => u.group_name === 'super admins').length : 0 %>
                        </p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                </div>
            </div>

            <!-- Create User Card -->
            <div class="panel-surface p-6">
                <div class="flex items-center justify-between mb-5">
                    <h2 class="text-sm font-extrabold uppercase tracking-wider text-white flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-[var(--accent-color)]"></span>
                        <span><%= isRtl ? 'إضافة مستخدم جديد' : 'Add New User' %></span>
                    </h2>
                </div>
                <form method="POST" action="/users/add" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
                    <div>
                        <label class="block text-[10px] font-extrabold uppercase text-zinc-400 mb-1.5 tracking-wider"><%= isRtl ? 'اسم المستخدم *' : 'Username *' %></label>
                        <input type="text" name="username" placeholder="e.g. jsmith" required class="user-input">
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="block text-[10px] font-extrabold uppercase text-zinc-400 tracking-wider"><%= isRtl ? 'البريد الإلكتروني' : 'Email Address' %></label>
                            <span class="text-[9px] text-[var(--text-muted)] font-semibold"><%= isRtl ? '(اختياري)' : '(Optional)' %></span>
                        </div>
                        <input type="email" name="email" placeholder="user@example.com" class="user-input">
                    </div>
                    <div>
                        <label class="block text-[10px] font-extrabold uppercase text-zinc-400 mb-1.5 tracking-wider"><%= isRtl ? 'كلمة السر *' : 'Password *' %></label>
                        <input type="password" name="password" placeholder="••••••••" required class="user-input">
                    </div>
                    <div>
                        <label class="block text-[10px] font-extrabold uppercase text-zinc-400 mb-1.5 tracking-wider"><%= isRtl ? 'المجموعة *' : 'User Group *' %></label>
                        <select name="group_id" required class="user-input">
                            <option value="" disabled selected><%= isRtl ? '-- اختر المجموعة --' : '-- Select Group --' %></option>
                            <% if (typeof groups !== 'undefined' && groups) { %>
                                <% groups.forEach(g => { %>
                                    <option value="<%= g.id %>"><%= g.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>
                    <div class="sm:col-span-2 lg:col-span-4 flex justify-end pt-2">
                        <button type="submit" class="btn-primary">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                            <span><%= isRtl ? 'إضافة المستخدم' : 'Create User' %></span>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Existing Users Table Section -->
            <div class="panel-surface overflow-hidden shadow-2xl">
                <div class="p-5 border-b border-[#27272a] bg-black/20 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <h2 class="text-sm font-extrabold uppercase tracking-wider text-white flex items-center gap-2">
                        <span><%= isRtl ? 'قائمة المستخدمين المسجلين' : 'Registered Users' %></span>
                    </h2>
                    <!-- Table Search Filter -->
                    <div class="relative w-full sm:w-64">
                        <input type="text" id="userSearchInput" onkeyup="filterUsersTable()" placeholder="<%= isRtl ? 'بحث باسم المستخدم أو البريد...' : 'Search user, email, group...' %>" class="user-input py-1.5 px-3 text-xs pl-8">
                        <svg class="w-3.5 h-3.5 text-zinc-500 absolute left-2.5 top-2.5 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-start border-collapse" id="usersTable">
                        <thead>
                            <tr class="bg-black/40 text-zinc-400 text-xs font-black uppercase border-b border-[#27272a]">
                                <th class="py-3.5 px-6 text-start">ID</th>
                                <th class="py-3.5 px-6 text-start"><%= isRtl ? 'اسم المستخدم' : 'User' %></th>
                                <th class="py-3.5 px-6 text-start"><%= isRtl ? 'المجموعة' : 'Group' %></th>
                                <th class="py-3.5 px-6 text-start"><%= isRtl ? 'البريد الإلكتروني' : 'Email Address' %></th>
                                <th class="py-3.5 px-6 text-start"><%= isRtl ? 'تاريخ الإنشاء' : 'Created Date' %></th>
                                <th class="py-3.5 px-6 text-end"><%= isRtl ? 'الإجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#27272a]/50 text-xs">
                            <% if (users && users.length > 0) { %>
                                <% users.forEach(u => { %>
                                    <tr class="user-row hover:bg-zinc-800/30 transition-colors">
                                        <td class="py-3.5 px-6 font-mono text-zinc-500 font-bold">#<%= u.id %></td>
                                        <td class="py-3.5 px-6 font-bold text-white">
                                            <div class="flex items-center gap-2.5">
                                                <div class="w-7 h-7 rounded-lg bg-gradient-to-br from-zinc-800 to-zinc-900 border border-zinc-700/50 flex items-center justify-center font-mono font-black text-xs text-white uppercase shrink-0">
                                                    <%= u.username ? u.username.charAt(0) : 'U' %>
                                                </div>
                                                <span class="user-username-cell font-mono text-sm"><%= u.username %></span>
                                            </div>
                                        </td>
                                        <td class="py-3.5 px-6">
                                            <% if (u.group_name === 'super admins') { %>
                                                <span class="user-group-cell inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-purple-500/15 text-purple-400 border border-purple-500/30">
                                                    Super Admin
                                                </span>
                                            <% } else if (u.group_name) { %>
                                                <span class="user-group-cell inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-blue-500/15 text-blue-400 border border-blue-500/30">
                                                    <%= u.group_name %>
                                                </span>
                                            <% } else { %>
                                                <span class="user-group-cell text-zinc-600">—</span>
                                            <% } %>
                                        </td>
                                        <td class="py-3.5 px-6 font-mono text-zinc-300 user-email-cell">
                                            <% if (u.email) { %>
                                                <%= u.email %>
                                            <% } else { %>
                                                <span class="text-zinc-600 font-sans italic"><%= isRtl ? 'غير محدد' : 'None' %></span>
                                            <% } %>
                                        </td>
                                        <td class="py-3.5 px-6 font-mono text-zinc-400">
                                            <%= u.created_at ? new Date(u.created_at).toISOString().split('T')[0] : '-' %>
                                        </td>
                                        <td class="py-3.5 px-6 text-end">
                                            <div class="flex items-center justify-end gap-2">
                                                <button data-userid="<%= u.id %>" data-username="<%= u.username %>" onclick="showChangePwFromBtn(this)" class="btn-ghost text-[10px] px-2.5 py-1" title="<%= isRtl ? 'تغيير كلمة السر' : 'Change Password' %>">
                                                    <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 0121 9z"/></svg>
                                                    <span><%= isRtl ? 'تغيير السر' : 'Password' %></span>
                                                </button>
                                                <form method="POST" action="/users/delete" class="inline" onsubmit="return confirm('<%= isRtl ? 'هل أنت تأكد من حذف هذا المستخدم؟' : 'Delete this user?' %>')">
                                                    <input type="hidden" name="id" value="<%= u.id %>">
                                                    <button type="submit" class="btn-ghost text-[10px] px-2.5 py-1 text-red-400 hover:text-red-300 hover:border-red-500/50" title="<%= isRtl ? 'حذف المستخدم' : 'Delete User' %>">
                                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="py-10 text-center text-zinc-500 font-bold"><%= isRtl ? 'لا يوجد مستخدمين مسجلين' : 'No registered users found' %></td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Group Management Section (Super Admin Only) -->
            <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                <div class="space-y-6 pt-4">
                    <div class="flex items-center justify-between border-b border-[#27272a] pb-3">
                        <div>
                            <h2 class="text-lg font-black tracking-tight text-white"><%= isRtl ? 'إدارة المجموعات والصلاحيات' : 'Groups & Permissions' %></h2>
                            <p class="text-xs text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'إنشاء مجموعات وتعيين صلاحيات الوصول لتبويبات اللوحة' : 'Create groups and assign tab access permissions to control feature visibility' %></p>
                        </div>
                    </div>

                    <!-- Add Group Form -->
                    <div class="panel-surface p-6">
                        <h3 class="text-sm font-extrabold uppercase tracking-wider text-white mb-4 flex items-center gap-2">
                            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                            <span><%= isRtl ? 'إضافة مجموعة جديدة' : 'Create New Group' %></span>
                        </h3>
                        <form method="POST" action="/groups/add" class="flex flex-col sm:flex-row items-end gap-3">
                            <input type="hidden" name="lang" value="<%= currentLang %>">
                            <div class="flex-1 w-full">
                                <label class="block text-[10px] font-extrabold uppercase text-zinc-400 mb-1.5 tracking-wider"><%= isRtl ? 'اسم المجموعة *' : 'Group Name *' %></label>
                                <input type="text" name="name" placeholder="e.g. Support Team" required class="user-input">
                            </div>
                            <button type="submit" class="btn-primary shrink-0">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                                <span><%= isRtl ? 'إنشاء المجموعة' : 'Create Group' %></span>
                            </button>
                        </form>
                    </div>

                    <!-- Group List -->
                    <% if (typeof groups !== 'undefined' && groups && groups.length > 0) { %>
                        <div class="space-y-4">
                            <% groups.forEach(function(g) { %>
                                <div class="panel-surface p-6 space-y-4">
                                    <div class="flex items-center justify-between border-b border-[#27272a] pb-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400 font-bold font-mono text-xs">
                                                G
                                            </div>
                                            <div>
                                                <h3 class="text-sm font-extrabold text-white flex items-center gap-2">
                                                    <span><%= g.name %></span>
                                                    <% if (g.name === 'super admins') { %>
                                                        <span class="px-2 py-0.5 text-[9px] font-extrabold rounded-full bg-purple-500/15 text-purple-400 border border-purple-500/30">LOCKED</span>
                                                    <% } %>
                                                </h3>
                                                <span class="text-[10px] text-zinc-500 font-mono">ID: #<%= g.id %></span>
                                            </div>
                                        </div>
                                        <% if (g.name !== 'super admins') { %>
                                            <form method="POST" action="/groups/delete" onsubmit="return confirm('<%= isRtl ? 'حذف المجموعة ' : 'Delete group ' %><%= g.name %>?')">
                                                <input type="hidden" name="lang" value="<%= currentLang %>">
                                                <input type="hidden" name="id" value="<%= g.id %>">
                                                <button type="submit" class="btn-ghost text-[10px] text-red-400 hover:text-red-300 hover:border-red-500/50">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    <span><%= isRtl ? 'حذف المجموعة' : 'Delete Group' %></span>
                                                </button>
                                            </form>
                                        <% } %>
                                    </div>

                                    <% if (g.name === 'super admins') { %>
                                        <div>
                                            <p class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider mb-2.5"><%= isRtl ? 'صلاحيات الوصول للتبويبات' : 'Tab Access Permissions' %></p>
                                            <div class="flex flex-wrap gap-3 opacity-60">
                                                <% var visibleTabs = (typeof allTabs !== 'undefined' ? allTabs : []).filter(function(t) { return t !== 'dashboard' && t !== 'users'; }); %>
                                                <% visibleTabs.forEach(function(tab) { %>
                                                    <label class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-xs text-[var(--text-muted)] opacity-60 cursor-not-allowed">
                                                        <input type="checkbox" name="tabs" value="<%= tab %>" class="tab-checkbox" <%= (g.permissions || []).includes(tab) ? 'checked' : '' %> disabled>
                                                        <span class="capitalize"><%= tab.replace(/-/g, ' ') %></span>
                                                    </label>
                                                <% }); %>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <form method="POST" action="/groups/permissions" class="space-y-4">
                                            <input type="hidden" name="lang" value="<%= currentLang %>">
                                            <input type="hidden" name="group_id" value="<%= g.id %>">
                                            <div>
                                                <p class="text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider mb-2.5"><%= isRtl ? 'صلاحيات الوصول للتبويبات' : 'Tab Access Permissions' %></p>
                                                <div class="flex flex-wrap gap-3">
                                                    <% var visibleTabs = (typeof allTabs !== 'undefined' ? allTabs : []).filter(function(t) { return t !== 'dashboard' && t !== 'users'; }); %>
                                                    <% visibleTabs.forEach(function(tab) { %>
                                                        <label class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] hover:border-[var(--border-accent)] hover:bg-[var(--bg-hover)] text-xs text-[var(--text-primary)] cursor-pointer transition">
                                                            <input type="checkbox" name="tabs" value="<%= tab %>" class="tab-checkbox" <%= (g.permissions || []).includes(tab) ? 'checked' : '' %>>
                                                            <span class="capitalize"><%= tab.replace(/-/g, ' ') %></span>
                                                        </label>
                                                    <% }); %>
                                                </div>
                                            </div>
                                            <div class="flex justify-end pt-1">
                                                <button type="submit" class="btn-primary text-[10px]">
                                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                                    <span><%= isRtl ? 'حفظ الصلاحيات' : 'Save Permissions' %></span>
                                                </button>
                                            </div>
                                        </form>
                                    <% } %>
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
            <% } %>

        </div>
    </div>

    <!-- Change Password Modal -->
    <div id="pwModal" class="fixed inset-0 bg-black/75 backdrop-blur-md flex items-center justify-center hidden z-50 p-4">
        <div class="panel-surface p-6 w-full max-w-sm border border-[#27272a] shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-[#27272a] pb-3">
                <h3 class="text-sm font-extrabold uppercase tracking-wider text-white"><%= isRtl ? 'تغيير كلمة السر' : 'Change Password' %></h3>
                <button onclick="closePwModal()" class="text-zinc-500 hover:text-white transition">✕</button>
            </div>
            <form method="POST" action="/users/change-password" class="space-y-4">
                <input type="hidden" name="id" id="pwUserId">
                <div>
                    <label class="block text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider mb-1.5"><%= isRtl ? 'اسم المستخدم' : 'Target User' %></label>
                    <input type="text" id="pwUsernameDisplay" readonly class="user-input opacity-60 font-mono text-xs">
                </div>
                <div>
                    <label class="block text-[10px] font-extrabold text-zinc-400 uppercase tracking-wider mb-1.5"><%= isRtl ? 'كلمة السر الجديدة *' : 'New Password *' %></label>
                    <input type="password" name="new_password" placeholder="••••••••" required class="user-input">
                </div>
                <div class="flex gap-2 justify-end pt-2">
                    <button type="button" onclick="closePwModal()" class="btn-ghost text-xs"><%= isRtl ? 'إلغاء' : 'Cancel' %></button>
                    <button type="submit" class="btn-primary text-xs"><%= isRtl ? 'حفظ التغييرات' : 'Save Password' %></button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function showChangePwFromBtn(btn) {
            const id = btn.getAttribute('data-userid');
            const username = btn.getAttribute('data-username');
            document.getElementById('pwUserId').value = id;
            document.getElementById('pwUsernameDisplay').value = username || ('User #' + id);
            document.getElementById('pwModal').classList.remove('hidden');
        }
        function showChangePw(id, username) {
            document.getElementById('pwUserId').value = id;
            document.getElementById('pwUsernameDisplay').value = username || ('User #' + id);
            document.getElementById('pwModal').classList.remove('hidden');
        }
        function closePwModal() {
            document.getElementById('pwModal').classList.add('hidden');
        }
        document.getElementById('pwModal').addEventListener('click', (e) => {
            if (e.target === e.currentTarget) closePwModal();
        });

        function filterUsersTable() {
            const input = document.getElementById('userSearchInput');
            const filter = input.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#usersTable tbody tr.user-row');

            rows.forEach(row => {
                const userText = row.querySelector('.user-username-cell')?.textContent.toLowerCase() || '';
                const groupText = row.querySelector('.user-group-cell')?.textContent.toLowerCase() || '';
                const emailText = row.querySelector('.user-email-cell')?.textContent.toLowerCase() || '';
                if (userText.includes(filter) || groupText.includes(filter) || emailText.includes(filter)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>

<%
/**
 * Global PBX scope selector.
 *
 * Rendered on every tab when at least one federation peer is configured. The
 * selection is persisted in the `fed_scope` cookie (read by the server) and
 * mirrored in localStorage so it survives cookie cleanup.
 *
 * Values: "all" | "local" | comma separated site codes.
 */
const fedScopeEnabled = (typeof federationEnabled !== 'undefined') && federationEnabled
    && (typeof federationCentral !== 'undefined') && federationCentral;
if (fedScopeEnabled) {
    const fedNodes = Array.isArray(federationNodes) ? federationNodes : [];
    const fedScope = (typeof federationScope !== 'undefined' && federationScope) ? federationScope : { mode: 'all', sites: [], localSiteCode: '10' };
    const localSite = String(fedScope.localSiteCode || '10');
    const scopeSites = new Set((fedScope.sites || []).map(String));
    const scopeIsAll = fedScope.mode === 'all';
    const scopeIsLocal = fedScope.mode === 'local';
    const selectedCount = scopeIsAll ? fedNodes.length : (scopeIsLocal ? 1 : scopeSites.size);
    const onlineCount = fedNodes.filter(n => n.status === 'online').length;
    const selectedNames = fedNodes
        .filter(n => scopeSites.has(String(n.site_code)))
        .map(n => n.node_name);
    const selectedLabel = selectedNames.length > 0 && selectedNames.length <= 3
        ? selectedNames.join(' + ')
        : (isRtl ? `${selectedCount} سيرفرات محددة` : `${selectedCount} PBXs selected`);
    const scopeLabel = scopeIsAll
        ? (isRtl ? 'كل السيرفرات' : 'All PBXs')
        : (scopeIsLocal
            ? (isRtl ? 'هذا السيرفر فقط' : 'This PBX only')
            : selectedLabel);
    const fedNodeNamesJson = JSON.stringify(
        Object.fromEntries(fedNodes.map(n => [String(n.site_code), n.node_name]))
    ).replace(/</g, '\\u003c');

    // When exactly one remote PBX is selected the central panel becomes that
    // PBX's control surface: writes (and, on the dongle page, device reads)
    // are relayed through the signed action gateway.
    const fedControlNode = (fedScope.mode === 'selected' && Array.isArray(fedScope.sites) && fedScope.sites.length === 1)
        ? fedNodes.find(n => String(n.site_code) === String(fedScope.sites[0]) && !n.is_local)
        : null;
    // Pages that aggregate every PBX at once (the dongle console) route each
    // action to the owning node themselves, so the single-node fetch shim must
    // stay off there or it would hijack the merged local reads.
    const fedAggregatedPage = (typeof fedMultiNodePage !== 'undefined') && Boolean(fedMultiNodePage);
    const fedCanControl = Boolean(fedControlNode) && (typeof isSuperAdmin !== 'undefined') && Boolean(isSuperAdmin) && !fedAggregatedPage;
    const fedControlSite = fedControlNode ? String(fedControlNode.site_code) : '';
    const fedControlName = fedControlNode ? String(fedControlNode.node_name || ('Site ' + fedControlSite)) : '';
    const fedControlSiteJson = JSON.stringify(fedControlSite).replace(/</g, '\\u003c');
    const fedControlNameJson = JSON.stringify(fedControlName).replace(/</g, '\\u003c');
%>
<style>
    #fedScopeBar .fed-scope-menu { scrollbar-width: thin; }
    #fedScopeBar .fed-scope-node:hover { background: var(--bg-hover); }
    #fedScopeBar .fed-scope-check { accent-color: var(--accent-color); }
    #fedScopeBar .fed-scope-dot { width: 8px; height: 8px; border-radius: 9999px; display: inline-block; flex: 0 0 auto; }
    html[dir="rtl"] #fedScopeBar .fed-scope-menu { right: auto; left: 0; }
</style>
<div id="fedScopeBar"
     class="mb-3 flex items-center gap-2 flex-wrap"
     data-local-site="<%= localSite %>"
     data-scope-mode="<%= fedScope.mode %>"
     dir="<%= isRtl ? 'rtl' : 'ltr' %>">
    <span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="3" width="20" height="6" rx="2"></rect>
            <rect x="2" y="15" width="20" height="6" rx="2"></rect>
            <path d="M6 6h.01M6 18h.01"></path>
        </svg>
        <%= isRtl ? 'نطاق السيرفرات' : 'PBX scope' %>
    </span>

    <div class="relative">
        <button type="button"
                id="fedScopeBtn"
                onclick="toggleFedScopeMenu(event)"
                aria-haspopup="true"
                aria-expanded="false"
                class="h-9 min-w-[190px] max-w-[320px] px-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] hover:border-[var(--accent-color)]/60 text-[var(--text-primary)] flex items-center justify-between gap-2 text-xs font-bold transition cursor-pointer">
            <span class="flex items-center gap-2 min-w-0">
                <span id="fedScopeDots" class="flex items-center gap-1 shrink-0">
                    <% fedNodes.slice(0, 4).forEach(node => { %>
                        <span class="fed-scope-dot" style="background:<%= node.status === 'online' ? '#10b981' : (node.status === 'offline' ? '#ef4444' : '#f59e0b') %>" title="<%= node.node_name %>"></span>
                    <% }); %>
                </span>
                <span id="fedScopeLabel" class="truncate"><%= scopeLabel %></span>
            </span>
            <svg class="w-3.5 h-3.5 shrink-0 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </button>

        <div id="fedScopeMenu"
             class="fed-scope-menu hidden absolute top-full mt-1.5 z-[250] w-[280px] max-w-[calc(100vw-2rem)] rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)] shadow-2xl p-2"
             role="dialog"
             aria-label="<%= isRtl ? 'اختيار السيرفرات' : 'Select PBXs' %>">
            <label class="fed-scope-node flex items-center gap-2 px-2 py-2 rounded-lg cursor-pointer select-none text-xs">
                <input type="checkbox" id="fedScopeAll" class="fed-scope-check rounded" <%= scopeIsAll ? 'checked' : '' %>>
                <span class="font-extrabold text-[var(--text-primary)]"><%= isRtl ? 'كل السيرفرات' : 'All PBXs' %></span>
                <span class="ms-auto text-[10px] font-bold text-[var(--text-muted)]"><%= fedNodes.length %></span>
            </label>
            <div class="my-1 border-t border-[var(--border-primary)]"></div>
            <div class="max-h-64 overflow-y-auto space-y-0.5">
                <% fedNodes.forEach(node => {
                    const reportRead = node.report_read !== false;
                    const checked = scopeIsAll
                        ? reportRead
                        : (scopeIsLocal ? String(node.site_code) === localSite : scopeSites.has(String(node.site_code)));
                    const dotColor = node.status === 'online' ? '#10b981' : (node.status === 'offline' ? '#ef4444' : '#f59e0b');
                    const peerPanelUrl = '/peer/' + encodeURIComponent(String(node.site_code)) + '/';
                %>
                <div class="fed-scope-node flex items-center gap-1 px-1 rounded-lg">
                    <label class="flex items-center gap-2 flex-1 min-w-0 px-1 py-2 rounded-lg select-none text-xs <%= reportRead ? 'cursor-pointer' : 'opacity-60 cursor-not-allowed' %>">
                        <input type="checkbox"
                               class="fed-scope-check rounded"
                               data-fed-site="<%= node.site_code %>"
                               <%= checked ? 'checked' : '' %>
                               <%= reportRead ? '' : 'disabled' %>>
                        <span class="fed-scope-dot" style="background:<%= dotColor %>"></span>
                        <span class="min-w-0 flex-1">
                            <span class="block truncate font-bold text-[var(--text-primary)]"><%= node.node_name %></span>
                            <span class="block truncate text-[10px] text-[var(--text-muted)] font-mono">Site <%= node.site_code %><%= node.is_local ? (isRtl ? ' · محلي' : ' · local') : '' %></span>
                        </span>
                        <span class="text-[9px] font-extrabold uppercase tracking-wide <%= reportRead ? (node.status === 'online' ? 'text-emerald-400' : (node.status === 'offline' ? 'text-red-400' : 'text-amber-400')) : 'text-[var(--text-muted)]' %>"><%= reportRead ? node.status : (isRtl ? 'لا تقارير' : 'no reports') %></span>
                    </label>
                    <% if (!node.is_local) { %>
                    <a href="<%= peerPanelUrl %>"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="<%= isRtl ? `فتح لوحة ${node.node_name} في تبويب جديد (عبر هذا السيرفر)` : `Open ${node.node_name} panel in a new tab (proxied by this server)` %>"
                       aria-label="<%= isRtl ? `فتح لوحة ${node.node_name}` : `Open ${node.node_name} panel` %>"
                       class="shrink-0 w-7 h-7 rounded-lg flex items-center justify-center border border-[var(--border-primary)] bg-[var(--bg-primary)] text-[var(--text-secondary)] hover:text-[var(--accent-color)] hover:border-[var(--accent-color)]/50 transition cursor-pointer <%= node.status === 'online' ? '' : 'opacity-50' %>">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <path d="M15 3h6v6"></path>
                            <path d="M10 14 21 3"></path>
                        </svg>
                    </a>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <div class="my-1 border-t border-[var(--border-primary)]"></div>
            <div class="flex items-center gap-2 px-1 pt-1">
                <button type="button" onclick="applyFedScope()" class="flex-1 h-8 rounded-lg bg-[var(--accent-color)] text-white text-[11px] font-extrabold uppercase tracking-wide hover:opacity-90 transition cursor-pointer">
                    <%= isRtl ? 'تطبيق' : 'Apply' %>
                </button>
                <button type="button" onclick="setFedScopeValue('local')" class="h-8 px-2.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[10px] font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer">
                    <%= isRtl ? 'محلي فقط' : 'Local only' %>
                </button>
            </div>
        </div>
    </div>

    <span id="fedScopeSummary" class="text-[10px] font-bold text-[var(--text-muted)] font-mono">
        <%= onlineCount %>/<%= fedNodes.length %> <%= isRtl ? 'متصل' : 'online' %>
    </span>
</div>
<% if (fedCanControl) { %>
<div id="fedControlBanner"
     class="mb-3 flex items-center gap-2 flex-wrap rounded-xl border border-amber-500/30 bg-amber-500/10 px-3 py-2 text-[11px] font-bold text-amber-300"
     role="status">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        <path d="M9 12l2 2 4-4"></path>
    </svg>
    <span class="min-w-0">
        <%= isRtl ? 'وضع التحكم:' : 'Control mode:' %>
        <b class="text-amber-200"><%= fedControlName %></b>
        —
        <span class="fed-control-note-devices hidden"><%= isRtl ? 'قائمة الأجهزة وكل الأوامر في هذه الصفحة تُنفَّذ على هذا السيرفر.' : 'the device list and every command on this page run on that PBX.' %></span>
        <span class="fed-control-note-config"><%= isRtl ? 'التغييرات في هذه الصفحة تُطبَّق على هذا السيرفر، بينما القيم المعروضة تأتي من السيرفر الحالي. استخدم زر «فتح اللوحة» لرؤية قيم السيرفر البعيد قبل تعديلها.' : 'changes on this page are applied to that PBX, while the values shown come from this server. Use the "open panel" button to see that PBX\'s own values before editing.' %></span>
    </span>
    <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amber-500/15 border border-amber-500/30">Site <%= fedControlSite %></span>
    <% if (fedControlNode && fedControlNode.status !== 'online') { %>
    <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded bg-red-500/15 border border-red-500/30 text-red-300"><%= isRtl ? 'غير متصل' : 'offline' %></span>
    <% } %>
</div>
<% } %>
<script>
    (function () {
        const bar = document.getElementById('fedScopeBar');
        if (!bar) return;
        const btn = document.getElementById('fedScopeBtn');
        const menu = document.getElementById('fedScopeMenu');
        const allChk = document.getElementById('fedScopeAll');
        const nodeChks = Array.from(menu.querySelectorAll('input[data-fed-site]:not(:disabled)'));
        const label = document.getElementById('fedScopeLabel');
        const localSite = bar.dataset.localSite || '10';
        const nodeNames = <%- fedNodeNamesJson %>;
        const isRtl = document.documentElement.dir === 'rtl';

        function closeMenu() {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
        }

        window.toggleFedScopeMenu = function (event) {
            if (event) event.stopPropagation();
            const willOpen = menu.classList.contains('hidden');
            menu.classList.toggle('hidden', !willOpen);
            btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        };

        function syncAllState() {
            const checked = nodeChks.filter(c => c.checked);
            allChk.checked = nodeChks.length > 0 && checked.length === nodeChks.length;
            allChk.indeterminate = checked.length > 0 && checked.length < nodeChks.length;
            if (checked.length === nodeChks.length) {
                label.textContent = isRtl ? 'كل السيرفرات' : 'All PBXs';
            } else if (checked.length === 1 && checked[0].dataset.fedSite === localSite) {
                label.textContent = isRtl ? 'هذا السيرفر فقط' : 'This PBX only';
            } else if (checked.length <= 3) {
                label.textContent = checked
                    .map(c => nodeNames[c.dataset.fedSite] || ('Site ' + c.dataset.fedSite))
                    .join(' + ');
            } else {
                label.textContent = isRtl
                    ? checked.length + ' سيرفرات محددة'
                    : checked.length + ' PBXs selected';
            }
        }

        allChk.addEventListener('change', function () {
            nodeChks.forEach(c => { c.checked = allChk.checked; });
            syncAllState();
        });
        nodeChks.forEach(chk => {
            chk.addEventListener('change', function () {
                // Never allow an empty scope; fall back to the local PBX.
                if (!nodeChks.some(c => c.checked)) chk.checked = true;
                syncAllState();
            });
        });

        function persist(value) {
            try {
                document.cookie = 'fed_scope=' + encodeURIComponent(value) + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (_) {}
            try { localStorage.setItem('fed_scope', value); } catch (_) {}
            window.location.reload();
        }

        window.applyFedScope = function () {
            const chosen = nodeChks.filter(c => c.checked).map(c => c.dataset.fedSite);
            if (chosen.length === 0 || chosen.length === nodeChks.length) return persist('all');
            if (chosen.length === 1 && chosen[0] === localSite) return persist('local');
            persist(chosen.join(','));
        };

        window.setFedScopeValue = function (value) {
            if (value === 'all') {
                nodeChks.forEach(c => { c.checked = true; });
                syncAllState();
                return persist('all');
            }
            nodeChks.forEach(c => { c.checked = c.dataset.fedSite === localSite; });
            syncAllState();
            persist('local');
        };

        // If the cookie was cleared but localStorage still has a selection,
        // restore it so the server and the UI agree on the next load.
        try {
            const stored = localStorage.getItem('fed_scope');
            const cookieValue = document.cookie.split(';').map(p => p.trim()).find(p => p.startsWith('fed_scope='));
            if (stored && !cookieValue) {
                document.cookie = 'fed_scope=' + encodeURIComponent(stored) + ';path=/;max-age=31536000;SameSite=Lax';
            }
        } catch (_) {}

        document.addEventListener('click', function (e) {
            if (!bar.contains(e.target)) closeMenu();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeMenu();
        });
    })();
</script>
<% if (fedCanControl) { %>
<script>
    /**
     * Federation control shim.
     *
     * Selecting one remote PBX turns the central panel into that PBX's control
     * surface. Mutating /api/* calls are rewritten to the signed action gateway
     * so the peer executes them locally. Federation management, login and API
     * key endpoints are never relayed. On the GSM page the device poll is
     * relayed too, so the whole page shows the remote dongles with full
     * controls instead of the read-only remote cards.
     */
    (function () {
        var cfg = {
            enabled: true,
            siteCode: <%- fedControlSiteJson %>,
            siteName: <%- fedControlNameJson %>,
            gateway: '/api/federation/peers/' + encodeURIComponent(<%- fedControlSiteJson %>) + '/action',
            dongleMode: false
        };
        window.__sokratFedControl = cfg;
        try {
            document.querySelectorAll('.fed-control-note-devices').forEach(function (el) {
                el.classList.toggle('hidden', !cfg.dongleMode);
            });
            document.querySelectorAll('.fed-control-note-config').forEach(function (el) {
                el.classList.toggle('hidden', cfg.dongleMode);
            });
        } catch (_) {}
        if (window.__sokratFedShimInstalled) return;
        window.__sokratFedShimInstalled = true;

        var GATEWAY = cfg.gateway;
        var DENY = [
            /^\/api\/federation(?:\/|$)/,
            /^\/api\/config\/federation(?:\/|$)/,
            /^\/api\/auth(?:\/|$)/,
            /^\/api\/admin(?:\/|$)/,
            /^\/api\/peer(?:\/|$)/
        ];

        function isDenied(pathname) {
            for (var i = 0; i < DENY.length; i += 1) {
                if (DENY[i].test(pathname)) return true;
            }
            return false;
        }

        function parseUrl(value) {
            try { return new URL(String(value || ''), window.location.origin); } catch (_) { return null; }
        }

        function shouldRelay(method, url) {
            if (!url || url.origin !== window.location.origin) return false;
            if (url.pathname.indexOf('/api/') !== 0) return false;
            if (isDenied(url.pathname)) return false;
            var verb = String(method || 'GET').toUpperCase();
            // Reads always stay local: the control pages show this PBX's own
            // state, and the dongle console merges every PBX server-side.
            if (verb === 'GET' || verb === 'HEAD') return false;
            return true;
        }

        function base64FromArrayBuffer(buffer) {
            var bytes = new Uint8Array(buffer);
            var binary = '';
            var chunk = 0x8000;
            for (var i = 0; i < bytes.length; i += chunk) {
                binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunk));
            }
            return btoa(binary);
        }

        function base64FromText(text) {
            return base64FromArrayBuffer(new TextEncoder().encode(String(text)).buffer);
        }

        function headersContentType(headers) {
            if (!headers) return '';
            try {
                if (typeof headers.get === 'function') return headers.get('content-type') || '';
                for (var key in headers) {
                    if (Object.prototype.hasOwnProperty.call(headers, key) && key.toLowerCase() === 'content-type') {
                        return String(headers[key] || '');
                    }
                }
            } catch (_) {}
            return '';
        }

        function buildPayload(method, url, body, contentType) {
            var payload = {
                method: String(method || 'POST').toUpperCase(),
                path: url.pathname + url.search
            };
            if (body === undefined || body === null) return Promise.resolve(payload);

            if (typeof body === 'string') {
                if (/json/i.test(contentType)) {
                    try {
                        payload.body = JSON.parse(body);
                        return Promise.resolve(payload);
                    } catch (_) {}
                }
                payload.body = base64FromText(body);
                payload.bodyEncoding = 'base64';
                payload.contentType = contentType || 'text/plain;charset=UTF-8';
                return Promise.resolve(payload);
            }
            if (typeof URLSearchParams !== 'undefined' && body instanceof URLSearchParams) {
                payload.body = base64FromText(body.toString());
                payload.bodyEncoding = 'base64';
                payload.contentType = 'application/x-www-form-urlencoded;charset=UTF-8';
                return Promise.resolve(payload);
            }
            if (typeof FormData !== 'undefined' && body instanceof FormData) {
                var formResponse = new Response(body);
                var formType = formResponse.headers.get('content-type') || 'multipart/form-data';
                return formResponse.arrayBuffer().then(function (buffer) {
                    payload.body = base64FromArrayBuffer(buffer);
                    payload.bodyEncoding = 'base64';
                    payload.contentType = formType;
                    return payload;
                });
            }
            if (typeof Blob !== 'undefined' && body instanceof Blob) {
                return body.arrayBuffer().then(function (buffer) {
                    payload.body = base64FromArrayBuffer(buffer);
                    payload.bodyEncoding = 'base64';
                    payload.contentType = body.type || contentType || 'application/octet-stream';
                    return payload;
                });
            }
            if (typeof ArrayBuffer !== 'undefined' && body instanceof ArrayBuffer) {
                payload.body = base64FromArrayBuffer(body);
                payload.bodyEncoding = 'base64';
                payload.contentType = contentType || 'application/octet-stream';
                return Promise.resolve(payload);
            }
            if (typeof ArrayBuffer !== 'undefined' && ArrayBuffer.isView && ArrayBuffer.isView(body)) {
                payload.body = base64FromArrayBuffer(body.buffer.slice(body.byteOffset, body.byteOffset + body.byteLength));
                payload.bodyEncoding = 'base64';
                payload.contentType = contentType || 'application/octet-stream';
                return Promise.resolve(payload);
            }
            payload.body = body;
            return Promise.resolve(payload);
        }

        function relay(payload, signal) {
            return window.__sokratOrigFetch(GATEWAY, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify(payload),
                credentials: 'same-origin',
                signal: signal
            });
        }

        if (window.fetch) {
            window.__sokratOrigFetch = window.fetch.bind(window);
            window.fetch = function (input, init) {
                var isRequest = (typeof Request !== 'undefined' && input instanceof Request);
                var method = (init && init.method) || (isRequest ? input.method : 'GET');
                var url = parseUrl(isRequest ? input.url : input);
                if (!shouldRelay(method, url)) return window.__sokratOrigFetch(input, init);

                var headers = (init && init.headers) || (isRequest ? input.headers : null);
                var contentType = headersContentType(headers);
                var bodyPromise = isRequest
                    ? input.clone().text().then(function (text) { return buildPayload(method, url, text || null, contentType); })
                    : buildPayload(method, url, init ? init.body : null, contentType);

                return bodyPromise.then(function (payload) {
                    return relay(payload, init && init.signal);
                });
            };
        }

        if (window.XMLHttpRequest) {
            var origOpen = XMLHttpRequest.prototype.open;
            var origSend = XMLHttpRequest.prototype.send;
            var origSetHeader = XMLHttpRequest.prototype.setRequestHeader;

            XMLHttpRequest.prototype.open = function (method, url) {
                var parsed = parseUrl(url);
                if (shouldRelay(method, parsed)) {
                    this.__sokratFed = { method: method, url: parsed, contentType: '' };
                    var args = Array.prototype.slice.call(arguments);
                    args[0] = 'POST';
                    args[1] = GATEWAY;
                    return origOpen.apply(this, args);
                }
                this.__sokratFed = null;
                return origOpen.apply(this, arguments);
            };
            XMLHttpRequest.prototype.setRequestHeader = function (name, value) {
                if (this.__sokratFed) {
                    if (String(name).toLowerCase() === 'content-type') {
                        this.__sokratFed.contentType = String(value || '');
                    }
                    return;
                }
                return origSetHeader.apply(this, arguments);
            };
            XMLHttpRequest.prototype.send = function (body) {
                var meta = this.__sokratFed;
                if (!meta) return origSend.apply(this, arguments);
                var xhr = this;
                buildPayload(meta.method, meta.url, body, meta.contentType).then(function (payload) {
                    origSetHeader.call(xhr, 'Content-Type', 'application/json');
                    origSend.call(xhr, JSON.stringify(payload));
                }).catch(function () {
                    try { xhr.dispatchEvent(new ProgressEvent('error')); } catch (_) {}
                });
            };
        }
    })();
</script>

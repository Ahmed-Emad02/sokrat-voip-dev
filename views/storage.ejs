const isRtl = currentLang === 'ar';
%>
<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - <%= t.title %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&family=Roboto:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <style>
        :root {
            --bg-primary: #050507;
            --bg-secondary: #0c0c0e;
            --bg-card: #121215;
            --bg-hover: #1e1e24;
            --border-primary: #18181c;
            --border-accent: #2c2c34;
            --text-primary: #f4f4f5;
            --text-secondary: #a1a1aa;
            --text-muted: #8e8e93;
            --accent-color: #e53e3e;
            --accent-hover: #fc8181;
            --accent-soft: rgba(229, 62, 62, 0.14);
            --accent-border: rgba(229, 62, 62, 0.42);
        }
        body.light-theme {
            --bg-primary: #f4f4f6 !important;
            --bg-secondary: #ffffff !important;
            --bg-card: #f4f4f6 !important;
            --bg-hover: #e4e4e9 !important;
            --border-primary: #e4e4e9 !important;
            --border-accent: #d4d4de !important;
            --text-primary: #18181b !important;
            --text-secondary: #3f3f46 !important;
            --text-muted: #71717a !important;
            --accent-color: #b91c1c !important;
            --accent-hover: #991b1b !important;
            --accent-soft: rgba(254, 226, 226, 0.72) !important;
            --accent-border: rgba(220, 38, 38, 0.36) !important;
        }
        body.light-theme .text-white {
            color: #18181b !important;
        }
        body.light-theme input,
        body.light-theme select,
        body.light-theme textarea {
            background-color: #ffffff !important;
            color: #18181b !important;
            border-color: #cbd5e1 !important;
        }
        body.light-theme .bg-black\/20 {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
        }
        body.light-theme .bg-zinc-800 {
            background-color: #e2e8f0 !important;
            color: #18181b !important;
        }
        body.light-theme .border-zinc-700 {
            border-color: #cbd5e1 !important;
        }
        body { font-family: 'Roboto', 'IBM Plex Sans Arabic', sans-serif; background-color: var(--bg-primary); color: var(--text-primary); }
        .panel-surface { background-color: var(--bg-secondary); border: 1px solid var(--border-primary); }
        .storage-tab-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.625rem 1rem;
            border-radius: 0.75rem;
            font-size: 0.8125rem;
            font-weight: 700;
            color: var(--text-secondary);
            transition: all 150ms ease;
            cursor: pointer;
            border: 1px solid transparent;
        }
        .storage-tab-btn:hover {
            color: var(--text-primary);
            background-color: var(--bg-hover);
        }
        .storage-tab-btn.active {
            color: #ffffff;
            background-color: var(--accent-color);
            border-color: var(--accent-border);
            box-shadow: 0 4px 14px 0 rgba(229, 62, 62, 0.3);
        }
        body.light-theme .storage-tab-btn.active {
            color: #ffffff !important;
            background-color: var(--accent-color) !important;
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>

    <div class="flex-1 p-6 md:p-8 relative flex flex-col min-h-screen">
        
        <!-- Header Section -->
        <div class="mb-6 shrink-0 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <div class="flex items-center gap-3">
                    <h2 class="text-3xl font-extrabold text-white tracking-tight"><%= t.title %> <span class="text-[var(--accent-color)]"><%= t.subtitle %></span></h2>
                    <span id="system-health-pill" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span id="system-health-text"><%= t.systemHealthy %></span>
                    </span>
                </div>
            </div>
            
            <div class="flex items-center gap-3 flex-wrap">
                <!-- Refresh Rate Selector -->
                <div class="flex items-center gap-2 panel-surface px-3 py-1.5 rounded-xl border border-[var(--border-primary)]">
                    <span class="text-xs font-bold text-[var(--text-muted)]"><%= t.refreshRate %></span>
                    <select id="telemetryRefreshRate" onchange="updateRefreshInterval(this.value)" class="bg-transparent text-xs font-bold text-white border-none cursor-pointer focus:outline-none">
                        <option value="1000" class="bg-[var(--bg-secondary)] text-white"><%= t.refresh1s %></option>
                        <option value="2000" class="bg-[var(--bg-secondary)] text-white"><%= t.refresh2s %></option>
                        <option value="5000" selected class="bg-[var(--bg-secondary)] text-white"><%= t.refresh5s %></option>
                        <option value="10000" class="bg-[var(--bg-secondary)] text-white"><%= t.refresh10s %></option>
                        <option value="0" class="bg-[var(--bg-secondary)] text-white"><%= t.refreshPaused %></option>
                    </select>
                </div>

                <button onclick="triggerImmediateRefresh()" class="panel-surface hover:bg-[var(--bg-hover)] text-white border border-[var(--border-primary)] rounded-xl px-4 py-2 text-xs font-bold flex items-center gap-2 cursor-pointer transition">
                    <svg id="refresh-spinner" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                    <span><%= isRtl ? 'تحديث البيانات' : 'Refresh Metrics' %></span>
                </button>
            </div>
        </div>

        <!-- Top Metrics Cards Grid (Persistent across tabs) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">
            <!-- Card 1: CPU & Load -->
            <div class="panel-surface rounded-2xl p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-wider"><%= t.cpuOverview %></span>
                    <div class="p-2 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="15" x2="23" y2="15"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="15" x2="4" y2="15"/></svg>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline justify-between mb-1">
                        <span id="stat-cpu-pct" class="text-2xl font-black text-white font-mono">- %</span>
                        <span id="stat-cpu-load" class="text-xs text-[var(--text-muted)] font-mono">Load: -</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-zinc-800 overflow-hidden">
                        <div id="stat-cpu-bar" class="h-full bg-purple-500 transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Card 2: RAM Memory -->
            <div class="panel-surface rounded-2xl p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-wider"><%= t.ramOverview %></span>
                    <div class="p-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 19v-3"/><path d="M10 19v-3"/><path d="M14 19v-3"/><path d="M18 19v-3"/><path d="M6 5v3"/><path d="M10 5v3"/><path d="M14 5v3"/><path d="M18 5v3"/><rect x="2" y="8" width="20" height="8" rx="2"/></svg>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline justify-between mb-1">
                        <span id="stat-ram-pct" class="text-2xl font-black text-white font-mono">- %</span>
                        <span id="stat-ram-avail" class="text-xs text-[var(--text-muted)] font-mono">- free</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-zinc-800 overflow-hidden">
                        <div id="stat-ram-bar" class="h-full bg-emerald-500 transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Card 3: Server Root Storage -->
            <div class="panel-surface rounded-2xl p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-wider"><%= t.diskOverview %></span>
                    <div class="p-2 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                    </div>
                </div>
                <div>
                    <div class="flex items-baseline justify-between mb-1">
                        <span id="disk-used-pct" class="text-2xl font-black text-white font-mono">- %</span>
                        <span id="disk-free-text" class="text-xs text-[var(--text-muted)] font-mono">- free</span>
                    </div>
                    <div class="w-full h-2 rounded-full bg-zinc-800 overflow-hidden">
                        <div id="disk-progress-bar" class="h-full bg-blue-500 transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Card 4: Asterisk PBX Core -->
            <div class="panel-surface rounded-2xl p-5 flex flex-col justify-between">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-wider"><%= t.asteriskOverview %></span>
                    <div class="p-2 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    </div>
                </div>
                <div>
                    <div class="flex items-center gap-2 mb-1">
                        <span id="stat-asterisk-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
                        <span id="stat-asterisk-status" class="text-lg font-black text-white font-mono">Online</span>
                    </div>
                    <span id="stat-asterisk-sub" class="text-xs text-[var(--text-muted)] block">- channels active</span>
                </div>
            </div>
        </div>

        <!-- Sub-Tab Navigation Bar -->
        <div class="flex items-center gap-2 border-b border-[var(--border-primary)] mb-6 pb-2">
            <button type="button" onclick="switchStorageTab('resources')" id="tab-btn-resources" class="storage-tab-btn active">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <span><%= t.tabResources %></span>
            </button>
            <button type="button" onclick="switchStorageTab('services')" id="tab-btn-services" class="storage-tab-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                <span><%= t.tabServices %></span>
            </button>
            <button type="button" onclick="switchStorageTab('storage')" id="tab-btn-storage" class="storage-tab-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                <span><%= t.tabStorage %></span>
            </button>
        </div>

        <!-- ============================================================= -->
        <!-- TAB 1: SERVER RESOURCES & TELEMETRY                           -->
        <!-- ============================================================= -->
        <div id="panel-resources" class="flex flex-col gap-6">
            
            <!-- Real-Time Sliding Telemetry Charts -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Chart 1: CPU & RAM Utilization -->
                <div class="panel-surface rounded-2xl p-5 flex flex-col">
                    <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 mb-4">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span>
                            <h3 class="text-sm font-bold text-white"><%= t.chartCpuRam %></h3>
                        </div>
                        <span class="text-xs text-[var(--text-muted)] font-mono" id="chart-cpu-ram-legend">CPU: 0% | RAM: 0%</span>
                    </div>
                    <div id="cpuRamChart" style="height: 240px; width: 100%;"></div>
                </div>

                <!-- Chart 2: Network Traffic & Asterisk Concurrent Calls -->
                <div class="panel-surface rounded-2xl p-5 flex flex-col">
                    <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 mb-4">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-500"></span>
                            <h3 class="text-sm font-bold text-white"><%= t.chartNetChannels %></h3>
                        </div>
                        <span class="text-xs text-[var(--text-muted)] font-mono" id="chart-net-legend">RX: 0 KB/s | TX: 0 KB/s</span>
                    </div>
                    <div id="netChannelsChart" style="height: 240px; width: 100%;"></div>
                </div>
            </div>

            <!-- Quick Maintenance Actions & Server Specifications -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Quick Actions Panel -->
                <div class="panel-surface rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-2 border-b border-[var(--border-primary)] pb-3 mb-4">
                            <svg class="text-[var(--accent-color)]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            <h3 class="text-sm font-bold text-white"><%= t.quickActions %></h3>
                        </div>
                        <div class="flex flex-col gap-3">
                            <!-- Flush RAM Caches Button -->
                            <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold text-white"><%= t.flushCachesBtn %></span>
                                    <span class="text-[10px] text-purple-400 font-mono">sync + drop_caches</span>
                                </div>
                                <p class="text-[11px] text-[var(--text-muted)]"><%= t.flushCachesDesc %></p>
                                <button type="button" onclick="executeDropCaches()" id="dropCachesBtn" class="mt-1 w-full bg-purple-600 hover:bg-purple-500 text-white font-bold rounded-lg py-2 px-3 text-xs flex items-center justify-center gap-2 cursor-pointer transition">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                    <span><%= t.flushCachesBtn %></span>
                                </button>
                            </div>

                            <!-- Asterisk Core Reload Button -->
                            <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-2">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold text-white"><%= t.reloadAsteriskBtn %></span>
                                    <span class="text-[10px] text-emerald-400 font-mono">core reload</span>
                                </div>
                                <p class="text-[11px] text-[var(--text-muted)]"><%= t.reloadAsteriskDesc %></p>
                                <button type="button" onclick="executeAsteriskReload()" id="reloadAsteriskBtn" class="mt-1 w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-lg py-2 px-3 text-xs flex items-center justify-center gap-2 cursor-pointer transition">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                    <span><%= t.reloadAsteriskBtn %></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Hardware Specifications Breakdown -->
                <div class="lg:col-span-2 panel-surface rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 mb-4">
                            <div class="flex items-center gap-2">
                                <svg class="text-blue-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                                <h3 class="text-sm font-bold text-white"><%= t.hardwareSpecs %></h3>
                            </div>
                            <span id="spec-uptime" class="text-xs font-mono text-zinc-400">-</span>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                            <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-1">
                                <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Processor Model & Cores</span>
                                <span id="spec-cpu-model" class="font-bold text-white font-mono">-</span>
                                <span id="spec-cpu-cores" class="text-[11px] text-[var(--text-secondary)] font-mono">- Cores Active</span>
                            </div>

                            <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-1">
                                <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Memory Breakdown (RAM & Swap)</span>
                                <div class="flex items-center justify-between font-mono">
                                    <span class="text-[var(--text-muted)]">Buffers/Cached:</span>
                                    <span id="spec-mem-cached" class="text-white">-</span>
                                </div>
                                <div class="flex items-center justify-between font-mono">
                                    <span class="text-[var(--text-muted)]">Swap Used:</span>
                                    <span id="spec-mem-swap" class="text-white">-</span>
                                </div>
                            </div>

                            <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-1">
                                <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Asterisk Telephony Telemetry</span>
                                <div class="flex items-center justify-between font-mono">
                                    <span class="text-[var(--text-muted)]">Version:</span>
                                    <span id="spec-asterisk-ver" class="text-white">-</span>
                                </div>
                                <div class="flex items-center justify-between font-mono">
                                    <span class="text-[var(--text-muted)]">Processed Calls:</span>
                                    <span id="spec-asterisk-calls" class="text-white">-</span>
                                </div>
                            </div>

                            <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-1">
                                <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Sokrat VoIP Runtime Engine</span>
                                <div class="flex items-center justify-between font-mono">
                                    <span class="text-[var(--text-muted)]">Node Version:</span>
                                    <span id="spec-node-ver" class="text-white">-</span>
                                </div>
                                <div class="flex items-center justify-between font-mono">
                                    <span class="text-[var(--text-muted)]">Process RSS / Heap:</span>
                                    <span id="spec-node-mem" class="text-white">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- USB Host Controllers & Hardware Bus Topology (PCI & Buses) -->
            <div class="panel-surface rounded-2xl p-5 flex flex-col">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-[var(--border-primary)] pb-3 mb-4">
                    <div class="flex items-center gap-2">
                        <div class="p-2 rounded-xl bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                        </div>
                        <div>
                            <h3 class="text-sm font-bold text-white"><%= t.usbControllersTitle %></h3>
                            <p class="text-xs text-[var(--text-muted)]"><%= isRtl ? 'بنية متحكمات PCI ونواقل USB ومنافذ المودم الفيزيائية لشرائح هواوي' : 'PCI host controllers, root hubs, bus hierarchy & physical modem endpoints for Huawei dongles' %></p>
                        </div>
                    </div>
                    <span id="usb-summary-badge" class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 shrink-0 font-mono">-</span>
                </div>

                <!-- PCI Controllers Sub-Section -->
                <div class="mb-5">
                    <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider block mb-3"><%= t.pciControllersLabel %></span>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="pci-controllers-container">
                        <div class="p-4 rounded-xl bg-black/20 border border-[var(--border-primary)] text-xs text-[var(--text-muted)]">Loading PCI controllers...</div>
                    </div>
                </div>

                <!-- Connected Hardware Devices & Huawei Modems on Bus -->
                <div>
                    <span class="text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider block mb-3"><%= t.usbDevicesLabel %></span>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="usb-devices-container">
                        <div class="p-4 rounded-xl bg-black/20 border border-[var(--border-primary)] text-xs text-[var(--text-muted)]">Loading USB bus topology...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================================= -->
        <!-- TAB 2: CORE SERVICES MANAGEMENT                               -->
        <!-- ============================================================= -->
        <div id="panel-services" class="hidden flex flex-col gap-6">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-bold text-white"><%= t.tabServices %></h3>
                    <p class="text-xs text-[var(--text-muted)]"><%= isRtl ? 'مراقبة وإعادة تشغيل الخدمات الحيوية المسؤولة عن الاتصالات والويب وقواعد البيانات' : 'Inspect and control vital daemon processes powering VoIP signaling, database, and web routing' %></p>
                </div>
                <button type="button" onclick="fetchServicesStatus()" class="panel-surface hover:bg-[var(--bg-hover)] text-white border border-[var(--border-primary)] rounded-xl px-3 py-1.5 text-xs font-bold flex items-center gap-2 cursor-pointer transition">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 4v6h-6"/><path d="M1 20v-6h6"/></svg>
                    <span><%= isRtl ? 'تحديث الخدمات' : 'Refresh Services' %></span>
                </button>
            </div>

            <!-- Autonomous Watchdog & Failover Alerts Banner -->
            <div class="panel-surface rounded-2xl p-5 border border-[var(--border-primary)] flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div class="flex items-center gap-3.5">
                    <div class="p-3 rounded-xl bg-red-500/10 text-red-400 border border-red-500/20 shrink-0">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h4 class="text-sm font-bold text-white"><%= isRtl ? 'المراقب الذكي وتنبيهات الأعطال' : 'Autonomous Watchdog & System Alerts' %></h4>
                            <span id="watchdog-status-pill" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-zinc-800 text-zinc-400 border border-zinc-700">Checking...</span>
                        </div>
                        <p class="text-xs text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'يراقب تعطل أستريسك وقاعدة البيانات ويرسل تنبيهات عبر تليجرام والإيميل مع نبضات مراقبة السيرفر' : 'Monitors PBX service crashes and sends instant alerts via Telegram & Email, with outbound heartbeat' %></p>
                    </div>
                </div>
                <div class="flex items-center gap-2 self-end md:self-center">
                    <button type="button" onclick="if(typeof openAlertsModal==='function')openAlertsModal();" class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-white bg-[var(--accent-color)] hover:bg-[#e0352b] transition cursor-pointer flex items-center gap-1.5">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 19.4 15z"/></svg>
                        <span><%= isRtl ? 'إعداد التنبيهات' : 'Configure Alerts' %></span>
                    </button>
                </div>
            </div>

            <!-- Services Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="services-grid-container">
                <!-- Populated dynamically via renderServicesCards() -->
                <div class="p-6 text-center text-zinc-500 font-mono text-xs col-span-full">Loading services telemetry...</div>
            </div>
        </div>

        <!-- ============================================================= -->
        <!-- TAB 3: STORAGE & BACKUPS (PC Export, GDrive, Retention)       -->
        <!-- ============================================================= -->
        <div id="panel-storage" class="hidden flex flex-col gap-6">
            
            <!-- Main Workspace Grid: PC Export & Google Drive Sync -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                
                <!-- Panel 1: Export Call History & Recordings to PC (ZIP Download) -->
                <div class="panel-surface rounded-2xl p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center gap-3 border-b border-[var(--border-primary)] pb-4 mb-5">
                            <div class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            </div>
                            <div>
                                <h3 class="text-base font-bold text-white"><%= t.pcExportTitle %></h3>
                                <p class="text-xs text-[var(--text-muted)]"><%= t.pcExportDesc %></p>
                            </div>
                        </div>

                        <form id="pcExportForm" onsubmit="handlePcExport(event)" class="flex flex-col gap-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="exportStartDate"><%= t.startDate %></label>
                                    <input type="date" id="exportStartDate" name="exportStartDate" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2 text-sm text-[var(--text-primary)] w-full">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="exportEndDate"><%= t.endDate %></label>
                                    <input type="date" id="exportEndDate" name="exportEndDate" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2 text-sm text-[var(--text-primary)] w-full">
                                </div>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="exportExtension"><%= t.extension %></label>
                                <select id="exportExtension" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2 text-sm text-[var(--text-primary)] w-full cursor-pointer">
                                    <option value="" selected><%= t.allExtensions %></option>
                                    <% roster.forEach(emp => { %>
                                        <option value="<%= emp.extension %>"><%= emp.extension %> - <%= emp.name %></option>
                                    <% }) %>
                                </select>
                            </div>

                            <div class="flex flex-col gap-2 pt-1">
                                <label class="inline-flex items-center gap-2.5 cursor-pointer text-xs font-semibold text-[var(--text-primary)]" for="includeCsv">
                                    <input type="checkbox" id="includeCsv" checked class="w-4 h-4 accent-emerald-500 rounded">
                                    <span><%= t.includeCsv %></span>
                                </label>
                                <label class="inline-flex items-center gap-2.5 cursor-pointer text-xs font-semibold text-[var(--text-primary)]" for="includeAudio">
                                    <input type="checkbox" id="includeAudio" checked class="w-4 h-4 accent-emerald-500 rounded">
                                    <span><%= t.includeAudio %></span>
                                </label>
                            </div>

                            <div class="pt-4 border-t border-[var(--border-primary)]/50 mt-2">
                                <button type="submit" id="downloadZipBtn" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold rounded-xl py-3 px-4 text-xs flex items-center justify-center gap-2 cursor-pointer transition">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    <span><%= t.downloadZipBtn %></span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Panel 2: Google Drive Cloud Backup -->
                <div class="panel-surface rounded-2xl p-6 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-4 mb-5 gap-3">
                            <div class="flex items-center gap-3">
                                <div class="p-2.5 rounded-xl bg-blue-500/10 text-blue-400 border border-blue-500/20 shrink-0">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 11 12 4 5 11"/><path d="M12 4v12"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-base font-bold text-white"><%= t.gdriveTitle %></h3>
                                    <p class="text-xs text-[var(--text-muted)]"><%= t.gdriveDesc %></p>
                                </div>
                            </div>
                            <span id="gdrive-status-badge" class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-zinc-800 text-zinc-400 border border-zinc-700 shrink-0"><%= t.disabled %></span>
                        </div>

                        <form id="gdriveSetupForm" onsubmit="handleGdriveSave(event)" class="flex flex-col gap-4">
                            <div class="flex items-center justify-between p-3 rounded-xl bg-black/20 border border-[var(--border-primary)]">
                                <span class="text-xs font-bold text-[var(--text-primary)]"><%= t.gdriveEnable %></span>
                                <input type="checkbox" id="gdriveEnabled" class="w-4 h-4 accent-blue-500 rounded cursor-pointer">
                            </div>

                            <div>
                                <label for="gdriveFolderName" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1"><%= t.gdriveFolder %></label>
                                <input type="text" id="gdriveFolderName" value="Sokrat-VoIP-Backups" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2 text-sm text-[var(--text-primary)] w-full font-mono">
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="gdriveSchedule"><%= t.gdriveSchedule %></label>
                                <select id="gdriveSchedule" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2 text-sm text-[var(--text-primary)] w-full cursor-pointer">
                                    <option value="daily" selected>Daily (At 02:00 AM)</option>
                                    <option value="weekly">Weekly (Sunday at 02:00 AM)</option>
                                    <option value="monthly">Monthly (1st of month)</option>
                                    <option value="manual">Manual Only</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1" for="gdriveCreds"><%= t.gdriveCreds %></label>
                                <textarea id="gdriveCreds" rows="3" placeholder='{"type": "service_account", "project_id": "...", ...}' class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl p-3 text-xs font-mono text-[var(--text-primary)] w-full"></textarea>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-[var(--border-primary)]/50">
                                <button type="submit" id="saveGdriveBtn" class="bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-xl py-2.5 px-3 text-xs flex items-center justify-center gap-2 cursor-pointer transition">
                                    <span><%= t.saveGdriveBtn %></span>
                                </button>
                                <button type="button" onclick="syncGdriveNow()" id="syncGdriveBtn" class="bg-blue-600 hover:bg-blue-500 text-white font-extrabold rounded-xl py-2.5 px-3 text-xs flex items-center justify-center gap-2 cursor-pointer transition">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                    <span><%= t.syncGdriveBtn %></span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Lower Section: Retention & Auto-Purge Manager -->
            <div class="panel-surface rounded-2xl p-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[var(--border-primary)] pb-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="p-2.5 rounded-xl bg-amber-500/10 text-amber-400 border border-amber-500/20 shrink-0">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-white"><%= t.purgeTitle %></h3>
                            <p class="text-xs text-[var(--text-muted)]"><%= t.purgeDesc %></p>
                        </div>
                    </div>
                    <button type="button" onclick="runPurgeNow()" id="runPurgeBtn" class="panel-surface hover:bg-red-500/10 text-red-400 border border-red-500/30 rounded-xl px-4 py-2 text-xs font-bold flex items-center gap-2 cursor-pointer transition shrink-0">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        <span><%= t.runPurgeBtn %></span>
                    </button>
                </div>

                <div class="flex flex-col gap-4">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <label for="purgeDaysSlider" class="text-xs font-bold text-[var(--text-secondary)] uppercase"><%= t.purgeDaysLabel %></label>
                                <div class="flex items-center gap-2">
                                    <input type="number" id="purgeDaysInput" min="1" max="3650" value="90" oninput="updatePurgeDays(this.value)" class="w-24 px-3 py-1 bg-black/40 border border-[var(--border-primary)] rounded-lg text-sm font-black text-amber-400 font-mono text-center focus:outline-none focus:border-amber-500">
                                    <span class="text-xs font-bold text-[var(--text-muted)]"><%= isRtl ? 'يوم' : 'Days' %></span>
                                </div>
                            </div>
                            <input type="range" id="purgeDaysSlider" min="7" max="3650" step="1" value="90" oninput="updatePurgeDays(this.value)" class="w-full h-2 bg-zinc-800 rounded-lg appearance-none cursor-pointer accent-amber-500">
                        </div>

                        <button type="button" onclick="savePurgePolicy()" class="bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-xl py-3 px-6 text-xs flex items-center justify-center gap-2 cursor-pointer transition shrink-0">
                            <span><%= t.savePurgeBtn %></span>
                        </button>
                    </div>

                    <!-- Quick Preset Buttons -->
                    <div class="flex items-center gap-2 flex-wrap pt-3 border-t border-[var(--border-primary)]/40">
                        <span class="text-[11px] font-bold text-[var(--text-muted)] uppercase"><%= isRtl ? 'المهل السريعة:' : 'Quick Presets:' %></span>
                        <button type="button" onclick="updatePurgeDays(30)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">30d (1m)</button>
                        <button type="button" onclick="updatePurgeDays(90)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">90d (3m)</button>
                        <button type="button" onclick="updatePurgeDays(180)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">180d (6m)</button>
                        <button type="button" onclick="updatePurgeDays(365)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">365d (1y)</button>
                        <button type="button" onclick="updatePurgeDays(730)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">730d (2y)</button>
                        <button type="button" onclick="updatePurgeDays(1095)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">1095d (3y)</button>
                        <button type="button" onclick="updatePurgeDays(1825)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">1825d (5y)</button>
                        <button type="button" onclick="updatePurgeDays(3650)" class="px-2.5 py-1 rounded-lg text-xs font-bold bg-zinc-800 hover:bg-zinc-700 text-zinc-300 border border-zinc-700 cursor-pointer transition">3650d (10y)</button>
                    </div>
                </div>
            </div>

        </div>

    </div>

    <!-- ============================================================= -->
    <!-- SERVICE RESTART CONFIRMATION MODAL                            -->
    <!-- ============================================================= -->
    <div id="serviceConfirmModal" class="fixed inset-0 z-[250] flex items-center justify-center bg-black/75 backdrop-blur-sm opacity-0 invisible transition-all duration-200 p-4" style="pointer-events:none">
        <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl w-full max-w-md overflow-hidden shadow-2xl">
            <div class="p-6">
                <div class="flex items-center gap-3 text-amber-400 mb-3">
                    <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <h3 class="text-base font-extrabold text-white" id="serviceConfirmModalTitle"><%= t.confirmRestartTitle %></h3>
                </div>
                <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-6" id="serviceConfirmModalDesc"><%= t.confirmRestartDesc %></p>
                <div class="grid grid-cols-2 gap-3">
                    <button type="button" onclick="closeServiceConfirmModal()" class="bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-xl py-2.5 px-4 text-xs cursor-pointer transition">
                        <%= isRtl ? 'إلغاء' : 'Cancel' %>
                    </button>
                    <button type="button" id="confirmServiceActionBtn" class="bg-red-600 hover:bg-red-500 text-white font-bold rounded-xl py-2.5 px-4 text-xs cursor-pointer transition">
                        <%= isRtl ? 'تأكيد' : 'Confirm' %>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Telemetry & Storage Management Client Script -->
    <script>
        // State & Polling Variables
        let telemetryPollTimer = null;
        let currentPollInterval = 5000;
        let cpuRamChartInstance = null;
        let netChannelsChartInstance = null;
        let pendingServiceAction = null;

        // Chart Data Buffers (Sliding 20 points)
        const MAX_POINTS = 20;
        const timeLabels = [];
        const cpuData = [];
        const ramData = [];
        const netRxData = [];
        const netTxData = [];
        const channelsData = [];

        function initSystemStoragePage() {
            // Restore saved active tab or URL param
            const urlParams = new URLSearchParams(window.location.search);
            const targetTab = urlParams.get('tab') || localStorage.getItem('activeStorageTab') || 'resources';
            switchStorageTab(targetTab);
            const savedRate = localStorage.getItem('telemetryRefreshRate');
            if (savedRate !== null) {
                currentPollInterval = parseInt(savedRate, 10);
            } else {
                currentPollInterval = 5000;
            }
            const refreshSelect = document.getElementById('telemetryRefreshRate');
            if (refreshSelect) refreshSelect.value = String(currentPollInterval);


            // Initialize ECharts
            initTelemetryCharts();

            // Date Pickers initialization
            if (window.flatpickr) {
                flatpickr("input[type='date'], input[name='startDate'], input[name='endDate'], input#exportStartDate, input#exportEndDate", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "F j, Y",
                    allowInput: true,
                    onReady: function(selectedDates, dateStr, instance) {
                        if (instance.altInput) {
                            var origId = instance.input.id || (instance.input.name ? instance.input.name + 'Input' : 'datePicker_' + Math.random().toString(36).substring(2, 7));
                            if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                            instance.input.id = origId + '_raw';
                            instance.altInput.id = origId;
                            instance.altInput.name = (instance.input.name || origId) + '_display';
                            instance.altInput.setAttribute('autocomplete', 'off');
                            var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                            instance.altInput.setAttribute('aria-label', ariaLabel);
                        }
                    }
                });
            }

            // Fetch initial telemetry and services data
            fetchTelemetryMetrics();
            fetchServicesStatus();
            fetchStorageInfo();

            // Start polling timer
            startTelemetryPolling();

            // Handle window resize for charts
            window.addEventListener('resize', () => {
                if (cpuRamChartInstance) cpuRamChartInstance.resize();
                if (netChannelsChartInstance) netChannelsChartInstance.resize();
            });

            // Pause polling when tab is hidden
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    stopTelemetryPolling();
                } else {
                    fetchTelemetryMetrics();
                    startTelemetryPolling();
                }
            });
        }

        // Resilient DOM ready guard
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSystemStoragePage);
        } else {
            initSystemStoragePage();
        }

        // Tab Switching Handler
        function switchStorageTab(tabId) {
            const tabs = ['resources', 'services', 'storage'];
            if (!tabs.includes(tabId)) tabId = 'resources';

            localStorage.setItem('activeStorageTab', tabId);

            tabs.forEach(t => {
                const panel = document.getElementById('panel-' + t);
                const btn = document.getElementById('tab-btn-' + t);
                if (panel) {
                    if (t === tabId) panel.classList.remove('hidden');
                    else panel.classList.add('hidden');
                }
                if (btn) {
                    if (t === tabId) btn.classList.add('active');
                    else btn.classList.remove('active');
                }
            });

            if (tabId === 'resources') {
                setTimeout(() => {
                    if (cpuRamChartInstance) cpuRamChartInstance.resize();
                    if (netChannelsChartInstance) netChannelsChartInstance.resize();
                }, 100);
            }
            if (tabId === 'services') {
                fetchServicesStatus();
            }
        }

        // Initialize ECharts
        function initTelemetryCharts() {
            const chart1El = document.getElementById('cpuRamChart');
            const chart2El = document.getElementById('netChannelsChart');

            const isDark = !document.documentElement.classList.contains('light-theme');
            const textColor = isDark ? '#a1a1aa' : '#71717a';
            const splitColor = isDark ? 'rgba(255, 255, 255, 0.05)' : 'rgba(0, 0, 0, 0.05)';

            if (chart1El && window.echarts) {
                cpuRamChartInstance = echarts.init(chart1El);
                cpuRamChartInstance.setOption({
                    animation: false,
                    tooltip: { trigger: 'axis' },
                    grid: { top: 20, right: 15, bottom: 25, left: 35 },
                    xAxis: {
                        type: 'category',
                        data: timeLabels,
                        axisLabel: { color: textColor, fontSize: 10 },
                        axisLine: { lineStyle: { color: splitColor } }
                    },
                    yAxis: {
                        type: 'value',
                        min: 0,
                        max: 100,
                        axisLabel: { color: textColor, fontSize: 10, formatter: '{value}%' },
                        splitLine: { lineStyle: { color: splitColor } }
                    },
                    series: [
                        {
                            name: 'CPU',
                            type: 'line',
                            smooth: true,
                            showSymbol: false,
                            data: cpuData,
                            lineStyle: { width: 2, color: '#a855f7' },
                            areaStyle: {
                                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                    { offset: 0, color: 'rgba(168, 85, 247, 0.35)' },
                                    { offset: 1, color: 'rgba(168, 85, 247, 0.02)' }
                                ])
                            }
                        },
                        {
                            name: 'RAM',
                            type: 'line',
                            smooth: true,
                            showSymbol: false,
                            data: ramData,
                            lineStyle: { width: 2, color: '#10b981' },
                            areaStyle: {
                                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                    { offset: 0, color: 'rgba(16, 185, 129, 0.35)' },
                                    { offset: 1, color: 'rgba(16, 185, 129, 0.02)' }
                                ])
                            }
                        }
                    ]
                });
            }

            if (chart2El && window.echarts) {
                netChannelsChartInstance = echarts.init(chart2El);
                netChannelsChartInstance.setOption({
                    animation: false,
                    tooltip: { trigger: 'axis' },
                    grid: { top: 20, right: 35, bottom: 25, left: 40 },
                    xAxis: {
                        type: 'category',
                        data: timeLabels,
                        axisLabel: { color: textColor, fontSize: 10 },
                        axisLine: { lineStyle: { color: splitColor } }
                    },
                    yAxis: [
                        {
                            type: 'value',
                            name: 'KB/s',
                            axisLabel: { color: textColor, fontSize: 10 },
                            splitLine: { lineStyle: { color: splitColor } }
                        },
                        {
                            type: 'value',
                            name: 'Calls',
                            min: 0,
                            minInterval: 1,
                            axisLabel: { color: '#f59e0b', fontSize: 10 },
                            splitLine: { show: false }
                        }
                    ],
                    series: [
                        {
                            name: 'Net RX (KB/s)',
                            type: 'line',
                            smooth: true,
                            showSymbol: false,
                            data: netRxData,
                            lineStyle: { width: 2, color: '#3b82f6' }
                        },
                        {
                            name: 'Net TX (KB/s)',
                            type: 'line',
                            smooth: true,
                            showSymbol: false,
                            data: netTxData,
                            lineStyle: { width: 2, color: '#06b6d4' }
                        },
                        {
                            name: 'Active Calls',
                            type: 'line',
                            yAxisIndex: 1,
                            smooth: true,
                            showSymbol: false,
                            data: channelsData,
                            lineStyle: { width: 2, color: '#f59e0b', type: 'dashed' }
                        }
                    ]
                });
            }
        }

        // Fetch Live Telemetry Metrics
        async function fetchTelemetryMetrics() {
            try {
                const res = await fetch('/api/system/resources');
                const data = await res.json();
                if (!data.success) return;

                // 1. CPU & Load
                const cpuPct = data.cpu ? data.cpu.usagePct : 0;
                const cpuLoad = (data.cpu && data.cpu.loadAvg) ? data.cpu.loadAvg.join(', ') : '-';
                const cores = data.cpu ? data.cpu.cores : 1;

                document.getElementById('stat-cpu-pct').textContent = cpuPct + ' %';
                document.getElementById('stat-cpu-load').textContent = 'Load: ' + cpuLoad;
                document.getElementById('stat-cpu-bar').style.width = Math.min(100, Math.max(0, cpuPct)) + '%';

                // 2. RAM Memory
                const ramPct = data.memory ? data.memory.usedPct : 0;
                const availGb = data.memory ? (data.memory.availableBytes / (1024 * 1024 * 1024)).toFixed(1) : 0;
                const totalGb = data.memory ? (data.memory.totalBytes / (1024 * 1024 * 1024)).toFixed(1) : 0;

                document.getElementById('stat-ram-pct').textContent = ramPct + ' %';
                document.getElementById('stat-ram-avail').textContent = availGb + ' GB free / ' + totalGb + ' GB';
                const ramBar = document.getElementById('stat-ram-bar');
                ramBar.style.width = Math.min(100, Math.max(0, ramPct)) + '%';
                if (ramPct > 85) ramBar.className = 'h-full bg-red-500 transition-all duration-500';
                else if (ramPct > 70) ramBar.className = 'h-full bg-amber-500 transition-all duration-500';
                else ramBar.className = 'h-full bg-emerald-500 transition-all duration-500';

                // 3. Disk Root Usage
                if (data.disk) {
                    const diskUsedPct = data.disk.usedPct || 0;
                    document.getElementById('disk-used-pct').textContent = diskUsedPct + ' %';
                    document.getElementById('disk-free-text').textContent = (data.disk.freeGb || 0) + ' GB free';
                    document.getElementById('disk-progress-bar').style.width = diskUsedPct + '%';
                }

                // 4. Asterisk Telephony Core
                if (data.asterisk) {
                    const isOnline = data.asterisk.status === 'online';
                    const statDot = document.getElementById('stat-asterisk-dot');
                    const statStatus = document.getElementById('stat-asterisk-status');
                    statStatus.textContent = isOnline ? 'Online' : 'Offline';
                    statStatus.className = isOnline ? 'text-lg font-black text-white font-mono' : 'text-lg font-black text-red-400 font-mono';
                    statDot.className = isOnline ? 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse shrink-0' : 'w-2.5 h-2.5 rounded-full bg-red-500 shrink-0';
                    document.getElementById('stat-asterisk-sub').textContent = (data.asterisk.activeChannels || 0) + ' channels | ' + (data.asterisk.activeCalls || 0) + ' active calls';
                }

                // 5. Hardware Specifications Breakdown
                if (data.cpu) {
                    document.getElementById('spec-cpu-model').textContent = data.cpu.model || '-';
                    document.getElementById('spec-cpu-cores').textContent = (data.cpu.cores || 1) + ' CPU Cores Active';
                }
                if (data.memory) {
                    const cachedMb = Math.round((data.memory.cachedBytes + data.memory.buffersBytes) / (1024 * 1024));
                    const swapUsedMb = Math.round(data.memory.swapUsedBytes / (1024 * 1024));
                    const swapTotalMb = Math.round(data.memory.swapTotalBytes / (1024 * 1024));
                    document.getElementById('spec-mem-cached').textContent = cachedMb + ' MB';
                    document.getElementById('spec-mem-swap').textContent = swapUsedMb + ' MB / ' + swapTotalMb + ' MB';
                }
                if (data.asterisk) {
                    document.getElementById('spec-asterisk-ver').textContent = data.asterisk.version || '-';
                    document.getElementById('spec-asterisk-calls').textContent = (data.asterisk.callsProcessed || 0) + ' calls';
                }
                if (data.node) {
                    document.getElementById('spec-node-ver').textContent = data.node.version + ' (PID: ' + data.node.pid + ')';
                    document.getElementById('spec-node-mem').textContent = data.node.memoryRssMb + ' MB / ' + data.node.memoryHeapUsedMb + ' MB';
                }
                if (data.systemUptimeSec) {
                    const hours = Math.floor(data.systemUptimeSec / 3600);
                    const mins = Math.floor((data.systemUptimeSec % 3600) / 60);
                    document.getElementById('spec-uptime').textContent = 'System Uptime: ' + hours + 'h ' + mins + 'm';
                }
                // 5b. Render USB Host Controllers & Hardware Bus Topology
                if (data.usb) {
                    renderUsbTopology(data.usb);
                }

                // 6. Push to sliding chart series
                const nowLabel = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                timeLabels.push(nowLabel);
                cpuData.push(cpuPct);
                ramData.push(ramPct);

                const rxKb = data.network ? Math.round(data.network.rxBytesPerSec / 1024) : 0;
                const txKb = data.network ? Math.round(data.network.txBytesPerSec / 1024) : 0;
                netRxData.push(rxKb);
                netTxData.push(txKb);
                channelsData.push(data.asterisk ? data.asterisk.activeCalls || 0 : 0);

                if (timeLabels.length > MAX_POINTS) {
                    timeLabels.shift();
                    cpuData.shift();
                    ramData.shift();
                    netRxData.shift();
                    netTxData.shift();
                    channelsData.shift();
                }

                document.getElementById('chart-cpu-ram-legend').textContent = 'CPU: ' + cpuPct + '% | RAM: ' + ramPct + '%';
                document.getElementById('chart-net-legend').textContent = 'RX: ' + rxKb + ' KB/s | TX: ' + txKb + ' KB/s';

                if (cpuRamChartInstance) {
                    cpuRamChartInstance.setOption({
                        xAxis: { data: timeLabels },
                        series: [{ data: cpuData }, { data: ramData }]
                    });
                }
                if (netChannelsChartInstance) {
                    netChannelsChartInstance.setOption({
                        xAxis: { data: timeLabels },
                        series: [{ data: netRxData }, { data: netTxData }, { data: channelsData }]
                    });
                }

            } catch (err) {
                console.error('Failed to fetch telemetry:', err);
            }
        }

        // Fetch Core Services Status
        async function fetchServicesStatus() {
            try {
                const res = await fetch('/api/system/services');
                const data = await res.json();
                if (!data.success || !data.services) return;
                renderServicesCards(data.services);
                fetchWatchdogStatus();
            } catch (err) {
                console.error('Failed to fetch services:', err);
            }
        }

        async function fetchWatchdogStatus() {
            try {
                const res = await fetch('/api/settings/alerts/watchdog-status');
                const data = await res.json();
                const pill = document.getElementById('watchdog-status-pill');
                if (pill && data.success && data.status) {
                    if (data.status.active) {
                        pill.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 flex items-center gap-1';
                        pill.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active (PID: ' + (data.status.pid || '-') + ')';
                    } else {
                        pill.className = 'text-[10px] font-bold px-2 py-0.5 rounded-full bg-red-500/15 text-red-400 border border-red-500/30';
                        pill.textContent = 'Inactive';
                    }
                }
            } catch (_) {}
        }

        // Render Services Cards into DOM
        function renderServicesCards(services) {
            const container = document.getElementById('services-grid-container');
            if (!container) return;

            let html = '';
            services.forEach(s => {
                const isActive = s.activeState === 'active';
                const isRunning = s.subState === 'running';

                let badgeClass = 'bg-zinc-800 text-zinc-400 border-zinc-700';
                let dotClass = 'bg-zinc-500';
                let statusLabel = s.activeState;

                if (isActive) {
                    badgeClass = 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30';
                    dotClass = 'bg-emerald-500 animate-pulse';
                    statusLabel = '<%= t.running %>';
                } else if (s.activeState === 'failed') {
                    badgeClass = 'bg-red-500/15 text-red-400 border-red-500/30';
                    dotClass = 'bg-red-500';
                    statusLabel = '<%= t.failed %>';
                } else {
                    badgeClass = 'bg-zinc-800 text-zinc-400 border-zinc-700';
                    dotClass = 'bg-zinc-500';
                    statusLabel = '<%= t.stopped %>';
                }

                html += `
                <div class="panel-surface rounded-2xl p-5 flex flex-col justify-between">
                    <div>
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div>
                                <h4 class="text-sm font-bold text-white">${escapeHtml(s.name)}</h4>
                                <span class="text-[10px] text-[var(--text-muted)] font-mono">${escapeHtml(s.unit)}</span>
                            </div>
                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold border ${badgeClass} shrink-0">
                                <span class="w-1.5 h-1.5 rounded-full ${dotClass}"></span>
                                <span>${escapeHtml(statusLabel)}</span>
                            </span>
                        </div>
                        <p class="text-xs text-[var(--text-muted)] mb-4">${escapeHtml(s.desc)}</p>

                        <div class="p-3 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col gap-1.5 text-xs font-mono mb-4">
                            <div class="flex items-center justify-between">
                                <span class="text-[var(--text-muted)]">Main PID:</span>
                                <span class="text-white">${s.pid > 0 ? s.pid : '-'}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-[var(--text-muted)]">Memory RSS:</span>
                                <span class="text-white">${s.memoryMb ? s.memoryMb + ' MB' : '-'}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-[var(--text-muted)]">Active Since:</span>
                                <span class="text-white truncate max-w-[180px]">${escapeHtml(s.activeSince || '-')}</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 pt-3 border-t border-[var(--border-primary)]">
                        ${s.id === 'asterisk' ? `
                            <button type="button" onclick="handleServiceAction('asterisk', 'reload')" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-xl py-2 px-3 text-xs flex items-center justify-center gap-1.5 cursor-pointer transition">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                <span><%= t.reloadBtn %></span>
                            </button>
                            <button type="button" onclick="confirmServiceAction('asterisk', 'restart', 'Asterisk PBX Core')" class="flex-1 bg-red-600/80 hover:bg-red-500 text-white font-bold rounded-xl py-2 px-3 text-xs flex items-center justify-center gap-1.5 cursor-pointer transition">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                <span><%= t.restartBtn %></span>
                            </button>
                        ` : s.id === 'database' ? `
                            <button type="button" onclick="confirmServiceAction('database', 'restart', 'MariaDB / MySQL')" class="w-full bg-amber-600/80 hover:bg-amber-500 text-white font-bold rounded-xl py-2 px-3 text-xs flex items-center justify-center gap-1.5 cursor-pointer transition">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                <span><%= t.restartBtn %></span>
                            </button>
                        ` : s.id === 'stt-worker' ? `
                            ${isActive ? `
                                <button type="button" onclick="handleServiceAction('stt-worker', 'restart')" class="flex-1 bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-xl py-2 px-3 text-xs cursor-pointer transition"><%= t.restartBtn %></button>
                                <button type="button" onclick="handleServiceAction('stt-worker', 'stop')" class="flex-1 bg-red-600/80 hover:bg-red-500 text-white font-bold rounded-xl py-2 px-3 text-xs cursor-pointer transition"><%= t.stopBtn %></button>
                            ` : `
                                <button type="button" onclick="handleServiceAction('stt-worker', 'start')" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl py-2 px-3 text-xs cursor-pointer transition"><%= t.startBtn %></button>
                            `}
                        ` : `
                            <button type="button" onclick="handleServiceAction('${s.id}', 'restart')" class="w-full bg-zinc-800 hover:bg-zinc-700 text-white font-bold rounded-xl py-2 px-3 text-xs flex items-center justify-center gap-1.5 cursor-pointer transition">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                                <span><%= t.restartBtn %></span>
                            </button>
                        `}
                    </div>
                </div>
                `;
            });

            container.innerHTML = html;
        }
        // Render USB Host Controllers & Hardware Bus Topology
        function renderUsbTopology(usb) {
            if (!usb) return;

            // Summary badge
            const pciCount = usb.pciControllers ? usb.pciControllers.length : 0;
            const rootCount = usb.rootHubs ? usb.rootHubs.length : 0;
            const devCount = usb.devices ? usb.devices.length : 0;
            const badge = document.getElementById('usb-summary-badge');
            if (badge) {
                badge.textContent = `${pciCount} PCI Controller(s) | ${rootCount} Root Hub(s) | ${devCount} USB Device(s)`;
            }

            // 1. PCI Host Controllers
            const pciContainer = document.getElementById('pci-controllers-container');
            if (pciContainer && usb.pciControllers) {
                let pciHtml = '';
                usb.pciControllers.forEach(p => {
                    pciHtml += `
                    <div class="p-3.5 rounded-xl bg-black/20 border border-[var(--border-primary)] flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="px-2 py-0.5 rounded-md bg-cyan-500/15 text-cyan-400 font-mono font-bold text-[11px] border border-cyan-500/30">[${escapeHtml(p.slot)}]</span>
                                <span class="text-[10px] font-mono text-[var(--text-muted)]">IRQ ${escapeHtml(p.irq || '-')}</span>
                            </div>
                            <h4 class="text-xs font-bold text-white mb-2 leading-snug">${escapeHtml(p.description)}</h4>
                        </div>
                        <div class="flex items-center justify-between text-[11px] font-mono pt-2 border-t border-[var(--border-primary)]/40 text-[var(--text-secondary)]">
                            <span>Driver: <strong class="text-emerald-400">${escapeHtml(p.driver || 'unbound')}</strong></span>
                            <span>Mem: ${escapeHtml(p.memory || '-')}</span>
                        </div>
                    </div>
                    `;
                });
                pciContainer.innerHTML = pciHtml || '<div class="text-xs text-[var(--text-muted)]">No PCI USB controllers detected</div>';
            }

            // 2. Connected Devices & Huawei Modems on Bus
            const usbContainer = document.getElementById('usb-devices-container');
            if (usbContainer && usb.devices) {
                let usbHtml = '';
                usb.devices.forEach(d => {
                    const isModem = (d.vendorId === '12d1' || (d.ttys && d.ttys.length > 0) || (d.interfaces && d.interfaces.some(i => i.driver === 'option')));
                    const cardBorder = isModem ? 'border-cyan-500/40 bg-cyan-950/10' : 'border-[var(--border-primary)] bg-black/20';

                    let ttyBadges = '';
                    if (d.ttys && d.ttys.length > 0) {
                        ttyBadges = d.ttys.map(t => `<span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] font-mono font-bold">/dev/${escapeHtml(t)}</span>`).join(' ');
                    } else {
                        ttyBadges = '<span class="text-[10px] text-[var(--text-muted)] font-mono">None</span>';
                    }

                    let driverBadges = '';
                    if (d.interfaces && d.interfaces.length > 0) {
                        const uniqueDrivers = [...new Set(d.interfaces.map(i => i.driver).filter(Boolean))];
                        driverBadges = uniqueDrivers.map(drv => `<span class="px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-300 text-[10px] font-mono">${escapeHtml(drv)}</span>`).join(' ');
                    } else {
                        driverBadges = '<span class="text-[10px] text-[var(--text-muted)] font-mono">unbound</span>';
                    }

                    usbHtml += `
                    <div class="p-3.5 rounded-xl border ${cardBorder} flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-2">
                                <span class="px-2 py-0.5 rounded-md bg-purple-500/15 text-purple-400 font-mono font-bold text-[10px] border border-purple-500/30">Bus Path: ${escapeHtml(d.busPath)}</span>
                                <span class="text-[10px] font-mono text-[var(--text-muted)]">${escapeHtml(d.vendorProduct)}</span>
                            </div>
                            <h4 class="text-xs font-bold text-white mb-2 leading-snug flex items-center gap-1.5">
                                ${isModem ? '<span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse shrink-0"></span>' : ''}
                                <span>${escapeHtml(d.name)}</span>
                            </h4>
                            <div class="flex items-center gap-3 text-[10px] font-mono text-[var(--text-secondary)] mb-3">
                                <span>Speed: <strong class="text-white">${escapeHtml(d.speed)}</strong></span>
                                <span>Power: <strong class="text-white">${escapeHtml(d.maxPower)}</strong></span>
                            </div>
                        </div>

                        <div class="pt-2.5 border-t border-[var(--border-primary)]/40 flex flex-col gap-2">
                            <div>
                                <span class="text-[10px] text-[var(--text-muted)] font-bold uppercase block mb-1">Kernel Drivers:</span>
                                <div class="flex items-center gap-1 flex-wrap">${driverBadges}</div>
                            </div>
                            <div>
                                <span class="text-[10px] text-[var(--text-muted)] font-bold uppercase block mb-1">Serial Ports:</span>
                                <div class="flex items-center gap-1 flex-wrap">${ttyBadges}</div>
                            </div>
                        </div>
                    </div>
                    `;
                });
                usbContainer.innerHTML = usbHtml || '<div class="text-xs text-[var(--text-muted)]">No USB devices detected on bus</div>';
            }
        }


        // HTML escaping helper
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Confirm Modal for Critical Actions
        function confirmServiceAction(serviceId, action, serviceName) {
            pendingServiceAction = { serviceId, action };
            const modal = document.getElementById('serviceConfirmModal');
            document.getElementById('serviceConfirmModalTitle').textContent = '<%= t.confirmRestartTitle %>: ' + serviceName;
            modal.classList.remove('opacity-0', 'invisible');
            modal.style.pointerEvents = 'auto';

            document.getElementById('confirmServiceActionBtn').onclick = () => {
                closeServiceConfirmModal();
                handleServiceAction(serviceId, action);
            };
        }

        function closeServiceConfirmModal() {
            const modal = document.getElementById('serviceConfirmModal');
            modal.classList.add('opacity-0', 'invisible');
            modal.style.pointerEvents = 'none';
            pendingServiceAction = null;
        }

        // Execute Service Action API call
        async function handleServiceAction(serviceId, action) {
            try {
                showToast(`Executing ${action} on ${serviceId}...`, 'info');
                const res = await fetch('/api/system/service-action', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ serviceId, action })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'Action executed successfully', 'success');
                    setTimeout(() => {
                        fetchServicesStatus();
                        fetchTelemetryMetrics();
                    }, 2000);
                } else {
                    showToast(data.error || 'Action failed', 'error');
                }
            } catch (err) {
                showToast('Network error: ' + err.message, 'error');
            }
        }

        // Flush RAM Caches
        async function executeDropCaches() {
            const btn = document.getElementById('dropCachesBtn');
            if (btn) btn.disabled = true;
            showToast('<%= t.reclaimingMemory %>', 'info');

            try {
                const res = await fetch('/api/system/drop-caches', { method: 'POST' });
                const data = await res.json();
                if (btn) btn.disabled = false;
                if (data.success) {
                    showToast(data.message || 'Caches flushed successfully', 'success');
                    fetchTelemetryMetrics();
                } else {
                    showToast(data.error || 'Failed to flush caches', 'error');
                }
            } catch (err) {
                if (btn) btn.disabled = false;
                showToast('Error: ' + err.message, 'error');
            }
        }

        // Asterisk Core Reload
        async function executeAsteriskReload() {
            const btn = document.getElementById('reloadAsteriskBtn');
            if (btn) btn.disabled = true;
            showToast('<%= t.reloadingAsterisk %>', 'info');

            try {
                const res = await fetch('/api/system/asterisk-reload', { method: 'POST' });
                const data = await res.json();
                if (btn) btn.disabled = false;
                if (data.success) {
                    showToast(data.message || 'Asterisk reloaded successfully', 'success');
                    fetchTelemetryMetrics();
                } else {
                    showToast(data.error || 'Reload failed', 'error');
                }
            } catch (err) {
                if (btn) btn.disabled = false;
                showToast('Error: ' + err.message, 'error');
            }
        }

        // Polling Timer Management
        function startTelemetryPolling() {
            stopTelemetryPolling();
            if (currentPollInterval > 0) {
                telemetryPollTimer = setInterval(fetchTelemetryMetrics, currentPollInterval);
            }
        }

        function stopTelemetryPolling() {
            if (telemetryPollTimer) {
                clearInterval(telemetryPollTimer);
                telemetryPollTimer = null;
            }
        }

        function updateRefreshInterval(val) {
            currentPollInterval = parseInt(val, 10);
            if (isNaN(currentPollInterval)) currentPollInterval = 5000;
            localStorage.setItem('telemetryRefreshRate', String(currentPollInterval));
            startTelemetryPolling();
        }

        function triggerImmediateRefresh() {
            const spinner = document.getElementById('refresh-spinner');
            if (spinner) spinner.classList.add('animate-spin');
            Promise.all([fetchTelemetryMetrics(), fetchServicesStatus(), fetchStorageInfo()]).finally(() => {
                setTimeout(() => {
                    if (spinner) spinner.classList.remove('animate-spin');
                }, 500);
            });
        }

        // Existing Storage & Backups Functions
        function fetchStorageInfo() {
            fetch('/api/storage/info')
                .then(res => res.json())
                .then(data => {
                    if (!data.success) return;
                    
                    // 1. Disk usage
                    const usedPct = data.disk ? data.disk.usedPct : 0;
                    const freeGb = data.disk ? data.disk.freeGb : 0;
                    document.getElementById('disk-used-pct').textContent = usedPct + ' %';
                    document.getElementById('disk-free-text').textContent = freeGb + ' GB free';
                    document.getElementById('disk-progress-bar').style.width = usedPct + '%';
                    
                    // 2. Recordings & Database
                    if (data.settings) {
                        const purgeDaysSlider = document.getElementById('purgeDaysSlider');
                        const purgeDaysInput = document.getElementById('purgeDaysInput');
                        if (purgeDaysSlider) purgeDaysSlider.value = data.settings.auto_purge_days;
                        if (purgeDaysInput) purgeDaysInput.value = data.settings.auto_purge_days;

                        const gdriveEnabled = document.getElementById('gdriveEnabled');
                        const gdriveFolderName = document.getElementById('gdriveFolderName');
                        const gdriveSchedule = document.getElementById('gdriveSchedule');
                        const gdriveCreds = document.getElementById('gdriveCreds');

                        if (gdriveEnabled) gdriveEnabled.checked = !!data.settings.gdrive_enabled;
                        if (gdriveFolderName) gdriveFolderName.value = data.settings.gdrive_folder_name || 'Sokrat-VoIP-Backups';
                        if (gdriveSchedule) gdriveSchedule.value = data.settings.auto_backup_schedule || 'daily';
                        if (gdriveCreds && data.settings.gdrive_credentials) {
                            gdriveCreds.value = data.settings.gdrive_credentials;
                        }
                        if (badge) {
                            badge.textContent = data.settings.gdrive_enabled ? 'Active' : 'Disabled';
                            badge.className = data.settings.gdrive_enabled 
                                ? 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30'
                                : 'px-2.5 py-1 rounded-full text-[11px] font-bold bg-zinc-800 text-zinc-400 border border-zinc-700';
                        }
                    }
                })
                .catch(err => console.error('Failed to fetch storage info:', err));
        }

        function handlePcExport(e) {
            e.preventDefault();
            const btn = document.getElementById('downloadZipBtn');
            btn.disabled = true;
            btn.querySelector('span').textContent = '<%= t.processing %>';

            const startDate = (document.getElementById('exportStartDate_raw') || document.getElementById('exportStartDate')).value;
            const endDate = (document.getElementById('exportEndDate_raw') || document.getElementById('exportEndDate')).value;
            const extension = document.getElementById('exportExtension').value;
            const includeAudio = document.getElementById('includeAudio').checked;
            const includeCsv = document.getElementById('includeCsv').checked;

            const url = `/api/storage/export/pc?startDate=${startDate}&endDate=${endDate}&extension=${extension}&includeAudio=${includeAudio}&includeCsv=${includeCsv}`;
            window.location.href = url;

            setTimeout(() => {
                btn.disabled = false;
                btn.querySelector('span').textContent = '<%= t.downloadZipBtn %>';
            }, 3000);
        }

        function handleGdriveSave(e) {
            e.preventDefault();
            const enabled = document.getElementById('gdriveEnabled').checked;
            const folderName = document.getElementById('gdriveFolderName').value.trim();
            const schedule = document.getElementById('gdriveSchedule').value;
            const creds = document.getElementById('gdriveCreds').value.trim();

            fetch('/api/storage/gdrive/setup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ gdrive_enabled: enabled, gdrive_folder_name: folderName, auto_backup_schedule: schedule, gdrive_credentials: creds })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast('<%= t.savedSuccess %>', 'success');
                    fetchStorageInfo();
                } else showToast(data.error || '<%= t.failed %>', 'error');
            });
        }

        function syncGdriveNow() {
            const btn = document.getElementById('syncGdriveBtn');
            btn.disabled = true;
            fetch('/api/storage/gdrive/sync', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    if (data.success) {
                        showToast(data.message || 'Google Drive Sync completed!', 'success');
                        fetchStorageInfo();
                    } else showToast(data.error || 'Sync failed', 'error');
                })
                .catch(err => {
                    btn.disabled = false;
                    showToast('Network error: ' + err.message, 'error');
                });
        }

        function savePurgePolicy() {
            const input = document.getElementById('purgeDaysInput');
            const slider = document.getElementById('purgeDaysSlider');
            const days = input ? input.value : (slider ? slider.value : 90);
            fetch('/api/storage/purge-settings', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ auto_purge_days: parseInt(days, 10) })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast('<%= t.savedSuccess %>', 'success');
                    fetchStorageInfo();
                } else showToast(data.error || '<%= t.failed %>', 'error');
            });
        }
        function updatePurgeDays(val) {
            const parsed = parseInt(val, 10);
            if (isNaN(parsed) || parsed < 1) return;
            const days = Math.min(3650, parsed);
            const slider = document.getElementById('purgeDaysSlider');
            const input = document.getElementById('purgeDaysInput');
            if (slider) slider.value = days;
            if (input) input.value = days;
        }


        function runPurgeNow() {
            if (!confirm('Permanently delete audio recordings older than the specified days?')) return;
            const btn = document.getElementById('runPurgeBtn');
            btn.disabled = true;
            fetch('/api/storage/purge', { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    btn.disabled = false;
                    if (data.success) {
                        showToast(data.message || 'Cleanup completed!', 'success');
                        fetchStorageInfo();
                    } else showToast(data.error || 'Cleanup failed', 'error');
                });
        }
    </script>
</body>
</html>

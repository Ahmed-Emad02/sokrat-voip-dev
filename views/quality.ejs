%>
<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') document.documentElement.classList.add('light-theme');
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - <%= t.title %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <script src="/js/tailwindcss-browser.js"></script>
    <style>
        :root {
            --bg-primary: #000000; --bg-secondary: #0c0c0e; --bg-hover: #1e1e24;
            --border-primary: #18181c; --text-primary: #f4f4f5; --text-secondary: #a1a1aa;
            --text-muted: #8e8e93; --accent-color: #e53e3e; --accent-hover: #fc8181;
        }
        body.light-theme {
            --bg-primary: #f4f4f6; --bg-secondary: #ffffff; --bg-hover: #e4e4e9;
            --border-primary: #e4e4e9; --text-primary: #18181b; --text-secondary: #3f3f46;
            --text-muted: #71717a; --accent-color: #b91c1c; --accent-hover: #991b1b;
        }
        body { font-family: 'JetBrains Mono', 'Cairo', monospace; background: var(--bg-primary); color: var(--text-primary); }
        /* The shared sidebar injects a hover "shutter" pseudo-element into every
           button. These controls use their own flat/solid styling. */
        .q-table-row::before, .q-player-btn::before, .q-player-mute::before,
        .q-filter button::before, .q-mode button::before, .q-mini-btn::before, .q-tab::before, .q-btn::before, .q-provider::before {
            content: none !important;
            display: none !important;
        }
        .q-table-row { border-radius: 0 !important; }
        #qtab-review h2, #qtab-profiles h2, #qtab-agents h2, #qtab-settings h2 { font-size: .9rem !important; }
        #reviewDrawerTitle { font-size: 1rem !important; }
        .q-modal h3 { font-size: .95rem !important; }
        .panel { background: var(--bg-secondary); border: 1px solid var(--border-primary); }
        .q-tab { padding: .55rem .9rem; border-radius: .65rem; font-size: .75rem; font-weight: 800; color: var(--text-secondary); border: 1px solid transparent; cursor: pointer; background: transparent; }
        .q-tab.active { background: var(--accent-color); color: #fff; border-color: var(--accent-color); }
        .q-input { width: 100%; background: var(--bg-primary); border: 1px solid var(--border-primary); color: var(--text-primary); border-radius: .55rem; padding: .5rem .65rem; font-size: .75rem; }
        .q-btn { padding: .5rem .85rem; border-radius: .55rem; font-size: .72rem; font-weight: 800; cursor: pointer; border: 1px solid var(--border-primary); color: var(--text-primary); background: var(--bg-hover); }
        .q-btn-primary { background: var(--accent-color); border-color: var(--accent-color); color: #fff; }
        .q-btn:disabled { opacity: .45; cursor: not-allowed; }
        .q-btn-danger { background: #7f1d1d; border-color: #991b1b; color: #fff; }
        .q-table th { text-align: start; padding: .6rem .5rem; color: var(--text-muted); font-size: .65rem; text-transform: uppercase; letter-spacing: .04em; }
        .q-table td { padding: .65rem .5rem; border-top: 1px solid var(--border-primary); font-size: .75rem; vertical-align: top; }
        .q-modal { position: fixed; inset: 0; background: rgba(0,0,0,.65); display: none; align-items: center; justify-content: center; padding: 1rem; z-index: 100; }
        .q-modal.open { display: flex; }
        .q-badge-pass { background: rgba(16,185,129,.12); color: #34d399; border: 1px solid rgba(16,185,129,.3); }
        .q-badge-fail { background: rgba(239,68,68,.12); color: #f87171; border: 1px solid rgba(239,68,68,.3); }
        .q-badge { padding: .2rem .45rem; border-radius: .35rem; font-size: .62rem; font-weight: 900; }
        .q-commandbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: .85rem 1rem; border: 1px solid var(--border-primary); border-radius: .9rem; background: var(--bg-secondary); margin-bottom: .85rem; }
        .q-metrics { display: flex; align-items: stretch; gap: 1.4rem; flex-wrap: wrap; }
        .q-metric { min-width: 5.2rem; }
        .q-metric-label { font-size: .56rem; color: var(--text-muted); font-weight: 800; text-transform: uppercase; letter-spacing: .05em; }
        .q-metric-value { font-size: 1.15rem; font-weight: 900; margin-top: .15rem; line-height: 1; }
        .q-engine { display: flex; align-items: center; gap: .55rem; min-width: 0; flex-wrap: wrap; padding-inline-start: 1rem; border-inline-start: 1px solid var(--border-primary); }
        .q-engine strong { white-space: nowrap; }
        .q-engine .q-btn { white-space: nowrap; }
        .q-review-shell { border: 1px solid var(--border-primary); border-radius: 1rem; background: var(--bg-secondary); overflow: hidden; }
        .q-review-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .8rem; flex-wrap: wrap; padding: .8rem 1rem; border-bottom: 1px solid var(--border-primary); }
        .q-filter { display: inline-flex; border: 1px solid var(--border-primary); border-radius: .55rem; overflow: hidden; }
        .q-filter button { border: 0; background: transparent; color: var(--text-secondary); font-size: .65rem; font-weight: 800; padding: .38rem .65rem; cursor: pointer; }
        .q-filter button[aria-pressed="true"] { background: var(--accent-color); color: #fff; }
        .q-search { width: 16rem; min-width: 13rem; flex: 1 1 16rem; max-width: 22rem; }
        .q-mode { display: inline-flex; border: 1px solid var(--border-primary); border-radius: .55rem; overflow: hidden; }
        .q-mode button { border: 0; background: transparent; color: var(--text-secondary); font-size: .62rem; font-weight: 800; padding: .35rem .55rem; cursor: pointer; white-space: nowrap; }
        .q-mode button[aria-pressed="true"] { background: rgba(229,62,62,.12); color: var(--accent-hover); box-shadow: inset 0 -2px 0 var(--accent-color); }
        .q-mini-btn { border: 1px solid var(--accent-color); background: rgba(229,62,62,.12); color: var(--accent-hover); border-radius: .35rem; padding: .18rem .4rem; font-size: .58rem; font-weight: 900; cursor: pointer; white-space: nowrap; }
        .q-mini-btn:hover { background: var(--accent-color); color: #fff; }
        .q-row-progress { grid-column: 1 / -1; display: block; height: 2px; background: var(--border-primary); border-radius: 999px; overflow: hidden; margin-top: .25rem; }
        .q-row-progress i { display: block; width: 38%; height: 100%; background: var(--accent-color); border-radius: inherit; animation: q-progress 1.1s ease-in-out infinite; }
        @keyframes q-progress { 0% { transform: translateX(-110%); } 100% { transform: translateX(300%); } }
        .q-row-busy .q-preview { color: var(--text-muted); font-style: italic; }
        .q-table-head, .q-table-row { display: grid; grid-template-columns: 3.6rem minmax(10rem, 1fr) 9.5rem 7.2rem minmax(9rem, 1.25fr); gap: .65rem; align-items: center; }
        .q-table-head { padding: .55rem 1rem; border-bottom: 1px solid var(--border-primary); background: var(--bg-primary); color: var(--text-muted); font-size: .56rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; position: sticky; top: 0; z-index: 2; }
        .q-table-body { max-height: calc(100vh - 19rem); overflow: auto; }
        .q-table-row { width: 100%; padding: .62rem 1rem; border: 0; border-top: 1px solid var(--border-primary); background: var(--bg-secondary); color: var(--text-primary); text-align: start; cursor: pointer; }
        .q-table-row:first-child { border-top: 0; }
        .q-table-row:hover { background: var(--bg-hover); }
        .q-table-row[aria-current="true"] { background: rgba(229,62,62,.08); box-shadow: inset 3px 0 0 var(--accent-color); }
        html[dir="rtl"] .q-table-row[aria-current="true"] { box-shadow: inset -3px 0 0 var(--accent-color); }
        .q-type-badge { display: inline-block; font-size: .52rem; font-weight: 900; color: var(--text-muted); border: 1px solid var(--border-primary); border-radius: .28rem; padding: .18rem .3rem; }
        .q-party-title { display: block; font-size: .73rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .q-party-meta { display: block; font-size: .58rem; color: var(--text-muted); margin-top: .13rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .q-when { font-size: .62rem; color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
        .q-quality { display: flex; align-items: center; gap: .3rem; flex-wrap: wrap; }
        .q-score { font-size: .78rem; font-weight: 900; font-variant-numeric: tabular-nums; }
        .q-preview { font-size: .64rem; color: var(--text-secondary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .q-empty { padding: 2.5rem 1rem; text-align: center; font-size: .7rem; color: var(--text-muted); }
        body.q-drawer-open { overflow: hidden; }
        .q-drawer-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,.58); opacity: 0; pointer-events: none; transition: opacity .18s ease; z-index: 90; }
        .q-drawer-backdrop.open { opacity: 1; pointer-events: auto; }
        .q-drawer { position: fixed; inset-block: 0; inset-inline-end: 0; width: min(34rem, 100vw); background: var(--bg-secondary); border-inline-start: 1px solid var(--border-primary); box-shadow: -20px 0 50px rgba(0,0,0,.25); transform: translateX(100%); transition: transform .2s ease; z-index: 95; display: flex; flex-direction: column; }
        html[dir="rtl"] .q-drawer { transform: translateX(-100%); box-shadow: 20px 0 50px rgba(0,0,0,.25); }
        .q-drawer.open { transform: translateX(0); }
        .q-drawer-head { display: flex; align-items: flex-start; justify-content: space-between; gap: .8rem; padding: 1rem; border-bottom: 1px solid var(--border-primary); flex: 0 0 auto; }
        .q-drawer-body { padding: 1rem; overflow: auto; flex: 1 1 auto; }
        .q-inspector-title { font-size: 1rem; font-weight: 900; }
        .q-kicker { font-size: .58rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; font-weight: 800; }
        .q-transcript { max-height: 18rem; overflow: auto; white-space: pre-wrap; line-height: 1.65; }
        .q-player { display: flex; align-items: center; gap: .65rem; margin-top: .9rem; padding: .55rem .65rem; border: 1px solid var(--border-primary); border-radius: .75rem; background: var(--bg-primary); }
        .q-player-btn { width: 2.25rem; height: 2.25rem; flex: 0 0 auto; display: grid; place-items: center; border: 0; border-radius: 999px; background: var(--accent-color); color: #fff; cursor: pointer; }
        .q-player-btn:hover { background: var(--accent-hover); }
        .q-player-btn svg { width: .95rem; height: .95rem; }
        .q-player-core { flex: 1 1 auto; min-width: 0; }
        .q-player-track { height: 1.1rem; display: flex; align-items: center; cursor: pointer; }
        .q-player-rail { width: 100%; height: 4px; border-radius: 999px; background: var(--border-primary); transition: height .15s ease; }
        .q-player-track:hover .q-player-rail { height: 5px; }
        .q-player-fill { width: 0; height: 100%; position: relative; background: linear-gradient(90deg, var(--accent-color), var(--accent-hover)); }
        .q-player-fill::after { content: ""; position: absolute; top: 50%; inset-inline-end: -3px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-hover); transform: translateY(-50%); }
        .q-player-times { display: flex; justify-content: space-between; margin-top: .1rem; color: var(--text-muted); font-size: .55rem; font-variant-numeric: tabular-nums; }
        .q-player-mute { flex: 0 0 auto; border: 0; background: transparent; color: var(--text-muted); cursor: pointer; padding: .25rem; }
        .q-player-mute:hover { color: var(--text-primary); }
        .q-player-mute svg { width: .95rem; height: .95rem; }
        .q-player.q-player-error .q-player-fill { background: var(--text-muted); }
        .q-player.q-player-error .q-player-times { color: #f87171; }
        .q-player audio { display: none; }
        .q-player:focus-within { border-color: var(--accent-color); }
        .q-player-btn:focus-visible, .q-player-mute:focus-visible, .q-player-track:focus-visible { outline: 2px solid var(--accent-hover); outline-offset: 2px; }
        .q-provider-fixed { display: flex; align-items: center; gap: .7rem; border: 1px solid var(--border-primary); border-radius: .7rem; padding: .65rem .75rem; background: var(--bg-primary); }
        .q-provider-mark { width: 2rem; height: 2rem; display: grid; place-items: center; border-radius: .5rem; background: rgba(229,62,62,.12); color: var(--accent-hover); font-size: .6rem; font-weight: 900; flex: 0 0 auto; }
        .q-provider-fixed strong { display: block; font-size: .72rem; }
        .q-provider-fixed span:not(.q-badge) { display: block; font-size: .58rem; color: var(--text-muted); }
        .q-provider-fixed .q-badge { margin-inline-start: auto; flex: 0 0 auto; }
        .q-provider-rail { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 1px solid var(--border-primary); border-radius: .7rem; overflow: hidden; }
        .q-provider { border: 0; border-inline-end: 1px solid var(--border-primary); border-bottom: 2px solid transparent; background: transparent; color: var(--text-secondary); padding: .55rem .45rem; text-align: start; cursor: pointer; }
        .q-provider:last-child { border-inline-end: 0; }
        .q-provider strong { display: block; font-size: .67rem; color: var(--text-primary); }
        .q-provider span { display: block; font-size: .55rem; margin-top: .15rem; color: var(--text-muted); }
        .q-provider[aria-checked="true"] { background: var(--bg-hover); border-bottom-color: var(--accent-color); }
        .q-provider:focus-visible, .q-table-row:focus-visible, .q-tab:focus-visible, .q-btn:focus-visible, .q-input:focus-visible { outline: 2px solid var(--accent-hover); outline-offset: 2px; }
        .q-settings-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
        .q-status-line { font-size: .65rem; color: var(--text-muted); min-height: 1.1rem; }
        .q-status-ok { color: #34d399; }
        .q-status-warn { color: #fbbf24; }
        .q-status-bad { color: #f87171; }
        body.light-theme .q-input { background: #fff; color: #18181b; }
        body.light-theme .q-table-row[aria-current="true"] { background: rgba(185,28,28,.07); }
        @media (max-width: 1180px) {
            .q-table-head, .q-table-row { grid-template-columns: 3.4rem minmax(10rem, 1fr) 8.8rem 6.4rem; }
            .q-col-preview { display: none; }
        }
        @media (max-width: 1024px) {
            .q-settings-grid { grid-template-columns: 1fr; }
            .q-table-head, .q-table-row { grid-template-columns: 3.4rem minmax(9rem, 1fr) 7rem; }
            .q-col-when { display: none; }
        }
        @media (max-width: 640px) {
            .q-commandbar { padding: .8rem; }
            .q-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; width: 100%; }
            .q-engine { width: 100%; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; padding-inline-start: 0; padding-top: .7rem; border-inline-start: 0; border-top: 1px solid var(--border-primary); }
            .q-engine .q-btn { grid-column: 1 / -1; justify-self: start; }
            .q-review-toolbar { align-items: stretch; }
            .q-review-toolbar > div:last-child { width: 100%; }
            .q-filter { width: 100%; }
            .q-filter button { flex: 1; }
            .q-search { width: 100%; min-width: 0; max-width: none; flex: 1 1 100%; }
            .q-table-head { display: none; }
            .q-table-body { max-height: none; }
            .q-table-row { grid-template-columns: 3.2rem minmax(0, 1fr) 4.8rem; padding: .7rem .75rem; }
            .q-drawer { width: 100vw; }
            .q-provider-rail { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .q-provider { border-bottom: 1px solid var(--border-primary); }
        }
        @media (prefers-reduced-motion: reduce) {
            .q-table-row, .q-provider, .q-btn, .q-tab, .q-drawer, .q-drawer-backdrop { transition: none; }
            .q-row-progress i { animation: none !important; width: 100%; opacity: .55; }
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <main class="flex-1 p-5 md:p-8 min-h-screen min-w-0">
        <header class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-5">
            <div>
                <h1 class="text-2xl md:text-3xl font-extrabold"><%= t.title %> <span style="color:var(--accent-color)"><%= t.subtitle %></span></h1>
            </div>
            <div class="flex gap-2 flex-wrap">
                <button class="q-btn" onclick="loadAll()"><%= t.refresh %></button>
                <button class="q-btn q-btn-primary" onclick="openRunModal()"><%= t.runEvaluation %></button>
            </div>
        </header>

        <div class="flex gap-2 flex-wrap mb-5" role="tablist" aria-label="Quality workspace">
            <button class="q-tab active" role="tab" aria-selected="true" data-qtab="review" onclick="switchQTab('review')"><%= t.review %></button>
            <button class="q-tab" role="tab" aria-selected="false" data-qtab="profiles" onclick="switchQTab('profiles')"><%= t.profiles %></button>
            <button class="q-tab" role="tab" aria-selected="false" data-qtab="agents" onclick="switchQTab('agents')"><%= t.agents %></button>
            <button class="q-tab" role="tab" aria-selected="false" data-qtab="settings" onclick="switchQTab('settings')"><%= t.settings %></button>
        </div>

        <section id="qtab-review" class="qtab-panel" role="tabpanel">
            <div class="q-commandbar">
                <div class="q-metrics">
                    <div class="q-metric"><div class="q-metric-label"><%= t.totalEvaluations %></div><div id="statEvaluations" class="q-metric-value">0</div></div>
                    <div class="q-metric"><div class="q-metric-label"><%= t.avgScore %></div><div id="statAvg" class="q-metric-value">--</div></div>
                    <div class="q-metric"><div class="q-metric-label"><%= t.passRate %></div><div id="statPass" class="q-metric-value">--</div></div>
                    <div class="q-metric"><div class="q-metric-label"><%= t.voicemails %></div><div id="statVoicemails" class="q-metric-value">0</div></div>
                </div>
                <div class="q-engine">
                    <span class="q-kicker"><%= t.sttConfigTitle %></span>
                    <strong id="reviewSttProvider" class="text-xs font-mono truncate">ElevenLabs / scribe_v3</strong>
                    <span id="reviewSttStatus" class="q-badge q-badge-fail">--</span>
                    <button class="q-btn" onclick="openSttSettings()"><%= t.configureStt %></button>
                </div>
            </div>

            <div class="q-review-shell">
                <div class="q-review-toolbar">
                    <div class="flex items-center gap-2 min-w-0">
                        <h2 class="text-sm font-extrabold"><%= t.voiceQueue %></h2>
                        <span id="reviewCount" class="q-kicker">0</span>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <div class="q-mode" role="group" aria-label="<%= t.transcriptionMode %>">
                            <button type="button" data-transcription-mode="manual" aria-pressed="true" onclick="setTranscriptionMode('manual')"><%= t.manual %></button>
                            <button type="button" data-transcription-mode="automatic" aria-pressed="false" onclick="setTranscriptionMode('automatic')"><%= t.automatic %></button>
                        </div>
                        <div class="q-filter" role="group" aria-label="Filter transcripts">
                            <button type="button" data-review-filter="all" aria-pressed="true" onclick="setReviewFilter('all')"><%= t.all %></button>
                            <button type="button" data-review-filter="call" aria-pressed="false" onclick="setReviewFilter('call')"><%= t.calls %></button>
                            <button type="button" data-review-filter="voicemail" aria-pressed="false" onclick="setReviewFilter('voicemail')"><%= t.voicemails %></button>
                        </div>
                        <input id="reviewSearch" class="q-input q-search" type="search" placeholder="<%= t.searchTranscripts %>" aria-label="<%= t.searchTranscripts %>" oninput="onReviewSearch()">
                    </div>
                </div>
                <div class="q-table-head" aria-hidden="true">
                    <span><%= t.type %></span>
                    <span><%= t.party %></span>
                    <span><%= t.when %></span>
                    <span><%= t.quality %></span>
                    <span><%= t.transcript %></span>
                </div>
                <div id="reviewList" class="q-table-body" aria-live="polite"></div>
            </div>
        </section>

        <div id="reviewBackdrop" class="q-drawer-backdrop" onclick="closeReviewDrawer()"></div>
        <aside id="reviewDrawer" class="q-drawer" role="dialog" aria-modal="true" aria-labelledby="reviewDrawerTitle" aria-hidden="true">

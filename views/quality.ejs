        async function loadReview() {
            try {
                const data = await api('/review?limit=75');
                reviewItems = data.items || [];
                const s = data.stats || {};
                document.getElementById('statEvaluations').textContent = Number(s.evaluations || 0);
                document.getElementById('statAvg').textContent = s.avg_score == null ? '--' : s.avg_score;
                document.getElementById('statPass').textContent = s.pass_rate == null ? '--' : s.pass_rate + '%';
                document.getElementById('statVoicemails').textContent = Number(s.voicemails_completed || s.voicemails || 0);
                for (const uid of [...transcribingUniqueids]) {
                    const item = reviewItems.find(entry => entry.uniqueid === uid);
                    if (item && (item.status === 'completed' || item.status === 'failed')) transcribingUniqueids.delete(uid);
                }
                renderReviewList();
                syncTranscriptionPolling();
                if (selectedReviewKey) {
                    let selected = reviewItems.find(item => itemKey(item) === selectedReviewKey);
                    if (!selected && selectedReviewUniqueid) selected = reviewItems.find(item => item.uniqueid === selectedReviewUniqueid);
                    if (selected) {
                        selectedReviewKey = itemKey(selected);
                        renderInspector(selected);
                    } else {
                        closeReviewDrawer();
                    }
                }
            } catch (err) {
                document.getElementById('reviewList').innerHTML = '<div class="q-empty" style="color:#f87171">' + esc(err.message) + '</div>';
            }
        }

        function itemKey(item) {
            return item.kind + ':' + (item.transcription_id != null ? item.transcription_id : (item.uniqueid || (item.mailbox + '/' + item.msg_file)));
        }
        function itemDate(item) {
            return item.calldate || item.completed_at || item.created_at || '';
        }
        function itemTitle(item) {
            if (item.kind === 'voicemail') return item.callerid ? (item.callerid + ' → ' + (item.mailbox || '')) : (I18N.voicemailTranscript + ' · ' + (item.mailbox || ''));
            return (item.src || '?') + ' → ' + (item.dst || '?');
        }
        function statusClass(status) {
            if (status === 'completed') return 'q-badge-pass';
            if (status === 'failed') return 'q-badge-fail';
            return 'q-badge';
        }
        function statusLabel(status) {
            if (status === 'none') return I18N.notTranscribed;
            return I18N[status] || status || I18N.pending;
        }
        function setReviewFilter(filter) {
            reviewFilter = filter;
            document.querySelectorAll('[data-review-filter]').forEach(btn => btn.setAttribute('aria-pressed', btn.dataset.reviewFilter === filter ? 'true' : 'false'));
            renderReviewList();
            ensureReviewSelection();
        }
        function ensureReviewSelection() {
            const list = filteredReviewItems();
            if (!selectedReviewKey) return;
            if (!list.some(item => itemKey(item) === selectedReviewKey)) closeReviewDrawer();
        }
        function onReviewSearch() {
            renderReviewList();
            ensureReviewSelection();
        }
        function filteredReviewItems() {
            const q = String(document.getElementById('reviewSearch')?.value || '').toLowerCase().trim();
            return reviewItems.filter(item => {
                if (reviewFilter !== 'all' && item.kind !== reviewFilter) return false;
                if (!q) return true;
                return [item.transcript, item.src, item.dst, item.mailbox, item.msg_file, item.callerid, item.profile_name]
                    .some(value => String(value || '').toLowerCase().includes(q));
            });
        }
        function renderReviewList() {
            const list = filteredReviewItems();
            const target = document.getElementById('reviewList');
            document.getElementById('reviewCount').textContent = (list.length === reviewItems.length ? list.length : list.length + ' / ' + reviewItems.length) + ' ' + I18N.items;
            if (!list.length) {
                target.innerHTML = '<div class="q-empty">' + esc(I18N.noReview) + '</div>';
                return;
            }
            target.innerHTML = list.map(item => {
                const key = itemKey(item);
                const score = item.overall_score == null ? '—' : Number(item.overall_score).toFixed(0);
                const passClass = item.pass === 1 ? 'q-badge-pass' : item.pass === 0 ? 'q-badge-fail' : 'q-badge';
                const busy = item.status === 'pending' || item.status === 'processing' || transcribingUniqueids.has(item.uniqueid);
                const quality = item.overall_score == null
                    ? `<span class="q-badge ${statusClass(item.status)}">${esc(statusLabel(item.status))}</span>`
                    : `<span class="q-score">${score}</span><span class="q-badge ${passClass}">${item.pass ? I18N.pass : I18N.fail}</span>`;
                const manualButton = transcriptionMode === 'manual' && item.kind === 'call' && item.uniqueid && !busy && item.status !== 'completed'
                    ? `<button type="button" class="q-mini-btn" data-transcribe="${esc(item.uniqueid)}" title="${item.status === 'failed' ? I18N.retry : I18N.transcribe}">${item.status === 'failed' ? I18N.retry : I18N.transcribe}</button>`
                    : '';
                const preview = busy ? I18N.transcribing : (item.transcript ? String(item.transcript).replace(/\s+/g, ' ').slice(0, 220) : '—');
                const partyMeta = item.kind === 'call'
                    ? `${item.duration_sec == null ? '-' : item.duration_sec + 's'}${item.profile_name ? ' · ' + item.profile_name : ''}`
                    : `${I18N.mailbox} ${item.mailbox || '-'} · ${item.msg_file || ''}`;
                return `
                    <div class="q-table-row ${busy ? 'q-row-busy' : ''}" role="button" tabindex="0" data-review-key="${esc(key)}" aria-current="${key === selectedReviewKey ? 'true' : 'false'}">
                        <span class="q-col-type"><span class="q-type-badge">${item.kind === 'voicemail' ? 'VM' : 'CALL'}</span></span>
                        <span class="q-col-party min-w-0"><span class="q-party-title">${esc(itemTitle(item))}</span><span class="q-party-meta">${esc(partyMeta)}</span></span>
                        <span class="q-col-when q-when">${esc(fmtDate(itemDate(item)))}</span>
                        <span class="q-col-quality q-quality">${quality}${manualButton}</span>
                        <span class="q-col-preview q-preview" dir="auto">${esc(preview)}</span>
                        ${busy ? '<span class="q-row-progress" aria-label="Transcribing"><i></i></span>' : ''}
                    </div>`;
            }).join('');
        }
        function selectReviewItem(key) {
            const item = reviewItems.find(entry => itemKey(entry) === key);
            if (!item) return;
            selectedReviewKey = key;
            selectedReviewUniqueid = item.uniqueid || null;
            renderReviewList();
            renderInspector(item);
            openReviewDrawer();

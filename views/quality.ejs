                        <label class="flex items-center gap-2 text-[10px] font-bold mt-5"><input id="setEvidence" type="checkbox" class="w-4 h-4"><%= t.requireEvidence %></label>
                    </div>
                    <div class="flex gap-2 mt-4"><button class="q-btn q-btn-primary" onclick="saveSettings()"><%= t.saveSettings %></button><button class="q-btn" onclick="testSettings()"><%= t.testConnection %></button><span id="settingsMsg" class="q-status-line self-center"></span></div>
                </div>

                <div id="sttProviderCard" class="panel rounded-xl p-5">
                    <div class="flex items-center justify-between gap-3 mb-1">
                        <h2 class="text-sm font-extrabold"><%= t.sttSettings %></h2>
                        <span id="qpSttKeyBadge" class="q-badge q-badge-fail">--</span>
                    </div>

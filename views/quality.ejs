        function updateTranscriptionModeButtons() {
            document.querySelectorAll('[data-transcription-mode]').forEach(btn => {
                btn.setAttribute('aria-pressed', btn.dataset.transcriptionMode === transcriptionMode ? 'true' : 'false');
            });
        }
        async function setTranscriptionMode(mode) {
            if (mode !== 'manual' && mode !== 'automatic') return;
            if (mode === 'automatic' && !qpSttHasSavedKey) {
                alert('Add the ElevenLabs API key before enabling automatic transcription.');
                openSttSettings();
                return;
            }
            if (mode === transcriptionMode) return;
            const previous = transcriptionMode;
            transcriptionMode = mode;
            const autoCalls = document.getElementById('qpSttCalls');
            if (autoCalls) autoCalls.checked = mode === 'automatic';
            updateTranscriptionModeButtons();
            renderReviewList();
            try {
                await jsonFetch('/api/config/stt/transcription-mode', {
                    method: 'POST',
                    body: JSON.stringify({ mode })
                });
                if (mode === 'automatic') setTimeout(loadReview, 1200);
            } catch (err) {
                transcriptionMode = previous;
                updateTranscriptionModeButtons();
                renderReviewList();
                alert(err.message);
            }
        }
        async function requestCallTranscription(uniqueid) {
            if (!uniqueid || transcribingUniqueids.has(uniqueid)) return;
            if (!qpSttHasSavedKey) {
                alert('Add the ElevenLabs API key before transcribing calls.');
                openSttSettings();
                return;
            }
            transcribingUniqueids.add(uniqueid);
            renderReviewList();
            try {
                await jsonFetch('/api/transcripts/call/' + encodeURIComponent(uniqueid) + '/transcribe', {
                    method: 'POST',
                    body: JSON.stringify({ language: 'ar' })
                });
                await loadReview();
                syncTranscriptionPolling();
            } catch (err) {
                transcribingUniqueids.delete(uniqueid);
                renderReviewList();
                alert(err.message);
            }
        }
        function syncTranscriptionPolling() {
            const active = transcribingUniqueids.size > 0 || reviewItems.some(item => item.status === 'pending' || item.status === 'processing');
            if (active && !transcriptionPollTimer) {
                transcriptionPollTimer = setInterval(async () => {
                    await loadReview();
                    const stillActive = transcribingUniqueids.size > 0 || reviewItems.some(item => item.status === 'pending' || item.status === 'processing');
                    if (!stillActive) {
                        clearInterval(transcriptionPollTimer);
                        transcriptionPollTimer = null;
                    }
                }, 3000);
            } else if (!active && transcriptionPollTimer) {
                clearInterval(transcriptionPollTimer);
                transcriptionPollTimer = null;
            }
        }
        function audioUrl(item) {
            if (item.kind === 'call' && item.uniqueid) return '/api/cdr/audio/' + encodeURIComponent(item.uniqueid);
            if (item.kind === 'voicemail' && item.mailbox && item.msg_file) {
                return '/vm-audio/' + encodeURIComponent(item.mailbox) + '/' + encodeURIComponent(item.msg_file);
            }
            return '';
        }
        function fmtAudioTime(value) {
            if (!Number.isFinite(value) || value < 0) return '0:00';
            const total = Math.floor(value);
            return Math.floor(total / 60) + ':' + String(total % 60).padStart(2, '0');
        }
        function mediaPlayerMarkup(src) {
            return `
                <div class="q-player" data-audio-src="${esc(src)}">
                    <button type="button" class="q-player-btn" data-audio-toggle aria-label="Play">
                        <svg data-audio-play-icon fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                        <svg data-audio-pause-icon class="hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
                    </button>
                    <div class="q-player-core">
                        <div class="q-player-track" data-audio-seek role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="0" aria-valuenow="0">
                            <div class="q-player-rail"><div class="q-player-fill" data-audio-fill></div></div>
                        </div>
                        <div class="q-player-times"><span data-audio-current>0:00</span><span data-audio-duration>--:--</span></div>
                    </div>
                    <button type="button" class="q-player-mute" data-audio-mute aria-label="Mute">
                        <svg data-audio-volume-icon fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H3v6h3l5 4V5zM15.5 8.5a5 5 0 010 7M18.5 5.5a9 9 0 010 13"/></svg>
                        <svg data-audio-muted-icon class="hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5L6 9H3v6h3l5 4V5zM17 9l4 6M21 9l-4 6"/></svg>
                    </button>
                    <audio preload="metadata" src="${esc(src)}"></audio>
                </div>`;
        }
        function initMediaPlayers(root) {
            root.querySelectorAll('.q-player').forEach(player => {
                if (player.dataset.ready === '1') return;
                player.dataset.ready = '1';
                const audio = player.querySelector('audio');
                const toggle = player.querySelector('[data-audio-toggle]');
                const seek = player.querySelector('[data-audio-seek]');
                const fill = player.querySelector('[data-audio-fill]');
                const current = player.querySelector('[data-audio-current]');
                const duration = player.querySelector('[data-audio-duration]');
                const mute = player.querySelector('[data-audio-mute]');
                const playIcon = player.querySelector('[data-audio-play-icon]');
                const pauseIcon = player.querySelector('[data-audio-pause-icon]');
                const volumeIcon = player.querySelector('[data-audio-volume-icon]');
                const mutedIcon = player.querySelector('[data-audio-muted-icon]');
                const setPlaying = playing => {
                    playIcon.classList.toggle('hidden', playing);
                    pauseIcon.classList.toggle('hidden', !playing);
                    toggle.setAttribute('aria-label', playing ? 'Pause' : 'Play');
                };
                const update = () => {
                    const dur = Number.isFinite(audio.duration) ? audio.duration : 0;
                    const pct = dur ? Math.min(100, Math.max(0, audio.currentTime / dur * 100)) : 0;
                    fill.style.width = pct + '%';
                    current.textContent = fmtAudioTime(audio.currentTime);
                    duration.textContent = dur ? fmtAudioTime(dur) : '--:--';
                    seek.setAttribute('aria-valuemax', String(Math.round(dur)));
                    seek.setAttribute('aria-valuenow', String(Math.round(audio.currentTime)));
                    setPlaying(!audio.paused);
                };
                toggle.addEventListener('click', () => {
                    if (audio.paused) audio.play().catch(() => {});
                    else audio.pause();
                });
                audio.addEventListener('play', update);
                audio.addEventListener('pause', update);
                audio.addEventListener('ended', update);
                audio.addEventListener('timeupdate', update);
                audio.addEventListener('loadedmetadata', update);
                audio.addEventListener('error', () => {
                    player.classList.add('q-player-error');
                    duration.textContent = 'unavailable';
                });
                seek.addEventListener('click', event => {
                    if (!Number.isFinite(audio.duration) || !audio.duration) return;
                    const rect = seek.getBoundingClientRect();
                    let ratio = (event.clientX - rect.left) / rect.width;
                    if (document.documentElement.dir === 'rtl') ratio = 1 - ratio;
                    audio.currentTime = Math.max(0, Math.min(audio.duration, ratio * audio.duration));
                    update();
                });
                seek.addEventListener('keydown', event => {
                    if (!Number.isFinite(audio.duration) || !audio.duration) return;
                    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
                        event.preventDefault();
                        const delta = event.key === 'ArrowRight' ? 5 : -5;
                        audio.currentTime = Math.max(0, Math.min(audio.duration, audio.currentTime + delta));
                        update();
                    }
                });
                mute.addEventListener('click', () => {
                    audio.muted = !audio.muted;
                    volumeIcon.classList.toggle('hidden', audio.muted);
                    mutedIcon.classList.toggle('hidden', !audio.muted);
                    mute.setAttribute('aria-label', audio.muted ? 'Unmute' : 'Mute');
                });
                update();
            });
        }
        function renderInspector(item) {

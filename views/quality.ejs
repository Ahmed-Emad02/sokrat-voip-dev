    <div id="runModal" class="q-modal">
        <div class="panel rounded-xl p-5 w-full max-w-lg">
            <div class="flex justify-between items-center mb-3"><h3 class="text-sm font-extrabold"><%= t.runEvaluation %></h3><button class="q-btn" onclick="closeModal('runModal')"><%= t.cancel %></button></div>
            <label class="block text-[10px] font-bold"><%= t.targetType %><select id="runTargetType" class="q-input mt-1" onchange="toggleRunTargetFields()"><option value="call"><%= t.calls %></option><option value="voicemail"><%= t.voicemails %></option></select></label>
            <div id="runCallFields" class="mt-3">
                <label class="block text-[10px] font-bold"><%= t.uniqueid %><input id="runUniqueid" class="q-input mt-1" placeholder="1793..."></label>
            </div>
            <div id="runVmFields" class="mt-3 hidden grid grid-cols-1 sm:grid-cols-2 gap-2">
                <label class="block text-[10px] font-bold"><%= t.mailbox %><input id="runMailbox" class="q-input mt-1" placeholder="101"></label>
                <label class="block text-[10px] font-bold"><%= t.file %><input id="runMsgFile" class="q-input mt-1" placeholder="msg0000.wav"></label>
            </div>
            <label class="block text-[10px] font-bold mt-3"><%= t.selectProfile %><select id="runProfile" class="q-input mt-1"></select></label>
            <div class="flex gap-2 mt-4"><button class="q-btn q-btn-primary" onclick="runEvaluation()"><%= t.run %></button><span id="runMsg" class="q-status-line self-center"></span></div>
        </div>
    </div>

    <script>
        const I18N = <%- JSON.stringify(t) %>;
        let profiles = [];
        let agents = [];
        let reviewItems = [];
        let reviewFilter = 'all';
        let selectedReviewKey = null;
        let sttProviderValue = 'elevenlabs';
        let qpSttHasSavedKey = false;
        let transcriptionMode = 'manual';
        let selectedReviewUniqueid = null;
        const transcribingUniqueids = new Set();
        let transcriptionPollTimer = null;

        const STT_DEFAULTS = {
            elevenlabs: { model: 'scribe_v3', url: 'https://api.elevenlabs.io/v1/speech-to-text', label: 'ElevenLabs' }
        };

        async function api(path, options = {}) {
            const res = await fetch('/api/ai' + path, {
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
                ...options
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
            return data;
        }

        async function jsonFetch(url, options = {}) {
            const res = await fetch(url, {
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
                ...options
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
            return data;
        }

        function esc(value) {
            return String(value === null || value === undefined ? '' : value)
                .replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
        }
        function fmtDate(value) { return value ? new Date(value).toLocaleString() : ''; }

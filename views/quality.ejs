                : `<div class="grid grid-cols-2 gap-2 text-[11px] mt-2"><div><span class="q-kicker">${I18N.mailbox}</span><br>${esc(item.mailbox || '-')}</div><div><span class="q-kicker">${I18N.from}</span><br>${esc(item.callerid || '-')}</div><div><span class="q-kicker">${I18N.file}</span><br><span class="font-mono">${esc(item.msg_file || '')}</span></div><div><span class="q-kicker">${I18N.provider}</span><br>${esc(item.engine || '-')} / ${esc(item.model_used || '-')}</div></div>`;
            target.innerHTML = `
                <div class="flex items-center justify-between gap-2">

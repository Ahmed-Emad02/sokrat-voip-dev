        thName: "الاسم", thAir: "مدة المكالمة", thState: "الحالة", thDir: "اتجاه", thScope: "النطاق", thRec: "التسجيل", thActions: "الإجراءات", noData: "لم يتم العثور على سجلات مكالمات مطابقة.",
        play: "تشغيل", download: "تحميل", noAudio: "لا يوجد صوت", footerLeft: "نشاط تدفق البيانات", footerRight: "إجمالي السجلات المحسوبة:",
        pagPrev: "السابق", pagNext: "التالي", pagShowing: "عرض", pagOf: "من", pagResults: "نتيجة",
        deleteBtn: "حذف", confirmDelete: "هل أنت متأكد من حذف سجل المكالمة هذا؟"
    }
};
const t = words[currentLang];
const isRtl = currentLang === 'ar';
const isSuper = (typeof isSuperAdmin !== 'undefined' && isSuperAdmin);
const userAllowedTabs = typeof allowedTabs !== 'undefined' ? allowedTabs : [];
const canDeleteCdr = isSuper || userAllowedTabs.includes('cdr-delete');
const canExportCdr = isSuper || userAllowedTabs.includes('cdr-export');
const canDownloadAudio = isSuper || userAllowedTabs.includes('cdr-audio-download');
const dispColors = {
    'ANSWERED': 'bg-[var(--accent-color)]/10 text-[var(--accent-color)] border border-[var(--accent-color)]/20',
    'BUSY': 'bg-amber-400/10 text-amber-400 border border-amber-400/20',
    'NO ANSWER': 'bg-teal-400/10 text-teal-400 border border-teal-400/20',
    'FAILED': 'bg-purple-400/10 text-purple-400 border border-purple-400/20',
    'CONGESTION': 'bg-slate-400/10 text-slate-300 border border-slate-500/30'
};
function fmtDur(s) {
    s = parseInt(s) || 0;
    const h = Math.floor(s / 3600); const m = Math.floor((s % 3600) / 60); const sec = s % 60;
    return h > 0 ? h + ':' + String(m).padStart(2,'0') + ':' + String(sec).padStart(2,'0')
                 : m + ':' + String(sec).padStart(2,'0');
}
%>
<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <!-- Prevent theme flickering -->
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - Call Logs</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #121212;
            --bg-card: #18181b;
            --bg-hover: #27272a;
            --border-primary: #27272a;
            --border-accent: #3f3f46;
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent-color: var(--accent-color);
            --accent-hover: var(--accent-hover);
            --status-online: var(--accent-color);
            --status-offline: #71717a;
            --status-active: var(--accent-color);
        }
        body { 
            background-color: var(--bg-primary); 
            font-family: 'JetBrains Mono', 'Cairo', monospace !important; 
            color: var(--text-primary); 
        }
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 10% 20%, rgba(255, 59, 48, 0.06) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.02) 0%, transparent 45%);
            pointer-events: none;
            z-index: -1;
        }
        .panel-surface { 
            background-color: var(--bg-secondary); 
            border: 1px solid var(--border-primary); 
        }
        .accent-orange { color: var(--accent-color); }
        .font-vibrant-display { font-weight: 900; letter-spacing: -0.01em; }
        .card-stat { 
            transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), 
                        border-color 150ms cubic-bezier(0.4, 0, 0.2, 1); 
        }
        .card-stat:hover { 
            transform: translateY(-2px); 
            border-color: var(--border-accent); 
        }
        input, select, button { 
            transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1); 
        }
        /* Unified Filter Typography */
        #cdrFilterForm label,
        #cdrFilterForm select,
        #cdrFilterForm button,
        #statusChecklistBtn,
        #targetExtensionChecklistBtn,
        .filter-action-btn {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }
        #cdrFilterForm input[type="text"],
        #cdrFilterForm input[type="datetime-local"],
        #cdrFilterForm .font-mono,
        .flatpickr-input {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }
        .filter-action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 2rem;
            min-height: 2rem;
            box-sizing: border-box;
            gap: 0.375rem;
            padding: 0 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            background-color: var(--bg-primary);
            color: var(--text-secondary);
            border: 1px solid var(--border-primary);
            transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            text-decoration: none;
        }
        .filter-action-btn:hover {
            background-color: var(--bg-hover);
            color: #ffffff;
            border-color: var(--border-accent);
        }
        /* Media Slider range input styling */
        .media-slider {
            -webkit-appearance: none;
            appearance: none;
            background: linear-gradient(to right, var(--accent-color, #ff3b30) 0%, var(--accent-color, #ff3b30) var(--seek-before-width, 0%), var(--border-primary, #27272a) var(--seek-before-width, 0%), var(--border-primary, #27272a) 100%);
            border-radius: 9999px;
            height: 6px;
            outline: none;
            transition: background 0.05s ease;
        }
        .media-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--accent-color, #ff3b30);
            cursor: pointer;
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        .media-slider:hover::-webkit-slider-thumb,
        .media-slider:active::-webkit-slider-thumb {
            transform: scale(1.3);
            background: #ffffff;
        }
        .media-slider::-moz-range-thumb {
            width: 12px;
            height: 12px;
            border: none;
            border-radius: 50%;
            background: var(--accent-color, #ff3b30);
            cursor: pointer;
            transition: transform 0.15s ease, background-color 0.15s ease;
        }
        .media-slider:hover::-moz-range-thumb,
        .media-slider:active::-moz-range-thumb {
            transform: scale(1.3);
            background: #ffffff;
        }
        .vol-slider {
            -webkit-appearance: none;
            appearance: none;
            background: linear-gradient(to right, var(--accent-color, #ff3b30) 0%, var(--accent-color, #ff3b30) var(--vol-before-width, 100%), var(--border-primary, #27272a) var(--vol-before-width, 100%), var(--border-primary, #27272a) 100%);
            border-radius: 9999px;
            height: 4px;
            outline: none;
        }
        .vol-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #ffffff;
            cursor: pointer;
        }
        .vol-slider::-moz-range-thumb {
            width: 9px;
            height: 9px;
            border: none;
            border-radius: 50%;
            background: #ffffff;
            cursor: pointer;
        }
        /* Theme-aware styling for External Failover calls in CDR */
        .cdr-failover-pill {
            background-color: rgba(245, 158, 11, 0.16);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.35);
            font-weight: 800;
        }
        .light-theme .cdr-failover-pill {
            background-color: #fef3c7 !important;
            color: #78350f !important;
            border-color: #f59e0b !important;
            font-weight: 800;
        }
        .cdr-via-badge {
            background-color: #27272a;
            color: #f4f4f5;
            border: 1px solid #3f3f46;
            font-weight: 800;
        }
        .light-theme .cdr-via-badge {
            background-color: #e2e8f0 !important;
            color: #0f172a !important;
            border-color: #94a3b8 !important;
            font-weight: 800;
        }
        .cdr-failover-dst {
            color: #f59e0b;
            font-weight: 800;
        }
        .light-theme .cdr-failover-dst {
            color: #78350f !important;
            font-weight: 800;
        }
        .cdr-failover-dir {
            background-color: rgba(245, 158, 11, 0.16);
            color: #fbbf24;
            border: 1px solid rgba(245, 158, 11, 0.35);
            font-weight: 900;
        }
        .light-theme .cdr-failover-dir {
            background-color: #fef3c7 !important;
            color: #78350f !important;
            border-color: #f59e0b !important;
            font-weight: 900;
        }
        .cdr-failover-scope {
            background-color: rgba(249, 115, 22, 0.16);
            color: #fb923c;
            border: 1px solid rgba(249, 115, 22, 0.35);
            font-weight: 900;
        }
        .light-theme .cdr-failover-scope {
            background-color: #ffedd5 !important;
            color: #7c2d12 !important;
            border-color: #ea580c !important;
            font-weight: 900;
        }
        .cdr-failover-name {
            color: #fbbf24;
            font-weight: 700;
        }
        .light-theme .cdr-failover-name {
            color: #78350f !important;
            font-weight: 700;
        }
        select[data-player-speed],
        select[name="cdr_speed"] {
            border: 0 !important;
            border-width: 0 !important;
            border-style: none !important;
            border-color: transparent !important;
            background-image: none !important;
            background: transparent !important;
            background-color: transparent !important;
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            appearance: none !important;
            width: auto !important;
            width: fit-content !important;
            max-width: fit-content !important;
            min-width: 0 !important;
            padding-left: 2px !important;
            padding-right: 2px !important;
            padding-top: 1px !important;
            padding-bottom: 1px !important;
            margin: 0 !important;
            text-align: center !important;
            text-align-last: center !important;
            -moz-text-align-last: center !important;
            box-shadow: none !important;
            outline: none !important;
        }
        select[data-player-speed]::-ms-expand,
        select[name="cdr_speed"]::-ms-expand {
            display: none !important;
        }
            @media (min-width: 1024px) {
            .filter-grid-row2 {
                display: grid !important;
                grid-template-columns: repeat(7, minmax(0, 1fr)) !important;
            }
        }
</style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <div class="flex-1 p-5 md:p-6 relative">
        
        <!-- Header Bar with Integrated Action -->
        <div class="mb-3 flex items-center justify-between gap-4 flex-wrap">
            <div class="<%= isRtl ? 'text-right' : '' %>">
                <h2 class="text-2xl font-vibrant-display text-white tracking-tight <%= isRtl ? 'text-right' : '' %>"><%= t.title %> <span class="accent-orange"><%= t.subtitle %></span></h2>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Columns Customize Button (Icon Only) -->
                <button type="button" onclick="openCdrColumnsModal()" class="config-btn-secondary p-2 rounded-lg flex items-center justify-center cursor-pointer shadow-sm group" title="<%= isRtl ? 'تخصيص الأعمدة' : 'Customize Columns' %>">
                    <svg class="w-4 h-4 text-zinc-400 group-hover:text-blue-400 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
                    </svg>
                    <span id="cdrColCountBadge" class="hidden">11/13</span>
                </button>

                <% if (canExportCdr) { %>
                <!-- Export Excel Button (Icon Only) -->
                <button type="button" onclick="exportCSV()" class="config-btn-secondary p-2 rounded-lg flex items-center justify-center cursor-pointer shadow-sm group" title="<%= isRtl ? 'تحميل Excel (.xlsx)' : 'Export Excel (.xlsx)' %>">
                    <svg class="w-4 h-4 text-emerald-500 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                </button>
                <% } %>
            </div>
        </div>

        <!-- Compact Balanced Filter Form -->
        <!-- Compact Balanced Filter Form -->
        <form id="cdrFilterForm" action="/cdr" method="GET" class="panel-surface p-3 px-3.5 rounded-xl mb-4 flex flex-col relative z-30">
            <input type="hidden" name="lang" value="<%= currentLang %>">
            <input type="hidden" name="page" value="1">
            
            
            <!-- Row 1: Primary Filters (4-column responsive grid) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 mb-2.5">
                <div>
                    <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="cdrStartDate"><%= t.startTime %></label>
                    <input type="datetime-local" id="cdrStartDate" name="startDate" value="<%= moment(filters.startDate).format('YYYY-MM-DDTHH:mm') %>" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                </div>
                <div>
                    <label for="cdrEndDate" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.endTime %></label>
                    <input type="datetime-local" id="cdrEndDate" name="endDate" value="<%= moment(filters.endDate).format('YYYY-MM-DDTHH:mm') %>" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                </div>
                <div class="relative">
                    <label for="targetExtensionSelect" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.roster %></label>
                    <select name="targetExtension" id="targetExtensionSelect" multiple class="hidden no-enhance">
                        <% 
                          let rosterList = (typeof roster !== 'undefined' && Array.isArray(roster)) ? roster : [];
                          let scopedExts = null;
                          if (typeof userExtensions !== 'undefined' && Array.isArray(userExtensions) && userExtensions.length > 0) {
                              scopedExts = userExtensions;
                          } else if (typeof userExtension !== 'undefined' && userExtension) {
                              scopedExts = String(userExtension).split(',').map(e => e.trim()).filter(Boolean);
                          }
                          const isScopedUser = Boolean(scopedExts && scopedExts.length > 0 && (typeof isSuperAdmin !== 'undefined' && !isSuperAdmin));
                          if (isScopedUser) {
                              rosterList = rosterList.filter(emp => scopedExts.includes(emp.extension));
                          }
                          let selectedExts = Array.isArray(filters.targetExtension) ? filters.targetExtension : (filters.targetExtension && filters.targetExtension !== 'ALL' ? [filters.targetExtension] : ['ALL']);
                          if (isScopedUser) {
                              if (selectedExts.includes('ALL') || selectedExts.length === 0) {
                                  selectedExts = scopedExts;
                              } else {
                                  selectedExts = selectedExts.filter(e => scopedExts.includes(e));
                                  if (selectedExts.length === 0) selectedExts = scopedExts;
                              }
                          }
                          let isAllExt = !isScopedUser && (selectedExts.includes('ALL') || selectedExts.length === 0);
                        %>
                        <% if (!isScopedUser) { %>
                            <option value="ALL" <%= isAllExt ? 'selected' : '' %>><%= t.allExt %></option>
                        <% } %>
                        <% rosterList.forEach(emp => { 
                            let isSel = isScopedUser || (!isAllExt && selectedExts.includes(emp.extension));
                        %>
                            <option value="<%= emp.extension %>" <%= isSel ? 'selected' : '' %>><%= emp.extension %> - <%= emp.name %></option>
                        <% }) %>
                    </select>

                    <button type="button" id="extChecklistBtn" onclick="toggleChecklistMenu('extChecklistMenu', event)" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] flex items-center justify-between gap-2 cursor-pointer text-start">
                        <span id="extChecklistLabel" class="truncate font-semibold"><%= isScopedUser ? (selectedExts.length === 1 ? (rosterList.find(e => e.extension === selectedExts[0]) ? (selectedExts[0] + ' - ' + rosterList.find(e => e.extension === selectedExts[0]).name) : selectedExts[0]) : (selectedExts.length === rosterList.length ? (rosterList[0] ? (rosterList[0].extension + ' - ' + rosterList[0].name) : selectedExts.join(', ')) : (selectedExts.length + ' ' + (isRtl ? 'تحويلات محددة' : 'Extensions')))) : t.allExt %></span>
                        <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <div id="extChecklistMenu" class="checklist-menu hidden absolute left-0 right-0 top-full mt-1 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl p-2 z-[9999] max-h-56 overflow-y-auto space-y-1" style="scrollbar-width:thin">
                        <% if (!isScopedUser) { %>
                            <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="ext_chk_all">
                                <input type="checkbox" id="ext_chk_all" name="ext_chk_all" value="ALL" <%= isAllExt ? 'checked' : '' %> onchange="onExtChecklistChange(this)" class="ext-chk rounded accent-[var(--accent-color)] cursor-pointer">
                                <span class="font-bold text-[var(--text-primary)]"><%= t.allExt %></span>
                            </label>
                        <% } %>
                        <% rosterList.forEach(emp => { 
                            let isSel = isScopedUser || (!isAllExt && selectedExts.includes(emp.extension));
                        %>
                            <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="ext_chk_<%= emp.extension %>">
                                <input type="checkbox" id="ext_chk_<%= emp.extension %>" name="ext_chk" value="<%= emp.extension %>" <%= isSel ? 'checked' : '' %> onchange="onExtChecklistChange(this)" class="ext-chk rounded accent-[var(--accent-color)] cursor-pointer">
                                <span class="text-zinc-300 font-mono"><%= emp.extension %></span>
                                <span class="text-zinc-400 truncate"><%= emp.name %></span>
                            </label>
                        <% }) %>
                    </div>
                </div>
                <div class="relative">
                    <label for="statusFilterSelect" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.status %></label>
                    <select name="statusFilter" id="statusFilterSelect" multiple class="hidden no-enhance">
                        <% 
                          let selectedSt = Array.isArray(filters.statusFilter) ? filters.statusFilter : (filters.statusFilter && filters.statusFilter !== 'ALL' ? [filters.statusFilter] : ['ALL']);
                          let isAllSt = selectedSt.includes('ALL') || selectedSt.length === 0;
                        %>
                        <option value="ALL" <%= isAllSt ? 'selected' : '' %>><%= t.allDisp %></option>
                        <option value="ANSWERED" <%= (!isAllSt && selectedSt.includes('ANSWERED')) ? 'selected' : '' %>>ANSWERED</option>
                        <option value="NO ANSWER" <%= (!isAllSt && selectedSt.includes('NO ANSWER')) ? 'selected' : '' %>>NO ANSWER</option>
                        <option value="BUSY" <%= (!isAllSt && selectedSt.includes('BUSY')) ? 'selected' : '' %>>BUSY</option>
                        <option value="FAILED" <%= (!isAllSt && selectedSt.includes('FAILED')) ? 'selected' : '' %>>FAILED</option>
                    </select>

                    <button type="button" id="statusChecklistBtn" onclick="toggleChecklistMenu('statusChecklistMenu', event)" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] flex items-center justify-between gap-2 cursor-pointer text-start">
                        <span id="statusChecklistLabel" class="truncate font-semibold"><%= t.allDisp %></span>
                        <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <div id="statusChecklistMenu" class="checklist-menu hidden absolute left-0 right-0 top-full mt-1 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl p-2 z-[9999] max-h-56 overflow-y-auto space-y-1" style="scrollbar-width:thin">
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="status_chk_all">
                            <input type="checkbox" id="status_chk_all" name="status_chk_all" value="ALL" <%= isAllSt ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-bold text-[var(--text-primary)]"><%= t.allDisp %></span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="status_chk_ans">
                            <input type="checkbox" id="status_chk_ans" name="status_chk" value="ANSWERED" <%= (!isAllSt && selectedSt.includes('ANSWERED')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-emerald-400 font-bold">ANSWERED</span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="status_chk_noans">
                            <input type="checkbox" id="status_chk_noans" name="status_chk" value="NO ANSWER" <%= (!isAllSt && selectedSt.includes('NO ANSWER')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-teal-400 font-bold">NO ANSWER</span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="status_chk_busy">
                            <input type="checkbox" id="status_chk_busy" name="status_chk" value="BUSY" <%= (!isAllSt && selectedSt.includes('BUSY')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-amber-400 font-bold">BUSY</span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="status_chk_failed">
                            <input type="checkbox" id="status_chk_failed" name="status_chk" value="FAILED" <%= (!isAllSt && selectedSt.includes('FAILED')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-purple-400 font-bold">FAILED</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Row 2: Secondary / Advanced Filters (7-column responsive grid) -->
            <% 
                let cdrHasActiveSecondary = (filters.directionFilter && filters.directionFilter !== 'ALL') ||
                                           (filters.callScopeFilter && filters.callScopeFilter !== 'ALL') ||
                                           (filters.trunkFilter && filters.trunkFilter !== 'ALL') ||
                                           (filters.searchSrc && filters.searchSrc.trim() !== '') ||
                                           (filters.searchDst && filters.searchDst.trim() !== '') ||
                                           (filters.searchDid && filters.searchDid.trim() !== '') ||
                                           (filters.searchUniqueId && filters.searchUniqueId.trim() !== '');
                let cdrActiveSecondaryCount = 0;
                if (filters.directionFilter && filters.directionFilter !== 'ALL') cdrActiveSecondaryCount++;
                if (filters.callScopeFilter && filters.callScopeFilter !== 'ALL') cdrActiveSecondaryCount++;
                if (filters.trunkFilter && filters.trunkFilter !== 'ALL') cdrActiveSecondaryCount++;
                if (filters.searchSrc && filters.searchSrc.trim() !== '') cdrActiveSecondaryCount++;
                if (filters.searchDst && filters.searchDst.trim() !== '') cdrActiveSecondaryCount++;
                if (filters.searchDid && filters.searchDid.trim() !== '') cdrActiveSecondaryCount++;
                if (filters.searchUniqueId && filters.searchUniqueId.trim() !== '') cdrActiveSecondaryCount++;
            %>
            <div id="cdrSecondaryFilters" class="<%= cdrHasActiveSecondary ? '' : 'hidden' %> overflow-hidden">
                <div class="pb-2.5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-2.5 filter-grid-row2">
                        <div>
                            <label for="cdrDirectionFilter" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.direction %></label>
                            <select id="cdrDirectionFilter" name="directionFilter" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                                <option value="ALL" <%= filters.directionFilter === 'ALL' ? 'selected' : '' %>><%= t.allDir %></option>
                                <option value="OUTBOUND" <%= filters.directionFilter === 'OUTBOUND' ? 'selected' : '' %>><%= t.dirOut %></option>
                                <option value="INBOUND" <%= filters.directionFilter === 'INBOUND' ? 'selected' : '' %>><%= t.dirIn %></option>
                                <option value="INTERNAL" <%= filters.directionFilter === 'INTERNAL' ? 'selected' : '' %>><%= t.dirInternal %></option>
                            </select>
                        </div>
                        <div>
                    <label for="cdrScopeFilter" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.scope %></label>
                    <select id="cdrScopeFilter" name="callScopeFilter" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                        <option value="ALL" <%= (filters.callScopeFilter || 'ALL') === 'ALL' ? 'selected' : '' %>><%= t.allScope %></option>
                        <option value="INTERNAL" <%= filters.callScopeFilter === 'INTERNAL' ? 'selected' : '' %>><%= t.scopeInternal %></option>
                        <option value="EXTERNAL" <%= filters.callScopeFilter === 'EXTERNAL' ? 'selected' : '' %>><%= t.scopeExternal %></option>
                        <option value="FAILOVER" <%= filters.callScopeFilter === 'FAILOVER' ? 'selected' : '' %>><%= t.scopeFailover %></option>
                    </select>
                </div>
                        <div>
                    <label for="cdrTrunkFilter" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider">LINE</label>
                    <select id="cdrTrunkFilter" name="trunkFilter" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                        <option value="ALL" <%= (!filters.trunkFilter || filters.trunkFilter === 'ALL') ? 'selected' : '' %>><%= t.allTrunks %></option>
                        <option value="INTERNAL" <%= filters.trunkFilter === 'INTERNAL' ? 'selected' : '' %>><%= t.trunkInternal %></option>
                        <% if (typeof availableTrunks !== 'undefined' && Array.isArray(availableTrunks)) { %>
                            <% availableTrunks.forEach(trk => { %>
                                <option value="<%= trk.id %>" <%= filters.trunkFilter === trk.id ? 'selected' : '' %>><%= trk.label %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>
                        <div>
                            <label for="cdrSearchSrc" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.src %></label>
                            <input type="text" id="cdrSearchSrc" name="searchSrc" value="<%= filters.searchSrc || '' %>" placeholder="e.g., 101" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                        </div>
                        <div>
                            <label for="cdrSearchDst" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.dst %></label>
                            <input type="text" id="cdrSearchDst" name="searchDst" value="<%= filters.searchDst || '' %>" placeholder="e.g., 010..." class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                        </div>
                        <div>
                            <label for="cdrSearchDid" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.did %></label>
                            <input type="text" id="cdrSearchDid" name="searchDid" value="<%= filters.searchDid || '' %>" placeholder="e.g., 01234567" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                        </div>
                        <div>
                            <label for="cdrSearchUid" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.uid %></label>
                            <input type="text" id="cdrSearchUid" name="searchUniqueId" value="<%= filters.searchUniqueId || '' %>" placeholder="e.g., 1234567890" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bottom Action Bar -->
            <div class="flex items-center justify-between gap-3 pt-2 border-t border-[var(--border-primary)]/50">
                <div class="flex items-center gap-2">
                    <a href="/cdr?lang=<%= currentLang %>" class="filter-action-btn h-8 inline-flex items-center justify-center" title="<%= t.reset %>">
                        <svg class="w-3.5 h-3.5 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span><%= t.reset %></span>
                    </a>
                    <button type="button" id="cdrToggleMoreBtn" onclick="toggleCdrMoreFilters()" class="filter-action-btn h-8 inline-flex items-center justify-center" title="<%= cdrHasActiveSecondary ? t.lessFilters : t.moreFilters %>">
                        <svg id="cdrToggleMoreFilterIcon" class="w-3.5 h-3.5 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        <span id="cdrToggleMoreLabel"><%= cdrHasActiveSecondary ? t.lessFilters : t.moreFilters %></span>
                        <svg id="cdrToggleMoreIcon" class="w-3.5 h-3.5 transition-transform duration-200 <%= cdrHasActiveSecondary ? 'rotate-180' : '' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        <% if (cdrActiveSecondaryCount > 0) { %>
                            <span class="inline-flex items-center px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-[var(--accent-color)]/20 text-[var(--accent-color)] border border-[var(--accent-color)]/30 ms-0.5">
                                <%= cdrActiveSecondaryCount %> <%= isRtl ? 'نشط' : 'Active' %>
                            </span>
                        <% } %>
                    </button>
                </div>
                <button type="submit" class="btn-primary h-8 px-5 rounded-lg text-xs font-bold uppercase tracking-wider inline-flex items-center justify-center cursor-pointer"><%= t.btn %></button>
            </div>
        </form>

        <!-- Top Pagination -->
        <% if (pagination.totalPages > 1) { %>
        <div class="flex items-center justify-between px-4 py-3 mb-2">
            <span class="text-xs text-zinc-500 font-bold">
                <%= t.pagShowing %> <%= (pagination.page - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.page * pagination.perPage, pagination.total) %> <%= t.pagOf %> <%= pagination.total %> <%= t.pagResults %>
            </span>
            <div class="flex items-center gap-1">
                <button onclick="goToPage(<%= pagination.page - 1 %>)" <%= pagination.page <= 1 ? 'disabled' : '' %> class="px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition cursor-pointer <%= pagination.page <= 1 ? 'text-zinc-700 bg-zinc-900/50 cursor-not-allowed' : 'text-zinc-300 bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:text-white' %>"><%= t.pagPrev %></button>
                <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
                    <button onclick="goToPage(<%= p %>)" class="px-3 py-1.5 rounded-lg text-xs font-black tracking-wider transition cursor-pointer <%= p === pagination.page ? 'bg-[var(--accent-color)] text-white' : 'text-zinc-400 bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:text-white' %>"><%= p %></button>
                <% } %>
                <button onclick="goToPage(<%= pagination.page + 1 %>)" <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %> class="px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition cursor-pointer <%= pagination.page >= pagination.totalPages ? 'text-zinc-700 bg-zinc-900/50 cursor-not-allowed' : 'text-zinc-300 bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:text-white' %>"><%= t.pagNext %></button>
            </div>
        </div>
        <% } %>

        <div class="panel-surface rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-start border-collapse">
                    <thead>
                        <tr class="bg-black/40 text-zinc-400 text-xs font-bold uppercase border-b border-[#27272a]">
                            <th data-col="time" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thTime %></th>
                            <th data-col="src" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thSrc %></th>
                            <th data-col="dst" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thDst %></th>
                            <th data-col="name" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thName %></th>
                            <th data-col="trunk" class="p-4 tracking-wider text-start whitespace-nowrap"><%= isRtl ? 'خط الربط' : 'Trunk' %></th>
                            <th data-col="airtime" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thAir %></th>
                            <th data-col="state" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thState %></th>
                            <th data-col="dir" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thDir %></th>
                            <th data-col="scope" class="p-4 tracking-wider text-start whitespace-nowrap"><%= t.thScope %></th>
                            <th data-col="rec" class="p-4 tracking-wider text-end min-w-[340px] whitespace-nowrap"><%= t.thRec %></th>
                            <th data-col="did" class="p-4 tracking-wider text-start whitespace-nowrap hidden"><%= t.thDid %></th>
                            <th data-col="uniqueid" class="p-4 tracking-wider text-start whitespace-nowrap hidden"><%= t.thId %></th>
                            <% if (canDeleteCdr) { %>
                                <th data-col="actions" class="p-4 tracking-wider text-center whitespace-nowrap"><%= t.thActions %></th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/30 text-sm font-mono">
                        <% if(calls.length === 0) { %>
                            <tr><td colspan="<%= canDeleteCdr ? 11 : 10 %>" class="p-8 text-center text-zinc-500 font-mono"><%= t.noData %></td></tr>
                        <% } else { %>
                            <% calls.forEach(call => { %>
                                <% const isFailover = (call.dcontext === 'ext-external-failover') || (call.userfield && String(call.userfield).startsWith('Failover:')); %>
                                <% const failoverViaMatch = call.userfield ? String(call.userfield).match(/via\s+([^\s,]+)/i) : null; %>
                                <% const failoverVia = failoverViaMatch ? failoverViaMatch[1] : (call.dstchannel && call.dstchannel.startsWith('Dongle/') ? call.dstchannel.split('-')[0].replace('Dongle/', '') : ''); %>
                                <tr class="hover:bg-zinc-900/60 transition <%= isFailover ? 'bg-amber-500/[0.03]' : '' %>">
                                    <td data-col="time" class="px-4 py-1.5 text-black whitespace-nowrap leading-none" style="color: #000000 !important;">
                                        <div class="flex flex-col gap-0.5 justify-center leading-none">
                                            <span class="text-xs text-black font-mono font-bold" style="color: #000000 !important;"><%= moment(call.calldate).format('YYYY-MM-DD') %></span>
                                            <span class="text-[11px] text-black font-mono font-semibold" style="color: #000000 !important;"><%= moment(call.calldate).format('HH:mm:ss') %></span>
                                        </div>
                                    </td>
                                                                        <td data-col="src" class="p-4 font-bold text-white font-mono whitespace-nowrap">
                                        <%= call.src %>
                                        <% if (isFailover && call.channel && call.channel.startsWith('Dongle/')) { %>
                                            <span class="block text-[10px] font-mono text-zinc-400 font-normal"><%= call.channel.split('-')[0].replace('Dongle/', '') %></span>
                                        <% } %>
                                    </td>
                                    <td data-col="dst" class="p-4 whitespace-nowrap">
                                        <% if (isFailover) { %>
                                            <div class="flex flex-col gap-1">
                                                <span class="font-bold cdr-failover-dst font-mono flex items-center gap-1.5 text-xs">
                                                    <svg class="w-3.5 h-3.5 shrink-0 opacity-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                                    <%= call.dst %>
                                                </span>
                                                <div class="flex items-center gap-1 flex-wrap">
                                                    <span class="inline-flex items-center gap-1 text-[10px] font-mono font-black px-2 py-0.5 rounded cdr-failover-pill">
                                                        <%= isRtl ? 'تحويل لرقم خارجي' : 'Failover Mobile' %>
                                                    </span>
                                                    <% if (failoverVia) { %>
                                                        <span class="text-[9px] font-mono font-extrabold px-1.5 py-0.5 rounded cdr-via-badge">via <%= failoverVia %></span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <span class="text-white font-mono"><%= call.dst %></span>
                                        <% } %>
                                    </td>
                                    <td data-col="name" class="p-4 text-zinc-300">
                                        <% if (isFailover && (!call.src_name || call.src_name === 'No Name' || call.src_name.startsWith('dongle'))) { %>
                                            <span class="cdr-failover-name text-xs font-semibold"><%= isRtl ? 'مكالمة واردة محولة لموبايل' : 'Inbound Forwarded Call' %></span>
                                        <% } else { %>
                                            <%= call.src_name %>
                                        <% } %>
                                    </td>
                                    <td data-col="trunk" class="p-4 whitespace-nowrap font-mono text-xs">
                                        <% if (call.trunk && call.trunk.name && call.trunk.name !== '-') { %>
                                            <% if (call.trunk.type === 'dongle') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 whitespace-nowrap">
                                                    <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                                    <%= call.trunk.name %>
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 whitespace-nowrap">
                                                    <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
                                                    <%= call.trunk.name %>
                                                </span>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-zinc-600 font-mono text-xs">-</span>
                                        <% } %>
                                    </td>
                                    <td data-col="airtime" class="p-4 text-zinc-400 whitespace-nowrap"><%= fmtDur(call.billsec) %></td>
                                    <td data-col="state" class="p-4 whitespace-nowrap">
                                        <span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded text-[10px] font-mono font-black tracking-wider whitespace-nowrap <%= dispColors[call.disposition] || 'bg-zinc-800 text-zinc-400 border border-zinc-700/50' %>">
                                            <%= call.disposition %>
                                        </span>
                                    </td>
                                    <td data-col="dir" class="p-4 whitespace-nowrap">
                                        <% if (isFailover) { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider px-2 py-0.5 rounded cdr-failover-dir whitespace-nowrap">
                                                <%= isRtl ? 'تحويل خارجي' : 'FAILOVER' %>
                                            </span>
                                        <% } else if (call.direction === 'OUTBOUND') { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider text-blue-400 bg-blue-400/10 px-2 py-0.5 rounded border border-blue-400/20 whitespace-nowrap"><%= t.dirOut %></span>
                                        <% } else if (call.direction === 'INBOUND') { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded border border-emerald-400/20 whitespace-nowrap"><%= t.dirIn %></span>
                                        <% } else { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider text-purple-400 bg-purple-400/10 px-2 py-0.5 rounded border border-purple-400/20 whitespace-nowrap"><%= t.dirInternal %></span>
                                        <% } %>
                                    </td>
                                    <td data-col="scope" class="p-4 whitespace-nowrap">
                                        <% if (isFailover) { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider px-2 py-0.5 rounded cdr-failover-scope whitespace-nowrap">
                                                <%= isRtl ? 'ربط شريحة مباشر' : 'Direct SIM Bridge' %>
                                            </span>
                                        <% } else if (call.call_scope === 'INTERNAL') { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider text-purple-400 bg-purple-400/10 px-2 py-0.5 rounded border border-purple-400/20 whitespace-nowrap"><%= isRtl ? 'داخلي' : 'Internal' %></span>
                                        <% } else { %>
                                            <span class="inline-flex items-center justify-center text-[10px] font-black tracking-wider text-indigo-400 bg-indigo-400/10 px-2 py-0.5 rounded border border-indigo-400/20 whitespace-nowrap"><%= isRtl ? 'خارجي' : 'External' %></span>
                                        <% } %>
                                    </td>
                                    <td data-col="rec" class="p-4 text-end min-w-[340px]">
                                        <% if (call.disposition === 'ANSWERED' && call.recordingfile) { %>
                                            <div class="audio-player flex items-center gap-1.5 min-w-[320px] max-w-[360px] <%= isRtl ? 'flex-row-reverse ml-auto' : 'ml-auto' %>">
                                                <audio preload="none" data-player-audio>
                                                    <source src="/audio/<%= call.uniqueid %>">
                                                </audio>
                                                <button data-player-playpause class="shrink-0 w-7 h-7 rounded-full bg-[var(--accent-color)] hover:bg-[var(--accent-hover)] flex items-center justify-center transition cursor-pointer" title="Play / Pause">
                                                    <svg data-icon-play class="w-3.5 h-3.5 text-white fill-white" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                                                    <svg data-icon-pause class="w-3.5 h-3.5 text-white fill-white hidden" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                                                </button>
                                                <span data-player-current class="text-[10px] font-mono font-bold text-[var(--text-muted)] w-7 text-right shrink-0 select-none">0:00</span>
                                                <div class="relative flex-1 min-w-[80px] flex items-center group py-1">
                                                    <input type="range" id="cdr_seek_<%= call.uniqueid %>" name="cdr_seek" aria-label="Seek Media Slider" data-player-slider min="0" max="100" value="0" step="0.1" class="media-slider w-full cursor-pointer focus:outline-none" title="Seek Media Slider" style="--seek-before-width: 0%;">
                                                </div>
                                                <span data-player-duration class="text-[10px] font-mono font-bold text-[var(--text-muted)] w-7 shrink-0 select-none"><%= fmtDur(call.billsec) %></span>
                                                <div class="flex items-center gap-1 shrink-0">
                                                    <div class="relative flex items-center group/vol shrink-0" data-volume-group>
                                                        <button type="button" data-player-mute class="shrink-0 w-7 h-7 rounded-lg bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] flex items-center justify-center text-[var(--text-secondary)] hover:text-white transition cursor-pointer" aria-label="Mute / Unmute">
                                                            <svg data-icon-vol-high class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072M18.364 5.636a9 9 0 010 12.728M11 5L6 9H2v6h4l5 4V5z"/></svg>
                                                            <svg data-icon-vol-mute class="w-3.5 h-3.5 text-rose-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/><path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
                                                        </button>
                                                        <div class="vol-popover absolute bottom-full left-1/2 -translate-x-1/2 pb-2 hidden group-hover/vol:flex group-focus-within/vol:flex hover:flex z-50 transition-all duration-150" data-volume-popover>
                                                            <div class="flex items-center px-3 py-2 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl shadow-2xl relative">
                                                                <input type="range" id="cdr_vol_<%= call.uniqueid %>" name="cdr_volume" aria-label="Audio Volume" data-player-volume min="0" max="1" step="0.05" value="1" class="vol-slider w-20 h-1.5 cursor-pointer focus:outline-none" title="Volume" style="--vol-before-width: 100%;">
                                                                <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-2 h-2 bg-[var(--bg-card)] border-b border-r border-[var(--border-primary)] rotate-45 pointer-events-none"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <select id="cdr_speed_<%= call.uniqueid %>" name="cdr_speed" aria-label="Playback speed" data-player-speed class="no-enhance shrink-0 appearance-none bg-transparent text-[var(--text-secondary)] hover:text-[var(--text-primary)] rounded text-[10px] font-bold cursor-pointer border-0 shadow-none focus:outline-none w-auto min-w-0 max-w-fit text-center" style="border: 0 !important; border-width: 0 !important; border-style: none !important; border-color: transparent !important; background-image: none !important; background: transparent !important; background-color: transparent !important; -webkit-appearance: none !important; -moz-appearance: none !important; appearance: none !important; outline: none !important; box-shadow: none !important; width: auto !important; width: fit-content !important; max-width: fit-content !important; min-width: 0 !important; padding: 1px 2px !important; margin: 0 !important; text-align: center !important; text-align-last: center !important;" title="Playback Speed">
                                                        <option value="0.5">0.5x</option>
                                                        <option value="1" selected>1x</option>
                                                        <option value="1.25">1.25x</option>
                                                        <option value="1.5">1.5x</option>
                                                        <option value="2">2x</option>
                                                    </select>
                                                    <button type="button" onclick="triggerAudioDownload(event, '/audio/<%= call.uniqueid %>?download=1')" class="shrink-0 w-7 h-7 rounded-full bg-[var(--bg-card)] hover:bg-[var(--accent-color)] border border-[var(--border-primary)] flex items-center justify-center transition cursor-pointer group/dl" title="<%= t.download %>">
                                                        <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover/dl:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m0 0l-4-4m4 4l4-4M5 19h14"/></svg>
                                                    </button>
                                                    <button type="button" onclick="openCdrTranscript(event, '<%= call.uniqueid %>')" id="cdr_stt_<%= call.uniqueid %>" class="shrink-0 w-7 h-7 rounded-full bg-blue-500/15 hover:bg-blue-600 border border-blue-500/40 text-blue-400 hover:text-white flex items-center justify-center transition cursor-pointer group/stt shadow-sm" title="<%= call.transcript ? (isRtl ? 'عرض تفريغ المكالمة' : 'View Transcript') : (isRtl ? 'تفريغ المكالمة فورياً (منصت)' : 'Transcribe Call (Munsit)') %>">
                                                        <svg class="w-3.5 h-3.5 <%= call.transcript ? 'text-emerald-400' : 'text-blue-400' %> group-hover/stt:text-white transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0-4a3 3 0 003-3V7a3 3 0 10-6 0v8a3 3 0 003 3z"/></svg>
                                                    </button>

                                                </div>
                                            </div>
                                        <% } else { %>
                                            <span class="text-xs font-mono text-zinc-500/30 font-bold italic select-none <%= isRtl ? 'pl-3' : 'pr-3' %>"><%= t.noAudio %></span>
                                        <% } %>
                                    </td>
                                    <td data-col="did" class="p-4 font-mono text-xs text-zinc-300 whitespace-nowrap hidden"><%= call.did && call.did.trim() ? call.did.trim() : '-' %></td>
                                    <td data-col="uniqueid" class="p-4 text-zinc-400 text-[11px] font-mono whitespace-nowrap hidden"><%= call.uniqueid %></td>
                                    <% if (canDeleteCdr) { %>
                                        <td data-col="actions" class="p-4 text-center">
                                            <button type="button" data-action="delete-cdr" data-uniqueid="<%= call.uniqueid %>" data-calldate="<%= moment(call.calldate).format('YYYY-MM-DD HH:mm:ss') %>" class="p-1.5 rounded-lg text-xs font-bold text-rose-400 hover:text-white bg-rose-500/10 hover:bg-rose-600 border border-rose-500/20 transition cursor-pointer" title="<%= t.deleteBtn %>">
                                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </button>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
            <div class="px-6 py-4 border-t border-[#27272a] bg-black/40">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-widest text-zinc-500"><%= t.footerLeft %></span>
                    <span class="text-sm font-black text-white"><%= t.footerRight %> <span class="text-[var(--accent-color)]"><%= pagination.total %></span></span>
                </div>
                <% if (pagination.totalPages > 1) { %>
                <div class="flex items-center justify-between mt-3 pt-3 border-t border-zinc-800/30">
                    <span class="text-xs text-zinc-500 font-bold">
                        <%= t.pagShowing %> <%= (pagination.page - 1) * pagination.perPage + 1 %>-<%= Math.min(pagination.page * pagination.perPage, pagination.total) %> <%= t.pagOf %> <%= pagination.total %> <%= t.pagResults %>
                    </span>
                    <div class="flex items-center gap-1">
                        <button onclick="goToPage(<%= pagination.page - 1 %>)" <%= pagination.page <= 1 ? 'disabled' : '' %> class="px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition cursor-pointer <%= pagination.page <= 1 ? 'text-zinc-700 bg-zinc-900/50 cursor-not-allowed' : 'text-zinc-300 bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:text-white' %>"><%= t.pagPrev %></button>
                        <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
                            <button onclick="goToPage(<%= p %>)" class="px-3 py-1.5 rounded-lg text-xs font-black tracking-wider transition cursor-pointer <%= p === pagination.page ? 'bg-[var(--accent-color)] text-white' : 'text-zinc-400 bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:text-white' %>"><%= p %></button>
                        <% } %>
                        <button onclick="goToPage(<%= pagination.page + 1 %>)" <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %> class="px-3 py-1.5 rounded-lg text-xs font-black uppercase tracking-wider transition cursor-pointer <%= pagination.page >= pagination.totalPages ? 'text-zinc-700 bg-zinc-900/50 cursor-not-allowed' : 'text-zinc-300 bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] hover:text-white' %>"><%= t.pagNext %></button>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        function triggerAudioDownload(e, url) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            window.location.href = url;
        }
        window.triggerAudioDownload = triggerAudioDownload;

        function goToPage(page) {
            const formEl = document.getElementById('cdrFilterForm');
            const pageEl = formEl ? formEl.querySelector('input[name="page"]') : null;
            if (pageEl && formEl) {
                const saved = localStorage.getItem('cdrPerPage');
                const perPageEl = formEl.querySelector('input[name="perPage"]');
                if (saved && perPageEl) perPageEl.value = saved;
                pageEl.value = page;
                formEl.submit();
            }
        }

        // Sync perPage from localStorage on page load and form submission
        (function() {
            var savedPerPage = localStorage.getItem('cdrPerPage');
            var currentPerPage = '<%= filters.perPage %>';
            var formEl = document.getElementById('cdrFilterForm');
            if (formEl) {
                var perPageInput = formEl.querySelector('input[name="perPage"]');
                if (savedPerPage && perPageInput) {
                    perPageInput.value = savedPerPage;
                }
                formEl.addEventListener('submit', function() {
                    var s = localStorage.getItem('cdrPerPage');
                    if (s && perPageInput) perPageInput.value = s;
                });
            }
            if (savedPerPage && parseInt(savedPerPage) !== parseInt(currentPerPage)) {
                var url = new URL(window.location);
                url.searchParams.set('perPage', savedPerPage);
                url.searchParams.set('page', '1');
                window.location.replace(url.toString());
            }
        })();

        function exportCSV() {
            const formEl = document.getElementById('cdrFilterForm');
            if (formEl) {
                const formData = new FormData(formEl);
                const params = new URLSearchParams(formData);
                params.delete('page');
                params.delete('perPage');
                window.location.href = '/cdr/export?' + params.toString();
            }
        }

        function deleteCdrRecord(uniqueid, calldate, btn) {
            if (!confirm('<%= t.confirmDelete %>')) return;
            if (btn) btn.disabled = true;

            fetch('/api/cdr/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ uniqueid, calldate })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const tr = btn ? btn.closest('tr') : null;
                    if (tr) {
                        tr.style.transition = 'opacity 300ms, transform 300ms';
                        tr.style.opacity = '0';
                        tr.style.transform = 'scale(0.98)';
                        setTimeout(() => { tr.remove(); }, 300);
                    } else {
                        window.location.reload();
                    }
                } else {
                    alert(data.error || 'Failed to delete call record');
                    if (btn) btn.disabled = false;
                }
            })
            .catch(err => {
                alert('Network error: ' + err.message);
                if (btn) btn.disabled = false;
            });
        }
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('[data-action="delete-cdr"]');
            if (!btn) return;
            e.preventDefault();
            const uniqueid = btn.getAttribute('data-uniqueid');
            const calldate = btn.getAttribute('data-calldate');
            if (!uniqueid) return;
            deleteCdrRecord(uniqueid, calldate, btn);
        });


        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.updateClock === 'function') window.updateClock();
            let currentlyPlaying = null;
            function fmtTime(s) {
                if (!s || !isFinite(s)) return '0:00';
                const m = Math.floor(s / 60);
                const sec = Math.floor(s % 60);
                return m + ':' + String(sec).padStart(2, '0');
            }
            document.querySelectorAll('.audio-player').forEach(player => {
                const audio       = player.querySelector('[data-player-audio]');
                const playBtn     = player.querySelector('[data-player-playpause]');
                const iconPlay    = player.querySelector('[data-icon-play]');
                const iconPause   = player.querySelector('[data-icon-pause]');
                const slider      = player.querySelector('[data-player-slider]');
                const curEl       = player.querySelector('[data-player-current]');
                const durEl       = player.querySelector('[data-player-duration]');
                const speedSel    = player.querySelector('[data-player-speed]');
                const muteBtn     = player.querySelector('[data-player-mute]');
                const iconVolHigh = player.querySelector('[data-icon-vol-high]');
                const iconVolMute = player.querySelector('[data-icon-vol-mute]');
                const volSlider   = player.querySelector('[data-player-volume]');

                let isScrubbing = false;
                let lastVolume = 1;

                function updateSliderBackground(val) {
                    if (slider) {
                        slider.style.setProperty('--seek-before-width', val + '%');
                    }
                }

                function updateVolBackground(val) {
                    if (volSlider) {
                        volSlider.style.setProperty('--vol-before-width', (val * 100) + '%');
                    }
                }

                playBtn.addEventListener('click', () => {
                    if (audio.paused) {
                        if (currentlyPlaying && currentlyPlaying !== audio) {
                            currentlyPlaying.pause();
                            currentlyPlaying.currentTime = 0;
                            const otherPlayer = currentlyPlaying.closest('.audio-player');
                            if (otherPlayer) {
                                otherPlayer.querySelector('[data-icon-play]')?.classList.remove('hidden');
                                otherPlayer.querySelector('[data-icon-pause]')?.classList.add('hidden');
                                const otherSlider = otherPlayer.querySelector('[data-player-slider]');
                                if (otherSlider) {
                                    otherSlider.value = 0;
                                    otherSlider.style.setProperty('--seek-before-width', '0%');
                                }
                                const otherCur = otherPlayer.querySelector('[data-player-current]');
                                if (otherCur) otherCur.textContent = '0:00';
                            }
                        }
                        const p = audio.play();
                        if (p && typeof p.catch === 'function') {
                            p.catch(err => {
                                if (err.name !== 'AbortError') console.warn('[Audio Player] Play error:', err);
                            });
                        }
                        currentlyPlaying = audio;
                        iconPlay.classList.add('hidden');
                        iconPause.classList.remove('hidden');
                    } else {
                        audio.pause();
                        iconPlay.classList.remove('hidden');
                        iconPause.classList.add('hidden');
                    }
                });

                audio.addEventListener('loadedmetadata', () => {
                    durEl.textContent = fmtTime(audio.duration);
                });

                audio.addEventListener('timeupdate', () => {
                    if (!audio.duration || isScrubbing) return;
                    const pct = (audio.currentTime / audio.duration) * 100;
                    if (slider) {
                        slider.value = pct;
                        updateSliderBackground(pct);
                    }
                    curEl.textContent = fmtTime(audio.currentTime);
                });

                audio.addEventListener('ended', () => {
                    iconPlay.classList.remove('hidden');
                    iconPause.classList.add('hidden');
                    if (slider) {
                        slider.value = 0;
                        updateSliderBackground(0);
                    }
                    curEl.textContent = '0:00';
                    currentlyPlaying = null;
                });

                if (slider) {
                    ['mousedown', 'touchstart'].forEach(evt => {
                        slider.addEventListener(evt, () => {
                            isScrubbing = true;
                        });
                    });

                    slider.addEventListener('input', () => {
                        isScrubbing = true;
                        const pct = parseFloat(slider.value);
                        updateSliderBackground(pct);
                        if (audio.duration) {
                            curEl.textContent = fmtTime((pct / 100) * audio.duration);
                        }
                    });

                    slider.addEventListener('change', () => {
                        if (audio.duration) {
                            audio.currentTime = (parseFloat(slider.value) / 100) * audio.duration;
                        }
                        isScrubbing = false;
                    });

                    ['mouseup', 'touchend'].forEach(evt => {
                        slider.addEventListener(evt, () => {
                            if (isScrubbing && audio.duration) {
                                audio.currentTime = (parseFloat(slider.value) / 100) * audio.duration;
                            }
                            isScrubbing = false;
                        });
                    });
                }

                if (speedSel) {
                    speedSel.addEventListener('change', () => {
                        audio.playbackRate = parseFloat(speedSel.value);
                    });
                }

                let isDraggingVol = false;
                let volHideTimeout = null;
                const volGroup = player.querySelector('[data-volume-group]');
                const volPopover = player.querySelector('[data-volume-popover]');

                if (volGroup && volPopover) {
                    volGroup.addEventListener('mouseenter', () => {
                        clearTimeout(volHideTimeout);
                        volPopover.classList.remove('hidden');
                        volPopover.classList.add('flex');
                    });
                    volGroup.addEventListener('mouseleave', () => {
                        volHideTimeout = setTimeout(() => {
                            if (!isDraggingVol) {
                                volPopover.classList.add('hidden');
                                volPopover.classList.remove('flex');
                            }
                        }, 300);
                    });
                }

                if (muteBtn) {
                    muteBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (audio.muted || audio.volume === 0) {
                            audio.muted = false;
                            audio.volume = lastVolume > 0 ? lastVolume : 1;
                            if (volSlider) volSlider.value = audio.volume;
                            updateVolBackground(audio.volume);
                            iconVolHigh?.classList.remove('hidden');
                            iconVolMute?.classList.add('hidden');
                        } else {
                            lastVolume = audio.volume;
                            audio.muted = true;
                            if (volSlider) volSlider.value = 0;
                            updateVolBackground(0);
                            iconVolHigh?.classList.add('hidden');
                            iconVolMute?.classList.remove('hidden');
                        }
                    });
                }

                if (volSlider) {
                    ['mousedown', 'touchstart'].forEach(evt => {
                        volSlider.addEventListener(evt, () => {
                            isDraggingVol = true;
                            clearTimeout(volHideTimeout);
                            if (volPopover) {
                                volPopover.classList.remove('hidden');
                                volPopover.classList.add('flex');
                            }
                        });
                    });
                    ['mouseup', 'touchend'].forEach(evt => {
                        window.addEventListener(evt, () => {
                            if (isDraggingVol) {
                                isDraggingVol = false;
                                volHideTimeout = setTimeout(() => {
                                    if (volPopover && volGroup && !volGroup.matches(':hover')) {
                                        volPopover.classList.add('hidden');
                                        volPopover.classList.remove('flex');
                                    }
                                }, 300);
                            }
                        });
                    });
                    volSlider.addEventListener('input', (e) => {
                        e.stopPropagation();
                        const v = parseFloat(volSlider.value);
                        audio.volume = v;
                        audio.muted = (v === 0);
                        updateVolBackground(v);
                        if (v === 0) {
                            iconVolHigh?.classList.add('hidden');
                            iconVolMute?.classList.remove('hidden');
                        } else {
                            lastVolume = v;
                            iconVolHigh?.classList.remove('hidden');
                            iconVolMute?.classList.add('hidden');
                        }
                    });
                }
            });

            // Initialize Flatpickr on datetime inputs
            flatpickr('input[type="datetime-local"]', {
                enableTime: true,
                dateFormat: "Y-m-d\\TH:i",
                altInput: true,
                altFormat: "m/d/Y h:i K",
                time_24hr: false,
                allowInput: true,
                scrollInputIntoView: false,
                appendTo: document.body,
                monthSelectorType: "dropdown",
                onReady: function(selectedDates, dateStr, instance) {
                    if (instance.altInput) {
                        var origId = instance.input.id || (instance.input.name ? instance.input.name + 'Input' : 'datePicker_' + Math.random().toString(36).substring(2, 7));
                        if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                        instance.input.id = origId + '_raw';
                        instance.altInput.id = origId;
                        instance.altInput.name = (instance.input.name || origId) + '_display';
                        instance.altInput.setAttribute('autocomplete', 'off');
                        var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                        instance.altInput.setAttribute('aria-label', ariaLabel);
                    }
                }
            });
        });
    </script>
    <script>
        (function() {
            function forceMonthSelect() {
                document.querySelectorAll('.flatpickr-current-month').forEach(function(el) {
                    var sel = el.querySelector('.flatpickr-monthDropdown-months');
                    var cur = el.querySelector('.cur-month');
                    if (!sel) return;
                    if (cur) cur.style.setProperty('display', 'none', 'important');
                    sel.style.setProperty('display', 'inline-block', 'important');
                    sel.style.setProperty('pointer-events', 'auto', 'important');
                    sel.style.setProperty('cursor', 'pointer', 'important');
                    sel.style.setProperty('opacity', '1', 'important');
                });
            }
            // Force month select element display
            forceMonthSelect();
            var pollTimer = setInterval(function() { forceMonthSelect(); }, 100);
            setTimeout(function() { clearInterval(pollTimer); }, 3000);
            var obs = new MutationObserver(function(muts) {
                muts.forEach(function(mut) {
                    mut.addedNodes.forEach(function(n) {
                        if (n.nodeType === 1 && n.querySelectorAll) forceMonthSelect();
                    });
                });
            });
            obs.observe(document.body, { childList: true, subtree: true });
        })();
    </script>
    <script>
        function toggleChecklistMenu(menuId, event) {
            if (event) event.stopPropagation();
            const menu = document.getElementById(menuId);
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden');
            document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            if (isHidden) menu.classList.remove('hidden');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.checklist-menu') && !e.target.closest('button[onclick*="toggleChecklistMenu"]')) {
                document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            }
        });

        function syncExtChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.ext-chk'));
            const select = document.getElementById('targetExtensionSelect');
            const labelSpan = document.getElementById('extChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allExt) %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onExtChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.ext-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncExtChecklistUI();
        }

function syncStatusChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.status-chk'));
            const select = document.getElementById('statusFilterSelect');
            const labelSpan = document.getElementById('statusChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allDisp) %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onStatusChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.status-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncStatusChecklistUI();
        }

        document.addEventListener('DOMContentLoaded', () => {
            syncExtChecklistUI();
            syncStatusChecklistUI();

            const cdrHasServerActiveSecondary = <%= cdrHasActiveSecondary ? 'true' : 'false' %>;
            if (!cdrHasServerActiveSecondary) {
                try {
                    const savedCdrExpanded = localStorage.getItem('cdr_filters_expanded');
                    if (savedCdrExpanded === 'true') {
                        toggleCdrMoreFilters(true, true);
                    }
                } catch (e) {}
            }
        });
    </script>


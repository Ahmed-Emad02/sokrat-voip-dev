    <script>
        let currentCdrTranscript = "";
        async function openCdrTranscript(e, uniqueid) {
            if (e) e.stopPropagation();
            const modal = document.getElementById("cdrTranscriptModal");
            const textEl = document.getElementById("cdrTranscriptText");
            const loadingEl = document.getElementById("cdrTranscriptLoading");
            const metaEl = document.getElementById("cdrTranscriptMeta");
            if (!modal) return;

            modal.classList.remove("invisible", "opacity-0");
            modal.classList.add("opacity-100");
            modal.style.pointerEvents = "auto";
            if (metaEl) metaEl.textContent = "UID: " + uniqueid;
            if (textEl) textEl.textContent = "";
            if (loadingEl) loadingEl.classList.remove("hidden");

            try {
                let res = await fetch("/api/transcripts/call/" + encodeURIComponent(uniqueid));
                let data = await res.json();
                let tr = data && data.transcription;

                if (!tr || tr.status !== "completed" || !tr.transcript) {
                    await fetch("/api/transcripts/call/" + encodeURIComponent(uniqueid) + "/transcribe", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ language: "ar" })
                    });

                    for (let i = 0; i < 15; i++) {
                        await new Promise(r => setTimeout(r, 2000));
                        res = await fetch("/api/transcripts/call/" + encodeURIComponent(uniqueid));
                        data = await res.json();
                        tr = data && data.transcription;
                        if (tr && (tr.status === "completed" || tr.status === "failed")) break;
                    }
                }

                if (loadingEl) loadingEl.classList.add("hidden");
                if (tr && tr.status === "completed" && tr.transcript) {
                    currentCdrTranscript = tr.transcript;
                    if (textEl) textEl.textContent = tr.transcript;
                    const btn = document.getElementById("cdr_stt_" + uniqueid);
                    if (btn) {
                        const icon = btn.querySelector("svg");
                        if (icon) {
                            icon.classList.remove("text-blue-400");
                            icon.classList.add("text-emerald-400");
                        }
                    }
                } else if (tr && tr.status === "failed") {
                    if (textEl) textEl.textContent = tr.error_message || "Transcription failed.";
                } else {
                    if (textEl) textEl.textContent = "Processing in progress. Please check back in a moment.";
                }
            } catch (err) {
                if (loadingEl) loadingEl.classList.add("hidden");
                if (textEl) textEl.textContent = "Error: " + err.message;
            }
        }
        function closeCdrTranscriptModal() {
            const modal = document.getElementById("cdrTranscriptModal");
            if (!modal) return;
            modal.classList.add("invisible", "opacity-0");
            modal.classList.remove("opacity-100");
            modal.style.pointerEvents = "none";
        }
        function copyCdrTranscript() {
            if (!currentCdrTranscript) return;
            navigator.clipboard.writeText(currentCdrTranscript).then(() => {
                const btn = document.getElementById("copyCdrTranscriptBtnText");
                if (btn) {
                    const orig = btn.textContent;
                    btn.textContent = "Copied!";
                    setTimeout(() => { btn.textContent = orig; }, 1500);
                }
            });
        }
        window.openCdrTranscript = openCdrTranscript;
        window.closeCdrTranscriptModal = closeCdrTranscriptModal;
        window.copyCdrTranscript = copyCdrTranscript;

        // =========================================================================
        // --- DYNAMIC CDR COLUMN MANAGER (Visibility & Reordering) ---
        // =========================================================================
        const _canDeleteCdr = <%= (typeof canDeleteCdr !== 'undefined' && canDeleteCdr) ? 'true' : 'false' %>;
        const _isRtl = <%= (typeof isRtl !== 'undefined' && isRtl) ? 'true' : 'false' %>;

        const CDR_STORAGE_KEY_V2 = 'sokrat_cdr_columns_v2';
        const CDR_STORAGE_KEY_V1 = 'sokrat_cdr_columns_v1';

        const CDR_COLUMNS_CATALOG = [
            { id: 'time', labelEn: 'Timestamp', labelAr: 'التوقيت', defaultVisible: true },
            { id: 'src', labelEn: 'Source', labelAr: 'المصدر', defaultVisible: true },
            { id: 'dst', labelEn: 'Destination', labelAr: 'الوجهة', defaultVisible: true },
            { id: 'name', labelEn: 'Name / Lead', labelAr: 'الاسم', defaultVisible: true },
            { id: 'trunk', labelEn: 'Trunk / Line', labelAr: 'خط الربط / الشريحة', defaultVisible: true },
            { id: 'airtime', labelEn: 'Airtime', labelAr: 'مدة المكالمة', defaultVisible: true },
            { id: 'state', labelEn: 'State', labelAr: 'الحالة', defaultVisible: true },
            { id: 'dir', labelEn: 'Direction', labelAr: 'الاتجاه', defaultVisible: true },
            { id: 'scope', labelEn: 'Scope', labelAr: 'النطاق', defaultVisible: true },
            { id: 'rec', labelEn: 'Recording', labelAr: 'التسجيل', defaultVisible: true },
            { id: 'did', labelEn: 'DID Number', labelAr: 'رقم DID', defaultVisible: false },
            { id: 'uniqueid', labelEn: 'UniqueID', labelAr: 'المعرف الفريد', defaultVisible: false },
            { id: 'actions', labelEn: 'Actions', labelAr: 'الإجراءات', defaultVisible: true, superOnly: true }
        ];

        let cdrWorkingColumns = [];
        let cdrDraggedColIndex = null;

        function getDefaultCdrColumns() {
            return CDR_COLUMNS_CATALOG
                .filter(c => !c.superOnly || _canDeleteCdr)
                .map(c => ({ id: c.id, visible: c.defaultVisible }));
        }

        function loadCdrColumnsPreference() {
            try {
                localStorage.removeItem(CDR_STORAGE_KEY_V1);
                const stored = localStorage.getItem(CDR_STORAGE_KEY_V2);
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        const existingIds = new Set(parsed.map(p => p.id));
                        const missing = getDefaultCdrColumns().filter(c => !existingIds.has(c.id));
                        const filtered = parsed.filter(p => CDR_COLUMNS_CATALOG.some(c => c.id === p.id && (!c.superOnly || _canDeleteCdr)));
                        return [...filtered, ...missing];
                    }
                }
            } catch (_) {}
            return getDefaultCdrColumns();
        }

        function applyCdrColumnsToTable(cols) {
            const table = document.querySelector('.panel-surface table');
            if (!table) return;

            const theadRow = table.querySelector('thead tr');
            const tbodyRows = table.querySelectorAll('tbody tr');

            // 1. Reorder & toggle <th>
            if (theadRow) {
                cols.forEach(col => {
                    const th = theadRow.querySelector(`:scope > [data-col="${col.id}"]`);
                    if (th) {
                        if (col.visible) th.classList.remove('hidden');
                        else th.classList.add('hidden');
                        theadRow.appendChild(th);
                    }
                });
            }

            // 2. Reorder & toggle <td> in all rows
            tbodyRows.forEach(row => {
                const emptyCell = row.querySelector('td[colspan]');
                if (emptyCell) {
                    const visibleCount = cols.filter(c => c.visible).length;
                    emptyCell.colSpan = visibleCount || 1;
                    return;
                }

                cols.forEach(col => {
                    const td = row.querySelector(`:scope > [data-col="${col.id}"]`);
                    if (td) {
                        if (col.visible) td.classList.remove('hidden');
                        else td.classList.add('hidden');
                        row.appendChild(td);
                    }
                });
            });

            // 3. Update counter badges
            const badge = document.getElementById('cdrColCountBadge');
            if (badge) {
                const activeCount = cols.filter(c => c.visible).length;
                badge.textContent = `${activeCount}/${cols.length}`;
            }
        }

        function openCdrColumnsModal() {
            const modal = document.getElementById('cdrColumnsModal');
            if (!modal) return;
            cdrWorkingColumns = loadCdrColumnsPreference().map(c => ({ ...c }));
            renderCdrModalColumnsList();
            modal.classList.remove('invisible', 'opacity-0');
            modal.classList.add('opacity-100');
            modal.style.pointerEvents = 'auto';
        }

        function closeCdrColumnsModal() {
            const modal = document.getElementById('cdrColumnsModal');
            if (!modal) return;
            modal.classList.add('invisible', 'opacity-0');
            modal.classList.remove('opacity-100');
            modal.style.pointerEvents = 'none';
        }

        function renderCdrModalColumnsList() {
            const container = document.getElementById('cdrColumnsOrderList');
            if (!container) return;
            container.innerHTML = '';

            const visibleCount = cdrWorkingColumns.filter(c => c.visible).length;
            const summaryEl = document.getElementById('modalVisibleColSummary');
            if (summaryEl) {
                summaryEl.textContent = `${visibleCount} / ${cdrWorkingColumns.length}`;
            }

            cdrWorkingColumns.forEach((col, idx) => {
                const def = CDR_COLUMNS_CATALOG.find(c => c.id === col.id) || { labelEn: col.id, labelAr: col.id };
                const label = _isRtl ? def.labelAr : def.labelEn;

                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-2 rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)] hover:border-blue-500/40 transition select-none';
                item.setAttribute('draggable', 'true');
                item.dataset.index = idx;

                item.innerHTML = `
                    <div class="flex items-center gap-2.5 min-w-0">
                        <div class="cursor-grab active:cursor-grabbing text-zinc-500 hover:text-zinc-300 p-0.5" title="${_isRtl ? 'اسحب للترتيب' : 'Drag to reorder'}">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
                            </svg>
                        </div>
                        <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-[var(--text-primary)] truncate">
                            <input type="checkbox" ${col.visible ? 'checked' : ''} onchange="toggleCdrModalColumn('${col.id}', this.checked)" class="rounded border-zinc-700 text-blue-600 focus:ring-blue-500 cursor-pointer">
                            <span class="${col.visible ? 'text-white' : 'text-zinc-500 line-through'}">${label}</span>
                        </label>
                    </div>
                    <div class="flex items-center gap-1 shrink-0">
                        <button type="button" onclick="moveCdrModalColumn(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-xs font-bold border border-[var(--border-primary)] ${idx === 0 ? 'opacity-20 cursor-not-allowed text-zinc-600' : 'text-zinc-400 hover:text-white hover:bg-zinc-800 cursor-pointer'} transition" title="${_isRtl ? 'للأعلى' : 'Move Up'}">▲</button>
                        <button type="button" onclick="moveCdrModalColumn(${idx}, 1)" ${idx === cdrWorkingColumns.length - 1 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-xs font-bold border border-[var(--border-primary)] ${idx === cdrWorkingColumns.length - 1 ? 'opacity-20 cursor-not-allowed text-zinc-600' : 'text-zinc-400 hover:text-white hover:bg-zinc-800 cursor-pointer'} transition" title="${_isRtl ? 'للأسفل' : 'Move Down'}">▼</button>
                    </div>
                `;

                // Drag and drop event listeners
                item.addEventListener('dragstart', (e) => {
                    cdrDraggedColIndex = idx;
                    e.dataTransfer.effectAllowed = 'move';
                    item.classList.add('opacity-40', 'bg-blue-500/10');
                });
                item.addEventListener('dragend', () => {
                    item.classList.remove('opacity-40', 'bg-blue-500/10');
                    document.querySelectorAll('#cdrColumnsOrderList > div').forEach(el => el.classList.remove('border-blue-500'));
                });
                item.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    item.classList.add('border-blue-500');
                });
                item.addEventListener('dragleave', () => {
                    item.classList.remove('border-blue-500');
                });
                item.addEventListener('drop', (e) => {
                    e.preventDefault();
                    item.classList.remove('border-blue-500');
                    const fromIdx = cdrDraggedColIndex;
                    const toIdx = idx;
                    if (fromIdx === null || fromIdx === undefined || fromIdx === toIdx) return;
                    const moved = cdrWorkingColumns.splice(fromIdx, 1)[0];
                    cdrWorkingColumns.splice(toIdx, 0, moved);
                    renderCdrModalColumnsList();
                });

                container.appendChild(item);
            });
        }

        function toggleCdrModalColumn(id, isChecked) {
            const col = cdrWorkingColumns.find(c => c.id === id);
            if (!col) return;
            const currentlyVisible = cdrWorkingColumns.filter(c => c.visible).length;
            if (!isChecked && currentlyVisible <= 1) {
                showToast(_isRtl ? 'يجب إبقاء عمود واحد على الأقل معروضاً' : 'At least one column must remain visible', 'error');
                renderCdrModalColumnsList();
                return;
            }
            col.visible = isChecked;
            renderCdrModalColumnsList();
        }

        function moveCdrModalColumn(idx, direction) {
            const targetIdx = idx + direction;
            if (targetIdx < 0 || targetIdx >= cdrWorkingColumns.length) return;
            const temp = cdrWorkingColumns[idx];
            cdrWorkingColumns[idx] = cdrWorkingColumns[targetIdx];
            cdrWorkingColumns[targetIdx] = temp;
            renderCdrModalColumnsList();
        }

        function resetCdrColumnsToDefault() {
            try {
                localStorage.removeItem(CDR_STORAGE_KEY_V2);
                localStorage.removeItem(CDR_STORAGE_KEY_V1);
                fetch('/api/user/column-preferences', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ table: 'cdr', reset: true })
                }).catch(() => {});
            } catch (_) {}
            cdrWorkingColumns = getDefaultCdrColumns();
            applyCdrColumnsToTable(cdrWorkingColumns);
            renderCdrModalColumnsList();
        }

        function saveCdrColumnsPreference() {
            localStorage.setItem(CDR_STORAGE_KEY_V2, JSON.stringify(cdrWorkingColumns));
            applyCdrColumnsToTable(cdrWorkingColumns);
            closeCdrColumnsModal();

            // Background sync to server
            fetch('/api/user/column-preferences', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ table: 'cdr', columns: cdrWorkingColumns })
            }).catch(() => {});

            showToast(_isRtl ? 'تم حفظ وتطبيق ترتيب الأعمدة بنجاح' : 'Columns layout saved successfully', 'success');
        }

        // Initialize column preferences on page load
        (function initCdrColumns() {
            const cols = loadCdrColumnsPreference();
            applyCdrColumnsToTable(cols);

            // Background fetch from server to sync preferences across sessions
            fetch('/api/user/column-preferences?table=cdr')
                .then(r => r.json())
                .then(data => {
                    if (data && data.success && Array.isArray(data.columns) && data.columns.length > 0) {
                        localStorage.setItem(CDR_STORAGE_KEY_V2, JSON.stringify(data.columns));
                        applyCdrColumnsToTable(data.columns);
                    }
                })
                .catch(() => {});
        })();

                // Expandable Filters Mechanism for Call History
        function toggleCdrMoreFilters(forcedState, immediate) {
            const drawer = document.getElementById('cdrSecondaryFilters');
            const label = document.getElementById('cdrToggleMoreLabel');
            const icon = document.getElementById('cdrToggleMoreIcon');
            if (!drawer) return;

            const isCurrentlyHidden = drawer.classList.contains('hidden') || drawer.style.display === 'none' || drawer.offsetHeight === 0;
            const expand = (typeof forcedState === 'boolean') ? forcedState : isCurrentlyHidden;

            if (expand) {
                if (!drawer.classList.contains('hidden') && drawer.offsetHeight > 0 && !drawer.dataset.animating) {
                    return;
                }

                if (immediate) {
                    drawer.classList.remove('hidden');
                    drawer.style.display = 'block';
                    drawer.style.maxHeight = 'none';
                    drawer.style.opacity = '1';
                    drawer.style.overflow = 'visible';
                    drawer.style.transition = 'none';
                    if (label) label.textContent = <%- JSON.stringify(t.lessFilters) %>;
                    if (icon) icon.classList.add('rotate-180');
                    try { localStorage.setItem('cdr_filters_expanded', 'true'); } catch (e) {}
                    return;
                }

                drawer.dataset.animating = 'true';
                drawer.classList.remove('hidden');
                drawer.style.display = 'block';
                drawer.style.overflow = 'hidden';
                drawer.style.transition = 'none';
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';

                // Measure real target height with contents rendered
                const targetHeight = drawer.scrollHeight;

                // Force layout reflow before starting transition
                void drawer.offsetHeight;

                drawer.style.transition = 'max-height 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease-out';

                requestAnimationFrame(() => {
                    drawer.style.maxHeight = targetHeight + 'px';
                    drawer.style.opacity = '1';
                });

                let finished = false;
                const finishExpand = () => {
                    if (finished) return;
                    finished = true;
                    delete drawer.dataset.animating;
                    drawer.style.transition = 'none';
                    drawer.style.maxHeight = 'none';
                    drawer.style.overflow = 'visible';
                };

                const onEnd = (e) => {
                    if (e && (e.target !== drawer || e.propertyName !== 'max-height')) return;
                    drawer.removeEventListener('transitionend', onEnd);
                    finishExpand();
                };
                drawer.addEventListener('transitionend', onEnd);
                setTimeout(finishExpand, 350);

                if (label) label.textContent = <%- JSON.stringify(t.lessFilters) %>;
                if (icon) icon.classList.add('rotate-180');
                try { localStorage.setItem('cdr_filters_expanded', 'true'); } catch (e) {}
            } else {
                if (drawer.classList.contains('hidden') && !drawer.dataset.animating) {
                    return;
                }

                if (immediate) {
                    drawer.classList.add('hidden');
                    drawer.style.display = '';
                    drawer.style.maxHeight = '';
                    drawer.style.opacity = '';
                    drawer.style.overflow = '';
                    drawer.style.transition = '';
                    if (label) label.textContent = <%- JSON.stringify(t.moreFilters) %>;
                    if (icon) icon.classList.remove('rotate-180');
                    try { localStorage.setItem('cdr_filters_expanded', 'false'); } catch (e) {}
                    return;
                }

                drawer.dataset.animating = 'true';
                drawer.style.overflow = 'hidden';

                // 1. Lock current computed pixel height without transition to eliminate jumps from 'none'
                const startHeight = drawer.offsetHeight || drawer.scrollHeight;
                drawer.style.transition = 'none';
                drawer.style.maxHeight = startHeight + 'px';
                drawer.style.opacity = '1';

                // 2. Force layout reflow so the browser commits the start height
                void drawer.offsetHeight;

                // 3. Apply smooth collapse transition and animate to 0
                drawer.style.transition = 'max-height 0.26s cubic-bezier(0.2, 0, 0, 1), opacity 0.2s ease-in';

                requestAnimationFrame(() => {
                    drawer.style.maxHeight = '0px';
                    drawer.style.opacity = '0';
                });

                let finished = false;
                const finishCollapse = () => {
                    if (finished) return;
                    finished = true;
                    delete drawer.dataset.animating;
                    drawer.classList.add('hidden');
                    drawer.style.display = '';
                    drawer.style.maxHeight = '';
                    drawer.style.opacity = '';
                    drawer.style.overflow = '';
                    drawer.style.transition = '';
                };

                const onEnd = (e) => {
                    if (e && (e.target !== drawer || e.propertyName !== 'max-height')) return;
                    drawer.removeEventListener('transitionend', onEnd);
                    finishCollapse();
                };
                drawer.addEventListener('transitionend', onEnd);
                setTimeout(finishCollapse, 320);

                if (label) label.textContent = <%- JSON.stringify(t.moreFilters) %>;
                if (icon) icon.classList.remove('rotate-180');
                try { localStorage.setItem('cdr_filters_expanded', 'false'); } catch (e) {}
            }
        }
        window.toggleCdrMoreFilters = toggleCdrMoreFilters;

        window.openCdrColumnsModal = openCdrColumnsModal;
        window.closeCdrColumnsModal = closeCdrColumnsModal;
        window.toggleCdrModalColumn = toggleCdrModalColumn;
        window.moveCdrModalColumn = moveCdrModalColumn;
        window.resetCdrColumnsToDefault = resetCdrColumnsToDefault;
        window.saveCdrColumnsPreference = saveCdrColumnsPreference;

    </script>

</body>
</html>

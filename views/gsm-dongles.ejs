                    <div class="flex items-center gap-2">
                        <span id="sms-modal-dongle" class="bg-[var(--accent-color)] text-white font-mono font-bold px-2 py-0.5 rounded text-[10px] uppercase"></span>
                        <span id="sms-modal-sender" class="text-[var(--text-primary)] font-bold font-mono text-sm"></span>
                        <button id="sms-modal-copy-sender" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] p-0.5 rounded transition cursor-pointer" title="Copy Number">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        </button>
                    </div>
                    <span id="sms-modal-time" class="text-[var(--text-muted)] font-mono"></span>
                </div>
                <!-- Content Area -->
                <div class="bg-[var(--bg-card)] border border-[var(--border-primary)] p-4 rounded-xl max-h-[250px] overflow-y-auto">
                    <p id="sms-modal-content" class="text-sm text-[var(--text-secondary)] leading-relaxed select-text whitespace-pre-wrap font-sans"></p>
                </div>
            </div>
            <!-- Modal Footer -->
            <div class="flex justify-end pt-2">
                <button onclick="closeSmsModal()" class="bg-[var(--bg-secondary)] hover:bg-[var(--bg-hover)] text-[var(--text-primary)] font-semibold rounded-lg px-5 py-2 text-sm transition cursor-pointer border border-[var(--border-primary)]">
                    <%= isRtl ? 'إغلاق' : 'Close' %>
                </button>
            </div>
        </div>
    </div>

    <!-- WebSockets Real-time streaming -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        let loadedDevices = <%- JSON.stringify(devices || []) %>;
        window.loadedDevices = loadedDevices;
        const isRtl = <%= isRtl %>;
        window.isRtl = isRtl;
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
        window.escapeHtml = escapeHtml;

        document.addEventListener('DOMContentLoaded', () => {
            const words = {
                stateFree: "<%= t.stateFree %>",
                stateDisconnected: "<%= t.stateDisconnected %>",
                stateGsmNotResponding: "<%= t.stateGsmNotResponding %>",
                stateNotInitializing: "<%= t.stateNotInitializing %>",
                reloadedSuccess: "<%= t.reloadedSuccess %>",
                sendUssdError: "<%= t.sendUssdError %>",
                sending: "<%= t.sending %>",
                sendBtn: "<%= t.sendBtn %>",
                running: "<%= t.running %>",
                refreshBtn: "<%= t.refreshBtn %>",
                noDongles: "<%= t.noDongles %>",
                selectPlaceholder: "<%= t.selectPlaceholder %>",
                usbNone: "<%= t.usbNone %>",
                usbNoneHint: "<%= t.usbNoneHint %>",
                usbMapped: "<%= isRtl ? 'مسجل في dongle' : 'Mapped' %>",
                usbUnmapped: "<%= isRtl ? 'غير مسجل' : 'Unmapped' %>",
                btnRestartDongle: "<%= t.btnRestartDongle %>",
                btnRebootModem: "<%= t.btnRebootModem %>",
                btnVirtualReplug: "<%= t.btnVirtualReplug %>",
                btnResetUsb: "<%= t.btnResetUsb %>"
            };

            // Socket.io initialization with safety check to prevent halts if blocked/undefined
            let socket = null;
            if (typeof io !== 'undefined') {
                socket = io();
            } else {
                console.warn("Socket.io (io) is not defined. Real-time updates will be disabled.");
            }
            
            // Elements
            const logsToggle = document.getElementById('logs-toggle-switch');
            const logScreen = document.getElementById('log-screen-console');
            const logsAutoscroll = document.getElementById('logs-autoscroll-chk');
            const clearLogsBtn = document.getElementById('clear-logs-btn');
            
            const ussdForm = document.getElementById('ussd-execution-form');
            const ussdTarget = document.getElementById('ussd-target-dongle');
            const ussdInput = document.getElementById('ussd-code-input');
            const ussdSubmitBtn = document.getElementById('ussd-submit-btn');
            const btnLabel = document.getElementById('btn-label');
            const btnSpinner = document.getElementById('btn-spinner');
            const terminalScreen = document.getElementById('terminal-screen');
            const terminalPlaceholder = document.getElementById('terminal-placeholder');
            
            const globalRefreshBtn = document.getElementById('global-refresh-btn');
            const donglesGrid = document.getElementById('dongles-grid');
            const deviceTotalEl = document.getElementById('gsm-device-total');
            const deviceReadyEl = document.getElementById('gsm-device-ready');
            
            // Detail display elements
            const elId = document.getElementById('info-id');
            const elNum = document.getElementById('info-number');
            const elProv = document.getElementById('info-provider');
            const globalResetUsbBtn = document.getElementById('global-reset-usb-btn');
            const elImei = document.getElementById('info-imei');
            const elImsi = document.getElementById('info-imsi');
            const elGroup = document.getElementById('info-group');
            const elModel = document.getElementById('info-model');
            const elFirm = document.getElementById('info-firmware');
            const elMode = document.getElementById('info-mode');
            const elSub = document.getElementById('info-submode');

            let selectedDongleId = null;
            let allSmsMessages = [];
            let lastUssdText = "";
            let lastUssdTime = 0;
            let devicesRefreshInFlight = false;

            function getDongleStateView(dev) {
                const rawState = String((dev && dev.State) || 'Not Connected');
                const normalized = rawState.toLowerCase();
                let color = 'red';
                let label = rawState;
                let animate = false;

                if (normalized.includes('not init')) {
                    color = 'yellow';
                    label = words.stateNotInitializing;
                } else if (normalized.includes('not responding')) {
                    label = words.stateGsmNotResponding;
                } else if (normalized.includes('not connec') || normalized === 'not_connected' || normalized.includes('disconnected')) {
                    label = isRtl ? 'غير متصل' : 'Not Connected';
                } else if (normalized === 'free' || normalized === 'idle') {
                    color = 'purple';
                    label = isRtl ? 'جاهز' : 'Free';
                } else if (normalized.includes('sms')) {
                    color = 'lightgreen';
                    label = isRtl ? 'رسالة SMS' : 'SMS';
                    animate = true;
                } else if (normalized.includes('outgoing') || normalized.includes('incoming') || normalized.includes('active') || normalized.includes('busy')) {
                    color = 'green';
                    label = normalized.includes('outgoing')
                        ? (isRtl ? 'مكالمة صادرة' : 'Outgoing Call')
                        : normalized.includes('incoming')
                            ? (isRtl ? 'مكالمة واردة' : 'Incoming Call')
                            : (isRtl ? 'مكالمة نشطة' : 'Active Call');
                    animate = true;
                } else if (normalized.includes('not reg') || normalized.includes('searching') || normalized.includes('no signal') || normalized.includes('gsm')) {
                    color = 'yellow';
                    label = isRtl ? 'غير مسجل' : 'GSM Not Registered';
                } else if (normalized.includes('dial') || normalized.includes('ring') || normalized.includes('calling')) {
                    color = 'blue';
                    label = normalized.includes('dial')
                        ? (isRtl ? 'جاري الاتصال' : 'Dialing')
                        : (isRtl ? 'جاري الرنين' : 'Ringing');
                    animate = true;
                }

                const badge = {
                    red: { bg: 'bg-red-500/15', text: 'text-red-400', border: 'border-red-500/30', dot: 'bg-red-500' },
                    purple: { bg: 'bg-purple-500/15', text: 'text-purple-400', border: 'border-purple-500/30', dot: 'bg-purple-400' },
                    green: { bg: 'bg-emerald-500/15', text: 'text-emerald-400', border: 'border-emerald-500/30', dot: 'bg-emerald-400' },
                    lightgreen: { bg: 'bg-green-500/15', text: 'text-green-400', border: 'border-green-500/30', dot: 'bg-green-400' },
                    yellow: { bg: 'bg-yellow-500/15', text: 'text-yellow-400', border: 'border-yellow-500/30', dot: 'bg-yellow-400' },
                    blue: { bg: 'bg-blue-500/15', text: 'text-blue-400', border: 'border-blue-500/30', dot: 'bg-blue-400' }
                }[color];

                return {
                    rawState,
                    color,
                    label,
                    animate,
                    badge,
                    isReady: color === 'purple' || color === 'green' || color === 'blue'
                };
            }

            function getDongleSignalView(dev) {
                const rawRssi = Number.parseInt(dev && dev.RSSI, 10);
                const rssi = Number.isFinite(rawRssi) ? Math.max(0, Math.min(31, rawRssi)) : 0;
                const percent = Math.round((rssi / 31) * 100);
                let activeColor = 'var(--status-success-text)';
                let level = isRtl ? 'ممتاز' : 'Excellent';

                if (rssi === 0) {
                    activeColor = 'var(--status-error-text)';
                    level = isRtl ? 'بدون إشارة' : 'No Signal';
                } else if (rssi < 9) {
                    activeColor = 'var(--status-error-text)';
                    level = isRtl ? 'ضعيف جداً' : 'Very Weak';
                } else if (rssi < 15) {
                    activeColor = 'var(--status-error-text)';
                    level = isRtl ? 'ضعيف' : 'Weak';
                } else if (rssi < 20) {
                    activeColor = 'var(--status-warning-text)';
                    level = isRtl ? 'متوسط' : 'Moderate';
                } else if (rssi < 25) {
                    level = isRtl ? 'جيد' : 'Good';
                }

                const thresholds = [1, 5, 9, 13, 18, 23, 28];
                const heights = [6, 10, 14, 18, 22, 26, 30];
                const barsHtml = thresholds.map((threshold, index) => {
                    const fill = rssi >= threshold ? activeColor : 'rgba(127,127,127,0.16)';
                    return `<span style="width:5px;height:${heights[index]}px;border-radius:2px;background:${fill};display:block"></span>`;
                }).join('');

                return { rssi, percent, activeColor, level, barsHtml };
            }

            function renderDongleRouting(dev) {
                const imei = String(dev.IMEI || '').trim();
                const trunks = Array.isArray(dev.customTrunks) ? dev.customTrunks : [];
                const validImei = /^\d{8,20}$/.test(imei);
                const emptyMessage = validImei
                    ? (isRtl ? 'لا يوجد مسار اتصال مخصص يحتوي على IMEI هذا الجهاز.' : 'No custom trunk dial string contains this IMEI.')
                    : (isRtl ? 'رقم IMEI غير متاح، لذلك لا يمكن مطابقة المسارات.' : 'IMEI unavailable, so routing cannot be matched.');

                if (trunks.length === 0) {
                    return `
                        <div class="dongle-routing-panel">
                            <div class="flex items-center gap-2 mb-1.5">
                                <svg class="text-[var(--text-muted)] shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                <span class="text-[9px] font-black uppercase tracking-wider text-[var(--text-secondary)]">${isRtl ? 'الربط الصادر عبر IMEI' : 'IMEI-Linked Outbound Routing'}</span>
                            </div>
                            <p class="text-[9px] text-[var(--text-muted)] leading-relaxed">${escapeHtml(emptyMessage)}</p>
                        </div>`;
                }

                const routeCount = trunks.reduce((total, trunk) => total + (Array.isArray(trunk.routes) ? trunk.routes.length : 0), 0);
                return `
                    <div class="dongle-routing-panel">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                            <div class="flex items-center gap-2 min-w-0">
                                <svg class="text-sky-400 shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                <span class="text-[9px] font-black uppercase tracking-wider text-[var(--text-secondary)]">${isRtl ? 'الربط الصادر عبر IMEI' : 'IMEI-Linked Outbound Routing'}</span>
                            </div>
                            <span class="text-[8px] font-mono font-bold text-sky-400 shrink-0">${trunks.length} ${isRtl ? 'مسار' : 'trunk'} · ${routeCount} ${isRtl ? 'وجهة' : 'routes'}</span>
                        </div>
                        <div class="space-y-1.5">
                            ${trunks.map(trunk => {
                                const routes = Array.isArray(trunk.routes) ? trunk.routes : [];
                                return `
                                    <div class="dongle-routing-trunk">
                                        <div class="flex items-center justify-between gap-2 mb-1">
                                            <div class="min-w-0">
                                                <span class="text-[10px] font-extrabold text-[var(--text-primary)] truncate block">${escapeHtml(trunk.name || `Trunk #${trunk.trunkId}`)}</span>
                                                <span class="text-[8px] text-[var(--text-muted)] font-mono">Trunk #${escapeHtml(trunk.trunkId)}</span>
                                            </div>
                                            <span class="px-1.5 py-0.5 rounded-full border text-[8px] font-bold shrink-0 ${trunk.disabled ? 'bg-red-500/10 border-red-500/20 text-red-400' : 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400'}">
                                                ${trunk.disabled ? (isRtl ? 'معطل' : 'Disabled') : (isRtl ? 'مفعل' : 'Enabled')}
                                            </span>
                                        </div>
                                        <div class="dongle-dial-string font-mono mb-1.5" title="${escapeHtml(trunk.dialString || '')}">${escapeHtml(trunk.dialString || '-')}</div>
                                        <div class="flex flex-wrap items-center gap-1">
                                            <span class="text-[8px] font-bold uppercase tracking-wider text-[var(--text-muted)]">${isRtl ? 'المسارات الصادرة' : 'Outbound Routes'}</span>
                                            ${routes.length > 0
                                                ? routes.map(route => `<span class="dongle-route-chip"><span class="truncate">${escapeHtml(route.name || `Route #${route.routeId}`)}</span><span class="opacity-60 ms-1 shrink-0">#${escapeHtml(route.routeId)}</span></span>`).join('')
                                                : `<span class="text-[8px] italic text-[var(--text-muted)]">${isRtl ? 'غير مرتبط بأي مسار صادر' : 'Not assigned to an outbound route'}</span>`}
                                        </div>
                                    </div>`;
                            }).join('')}
                        </div>
                    </div>`;
            }

            function renderDongleCards() {
                if (!donglesGrid) return;

                const states = loadedDevices.map(getDongleStateView);
                if (deviceTotalEl) deviceTotalEl.textContent = String(loadedDevices.length);
                if (deviceReadyEl) deviceReadyEl.textContent = String(states.filter(state => state.isReady).length);
                donglesGrid.innerHTML = '';

                if (loadedDevices.length === 0) {
                    donglesGrid.innerHTML = `
                        <div class="col-span-full py-10 text-center">
                            <div class="w-10 h-10 mx-auto mb-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] flex items-center justify-center text-[var(--text-muted)]">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17h16M7 13h10M10 9h4"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-[var(--text-secondary)]">${escapeHtml(words.noDongles)}</p>
                        </div>`;
                    return;
                }

                loadedDevices.forEach((dev, index) => {
                    const id = String(dev.ID || '');
                    const phoneNumber = String(dev.Number || 'Unknown');
                    const imsi = String(dev.IMSI || '-');
                    const imei = String(dev.IMEI || '-');
                    const provider = String(dev['Provider Name'] || 'NONE');
                    const model = String(dev.Model || '-');
                    const firmware = String(dev.Firmware || '-');
                    const mode = [dev.Mode, dev.Submode].filter(Boolean).join(' / ') || '-';
                    const state = states[index];
                    const signal = getDongleSignalView(dev);
                    const card = document.createElement('article');

                    card.className = `dongle-device-card dongle-state-${state.color} rounded-2xl cursor-pointer flex flex-col`;
                    card.id = 'row-' + id;
                    card.dataset.dongleId = id;
                    card.dataset.number = phoneNumber === 'Unknown' ? '' : phoneNumber;
                    card.dataset.imsi = imsi;
                    card.dataset.imei = imei;
                    if (id === selectedDongleId) card.classList.add('selected-row');

                    card.innerHTML = `
                        <div class="p-3 sm:p-4 flex-1">
                            <div class="flex items-start justify-between gap-2.5 mb-3">
                                <div class="flex items-center gap-3 min-w-0">
                                    <div class="w-9 h-9 rounded-xl dongle-icon-box flex items-center justify-center shrink-0">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 18h6M9 6h.01M12 6h.01M15 6h.01"/></svg>
                                    </div>
                                    <div class="min-w-0">
                                        <h4 class="text-base sm:text-lg font-black text-[var(--text-primary)] font-mono truncate tracking-tight">${escapeHtml(id)}</h4>
                                        <p class="text-[10px] text-[var(--text-muted)] truncate">${escapeHtml(provider)}</p>
                                    </div>
                                </div>
                                <span class="px-2 py-1 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)] text-[9px] font-bold text-[var(--text-muted)] shrink-0">${isRtl ? 'المجموعة' : 'Group'} ${escapeHtml(dev.Group || '0')}</span>
                            </div>

                            <div class="dongle-priority-grid grid grid-cols-1 sm:grid-cols-2 gap-2">
                                <div class="dongle-priority-metric">
                                    <span class="dongle-metric-label">IMEI · ${isRtl ? 'هوية الجهاز' : 'Device Identity'}</span>
                                    <div class="flex items-center gap-2 min-w-0">
                                        <span class="dongle-priority-value font-mono flex-1">${escapeHtml(imei)}</span>
                                        ${imei !== '-' && imei !== 'Unknown' ? `<button type="button" data-dongle-action="copy-imei" class="w-6 h-6 rounded-md bg-[var(--bg-primary)]/40 border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer shrink-0" title="${isRtl ? 'نسخ IMEI' : 'Copy IMEI'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                                    </div>
                                </div>
                                <div class="dongle-priority-metric">
                                    <span class="dongle-metric-label">${isRtl ? 'الحالة الحالية' : 'Current State'}</span>
                                    <span class="dongle-status-pill w-full inline-flex items-center justify-center gap-2 rounded-lg px-3 py-1.5 text-xs font-black border uppercase tracking-wider">
                                        <span class="dongle-status-dot h-2 w-2 rounded-full ${state.badge.dot}${state.animate ? ' animate-pulse' : ''} shrink-0"></span>
                                        ${escapeHtml(state.label)}
                                    </span>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-2">
                                <div class="dongle-metric">
                                    <span class="dongle-metric-label">${isRtl ? 'رقم الشريحة' : 'DID / SIM'}</span>
                                    <div class="flex items-center gap-1 min-w-0">
                                        <span id="display-num-${escapeHtml(id)}" class="dongle-metric-value font-mono flex-1 truncate">${escapeHtml(phoneNumber)}</span>
                                        ${phoneNumber !== 'Unknown' ? `<button type="button" data-dongle-action="copy-number" class="p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'نسخ الرقم' : 'Copy number'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                                        <button type="button" data-dongle-action="edit-number" class="p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'تعديل الرقم' : 'Edit number'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4z"/></svg></button>
                                    </div>
                                </div>
                                <div class="dongle-metric">
                                    <span class="dongle-metric-label">${isRtl ? 'الإشارة' : 'Signal'}</span>
                                    <div class="flex items-end justify-between gap-2">
                                        <span class="dongle-metric-value font-mono" style="color:${signal.activeColor}">${signal.percent}%</span>
                                        <div class="flex items-end gap-0.5 h-[24px]">${signal.barsHtml}</div>
                                    </div>
                                </div>
                                <div class="dongle-metric col-span-2">
                                    <span class="dongle-metric-label">IMSI · ${isRtl ? 'هوية الشريحة' : 'SIM Identity'}</span>
                                    <span class="dongle-metric-value font-mono truncate" title="${escapeHtml(imsi)}">${escapeHtml(imsi)}</span>
                                </div>
                                <div class="dongle-hardware-summary col-span-2 flex items-center justify-between gap-2 min-w-0">
                                    <span class="font-black uppercase tracking-wider shrink-0">${isRtl ? 'الجهاز' : 'Hardware'}</span>
                                    <span class="font-mono truncate text-end" title="${escapeHtml(`${model} · ${mode} · ${firmware}`)}">${escapeHtml(model)} · ${escapeHtml(mode)} · ${escapeHtml(firmware)}</span>
                                </div>
                            </div>

                            ${renderDongleRouting(dev)}
                        </div>
                        <div class="dongle-card-footer px-3 sm:px-4 py-2.5 flex items-center justify-between gap-2">
                            <span class="text-[10px] font-extrabold text-[var(--text-muted)] flex items-center gap-1.5 shrink-0">
                                <span style="color:${signal.activeColor}">●</span> ${escapeHtml(signal.level)} · ${signal.rssi}/31
                            </span>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" id="reloadBtn-${escapeHtml(id)}" data-dongle-action="reload" class="dongle-action-button dongle-action-primary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnRestartDongle)}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                                </button>

                                <button type="button" id="rebootBtn-${escapeHtml(id)}" data-dongle-action="reboot-modem" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnRebootModem)}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                                </button>

                                <button type="button" id="virtualReplugBtn-${escapeHtml(id)}" data-dongle-action="virtual-replug" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnVirtualReplug)}">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22v-5"/><path d="M9 8V2h6v6"/><path d="M6 13V8h12v5a6 6 0 0 1-12 0z"/></svg>
                                </button>

                            </div>
                        </div>`;

                    donglesGrid.appendChild(card);
                });
            }

            if (donglesGrid) {
                donglesGrid.addEventListener('click', event => {
                    const card = event.target.closest('.dongle-device-card');
                    if (!card || !donglesGrid.contains(card)) return;

                    const id = card.dataset.dongleId;
                    const actionButton = event.target.closest('[data-dongle-action]');
                    if (!actionButton) {
                        selectDevice(id);
                        return;
                    }

                    const action = actionButton.dataset.dongleAction;
                    if (action === 'copy-imei') copyToClipboard(card.dataset.imei, actionButton);
                    if (action === 'copy-number') copyToClipboard(card.dataset.number, actionButton);
                    if (action === 'edit-number') editSimNumber(id, card.dataset.imsi, card.dataset.number);
                    if (action === 'reload') reloadDongle(id);
                    if (action === 'reboot-modem') rebootModem(id);
                    if (action === 'virtual-replug') virtualReplug(id);
                    if (action === 'reset-usb') resetUsbPort(id);
                });
            }

            function appendUssdResponse(logTime, text, isLive) {
                const now = Date.now();
                const normalizedText = String(text || '').trim();
                
                // Deduplicate identical responses printed within 3 seconds
                if (normalizedText === lastUssdText && (now - lastUssdTime) < 3000) {
                    return;
                }
                
                lastUssdText = normalizedText;
                lastUssdTime = now;
                
                const respLine = document.createElement('div');
                respLine.className = 'text-emerald-400 font-bold bg-emerald-950/10 p-2 rounded border border-emerald-900/20 mt-1 whitespace-pre-wrap leading-relaxed select-text';
                
                const displayLabel = isLive ? ' (Live Event)' : '';
                const displayText = normalizedText || '(Empty Response / Terminated by Network)';
                respLine.innerHTML = `<span class="text-zinc-500 font-normal">[${logTime}]${displayLabel}</span> ${displayText}`;
                
                terminalScreen.appendChild(respLine);
                terminalScreen.scrollTop = terminalScreen.scrollHeight;
            }

            // Select Row behavior to display details
            window.selectDevice = function(id) {
                try {
                    const normalizedId = String(id || '');
                    const dev = loadedDevices.find(device => String(device.ID || '') === normalizedId);
                    if (!dev) return;

                    document.querySelectorAll('.dongle-device-card').forEach(card => {
                        card.classList.remove('selected-row');
                    });
                    const selectedRow = document.getElementById('row-' + normalizedId);
                    if (selectedRow) selectedRow.classList.add('selected-row');
                    
                    // Fill metadata cards
                    elId.textContent = dev.ID || '-';
                    elNum.textContent = dev.Number || 'Unknown';
                    elProv.textContent = dev['Provider Name'] || 'NONE';
                    elImei.textContent = dev.IMEI || '-';
                    elImsi.textContent = dev.IMSI || '-';
                    elGroup.textContent = dev.Group || '0';
                    elModel.textContent = dev.Model || '-';
                    elFirm.textContent = dev.Firmware || '-';
                    elMode.textContent = dev.Mode || '-';
                    elSub.textContent = dev.Submode || '-';

                    selectedDongleId = normalizedId;
                    updateSmsInboxTitle();
                    filterAndRenderSms();

                    // Update Live Status & Diagnostics Block
                    updateLiveDiagnostics(dev);

                    // Sync select dropdown
                    if (ussdTarget) {
                        ussdTarget.value = id;
                    }
                } catch (err) {
                    console.error("Error inside selectDevice:", err);
                }
            };

            function updateLiveDiagnostics(dev) {
                try {
                    const signal = getDongleSignalView(dev);
                    const state = getDongleStateView(dev);
                    const barsContainer = document.getElementById('diag-signal-bars');
                    const signalText = document.getElementById('diag-signal-text');
                    const badgeContainer = document.getElementById('diag-service-badge');
                    const carrierEl = document.getElementById('diag-carrier-text');

                    if (barsContainer) barsContainer.innerHTML = signal.barsHtml;
                    if (signalText) signalText.textContent = `${signal.rssi}/31 · ${signal.percent}% · ${signal.level}`;
                    if (carrierEl) carrierEl.textContent = dev['Provider Name'] || (isRtl ? 'غير معروف' : 'Unknown');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = `
                            <span class="inline-flex items-center gap-1.5 ${state.badge.bg} ${state.badge.text} rounded-full px-2.5 py-1 text-[10px] font-semibold border ${state.badge.border}">
                                <span class="h-1.5 w-1.5 rounded-full ${state.badge.dot}${state.animate ? ' animate-pulse' : ''} shrink-0"></span>
                                ${escapeHtml(state.label)}
                            </span>`;
                    }

                    const checklist = [
                        document.getElementById('chk-voice'),
                        document.getElementById('chk-sms'),
                        document.getElementById('chk-ussd')
                    ];
                    let checklistClass = 'text-zinc-500 font-bold font-mono';
                    let checklistLabel = '● OFF';
                    if (state.isReady) {
                        checklistClass = 'text-emerald-500 font-bold font-mono';
                        checklistLabel = '● OK';
                    } else if (state.color === 'yellow') {
                        checklistClass = 'text-red-500 font-bold font-mono';
                        checklistLabel = '● FAIL';
                    } else if (state.color !== 'red') {
                        checklistClass = 'text-amber-500 font-bold font-mono';
                        checklistLabel = '● WAIT';
                    }
                    checklist.forEach(element => {
                        if (!element) return;
                        element.className = checklistClass;
                        element.textContent = checklistLabel;
                    });
                } catch (error) {
                    console.error('Error updating live diagnostics:', error);
                }
            }

            renderDongleCards();
            if (loadedDevices.length > 0) {
                selectDevice(loadedDevices[0].ID);
            }

            // Sync detail card and table highlight when select dropdown is changed
            if (ussdTarget) {
                ussdTarget.addEventListener('change', (e) => {
                    selectDevice(e.target.value);
                });
            }

            // --- SMS INBOX MANAGEMENT ---
            function getSmsContainer() {
                return document.getElementById('sms-inbox-container');
            }

            function updateSmsInboxTitle() {
                const deviceEl = document.getElementById('sms-inbox-device');
                if (!deviceEl) return;
                deviceEl.textContent = selectedDongleId
                    ? `${isRtl ? 'الجهاز المحدد' : 'Selected'}: ${selectedDongleId}`
                    : (isRtl ? 'اختر جهازاً' : 'Select a dongle');
            }

            function updateSmsInboxCount(count) {
                const countEl = document.getElementById('sms-inbox-count');
                if (countEl) countEl.textContent = String(count);
            }

            // Toast Notification system
            const toastContainer = document.getElementById('toast-container');
            
            function showSmsToast(sms) {
                if (!toastContainer) return;
                
                const toast = document.createElement('div');
                // Premium glassmorphism dynamic style
                toast.className = 'bg-[var(--bg-secondary)]/90 border border-[var(--border-primary)] shadow-2xl p-4 rounded-xl flex flex-col gap-1.5 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto cursor-pointer max-w-xs';
                
                toast.innerHTML = `
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-[var(--accent-color)] font-bold uppercase tracking-wider font-mono">${isRtl ? 'رسالة جديدة' : 'New SMS'}</span>
                        <span class="text-[var(--text-muted)] font-mono text-[10px]">${sms.dongleId}</span>
                    </div>
                    <div class="text-xs font-bold text-[var(--text-primary)]">${sms.sender}</div>
                    <p class="text-xs text-[var(--text-secondary)] truncate">${sms.content}</p>
                `;
                
                toast.onclick = function() {
                    if (selectedDongleId && selectedDongleId.toLowerCase() !== sms.dongleId.toLowerCase()) {
                        selectDevice(sms.dongleId);
                    }
                    showSmsModal(sms.dongleId, sms.sender, sms.content, sms.timestamp);
                    toast.remove();
                };
                
                toastContainer.appendChild(toast);
                
                // Animate entrance
                setTimeout(() => {
                    toast.classList.remove('translate-y-5', 'opacity-0');
                }, 10);
                
                // Auto dismiss after 6 seconds
                setTimeout(() => {
                    toast.classList.add('translate-y-5', 'opacity-0');
                    setTimeout(() => { toast.remove(); }, 300);
                }, 6000);
            }

            function showToast(title, message, type) {
                if (!toastContainer) return;
                const toast = document.createElement('div');
                const borderColor = type === 'error' ? 'border-red-900' : type === 'warning' ? 'border-amber-500/50' : type === 'success' ? 'border-emerald-900' : 'border-[var(--border-primary)]';
                const titleColor = type === 'error' ? 'text-red-400' : type === 'warning' ? 'text-amber-400' : type === 'success' ? 'text-emerald-400' : 'text-[var(--text-primary)]';
                toast.className = 'bg-[var(--bg-secondary)]/90 border ' + borderColor + ' shadow-2xl p-4 rounded-xl flex flex-col gap-1.5 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto max-w-xs';
                toast.innerHTML = '\
                    <div class="flex items-center justify-between text-xs">\
                        <span class="' + titleColor + ' font-bold uppercase tracking-wider">' + title + '</span>\
                    </div>\
                    <p class="text-xs text-[var(--text-secondary)] whitespace-pre-wrap">' + message + '</p>\
                ';
                toast.onclick = function() { toast.remove(); };
                toastContainer.appendChild(toast);
                setTimeout(function() { toast.classList.remove('translate-y-5', 'opacity-0'); }, 10);
                setTimeout(function() {
                    toast.classList.add('translate-y-5', 'opacity-0');
                    setTimeout(function() { toast.remove(); }, 300);
                }, 8000);
            }

            // Modal DOM elements & controllers
            const smsModal = document.getElementById('sms-modal');
            const smsModalCard = document.getElementById('sms-modal-card');
            const smsModalDongle = document.getElementById('sms-modal-dongle');
            const smsModalSender = document.getElementById('sms-modal-sender');
            const smsModalCopySender = document.getElementById('sms-modal-copy-sender');
            const smsModalTime = document.getElementById('sms-modal-time');
            const smsModalContent = document.getElementById('sms-modal-content');
            
            window.showSmsModal = function(dongleId, sender, content, timestamp) {
                smsModalDongle.textContent = dongleId;
                smsModalSender.textContent = sender;
                smsModalTime.textContent = new Date(timestamp).toLocaleString();
                smsModalContent.textContent = content;
                
                smsModalCopySender.onclick = function() {
                    copyToClipboard(sender, smsModalCopySender);
                };
                
                smsModal.classList.remove('opacity-0', 'pointer-events-none');
                smsModalCard.classList.remove('scale-95', 'opacity-0');
                smsModalCard.classList.add('scale-100', 'opacity-100');
            };
            
            window.closeSmsModal = function() {
                smsModal.classList.add('opacity-0', 'pointer-events-none');
                smsModalCard.classList.remove('scale-100', 'opacity-100');
                smsModalCard.classList.add('scale-95', 'opacity-0');
            };
            
            // Close on outer click
            smsModal.addEventListener('click', (e) => {
                if (e.target === smsModal) closeSmsModal();
            });
            
            // Close on ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !smsModal.classList.contains('opacity-0')) {
                    closeSmsModal();
                }
            });

            function renderSmsCard(sms) {
                const dateStr = new Date(sms.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const card = document.createElement('div');
                card.className = 'sms-message-card p-3.5 bg-[var(--bg-card)] border border-[var(--border-primary)] hover:border-[var(--border-accent)] rounded-xl transition flex flex-col gap-2 cursor-pointer select-none';
                card.id = 'sms-' + sms.id;
                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="bg-[var(--accent-color)] text-white font-mono font-bold px-1.5 py-0.5 rounded text-[9px] uppercase shrink-0">${escapeHtml(sms.dongleId)}</span>
                            <span class="text-[var(--text-primary)] font-bold font-mono truncate">${escapeHtml(sms.sender)}</span>
                            <button type="button" class="sms-copy-sender text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded transition cursor-pointer shrink-0" title="${isRtl ? 'نسخ الرقم' : 'Copy number'}">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                            </button>
                        </div>
                        <span class="text-[var(--text-muted)] font-mono text-[9px] shrink-0">${escapeHtml(dateStr)}</span>
                    </div>
                    <p class="text-xs text-[var(--text-secondary)] leading-relaxed select-text font-sans line-clamp-2">${escapeHtml(sms.content)}</p>`;

                const copyButton = card.querySelector('.sms-copy-sender');
                copyButton.addEventListener('click', event => {
                    event.stopPropagation();
                    copyToClipboard(sms.sender, copyButton);
                });
                card.addEventListener('click', () => {
                    showSmsModal(sms.dongleId, sms.sender, sms.content, sms.timestamp);
                });
                return card;
            }

            function filterAndRenderSms() {
                const container = getSmsContainer();
                if (!container) return;

                if (!selectedDongleId) {
                    showEmptySmsInbox();
                    return;
                }

                const filtered = allSmsMessages.filter(sms => (sms.dongleId || '').toLowerCase() === selectedDongleId.toLowerCase());
                updateSmsInboxCount(filtered.length);
                container.innerHTML = '';
                if (filtered.length === 0) {
                    showEmptySmsInbox();
                    return;
                }
                filtered.forEach(sms => container.appendChild(renderSmsCard(sms)));
            }

            window.loadSmsInbox = async function() {
                try {
                    const res = await fetch('/api/gsm-dongles/sms');
                    const data = await res.json();
                    if (data.success && data.sms) {
                        allSmsMessages = data.sms;
                        filterAndRenderSms();
                    } else {
                        allSmsMessages = [];
                        showEmptySmsInbox();
                    }
                } catch (e) {
                    console.error("Failed to load SMS inbox:", e);
                }
            };

            window.clearSmsInbox = async function() {
                if (!confirm(isRtl ? 'هل أنت متأكد من مسح صندوق الرسائل؟' : 'Are you sure you want to clear the SMS inbox?')) return;
                try {
                    await fetch('/api/gsm-dongles/clear-sms', { method: 'POST' });
                } catch (e) {
                    console.error("Failed to clear SMS inbox:", e);
                }
            };

            function showEmptySmsInbox() {
                const container = getSmsContainer();
                if (!container) return;
                updateSmsInboxCount(0);
                container.innerHTML = `
                    <div class="text-center py-8 text-[var(--text-muted)] italic" id="sms-empty-placeholder">
                        ${isRtl ? 'لا يوجد رسائل واردة حالياً' : 'No incoming SMS messages'}
                    </div>`;
            }

            // Real-time SMS receivers
            if (socket) {
                socket.on('newSms', (sms) => {
                    allSmsMessages.unshift(sms);
                    
                    // Show a real-time toast notification alert
                    showSmsToast(sms);
                    
                    if (selectedDongleId && (sms.dongleId || '').toLowerCase() === selectedDongleId.toLowerCase()) {
                        const placeholder = document.getElementById('sms-empty-placeholder');
                        if (placeholder && placeholder.parentNode) {
                            placeholder.parentNode.removeChild(placeholder);
                        }
                        const container = getSmsContainer();
                        if (container) {
                            container.insertBefore(renderSmsCard(sms), container.firstChild);
                        }
                        updateSmsInboxCount(allSmsMessages.filter(message => (message.dongleId || '').toLowerCase() === selectedDongleId.toLowerCase()).length);
                    }
                });

                socket.on('smsCleared', () => {
                    allSmsMessages = [];
                    showEmptySmsInbox();
                });
            }

            // Initial load
            loadSmsInbox();

            // --- USB TTY DEVICE LISTING ---
            const usbGrid = document.getElementById('usb-devices-grid');

            let lastUsbSignature = null;
            let usbRefreshInFlight = false;
            let usbHasLoaded = false;
            const usbHtmlEntities = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            };

            function escapeUsbText(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => usbHtmlEntities[character]);
            }

            function getUsbSignature(devices) {
                return JSON.stringify(devices.map(device => ({
                    name: device.name || '',
                    dongleId: device.dongleId || '',
                    portType: device.portType || ''
                })));
            }

            function renderUsbDevices(devices) {
                if (devices.length === 0) {
                    usbGrid.innerHTML = `
                        <div class="col-span-full flex flex-col items-center justify-center py-6 gap-2">
                            <svg class="text-zinc-600" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            <span class="text-sm font-bold text-zinc-500">${words.usbNone}</span>
                            <span class="text-[10px] text-zinc-600 max-w-xs text-center">${words.usbNoneHint}</span>
                        </div>`;
                    return;
                }

                usbGrid.innerHTML = devices.map(device => {
                    const mapped = Boolean(device.dongleId);
                    const matchBorder = mapped
                        ? 'border-emerald-500/40 bg-emerald-950/15'
                        : 'border-[var(--border-primary)] bg-[var(--bg-card)]';
                    const matchIcon = mapped
                        ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
                        : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
                    const label = mapped
                        ? `${device.dongleId} (${device.portType || ''})`
                        : words.usbUnmapped;

                    return `
                        <div class="flex flex-col items-center gap-2 p-3 rounded-xl border ${matchBorder} transition hover:border-[var(--accent-color)]/40 cursor-default">
                            <div class="flex items-center gap-1.5">
                                ${matchIcon}
                                <span class="font-mono text-sm font-bold text-[var(--text-primary)]">${escapeUsbText(device.name)}</span>
                            </div>
                            <span class="text-[9px] font-bold uppercase tracking-wider ${mapped ? 'text-emerald-400' : 'text-zinc-500'}">${escapeUsbText(label)}</span>
                        </div>`;
                }).join('');
            }

            window.refreshUsbDevices = async function() {
                if (!usbGrid || usbRefreshInFlight) return;
                usbRefreshInFlight = true;

                if (!usbHasLoaded) {
                    usbGrid.innerHTML = '<div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading...</div>';
                }

                try {
                    const response = await fetch('/api/gsm-dongles/ttyusb-devices', { cache: 'no-store' });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        throw new Error(data.error || 'Failed to fetch USB devices');
                    }

                    const devices = Array.isArray(data.devices) ? data.devices : [];
                    const signature = getUsbSignature(devices);
                    if (signature !== lastUsbSignature) {
                        lastUsbSignature = signature;
                        renderUsbDevices(devices);
                    }
                    usbHasLoaded = true;
                } catch (error) {
                    console.error('Failed to refresh USB devices:', error);
                    if (!usbHasLoaded) {
                        usbGrid.innerHTML = '<div class="text-red-400 text-xs text-center col-span-full py-4">' + (isRtl ? 'فشل في جلب البيانات' : 'Failed to fetch') + '</div>';
                        usbHasLoaded = true;
                    }
                } finally {
                    usbRefreshInFlight = false;
                }
            };
            if (socket) {
                socket.on('dongleLog', (line) => {
                    if (!logsToggle.checked) return;
                    
                    const lineEl = document.createElement('div');
                    lineEl.className = 'py-0.5 border-b border-zinc-950/20';
                    
                    if (line.includes('ERROR') || line.includes('WARNING') || line.includes('Failed')) {
                        lineEl.className += ' text-rose-500';
                    } else if (line.includes('NOTICE') || line.includes('Got USSD')) {
                        lineEl.className += ' text-emerald-400 font-bold';
                    } else {
                        lineEl.className += ' text-zinc-500';
                    }
                    
                    lineEl.textContent = line;
                    logScreen.appendChild(lineEl);
                    
                    if (logsAutoscroll.checked) {
                        logScreen.scrollTop = logScreen.scrollHeight;
                    }
                });
            }
            // Initial load, then one-second checks without clearing unchanged content
            refreshUsbDevices();
            setInterval(refreshUsbDevices, 1000);

            clearLogsBtn.addEventListener('click', function() {
                logScreen.innerHTML = '<div class="text-zinc-600">[System] Log screen cleared. Awaiting hardware events...</div>';
            });

            // Toggle logs console container visibility
            logsToggle.addEventListener('change', () => {
                logScreen.classList.toggle('hidden', !logsToggle.checked);
            });

            // Copy to clipboard utility with green checkmark feedback (supports non-secure HTTP local IP fallback)
            window.copyToClipboard = function(text, btn) {
                const clean = String(text || '').trim();
                if (!clean || clean === '-' || clean === 'Unknown') return;
                
                function fallbackCopy(val) {
                    const textArea = document.createElement("textarea");
                    textArea.value = val;
                    textArea.style.top = "0";
                    textArea.style.left = "0";
                    textArea.style.position = "fixed";
                    textArea.style.opacity = "0";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        showFeedback();
                    } catch (err) {
                        console.error('Fallback copy failed: ', err);
                    }
                    document.body.removeChild(textArea);
                }

                function showFeedback() {
                    if (btn) {
                        const originalHTML = btn.innerHTML;
                        btn.innerHTML = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
                        btn.style.pointerEvents = 'none';
                        setTimeout(() => {
                            btn.innerHTML = originalHTML;
                            btn.style.pointerEvents = 'auto';
                        }, 1500);
                    }
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(clean).then(showFeedback).catch(() => {
                        fallbackCopy(clean);
                    });
                } else {
                    fallbackCopy(clean);
                }
            };

            // Edit SIM phone number mapping action
            window.editSimNumber = function(dongleId, imsi, currentVal) {
                if ((!currentVal || currentVal === 'Unknown' || currentVal === '-') && dongleId) {
                    const el = document.getElementById('display-num-' + dongleId);
                    if (el && el.textContent && !el.textContent.includes('Unknown') && !el.textContent.includes('-')) {
                        currentVal = el.textContent.trim();
                    }
                }
                const promptMsg = isRtl 
                    ? `أدخل رقم الهاتف الجديد للشريحة (IMSI: ${imsi}):` 
                    : `Enter phone number for SIM card (IMSI: ${imsi}):`;
                
                const newNum = prompt(promptMsg, currentVal || '');
                if (newNum === null) return;
                const trimmed = newNum.trim().replace(/\s+/g, '');
                if (!trimmed) return;

                // Removed 11-digit restriction to accept any entered SIM phone number string verbatim
                
                const displaySpan = document.getElementById('display-num-' + dongleId);
                if (displaySpan) displaySpan.innerHTML = '<span class="text-zinc-500 italic">Saving...</span>';
                
                showToast(dongleId, isRtl ? 'جاري حفظ الرقم...' : 'Saving number and sending AT commands...', 'info');
                
                fetch('/api/gsm-dongles/save-number', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imsi, number: trimmed, dongleId })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.results) {
                        let details = data.results.map(function(r) {
                            const status = r.error ? '❌' : '✅';
                            return status + ' ' + r.step + (r.error ? ': ' + r.error : '');
                        }).join('\n');
                        const isAtSuccess = data.atSuccess !== false && !data.results.some(r => r.error);
                        const toastTitle = dongleId + ' - ' + (isAtSuccess
                            ? (isRtl ? 'تم الحفظ في الشريحة واللوحة' : 'Saved to SIM Card & Dashboard')
                            : (isRtl ? 'تم الحفظ في اللوحة (تحذير أستريسك)' : 'Saved to Dashboard (Asterisk Warning)'));
                        showToast(toastTitle, details, isAtSuccess ? 'success' : 'warning');
                    } else if (data.success) {
                        showToast(dongleId, isRtl ? 'تم الحفظ في اللوحة' : 'Saved to Dashboard', 'success');
                    } else {
                        showToast(dongleId, (isRtl ? 'فشل الحفظ: ' : 'Failed: ') + (data.error || 'Unknown error'), 'error');
                    }
                    refreshDevicesList();
                })
                .catch(err => {
                    console.error("Error saving SIM number:", err);
                    showToast(dongleId, isRtl ? 'خطأ في الاتصال' : 'Connection error', 'error');
                    refreshDevicesList();
                });
            };

            // Reload single dongle action
            // 1. Reload / Restart single dongle action
            window.reloadDongle = function(id) {
                if (!confirm((isRtl ? 'هل أنت متأكد من إعادة تشغيل الشريحة ' : 'Are you sure you want to restart ') + id + '?')) return;
                const btn = document.getElementById('reloadBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة تشغيل' : 'Restarting', (isRtl ? 'جاري إعادة تشغيل الشريحة ' : 'Restarting dongle ') + id + '...', 'info');

                fetch('/api/gsm-dongles/reload/' + id, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', words.reloadedSuccess + ' (' + id + ')', 'success');
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Unknown server error', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            // 2. Reboot modem firmware via AT command (AT+CFUN=1,1)
            window.rebootModem = function(id) {
                if (!confirm((isRtl ? 'هل أنت متأكد من إعادة تشغيل مودم الجهاز ' : 'Are you sure you want to reboot modem ') + id + '?')) return;
                const btn = document.getElementById('rebootBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة تشغيل المودم' : 'Modem Reboot', (isRtl ? 'جاري إرسال أمر إعادة تشغيل المودم ' : 'Sending modem reboot command to ') + id + '...', 'warning');

                fetch('/api/gsm-dongles/reboot-modem/' + id, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (isRtl ? 'تم إرسال أمر إعادة تشغيل المودم لـ ' : 'Modem reboot command sent to ') + id, 'success');
                            setTimeout(refreshDevicesList, 3000);
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Modem reboot failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            // 3. Virtual USB Unplug & Re-plug (Kernel sysfs unbind/bind)
            window.virtualReplug = function(id) {
                if (!confirm((isRtl ? 'هل أنت متأكد من محاكاة إعادة توصيل USB لـ ' : 'Are you sure you want to simulate virtual USB re-plug for ') + id + '?')) return;
                const btn = document.getElementById('virtualReplugBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة توصيل USB' : 'Virtual USB Re-plug', (isRtl ? 'جاري فصل وإعادة توصيل USB لـ ' : 'Simulating virtual USB re-plug for ') + id + '...', 'warning');

                fetch('/api/gsm-dongles/virtual-replug/' + id, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (isRtl ? 'تمت محاكاة إعادة توصيل USB بنجاح لـ ' : 'Virtual USB re-plug executed for ') + id, 'success');
                            setTimeout(refreshDevicesList, 4000);
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Virtual re-plug failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            window.toggleLegendBlock = function() {
                const block = document.getElementById('legend-content-block');
                const text = document.getElementById('legend-toggle-text');
                const icon = document.getElementById('legend-toggle-icon');
                if (!block) return;

                const isHidden = block.classList.contains('hidden');
                if (isHidden) {
                    block.classList.remove('hidden');
                    if (text) text.textContent = isRtl ? 'إخفاء الدليل' : 'Hide Guide';
                    if (icon) icon.classList.add('rotate-180');
                } else {
                    block.classList.add('hidden');
                    if (text) text.textContent = isRtl ? 'عرض الدليل' : 'Show Guide';
                    if (icon) icon.classList.remove('rotate-180');
                }
            };

            // Send USSD request action
            ussdForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const target = ussdTarget.value;
                const code = ussdInput.value;
                
                if (!target || !code) return;
                
                btnLabel.textContent = words.sending;
                btnSpinner.classList.remove('hidden');
                ussdSubmitBtn.disabled = true;
                
                const placeholderEl = document.getElementById('terminal-placeholder');
                if (placeholderEl && placeholderEl.parentNode) {
                    placeholderEl.parentNode.removeChild(placeholderEl);
                }
                
                const cmdLine = document.createElement('div');
                cmdLine.className = 'text-zinc-500 mt-2 border-t border-zinc-900 pt-2';
                cmdLine.textContent = `[${new Date().toLocaleTimeString()}] > exec-ussd -d ${target} -c ${code}`;
                terminalScreen.appendChild(cmdLine);
                terminalScreen.scrollTop = terminalScreen.scrollHeight;

                fetch('/api/gsm-dongles/ussd', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongle: target, code: code })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        appendUssdResponse(data.logTime || new Date().toLocaleTimeString(), data.response, false);
                    } else {
                        const respLine = document.createElement('div');
                        respLine.className = 'text-rose-400 font-bold bg-rose-950/10 p-2 rounded border border-rose-900/20 mt-1';
                        respLine.textContent = `[System Error] ${data.error || words.sendUssdError}`;
                        terminalScreen.appendChild(respLine);
                        terminalScreen.scrollTop = terminalScreen.scrollHeight;
                    }
                })
                .catch(err => {
                    const errorLine = document.createElement('div');
                    errorLine.className = 'text-rose-500 font-bold mt-1';
                    errorLine.textContent = `[Network Error] ${err.message}`;
                    terminalScreen.appendChild(errorLine);
                    terminalScreen.scrollTop = terminalScreen.scrollHeight;
                })
                .finally(() => {
                    btnLabel.textContent = words.sendBtn;
                    btnSpinner.classList.add('hidden');
                    ussdSubmitBtn.disabled = false;
                });
            });

            // WebSocket live USSD responses capture
            if (socket) {
                socket.on('ussdResponse', (data) => {
                    if (ussdTarget.value.toLowerCase() === data.dongleId.toLowerCase()) {
                        appendUssdResponse(data.logTime, data.text, true);
                    }
                });

                socket.on('dongleNumberUpdated', (data) => {
                    const btn = document.getElementById('resetBtn-' + data.dongleId);
                    if (btn) {
                        const span = btn.querySelector('span');
                        if (span) span.innerText = words.resetUsbBtn;
                        btn.disabled = false;
                    }
                    refreshDevicesList();
                });

                socket.on('dongleProvisionResult', (data) => {
                    if (data.results) {
                        let details = data.results.map(function(r) {
                            const status = r.error ? '❌' : '✅';
                            return status + ' ' + r.step + (r.error ? ': ' + r.error : '');
                        }).join('\n');
                        showToast(data.dongleId + ' AT Results', details, data.results.some(function(r) { return r.error; }) ? 'error' : 'success');
                    }
                    refreshDevicesList();
                });

                socket.on('usbDevicesUpdated', () => {
                    refreshUsbDevices();
                });
            }

            // Refresh Device List AJAX helper
            function refreshDevicesList() {
                if (devicesRefreshInFlight) return;
                devicesRefreshInFlight = true;

                fetch('/api/gsm-dongles')
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success || !Array.isArray(data.devices)) return;

                        loadedDevices = data.devices;
                        window.loadedDevices = loadedDevices;
                        const currentSelected = selectedDongleId || (ussdTarget ? ussdTarget.value : '');
                        const nextSelected = loadedDevices.some(device => String(device.ID || '') === String(currentSelected || ''))
                            ? String(currentSelected)
                            : (loadedDevices[0] ? String(loadedDevices[0].ID || '') : '');

                        if (ussdTarget) {
                            ussdTarget.innerHTML = '';
                            const placeholder = document.createElement('option');
                            placeholder.value = '';
                            placeholder.disabled = true;
                            placeholder.hidden = true;
                            placeholder.textContent = words.selectPlaceholder;
                            placeholder.selected = !nextSelected;
                            ussdTarget.appendChild(placeholder);

                            loadedDevices.forEach(device => {
                                const option = document.createElement('option');
                                option.value = String(device.ID || '');
                                option.textContent = `${device.ID || ''} (${device.Number || 'Unknown'})`;
                                option.selected = option.value === nextSelected;
                                ussdTarget.appendChild(option);
                            });
                        }

                        renderDongleCards();
                        if (nextSelected) {
                            selectDevice(nextSelected);
                        } else {
                            selectedDongleId = null;
                            updateSmsInboxTitle();
                            showEmptySmsInbox();
                        }
                    })
                    .catch(error => console.error('Error refreshing devices:', error))
                    .finally(() => {
                        devicesRefreshInFlight = false;
                    });
            }

            window.resetServerUsbPorts = function(btn) {
                if (!confirm(isRtl ? 'هل أنت متأكد من إعادة تعيين كافة منافذ USB في السيرفر؟' : 'Are you sure you want to reset all USB ports on the server?')) return;
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة تعيين USB' : 'Resetting USB', isRtl ? 'جاري إعادة تعيين كافة منافذ USB في السيرفر...' : 'Resetting all USB ports on the server...', 'warning');

                fetch('/api/gsm-dongles/reset-usb-port', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongleId: 'all' })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? 'نجاح' : 'Success', isRtl ? 'تمت إعادة تعيين كافة منافذ USB بنجاح.' : 'All USB ports reset successfully.', 'success');
                        refreshDevicesList();
                    } else {
                        showToast(isRtl ? 'خطأ' : 'Error', data.error || 'USB reset failed', 'error');
                    }
                })
                .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                .finally(() => { if (btn) btn.disabled = false; });
            };

            if (globalResetUsbBtn) {
                globalResetUsbBtn.addEventListener('click', () => {
                    resetServerUsbPorts(globalResetUsbBtn);
                });
            }
            setInterval(refreshDevicesList, 1000);
        });
    </script>
</body>
</html>

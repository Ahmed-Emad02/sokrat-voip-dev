                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            </div>
                            <span class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= t.legendTitle %></span>
                        </div>
                        <button type="button" class="text-[10px] font-bold text-blue-400 hover:underline flex items-center gap-1">
                            <span id="legend-toggle-text"><%= isRtl ? 'عرض الدليل' : 'Show Guide' %></span>
                            <svg id="legend-toggle-icon" class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                    </div>

                    <div id="legend-content-block" class="mt-3 pt-3 border-t border-[var(--border-primary)] space-y-4 hidden">
                        <!-- 1. Action Buttons Guide -->
                        <div>
                            <span class="text-[10px] font-black uppercase tracking-wider text-[var(--text-secondary)] block mb-2"><%= isRtl ? 'أزرار الإجراءات والتحكم:' : 'Action & Control Buttons:' %></span>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-[var(--accent-color)] text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                                        <%= isRtl ? 'أعلى الصفحة' : 'Header' %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendTopHeaderDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                                        <%= t.btnRestartDongle %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendRestartDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                                        <%= t.btnRebootModem %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendRebootDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22v-5"/><path d="M9 8V2h6v6"/><path d="M6 13V8h12v5a6 6 0 0 1-12 0z"/></svg>
                                        <%= t.btnVirtualReplug %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendReplugDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                                        <%= t.btnPopulateHardware %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendPopulateDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 17l6-6-6-6"/><path d="M12 19h8"/><circle cx="7" cy="12" r="3"/><path d="M17 7l4 4-4 4"/></svg>
                                        <%= t.btnEditPorts %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendEditPortsDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>
                                        <%= t.btnCallForwarding %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendCallForwardingDesc %></p>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Dongle State Colors Guide -->
                        <div>
                            <span class="text-[10px] font-black uppercase tracking-wider text-[var(--text-secondary)] block mb-2"><%= isRtl ? 'ألوان حالات الشريحة:' : 'Dongle State Colors:' %></span>
                            <div class="flex flex-wrap items-center gap-2 text-[10px]">
                                <span class="px-2.5 py-1 rounded-lg bg-purple-600 text-white font-black border border-purple-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                    <%= isRtl ? 'جاهز (Free)' : 'Free / Ready' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-[#047857] text-white font-black border border-emerald-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    <%= isRtl ? 'مكالمة نشطة' : 'Active Call' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-pink-600 text-white font-black border border-pink-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    <%= isRtl ? 'رسالة SMS' : 'SMS' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-blue-600 text-white font-black border border-blue-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    <%= isRtl ? 'اتصال / رنين' : 'Dialing / Ringing' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-amber-600 text-white font-black border border-amber-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                    <%= isRtl ? 'جاري التهيئة' : 'Initializing' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-[#881337] text-white font-black border border-rose-700 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                    <%= isRtl ? 'غير متصل' : 'Disconnected' %>
                                </span>
                        </div>
                    </div>
                </div>
                <div id="dongles-grid" class="grid grid-cols-1 md:grid-cols-2 items-start gap-3 p-3 sm:p-4">
<div class="col-span-full py-8 text-center text-xs text-[var(--text-muted)]"><%= isRtl ? 'جاري تحميل أجهزة GSM...' : 'Loading GSM dongles...' %></div>
                </div>
            </div>
        </section>


            <!-- Middle Row: SMS Inbox & USSD Console Side-by-Side (2 Columns) -->
            <div class="inboxes-grid grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch mt-4">
                <!-- 1. SMS Inbox Panel -->
                <div class="gsm-console-panel sms-inbox-panel panel-surface rounded-2xl p-5 flex flex-col gap-4 h-[30rem]">
                    <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3 gap-3 shrink-0">
                        <div class="min-w-0">
                            <h3 class="text-sm font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                                <svg class="text-[var(--accent-color)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"/><path d="m22 6-10 7L2 6"/></svg>
                                <%= isRtl ? 'صندوق الرسائل' : 'SMS Inbox' %>
                            </h3>
                            <p id="sms-inbox-device" class="text-[10px] text-[var(--text-muted)] font-mono mt-0.5 truncate"><%= isRtl ? 'اختر جهازاً' : 'Select a dongle' %></p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <span id="sms-inbox-count" class="px-2 py-1 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[10px] font-mono font-bold text-[var(--text-secondary)]">0</span>
                            <button onclick="clearSmsInbox()" class="text-[10px] bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer">
                                <%= isRtl ? 'مسح' : 'Clear' %>
                            </button>
                        </div>
                    </div>

                    <div class="sms-inbox-scroll overflow-y-auto flex-1 flex flex-col gap-2.5 pe-1" id="sms-inbox-container">
                        <div class="text-center py-8 text-[var(--text-muted)] italic" id="sms-empty-placeholder"><%= isRtl ? 'لا يوجد رسائل واردة حالياً' : 'No incoming SMS messages' %></div>
                    </div>
                </div>

                <!-- 2. USSD Console Panel & Terminal Response -->
                <div class="gsm-console-panel panel-surface rounded-2xl p-5 flex flex-col gap-4 h-[30rem]">
                    <!-- USSD Exec Section -->
                    <div class="flex flex-col gap-3 pb-3 border-b border-[var(--border-primary)] shrink-0">
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <h3 class="text-sm font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                                <div id="console-tab-icon" class="w-7 h-7 rounded-lg bg-indigo-500/15 border border-indigo-500/30 flex items-center justify-center text-indigo-400">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="4 17 10 11 4 5"></polyline>
                                        <line x1="12" y1="19" x2="20" y2="19"></line>
                                    </svg>
                                </div>
                                <span id="console-tab-title"><%= t.ussdTitle %></span>
                            </h3>
                            <div class="flex items-center gap-1 p-0.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)]">
                                <button type="button" id="tab-btn-ussd" onclick="switchConsoleTab('ussd')" class="px-3 py-1.5 rounded-lg text-xs font-black transition-all cursor-pointer bg-indigo-600 text-white border border-indigo-400 shadow-md flex items-center gap-1.5">
                                    <span class="font-mono font-black">&gt;_</span>
                                    <span><%= t.cfTabUssd || 'USSD >_' %></span>
                                </button>
                                <button type="button" id="tab-btn-forwarding" onclick="switchConsoleTab('forwarding')" class="px-3 py-1.5 rounded-lg text-xs font-extrabold transition-all cursor-pointer text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] border border-transparent flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>
                                    <span><%= t.cfTabForwarding || (isRtl ? 'تحويل المكالمات' : 'Call Forwarding') %></span>
                                </button>
                            </div>
                        </div>

                        <form id="ussd-execution-form" class="flex flex-col sm:flex-row items-end gap-2.5">
                            <div class="flex-1 w-full sm:w-auto">
                                <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="ussd-target-dongle">
                                    <%= isRtl ? 'الشريحة المستهدفة *' : 'Target Dongle *' %>
                                </label>
                                <select id="ussd-target-dongle" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required>
                                    <option value="" disabled <%= initialSelectedDongleId ? '' : 'selected' %> hidden><%= t.selectPlaceholder %></option>
                                    <% if (devices && devices.length > 0) { %>
                                        <% devices.forEach(d => { %>
                                            <option value="<%= d.ID %>" <%= d.ID === initialSelectedDongleId ? 'selected' : '' %>><%= d.ID %> (<%= d.Number || 'Unknown SIM' %>)</option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            
                            <div class="flex-1 w-full sm:w-auto">
                                <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="ussd-code-input">
                                    <%= isRtl ? 'رمز الـ USSD *' : 'USSD Code *' %>
                                </label>
                                <div class="flex items-center bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-2.5 focus-within:border-indigo-500 transition-colors">
                                    <span class="text-indigo-400 font-bold font-mono text-xs leading-none select-none me-1.5">&gt;_</span>
                                    <input type="text" id="ussd-code-input" class="w-full bg-transparent border-0 outline-none py-1.5 text-xs text-[var(--text-primary)] font-mono placeholder-zinc-500" placeholder="e.g. *100# or *50#" required autocomplete="off">
                                </div>
                            </div>

                            <button type="submit" id="ussd-submit-btn" class="config-btn-primary px-4 py-2 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shrink-0 w-full sm:w-auto">
                                <span id="btn-label"><%= t.sendBtn %></span>
                                <div id="btn-spinner" class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin hidden"></div>
                            </button>
                        </form>

                        <!-- Call Forwarding Helper Form -->
                        <form id="forwarding-execution-form" class="hidden flex flex-col gap-2.5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2.5 items-end">
                                <div>
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-target-dongle">
                                        <%= isRtl ? 'الشريحة المستهدفة *' : 'Target Dongle *' %>
                                    </label>
                                    <select id="cf-target-dongle" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required>
                                        <option value="" disabled <%= initialSelectedDongleId ? '' : 'selected' %> hidden><%= t.selectPlaceholder %></option>
                                        <% if (devices && devices.length > 0) { %>
                                            <% devices.forEach(d => { %>
                                                <option value="<%= d.ID %>" <%= d.ID === initialSelectedDongleId ? 'selected' : '' %>><%= d.ID %> (<%= d.Number || 'Unknown SIM' %>)</option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>

                                <div>
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-scenario">
                                        <%= t.cfScenario %> *
                                    </label>
                                    <select id="cf-scenario" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required onchange="onCfScenarioChange()">
                                        <option value="21"><%= t.cfAlways %></option>
                                        <option value="67"><%= t.cfBusy %></option>
                                        <option value="61"><%= t.cfNoReply %></option>
                                        <option value="62"><%= t.cfNotReachable %></option>
                                        <option value="004"><%= t.cfAllConditional %></option>
                                        <option value="002"><%= t.cfAllForwarding %></option>
                                    </select>
                                </div>

                                <div>
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-action">
                                        <%= t.cfAction %> *
                                    </label>
                                    <select id="cf-action" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required onchange="onCfActionChange()">
                                        <option value="activate"><%= t.cfActionActivate %></option>
                                        <option value="query"><%= t.cfActionQuery %></option>
                                        <option value="cancel"><%= t.cfActionCancel %></option>
                                    </select>
                                </div>

                                <div id="cf-number-container">
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-number-input">
                                        <%= t.cfForwardToNumber %> *
                                    </label>
                                    <div class="flex items-center bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-2.5 focus-within:border-emerald-500 transition-colors">
                                        <svg class="w-3.5 h-3.5 text-emerald-400 me-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        <input type="tel" id="cf-number-input" class="w-full bg-transparent border-0 outline-none py-1.5 text-xs text-[var(--text-primary)] font-mono placeholder-zinc-500" placeholder="01011719380" required autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-3 pt-1 flex-wrap">
                                <div id="cf-delay-container" class="hidden items-center gap-2">
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase" for="cf-delay-select">
                                        <%= t.cfNoReplyDelay %>:
                                    </label>
                                    <select id="cf-delay-select" class="config-input py-1 text-xs font-mono">
                                        <option value="20">20 <%= t.cfDefaultSec %></option>
                                        <option value="5">5 <%= t.cfSeconds %></option>
                                        <option value="10">10 <%= t.cfSeconds %></option>
                                        <option value="15">15 <%= t.cfSeconds %></option>
                                        <option value="25">25 <%= t.cfSeconds %></option>
                                        <option value="30">30 <%= t.cfSeconds %></option>
                                    </select>
                                </div>

                                <div class="ms-auto flex items-center gap-2">
                                    <button type="submit" id="cf-submit-btn" class="config-btn-primary px-5 py-2 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer">
                                        <span id="cf-btn-label"><%= t.cfSendBtn %></span>
                                        <div id="cf-btn-spinner" class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin hidden"></div>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- USSD Terminal Display -->
                    <div class="flex flex-col flex-1 min-h-0 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl overflow-hidden">
                        <div class="px-3.5 py-2 border-b border-[var(--border-primary)] flex items-center justify-between shrink-0 bg-[var(--bg-secondary)]">
                            <div class="flex items-center gap-2">
                                <div class="flex items-center gap-1 me-1">
                                    <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80"></span>
                                    <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80"></span>
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80"></span>
                                </div>
                                <span class="text-xs font-extrabold text-[var(--text-primary)] uppercase tracking-wider font-mono"><%= t.terminalTitle %></span>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="copyUssdTerminal()" class="px-2.5 py-1 rounded-lg bg-[var(--bg-primary)] hover:bg-[var(--bg-hover)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-primary)] text-[10px] font-bold transition cursor-pointer flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                                    <span><%= isRtl ? 'نسخ' : 'Copy' %></span>
                                </button>
                                <button type="button" onclick="clearUssdTerminal()" class="px-2.5 py-1 rounded-lg bg-[var(--bg-primary)] hover:bg-rose-500/10 text-[var(--text-secondary)] hover:text-rose-400 border border-[var(--border-primary)] hover:border-rose-500/30 text-[10px] font-bold transition cursor-pointer flex items-center gap-1">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                    <span><%= isRtl ? 'مسح' : 'Clear' %></span>
                                </button>
                            </div>
                        </div>
                        
                        <div class="terminal-screen p-3.5 flex-1 overflow-y-auto text-xs text-emerald-400 font-mono flex flex-col gap-2 rounded-b-xl bg-[#080c09]" id="terminal-screen">
                            <div class="text-emerald-500/70 font-mono text-xs select-none p-3 rounded-lg border border-emerald-900/30 bg-emerald-950/20" id="terminal-placeholder">
                                <%= t.terminalPlaceholder %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lower Row: Selected Device Details (Short, Wide & Dense Horizontal Card directly under SMS & USSD) -->
            <div id="device-details-panel" class="panel-surface rounded-2xl p-5 flex flex-col gap-4 mt-4 w-full">
                <!-- Header with ID & Live Diagnostics Badges -->
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b border-[var(--border-primary)] pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl bg-[var(--accent-color)]/10 border border-[var(--accent-color)]/20 flex items-center justify-center text-[var(--accent-color)] font-bold shrink-0">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <path d="M9 3v18M13 8h4M13 12h4M13 16h2"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-extrabold text-[var(--text-primary)] uppercase tracking-wider flex items-center gap-2 flex-wrap">
                                <span><%= isRtl ? 'تفاصيل ومواصفات الجهاز' : 'Selected Device Specifications' %></span>
                                <span id="info-id" class="px-2.5 py-0.5 rounded-lg bg-red-500/10 text-[var(--accent-color)] border border-red-500/20 font-mono text-xs font-black">-</span>
                            </h4>
                            <p class="text-[10px] text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'بيانات الهوية والعتاد والتشخيص المباشر للمودم المحدد' : 'Hardware identification, firmware specs, and live diagnostics' %></p>
                        </div>
                    </div>

                    <!-- Live Signal & Service Status Strip -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)]">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase"><%= isRtl ? 'الإشارة' : 'Signal' %>:</span>
                            <div class="flex items-end gap-0.5 h-[14px] shrink-0" id="diag-signal-bars"></div>
                            <span id="diag-signal-text" class="text-xs font-bold text-[var(--text-primary)] font-mono whitespace-nowrap">-</span>
                        </div>

                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)]">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase"><%= isRtl ? 'الخدمة' : 'Service' %>:</span>
                            <div id="diag-service-badge"></div>
                            <span id="diag-carrier-text" class="text-xs font-bold text-[var(--accent-color)]">-</span>
                        </div>

                        <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[10px]">
                            <div><span class="text-[9px] font-bold text-[var(--text-muted)] uppercase me-1"><%= isRtl ? 'صوت' : 'Voice' %>:</span><span id="chk-voice" class="text-zinc-500 font-bold font-mono">-</span></div>
                            <div class="border-s border-[var(--border-primary)] ps-2.5"><span class="text-[9px] font-bold text-[var(--text-muted)] uppercase me-1"><%= isRtl ? 'رسائل' : 'SMS' %>:</span><span id="chk-sms" class="text-zinc-500 font-bold font-mono">-</span></div>
                            <div class="border-s border-[var(--border-primary)] ps-2.5"><span class="text-[9px] font-bold text-[var(--text-muted)] uppercase me-1">USSD:</span><span id="chk-ussd" class="text-zinc-500 font-bold font-mono">-</span></div>
                        </div>
                    </div>
                </div>

                <!-- Dense Horizontal Multi-Column Grid (8 Columns on Desktop) -->
                <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5">
                    <div class="gsm-detail-field">
                        <span class="gsm-detail-label"><%= t.thNumber %></span>
                        <div class="flex items-center gap-1 min-w-0">
                            <span id="info-number" class="gsm-detail-value font-mono flex-1 text-xs sm:text-sm font-black truncate">-</span>
                            <button onclick="copyToClipboard(document.getElementById('info-number').textContent, this)" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded transition cursor-pointer shrink-0" title="<%= isRtl ? 'نسخ' : 'Copy' %>">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                            </button>
                            <button onclick="editSimNumber(document.getElementById('info-id').textContent, document.getElementById('info-imsi').textContent, document.getElementById('info-number').textContent === 'Unknown' || document.getElementById('info-number').textContent === '-' ? '' : document.getElementById('info-number').textContent)" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded transition cursor-pointer shrink-0" title="<%= isRtl ? 'تعديل' : 'Edit' %>">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4z"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.thProvider %></span><span id="info-provider" class="gsm-detail-value text-[var(--accent-color)] text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.thIMEI %></span><span id="info-imei" class="gsm-detail-value font-mono text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.thIMSI %></span><span id="info-imsi" class="gsm-detail-value font-mono text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.model %></span><span id="info-model" class="gsm-detail-value text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.firmware %></span><span id="info-firmware" class="gsm-detail-value font-mono text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.group %></span><span id="info-group" class="gsm-detail-value text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.mode %> / <%= t.submode %></span><span class="gsm-detail-value text-xs sm:text-sm font-black truncate"><span id="info-mode">-</span> / <span id="info-submode">-</span></span></div>
                </div>
            </div>

        <!-- USB Hardware (lsusb) & Serial Endpoints (/dev/ttyUSB*) Dual Monitor -->
        <section class="panel-surface rounded-2xl p-5 sm:p-6 flex flex-col gap-5 shrink-0">
            <!-- Header with Live Metric Badges -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[var(--border-primary)]">
                <div>
                    <h3 class="text-sm font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                        <svg class="w-4 h-4 text-[var(--accent-color)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
                        <%= t.usbHardwareMonitor %>
                    </h3>
                    <p class="text-[11px] text-[var(--text-muted)] mt-1"><%= t.usbHardwareDesc %></p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span id="lsusb-modems-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold font-mono bg-purple-500/15 text-purple-300 border border-purple-500/30 flex items-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                        <span id="lsusb-modems-count">0 <%= t.lsusbModemsBadge %></span>
                    </span>
                    <span id="lsusb-tty-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span id="lsusb-tty-count">0 <%= t.lsusbTtyBadge %></span>
                    </span>
                    <button type="button" onclick="refreshUsbDevices()" class="p-1.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer" title="<%= isRtl ? 'إعادة فحص USB' : 'Refresh USB Devices' %>">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </button>
                </div>
            </div>

            <!-- Tier 1: Physical USB Hardware Devices (lsusb) -->
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-secondary)] flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        <%= t.lsusbPhysicalDevices %>
                    </h4>
                    <span class="text-[10px] text-[var(--text-muted)] font-mono">Bus / Dev ID</span>
                </div>
                <div id="lsusb-devices-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    <div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading physical hardware...</div>
                </div>
            </div>

            <!-- Tier 2: OS Serial Character Endpoints (/dev/ttyUSB*) -->
            <div class="space-y-2 pt-2 border-t border-[var(--border-primary)]/60">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-secondary)] flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                        <%= t.lsusbSerialEndpoints %>
                    </h4>
                    <span class="text-[10px] text-[var(--text-muted)] font-mono"><%= isRtl ? 'الصوت / البيانات' : 'Audio / Data Channels' %></span>
                </div>
                <div id="usb-devices-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                    <div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading serial endpoints...</div>
                </div>
            </div>
        </section>

        <!-- Collapsible logs console (Bottom) -->
        <div class="panel-surface rounded-2xl flex flex-col shrink-0">
            <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-black/40 border-b border-[var(--border-primary)] rounded-t-2xl <%= isRtl ? 'sm:flex-row-reverse' : '' %>">
                <h3 class="text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider flex items-center gap-2">
                    <div class="relative flex items-center justify-center">
                        <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-[var(--accent-color)] opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--accent-color)]"></span>
                    </div>
                    <%= t.logTitle %>
                </h3>
                
                <div class="w-full sm:w-auto flex flex-wrap items-center gap-3 sm:gap-4 text-xs font-semibold select-none <%= isRtl ? 'flex-row-reverse' : '' %>">
                    <div class="flex items-center gap-2">
                        <span><%= t.logToggle %></span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="logs-toggle-switch" class="sr-only peer">
                            <div class="w-8 h-4 bg-zinc-800 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-[var(--accent-color)]"></div>
                        </label>
                    </div>
                    
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="logs-autoscroll-chk" checked class="accent-[var(--accent-color)] rounded font-bold">
                        <span><%= t.autoscroll %></span>

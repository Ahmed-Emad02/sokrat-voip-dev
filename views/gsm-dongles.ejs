                    card.dataset.number = phoneNumber === 'Unknown' ? '' : phoneNumber;
                    card.dataset.imsi = imsi;
                    card.dataset.imei = imei;
                    card.dataset.audio = String(dev.audio || '');
                    card.dataset.data = String(dev.data || '');

                    if (currentViewMode === 'minimal') {
                        card.className = `dongle-device-card dongle-state-${state.color} rounded-xl cursor-pointer p-3 sm:px-4 py-2.5 flex items-center justify-between gap-3 text-xs flex-wrap md:flex-nowrap transition-all`;

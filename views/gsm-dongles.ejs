                                <div class="w-7 h-7 rounded-lg dongle-icon-box flex items-center justify-center shrink-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 18h6M9 6h.01M12 6h.01M15 6h.01"/></svg>
                                </div>
                                <div class="min-w-0">
                                    <h4 class="text-sm font-black text-[var(--text-primary)] font-mono truncate tracking-tight">${escapeHtml(id)}</h4>
                                </div>
                            </div>

                            <div class="flex items-center justify-center gap-1.5 min-w-0 md:flex-1 text-center">
                                <span class="text-[10px] font-extrabold text-[var(--text-muted)] uppercase tracking-wider">IMEI:</span>
                                <span class="font-mono text-xs text-[var(--text-primary)] font-semibold truncate max-w-[140px]" title="${escapeHtml(imei)}">${escapeHtml(imei)}</span>
                                ${imei !== '-' && imei !== 'Unknown' ? `<button type="button" data-dongle-action="copy-imei" class="p-0.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'نسخ IMEI' : 'Copy IMEI'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                            </div>

                            <div class="flex items-center justify-center gap-1.5 min-w-0 md:flex-1 text-center">
                                <span class="text-[10px] font-extrabold text-[var(--text-muted)] uppercase tracking-wider">${isRtl ? 'الشريحة:' : 'SIM:'}</span>
                                <span id="display-num-${escapeHtml(id)}" class="font-mono text-xs text-[var(--text-primary)] font-bold truncate max-w-[130px]">${escapeHtml(phoneNumber)}</span>
                                ${phoneNumber !== 'Unknown' ? `<button type="button" data-dongle-action="copy-number" class="p-0.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'نسخ الرقم' : 'Copy number'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                            </div>

                            <div class="flex items-center justify-center md:flex-1 text-center">
                                <span class="dongle-status-pill inline-flex items-center justify-center gap-1.5 rounded-lg px-2.5 py-1 text-[10px] font-black uppercase tracking-wider">
                                    <span class="dongle-status-dot h-1.5 w-1.5 rounded-full ${state.badge.dot}${state.animate ? ' animate-pulse' : ''} shrink-0"></span>
                                    ${escapeHtml(state.label)}
                                </span>
                            </div>

                            <div class="flex items-center justify-center gap-2 md:flex-1 text-center">
                                <span class="font-mono text-xs font-bold" style="color:${signal.activeColor}">${signal.percent}%</span>
                                <div class="flex items-end gap-0.5 h-[16px]">${signal.barsHtml}</div>
                            </div>

                            <div class="flex items-center justify-center gap-1.5 md:flex-1 text-center">
                                <button type="button" id="forwardBtn-${escapeHtml(id)}" data-dongle-action="call-forwarding" class="dongle-action-button dongle-action-secondary cursor-pointer px-2 py-1.5 h-8 rounded-lg text-xs font-bold flex items-center gap-1" title="${escapeHtml(words.btnCallForwarding || (isRtl ? 'تحويل المكالمات' : 'Call Forwarding'))}">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>
                                    <span>${escapeHtml(words.btnCallForwarding || (isRtl ? 'تحويل' : 'Forward'))}</span>
                                </button>
                                <button type="button" id="reloadBtn-${escapeHtml(id)}" data-dongle-action="reload" class="dongle-action-button dongle-action-primary cursor-pointer px-2.5 py-1.5 h-8 rounded-lg text-xs font-bold flex items-center gap-1.5" title="${escapeHtml(words.refreshBtn)}">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                                    <span>${escapeHtml(words.refreshBtn)}</span>
                                </button>
                            </div>`;
                    } else {
                        card.className = `dongle-device-card dongle-state-${state.color} rounded-2xl cursor-pointer flex flex-col`;
                        if (id === selectedDongleId) card.classList.add('selected-row');

                        card.innerHTML = `
                            <div class="p-3 sm:p-4 flex-1">
                                <div class="flex items-start justify-between gap-2.5 mb-3">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="w-9 h-9 rounded-xl dongle-icon-box flex items-center justify-center shrink-0">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 18h6M9 6h.01M12 6h.01M15 6h.01"/></svg>
                                        </div>
                                        <div class="min-w-0">
                                            <h4 class="text-base sm:text-lg font-black text-[var(--text-primary)] font-mono truncate tracking-tight">${escapeHtml(id)}</h4>
                                            <p class="text-[10px] text-[var(--text-muted)] truncate">${escapeHtml(provider)}</p>
                                        </div>
                                    </div>
                                    <span class="px-2 py-1 rounded-lg bg-[var(--bg-primary)]/50 border border-[var(--border-primary)] text-[9px] font-bold text-[var(--text-muted)] shrink-0">${isRtl ? 'المجموعة' : 'Group'} ${escapeHtml(dev.Group || '0')}</span>
                                </div>

                                <div class="dongle-priority-grid grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <div class="dongle-priority-metric">
                                        <span class="dongle-metric-label">IMEI · ${isRtl ? 'هوية الجهاز' : 'Device Identity'}</span>
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class="dongle-priority-value font-mono flex-1">${escapeHtml(imei)}</span>
                                            ${imei !== '-' && imei !== 'Unknown' ? `<button type="button" data-dongle-action="copy-imei" class="w-6 h-6 rounded-md bg-[var(--bg-primary)]/40 border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] flex items-center justify-center cursor-pointer shrink-0" title="${isRtl ? 'نسخ IMEI' : 'Copy IMEI'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                                        </div>
                                    </div>
                                    <div class="dongle-priority-metric">
                                        <span class="dongle-metric-label">${isRtl ? 'الحالة الحالية' : 'Current State'}</span>
                                        <span class="dongle-status-pill w-full inline-flex items-center justify-center gap-2 rounded-lg px-3 py-1.5 text-xs font-black border uppercase tracking-wider">
                                            <span class="dongle-status-dot h-2 w-2 rounded-full ${state.badge.dot}${state.animate ? ' animate-pulse' : ''} shrink-0"></span>
                                            ${escapeHtml(state.label)}
                                        </span>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-2">
                                    <div class="dongle-metric">
                                        <span class="dongle-metric-label">${isRtl ? 'رقم الشريحة' : 'DID / SIM'}</span>
                                        <div class="flex items-center gap-1 min-w-0">
                                            <span id="display-num-${escapeHtml(id)}" class="dongle-metric-value font-mono flex-1 truncate">${escapeHtml(phoneNumber)}</span>
                                            ${phoneNumber !== 'Unknown' ? `<button type="button" data-dongle-action="copy-number" class="p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'نسخ الرقم' : 'Copy number'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                                            <button type="button" data-dongle-action="edit-number" class="p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'تعديل الرقم' : 'Edit number'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4z"/></svg></button>
                                        </div>
                                    </div>
                                    <div class="dongle-metric">
                                        <span class="dongle-metric-label">${isRtl ? 'الإشارة' : 'Signal'}</span>
                                        <div class="flex items-end justify-between gap-2">
                                            <span class="dongle-metric-value font-mono" style="color:${signal.activeColor}">${signal.percent}%</span>
                                            <div class="flex items-end gap-0.5 h-[24px]">${signal.barsHtml}</div>
                                        </div>
                                    </div>
                                    <div class="dongle-metric col-span-2">
                                        <span class="dongle-metric-label">IMSI · ${isRtl ? 'هوية الشريحة' : 'SIM Identity'}</span>
                                        <span class="dongle-metric-value font-mono truncate" title="${escapeHtml(imsi)}">${escapeHtml(imsi)}</span>
                                    </div>
                                    <div class="dongle-hardware-summary col-span-2 flex items-center justify-between gap-2 min-w-0">
                                        <span class="font-black uppercase tracking-wider shrink-0">${isRtl ? 'الجهاز' : 'Hardware'}</span>
                                        <span class="font-mono truncate text-end" title="${escapeHtml(`${model} · ${mode} · ${firmware}`)}">${escapeHtml(model)} · ${escapeHtml(mode)} · ${escapeHtml(firmware)}</span>
                                    </div>
                                </div>

                                ${renderDongleRouting(dev)}
                            </div>
                            <div class="dongle-card-footer px-3 sm:px-4 py-2.5 flex items-center justify-between gap-2">
                                <span class="text-[10px] font-extrabold text-[var(--text-muted)] flex items-center gap-1.5 shrink-0">
                                    <span style="color:${signal.activeColor}">●</span> ${escapeHtml(signal.level)} · ${signal.rssi}/31
                                </span>
                                <div class="flex items-center gap-1.5 shrink-0">
                                    <button type="button" id="forwardBtn-${escapeHtml(id)}" data-dongle-action="call-forwarding" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnCallForwarding || (isRtl ? 'تحويل المكالمات' : 'Call Forwarding'))}">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>
                                    </button>
                                    <button type="button" id="editPortsBtn-${escapeHtml(id)}" data-dongle-action="edit-ports" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnEditPorts)}">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 17l6-6-6-6"/><path d="M12 19h8"/><circle cx="7" cy="12" r="3"/><path d="M17 7l4 4-4 4"/></svg>
                                    </button>

                                    <button type="button" id="populateBtn-${escapeHtml(id)}" data-dongle-action="populate-hardware" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center ${hasValidHardware ? '' : 'opacity-40 cursor-not-allowed'}" title="${escapeHtml(words.btnPopulateHardware)}" ${hasValidHardware ? '' : 'disabled'}>
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                                    </button>

                                    <button type="button" id="reloadBtn-${escapeHtml(id)}" data-dongle-action="reload" class="dongle-action-button dongle-action-primary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnRestartDongle)}">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                                    </button>

                                    <button type="button" id="rebootBtn-${escapeHtml(id)}" data-dongle-action="reboot-modem" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnRebootModem)}">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                                    </button>

                                    <button type="button" id="virtualReplugBtn-${escapeHtml(id)}" data-dongle-action="virtual-replug" class="dongle-action-button dongle-action-secondary cursor-pointer w-8 h-8 p-0 rounded-lg flex items-center justify-center" title="${escapeHtml(words.btnVirtualReplug)}">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 22v-5"/><path d="M9 8V2h6v6"/><path d="M6 13V8h12v5a6 6 0 0 1-12 0z"/></svg>
                                    </button>
                                </div>
                            </div>`;
                    }
                    donglesGrid.appendChild(card);
                });
            }

            if (donglesGrid) {
                donglesGrid.addEventListener('click', event => {
                    const card = event.target.closest('.dongle-device-card');
                    if (!card || !donglesGrid.contains(card)) return;

                    const id = card.dataset.dongleId;
                    const actionButton = event.target.closest('[data-dongle-action]');
                    if (!actionButton) {
                        selectDevice(id);
                        return;
                    }

                    const action = actionButton.dataset.dongleAction;
                    if (action === 'copy-imei') copyToClipboard(card.dataset.imei, actionButton);
                    if (action === 'copy-number') copyToClipboard(card.dataset.number, actionButton);
                    if (action === 'edit-number') editSimNumber(id, card.dataset.imsi, card.dataset.number);
                    if (action === 'reload') reloadDongle(id);
                    if (action === 'reboot-modem') rebootModem(id);
                    if (action === 'edit-ports') openEditPortsModal(id, card.dataset.audio, card.dataset.data);
                    if (action === 'virtual-replug') virtualReplug(id);
                    if (action === 'reset-usb') resetUsbPort(id);
                    if (action === 'populate-hardware') populateDongleHardware(id, card.dataset.imei, card.dataset.imsi);
                    if (action === 'call-forwarding') openDongleCallForwarding(id);
                });
            }

            function appendUssdResponse(logTime, text, isLive) {
                const now = Date.now();
                const normalizedText = String(text || '').trim();
                
                // Deduplicate identical responses printed within 3 seconds
                if (normalizedText === lastUssdText && (now - lastUssdTime) < 3000) {
                    return;
                }
                
                lastUssdText = normalizedText;
                lastUssdTime = now;
                
                const respLine = document.createElement('div');
                respLine.className = 'text-emerald-400 font-bold bg-emerald-950/10 p-2 rounded border border-emerald-900/20 mt-1 whitespace-pre-wrap leading-relaxed select-text';
                
                const displayLabel = isLive ? ' (Live Event)' : '';
                const displayText = normalizedText || '(Empty Response / Terminated by Network)';
                respLine.innerHTML = `<span class="text-zinc-500 font-normal">[${logTime}]${displayLabel}</span> ${displayText}`;
                
                terminalScreen.appendChild(respLine);
                terminalScreen.scrollTop = terminalScreen.scrollHeight;
            }

            // Select Row behavior to display details
            window.selectDevice = function(id) {
                try {
                    const normalizedId = String(id || '');
                    const dev = loadedDevices.find(device => String(device.ID || '') === normalizedId);
                    if (!dev) return;

                    document.querySelectorAll('.dongle-device-card').forEach(card => {
                        card.classList.remove('selected-row');
                    });
                    const selectedRow = document.getElementById('row-' + normalizedId);
                    if (selectedRow) selectedRow.classList.add('selected-row');
                    
                    // Fill metadata cards
                    elId.textContent = dev.ID || '-';
                    elNum.textContent = dev.Number || 'Unknown';
                    elProv.textContent = dev['Provider Name'] || 'NONE';
                    elImei.textContent = dev.IMEI || '-';
                    elImsi.textContent = dev.IMSI || '-';
                    elGroup.textContent = dev.Group || '0';
                    elModel.textContent = dev.Model || '-';
                    elFirm.textContent = dev.Firmware || '-';
                    elMode.textContent = dev.Mode || '-';
                    elSub.textContent = dev.Submode || '-';

                    selectedDongleId = normalizedId;
                    updateSmsInboxTitle();
                    filterAndRenderSms();

                    // Update Live Status & Diagnostics Block
                    updateLiveDiagnostics(dev);

                    // Sync select dropdowns
                    if (ussdTarget) {
                        ussdTarget.value = id;
                    }
                    const cfTarget = document.getElementById('cf-target-dongle');
                    if (cfTarget) {
                        cfTarget.value = id;
                    }
                } catch (err) {
                    console.error("Error inside selectDevice:", err);
                }
            };

            function updateLiveDiagnostics(dev) {
                try {
                    const signal = getDongleSignalView(dev);
                    const state = getDongleStateView(dev);
                    const barsContainer = document.getElementById('diag-signal-bars');
                    const signalText = document.getElementById('diag-signal-text');
                    const badgeContainer = document.getElementById('diag-service-badge');
                    const carrierEl = document.getElementById('diag-carrier-text');

                    if (barsContainer) barsContainer.innerHTML = signal.barsHtml;
                    if (signalText) signalText.textContent = `${signal.rssi}/31 · ${signal.percent}% · ${signal.level}`;
                    if (carrierEl) carrierEl.textContent = dev['Provider Name'] || (isRtl ? 'غير معروف' : 'Unknown');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = `
                            <span class="inline-flex items-center gap-1.5 ${state.badge.bg} ${state.badge.text} rounded-full px-2.5 py-1 text-[10px] font-semibold border ${state.badge.border}">
                                <span class="h-1.5 w-1.5 rounded-full ${state.badge.dot}${state.animate ? ' animate-pulse' : ''} shrink-0"></span>
                                ${escapeHtml(state.label)}
                            </span>`;
                    }

                    const checklist = [
                        document.getElementById('chk-voice'),
                        document.getElementById('chk-sms'),
                        document.getElementById('chk-ussd')
                    ];
                    let checklistClass = 'text-zinc-500 font-bold font-mono';
                    let checklistLabel = '● OFF';
                    if (state.isReady) {
                        checklistClass = 'text-emerald-500 font-bold font-mono';
                        checklistLabel = '● OK';
                    } else if (state.color === 'yellow') {
                        checklistClass = 'text-red-500 font-bold font-mono';
                        checklistLabel = '● FAIL';
                    } else if (state.color !== 'red') {
                        checklistClass = 'text-amber-500 font-bold font-mono';
                        checklistLabel = '● WAIT';
                    }
                    checklist.forEach(element => {
                        if (!element) return;
                        element.className = checklistClass;
                        element.textContent = checklistLabel;
                    });
                } catch (error) {
                    console.error('Error updating live diagnostics:', error);
                }
            }

            renderDongleCards();
            if (loadedDevices.length > 0) {
                selectDevice(loadedDevices[0].ID);
            }

            // Sync detail card and table highlight when select dropdown is changed
            if (ussdTarget) {
                ussdTarget.addEventListener('change', (e) => {
                    selectDevice(e.target.value);
                });
            }
            const cfTargetEl = document.getElementById('cf-target-dongle');
            if (cfTargetEl) {
                cfTargetEl.addEventListener('change', (e) => {
                    selectDevice(e.target.value);
                });
            }

            // --- SMS INBOX MANAGEMENT ---
            function getSmsContainer() {
                return document.getElementById('sms-inbox-container');
            }

            function updateSmsInboxTitle() {
                const deviceEl = document.getElementById('sms-inbox-device');
                if (!deviceEl) return;
                deviceEl.textContent = selectedDongleId
                    ? `${isRtl ? 'الجهاز المحدد' : 'Selected'}: ${selectedDongleId}`
                    : (isRtl ? 'اختر جهازاً' : 'Select a dongle');
            }

            function updateSmsInboxCount(count) {
                const countEl = document.getElementById('sms-inbox-count');
                if (countEl) countEl.textContent = String(count);
            }

            // Toast Notification system
            const toastContainer = document.getElementById('toast-container');
            
            function showSmsToast(sms) {
                if (!toastContainer) return;
                
                const toast = document.createElement('div');
                // Premium glassmorphism dynamic style
                toast.className = 'bg-[var(--bg-secondary)]/90 border border-[var(--border-primary)] p-4 rounded-xl flex flex-col gap-1.5 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto cursor-pointer max-w-xs';
                
                toast.innerHTML = `
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-[var(--accent-color)] font-bold uppercase tracking-wider font-mono">${isRtl ? 'رسالة جديدة' : 'New SMS'}</span>
                        <span class="text-[var(--text-muted)] font-mono text-[10px]">${sms.dongleId}</span>
                    </div>
                    <div class="text-xs font-bold text-[var(--text-primary)]">${sms.sender}</div>
                    <p class="text-xs text-[var(--text-secondary)] truncate">${sms.content}</p>
                `;
                
                toast.onclick = function() {
                    if (selectedDongleId && selectedDongleId.toLowerCase() !== sms.dongleId.toLowerCase()) {
                        selectDevice(sms.dongleId);
                    }
                    showSmsModal(sms.dongleId, sms.sender, sms.content, sms.timestamp);
                    toast.remove();
                };
                
                toastContainer.appendChild(toast);
                
                // Animate entrance
                setTimeout(() => {
                    toast.classList.remove('translate-y-5', 'opacity-0');
                }, 10);
                
                // Auto dismiss after 6 seconds
                setTimeout(() => {
                    toast.classList.add('translate-y-5', 'opacity-0');
                    setTimeout(() => { toast.remove(); }, 300);
                }, 6000);
            }

            function showToast(title, message, type) {
                if (!toastContainer) return;
                const toast = document.createElement('div');
                const borderColor = type === 'error' ? 'border-red-900' : type === 'warning' ? 'border-amber-500/50' : type === 'success' ? 'border-emerald-900' : 'border-[var(--border-primary)]';
                const titleColor = type === 'error' ? 'text-red-400' : type === 'warning' ? 'text-amber-400' : type === 'success' ? 'text-emerald-400' : 'text-[var(--text-primary)]';
                toast.className = 'bg-[var(--bg-secondary)]/90 border ' + borderColor + ' p-4 rounded-xl flex flex-col gap-1.5 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto max-w-xs';
                toast.innerHTML = '\
                    <div class="flex items-center justify-between text-xs">\
                        <span class="' + titleColor + ' font-bold uppercase tracking-wider">' + title + '</span>\
                    </div>\
                    <p class="text-xs text-[var(--text-secondary)] whitespace-pre-wrap">' + message + '</p>\
                ';
                toast.onclick = function() { toast.remove(); };
                toastContainer.appendChild(toast);
                setTimeout(function() { toast.classList.remove('translate-y-5', 'opacity-0'); }, 10);
                setTimeout(function() {
                    toast.classList.add('translate-y-5', 'opacity-0');
                    setTimeout(function() { toast.remove(); }, 300);
                }, 8000);
            }

            // Modal DOM elements & controllers
            const smsModal = document.getElementById('sms-modal');
            const smsModalCard = document.getElementById('sms-modal-card');
            const smsModalDongle = document.getElementById('sms-modal-dongle');
            const smsModalSender = document.getElementById('sms-modal-sender');
            const smsModalCopySender = document.getElementById('sms-modal-copy-sender');
            const smsModalTime = document.getElementById('sms-modal-time');
            const smsModalContent = document.getElementById('sms-modal-content');
            
            window.showSmsModal = function(dongleId, sender, content, timestamp) {
                smsModalDongle.textContent = dongleId;
                smsModalSender.textContent = sender;
                smsModalTime.textContent = new Date(timestamp).toLocaleString();
                smsModalContent.textContent = content;
                
                smsModalCopySender.onclick = function() {
                    copyToClipboard(sender, smsModalCopySender);
                };
                
                smsModal.classList.remove('opacity-0', 'pointer-events-none');
                smsModalCard.classList.remove('scale-95', 'opacity-0');
                smsModalCard.classList.add('scale-100', 'opacity-100');
            };
            
            window.closeSmsModal = function() {
                smsModal.classList.add('opacity-0', 'pointer-events-none');
                smsModalCard.classList.remove('scale-100', 'opacity-100');
                smsModalCard.classList.add('scale-95', 'opacity-0');
            };
            
            // Close on outer click
            smsModal.addEventListener('click', (e) => {
                if (e.target === smsModal) closeSmsModal();
            });
            
            // Close on ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !smsModal.classList.contains('opacity-0')) {
                    closeSmsModal();
                }
            });

            // Edit Ports Modal elements & controllers
            const editPortsModal = document.getElementById('edit-ports-modal');
            const editPortsModalCard = document.getElementById('edit-ports-modal-card');
            const editPortsDongleId = document.getElementById('edit-ports-dongle-id');
            const editPortsDongleBadge = document.getElementById('edit-ports-dongle-badge');
            const editPortsAudioInput = document.getElementById('edit-ports-audio');
            const editPortsDataInput = document.getElementById('edit-ports-data');
            const editPortsConflictWarning = document.getElementById('edit-ports-conflict-warning');
            const detectedPortsChips = document.getElementById('detected-ports-chips');
            const savePortsSubmitBtn = document.getElementById('save-ports-submit-btn');

            let detectedDevicesList = [];

            window.validatePortsForm = function() {
                const audio = editPortsAudioInput ? editPortsAudioInput.value.trim().toLowerCase() : '';
                const data = editPortsDataInput ? editPortsDataInput.value.trim().toLowerCase() : '';

                const hasConflict = Boolean(audio && data && audio === data);
                if (editPortsConflictWarning) {
                    if (hasConflict) editPortsConflictWarning.classList.remove('hidden');
                    else editPortsConflictWarning.classList.add('hidden');
                }
                if (savePortsSubmitBtn) {
                    savePortsSubmitBtn.disabled = hasConflict || !audio || !data;
                }
                renderDetectedPortsRows();
            };

            window.setPortSelection = function(portType, portName) {
                if (portType === 'audio' && editPortsAudioInput) {
                    editPortsAudioInput.value = portName;
                } else if (portType === 'data' && editPortsDataInput) {
                    editPortsDataInput.value = portName;
                }
                validatePortsForm();
            };

            function renderDetectedPortsRows() {
                if (!detectedPortsChips) return;
                if (!detectedDevicesList || detectedDevicesList.length === 0) {
                    detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'لا توجد منافذ USB تسلسلية مكتشفة' : 'No ttyUSB devices detected'}</span>`;
                    return;
                }

                const currentDongleId = editPortsDongleId ? editPortsDongleId.value.trim().toLowerCase() : '';
                const selectedAudio = editPortsAudioInput ? editPortsAudioInput.value.trim().toLowerCase() : '';
                const selectedData = editPortsDataInput ? editPortsDataInput.value.trim().toLowerCase() : '';

                let html = '';
                detectedDevicesList.forEach(dev => {
                    const portPath = '/dev/' + dev.name;
                    const portLower = portPath.toLowerCase();
                    const isAudio = selectedAudio === portLower;
                    const isData = selectedData === portLower;
                    const isMappedOther = dev.dongleId && dev.dongleId.toLowerCase() !== currentDongleId;

                    let statusBadge = '';
                    let cardBg = 'bg-[var(--bg-secondary)] border-[var(--border-primary)]';

                    if (isAudio) {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold font-mono shrink-0">● ${isRtl ? 'صوت (Audio)' : 'AUDIO PORT'}</span>`;
                        cardBg = 'bg-emerald-950/20 border-emerald-500/40';
                    } else if (isData) {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 text-[10px] font-bold font-mono shrink-0">● ${isRtl ? 'أوامر (Data)' : 'DATA PORT'}</span>`;
                        cardBg = 'bg-cyan-950/20 border-cyan-500/40';
                    } else if (isMappedOther) {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-zinc-700/30 text-[var(--text-muted)] border border-zinc-700/50 text-[10px] font-mono shrink-0">${isRtl ? 'مستخدم في ' : 'Used by '}${escapeHtml(dev.dongleId)}</span>`;
                    } else {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-[var(--bg-card)] text-[var(--text-muted)] border border-[var(--border-primary)] text-[10px] font-mono shrink-0">${isRtl ? 'متاح' : 'Available'}</span>`;
                    }

                    html += `
                        <div class="flex items-center justify-between gap-2 p-2 rounded-xl border ${cardBg} transition text-xs font-mono">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="font-bold text-[var(--text-primary)] truncate">${escapeHtml(portPath)}</span>
                                ${statusBadge}
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="setPortSelection('audio', '${escapeHtml(portPath)}')" class="px-2.5 py-1 rounded-lg text-[10px] font-bold font-sans cursor-pointer transition flex items-center gap-1 ${
                                    isAudio ? 'bg-emerald-500 text-white shadow-sm' : 'bg-[var(--bg-card)] hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                                }" title="${isRtl ? 'تعيين كمنفذ للصوت' : 'Assign as Audio Port'}">
                                    <span>${isRtl ? 'صوت' : 'Audio'}</span>
                                </button>
                                <button type="button" onclick="setPortSelection('data', '${escapeHtml(portPath)}')" class="px-2.5 py-1 rounded-lg text-[10px] font-bold font-sans cursor-pointer transition flex items-center gap-1 ${
                                    isData ? 'bg-cyan-500 text-white shadow-sm' : 'bg-[var(--bg-card)] hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30'
                                }" title="${isRtl ? 'تعيين كمنفذ للأوامر' : 'Assign as Data Port'}">
                                    <span>${isRtl ? 'أوامر' : 'Data'}</span>
                                </button>
                            </div>
                        </div>`;
                });
                detectedPortsChips.innerHTML = html;
            }

            window.loadDetectedPortsList = function() {
                if (!detectedPortsChips) return;
                const dongleId = editPortsDongleId ? editPortsDongleId.value.trim() : '';
                detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'جاري فحص المنافذ...' : 'Scanning detected ports...'}</span>`;
                const url = dongleId ? `/api/gsm-dongles/ttyusb-devices?dongleId=${encodeURIComponent(dongleId)}` : '/api/gsm-dongles/ttyusb-devices';
                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success && Array.isArray(data.devices)) {
                            detectedDevicesList = data.devices;
                            renderDetectedPortsRows();
                        } else {
                            detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'لا توجد منافذ USB تسلسلية مكتشفة' : 'No ttyUSB devices detected'}</span>`;
                        }
                    })
                    .catch(() => {
                        detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'تعذر فحص المنافذ' : 'Could not scan ports'}</span>`;
                    });
            };

            window.openEditPortsModal = function(dongleId, currentAudio, currentData) {
                if (!dongleId) return;
                if (editPortsDongleId) editPortsDongleId.value = dongleId;
                if (editPortsDongleBadge) editPortsDongleBadge.textContent = dongleId;
                if (editPortsAudioInput) editPortsAudioInput.value = currentAudio || '';
                if (editPortsDataInput) editPortsDataInput.value = currentData || '';

                validatePortsForm();
                loadDetectedPortsList();

                if (editPortsModal && editPortsModalCard) {
                    editPortsModal.classList.remove('opacity-0', 'pointer-events-none');
                    editPortsModalCard.classList.remove('scale-95', 'opacity-0');
                    editPortsModalCard.classList.add('scale-100', 'opacity-100');
                }
            };

            window.closeEditPortsModal = function() {
                if (editPortsModal && editPortsModalCard) {
                    editPortsModal.classList.add('opacity-0', 'pointer-events-none');
                    editPortsModalCard.classList.remove('scale-100', 'opacity-100');
                    editPortsModalCard.classList.add('scale-95', 'opacity-0');
                }
            };

            if (editPortsModal) {
                editPortsModal.addEventListener('click', (e) => {
                    if (e.target === editPortsModal) closeEditPortsModal();
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && editPortsModal && !editPortsModal.classList.contains('opacity-0')) {
                    closeEditPortsModal();
                }
            });

            window.saveDonglePorts = function(e) {
                if (e && e.preventDefault) e.preventDefault();
                const dongleId = editPortsDongleId ? editPortsDongleId.value.trim() : '';
                const audio = editPortsAudioInput ? editPortsAudioInput.value.trim() : '';
                const data = editPortsDataInput ? editPortsDataInput.value.trim() : '';

                if (!dongleId || !audio || !data) {
                    showToast(isRtl ? 'خطأ' : 'Error', isRtl ? 'يرجى إدخال منفذ الصوت ومنفذ البيانات' : 'Both audio and data ports are required', 'error');
                    return;
                }
                if (audio.toLowerCase() === data.toLowerCase()) {
                    showToast(isRtl ? 'خطأ' : 'Error', isRtl ? 'لا يمكن أن يكون منفذ الصوت ومنفذ البيانات نفس المنفذ' : 'Audio and Data ports cannot be the same device', 'error');
                    return;
                }

                if (savePortsSubmitBtn) savePortsSubmitBtn.disabled = true;
                showToast(isRtl ? 'تحديث المنافذ' : 'Updating Ports', (isRtl ? 'جاري تحديث منافذ TTY لـ ' : 'Updating TTY ports for ') + dongleId + '...', 'info');

                fetch('/api/gsm-dongles/update-ports/' + encodeURIComponent(dongleId), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ audio, data })
                })
                    .then(res => res.json())
                    .then(resData => {
                        if (resData.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (words.editPortsSuccess || (isRtl ? 'تم تحديث منافذ TTY بنجاح' : 'TTY ports updated successfully')) + ' (' + dongleId + ')', 'success');
                            closeEditPortsModal();
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', resData.error || 'Failed to update TTY ports', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => {
                        if (savePortsSubmitBtn) savePortsSubmitBtn.disabled = false;
                    });
            };

            // Dongle & Config Audit Modal elements & controllers
            const dongleAuditModal = document.getElementById('dongle-audit-modal');
            const dongleAuditModalCard = document.getElementById('dongle-audit-modal-card');
            const auditKpiTotal = document.getElementById('audit-kpi-total');
            const auditKpiSynced = document.getElementById('audit-kpi-synced');
            const auditKpiIssues = document.getElementById('audit-kpi-issues');
            const auditKpiDisconnected = document.getElementById('audit-kpi-disconnected');
            const auditActionBanner = document.getElementById('audit-action-banner');
            const auditBannerText = document.getElementById('audit-banner-text');
            const auditReconcileAllBtn = document.getElementById('audit-reconcile-all-btn');
            const auditSlotsTableBody = document.getElementById('audit-slots-table-body');
            const auditTimestamp = document.getElementById('audit-timestamp');
            const auditRefreshBtn = document.getElementById('audit-refresh-btn');

            let currentAuditData = null;

            window.openDongleAuditModal = function() {
                if (dongleAuditModal && dongleAuditModalCard) {
                    dongleAuditModal.classList.remove('opacity-0', 'pointer-events-none');
                    dongleAuditModalCard.classList.remove('scale-95', 'opacity-0');
                    dongleAuditModalCard.classList.add('scale-100', 'opacity-100');
                    runDongleAudit();
                }
            };

            window.closeDongleAuditModal = function() {
                if (dongleAuditModal && dongleAuditModalCard) {
                    dongleAuditModal.classList.add('opacity-0', 'pointer-events-none');
                    dongleAuditModalCard.classList.remove('scale-100', 'opacity-100');
                    dongleAuditModalCard.classList.add('scale-95', 'opacity-0');
                }
            };

            if (dongleAuditModal) {
                dongleAuditModal.addEventListener('click', (e) => {
                    if (e.target === dongleAuditModal) closeDongleAuditModal();
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && dongleAuditModal && !dongleAuditModal.classList.contains('opacity-0')) {
                    closeDongleAuditModal();
                }
            });

            window.runDongleAudit = function() {
                if (!auditSlotsTableBody) return;
                auditSlotsTableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-xs text-[var(--text-muted)] font-sans">
                            <div class="inline-flex items-center gap-2">
                                <svg class="animate-spin text-[var(--accent-color)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="16"/></svg>
                                <span>${isRtl ? 'جاري فحص الإعدادات والأجهزة...' : 'Scanning configuration and live devices...'}</span>
                            </div>
                        </td>
                    </tr>`;

                if (auditRefreshBtn) {
                    const icon = auditRefreshBtn.querySelector('svg');
                    if (icon) icon.classList.add('animate-spin');
                }

                fetch('/api/gsm-dongles/audit')
                    .then(res => res.json())
                    .then(data => {
                        if (data.success && data.audit) {
                            currentAuditData = data.audit;
                            renderAuditReport(data.audit);
                        } else {
                            auditSlotsTableBody.innerHTML = `
                                <tr>
                                    <td colspan="5" class="px-4 py-6 text-center text-xs text-rose-400 font-sans">
                                        ${escapeHtml(data.error || 'Failed to load audit data')}
                                    </td>
                                </tr>`;
                        }
                    })
                    .catch(err => {
                        auditSlotsTableBody.innerHTML = `
                            <tr>
                                <td colspan="5" class="px-4 py-6 text-center text-xs text-rose-400 font-sans">
                                    ${escapeHtml(err.message || 'Network Error during audit')}
                                </td>
                            </tr>`;
                    })
                    .finally(() => {
                        if (auditRefreshBtn) {
                            const icon = auditRefreshBtn.querySelector('svg');
                            if (icon) icon.classList.remove('animate-spin');
                        }
                    });
            };

            function renderAuditReport(audit) {
                if (!audit) return;
                const { summary, slots, timestamp } = audit;

                if (auditKpiTotal) auditKpiTotal.textContent = summary.totalSlots || 0;
                if (auditKpiSynced) auditKpiSynced.textContent = summary.syncedCount || 0;
                if (auditKpiIssues) auditKpiIssues.textContent = (summary.issuesCount || 0) + (summary.unpinnedCount || 0);
                if (auditKpiDisconnected) auditKpiDisconnected.textContent = summary.disconnectedCount || 0;
                if (auditTimestamp) auditTimestamp.textContent = new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

                const actionableSlots = (slots || []).filter(s => s.actionNeeded || (s.live && (s.live.imei || s.live.imsi) && s.status !== 'synced'));

                if (auditActionBanner) {
                    if (actionableSlots.length > 0) {
                        auditActionBanner.classList.remove('hidden');
                        if (auditBannerText) {
                            auditBannerText.textContent = isRtl
                                ? `تم اكتشاف ${actionableSlots.length} شريحة بها اختلافات أو كود IMEI غير مسجل في dongle.conf. انقر لمطابقة الإعدادات فوراً.`
                                : `Detected ${actionableSlots.length} slot(s) with mismatches or unpopulated hardware IDs. Sync configuration to match live devices.`;
                        }
                    } else {
                        auditActionBanner.classList.add('hidden');
                    }
                }

                if (!slots || slots.length === 0) {
                    auditSlotsTableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-xs text-[var(--text-muted)] font-sans">
                                ${isRtl ? 'لا توجد منافذ مهيأة في dongle.conf' : 'No dongle slots configured in dongle.conf'}
                            </td>
                        </tr>`;
                    return;
                }

                let html = '';
                slots.forEach(slot => {
                    const cfg = slot.config || {};
                    const liv = slot.live || {};
                    const isConnected = liv.state && !['not connected', 'not initialized', 'unknown'].includes(String(liv.state).toLowerCase());
                    const canSync = liv.imei || liv.imsi;

                    let statusBadge = '';
                    if (slot.status === 'synced') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ${isRtl ? 'مطابق تماماً' : 'Synchronized'}
                        </span>`;
                    } else if (slot.status === 'mismatch') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span> ${isRtl ? 'اختلاف في IMEI/IMSI' : 'Hardware Mismatch'}
                        </span>`;
                    } else if (slot.status === 'unpinned') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> ${isRtl ? 'غير مسجل في conf' : 'Unpinned in config'}
                        </span>`;
                    } else if (slot.status === 'disconnected') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-zinc-500/10 text-[var(--text-muted)] border border-zinc-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span> ${isRtl ? 'غير متصل' : 'Disconnected'}
                        </span>`;
                    } else {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span> ${escapeHtml(slot.status)}
                        </span>`;
                    }

                    const issuesList = (slot.issues || []).map(iss => {
                        const colorClass = iss.severity === 'critical' ? 'text-rose-400' : (iss.severity === 'warning' ? 'text-amber-400' : 'text-blue-400');
                        return `<p class="text-[10px] font-sans ${colorClass} leading-tight">• ${escapeHtml(iss.message)}</p>`;
                    }).join('');

                    html += `
                        <tr class="hover:bg-[var(--bg-hover)] transition">
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-0.5">
                                    <span class="font-bold text-[var(--text-primary)]">[${escapeHtml(slot.slotId)}]</span>
                                    <span class="text-[10px] text-[var(--text-muted)]">${escapeHtml(cfg.audio || '-')}</span>
                                    <span class="text-[10px] text-[var(--text-muted)]">${escapeHtml(cfg.data || '-')}</span>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-1 text-[11px]">
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMEI:</span> <span class="${cfg.imei ? 'text-[var(--text-primary)]' : 'text-amber-400/80 italic font-sans'}">${escapeHtml(cfg.imei || '(none)')}</span></div>
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMSI:</span> <span class="${cfg.imsi ? 'text-[var(--text-primary)]' : 'text-amber-400/80 italic font-sans'}">${escapeHtml(cfg.imsi || '(none)')}</span></div>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-1 text-[11px]">
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">State:</span> <span class="font-bold ${isConnected ? 'text-emerald-400 font-sans' : 'text-zinc-400 font-sans'}">${escapeHtml(liv.state || 'Not Connected')}</span></div>
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMEI:</span> <span class="${liv.imei ? 'text-[var(--text-primary)]' : 'text-zinc-500 italic font-sans'}">${escapeHtml(liv.imei || '(none)')}</span></div>
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMSI:</span> <span class="${liv.imsi ? 'text-[var(--text-primary)]' : 'text-zinc-500 italic font-sans'}">${escapeHtml(liv.imsi || '(none)')}</span></div>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-1.5">
                                    <div>${statusBadge}</div>
                                    <div class="flex flex-col gap-0.5">${issuesList}</div>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-middle text-end">
                                ${canSync && slot.status !== 'synced' ? `
                                    <button type="button" onclick="reconcileSlot('${escapeHtml(slot.slotId)}')" class="bg-[var(--accent-color)]/20 hover:bg-[var(--accent-color)] text-[var(--accent-color)] hover:text-white font-sans font-bold px-2.5 py-1 rounded-lg text-xs transition cursor-pointer border border-[var(--accent-color)]/40 shrink-0">
                                        ${isRtl ? 'مطابقة' : 'Sync'}
                                    </button>
                                ` : ''}
                            </td>
                        </tr>`;
                });

                auditSlotsTableBody.innerHTML = html;
            }

            window.reconcileSlot = function(slotId) {
                if (!slotId) return;
                showToast(isRtl ? 'جاري المطابقة' : 'Reconciling', (isRtl ? 'جاري مطابقة إعدادات ' : 'Reconciling config for ') + slotId + '...', 'info');

                fetch('/api/gsm-dongles/reconcile-conf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ slots: [slotId] })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', data.message || 'Slot reconciled successfully', 'success');
                            if (data.audit) {
                                currentAuditData = data.audit;
                                renderAuditReport(data.audit);
                            } else {
                                runDongleAudit();
                            }
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Reconciliation failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'));
            };

            window.reconcileAllDongles = function() {
                if (auditReconcileAllBtn) auditReconcileAllBtn.disabled = true;
                showToast(isRtl ? 'جاري المطابقة الشاملة' : 'Reconciling All Slots', isRtl ? 'جاري تحديث dongle.conf لكافة الأجهزة المتصلة...' : 'Updating dongle.conf for all live devices...', 'info');

                fetch('/api/gsm-dongles/reconcile-conf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ syncAll: true })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', data.message || 'All dongles reconciled successfully', 'success');
                            if (data.audit) {
                                currentAuditData = data.audit;
                                renderAuditReport(data.audit);
                            } else {
                                runDongleAudit();
                            }
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Reconciliation failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => {
                        if (auditReconcileAllBtn) auditReconcileAllBtn.disabled = false;
                    });
            };

            function renderSmsCard(sms) {
                const dateStr = new Date(sms.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const card = document.createElement('div');
                card.className = 'sms-message-card p-3.5 bg-[var(--bg-card)] border border-[var(--border-primary)] hover:border-[var(--border-accent)] rounded-xl transition flex flex-col gap-2 cursor-pointer select-none';
                card.id = 'sms-' + sms.id;
                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2 text-xs">
                        <div class="flex items-center gap-2 min-w-0">
                            <span class="bg-[var(--accent-color)] text-white font-mono font-bold px-1.5 py-0.5 rounded text-[9px] uppercase shrink-0">${escapeHtml(sms.dongleId)}</span>
                            <span class="text-[var(--text-primary)] font-bold font-mono truncate">${escapeHtml(sms.sender)}</span>
                            <button type="button" class="sms-copy-sender text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded transition cursor-pointer shrink-0" title="${isRtl ? 'نسخ الرقم' : 'Copy number'}">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                            </button>
                        </div>
                        <span class="text-[var(--text-muted)] font-mono text-[9px] shrink-0">${escapeHtml(dateStr)}</span>
                    </div>
                    <p class="text-xs text-[var(--text-secondary)] leading-relaxed select-text font-sans line-clamp-2">${escapeHtml(sms.content)}</p>`;

                const copyButton = card.querySelector('.sms-copy-sender');
                copyButton.addEventListener('click', event => {
                    event.stopPropagation();
                    copyToClipboard(sms.sender, copyButton);
                });
                card.addEventListener('click', () => {
                    showSmsModal(sms.dongleId, sms.sender, sms.content, sms.timestamp);
                });
                return card;
            }

            function filterAndRenderSms() {
                const container = getSmsContainer();
                if (!container) return;

                if (!selectedDongleId) {
                    showEmptySmsInbox();
                    return;
                }

                const filtered = allSmsMessages.filter(sms => (sms.dongleId || '').toLowerCase() === selectedDongleId.toLowerCase());
                updateSmsInboxCount(filtered.length);
                container.innerHTML = '';
                if (filtered.length === 0) {
                    showEmptySmsInbox();
                    return;
                }
                filtered.forEach(sms => container.appendChild(renderSmsCard(sms)));
            }

            window.loadSmsInbox = async function() {
                try {
                    const res = await fetch('/api/gsm-dongles/sms');
                    const data = await res.json();
                    if (data.success && data.sms) {
                        allSmsMessages = data.sms;
                        filterAndRenderSms();
                    } else {
                        allSmsMessages = [];
                        showEmptySmsInbox();
                    }
                } catch (e) {
                    console.error("Failed to load SMS inbox:", e);
                }
            };

            window.clearSmsInbox = async function() {
                if (!confirm(isRtl ? 'هل أنت متأكد من مسح صندوق الرسائل؟' : 'Are you sure you want to clear the SMS inbox?')) return;
                try {
                    await fetch('/api/gsm-dongles/clear-sms', { method: 'POST' });
                } catch (e) {
                    console.error("Failed to clear SMS inbox:", e);
                }
            };

            function showEmptySmsInbox() {
                const container = getSmsContainer();
                if (!container) return;
                updateSmsInboxCount(0);
                container.innerHTML = `
                    <div class="text-center py-8 text-[var(--text-muted)] italic" id="sms-empty-placeholder">
                        ${isRtl ? 'لا يوجد رسائل واردة حالياً' : 'No incoming SMS messages'}
                    </div>`;
            }

            // Real-time SMS receivers
            if (socket) {
                socket.on('newSms', (sms) => {
                    allSmsMessages.unshift(sms);
                    
                    // Show a real-time toast notification alert
                    showSmsToast(sms);
                    
                    if (selectedDongleId && (sms.dongleId || '').toLowerCase() === selectedDongleId.toLowerCase()) {
                        const placeholder = document.getElementById('sms-empty-placeholder');
                        if (placeholder && placeholder.parentNode) {
                            placeholder.parentNode.removeChild(placeholder);
                        }
                        const container = getSmsContainer();
                        if (container) {
                            container.insertBefore(renderSmsCard(sms), container.firstChild);
                        }
                        updateSmsInboxCount(allSmsMessages.filter(message => (message.dongleId || '').toLowerCase() === selectedDongleId.toLowerCase()).length);
                    }
                });

                socket.on('smsCleared', () => {
                    allSmsMessages = [];
                    showEmptySmsInbox();
                });
            }

            // Initial load
            loadSmsInbox();

            // --- USB TTY & LSUSB HARDWARE DEVICE LISTING ---
            const usbGrid = document.getElementById('usb-devices-grid');
            const lsusbGrid = document.getElementById('lsusb-devices-grid');
            const lsusbModemsCountEl = document.getElementById('lsusb-modems-count');
            const lsusbTtyCountEl = document.getElementById('lsusb-tty-count');

            let lastUsbSignature = null;
            let usbRefreshInFlight = false;
            let usbHasLoaded = false;
            const usbHtmlEntities = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            };

            function escapeUsbText(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => usbHtmlEntities[character]);
            }

            function getUsbSignature(data) {
                return JSON.stringify({
                    modems: (data.physicalModems || []).map(m => `${m.bus}:${m.device}:${m.hardwareId}:${(m.ttyPorts||[]).join(',')}:${(m.boundSlots||[]).join(',')}`),
                    devices: (data.devices || data.ttyDevices || []).map(d => `${d.name}:${d.dongleId}:${d.portType}`)
                });
            }

            function renderLsusbDevices(physicalModems) {
                if (!lsusbGrid) return;
                if (!Array.isArray(physicalModems) || physicalModems.length === 0) {
                    lsusbGrid.innerHTML = `
                        <div class="col-span-full flex flex-col items-center justify-center py-6 gap-2 bg-[var(--bg-card)] rounded-xl border border-[var(--border-primary)]">
                            <svg class="text-zinc-500" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            <span class="text-sm font-bold text-zinc-400">${escapeUsbText(words.lsusbNone || 'No physical USB modems detected')}</span>
                            <span class="text-[10px] text-zinc-500 max-w-xs text-center">${escapeUsbText(words.lsusbNoneHint || 'Check physical USB connections or run lsusb in terminal')}</span>
                        </div>`;
                    return;
                }

                lsusbGrid.innerHTML = physicalModems.map(modem => {
                    const boundSlotsText = (modem.boundSlots && modem.boundSlots.length)
                        ? modem.boundSlots.join(', ')
                        : (words.lsusbUnassigned || 'Unassigned');
                    const isBound = Boolean(modem.boundSlots && modem.boundSlots.length);

                    const ttyPills = (modem.ttyPorts && modem.ttyPorts.length > 0)
                        ? modem.ttyPorts.map(p => `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-black text-emerald-200 bg-emerald-900/60 hover:bg-emerald-900/80 border border-emerald-400/50 shadow-xs transition-colors">${escapeUsbText(p)}</span>`).join('')
                        : `<span class="text-[10px] text-amber-400 font-mono font-bold">${isRtl ? 'لا توجد منافذ TTY' : 'No TTY ports'}</span>`;

                    return `
                        <div class="flex flex-col gap-2.5 p-3.5 rounded-xl border border-purple-500/30 bg-purple-950/20 transition hover:border-purple-400/60 shadow-sm">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0 shadow-xs"></span>

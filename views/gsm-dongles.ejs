            --bg-card: #121215; /* Charcoal card surfaces */
            --bg-hover: #1e1e24; /* Zinc hover state */
            --border-primary: #18181c; /* Soft dark border */
            --border-accent: #2c2c34; /* Slightly brighter border */
            --text-primary: #f4f4f5; /* High contrast Zinc 50 */
            --text-secondary: #a1a1aa; /* Zinc 400 */
            --text-muted: #8e8e93; /* Compliant muted text (contrast 6.4:1) */
            --accent-color: #e53e3e; /* Deep rich crimson red */
            --accent-hover: #fc8181; /* Accent hover color */
            --accent-soft: rgba(229, 62, 62, 0.14);
            --accent-border: rgba(229, 62, 62, 0.42);
            --bg-selected: rgba(229, 62, 62, 0.2); /* Translucent crimson selection */
        }
        body.light-theme {
            --bg-primary: #f4f4f6 !important; /* Clean light grey background */
            --bg-secondary: #ffffff !important; /* Pure white card background */
            --bg-card: #f4f4f6 !important;
            --bg-hover: #e4e4e9 !important;
            --border-primary: #e4e4e9 !important;
            --border-accent: #d4d4de !important;
            --text-primary: #18181b !important;
            --text-secondary: #3f3f46 !important;
            --text-muted: #71717a !important; /* Compliant muted text (contrast 4.68:1) */
            --accent-color: #b91c1c !important; /* Accessible deep red for light mode */
            --accent-hover: #991b1b !important;
            --accent-soft: rgba(254, 226, 226, 0.72) !important;
            --accent-border: rgba(220, 38, 38, 0.36) !important;
            --bg-selected: rgba(220, 38, 38, 0.22) !important;
        }
        body { 
            background-color: var(--bg-primary); 
            font-family: 'Roboto', 'IBM Plex Sans Arabic', sans-serif; 
            color: var(--text-primary); 
        }
        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: 
                radial-gradient(circle at 10% 20%, rgba(229, 62, 62, 0.04) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.01) 0%, transparent 45%);
            pointer-events: none;
            z-index: -1;
        }
        .panel-surface { 
            background-color: var(--bg-secondary); 
            border: 1px solid var(--border-primary); 
        }
        .accent-orange { color: var(--accent-color); }
        .font-vibrant-display { font-weight: 900; letter-spacing: -0.01em; }
        
        .terminal-screen {
            background-color: #030303;
            border: 1px solid #1a1a1a;
            font-family: 'JetBrains Mono', 'Courier New', Courier, monospace;
            max-height: 400px;
            overflow-y: auto;
        }
        .log-screen {
            background-color: #050505;
            border: 1px solid #1f1f23;
            font-family: 'JetBrains Mono', monospace;
            max-height: 250px;
            overflow-y: auto;
        }
        .pulse-dot {
            position: relative;
        }
        .pulse-dot.active::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0; left: 0;
            border-radius: 50%;
            background-color: inherit;
            animation: ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
        @media (min-width: 1400px) {
            #dongles-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
            }
        }
        .dongle-device-card {
            background: var(--bg-card);
            border: 2px solid var(--border-primary);
            min-width: 0;
            overflow: hidden;
            transition: border-color 180ms ease, transform 180ms ease, background-color 180ms ease;
        }
        .dongle-device-card:hover {
            border-color: var(--border-accent);
            transform: translateY(-2px);
        }
        
        /* State-driven card color themes — Matte background surfaces and bolder state accents */
        
        /* 1. FREE / READY (Purple) */
        .dongle-device-card.dongle-state-purple {
            background-color: #23153c !important;
            border-color: #a855f7 !important;
        }
        .dongle-device-card.dongle-state-purple:hover {
            border-color: #c084fc !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-icon-box {
            background-color: #581c87 !important;
            border: 1px solid #a855f7 !important;
            color: #e9d5ff !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-status-pill {
            background-color: #9333ea !important;
            border: 1px solid #c084fc !important;
            color: #ffffff !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-status-dot {
            background-color: #f3e8ff !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-metric,
        .dongle-device-card.dongle-state-purple .dongle-priority-metric {
            background: #1a0f30 !important;
            border: 1px solid rgba(168, 85, 247, 0.4) !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-hardware-summary,
        .dongle-device-card.dongle-state-purple .dongle-routing-panel {
            background: #1c1130 !important;
            border: 1px solid rgba(168, 85, 247, 0.4) !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-routing-trunk {
            background: #160d26 !important;
            border: 1px solid rgba(168, 85, 247, 0.3) !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-card-footer {
            background-color: #160d26 !important;
            border-top: 1px solid rgba(168, 85, 247, 0.4) !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-action-button.dongle-action-primary {
            background-color: #9333ea !important;
            border-color: #c084fc !important;
            color: #ffffff !important;
        }
        .dongle-device-card.dongle-state-purple .dongle-action-button.dongle-action-primary:hover {
            background-color: #7e22ce !important;
        }
        .dongle-device-card.selected-row.dongle-state-purple {
            border-color: #e9d5ff !important;
            outline: 3px solid #c084fc !important;

        }
        .light-theme .dongle-device-card.dongle-state-green .dongle-metric,
        .light-theme .dongle-device-card.dongle-state-green .dongle-priority-metric,
        .light-theme .dongle-device-card.dongle-state-green .dongle-routing-panel,
        .light-theme .dongle-device-card.dongle-state-green .dongle-hardware-summary {
            background: #bbf7d0 !important;
            border-color: #34d399 !important;
        }
        .light-theme .dongle-device-card.dongle-state-green .dongle-routing-trunk {

                    const routingTrunk = event.target.closest('.dongle-routing-trunk');
                    if (routingTrunk) return;

                    const card = event.target.closest('.dongle-device-card');
                    if (!card || !donglesGrid.contains(card)) return;

                    const id = card.dataset.dongleId;
                    const actionButton = event.target.closest('[data-dongle-action]');
                    if (!actionButton) {
                        selectDevice(id);
                        return;
                    }

                    const action = actionButton.dataset.dongleAction;
                    if (action === 'copy-imei') copyToClipboard(card.dataset.imei, actionButton);
                    if (action === 'copy-number') copyToClipboard(card.dataset.number, actionButton);
                    if (action === 'edit-number') editSimNumber(id, card.dataset.imsi, card.dataset.number);
                    if (action === 'reload') reloadDongle(id);
                    if (action === 'reboot-modem') rebootModem(id);
                    if (action === 'edit-ports') openEditPortsModal(id, card.dataset.audio, card.dataset.data);
                    if (action === 'virtual-replug') virtualReplug(id);
                    if (action === 'reset-usb') virtualReplug(id);
                    if (action === 'populate-hardware') populateDongleHardware(id, card.dataset.imei, card.dataset.imsi);
                    if (action === 'call-forwarding') openDongleCallForwarding(id);
                });
            }

            function appendUssdResponse(logTime, text, isLive) {
                const now = Date.now();
                const normalizedText = String(text || '').trim();
                
                // Deduplicate identical responses printed within 3 seconds
                if (normalizedText === lastUssdText && (now - lastUssdTime) < 3000) {
                    return;
                }
                
                lastUssdText = normalizedText;
                lastUssdTime = now;
                
                const respLine = document.createElement('div');
                respLine.className = 'ussd-resp-box font-semibold p-2.5 rounded-lg border mt-1 whitespace-pre-wrap leading-relaxed select-text';
                
                const displayLabel = isLive ? ' (Live Event)' : '';
                const displayText = normalizedText || '(Empty Response / Terminated by Network)';
                respLine.innerHTML = `<span class="ussd-resp-time font-normal font-mono">[${logTime}]${displayLabel}</span> <span class="ussd-resp-text font-mono">${displayText}</span>`;
                
                terminalScreen.appendChild(respLine);
                terminalScreen.scrollTop = terminalScreen.scrollHeight;
            }

            // Select Row behavior to display details
            window.selectDevice = function(id, options) {
                try {
                    const normalizedId = String(id || '');
                    const dev = loadedDevices.find(device => String(device.ID || '') === normalizedId);
                    if (!dev) return;

                    document.querySelectorAll('.dongle-device-card').forEach(card => {
                        card.classList.remove('selected-row');
                    });
                    const selectedRow = document.getElementById('row-' + normalizedId);
                    if (selectedRow) selectedRow.classList.add('selected-row');
                    
                    // Fill metadata cards
                    elId.textContent = dev.ID || '-';
                    elNum.textContent = dev.Number || 'Unknown';
                    elProv.textContent = dev['Provider Name'] || 'NONE';
                    elImei.textContent = dev.IMEI || '-';
                    elImsi.textContent = dev.IMSI || '-';
                    elGroup.textContent = dev.Group || '0';
                    elModel.textContent = dev.Model || '-';
                    elFirm.textContent = dev.Firmware || '-';
                    elMode.textContent = dev.Mode || '-';
                    elSub.textContent = dev.Submode || '-';

                    const previousSelected = selectedDongleId;
                    selectedDongleId = normalizedId;
                    updateSmsInboxTitle();
                    if (!options || !options.skipSms || previousSelected !== normalizedId) {
                        if (previousSelected !== normalizedId) {
                            activeThreadEndpoint = null;
                        }
                        filterAndRenderSms();
                    }
                    // Update Live Status & Diagnostics Block
                    updateLiveDiagnostics(dev);

                    // Sync select dropdowns
                    isSyncingSelect = true;
                    if (ussdTarget && ussdTarget.value !== id) {
                        ussdTarget.value = id;
                        ussdTarget.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    const cfTarget = document.getElementById('cf-target-dongle');
                    if (cfTarget && cfTarget.value !== id) {
                        cfTarget.value = id;
                        cfTarget.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    const replyDongle = document.getElementById('sms-reply-dongle');
                    if (replyDongle && replyDongle.value.toLowerCase() !== normalizedId.toLowerCase()) {
                        replyDongle.value = normalizedId;
                    }
                    isSyncingSelect = false;
                } catch (err) {
                    console.error("Error inside selectDevice:", err);
                }
            };

            function updateLiveDiagnostics(dev) {
                try {
                    const signal = getDongleSignalView(dev);
                    const state = getDongleStateView(dev);
                    const barsContainer = document.getElementById('diag-signal-bars');
                    const signalText = document.getElementById('diag-signal-text');
                    const badgeContainer = document.getElementById('diag-service-badge');
                    const carrierEl = document.getElementById('diag-carrier-text');

                    if (barsContainer) barsContainer.innerHTML = signal.barsHtml;
                    if (signalText) signalText.textContent = `${signal.rssi}/31 · ${signal.percent}% · ${signal.level}`;
                    if (carrierEl) carrierEl.textContent = dev['Provider Name'] || (isRtl ? 'غير معروف' : 'Unknown');
                    if (badgeContainer) {
                        badgeContainer.innerHTML = `
                            <span class="inline-flex items-center gap-1.5 ${state.badge.bg} ${state.badge.text} rounded-full px-2.5 py-1 text-[10px] font-semibold border ${state.badge.border}">
                                <span class="h-1.5 w-1.5 rounded-full ${state.badge.dot}${state.animate ? ' animate-pulse' : ''} shrink-0"></span>
                                ${escapeHtml(state.label)}
                            </span>`;
                    }

                    const checklist = [
                        document.getElementById('chk-voice'),
                        document.getElementById('chk-sms'),
                        document.getElementById('chk-ussd')
                    ];
                    let checklistClass = 'text-zinc-500 font-bold font-mono';
                    let checklistLabel = '● OFF';
                    if (state.isReady) {
                        checklistClass = 'text-emerald-500 font-bold font-mono';
                        checklistLabel = '● OK';
                    } else if (state.color === 'yellow') {
                        checklistClass = 'text-red-500 font-bold font-mono';
                        checklistLabel = '● FAIL';
                    } else if (state.color !== 'red') {
                        checklistClass = 'text-amber-500 font-bold font-mono';
                        checklistLabel = '● WAIT';
                    }
                    checklist.forEach(element => {
                        if (!element) return;
                        element.className = checklistClass;
                        element.textContent = checklistLabel;
                    });
                } catch (error) {
                    console.error('Error updating live diagnostics:', error);
                }
            }

            renderDongleCards();
            if (loadedDevices.length > 0) {
                selectDevice(loadedDevices[0].ID);
            }

            // Sync detail card and table highlight when select dropdown is changed
            if (ussdTarget) {
                ussdTarget.addEventListener('change', (e) => {
                    if (isSyncingSelect) return;
                    if (e.target.value && e.target.value !== selectedDongleId) {
                        selectDevice(e.target.value);
                    }
                });
            }
            const cfTargetEl = document.getElementById('cf-target-dongle');
            if (cfTargetEl) {
                cfTargetEl.addEventListener('change', (e) => {
                    if (isSyncingSelect) return;
                    if (e.target.value && e.target.value !== selectedDongleId) {
                        selectDevice(e.target.value);
                    }
                });
            }
            const replyDongleEl = document.getElementById('sms-reply-dongle');
            if (replyDongleEl) {
                replyDongleEl.addEventListener('change', (e) => {
                    if (isSyncingSelect) return;
                    const val = e.target.value;
                    if (val && val.toLowerCase() !== (selectedDongleId || '').toLowerCase()) {
                        selectDevice(val);
                    }
                });
            }

            // --- SMS INBOX MANAGEMENT ---
            function getSmsContainer() {
                return document.getElementById('sms-inbox-container');
            }

            function updateSmsInboxTitle() {
                const deviceEl = document.getElementById('sms-inbox-device');
                if (deviceEl) {
                    deviceEl.textContent = selectedDongleId
                        ? `${isRtl ? 'الجهاز المحدد' : 'Selected'}: ${selectedDongleId}`
                        : (isRtl ? 'اختر جهازاً' : 'Select a dongle');
                }
                const replyDongle = document.getElementById('sms-reply-dongle');
                if (replyDongle && selectedDongleId && replyDongle.value.toLowerCase() !== selectedDongleId.toLowerCase()) {
                    replyDongle.value = selectedDongleId;
                }
            }

            function updateSmsInboxCount(count) {
                const countEl = document.getElementById('sms-inbox-count');
                if (countEl) countEl.textContent = String(count);
            }

            // Toast Notification system
            const toastContainer = document.getElementById('toast-container');
            
            function showSmsToast(sms) {
                if (!toastContainer) return;
                
                const toast = document.createElement('div');
                // Premium glassmorphism dynamic style
                toast.className = 'bg-[var(--bg-secondary)]/90 border border-[var(--border-primary)] p-4 rounded-xl flex flex-col gap-1.5 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto cursor-pointer max-w-xs';
                
                toast.innerHTML = `
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-[var(--accent-color)] font-bold uppercase tracking-wider font-mono">${isRtl ? 'رسالة جديدة' : 'New SMS'}</span>
                        <span class="text-[var(--text-muted)] font-mono text-[10px]">${sms.dongleId}</span>
                    </div>
                    <div class="text-xs font-bold text-[var(--text-primary)]">${sms.sender}</div>
                    <p class="text-xs text-[var(--text-secondary)] truncate">${sms.content}</p>
                `;
                
                toast.onclick = function() {
                    if (selectedDongleId && selectedDongleId.toLowerCase() !== sms.dongleId.toLowerCase()) {
                        selectDevice(sms.dongleId);
                    }
                    if (typeof selectSmsThread === 'function') {
                        selectSmsThread(sms.endpoint || sms.sender);
                    } else if (typeof showSmsModal === 'function') {
                        showSmsModal(sms.dongleId, sms.sender, sms.content, sms.timestamp);
                    }
                    toast.remove();
                };
                
                toastContainer.appendChild(toast);
                
                // Animate entrance
                setTimeout(() => {
                    toast.classList.remove('translate-y-5', 'opacity-0');
                }, 10);
                
                // Auto dismiss after 6 seconds
                setTimeout(() => {
                    toast.classList.add('translate-y-5', 'opacity-0');
                    setTimeout(() => { toast.remove(); }, 300);
                }, 6000);
            }

            function showToast(title, message, type) {
                if (!toastContainer) return;
                const toast = document.createElement('div');
                const borderColor = type === 'error' ? 'border-red-900' : type === 'warning' ? 'border-amber-500/50' : type === 'success' ? 'border-emerald-900' : 'border-[var(--border-primary)]';
                const titleColor = type === 'error' ? 'text-red-400' : type === 'warning' ? 'text-amber-400' : type === 'success' ? 'text-emerald-400' : 'text-[var(--text-primary)]';
                toast.className = 'bg-[var(--bg-secondary)]/90 border ' + borderColor + ' p-4 rounded-xl flex flex-col gap-1.5 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto max-w-xs';
                toast.innerHTML = '\
                    <div class="flex items-center justify-between text-xs">\
                        <span class="' + titleColor + ' font-bold uppercase tracking-wider">' + title + '</span>\
                    </div>\
                    <p class="text-xs text-[var(--text-secondary)] whitespace-pre-wrap">' + message + '</p>\
                ';
                toast.onclick = function() { toast.remove(); };
                toastContainer.appendChild(toast);
                setTimeout(function() { toast.classList.remove('translate-y-5', 'opacity-0'); }, 10);
                setTimeout(function() {
                    toast.classList.add('translate-y-5', 'opacity-0');
                    setTimeout(function() { toast.remove(); }, 300);
                }, 8000);
            }

            // Modal DOM elements & controllers
            const smsModal = document.getElementById('sms-modal');
            const smsModalCard = document.getElementById('sms-modal-card');
            const smsModalDongle = document.getElementById('sms-modal-dongle');
            const smsModalSender = document.getElementById('sms-modal-sender');
            const smsModalCopySender = document.getElementById('sms-modal-copy-sender');
            const smsModalTime = document.getElementById('sms-modal-time');
            const smsModalContent = document.getElementById('sms-modal-content');
            
            window.showSmsModal = function(dongleId, sender, content, timestamp) {
                smsModalDongle.textContent = dongleId;
                smsModalSender.textContent = sender;
                smsModalTime.textContent = new Date(timestamp).toLocaleString();
                smsModalContent.textContent = content;
                
                smsModalCopySender.onclick = function() {
                    copyToClipboard(sender, smsModalCopySender);
                };
                
                smsModal.classList.remove('opacity-0', 'pointer-events-none');
                smsModalCard.classList.remove('scale-95', 'opacity-0');
                smsModalCard.classList.add('scale-100', 'opacity-100');
            };
            
            // Send SMS Modal Controller
            const sendSmsModal = document.getElementById('send-sms-modal');
            const sendSmsModalCard = document.getElementById('send-sms-modal-card');
            const smsSenderSelect = document.getElementById('smsSenderSelect');
            const smsRecipientInput = document.getElementById('smsRecipientInput');
            const smsMessageInput = document.getElementById('smsMessageInput');
            const smsCharCounter = document.getElementById('smsCharCounter');

            window.openSendSmsModal = function(prefillDongle = null, prefillNumber = null) {
                // Populate senders list from current state
                // Populate senders list from current state
                smsSenderSelect.innerHTML = '';
                const devs = Array.isArray(window.loadedDevices) && window.loadedDevices.length > 0 ? window.loadedDevices : (typeof loadedDevices !== 'undefined' && Array.isArray(loadedDevices) ? loadedDevices : []);
                if (devs.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = selectedDongleId || 'dongle0';
                    opt.textContent = selectedDongleId || 'dongle0';
                    smsSenderSelect.appendChild(opt);
                } else {
                    devs.forEach(d => {
                        const opt = document.createElement('option');
                        const dongleId = d.ID || d.id || d.dongle_name || 'dongle0';
                        const simNum = d.Number || d.simNumber || d.phone_number || '';
                        const provider = d.ProviderName || d.provider || '';
                        opt.value = dongleId;
                        const numText = simNum ? ` (${simNum})` : '';
                        opt.textContent = `${dongleId}${numText}${provider ? ' - ' + provider : ''}`;
                        if (prefillDongle && (dongleId === prefillDongle || (simNum && simNum === prefillDongle))) {
                            opt.selected = true;
                        } else if (!prefillDongle && selectedDongleId && dongleId === selectedDongleId) {
                            opt.selected = true;
                        }
                        smsSenderSelect.appendChild(opt);
                    });
                }

                if (prefillNumber) {
                    smsRecipientInput.value = prefillNumber;
                }

                sendSmsModal.classList.remove('opacity-0', 'pointer-events-none');
                sendSmsModalCard.classList.remove('scale-95', 'opacity-0');
                sendSmsModalCard.classList.add('scale-100', 'opacity-100');
                setTimeout(() => {
                    if (prefillNumber) smsMessageInput.focus();
                    else smsRecipientInput.focus();
                }, 100);
            };

            window.closeSendSmsModal = function() {
                sendSmsModal.classList.add('opacity-0', 'pointer-events-none');
                sendSmsModalCard.classList.remove('scale-100', 'opacity-100');
                sendSmsModalCard.classList.add('scale-95', 'opacity-0');
                smsMessageInput.value = '';
                if (smsCharCounter) smsCharCounter.textContent = '0/160';
            };

            sendSmsModal.addEventListener('click', (e) => {
                if (e.target === sendSmsModal) closeSendSmsModal();
            });

            window.updateSmsCounter = function(textarea) {
                if (!smsCharCounter) return;
                const len = textarea.value.length;
                const isUnicode = /[^\u0000-\u007F]/.test(textarea.value);
                const limit = isUnicode ? 70 : 160;
                smsCharCounter.textContent = `${len}/${limit}${isUnicode ? ' (Unicode)' : ''}`;
            };

            window.handleSendSmsSubmit = async function(event) {
                event.preventDefault();
                const btn = document.getElementById('sendSmsSubmitBtn');
                const btnText = document.getElementById('sendSmsSubmitText');
                const origText = btnText ? btnText.textContent : 'Send';

                const dongleOrSim = smsSenderSelect.value;
                const to = smsRecipientInput.value.trim();
                const message = smsMessageInput.value.trim();

                if (!to || !message) return;

                if (btn) btn.disabled = true;
                if (btnText) btnText.textContent = isRtl ? 'جاري الإرسال...' : 'Sending...';

                try {
                    const res = await fetch('/api/gsm-dongles/send-sms', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            dongleId: dongleOrSim,
                            to: to,
                            message: message
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast(isRtl ? 'تم إرسال الرسالة بنجاح!' : 'SMS dispatched successfully!', 'success');
                        closeSendSmsModal();
                    } else {
                        showToast(data.error || (isRtl ? 'فشل إرسال الرسالة' : 'Failed to send SMS'), 'error');
                    }
                } catch (err) {
                    showToast(err.message, 'error');
                } finally {
                    if (btn) btn.disabled = false;
                    if (btnText) btnText.textContent = origText;
                }
            };

            window.closeSmsModal = function() {
                smsModal.classList.add('opacity-0', 'pointer-events-none');
                smsModalCard.classList.remove('scale-100', 'opacity-100');
                smsModalCard.classList.add('scale-95', 'opacity-0');
            };
            
            // Close on outer click
            smsModal.addEventListener('click', (e) => {
                if (e.target === smsModal) closeSmsModal();
            });
            
            // Close on ESC
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && !smsModal.classList.contains('opacity-0')) {
                    closeSmsModal();
                }
            });

            // Edit Ports Modal elements & controllers
            const editPortsModal = document.getElementById('edit-ports-modal');
            const editPortsModalCard = document.getElementById('edit-ports-modal-card');
            const editPortsDongleId = document.getElementById('edit-ports-dongle-id');
            const editPortsDongleBadge = document.getElementById('edit-ports-dongle-badge');
            const editPortsAudioInput = document.getElementById('edit-ports-audio');
            const editPortsDataInput = document.getElementById('edit-ports-data');
            const editPortsConflictWarning = document.getElementById('edit-ports-conflict-warning');
            const detectedPortsChips = document.getElementById('detected-ports-chips');
            const savePortsSubmitBtn = document.getElementById('save-ports-submit-btn');

            let detectedDevicesList = [];

            window.validatePortsForm = function() {
                const audio = editPortsAudioInput ? editPortsAudioInput.value.trim().toLowerCase() : '';
                const data = editPortsDataInput ? editPortsDataInput.value.trim().toLowerCase() : '';

                const hasConflict = Boolean(audio && data && audio === data);
                if (editPortsConflictWarning) {
                    if (hasConflict) editPortsConflictWarning.classList.remove('hidden');
                    else editPortsConflictWarning.classList.add('hidden');
                }
                if (savePortsSubmitBtn) {
                    savePortsSubmitBtn.disabled = hasConflict || !audio || !data;
                }
                renderDetectedPortsRows();
            };

            window.setPortSelection = function(portType, portName) {
                if (portType === 'audio' && editPortsAudioInput) {
                    editPortsAudioInput.value = portName;
                } else if (portType === 'data' && editPortsDataInput) {
                    editPortsDataInput.value = portName;
                }
                validatePortsForm();
            };

            function renderDetectedPortsRows() {
                if (!detectedPortsChips) return;
                if (!detectedDevicesList || detectedDevicesList.length === 0) {
                    detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'لا توجد منافذ USB تسلسلية مكتشفة' : 'No ttyUSB devices detected'}</span>`;
                    return;
                }

                const currentDongleId = editPortsDongleId ? editPortsDongleId.value.trim().toLowerCase() : '';
                const selectedAudio = editPortsAudioInput ? editPortsAudioInput.value.trim().toLowerCase() : '';
                const selectedData = editPortsDataInput ? editPortsDataInput.value.trim().toLowerCase() : '';

                let html = '';
                detectedDevicesList.forEach(dev => {
                    const portPath = '/dev/' + dev.name;
                    const portLower = portPath.toLowerCase();
                    const isAudio = selectedAudio === portLower;
                    const isData = selectedData === portLower;
                    const isMappedOther = dev.dongleId && dev.dongleId.toLowerCase() !== currentDongleId;

                    let statusBadge = '';
                    let cardBg = 'bg-[var(--bg-secondary)] border-[var(--border-primary)]';

                    if (isAudio) {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold font-mono shrink-0">● ${isRtl ? 'صوت (Audio)' : 'AUDIO PORT'}</span>`;
                        cardBg = 'bg-emerald-950/20 border-emerald-500/40';
                    } else if (isData) {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-cyan-500/15 text-cyan-400 border border-cyan-500/30 text-[10px] font-bold font-mono shrink-0">● ${isRtl ? 'أوامر (Data)' : 'DATA PORT'}</span>`;
                        cardBg = 'bg-cyan-950/20 border-cyan-500/40';
                    } else if (isMappedOther) {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-zinc-700/30 text-[var(--text-muted)] border border-zinc-700/50 text-[10px] font-mono shrink-0">${isRtl ? 'مستخدم في ' : 'Used by '}${escapeHtml(dev.dongleId)}</span>`;
                    } else {
                        statusBadge = `<span class="px-2 py-0.5 rounded-md bg-[var(--bg-card)] text-[var(--text-muted)] border border-[var(--border-primary)] text-[10px] font-mono shrink-0">${isRtl ? 'متاح' : 'Available'}</span>`;
                    }

                    html += `
                        <div class="flex items-center justify-between gap-2 p-2 rounded-xl border ${cardBg} transition text-xs font-mono">
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="font-bold text-[var(--text-primary)] truncate">${escapeHtml(portPath)}</span>
                                ${statusBadge}
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="setPortSelection('audio', '${escapeHtml(portPath)}')" class="px-2.5 py-1 rounded-lg text-[10px] font-bold font-sans cursor-pointer transition flex items-center gap-1 ${
                                    isAudio ? 'bg-emerald-500 text-white shadow-sm' : 'bg-[var(--bg-card)] hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                                }" title="${isRtl ? 'تعيين كمنفذ للصوت' : 'Assign as Audio Port'}">
                                    <span>${isRtl ? 'صوت' : 'Audio'}</span>
                                </button>
                                <button type="button" onclick="setPortSelection('data', '${escapeHtml(portPath)}')" class="px-2.5 py-1 rounded-lg text-[10px] font-bold font-sans cursor-pointer transition flex items-center gap-1 ${
                                    isData ? 'bg-cyan-500 text-white shadow-sm' : 'bg-[var(--bg-card)] hover:bg-cyan-500/20 text-cyan-400 border border-cyan-500/30'
                                }" title="${isRtl ? 'تعيين كمنفذ للأوامر' : 'Assign as Data Port'}">
                                    <span>${isRtl ? 'أوامر' : 'Data'}</span>
                                </button>
                            </div>
                        </div>`;
                });
                detectedPortsChips.innerHTML = html;
            }

            window.loadDetectedPortsList = function() {
                if (!detectedPortsChips) return;
                const dongleId = editPortsDongleId ? editPortsDongleId.value.trim() : '';
                detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'جاري فحص المنافذ...' : 'Scanning detected ports...'}</span>`;
                const url = dongleId ? `/api/gsm-dongles/ttyusb-devices?dongleId=${encodeURIComponent(dongleId)}` : '/api/gsm-dongles/ttyusb-devices';
                fetch(url)
                    .then(res => res.json())
                    .then(data => {
                        if (data.success && Array.isArray(data.devices)) {
                            detectedDevicesList = data.devices;
                            renderDetectedPortsRows();
                        } else {
                            detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'لا توجد منافذ USB تسلسلية مكتشفة' : 'No ttyUSB devices detected'}</span>`;
                        }
                    })
                    .catch(() => {
                        detectedPortsChips.innerHTML = `<span class="text-xs text-[var(--text-muted)] py-2 text-center">${isRtl ? 'تعذر فحص المنافذ' : 'Could not scan ports'}</span>`;
                    });
            };

            window.openEditPortsModal = function(dongleId, currentAudio, currentData) {
                if (!dongleId) return;
                if (editPortsDongleId) editPortsDongleId.value = dongleId;
                if (editPortsDongleBadge) editPortsDongleBadge.textContent = dongleId;
                if (editPortsAudioInput) editPortsAudioInput.value = currentAudio || '';
                if (editPortsDataInput) editPortsDataInput.value = currentData || '';

                validatePortsForm();
                loadDetectedPortsList();

                if (editPortsModal && editPortsModalCard) {
                    editPortsModal.classList.remove('opacity-0', 'pointer-events-none');
                    editPortsModalCard.classList.remove('scale-95', 'opacity-0');
                    editPortsModalCard.classList.add('scale-100', 'opacity-100');
                }
            };

            window.closeEditPortsModal = function() {
                if (editPortsModal && editPortsModalCard) {
                    editPortsModal.classList.add('opacity-0', 'pointer-events-none');
                    editPortsModalCard.classList.remove('scale-100', 'opacity-100');
                    editPortsModalCard.classList.add('scale-95', 'opacity-0');
                }
            };

            if (editPortsModal) {
                editPortsModal.addEventListener('click', (e) => {
                    if (e.target === editPortsModal) closeEditPortsModal();
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && editPortsModal && !editPortsModal.classList.contains('opacity-0')) {
                    closeEditPortsModal();
                }
            });

            window.saveDonglePorts = function(e) {
                if (e && e.preventDefault) e.preventDefault();
                const dongleId = editPortsDongleId ? editPortsDongleId.value.trim() : '';
                const audio = editPortsAudioInput ? editPortsAudioInput.value.trim() : '';
                const data = editPortsDataInput ? editPortsDataInput.value.trim() : '';

                if (!dongleId || !audio || !data) {
                    showToast(isRtl ? 'خطأ' : 'Error', isRtl ? 'يرجى إدخال منفذ الصوت ومنفذ البيانات' : 'Both audio and data ports are required', 'error');
                    return;
                }
                if (audio.toLowerCase() === data.toLowerCase()) {
                    showToast(isRtl ? 'خطأ' : 'Error', isRtl ? 'لا يمكن أن يكون منفذ الصوت ومنفذ البيانات نفس المنفذ' : 'Audio and Data ports cannot be the same device', 'error');
                    return;
                }

                if (savePortsSubmitBtn) savePortsSubmitBtn.disabled = true;
                showToast(isRtl ? 'تحديث المنافذ' : 'Updating Ports', (isRtl ? 'جاري تحديث منافذ TTY لـ ' : 'Updating TTY ports for ') + dongleId + '...', 'info');

                fetch('/api/gsm-dongles/update-ports/' + encodeURIComponent(dongleId), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ audio, data })
                })
                    .then(res => res.json())
                    .then(resData => {
                        if (resData.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (words.editPortsSuccess || (isRtl ? 'تم تحديث منافذ TTY بنجاح' : 'TTY ports updated successfully')) + ' (' + dongleId + ')', 'success');
                            closeEditPortsModal();
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', resData.error || 'Failed to update TTY ports', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => {
                        if (savePortsSubmitBtn) savePortsSubmitBtn.disabled = false;
                    });
            };

            // Dongle & Config Audit Modal elements & controllers
            const dongleAuditModal = document.getElementById('dongle-audit-modal');
            const dongleAuditModalCard = document.getElementById('dongle-audit-modal-card');
            const auditKpiTotal = document.getElementById('audit-kpi-total');
            const auditKpiSynced = document.getElementById('audit-kpi-synced');
            const auditKpiIssues = document.getElementById('audit-kpi-issues');
            const auditKpiDisconnected = document.getElementById('audit-kpi-disconnected');
            const auditActionBanner = document.getElementById('audit-action-banner');
            const auditBannerText = document.getElementById('audit-banner-text');
            const auditReconcileAllBtn = document.getElementById('audit-reconcile-all-btn');
            const auditSlotsTableBody = document.getElementById('audit-slots-table-body');
            const auditTimestamp = document.getElementById('audit-timestamp');
            const auditRefreshBtn = document.getElementById('audit-refresh-btn');

            let currentAuditData = null;

            window.openDongleAuditModal = function() {
                if (dongleAuditModal && dongleAuditModalCard) {
                    dongleAuditModal.classList.remove('opacity-0', 'pointer-events-none');
                    dongleAuditModalCard.classList.remove('scale-95', 'opacity-0');
                    dongleAuditModalCard.classList.add('scale-100', 'opacity-100');
                    runDongleAudit();
                }
            };

            window.closeDongleAuditModal = function() {
                if (dongleAuditModal && dongleAuditModalCard) {
                    dongleAuditModal.classList.add('opacity-0', 'pointer-events-none');
                    dongleAuditModalCard.classList.remove('scale-100', 'opacity-100');
                    dongleAuditModalCard.classList.add('scale-95', 'opacity-0');
                }
            };

            if (dongleAuditModal) {
                dongleAuditModal.addEventListener('click', (e) => {
                    if (e.target === dongleAuditModal) closeDongleAuditModal();
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && dongleAuditModal && !dongleAuditModal.classList.contains('opacity-0')) {
                    closeDongleAuditModal();
                }
            });

            window.runDongleAudit = function() {
                if (!auditSlotsTableBody) return;
                auditSlotsTableBody.innerHTML = `
                    <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-xs text-[var(--text-muted)] font-sans">
                            <div class="inline-flex items-center gap-2">
                                <svg class="animate-spin text-[var(--accent-color)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10" stroke-dasharray="32" stroke-dashoffset="16"/></svg>
                                <span>${isRtl ? 'جاري فحص الإعدادات والأجهزة...' : 'Scanning configuration and live devices...'}</span>
                            </div>
                        </td>
                    </tr>`;

                if (auditRefreshBtn) {
                    const icon = auditRefreshBtn.querySelector('svg');
                    if (icon) icon.classList.add('animate-spin');
                }

                fetch('/api/gsm-dongles/audit')
                    .then(res => res.json())
                    .then(data => {
                        if (data.success && data.audit) {
                            currentAuditData = data.audit;
                            renderAuditReport(data.audit);
                        } else {
                            auditSlotsTableBody.innerHTML = `
                                <tr>
                                    <td colspan="5" class="px-4 py-6 text-center text-xs text-rose-400 font-sans">
                                        ${escapeHtml(data.error || 'Failed to load audit data')}
                                    </td>
                                </tr>`;
                        }
                    })
                    .catch(err => {
                        auditSlotsTableBody.innerHTML = `
                            <tr>
                                <td colspan="5" class="px-4 py-6 text-center text-xs text-rose-400 font-sans">
                                    ${escapeHtml(err.message || 'Network Error during audit')}
                                </td>
                            </tr>`;
                    })
                    .finally(() => {
                        if (auditRefreshBtn) {
                            const icon = auditRefreshBtn.querySelector('svg');
                            if (icon) icon.classList.remove('animate-spin');
                        }
                    });
            };

            function renderAuditReport(audit) {
                if (!audit) return;
                const { summary, slots, timestamp } = audit;

                if (auditKpiTotal) auditKpiTotal.textContent = summary.totalSlots || 0;
                if (auditKpiSynced) auditKpiSynced.textContent = summary.syncedCount || 0;
                if (auditKpiIssues) auditKpiIssues.textContent = (summary.issuesCount || 0) + (summary.unpinnedCount || 0);
                if (auditKpiDisconnected) auditKpiDisconnected.textContent = summary.disconnectedCount || 0;
                if (auditTimestamp) auditTimestamp.textContent = new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });

                const actionableSlots = (slots || []).filter(s => s.actionNeeded || (s.live && (s.live.imei || s.live.imsi) && s.status !== 'synced'));

                if (auditActionBanner) {
                    if (actionableSlots.length > 0) {
                        auditActionBanner.classList.remove('hidden');
                        if (auditBannerText) {
                            auditBannerText.textContent = isRtl
                                ? `تم اكتشاف ${actionableSlots.length} شريحة بها اختلافات أو كود IMEI غير مسجل في dongle.conf. انقر لمطابقة الإعدادات فوراً.`
                                : `Detected ${actionableSlots.length} slot(s) with mismatches or unpopulated hardware IDs. Sync configuration to match live devices.`;
                        }
                    } else {
                        auditActionBanner.classList.add('hidden');
                    }
                }

                if (!slots || slots.length === 0) {
                    auditSlotsTableBody.innerHTML = `
                        <tr>
                            <td colspan="5" class="px-4 py-8 text-center text-xs text-[var(--text-muted)] font-sans">
                                ${isRtl ? 'لا توجد منافذ مهيأة في dongle.conf' : 'No dongle slots configured in dongle.conf'}
                            </td>
                        </tr>`;
                    return;
                }

                let html = '';
                slots.forEach(slot => {
                    const cfg = slot.config || {};
                    const liv = slot.live || {};
                    const isConnected = liv.state && !['not connected', 'not initialized', 'unknown'].includes(String(liv.state).toLowerCase());
                    const canSync = liv.imei || liv.imsi;

                    let statusBadge = '';
                    if (slot.status === 'synced') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> ${isRtl ? 'مطابق تماماً' : 'Synchronized'}
                        </span>`;
                    } else if (slot.status === 'mismatch') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-rose-500/10 text-rose-400 border border-rose-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse"></span> ${isRtl ? 'اختلاف في IMEI/IMSI' : 'Hardware Mismatch'}
                        </span>`;
                    } else if (slot.status === 'unpinned') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> ${isRtl ? 'غير مسجل في conf' : 'Unpinned in config'}
                        </span>`;
                    } else if (slot.status === 'disconnected') {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-zinc-500/10 text-[var(--text-muted)] border border-zinc-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span> ${isRtl ? 'غير متصل' : 'Disconnected'}
                        </span>`;
                    } else {
                        statusBadge = `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold font-sans">
                            <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span> ${escapeHtml(slot.status)}
                        </span>`;
                    }

                    const issuesList = (slot.issues || []).map(iss => {
                        const colorClass = iss.severity === 'critical' ? 'text-rose-400' : (iss.severity === 'warning' ? 'text-amber-400' : 'text-blue-400');
                        return `<p class="text-[10px] font-sans ${colorClass} leading-tight">• ${escapeHtml(iss.message)}</p>`;
                    }).join('');

                    html += `
                        <tr class="hover:bg-[var(--bg-hover)] transition">
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-0.5">
                                    <span class="font-bold text-[var(--text-primary)]">[${escapeHtml(slot.slotId)}]</span>
                                    <span class="text-[10px] text-[var(--text-muted)]">${escapeHtml(cfg.audio || '-')}</span>
                                    <span class="text-[10px] text-[var(--text-muted)]">${escapeHtml(cfg.data || '-')}</span>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-1 text-[11px]">
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMEI:</span> <span class="${cfg.imei ? 'text-[var(--text-primary)]' : 'text-amber-400/80 italic font-sans'}">${escapeHtml(cfg.imei || '(none)')}</span></div>
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMSI:</span> <span class="${cfg.imsi ? 'text-[var(--text-primary)]' : 'text-amber-400/80 italic font-sans'}">${escapeHtml(cfg.imsi || '(none)')}</span></div>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-1 text-[11px]">
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">State:</span> <span class="font-bold ${isConnected ? 'text-emerald-400 font-sans' : 'text-zinc-400 font-sans'}">${escapeHtml(liv.state || 'Not Connected')}</span></div>
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMEI:</span> <span class="${liv.imei ? 'text-[var(--text-primary)]' : 'text-zinc-500 italic font-sans'}">${escapeHtml(liv.imei || '(none)')}</span></div>
                                    <div><span class="text-[10px] text-[var(--text-muted)] font-sans">IMSI:</span> <span class="${liv.imsi ? 'text-[var(--text-primary)]' : 'text-zinc-500 italic font-sans'}">${escapeHtml(liv.imsi || '(none)')}</span></div>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-top">
                                <div class="flex flex-col gap-1.5">
                                    <div>${statusBadge}</div>
                                    <div class="flex flex-col gap-0.5">${issuesList}</div>
                                </div>
                            </td>
                            <td class="px-3.5 py-3 align-middle text-end">
                                ${canSync && slot.status !== 'synced' ? `
                                    <button type="button" onclick="reconcileSlot('${escapeHtml(slot.slotId)}')" class="bg-[var(--accent-color)]/20 hover:bg-[var(--accent-color)] text-[var(--accent-color)] hover:text-white font-sans font-bold px-2.5 py-1 rounded-lg text-xs transition cursor-pointer border border-[var(--accent-color)]/40 shrink-0">
                                        ${isRtl ? 'مطابقة' : 'Sync'}
                                    </button>
                                ` : ''}
                            </td>
                        </tr>`;
                });

                auditSlotsTableBody.innerHTML = html;
            }

            window.reconcileSlot = function(slotId) {
                if (!slotId) return;
                showToast(isRtl ? 'جاري المطابقة' : 'Reconciling', (isRtl ? 'جاري مطابقة إعدادات ' : 'Reconciling config for ') + slotId + '...', 'info');

                fetch('/api/gsm-dongles/reconcile-conf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ slots: [slotId] })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', data.message || 'Slot reconciled successfully', 'success');
                            if (data.audit) {
                                currentAuditData = data.audit;
                                renderAuditReport(data.audit);
                            } else {
                                runDongleAudit();
                            }
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Reconciliation failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'));
            };

            window.reconcileAllDongles = function() {
                if (auditReconcileAllBtn) auditReconcileAllBtn.disabled = true;
                showToast(isRtl ? 'جاري المطابقة الشاملة' : 'Reconciling All Slots', isRtl ? 'جاري تحديث dongle.conf لكافة الأجهزة المتصلة...' : 'Updating dongle.conf for all live devices...', 'info');

                fetch('/api/gsm-dongles/reconcile-conf', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ syncAll: true })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', data.message || 'All dongles reconciled successfully', 'success');
                            if (data.audit) {
                                currentAuditData = data.audit;
                                renderAuditReport(data.audit);
                            } else {
                                runDongleAudit();
                            }
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Reconciliation failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => {
                        if (auditReconcileAllBtn) auditReconcileAllBtn.disabled = false;
                    });
            };

            // --- DUAL-PANE SMS PHONE CHAT MESSENGER CONTROLLER ---

            function normalizePhoneEndpoint(num) {
                if (!num) return '';
                return String(num).replace(/[\s\-\(\)]/g, '').trim();
            }

            function formatRelativeTime(timestamp) {
                if (!timestamp) return '';
                const date = new Date(timestamp);
                const now = new Date();
                const isToday = date.toDateString() === now.toDateString();
                const isYesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1).toDateString() === date.toDateString();

                if (isToday) {
                    return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                } else if (isYesterday) {
                    return isRtl ? 'الأمس' : 'Yesterday';
                } else {
                    return date.toLocaleDateString([], { month: 'short', day: 'numeric' });
                }
            }

            function groupSmsIntoThreads(messages, filterDongleId = null) {
                const threadMap = new Map();
                const sorted = [...messages].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));

                sorted.forEach(msg => {
                    const dId = String(msg.dongleId || '').toLowerCase().trim();
                    if (filterDongleId && dId !== filterDongleId.toLowerCase().trim()) {
                        return;
                    }

                    const rawEndpoint = msg.endpoint || (msg.direction === 'outgoing' ? msg.recipient : msg.sender) || 'Unknown';
                    const endpoint = normalizePhoneEndpoint(rawEndpoint);
                    if (!endpoint) return;

                    if (!threadMap.has(endpoint)) {
                        threadMap.set(endpoint, {
                            endpoint: endpoint,
                            displayNumber: rawEndpoint,
                            contactName: msg.contactName || '',
                            dongleId: msg.dongleId || 'dongle0',
                            lastMessage: msg,
                            messages: []
                        });
                    }

                    const thread = threadMap.get(endpoint);
                    thread.lastMessage = msg;
                    thread.dongleId = msg.dongleId || thread.dongleId;
                    if (msg.contactName && !thread.contactName) thread.contactName = msg.contactName;
                    thread.messages.push(msg);
                });

                return Array.from(threadMap.values()).sort((a, b) => (b.lastMessage?.timestamp || 0) - (a.lastMessage?.timestamp || 0));
            }

            function renderSmsThreads() {
                const listEl = document.getElementById('sms-threads-list');
                if (!listEl) return;

                const threads = groupSmsIntoThreads(allSmsMessages, selectedDongleId);
                updateSmsInboxCount(threads.length);

                const query = smsSearchQuery.toLowerCase().trim();
                const filteredThreads = query 
                    ? threads.filter(t => t.endpoint.toLowerCase().includes(query) || (t.contactName && t.contactName.toLowerCase().includes(query)) || (t.lastMessage?.content && t.lastMessage.content.toLowerCase().includes(query)))
                    : threads;

                if (filteredThreads.length === 0) {
                    listEl.innerHTML = `
                        <div class="text-center py-12 text-zinc-500 text-xs italic" id="sms-empty-placeholder">
                            ${query ? (isRtl ? 'لا توجد نتائج بحث' : 'No matches found') : (isRtl ? 'لا توجد محادثات لهذه الشريحة' : 'No conversations found for this dongle')}
                        </div>`;
                    activeThreadEndpoint = null;
                    renderChatMessages();
                    return;
                }

                // If activeThreadEndpoint is no longer valid for this dongle, reset it
                if (activeThreadEndpoint && !filteredThreads.some(t => t.endpoint === activeThreadEndpoint)) {
                    activeThreadEndpoint = null;
                }

                let html = '';
                filteredThreads.forEach(t => {
                    const isActive = activeThreadEndpoint && normalizePhoneEndpoint(activeThreadEndpoint) === t.endpoint;
                    const lastMsg = t.lastMessage || {};
                    const isOutgoing = lastMsg.direction === 'outgoing';
                    const prefix = isOutgoing ? (isRtl ? 'أنت: ' : 'You: ') : '';
                    const previewText = (prefix + (lastMsg.content || '')).trim();
                    const timeStr = formatRelativeTime(lastMsg.timestamp);
                    const avatarLetter = (t.contactName ? t.contactName.trim()[0] : (t.displayNumber ? t.displayNumber.replace(/^\+/, '')[0] : '#')).toUpperCase();

                    html += `
                        <div class="p-3 flex items-start gap-2.5 cursor-pointer transition select-none hover:bg-[var(--bg-hover)] text-start ${isActive ? 'bg-[var(--bg-hover)] border-s-2 border-[var(--accent-color)]' : ''}" onclick="selectSmsThread('${escapeHtml(t.endpoint)}', true)">
                            <div class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center font-bold text-xs font-mono shrink-0 mt-0.5">
                                ${escapeHtml(avatarLetter)}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-1">
                                    <span class="font-bold text-xs ${isActive ? 'text-[var(--accent-color)] font-black' : 'text-[var(--text-primary)]'} font-mono truncate">${escapeHtml(t.contactName || t.displayNumber)}</span>
                                    <span class="text-[9px] text-[var(--text-muted)] font-mono shrink-0">${escapeHtml(timeStr)}</span>
                                </div>
                                ${t.contactName ? `<p class="text-[10px] text-[var(--text-muted)] font-mono truncate">${escapeHtml(t.displayNumber)}</p>` : ''}
                                <p class="text-[11px] text-[var(--text-muted)] truncate mt-0.5">${escapeHtml(previewText)}</p>
                                <div class="flex items-center justify-between mt-1">
                                    <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-muted)] uppercase">${escapeHtml(t.dongleId)}</span>
                                    <span class="text-[9px] text-[var(--text-muted)] font-mono">${t.messages.length} ${isRtl ? 'رسالة' : 'msgs'}</span>
                                </div>
                            </div>
                        </div>`;
                });

                listEl.innerHTML = html;

                if (!activeThreadEndpoint && filteredThreads.length > 0 && window.innerWidth >= 640) {
                    selectSmsThread(filteredThreads[0].endpoint, false);
                } else if (!activeThreadEndpoint) {
                    renderChatMessages();
                }
            }

            window.selectSmsThread = function(endpoint, shouldFocus = false) {
                activeThreadEndpoint = normalizePhoneEndpoint(endpoint);

                const chatPane = document.getElementById('sms-chat-pane');
                const threadsPane = document.getElementById('sms-threads-pane');
                if (chatPane) {
                    chatPane.classList.remove('hidden');
                    chatPane.classList.add('flex');
                }
                if (threadsPane && window.innerWidth < 640) {
                    threadsPane.classList.add('hidden');
                }

                const numberEl = document.getElementById('sms-active-number');
                const nameEl = document.getElementById('sms-active-contact-name');
                const avatarEl = document.getElementById('sms-active-avatar');
                const replyDongleSelect = document.getElementById('sms-reply-dongle');

                const threads = groupSmsIntoThreads(allSmsMessages, selectedDongleId);
                const activeThread = threads.find(t => t.endpoint === activeThreadEndpoint);

                if (numberEl) numberEl.textContent = activeThread ? activeThread.displayNumber : endpoint;
                if (nameEl) nameEl.textContent = activeThread?.contactName || '';
                if (avatarEl) {
                    const letter = (activeThread?.contactName ? activeThread.contactName.trim()[0] : endpoint.replace(/^\+/, '')[0] || '#').toUpperCase();
                    avatarEl.textContent = letter;
                }

                if (replyDongleSelect) {
                    replyDongleSelect.innerHTML = '';
                    const devs = (loadedDevices && loadedDevices.length > 0) ? loadedDevices : [];
                    if (devs.length > 0) {
                        devs.forEach(d => {
                            const opt = document.createElement('option');
                            const id = d.ID || 'dongle0';
                            opt.value = id;
                            opt.textContent = `${id} (${d.Number && d.Number !== 'Unknown' ? d.Number : 'No SIM'})`;
                            if (selectedDongleId && selectedDongleId.toLowerCase() === id.toLowerCase()) {
                                opt.selected = true;
                            } else if (activeThread && activeThread.dongleId && activeThread.dongleId.toLowerCase() === id.toLowerCase()) {
                                opt.selected = true;
                            }
                            replyDongleSelect.appendChild(opt);
                        });
                    } else {
                        const fallbackId = (activeThread && activeThread.dongleId) || selectedDongleId || 'dongle0';
                        const opt = document.createElement('option');
                        opt.value = fallbackId;
                        opt.textContent = fallbackId;
                        opt.selected = true;
                        replyDongleSelect.appendChild(opt);
                    }
                    isSyncingSelect = true;
                    replyDongleSelect.dispatchEvent(new Event('change', { bubbles: true }));
                    isSyncingSelect = false;
                }

                renderSmsThreads();
                renderChatMessages();

                const input = document.getElementById('sms-composer-input');
                if (shouldFocus && input && window.innerWidth >= 640) {
                    input.focus({ preventScroll: true });
                }
            };

            window.backToThreadList = function() {
                const chatPane = document.getElementById('sms-chat-pane');
                const threadsPane = document.getElementById('sms-threads-pane');
                if (chatPane) {
                    chatPane.classList.add('hidden');
                    chatPane.classList.remove('flex');
                }
                if (threadsPane) {
                    threadsPane.classList.remove('hidden');
                }
            };

            function renderChatMessages() {
                const stream = document.getElementById('sms-messages-stream');
                if (!stream) return;

                const numberEl = document.getElementById('sms-active-number');
                const nameEl = document.getElementById('sms-active-contact-name');
                const avatarEl = document.getElementById('sms-active-avatar');

                if (!activeThreadEndpoint) {
                    stream.innerHTML = `<div class="text-center py-16 text-zinc-500 text-xs italic" id="sms-no-thread-selected">${isRtl ? 'اختر محادثة لعرض سجل الرسائل' : 'Select a conversation to view chat history'}</div>`;
                    if (numberEl) numberEl.textContent = '-';
                    if (nameEl) nameEl.textContent = '';
                    if (avatarEl) avatarEl.textContent = '#';
                    return;
                }

                const threads = groupSmsIntoThreads(allSmsMessages, selectedDongleId);
                const activeThread = threads.find(t => t.endpoint === activeThreadEndpoint);
                const messages = activeThread ? activeThread.messages : [];
                if (messages.length === 0) {
                    stream.innerHTML = `<div class="text-center py-16 text-zinc-500 text-xs italic">${isRtl ? 'لا توجد رسائل سابقة في هذه المحادثة. يمكنك إرسال رسالة الآن.' : 'No messages in this thread yet. Send a message to start chatting.'}</div>`;
                    return;
                }

                let html = '';
                let lastDateHeader = '';

                messages.forEach(msg => {
                    const msgDate = new Date(msg.timestamp || Date.now());
                    const dateHeader = msgDate.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });

                    if (dateHeader !== lastDateHeader) {
                        lastDateHeader = dateHeader;
                        html += `
                            <div class="flex items-center justify-center my-3">
                                <span class="px-2.5 py-0.5 rounded-full bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-muted)] text-[10px] font-mono shadow-xs">${escapeHtml(dateHeader)}</span>
                            </div>`;
                    }

                    const isOut = msg.direction === 'outgoing';
                    const timeStr = msgDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

                    if (isOut) {
                        html += `
                            <div class="flex justify-end select-text">
                                <div class="max-w-[85%] sm:max-w-[75%] rounded-2xl rounded-te-xs bg-[var(--accent-color)] text-white p-3 shadow-md flex flex-col gap-1 text-start" dir="auto">
                                    <p class="text-xs leading-relaxed whitespace-pre-wrap font-sans break-words text-start" dir="auto">${escapeHtml(msg.content)}</p>
                                    <div class="flex items-center justify-end gap-1 text-[9px] font-mono text-white/80">
                                        <span>${escapeHtml(timeStr)}</span>
                                        <span title="Sent">✓</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    } else {
                        html += `
                            <div class="flex justify-start select-text">
                                <div class="max-w-[85%] sm:max-w-[75%] rounded-2xl rounded-ts-xs bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-primary)] p-3 shadow-sm flex flex-col gap-1 text-start" dir="auto">
                                    <p class="text-xs leading-relaxed whitespace-pre-wrap font-sans break-words text-[var(--text-primary)] text-start" dir="auto">${escapeHtml(msg.content)}</p>
                                    <div class="flex items-center justify-start gap-1.5 text-[9px] font-mono text-[var(--text-muted)] mt-0.5">
                                        <span class="px-1 py-0.5 rounded bg-[var(--bg-hover)] border border-[var(--border-primary)] text-[var(--text-muted)] text-[8px] uppercase font-mono">${escapeHtml(msg.dongleId || 'dongle')}</span>
                                        <span>${escapeHtml(timeStr)}</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    }
                });

                stream.innerHTML = html;
                stream.scrollTop = stream.scrollHeight;
            }

            window.handleQuickSmsSubmit = async function(event) {
                if (event) event.preventDefault();
                const input = document.getElementById('sms-composer-input');
                const sendBtn = document.getElementById('sms-composer-send-btn');
                const dongleSelect = document.getElementById('sms-reply-dongle');
                if (!input || !activeThreadEndpoint) return;

                const message = input.value.trim();
                if (!message) return;

                const targetDongle = (dongleSelect && dongleSelect.value) ? dongleSelect.value : (selectedDongleId || 'dongle0');
                if (sendBtn) sendBtn.disabled = true;

                try {
                    const res = await fetch('/api/gsm-dongles/send-sms', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            dongleId: targetDongle,
                            to: activeThreadEndpoint,
                            message: message
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        input.value = '';
                        const counter = document.getElementById('sms-composer-counter');
                        if (counter) counter.textContent = '0/160';
                        showToast(isRtl ? 'تم الإرسال' : 'Sent', isRtl ? 'تم إرسال الرسالة بنجاح' : 'SMS sent successfully', 'success');
                    } else {
                        showToast(isRtl ? 'فشل الإرسال' : 'Send Failed', data.error || 'Failed to send SMS', 'error');
                    }
                } catch (err) {
                    showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error');
                } finally {
                    if (sendBtn) sendBtn.disabled = false;
                }
            };

            window.startNewChatPrompt = function() {
                const num = prompt(isRtl ? 'أدخل رقم هاتف المحادثة (مثال: +201012345678 أو 01012345678):' : 'Enter phone number (e.g. +201012345678 or 01012345678):');
                if (!num || !num.trim()) return;
                const clean = normalizePhoneEndpoint(num);
                if (clean.length < 3) {
                    alert(isRtl ? 'رقم الهاتف غير صالح' : 'Invalid phone number');
                    return;
                }
                selectSmsThread(clean);
            };

            window.deleteActiveThread = async function() {
                if (!activeThreadEndpoint) return;
                if (!confirm(isRtl ? 'هل أنت متأكد من حذف هذه المحادثة؟' : 'Are you sure you want to delete this conversation thread?')) return;

                try {
                    const res = await fetch('/api/gsm-dongles/delete-thread', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            endpoint: activeThreadEndpoint,
                            dongleId: selectedDongleId || 'all'
                        })
                    });
                    const data = await res.json();
                    if (data.success) {
                        allSmsMessages = allSmsMessages.filter(m => normalizePhoneEndpoint(m.endpoint || m.sender || m.recipient) !== activeThreadEndpoint);
                        activeThreadEndpoint = null;
                        renderSmsThreads();
                        renderChatMessages();
                        showToast(isRtl ? 'تم الحذف' : 'Deleted', isRtl ? 'تم حذف المحادثة بنجاح' : 'Thread deleted successfully', 'success');
                    } else {
                        showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Failed to delete thread', 'error');
                    }
                } catch (err) {
                    showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error');
                }
            };

            window.handleSmsSearch = function(val) {
                smsSearchQuery = String(val || '');
                renderSmsThreads();
            };

            window.handleComposerKeydown = function(e) {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    handleQuickSmsSubmit();
                }
            };

            window.handleComposerInput = function(textarea) {
                const len = textarea.value.length;
                const isUnicode = /[^\u0000-\u007F]/.test(textarea.value);
                const limit = isUnicode ? 70 : 160;
                const counter = document.getElementById('sms-composer-counter');
                if (counter) {
                    counter.textContent = `${len}/${limit}${isUnicode ? ' (Unicode)' : ''}`;
                }
            };

            window.copyActiveNumber = function() {
                if (!activeThreadEndpoint) return;
                navigator.clipboard.writeText(activeThreadEndpoint);
                showToast(isRtl ? 'تم النسخ' : 'Copied', activeThreadEndpoint, 'info');
            };

            function filterAndRenderSms() {
                renderSmsThreads();
                renderChatMessages();
            }

            window.loadSmsInbox = async function() {
                try {
                    const res = await fetch('/api/gsm-dongles/sms');
                    const data = await res.json();
                    if (data.success && data.sms) {
                        allSmsMessages = data.sms;
                    } else {
                        allSmsMessages = [];
                    }
                    renderSmsThreads();
                    renderChatMessages();
                } catch (e) {
                    console.error("Failed to load SMS inbox:", e);
                }
            };

            window.clearSmsInbox = async function() {
                if (!confirm(isRtl ? 'هل أنت متأكد من مسح صندوق الرسائل؟' : 'Are you sure you want to clear the SMS inbox?')) return;
                try {
                    await fetch('/api/gsm-dongles/clear-sms', { method: 'POST' });
                } catch (e) {
                    console.error("Failed to clear SMS inbox:", e);
                }
            };

            // Real-time SMS receivers
            if (socket) {
                socket.on('newSms', (sms) => {
                    allSmsMessages.unshift(sms);
                    showSmsToast(sms);
                    renderSmsThreads();
                    const msgEndpoint = normalizePhoneEndpoint(sms.endpoint || sms.sender || sms.recipient);
                    if (activeThreadEndpoint && msgEndpoint === activeThreadEndpoint) {
                        renderChatMessages();
                    }
                });

                socket.on('smsCleared', () => {
                    allSmsMessages = [];
                    activeThreadEndpoint = null;
                    renderSmsThreads();
                    renderChatMessages();
                });

                socket.on('smsThreadDeleted', (data) => {
                    const ep = normalizePhoneEndpoint(data.endpoint);
                    allSmsMessages = allSmsMessages.filter(m => normalizePhoneEndpoint(m.endpoint || m.sender || m.recipient) !== ep);
                    if (activeThreadEndpoint === ep) activeThreadEndpoint = null;
                    renderSmsThreads();
                    renderChatMessages();
                });
            }

            // Initial load
            loadSmsInbox();

            // --- USB TTY & LSUSB HARDWARE DEVICE LISTING ---
            const usbGrid = document.getElementById('usb-devices-grid');
            const lsusbGrid = document.getElementById('lsusb-devices-grid');
            const lsusbModemsCountEl = document.getElementById('lsusb-modems-count');
            const lsusbTtyCountEl = document.getElementById('lsusb-tty-count');

            let lastUsbSignature = null;
            let usbRefreshInFlight = false;
            let usbHasLoaded = false;
            const usbHtmlEntities = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            };

            function escapeUsbText(value) {
                return String(value ?? '').replace(/[&<>"']/g, character => usbHtmlEntities[character]);
            }

            function getUsbSignature(data) {
                return JSON.stringify({
                    modems: (data.physicalModems || []).map(m => `${m.bus}:${m.device}:${m.hardwareId}:${(m.ttyPorts||[]).join(',')}:${(m.boundSlots||[]).join(',')}`),
                    devices: (data.devices || data.ttyDevices || []).map(d => `${d.name}:${d.dongleId}:${d.portType}`)
                });
            }

            function renderLsusbDevices(physicalModems) {
                if (!lsusbGrid) return;
                if (!Array.isArray(physicalModems) || physicalModems.length === 0) {
                    lsusbGrid.innerHTML = `
                        <div class="col-span-full flex flex-col items-center justify-center py-6 gap-2 bg-[var(--bg-card)] rounded-xl border border-[var(--border-primary)]">
                            <svg class="text-zinc-500" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            <span class="text-sm font-bold text-zinc-400">${escapeUsbText(words.lsusbNone || 'No physical USB modems detected')}</span>
                            <span class="text-[10px] text-zinc-500 max-w-xs text-center">${escapeUsbText(words.lsusbNoneHint || 'Check physical USB connections or run lsusb in terminal')}</span>
                        </div>`;
                    return;
                }

                lsusbGrid.innerHTML = physicalModems.map(modem => {
                    const boundSlotsText = (modem.boundSlots && modem.boundSlots.length)
                        ? modem.boundSlots.join(', ')
                        : (words.lsusbUnassigned || 'Unassigned');
                    const isBound = Boolean(modem.boundSlots && modem.boundSlots.length);

                    const ttyPills = (modem.ttyPorts && modem.ttyPorts.length > 0)
                        ? modem.ttyPorts.map(p => `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-black text-emerald-200 bg-emerald-900/60 hover:bg-emerald-900/80 border border-emerald-400/50 shadow-xs transition-colors">${escapeUsbText(p)}</span>`).join('')
                        : `<span class="text-[10px] text-amber-400 font-mono font-bold">${isRtl ? 'لا توجد منافذ TTY' : 'No TTY ports'}</span>`;

                    return `
                        <div class="flex flex-col gap-2.5 p-3.5 rounded-xl border border-purple-500/30 bg-purple-950/20 transition hover:border-purple-400/60 shadow-sm">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2 min-w-0">
                                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0 shadow-xs"></span>
                                    <span class="font-black text-xs text-[var(--text-primary)] truncate">${escapeUsbText(modem.vendorName || '')} ${escapeUsbText(modem.modelName || 'GSM Modem')}</span>
                                </div>
                                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-black text-black bg-purple-300 border border-purple-400 shrink-0">${escapeUsbText(modem.hardwareId)}</span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 text-[10px] font-mono pt-2 border-t border-purple-500/20">
                                <div class="flex items-center gap-1.5 text-[var(--text-muted)]">
                                    <svg class="w-3 h-3 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                    <span>Bus ${escapeUsbText(modem.bus)} • Dev ${escapeUsbText(modem.device)}</span>
                                </div>
                                <div class="flex items-center gap-1 text-right rtl:text-left justify-end">
                                    <span class="text-[var(--text-muted)]">${escapeUsbText(words.lsusbBoundSlot || 'Slot')}:</span>
                                    <span class="font-black ${isBound ? 'text-emerald-400' : 'text-amber-400'}">${escapeUsbText(boundSlotsText)}</span>
                                </div>
                            </div>

                            <div class="flex items-center gap-1.5 flex-wrap pt-1 border-t border-white/5">
                                <span class="text-[9px] text-[var(--text-muted)] font-mono">${escapeUsbText(words.lsusbBoundPorts || 'Ports')}:</span>
                                ${ttyPills}
                            </div>
                        </div>`;
                }).join('');
            }

            function renderUsbDevices(devices) {
                if (!usbGrid) return;
                if (devices.length === 0) {
                    usbGrid.innerHTML = `
                        <div class="col-span-full flex flex-col items-center justify-center py-6 gap-2">
                            <svg class="text-zinc-600" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            <span class="text-sm font-bold text-zinc-500">${words.usbNone}</span>
                            <span class="text-[10px] text-zinc-600 max-w-xs text-center">${words.usbNoneHint}</span>
                        </div>`;
                    return;
                }

                usbGrid.innerHTML = devices.map(device => {
                    const mapped = Boolean(device.dongleId);
                    const matchBorder = mapped
                        ? 'border-emerald-500/40 bg-emerald-950/15'
                        : 'border-[var(--border-primary)] bg-[var(--bg-card)]';
                    const matchIcon = mapped
                        ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
                        : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#71717a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
                    const label = mapped
                        ? `${device.dongleId} (${device.portType || ''})`
                        : words.usbUnmapped;

                    return `
                        <div class="flex flex-col items-center gap-2 p-3 rounded-xl border ${matchBorder} transition hover:border-[var(--accent-color)]/40 cursor-default">
                            <div class="flex items-center gap-1.5">
                                ${matchIcon}
                                <span class="font-mono text-sm font-bold text-[var(--text-primary)]">${escapeUsbText(device.name)}</span>
                            </div>
                            <span class="text-[9px] font-bold uppercase tracking-wider ${mapped ? 'text-emerald-400' : 'text-zinc-500'}">${escapeUsbText(label)}</span>
                        </div>`;
                }).join('');
            }

            window.refreshUsbDevices = async function() {
                if (usbRefreshInFlight) return;
                usbRefreshInFlight = true;

                if (!usbHasLoaded) {
                    if (usbGrid) usbGrid.innerHTML = '<div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading...</div>';
                    if (lsusbGrid) lsusbGrid.innerHTML = '<div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading physical hardware...</div>';
                }

                try {
                    const response = await fetch('/api/gsm-dongles/ttyusb-devices', { cache: 'no-store' });
                    const data = await response.json();
                    if (!response.ok || !data.success) {
                        throw new Error(data.error || 'Failed to fetch USB devices');
                    }

                    const devices = Array.isArray(data.devices) ? data.devices : (Array.isArray(data.ttyDevices) ? data.ttyDevices : []);
                    const physicalModems = Array.isArray(data.physicalModems) ? data.physicalModems : [];

                    if (lsusbModemsCountEl) {
                        lsusbModemsCountEl.textContent = `${physicalModems.length} ${words.lsusbModemsBadge || 'Modems (lsusb)'}`;
                    }
                    if (lsusbTtyCountEl) {
                        lsusbTtyCountEl.textContent = `${devices.length} ${words.lsusbTtyBadge || 'TTY Ports Active'}`;
                    }

                    const signature = getUsbSignature(data);
                    if (signature !== lastUsbSignature) {
                        lastUsbSignature = signature;
                        renderLsusbDevices(physicalModems);
                        renderUsbDevices(devices);
                    }
                    usbHasLoaded = true;
                } catch (error) {
                    console.error('Failed to refresh USB devices:', error);
                    if (!usbHasLoaded) {
                        if (usbGrid) usbGrid.innerHTML = '<div class="text-red-400 text-xs text-center col-span-full py-4">' + (isRtl ? 'فشل في جلب البيانات' : 'Failed to fetch') + '</div>';
                        if (lsusbGrid) lsusbGrid.innerHTML = '<div class="text-red-400 text-xs text-center col-span-full py-4">' + (isRtl ? 'فشل في جلب البيانات' : 'Failed to fetch') + '</div>';
                        usbHasLoaded = true;
                    }
                } finally {
                    usbRefreshInFlight = false;
                }
            };
            if (socket) {
                socket.on('dongleLog', (line) => {
                    if (!logsToggle.checked) return;
                    
                    const lineEl = document.createElement('div');
                    lineEl.className = 'py-0.5 border-b border-zinc-950/20';
                    
                    if (line.includes('ERROR') || line.includes('WARNING') || line.includes('Failed')) {
                        lineEl.className += ' text-rose-500';
                    } else if (line.includes('NOTICE') || line.includes('Got USSD')) {
                        lineEl.className += ' text-emerald-400 font-bold';
                    } else {
                        lineEl.className += ' text-zinc-500';
                    }
                    
                    lineEl.textContent = line;
                    logScreen.appendChild(lineEl);
                    
                    if (logsAutoscroll.checked) {
                        logScreen.scrollTop = logScreen.scrollHeight;
                    }
                });
            }
            // Initial load, then one-second checks without clearing unchanged content
            refreshUsbDevices();
            setInterval(refreshUsbDevices, 1000);

            clearLogsBtn.addEventListener('click', function() {
                logScreen.innerHTML = '<div class="text-zinc-600">[System] Log screen cleared. Awaiting hardware events...</div>';
            });

            // Toggle logs console container visibility
            logsToggle.addEventListener('change', () => {
                logScreen.classList.toggle('hidden', !logsToggle.checked);
            });

            // Copy to clipboard utility with green checkmark feedback (supports non-secure HTTP local IP fallback)
            window.copyToClipboard = function(text, btn) {
                const clean = String(text || '').trim();
                if (!clean || clean === '-' || clean === 'Unknown') return;
                
                function fallbackCopy(val) {
                    const textArea = document.createElement("textarea");
                    textArea.value = val;
                    textArea.style.top = "0";
                    textArea.style.left = "0";
                    textArea.style.position = "fixed";
                    textArea.style.opacity = "0";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        showFeedback();
                    } catch (err) {
                        console.error('Fallback copy failed: ', err);
                    }
                    document.body.removeChild(textArea);
                }

                function showFeedback() {
                    if (btn) {
                        const originalHTML = btn.innerHTML;
                        btn.innerHTML = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
                        btn.style.pointerEvents = 'none';
                        setTimeout(() => {
                            btn.innerHTML = originalHTML;
                            btn.style.pointerEvents = 'auto';
                        }, 1500);
                    }
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(clean).then(showFeedback).catch(() => {
                        fallbackCopy(clean);
                    });
                } else {
                    fallbackCopy(clean);
                }
            };

            // --- ROOT AT DIAGNOSTICS CLIENT LOGIC ---
            let activeAtDiagDongleId = '';
            const atDiagModal = document.getElementById('at-diag-modal');
            const atDiagModalCard = document.getElementById('at-diag-modal-card');
            const atDiagTargetBadge = document.getElementById('at-diag-target-badge');
            const atDiagInput = document.getElementById('at-diag-input');
            const atDiagLoading = document.getElementById('at-diag-loading');
            const atDiagResultSection = document.getElementById('at-diag-result-section');
            const atDiagExplanationCard = document.getElementById('at-diag-explanation-card');
            const atDiagBadge = document.getElementById('at-diag-badge');
            const atDiagSummary = document.getElementById('at-diag-summary');
            const atDiagDetails = document.getElementById('at-diag-details');
            const atDiagRecommendation = document.getElementById('at-diag-recommendation');
            const atDiagRecommendationBox = document.getElementById('at-diag-recommendation-box');
            const atDiagCmdExecuted = document.getElementById('at-diag-cmd-executed');
            const atDiagRawOutput = document.getElementById('at-diag-raw-output');
            const atDiagSubmitBtn = document.getElementById('at-diag-submit-btn');

            window.openAtDiagConsole = function(dongleId) {
                if (!isRootUser) return;
                activeAtDiagDongleId = String(dongleId || '').toLowerCase().trim();
                if (atDiagTargetBadge) atDiagTargetBadge.textContent = activeAtDiagDongleId;
                if (atDiagModal && atDiagModalCard) {
                    atDiagModal.classList.remove('opacity-0', 'pointer-events-none');
                    atDiagModalCard.classList.remove('scale-95', 'opacity-0');
                    atDiagModalCard.classList.add('scale-100', 'opacity-100');
                }
                if (atDiagInput) {
                    atDiagInput.value = '';
                    setTimeout(() => atDiagInput.focus(), 100);
                }
            };

            window.closeAtDiagModal = function() {
                if (atDiagModal && atDiagModalCard) {
                    atDiagModal.classList.add('opacity-0', 'pointer-events-none');
                    atDiagModalCard.classList.remove('scale-100', 'opacity-100');
                    atDiagModalCard.classList.add('scale-95', 'opacity-0');
                }
            };

            if (atDiagModal) {
                atDiagModal.addEventListener('click', (e) => {
                    if (e.target === atDiagModal) closeAtDiagModal();
                });
            }

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && atDiagModal && !atDiagModal.classList.contains('opacity-0')) {
                    closeAtDiagModal();
                }
            });

            window.runAtDiag = function(dongleId, command) {
                if (!isRootUser) return;
                activeAtDiagDongleId = String(dongleId || '').toLowerCase().trim();
                openAtDiagConsole(activeAtDiagDongleId);
                executeAtDiag(command);
            };

            window.executeAtDiag = function(command) {
                if (!isRootUser || !activeAtDiagDongleId) return;
                const cmd = String(command || '').trim();
                if (!cmd) return;

                if (atDiagInput) atDiagInput.value = cmd;
                if (atDiagLoading) atDiagLoading.classList.remove('hidden');
                if (atDiagResultSection) atDiagResultSection.classList.add('hidden');
                if (atDiagSubmitBtn) atDiagSubmitBtn.disabled = true;

                fetch(`/api/gsm-dongles/at-diagnostic/${encodeURIComponent(activeAtDiagDongleId)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command: cmd })
                })
                .then(res => res.json())
                .then(data => {
                    if (atDiagLoading) atDiagLoading.classList.add('hidden');
                    if (atDiagSubmitBtn) atDiagSubmitBtn.disabled = false;

                    if (!data.success) {
                        showToast(activeAtDiagDongleId, data.error || 'Diagnostic command failed', 'error');
                        return;
                    }

                    renderAtDiagResult(data);
                })
                .catch(err => {
                    if (atDiagLoading) atDiagLoading.classList.add('hidden');
                    if (atDiagSubmitBtn) atDiagSubmitBtn.disabled = false;
                    showToast(activeAtDiagDongleId, 'Network error executing AT diagnostic: ' + err.message, 'error');
                });
            };

            window.handleCustomAtSubmit = function(e) {
                e.preventDefault();
                const cmd = atDiagInput ? atDiagInput.value.trim() : '';
                if (cmd) executeAtDiag(cmd);
            };

            function renderAtDiagResult(data) {
                if (!atDiagResultSection) return;
                const exp = data.explanation || {};
                const sev = exp.severity || 'info';

                // Card border & background
                if (atDiagExplanationCard) {
                    if (sev === 'success') {
                        atDiagExplanationCard.className = 'p-4 sm:p-5 rounded-2xl border bg-emerald-500/15 border-emerald-500/40 text-[var(--text-primary)] shadow-sm';
                    } else if (sev === 'danger') {
                        atDiagExplanationCard.className = 'p-4 sm:p-5 rounded-2xl border bg-rose-500/15 border-rose-500/40 text-[var(--text-primary)] shadow-sm';
                    } else if (sev === 'warning') {
                        atDiagExplanationCard.className = 'p-4 sm:p-5 rounded-2xl border bg-amber-500/15 border-amber-500/40 text-[var(--text-primary)] shadow-sm';
                    } else {
                        atDiagExplanationCard.className = 'p-4 sm:p-5 rounded-2xl border bg-sky-500/15 border-sky-500/40 text-[var(--text-primary)] shadow-sm';
                    }
                }

                // Badge
                if (atDiagBadge) {
                    atDiagBadge.textContent = exp.badge || data.command;
                    if (sev === 'success') {
                        atDiagBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wide bg-emerald-500/25 text-black border border-emerald-500/50 shadow-sm';
                    } else if (sev === 'danger') {
                        atDiagBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wide bg-rose-500/25 text-black border border-rose-500/50 shadow-sm';
                    } else if (sev === 'warning') {
                        atDiagBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wide bg-amber-500/25 text-black border border-amber-500/50 shadow-sm';
                    } else {
                        atDiagBadge.className = 'px-3 py-1 rounded-full text-xs font-black tracking-wide bg-sky-500/25 text-black border border-sky-500/50 shadow-sm';
                    }
                }
                // Summary
                if (atDiagSummary) atDiagSummary.textContent = exp.summary || '';

                // Details
                if (atDiagDetails) {
                    atDiagDetails.innerHTML = '';
                    const details = Array.isArray(exp.details) ? exp.details : [exp.details].filter(Boolean);
                    details.forEach(d => {
                        const li = document.createElement('li');
                        li.className = 'text-xs sm:text-sm text-[var(--text-primary)] font-semibold leading-relaxed';
                        li.textContent = d;
                        atDiagDetails.appendChild(li);
                    });
                }

                // Recommendation
                if (atDiagRecommendationBox && atDiagRecommendation) {
                    if (exp.recommendation) {
                        atDiagRecommendation.textContent = exp.recommendation;
                        atDiagRecommendationBox.classList.remove('hidden');
                        if (sev === 'danger') {
                            atDiagRecommendationBox.className = 'p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-rose-500/20 border border-rose-500/40 text-black font-black';
                        } else if (sev === 'warning') {
                            atDiagRecommendationBox.className = 'p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-amber-500/20 border border-amber-500/40 text-black font-black';
                        } else if (sev === 'success') {
                            atDiagRecommendationBox.className = 'p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-emerald-500/20 border border-emerald-500/40 text-black font-black';
                        } else {
                            atDiagRecommendationBox.className = 'p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 bg-sky-500/20 border border-sky-500/40 text-black font-black';
                        }
                    } else {
                        atDiagRecommendationBox.classList.add('hidden');
                    }
                }
                // Raw Command and Output
                if (atDiagCmdExecuted) atDiagCmdExecuted.textContent = data.command;
                if (atDiagRawOutput) atDiagRawOutput.textContent = data.rawOutput || '(No response text)';

                atDiagResultSection.classList.remove('hidden');
            }

            window.copyAtDiagOutput = function() {
                if (!atDiagRawOutput) return;
                const text = atDiagRawOutput.textContent;
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(() => {
                        showToast(activeAtDiagDongleId || 'Modem', 'AT output copied to clipboard', 'success');
                    });
                }
            };

            // Edit SIM phone number mapping action
            window.editSimNumber = function(dongleId, imsi, currentVal) {
                if ((!currentVal || currentVal === 'Unknown' || currentVal === '-') && dongleId) {
                    const el = document.getElementById('display-num-' + dongleId);
                    if (el && el.textContent && !el.textContent.includes('Unknown') && !el.textContent.includes('-')) {
                        currentVal = el.textContent.trim();
                    }
                }
                const promptMsg = isRtl 
                    ? `أدخل رقم الهاتف الجديد للشريحة (IMSI: ${imsi}):` 
                    : `Enter phone number for SIM card (IMSI: ${imsi}):`;
                
                const newNum = prompt(promptMsg, currentVal || '');
                if (newNum === null) return;
                const trimmed = newNum.trim().replace(/\s+/g, '');
                if (!trimmed) return;

                // Removed 11-digit restriction to accept any entered SIM phone number string verbatim
                
                const displaySpan = document.getElementById('display-num-' + dongleId);
                if (displaySpan) displaySpan.innerHTML = '<span class="text-zinc-500 italic">Saving...</span>';
                
                showToast(dongleId, isRtl ? 'جاري حفظ الرقم...' : 'Saving number and sending AT commands...', 'info');
                
                fetch('/api/gsm-dongles/save-number', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imsi, number: trimmed, dongleId })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.results) {
                        let details = data.results.map(function(r) {
                            const status = r.error ? '❌' : '✅';
                            return status + ' ' + r.step + (r.error ? ': ' + r.error : '');
                        }).join('\n');
                        const isAtSuccess = data.atSuccess !== false && !data.results.some(r => r.error);
                        const toastTitle = dongleId + ' - ' + (isAtSuccess
                            ? (isRtl ? 'تم الحفظ في الشريحة واللوحة' : 'Saved to SIM Card & Dashboard')
                            : (isRtl ? 'تم الحفظ في اللوحة (تحذير أستريسك)' : 'Saved to Dashboard (Asterisk Warning)'));
                        showToast(toastTitle, details, isAtSuccess ? 'success' : 'warning');
                    } else if (data.success) {
                        showToast(dongleId, isRtl ? 'تم الحفظ في اللوحة' : 'Saved to Dashboard', 'success');
                    } else {
                        showToast(dongleId, (isRtl ? 'فشل الحفظ: ' : 'Failed: ') + (data.error || 'Unknown error'), 'error');
                    }
                    refreshDevicesList();
                })
                .catch(err => {
                    console.error("Error saving SIM number:", err);
                    showToast(dongleId, isRtl ? 'خطأ في الاتصال' : 'Connection error', 'error');
                    refreshDevicesList();
                });
            };

            // Reload single dongle action
            // 1. Reload / Restart single dongle action
            window.reloadDongle = function(id) {
                if (!confirm((isRtl ? 'هل أنت متأكد من إعادة تشغيل الشريحة ' : 'Are you sure you want to restart ') + id + '?')) return;
                const btn = document.getElementById('reloadBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة تشغيل' : 'Restarting', (isRtl ? 'جاري إعادة تشغيل الشريحة ' : 'Restarting dongle ') + id + '...', 'info');

                fetch('/api/gsm-dongles/reload/' + id, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', words.reloadedSuccess + ' (' + id + ')', 'success');
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Unknown server error', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            // 2. Reboot modem firmware via AT command (AT+CFUN=1,1)
            window.rebootModem = function(id) {
                if (!confirm((isRtl ? 'هل أنت متأكد من إعادة تشغيل مودم الجهاز ' : 'Are you sure you want to reboot modem ') + id + '?')) return;
                const btn = document.getElementById('rebootBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة تشغيل المودم' : 'Modem Reboot', (isRtl ? 'جاري إرسال أمر إعادة تشغيل المودم ' : 'Sending modem reboot command to ') + id + '...', 'warning');

                fetch('/api/gsm-dongles/reboot-modem/' + id, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (isRtl ? 'تم إرسال أمر إعادة تشغيل المودم لـ ' : 'Modem reboot command sent to ') + id, 'success');
                            setTimeout(refreshDevicesList, 3000);
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Modem reboot failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            // 3. Virtual USB Unplug & Re-plug (Kernel sysfs unbind/bind)
            window.virtualReplug = function(id) {
                if (!confirm((isRtl ? 'هل أنت متأكد من محاكاة إعادة توصيل USB لـ ' : 'Are you sure you want to simulate virtual USB re-plug for ') + id + '?')) return;
                const btn = document.getElementById('virtualReplugBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة توصيل USB' : 'Virtual USB Re-plug', (isRtl ? 'جاري فصل وإعادة توصيل USB لـ ' : 'Simulating virtual USB re-plug for ') + id + '...', 'warning');

                fetch('/api/gsm-dongles/virtual-replug/' + id, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (isRtl ? 'تمت محاكاة إعادة توصيل USB بنجاح لـ ' : 'Virtual USB re-plug executed for ') + id, 'success');
                            setTimeout(refreshDevicesList, 4000);
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Virtual re-plug failed', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            // 4. Populate IMEI & IMSI in /etc/asterisk/dongle.conf
            window.populateDongleHardware = function(id, imei, imsi) {
                const cleanImei = String(imei || '').trim();
                const cleanImsi = String(imsi || '').trim();
                if (!cleanImei || cleanImei === '-' || cleanImei === 'Unknown' || !cleanImsi || cleanImsi === '-' || cleanImsi === 'Unknown') {
                    showToast(isRtl ? 'تنبيه' : 'Notice', isRtl ? 'معرفات الجهاز (IMEI / IMSI) غير مكتشفة بعد لهذه الشريحة' : 'Hardware identifiers (IMEI / IMSI) are not detected for this dongle yet', 'warning');
                    return;
                }

                const confirmMsg = `${words.populateHardwareConfirm || (isRtl ? 'هل تريد حفظ كود IMEI و IMSI في ملف dongle.conf للشريحة ' : 'Do you want to populate IMEI and IMSI in dongle.conf for ')}${id}?\n\nIMEI: ${cleanImei}\nIMSI: ${cleanImsi}`;
                if (!confirm(confirmMsg)) return;

                const btn = document.getElementById('populateBtn-' + id);
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'تثبيت المعرفات' : 'Populating Hardware IDs', (isRtl ? 'جاري حفظ IMEI و IMSI في dongle.conf لـ ' : 'Writing IMEI & IMSI to dongle.conf for ') + id + '...', 'info');

                fetch('/api/gsm-dongles/populate-hardware/' + encodeURIComponent(id), {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ imei: cleanImei, imsi: cleanImsi })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showToast(isRtl ? 'نجاح' : 'Success', (words.populateHardwareSuccess || (isRtl ? 'تم حفظ كود IMEI و IMSI بنجاح' : 'Populated IMEI and IMSI in dongle.conf successfully')) + ' (' + id + ')', 'success');
                            refreshDevicesList();
                        } else {
                            showToast(isRtl ? 'خطأ' : 'Error', data.error || 'Failed to populate hardware IDs', 'error');
                        }
                    })
                    .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                    .finally(() => { if (btn) btn.disabled = false; });
            };

            window.toggleLegendBlock = function() {
                const block = document.getElementById('legend-content-block');
                const text = document.getElementById('legend-toggle-text');
                const icon = document.getElementById('legend-toggle-icon');
                if (!block) return;

                const isHidden = block.classList.contains('hidden');
                if (isHidden) {
                    block.classList.remove('hidden');
                    if (text) text.textContent = isRtl ? 'إخفاء الدليل' : 'Hide Guide';
                    if (icon) icon.classList.add('rotate-180');
                } else {
                    block.classList.add('hidden');
                    if (text) text.textContent = isRtl ? 'عرض الدليل' : 'Show Guide';
                    if (icon) icon.classList.remove('rotate-180');
                }
            };
            window.setUssdPreset = function(code) {
                const input = document.getElementById('ussd-code-input');
                if (!input) return;
                input.value = code;
                input.focus();
            };

            window.clearUssdTerminal = function() {
                const terminalScreen = document.getElementById('terminal-screen');
                if (!terminalScreen) return;
                terminalScreen.innerHTML = `
                    <div class="font-mono text-xs select-none p-3.5 rounded-lg border" id="terminal-placeholder">
                        ${words.terminalPlaceholder}
                    </div>`;
            };

            window.copyUssdTerminal = function() {
                const terminalScreen = document.getElementById('terminal-screen');
                if (!terminalScreen) return;
                const text = terminalScreen.innerText;
                if (!text) return;
                navigator.clipboard.writeText(text).then(() => {
                    showToast(isRtl ? 'تم النسخ' : 'Copied', isRtl ? 'تم نسخ استجابات الشاشة إلى الحافظة' : 'Terminal output copied to clipboard', 'success');
                }).catch(err => {
                    showToast(isRtl ? 'خطأ' : 'Error', 'Failed to copy output', 'error');
                });
            };
            // Send USSD request action
            ussdForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const target = ussdTarget.value;
                const code = ussdInput.value;
                
                if (!target || !code) return;
                
                btnLabel.textContent = words.sending;
                btnSpinner.classList.remove('hidden');
                ussdSubmitBtn.disabled = true;
                
                const placeholderEl = document.getElementById('terminal-placeholder');
                if (placeholderEl && placeholderEl.parentNode) {
                    placeholderEl.parentNode.removeChild(placeholderEl);
                }
                
                const cmdLine = document.createElement('div');
                cmdLine.className = 'ussd-cmd-line mt-2 pt-2 text-xs font-mono';
                cmdLine.textContent = `[${new Date().toLocaleTimeString()}] > exec-ussd -d ${target} -c ${code}`;
                terminalScreen.appendChild(cmdLine);
                terminalScreen.scrollTop = terminalScreen.scrollHeight;

                fetch('/api/gsm-dongles/ussd', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongle: target, code: code })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        appendUssdResponse(data.logTime || new Date().toLocaleTimeString(), data.response, false);
                        showToast(target + ' (USSD / MMI)', data.response, 'success');
                    } else {
                        const respLine = document.createElement('div');
                        respLine.className = 'ussd-err-box font-bold p-2.5 rounded-lg border mt-1';
                        respLine.textContent = `[System Error] ${data.error || words.sendUssdError}`;
                        terminalScreen.scrollTop = terminalScreen.scrollHeight;
                        showToast(target + ' (Error)', data.error || words.sendUssdError, 'error');
                    }
                })
                .catch(err => {
                    const errorLine = document.createElement('div');
                    errorLine.className = 'ussd-err-box font-bold p-2.5 rounded-lg border mt-1';
                    errorLine.textContent = `[Network Error] ${err.message}`;
                    terminalScreen.appendChild(errorLine);
                    terminalScreen.scrollTop = terminalScreen.scrollHeight;
                })
                .finally(() => {
                    btnLabel.textContent = words.sendBtn;
                    btnSpinner.classList.add('hidden');
                    ussdSubmitBtn.disabled = false;
                });
            });
            // Console Tab Switcher Logic (USSD vs Call Forwarding)
            window.switchConsoleTab = function(tab) {
                const ussdForm = document.getElementById('ussd-execution-form');
                const cfForm = document.getElementById('forwarding-execution-form');
                const btnUssd = document.getElementById('tab-btn-ussd');
                const btnCf = document.getElementById('tab-btn-forwarding');
                const tabTitle = document.getElementById('console-tab-title');
                const tabIcon = document.getElementById('console-tab-icon');
                if (!ussdForm || !cfForm) return;

                if (tab === 'forwarding') {
                    ussdForm.classList.add('hidden');
                    cfForm.classList.remove('hidden');

                    if (btnUssd) {
                        btnUssd.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold transition-all cursor-pointer text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] border border-transparent flex items-center gap-1.5';
                    }
                    if (btnCf) {
                        btnCf.className = 'px-3 py-1.5 rounded-lg text-xs font-black transition-all cursor-pointer bg-emerald-600 text-white border border-emerald-400 shadow-md flex items-center gap-1.5';
                    }
                    if (tabTitle) tabTitle.textContent = words.callForwardingTitle || (isRtl ? 'تحويل المكالمات' : 'Call Forwarding');
                    if (tabIcon) {
                        tabIcon.className = 'flex items-center justify-center text-emerald-400 shrink-0';
                        tabIcon.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>';
                    }
                } else {
                    cfForm.classList.add('hidden');
                    ussdForm.classList.remove('hidden');

                    if (btnUssd) {
                        btnUssd.className = 'px-3 py-1.5 rounded-lg text-xs font-black transition-all cursor-pointer bg-indigo-600 text-white border border-indigo-400 shadow-md flex items-center gap-1.5';
                    }
                    if (btnCf) {
                        btnCf.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold transition-all cursor-pointer text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] border border-transparent flex items-center gap-1.5';
                    }
                    if (tabTitle) tabTitle.textContent = words.ussdTitle;
                    if (tabIcon) {
                        tabIcon.className = 'flex items-center justify-center text-indigo-400 shrink-0';
                        tabIcon.innerHTML = '<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>';
                    }
                }
            };

            window.openDongleCallForwarding = function(dongleId) {
                if (!dongleId) return;
                selectDevice(dongleId);
                const cfTarget = document.getElementById('cf-target-dongle');
                if (cfTarget) cfTarget.value = dongleId;
                switchConsoleTab('forwarding');
                const formEl = document.getElementById('forwarding-execution-form');
                if (formEl && formEl.scrollIntoView) {
                    formEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            };

            window.onCfScenarioChange = function() {
                const scenario = document.getElementById('cf-scenario').value;
                const delayContainer = document.getElementById('cf-delay-container');
                if (!delayContainer) return;
                if (scenario === '61' || scenario === '004') {
                    delayContainer.classList.remove('hidden');
                    delayContainer.classList.add('flex');
                } else {
                    delayContainer.classList.add('hidden');
                    delayContainer.classList.remove('flex');
                }
            };

            window.onCfActionChange = function() {
                const action = document.getElementById('cf-action').value;
                const numInput = document.getElementById('cf-number-input');
                const numContainer = document.getElementById('cf-number-container');
                if (!numInput) return;

                if (action === 'query' || action === 'cancel') {
                    numInput.required = false;
                    numInput.disabled = true;
                    numInput.placeholder = isRtl ? '(غير مطلوب لهذا الإجراء)' : '(Not required)';
                    if (numContainer) numContainer.classList.add('opacity-50');
                } else {
                    numInput.required = true;
                    numInput.disabled = false;
                    numInput.placeholder = '01011719380';
                    if (numContainer) numContainer.classList.remove('opacity-50');
                }
            };

            const forwardingForm = document.getElementById('forwarding-execution-form');
            if (forwardingForm) {
                forwardingForm.addEventListener('submit', (e) => {
                    e.preventDefault();
                    const targetEl = document.getElementById('cf-target-dongle');
                    const scenarioEl = document.getElementById('cf-scenario');
                    const actionEl = document.getElementById('cf-action');
                    const numberEl = document.getElementById('cf-number-input');
                    const delayEl = document.getElementById('cf-delay-select');
                    const submitBtn = document.getElementById('cf-submit-btn');
                    const btnLabel = document.getElementById('cf-btn-label');
                    const btnSpinner = document.getElementById('cf-btn-spinner');

                    const target = targetEl ? targetEl.value : '';
                    const scenario = scenarioEl ? scenarioEl.value : '21';
                    const action = actionEl ? actionEl.value : 'activate';
                    const number = numberEl ? numberEl.value.trim() : '';
                    const delay = delayEl ? delayEl.value : '20';

                    if (!target) {
                        showToast(isRtl ? 'خطأ' : 'Error', isRtl ? 'يرجى اختيار الشريحة المستهدفة' : 'Target dongle is required', 'error');
                        return;
                    }
                    if (action === 'activate' && !number) {
                        showToast(isRtl ? 'خطأ' : 'Error', isRtl ? 'يرجى إدخال رقم هاتف التحويل' : 'Forwarding phone number is required', 'error');
                        if (numberEl) numberEl.focus();
                        return;
                    }

                    if (btnLabel) btnLabel.textContent = words.cfExecuting || (isRtl ? 'جاري الإرسال...' : 'Executing...');
                    if (btnSpinner) btnSpinner.classList.remove('hidden');
                    if (submitBtn) submitBtn.disabled = true;

                    const placeholderEl = document.getElementById('terminal-placeholder');
                    if (placeholderEl && placeholderEl.parentNode) {
                        placeholderEl.parentNode.removeChild(placeholderEl);
                    }

                    const scenarioLabel = scenarioEl && scenarioEl.selectedIndex >= 0 ? scenarioEl.options[scenarioEl.selectedIndex].text : scenario;
                    const actionLabel = actionEl && actionEl.selectedIndex >= 0 ? actionEl.options[actionEl.selectedIndex].text : action;
                    const cmdLine = document.createElement('div');
                    cmdLine.className = 'ussd-cmd-line mt-2 pt-2 text-xs font-mono';
                    cmdLine.textContent = `[${new Date().toLocaleTimeString()}] > exec-forwarding -d ${target} -s ${scenario} (${scenarioLabel}) -a ${action} ${number ? ('-n ' + number) : ''}`;
                    terminalScreen.appendChild(cmdLine);
                    terminalScreen.scrollTop = terminalScreen.scrollHeight;

                    fetch('/api/gsm-dongles/call-forwarding', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            dongle: target,
                            scenario,
                            action,
                            number,
                            delay
                        })
                    })
                    .then(res => res.json())
                    .then(data => {
                        const toastTitle = words.callForwardingTitle || (isRtl ? 'تحويل المكالمات' : 'Call Forwarding');
                        if (data.success) {
                            appendUssdResponse(data.logTime || new Date().toLocaleTimeString(), data.message, false);
                            showToast(toastTitle + ' (' + target + ')', data.message, 'success');
                        } else {
                            const errText = data.error || data.message || (isRtl ? 'فشل إرسال كود التحويل' : 'Failed to execute call forwarding');
                            const respLine = document.createElement('div');
                            respLine.className = 'ussd-err-box font-bold p-2.5 rounded-lg border mt-1';
                            respLine.textContent = `[System Error] ${errText}`;
                            terminalScreen.appendChild(respLine);
                            terminalScreen.scrollTop = terminalScreen.scrollHeight;
                            showToast(toastTitle + ' (' + target + ')', errText, 'error');
                        }
                    })
                    .catch(err => {
                        const errorLine = document.createElement('div');
                        errorLine.className = 'ussd-err-box font-bold p-2.5 rounded-lg border mt-1';
                        errorLine.textContent = `[Network Error] ${err.message}`;
                        terminalScreen.appendChild(errorLine);
                        terminalScreen.scrollTop = terminalScreen.scrollHeight;
                        showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error');
                    })
                    .finally(() => {
                        if (btnLabel) btnLabel.textContent = words.cfSendBtn || (isRtl ? 'إرسال الكود' : 'Send Code');
                        if (btnSpinner) btnSpinner.classList.add('hidden');
                        if (submitBtn) submitBtn.disabled = false;
                    });
                });
            }

            // WebSocket live USSD responses capture
            if (socket) {
                socket.on('ussdResponse', (data) => {
                    if (ussdTarget.value.toLowerCase() === data.dongleId.toLowerCase()) {
                        appendUssdResponse(data.logTime, data.text, true);
                    }
                });

                socket.on('dongleNumberUpdated', (data) => {
                    const btn = document.getElementById('resetBtn-' + data.dongleId);
                    if (btn) {
                        const span = btn.querySelector('span');
                        if (span) span.innerText = words.resetUsbBtn;
                        btn.disabled = false;
                    }
                    refreshDevicesList();
                });

                socket.on('dongleProvisionResult', (data) => {
                    if (data.results) {
                        let details = data.results.map(function(r) {
                            const status = r.error ? '❌' : '✅';
                            return status + ' ' + r.step + (r.error ? ': ' + r.error : '');
                        }).join('\n');
                        showToast(data.dongleId + ' AT Results', details, data.results.some(function(r) { return r.error; }) ? 'error' : 'success');
                    }
                    refreshDevicesList();
                });

                socket.on('usbDevicesUpdated', () => {
                    refreshUsbDevices();
                    refreshDevicesList(true);
                });

                // Real-time SIM failure prominent top-center notification (IMSI read error)
                socket.on('dongleSimError', (data) => {
                    if (!data || data.error !== 'imsi_failed') return;
                    const dongleName = data.dongleId || 'dongle';
                    const alertTitle = isRtl ? `تنبيه عتاد الشريحة [${dongleName}]` : `Hardware SIM Alert [${dongleName}]`;
                    const alertMsg = isRtl
                        ? `بطاقة SIM غير متصلة بشكل صحيح (تعذر قراءة رقم IMSI). يرجى التأكد من تركيب الشريحة في الجهاز وإعادة التوصيل.`
                        : `SIM card is not connected properly (failed to read IMSI). Please make sure the SIM card is properly inserted in the dongle.`;
                    showTopCenterAlert(alertTitle, alertMsg);
                });
            }

            function showTopCenterAlert(title, message) {
                const topContainer = document.getElementById('top-alert-container');
                if (!topContainer) {
                    showToast(title, message, 'warning');
                    return;
                }
                const alertEl = document.createElement('div');
                alertEl.className = 'pointer-events-auto w-full rounded-2xl p-4 sm:p-5 flex items-start gap-4 transform -translate-y-8 opacity-0 transition-all duration-300 font-mono';
                alertEl.style.cssText = 'background-color: #121215 !important; border: 2px solid #ef4444 !important; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.85), 0 0 25px rgba(239, 68, 68, 0.35) !important; font-family: \'JetBrains Mono\', monospace !important;';
                alertEl.innerHTML = `
                    <div class="p-2.5 rounded-xl shrink-0 mt-0.5" style="background-color: rgba(239, 68, 68, 0.2) !important; color: #f87171 !important; border: 1px solid rgba(239, 68, 68, 0.4) !important;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0 font-mono">
                        <div class="flex items-center justify-between gap-2 mb-1.5">
                            <h4 class="text-sm sm:text-base font-bold tracking-wide uppercase font-mono" style="color: #ff6b6b !important; font-family: 'JetBrains Mono', monospace !important;">${title}</h4>
                            <button type="button" class="p-1 rounded-lg transition cursor-pointer" style="color: #ffffff !important; background-color: rgba(255, 255, 255, 0.1) !important;" onclick="this.closest('.pointer-events-auto').remove()">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                            </button>
                        </div>
                        <p class="text-sm sm:text-base font-medium leading-relaxed font-mono" style="color: #ffffff !important; text-shadow: 0 1px 2px rgba(0,0,0,0.5); font-family: 'JetBrains Mono', monospace !important;">${message}</p>
                    </div>
                `;
                topContainer.appendChild(alertEl);
                requestAnimationFrame(() => {
                    alertEl.classList.remove('-translate-y-8', 'opacity-0');
                });
                setTimeout(() => {
                    alertEl.classList.add('-translate-y-8', 'opacity-0');
                    setTimeout(() => { alertEl.remove(); }, 300);
                }, 12000);
            }

            // Refresh Device List AJAX helper
            let lastDevicesSignature = JSON.stringify(loadedDevices || []);
            function refreshDevicesList(force = false) {
                if (devicesRefreshInFlight) return;
                devicesRefreshInFlight = true;

                fetch('/api/gsm-dongles')
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success || !Array.isArray(data.devices)) return;

                        const newSignature = JSON.stringify(data.devices);
                        if (!force && newSignature === lastDevicesSignature) {
                            return;
                        }
                        lastDevicesSignature = newSignature;

                        const previousSelected = selectedDongleId;
                        loadedDevices = data.devices;
                        window.loadedDevices = loadedDevices;
                        const currentSelected = selectedDongleId || (ussdTarget ? ussdTarget.value : '');
                        const nextSelected = loadedDevices.some(device => String(device.ID || '') === String(currentSelected || ''))
                            ? String(currentSelected)
                            : (loadedDevices[0] ? String(loadedDevices[0].ID || '') : '');

                        const cfTarget = document.getElementById('cf-target-dongle');
                        const currentCfSelected = cfTarget && cfTarget.value ? cfTarget.value : nextSelected;
                        const nextCfSelected = loadedDevices.some(device => String(device.ID || '') === String(currentCfSelected || ''))
                            ? String(currentCfSelected)
                            : nextSelected;

                        function populateTargetDropdown(el, selectedVal, fallbackNumber) {
                            if (!el) return;
                            el.innerHTML = '';
                            const placeholder = document.createElement('option');
                            placeholder.value = '';
                            placeholder.disabled = true;
                            placeholder.hidden = true;
                            placeholder.textContent = words.selectPlaceholder;
                            placeholder.selected = !selectedVal;
                            el.appendChild(placeholder);

                            loadedDevices.forEach(device => {
                                const option = document.createElement('option');
                                option.value = String(device.ID || '');
                                option.textContent = `${device.ID || ''} (${device.Number || fallbackNumber})`;
                                option.selected = option.value === selectedVal;
                                el.appendChild(option);
                            });
                            if (selectedVal) {
                                isSyncingSelect = true;
                                el.value = selectedVal;
                                el.dispatchEvent(new Event('change', { bubbles: true }));
                                isSyncingSelect = false;
                            }
                        }

                        if (ussdTarget) {
                            populateTargetDropdown(ussdTarget, nextSelected, 'Unknown');
                        }
                        if (cfTarget) {
                            populateTargetDropdown(cfTarget, nextCfSelected, 'Unknown SIM');
                        }

                        renderDongleCards();
                        if (typeof updateReportDropdowns === 'function') {
                            updateReportDropdowns();
                        }
                        if (nextSelected) {
                            selectDevice(nextSelected, { skipSms: (previousSelected === nextSelected) });
                        } else {
                            selectedDongleId = null;
                            updateSmsInboxTitle();
                            showEmptySmsInbox();
                        }
                    })
                    .catch(error => console.error('Error refreshing devices:', error))
                    .finally(() => {
                        devicesRefreshInFlight = false;
                    });
            }

            window.resetServerUsbPorts = function(btn) {
                if (!confirm(isRtl ? 'هل أنت متأكد من إعادة تعيين كافة منافذ USB في السيرفر؟' : 'Are you sure you want to reset all USB ports on the server?')) return;
                if (btn) btn.disabled = true;
                showToast(isRtl ? 'إعادة تعيين USB' : 'Resetting USB', isRtl ? 'جاري إعادة تعيين كافة منافذ USB في السيرفر...' : 'Resetting all USB ports on the server...', 'warning');

                fetch('/api/gsm-dongles/reset-usb-port', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongleId: 'all' })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? 'نجاح' : 'Success', isRtl ? 'تمت إعادة تعيين كافة منافذ USB بنجاح.' : 'All USB ports reset successfully.', 'success');
                        refreshDevicesList();
                    } else {
                        showToast(isRtl ? 'خطأ' : 'Error', data.error || 'USB reset failed', 'error');
                    }
                })
                .catch(err => showToast(isRtl ? 'خطأ شبكة' : 'Network Error', err.message, 'error'))
                .finally(() => { if (btn) btn.disabled = false; });
            };

            if (globalResetUsbBtn) {
                globalResetUsbBtn.addEventListener('click', () => {
                    resetServerUsbPorts(globalResetUsbBtn);
                });
            }
            setInterval(refreshDevicesList, 3000);

            // -----------------------------------------------------------------
            // Dongle & SIM State Duration Analytics Controller
            // -----------------------------------------------------------------
            let currentReportTab = 'dongles';
            let cachedReportData = null;

            function formatLocalDatetime(date) {
                const pad = (n) => String(n).padStart(2, '0');
                const y = date.getFullYear();
                const m = pad(date.getMonth() + 1);
                const d = pad(date.getDate());
                const h = pad(date.getHours());
                const min = pad(date.getMinutes());
                return `${y}-${m}-${d}T${h}:${min}`;
            }

            function updateReportDropdowns() {
                const dSelect = document.getElementById('reportDongleSelect');
                const sSelect = document.getElementById('reportSimSelect');
                if (!dSelect || !sSelect || !Array.isArray(loadedDevices)) return;

                const curD = dSelect.value || 'ALL';
                const curS = sSelect.value || 'ALL';

                const dOptions = ['<option value="ALL">' + (isRtl ? 'جميع الأجهزة (الكل)' : 'All Dongles (ALL)') + '</option>'];
                const sOptions = ['<option value="ALL">' + (isRtl ? 'جميع الشرائح (الكل)' : 'All SIM Numbers (ALL)') + '</option>'];
                const addedSims = new Set();

                loadedDevices.forEach(dev => {
                    const dId = String(dev.ID || '').trim();
                    if (dId) {
                        dOptions.push(`<option value="${escapeHtml(dId)}"${curD.toLowerCase() === dId.toLowerCase() ? ' selected' : ''}>${escapeHtml(dId)}</option>`);
                    }
                    const sNum = String(dev.Number || '').trim();
                    if (sNum && sNum !== 'Unknown' && sNum !== '-' && !addedSims.has(sNum)) {
                        addedSims.add(sNum);
                        sOptions.push(`<option value="${escapeHtml(sNum)}"${curS === sNum ? ' selected' : ''}>${escapeHtml(sNum)}</option>`);
                    }
                });

                dSelect.innerHTML = dOptions.join('');
                sSelect.innerHTML = sOptions.join('');
            }

            window.setDongleReportTab = function(tab) {
                currentReportTab = tab;
                const btnDongles = document.getElementById('report-tab-dongles-btn');
                const btnSims = document.getElementById('report-tab-sims-btn');
                if (tab === 'dongles') {
                    if (btnDongles) {
                        btnDongles.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-[var(--accent-color)] text-white shadow-sm cursor-pointer';
                    }
                    if (btnSims) {
                        btnSims.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] cursor-pointer';
                    }
                } else {
                    if (btnDongles) {
                        btnDongles.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] cursor-pointer';
                    }
                    if (btnSims) {
                        btnSims.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-[var(--accent-color)] text-white shadow-sm cursor-pointer';
                    }
                }
                renderDurationTable();
            };

            let reportStartPicker = null;
            let reportEndPicker = null;

            function initReportPickers() {
                if (typeof flatpickr === 'undefined') return;
                const sEl = document.getElementById('reportStartDate');
                const eEl = document.getElementById('reportEndDate');
                if (sEl && !reportStartPicker) {
                    reportStartPicker = flatpickr(sEl, {
                        enableTime: true,
                        dateFormat: "Y-m-d\\TH:i",
                        altInput: true,
                        altFormat: "m/d/Y h:i K",
                        time_24hr: false,
                        allowInput: true,
                        scrollInputIntoView: false,
                        appendTo: document.body,
                        monthSelectorType: "dropdown",
                        onReady: function(selectedDates, dateStr, instance) {
                            if (instance.altInput) {
                                var origId = instance.input.id || 'reportStartDate';
                                if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                                instance.input.id = origId + '_raw';
                                instance.altInput.id = origId;
                                instance.altInput.name = (instance.input.name || origId) + '_display';
                                instance.altInput.setAttribute('autocomplete', 'off');
                                var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                                instance.altInput.setAttribute('aria-label', ariaLabel);
                            }
                        }
                    });
                }
                if (eEl && !reportEndPicker) {
                    reportEndPicker = flatpickr(eEl, {
                        enableTime: true,
                        dateFormat: "Y-m-d\\TH:i",
                        altInput: true,
                        altFormat: "m/d/Y h:i K",
                        time_24hr: false,
                        allowInput: true,
                        scrollInputIntoView: false,
                        appendTo: document.body,
                        monthSelectorType: "dropdown",
                        onReady: function(selectedDates, dateStr, instance) {
                            if (instance.altInput) {
                                var origId = instance.input.id || 'reportEndDate';
                                if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                                instance.input.id = origId + '_raw';
                                instance.altInput.id = origId;
                                instance.altInput.name = (instance.input.name || origId) + '_display';
                                instance.altInput.setAttribute('autocomplete', 'off');
                                var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                                instance.altInput.setAttribute('aria-label', ariaLabel);
                            }
                        }
                    });
                }
            }

            window.setDongleReportPreset = function(preset) {
                initReportPickers();
                const startInput = document.getElementById('reportStartDate_raw') || document.getElementById('reportStartDate');
                const endInput = document.getElementById('reportEndDate_raw') || document.getElementById('reportEndDate');
                if (!startInput || !endInput) return;

                const now = new Date();
                let start, end;
                if (preset === 'today') {
                    start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
                    end = now;
                } else if (preset === 'yesterday') {
                    start = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 0, 0, 0);
                    end = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1, 23, 59, 59);
                } else if (preset === '7days') {
                    start = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);
                    end = now;
                } else if (preset === '30days') {
                    start = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
                    end = now;
                }

                if (reportStartPicker) reportStartPicker.setDate(start, true);
                else startInput.value = formatLocalDatetime(start);

                if (reportEndPicker) reportEndPicker.setDate(end, true);
                else endInput.value = formatLocalDatetime(end);

                fetchDongleStateReports();
            };

            window.toggleReportWorkHours = function(checked) {
                const c = document.getElementById('report-shift-controls');
                if (c) {
                    if (checked) c.classList.remove('hidden');
                    else c.classList.add('hidden');
                }
                fetchDongleStateReports();
            };

            window.setReportWorkDaysPreset = function(preset) {
                const checkboxes = document.querySelectorAll('input[name="reportWorkDay"]');
                checkboxes.forEach(cb => {
                    const val = parseInt(cb.value, 10);
                    if (preset === 'sun-thu') {
                        cb.checked = (val >= 0 && val <= 4);
                    } else if (preset === 'mon-fri') {
                        cb.checked = (val >= 1 && val <= 5);
                    } else if (preset === 'all') {
                        cb.checked = true;
                    }
                });
                fetchDongleStateReports();
            };
            function renderDurationTable() {
                const tbody = document.getElementById('report-table-body');
                const colTargetHeader = document.getElementById('report-col-target-header');
                const colSubtargetHeader = document.getElementById('report-col-subtarget-header');
                if (!tbody) return;

                if (colTargetHeader && colSubtargetHeader) {
                    if (currentReportTab === 'dongles') {
                        colTargetHeader.textContent = isRtl ? 'المودم' : 'Dongle';
                        colSubtargetHeader.textContent = isRtl ? 'رقم الشريحة' : 'SIM Number';
                    } else {
                        colTargetHeader.textContent = isRtl ? 'رقم الشريحة' : 'SIM Number';
                        colSubtargetHeader.textContent = isRtl ? 'المودم' : 'Dongle';
                    }
                }

                if (!cachedReportData) {
                    tbody.innerHTML = `<tr><td colspan="9" class="py-8 text-center text-xs text-[var(--text-muted)] font-sans">${isRtl ? 'لا توجد بيانات' : 'No data loaded'}</td></tr>`;
                    return;
                }

                const items = currentReportTab === 'dongles' ? (cachedReportData.dongleReports || []) : (cachedReportData.simReports || []);

                if (items.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="9" class="py-8 text-center text-xs text-[var(--text-muted)] font-sans">${isRtl ? 'لا توجد سجلات مسجلة في هذا النطاق الزمني.' : 'No state logs recorded in this timeframe.'}</td></tr>`;
                    return;
                }

                let html = '';
                items.forEach(item => {
                    const name = currentReportTab === 'dongles' ? (item.dongle_name || '-') : (item.sim_number || '-');
                    const secondary = currentReportTab === 'dongles' ? (item.sim_number || '-') : (item.dongle_name || '-');
                    const free = item.states?.Free || { formatted: '0s', pct: 0 };
                    const busy = item.states?.Busy || { formatted: '0s', pct: 0, inbound: { calls: 0, formatted: '0s', pct: 0 }, outbound: { calls: 0, formatted: '0s', pct: 0 } };
                    const notInit = item.states?.['Not Initialized'] || { formatted: '0s', pct: 0 };
                    const notConn = item.states?.['Not connected'] || { formatted: '0s', pct: 0 };
                    const uptime = item.uptimePct || 0;

                    const inCalls = busy.inbound?.calls || 0;
                    const inDur = busy.inbound?.talkFormatted || busy.inbound?.formatted || '0s';
                    const outCalls = busy.outbound?.calls || 0;
                    const outDur = busy.outbound?.talkFormatted || busy.outbound?.formatted || '0s';

                    const pctFree = free.pct || 0;
                    const pctIn = busy.inbound?.pct || 0;
                    const pctOut = busy.outbound?.pct || 0;
                    const pctNotInit = notInit.pct || 0;
                    const pctNotConn = notConn.pct || 0;

                    html += `
                        <tr class="hover:bg-[var(--bg-hover)] transition-colors border-b border-[var(--border-primary)]/40">
                            <td class="py-3 px-4 font-black text-white font-mono text-xs">${escapeHtml(name)}</td>
                            <td class="py-3 px-4 text-sky-300 font-bold font-mono text-xs">${escapeHtml(secondary)}</td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-emerald-600 font-bold font-mono text-xs">${free.formatted}</span>
                                    <span class="text-[11px] text-zinc-300 font-mono font-medium">(${free.pct}%)</span>
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="duration-busy-text font-black font-mono text-xs">${busy.formatted}</span>
                                        <span class="duration-busy-text text-[11px] font-mono font-bold">(${busy.pct}%)</span>
                                    </div>
                                    <div class="flex flex-wrap items-center gap-1 mt-0.5">
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-cyan-300 text-black border border-cyan-400 text-[10px] font-mono font-black" title="${isRtl ? 'المكالمات الواردة' : 'Incoming Calls'}">
                                            <svg class="w-2.5 h-2.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                                            <span class="text-black font-bold">${inDur} (${inCalls})</span>
                                        </span>
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-indigo-300 text-black border border-indigo-400 text-[10px] font-mono font-black" title="${isRtl ? 'المكالمات الصادرة' : 'Outgoing Calls'}">
                                            <svg class="w-2.5 h-2.5 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                                            <span class="text-black font-bold">${outDur} (${outCalls})</span>
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-rose-600 font-bold font-mono text-xs">${notInit.formatted}</span>
                                    <span class="text-[11px] text-zinc-300 font-mono font-medium">(${notInit.pct}%)</span>
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <div class="flex items-center gap-1.5">
                                    <span class="text-amber-600 font-bold font-mono text-xs">${notConn.formatted}</span>
                                    <span class="text-[11px] text-zinc-300 font-mono font-medium">(${notConn.pct}%)</span>
                                </div>
                            </td>
                            <td class="py-3 px-4 min-w-[140px]">
                                <div class="w-full h-2 rounded-full bg-zinc-800 overflow-hidden flex" title="${isRtl ? 'جاهز' : 'Free'}: ${pctFree}% | ${isRtl ? 'وارد' : 'Inbound'}: ${pctIn}% | ${isRtl ? 'صادر' : 'Outbound'}: ${pctOut}% | ${isRtl ? 'غير مهيأ' : 'Not Init'}: ${pctNotInit}% | ${isRtl ? 'غير متصل' : 'Disconn'}: ${pctNotConn}%">
                                    ${pctFree > 0 ? `<div style="width:${pctFree}%" class="h-full bg-emerald-400"></div>` : ''}
                                    ${pctIn > 0 ? `<div style="width:${pctIn}%" class="h-full bg-cyan-400"></div>` : ''}
                                    ${pctOut > 0 ? `<div style="width:${pctOut}%" class="h-full bg-indigo-400"></div>` : ''}
                                    ${pctNotInit > 0 ? `<div style="width:${pctNotInit}%" class="h-full bg-rose-400"></div>` : ''}
                                    ${pctNotConn > 0 ? `<div style="width:${pctNotConn}%" class="h-full bg-amber-400"></div>` : ''}
                                </div>
                                <div class="flex items-center justify-between text-[10px] text-zinc-300 font-mono font-medium mt-1">
                                    <span>${isRtl ? 'جاهز' : 'Free'}: ${pctFree}%</span>
                                    <span>${isRtl ? 'مكالمات' : 'Calls'}: ${busy.pct}%</span>
                                </div>
                            </td>
                            <td class="py-3 px-4 text-zinc-100 font-mono">
                                <div class="flex flex-col gap-0.5">
                                    <span class="font-bold text-white text-xs">${item.totalCalls || 0} ${isRtl ? 'مكالمة' : 'calls'}</span>
                                    <span class="text-[11px] text-zinc-300 font-medium">${item.talkFormatted || (item.talkMin + 'm') || '0s'} ${isRtl ? 'محادثة' : 'talk'}</span>
                                </div>
                            </td>
                            <td class="py-3 px-4 text-center">
                                <span class="px-2.5 py-1 text-[11px] font-black font-mono rounded-lg inline-flex items-center gap-1.5 ${uptime >= 90 ? 'bg-emerald-500/20 text-emerald-600 border border-emerald-400/30' : uptime >= 60 ? 'bg-amber-500/20 text-amber-600 border border-amber-400/30' : 'bg-rose-500/20 text-rose-600 border border-rose-400/30'}">
                                    <span class="w-1.5 h-1.5 rounded-full ${uptime >= 90 ? 'bg-emerald-400' : uptime >= 60 ? 'bg-amber-400' : 'bg-rose-400'}"></span>
                                    ${uptime}%
                                </span>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            }

            window.fetchDongleStateReports = async function() {
                initReportPickers();
                const startInput = document.getElementById('reportStartDate_raw') || document.getElementById('reportStartDate');
                const endInput = document.getElementById('reportEndDate_raw') || document.getElementById('reportEndDate');
                const dSelect = document.getElementById('reportDongleSelect');
                const sSelect = document.getElementById('reportSimSelect');
                const refreshBtn = document.getElementById('dongle-report-refresh-btn');

                if (!startInput || !endInput) return;
                if (refreshBtn) refreshBtn.disabled = true;

                const startDate = startInput.value;
                const endDate = endInput.value;
                const dongleId = dSelect ? dSelect.value : 'ALL';
                const simNumber = sSelect ? sSelect.value : 'ALL';

                const workHoursCheckbox = document.getElementById('reportWorkHoursEnabled');
                const workHoursEnabled = workHoursCheckbox ? workHoursCheckbox.checked : false;
                const shiftStart = (document.getElementById('reportShiftStart')?.value || '09:00').trim();
                const shiftEnd = (document.getElementById('reportShiftEnd')?.value || '17:00').trim();
                const selectedWorkDays = [];
                document.querySelectorAll('input[name="reportWorkDay"]:checked').forEach(cb => {
                    selectedWorkDays.push(cb.value);
                });
                const workDaysParam = selectedWorkDays.join(',');

                try {
                    const url = `/api/config/modem/reports?startDate=${encodeURIComponent(startDate)}&endDate=${encodeURIComponent(endDate)}&dongleId=${encodeURIComponent(dongleId)}&simNumber=${encodeURIComponent(simNumber)}&workHoursEnabled=${workHoursEnabled}&shiftStart=${encodeURIComponent(shiftStart)}&shiftEnd=${encodeURIComponent(shiftEnd)}&workDays=${encodeURIComponent(workDaysParam)}`;
                    const res = await fetch(url);
                    const data = await res.json();

                    if (!data.success) {
                        showToast(isRtl ? 'خطأ في التقرير' : 'Report Error', data.error || 'Failed to fetch report', 'error');
                        return;
                    }

                    cachedReportData = data;

                    // Update Global KPI Cards
                    const g = data.globalSummary || {};
                    const freeElPct = document.getElementById('report-kpi-free-pct');
                    const freeElDur = document.getElementById('report-kpi-free-dur');
                    if (freeElPct) freeElPct.textContent = `${g.Free?.pct || 0}%`;
                    if (freeElDur) freeElDur.textContent = g.Free?.formatted || '0s';

                    const busyElPct = document.getElementById('report-kpi-busy-pct');
                    const busyElDur = document.getElementById('report-kpi-busy-dur');
                    if (busyElPct) busyElPct.textContent = `${g.Busy?.pct || 0}%`;
                    if (busyElDur) busyElDur.textContent = g.Busy?.formatted || '0s';

                    // Branches
                    const inDurEl = document.getElementById('report-kpi-inbound-dur');
                    const inCallsEl = document.getElementById('report-kpi-inbound-calls');
                    if (inDurEl) inDurEl.textContent = g.Busy?.inbound?.talkFormatted || g.Busy?.inbound?.formatted || '0s';
                    if (inCallsEl) inCallsEl.textContent = `${g.Busy?.inbound?.calls || 0} ${isRtl ? 'مكالمة' : 'calls'}`;

                    const outDurEl = document.getElementById('report-kpi-outbound-dur');
                    const outCallsEl = document.getElementById('report-kpi-outbound-calls');
                    if (outDurEl) outDurEl.textContent = g.Busy?.outbound?.talkFormatted || g.Busy?.outbound?.formatted || '0s';
                    if (outCallsEl) outCallsEl.textContent = `${g.Busy?.outbound?.calls || 0} ${isRtl ? 'مكالمة' : 'calls'}`;

                    const notInitPct = document.getElementById('report-kpi-notinit-pct');
                    const notInitDur = document.getElementById('report-kpi-notinit-dur');
                    if (notInitPct) notInitPct.textContent = `${g['Not Initialized']?.pct || 0}%`;
                    if (notInitDur) notInitDur.textContent = g['Not Initialized']?.formatted || '0s';

                    const notConnPct = document.getElementById('report-kpi-notconn-pct');
                    const notConnDur = document.getElementById('report-kpi-notconn-dur');
                    if (notConnPct) notConnPct.textContent = `${g['Not connected']?.pct || 0}%`;
                    if (notConnDur) notConnDur.textContent = g['Not connected']?.formatted || '0s';

                    const winLabel = document.getElementById('report-window-label');
                    if (winLabel) {
                        let label = data.timeframe?.formattedWindow || '-';
                        if (data.timeframe?.workHoursEnabled) {
                            label += ` (${isRtl ? 'الوردية: ' : 'Shift: '}${data.timeframe.shiftStart} - ${data.timeframe.shiftEnd})`;
                        }
                        winLabel.textContent = label;
                    }

                    renderDurationTable();
                } catch (err) {
                    console.error('Failed to fetch duration reports:', err);
                } finally {
                    if (refreshBtn) refreshBtn.disabled = false;
                }
            };

            const initReportDates = () => {
                initReportPickers();
                const now = new Date();
                const start = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0);
                if (reportStartPicker) reportStartPicker.setDate(start, true);
                else {
                    const sIn = document.getElementById('reportStartDate_raw') || document.getElementById('reportStartDate');
                    if (sIn) sIn.value = formatLocalDatetime(start);
                }
                if (reportEndPicker) reportEndPicker.setDate(now, true);
                else {
                    const eIn = document.getElementById('reportEndDate_raw') || document.getElementById('reportEndDate');
                    if (eIn) eIn.value = formatLocalDatetime(now);
                }
            };
            initReportDates();
            updateReportDropdowns();
            setTimeout(() => {
                fetchDongleStateReports();
            }, 200);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDonglesPage);
        } else {
            initDonglesPage();
        }
    </script>
</body>
</html>

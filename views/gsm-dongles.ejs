        .light-theme .dongle-device-card.dongle-state-pink .dongle-icon-box {
            background-color: #fbcfe8 !important;
            border: 1px solid #f472b6 !important;
            color: #9d174d !important;
        }
        .light-theme .dongle-device-card.dongle-state-pink .dongle-metric,
        .light-theme .dongle-device-card.dongle-state-pink .dongle-priority-metric,
        .light-theme .dongle-device-card.dongle-state-pink .dongle-routing-panel,
        .light-theme .dongle-device-card.dongle-state-pink .dongle-hardware-summary {
            background: #fbcfe8 !important;
            border-color: #f472b6 !important;
        }
        .light-theme .dongle-device-card.dongle-state-pink .dongle-routing-trunk {
            background: #ffffff !important;
            border-color: #f9a8d4 !important;
        }
        .light-theme .dongle-device-card.dongle-state-pink .dongle-card-footer {
            background-color: #fbcfe8 !important;
            border-top-color: #f472b6 !important;
        }

        /* 3. DIALING / RINGING (Blue) in Light Theme */
        .light-theme .dongle-device-card.dongle-state-blue {
            background-color: #eff6ff !important;
            border-color: #3b82f6 !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue:hover {
            border-color: #2563eb !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-icon-box {
            background-color: #dbeafe !important;
            border: 1px solid #60a5fa !important;
            color: #1e40af !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-status-pill {
            background-color: #2563eb !important;
            border: 1px solid #1d4ed8 !important;
            color: #ffffff !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-status-dot {
            background-color: #ffffff !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-metric,
        .light-theme .dongle-device-card.dongle-state-blue .dongle-priority-metric,
        .light-theme .dongle-device-card.dongle-state-blue .dongle-routing-panel,
        .light-theme .dongle-device-card.dongle-state-blue .dongle-hardware-summary {
            background: #dbeafe !important;
            border-color: #93c5fd !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-routing-trunk {
            background: #ffffff !important;
            border-color: #bfdbfe !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-card-footer {
            background-color: #dbeafe !important;
            border-top-color: #93c5fd !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-action-button.dongle-action-primary {
            background-color: #2563eb !important;
            border-color: #1d4ed8 !important;
            color: #ffffff !important;
        }
        .light-theme .dongle-device-card.dongle-state-blue .dongle-action-button.dongle-action-primary:hover {
            background-color: #1d4ed8 !important;
        }

        .light-theme .dongle-device-card.dongle-state-yellow {
            background-color: #fef3c7 !important;
            border-color: #f59e0b !important;
        }
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-icon-box {
            background-color: #fde68a !important;
            border: 1px solid #fbbf24 !important;
            color: #92400e !important;
        }
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-metric,
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-priority-metric,
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-routing-panel,
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-hardware-summary {
            background: #fde68a !important;
            border-color: #fbbf24 !important;
        }
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-routing-trunk {
            background: #ffffff !important;
            border-color: #fde68a !important;
        }
        .light-theme .dongle-device-card.dongle-state-yellow .dongle-card-footer {
            background-color: #fde68a !important;
            border-top-color: #fbbf24 !important;
        }

        .light-theme .dongle-device-card.dongle-state-red {
            background-color: #ffe4e6 !important;
            border-color: #f43f5e !important;
        }
        .light-theme .dongle-device-card.dongle-state-red .dongle-icon-box {
            background-color: #fecdd3 !important;
            border: 1px solid #fb7185 !important;
            color: #9f1239 !important;
        }
        .light-theme .dongle-device-card.dongle-state-red .dongle-metric,
        .light-theme .dongle-device-card.dongle-state-red .dongle-priority-metric,
        .light-theme .dongle-device-card.dongle-state-red .dongle-routing-panel,
        .light-theme .dongle-device-card.dongle-state-red .dongle-hardware-summary {
            background: #fecdd3 !important;
            border-color: #fb7185 !important;
        }
        .light-theme .dongle-device-card.dongle-state-red .dongle-routing-trunk {
            background: #ffffff !important;
            border-color: #fda4af !important;
        }
        .light-theme .dongle-device-card.dongle-state-red .dongle-card-footer {
            background-color: #fecdd3 !important;
            border-top-color: #fb7185 !important;
        }

        .light-theme .dongle-device-card .dongle-metric-label {
            color: #374151 !important;
        }
        .light-theme .dongle-device-card .dongle-metric-value,
        .light-theme .dongle-device-card .dongle-priority-value {
            color: #111827 !important;
        }
        .light-theme .dongle-device-card .dongle-hardware-summary {
            color: #1f2937 !important;
        }
        .light-theme .dongle-device-card .dongle-dial-string {
            color: #0f172a !important;
            background: rgba(0, 0, 0, 0.05) !important;
            border: 1px solid rgba(0, 0, 0, 0.1) !important;
        }

        .selected-row {
            outline: 3px solid var(--accent-color) !important;
            outline-offset: 1px;
        }
        .dongle-status-pill {
            white-space: nowrap;
        }
        .dongle-priority-grid {
            margin-bottom: 0.5rem;
        }
        .dongle-priority-metric {
            background: linear-gradient(135deg, color-mix(in srgb, var(--accent-soft) 68%, var(--bg-primary)), color-mix(in srgb, var(--bg-primary) 58%, transparent));
            border: 1px solid var(--accent-border);
            border-radius: 0.75rem;
            min-width: 0;
            padding: 0.5rem 0.55rem;
        }
        .dongle-priority-value {
            color: var(--text-primary);
            font-size: 1rem !important;
            font-weight: 900 !important;
            letter-spacing: 0.01em;
            line-height: 1.25;
            overflow-wrap: anywhere;
        }
        .dongle-hardware-summary {
            background: color-mix(in srgb, var(--bg-primary) 28%, transparent);
            border: 1px dashed color-mix(in srgb, var(--border-primary) 78%, transparent);
            border-radius: 0.55rem;
            color: var(--text-muted);
            font-size: 0.58rem;
            line-height: 1.3;
            padding: 0.35rem 0.55rem;
        }
        .dongle-routing-panel {
            background: color-mix(in srgb, var(--bg-primary) 38%, transparent);
            border: 1px solid color-mix(in srgb, var(--border-accent) 80%, transparent);
            border-radius: 0.72rem;
            margin-top: 0.5rem;
            padding: 0.55rem;
        }
        .dongle-routing-trunk {
            background: color-mix(in srgb, var(--bg-card) 82%, transparent);
            border: 1px solid var(--border-primary);
            border-radius: 0.58rem;
            padding: 0.5rem;
            display: block;
            text-decoration: none;
            cursor: pointer;
            transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease, background-color 180ms ease;
        }
        .dongle-routing-trunk:hover {
            border-color: rgba(239, 68, 68, 0.75) !important;
            box-shadow: 0 4px 14px rgba(239, 68, 68, 0.2);
            transform: translateY(-1px);
        }
        .dongle-dial-string {
            background: color-mix(in srgb, var(--bg-primary) 58%, transparent);
            border-radius: 0.38rem;
            color: var(--text-secondary);
            font-size: 0.58rem;
            line-height: 1.35;
            overflow-wrap: anywhere;
            padding: 0.3rem 0.4rem;
        }
        .dongle-route-chip {
            background: rgba(14, 165, 233, 0.1);
            border: 1px solid rgba(14, 165, 233, 0.24);
            border-radius: 999px;
            color: #38bdf8;
            display: inline-flex;
            font-size: 0.58rem;
            font-weight: 700;
            line-height: 1.2;
            max-width: 100%;
            padding: 0.22rem 0.42rem;
        }
        .dongle-metric {
            background: color-mix(in srgb, var(--bg-primary) 46%, transparent);
            border: 1px solid color-mix(in srgb, var(--border-primary) 75%, transparent);
            border-radius: 0.6rem;
            min-width: 0;
            padding: 0.52rem 0.62rem;
        }
        .dongle-metric-label,
        .gsm-detail-label {
            color: var(--text-muted);
            display: block;
            font-size: 0.58rem;
            font-weight: 800;
            letter-spacing: 0.08em;
            line-height: 1;
            margin-bottom: 0.32rem;
            text-transform: uppercase;
        }
        .dongle-metric-value,
        .gsm-detail-value {
            color: var(--text-primary);
            display: block;
            font-size: 1rem !important;
            font-weight: 800 !important;
            line-height: 1.3;
            min-width: 0;
            overflow-wrap: anywhere;
        }
        .dongle-card-footer {
            flex-wrap: wrap;
            row-gap: 0.5rem;
            min-height: 2.75rem;
        }
        .dongle-action-button {
            align-items: center;
            border: 1px solid var(--border-primary);
            border-radius: 0.52rem;
            display: inline-flex;
            font-size: 0.68rem;
            font-weight: 700;
            gap: 0.35rem;
            justify-content: center;
            min-height: 1.9rem;
            padding: 0.36rem 0.6rem;
            transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
            white-space: nowrap;
        }
        .dongle-action-button:disabled {
            cursor: not-allowed;
            opacity: 0.65;
        }
        .dongle-action-primary {
            background: var(--accent-color);
            border-color: var(--accent-color);
            color: #ffffff;
        }
        .dongle-action-primary:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }
        .dongle-action-secondary {
            background: rgba(0, 0, 0, 0.4);
            border-color: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }
        .dongle-action-secondary:hover {
            background: rgba(255, 255, 255, 0.25);
            border-color: rgba(255, 255, 255, 0.45);
        }
        .light-theme .dongle-action-secondary {
            background: rgba(255, 255, 255, 0.85);
            border-color: rgba(0, 0, 0, 0.2);
            color: #111827;
        }
        .light-theme .dongle-action-secondary:hover {
            background: #ffffff;
            border-color: rgba(0, 0, 0, 0.4);
        }
        .gsm-console-panel {
            min-height: 0;
            min-width: 0;
        }
        .gsm-detail-field {
            background: color-mix(in srgb, var(--bg-primary) 42%, transparent);
            border: 1px solid color-mix(in srgb, var(--border-primary) 72%, transparent);
            border-radius: 0.7rem;
            min-width: 0;
            padding: 0.5rem 0.65rem;
        }
        .sms-inbox-panel {
            min-height: 0;
            overflow: hidden;
        }
        .sms-inbox-scroll {
            min-height: 0;
            overscroll-behavior: contain;
            scrollbar-color: rgba(220, 38, 38, 0.45) transparent;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
        }
        .sms-inbox-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .sms-inbox-scroll::-webkit-scrollbar-thumb {
            background: rgba(220, 38, 38, 0.45);
            border-radius: 999px;
        }
        .sms-inbox-scroll::-webkit-scrollbar-thumb:hover {
            background: rgba(220, 38, 38, 0.7);
        }
        .sms-inbox-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .sms-message-card {
            flex-shrink: 0;
        }

        .light-theme .sms-inbox-scroll {
            scrollbar-color: #991b1b transparent !important;
        }
        .light-theme .sms-inbox-scroll::-webkit-scrollbar-thumb {
            background: #991b1b !important;
        }
        .light-theme .sms-inbox-scroll::-webkit-scrollbar-thumb:hover {
            background: #7f1d1d !important;
        }
        
        /* Light Theme Page-Specific Overrides for gsm-dongles.ejs */
        .light-theme .panel-surface {
            background-color: var(--bg-secondary) !important;
            border-color: var(--border-primary) !important;
        }
        .light-theme .bg-black\/40 {
            background-color: #e2e8f0 !important;
        }
        .light-theme .bg-black\/25 {
            background-color: #f1f5f9 !important;
        }
        .light-theme .bg-zinc-950 {
            background-color: var(--bg-card) !important;
            border-color: #cbd5e1 !important;
        }
        .light-theme select,
        .light-theme select option,
        .light-theme input {
            background-color: var(--bg-card) !important;
            color: var(--text-primary) !important;
            border-color: var(--border-primary) !important;
        }
        .light-theme .border-b,
        .light-theme .border-t,
        .light-theme .border {
            border-color: #cbd5e1 !important;
        }
        .light-theme .text-zinc-400,
        .light-theme .text-zinc-500,
        .light-theme .text-zinc-300 {
            color: #334155 !important;
        }
        .light-theme .text-white {
            color: #000000 !important;
        }
        .light-theme [class*="border-[#27272a]"] {
            border-color: #cbd5e1 !important;
        }
        .light-theme .terminal-container {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
        }
        .light-theme .terminal-screen {
            background-color: #ffffff !important;
            border: none !important;
            color: #0f172a !important;
        }
        .light-theme #terminal-screen div {
            color: inherit !important;
        }
        .light-theme #terminal-placeholder {
            color: #64748b !important;
            background-color: #f8fafc !important;
            border-color: #e2e8f0 !important;
        }
        .light-theme .ussd-resp-box {
            background-color: #f8fafc !important;
            border-color: #e2e8f0 !important;
            color: #0f172a !important;
        }
        .light-theme .ussd-resp-time {
            color: #64748b !important;
        }
        .light-theme .ussd-resp-text {
            color: #047857 !important;
        }
        .light-theme .ussd-cmd-line {
            color: #64748b !important;
            border-color: #e2e8f0 !important;
        }
        .light-theme .ussd-err-box {
            background-color: #fef2f2 !important;
            border-color: #fecaca !important;
            color: #b91c1c !important;
        }
        .light-theme .ussd-term-btn {
            background-color: #ffffff !important;
            color: #334155 !important;
            border-color: #cbd5e1 !important;
        }
        .light-theme .ussd-term-btn:hover {
            background-color: #f1f5f9 !important;
            color: #0f172a !important;
            border-color: #94a3b8 !important;
        }
        .light-theme .log-screen {
            background-color: #050505 !important;
            border: 1px solid #1f1f23 !important;
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    
    <div class="flex-1 p-4 sm:p-6 xl:p-8 relative flex flex-col min-w-0 min-h-screen">
        
        <!-- Header Section -->
        <div class="mb-6 shrink-0 flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <div class="flex items-center gap-3">
                <div class="text-[var(--accent-color)] flex items-center justify-center shrink-0">
                    <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="10" y="2" width="4" height="4" rx="0.5" />
                        <line x1="11" y1="3.5" x2="11.01" y2="3.5" stroke-width="2" />
                        <line x1="13" y1="3.5" x2="13.01" y2="3.5" stroke-width="2" />
                        <rect x="7" y="6" width="10" height="15" rx="2" />
                        <circle cx="12" cy="17" r="1" fill="currentColor" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-2xl sm:text-3xl font-vibrant-display text-[var(--text-primary)] tracking-tight"><%= t.title %> <span class="accent-orange"><%= t.subtitle %></span></h2>
                </div>
            </div>

            <div class="flex flex-wrap items-center gap-2.5">
                <div class="inline-flex items-center p-1 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] gap-1">
                    <button type="button" id="btn-view-grid" onclick="setDongleViewMode('grid')" class="px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[var(--accent-color)] text-white">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        <span><%= t.viewGrid %></span>
                    </button>
                    <button type="button" id="btn-view-minimal" onclick="setDongleViewMode('minimal')" class="px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                        <span><%= t.viewMinimal %></span>
                    </button>
                </div>
                <div class="px-3 py-2 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)]">
                    <span class="text-[9px] uppercase tracking-wider text-[var(--text-muted)] block"><%= isRtl ? 'الأجهزة' : 'Devices' %></span>
                    <span id="gsm-device-total" class="text-sm font-black text-[var(--text-primary)] font-mono">0</span>
                </div>
                <div class="px-3 py-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20">
                    <span class="text-[9px] uppercase tracking-wider text-emerald-400/80 block"><%= isRtl ? 'جاهز' : 'Ready' %></span>
                    <span id="gsm-device-ready" class="text-sm font-black text-emerald-400 font-mono">0</span>
                </div>
                <button id="global-audit-btn" type="button" onclick="openDongleAuditModal()" class="dongle-action-button dongle-action-secondary cursor-pointer px-3.5 py-2 font-bold text-xs flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                    <span><%= t.btnAuditHardware %></span>
                </button>
                <button id="global-reset-usb-btn" class="dongle-action-button dongle-action-primary cursor-pointer px-3.5 py-2 font-bold text-xs flex items-center gap-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                    <span><%= t.btnResetAllUsb %></span>
                </button>
            </div>
        </div>

        <!-- Main Content Stack -->
        <div class="flex flex-col gap-6 mb-6">
            <!-- Responsive GSM Dongle Fleet -->
            <section class="panel-surface rounded-2xl overflow-hidden shrink-0">

                <!-- Action Buttons & Dongle State Legend -->
                <div class="px-5 sm:px-6 py-3 bg-[var(--bg-card)]/80 border-b border-[var(--border-primary)]">
                    <div class="flex items-center justify-between gap-2 cursor-pointer select-none" onclick="toggleLegendBlock()">
                        <div class="flex items-center gap-2">
                            <div class="text-blue-400 flex items-center justify-center shrink-0">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            </div>
                            <span class="text-xs font-black uppercase tracking-wider text-[var(--text-primary)]"><%= t.legendTitle %></span>
                        </div>
                        <button type="button" class="text-[10px] font-bold text-blue-400 hover:underline flex items-center gap-1">
                            <span id="legend-toggle-text"><%= isRtl ? 'عرض الدليل' : 'Show Guide' %></span>
                            <svg id="legend-toggle-icon" class="w-3.5 h-3.5 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                    </div>

                    <div id="legend-content-block" class="mt-3 pt-3 border-t border-[var(--border-primary)] space-y-4 hidden">
                        <!-- 1. Action Buttons Guide -->
                        <div>
                            <span class="text-[10px] font-black uppercase tracking-wider text-[var(--text-secondary)] block mb-2"><%= isRtl ? 'أزرار الإجراءات والتحكم:' : 'Action & Control Buttons:' %></span>
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2">
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-[var(--accent-color)] text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                                        <%= isRtl ? 'أعلى الصفحة' : 'Header' %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendTopHeaderDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                                        <%= t.btnRestartDongle %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendRestartDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18.36 6.64a9 9 0 1 1-12.73 0"/><line x1="12" y1="2" x2="12" y2="12"/></svg>
                                        <%= t.btnRebootModem %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendRebootDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22v-5"/><path d="M9 8V2h6v6"/><path d="M6 13V8h12v5a6 6 0 0 1-12 0z"/></svg>
                                        <%= t.btnVirtualReplug %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendReplugDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                                        <%= t.btnPopulateHardware %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendPopulateDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 17l6-6-6-6"/><path d="M12 19h8"/><circle cx="7" cy="12" r="3"/><path d="M17 7l4 4-4 4"/></svg>
                                        <%= t.btnEditPorts %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendEditPortsDesc %></p>
                                </div>
                                <div class="p-2.5 rounded-xl bg-[var(--bg-primary)]/60 border border-[var(--border-primary)] flex items-start gap-2.5">
                                    <span class="px-2 py-1 rounded bg-black/40 border border-white/20 text-white text-[9px] font-bold shrink-0 flex items-center gap-1">
                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>
                                        <%= t.btnCallForwarding %>
                                    </span>
                                    <p class="text-[10px] text-[var(--text-muted)] leading-relaxed"><%= t.legendCallForwardingDesc %></p>
                                </div>
                            </div>
                        </div>

                        <!-- 2. Dongle State Colors Guide -->
                        <div>
                            <span class="text-[10px] font-black uppercase tracking-wider text-[var(--text-secondary)] block mb-2"><%= isRtl ? 'ألوان حالات الشريحة:' : 'Dongle State Colors:' %></span>
                            <div class="flex flex-wrap items-center gap-2 text-[10px]">
                                <span class="px-2.5 py-1 rounded-lg bg-purple-600 text-white font-black border border-purple-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                    <%= isRtl ? 'جاهز (Free)' : 'Free / Ready' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-[#047857] text-white font-black border border-emerald-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    <%= isRtl ? 'مكالمة نشطة' : 'Active Call' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-pink-600 text-white font-black border border-pink-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    <%= isRtl ? 'رسالة SMS' : 'SMS' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-blue-600 text-white font-black border border-blue-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                    <%= isRtl ? 'اتصال / رنين' : 'Dialing / Ringing' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-amber-600 text-white font-black border border-amber-400 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                    <%= isRtl ? 'جاري التهيئة' : 'Initializing' %>
                                </span>
                                <span class="px-2.5 py-1 rounded-lg bg-[#881337] text-white font-black border border-rose-700 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
                                    <%= isRtl ? 'غير متصل' : 'Disconnected' %>
                                </span>
                        </div>
                    </div>
                </div>
                <div id="dongles-grid" class="grid grid-cols-1 md:grid-cols-2 items-start gap-3 p-3 sm:p-4">
<div class="col-span-full py-8 text-center text-xs text-[var(--text-muted)]"><%= isRtl ? 'جاري تحميل أجهزة GSM...' : 'Loading GSM dongles...' %></div>
                </div>
            </div>
        </section>


            <!-- Middle Row: SMS Inbox & USSD Console Side-by-Side (Expanded SMS Messenger & Reduced USSD Console) -->
            <div class="inboxes-grid grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch mt-4">
                <!-- 1. SMS Messenger Panel (Expanded 7/12 or 8/12 on larger screens) -->
                <div class="gsm-console-panel sms-inbox-panel panel-surface rounded-2xl flex flex-col h-[34rem] overflow-hidden border border-[var(--border-primary)] lg:col-span-7 xl:col-span-8" id="sms-messenger-container">
                    <!-- Top Bar -->
                    <div class="p-3 sm:px-4 flex items-center justify-between border-b border-[var(--border-primary)] bg-[var(--bg-card)]/80 gap-2 shrink-0">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="text-emerald-400 flex items-center justify-center shrink-0">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                            </div>
                            <div class="min-w-0">
                                <h3 class="text-xs sm:text-sm font-black text-[var(--text-primary)] uppercase tracking-wider truncate"><%= t.smsMessengerTitle || 'SMS Messenger' %></h3>
                                <p id="sms-inbox-device" class="text-[10px] text-[var(--text-muted)] font-mono truncate"><%= isRtl ? 'اختر جهازاً' : 'Select a dongle' %></p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button type="button" onclick="startNewChatPrompt()" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-[var(--accent-color)] hover:opacity-90 text-white flex items-center gap-1 transition cursor-pointer shadow-sm">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                                <span class="hidden sm:inline"><%= t.smsNewChat || 'New Chat' %></span>
                            </button>
                            <span id="sms-inbox-count" class="px-2 py-0.5 rounded-md bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[10px] font-mono font-bold text-[var(--text-secondary)]">0</span>
                            <button type="button" onclick="clearSmsInbox()" class="p-1.5 rounded-lg text-zinc-400 hover:text-rose-400 hover:bg-[var(--bg-hover)] transition cursor-pointer" title="<%= isRtl ? 'مسح كافة الرسائل' : 'Clear All Messages' %>">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </div>
                    </div>

                    <!-- Dual-Pane Body -->
                    <div class="flex-1 flex overflow-hidden min-h-0 relative">
                        <!-- Left Pane: Conversations / Endpoints List -->
                        <div id="sms-threads-pane" class="w-full sm:w-[32%] lg:w-[34%] xl:w-[28%] min-w-[200px] max-w-[300px] border-e border-[var(--border-primary)] flex flex-col bg-[var(--bg-primary)]/40 shrink-0">
                            <!-- Search & Filter Bar -->
                            <div class="p-2 border-b border-[var(--border-primary)] bg-[var(--bg-card)]/50 space-y-1.5 shrink-0">
                                <div class="relative">
                                    <input type="text" id="sms-thread-search" oninput="handleSmsSearch(this.value)" placeholder="<%= t.smsSearchPlaceholder || 'Search number or text...' %>" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1 text-xs text-[var(--text-primary)] placeholder-zinc-500 focus:outline-none focus:border-[var(--accent-color)] font-mono">
                                    <svg class="w-3.5 h-3.5 text-zinc-500 absolute end-2.5 top-2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                                </div>
                            </div>

                            <!-- Thread Roster -->
                            <div id="sms-threads-list" class="flex-1 overflow-y-auto divide-y divide-[var(--border-primary)]/30">
                                <div class="text-center py-10 text-[var(--text-muted)] text-xs italic" id="sms-empty-placeholder">
                                    <%= t.smsNoThreads || 'No conversations found' %>
                                </div>
                            </div>
                        </div>

                        <!-- Right Pane: Chat History & Composer (~62%) -->
                        <div id="sms-chat-pane" class="hidden sm:flex flex-1 flex-col bg-[var(--bg-card)]/30 overflow-hidden min-w-0">
                            <!-- Chat Active Header -->
                            <div id="sms-chat-header" class="px-3.5 py-2 border-b border-[var(--border-primary)] bg-[var(--bg-card)]/70 flex items-center justify-between gap-2 shrink-0">
                                <div class="flex items-center gap-2 min-w-0">
                                    <button type="button" onclick="backToThreadList()" class="sm:hidden p-1 rounded-lg hover:bg-[var(--bg-hover)] text-zinc-400 cursor-pointer" title="<%= t.smsBackToThreads || 'Back' %>">
                                        <svg class="w-4 h-4 rtl:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                                    </button>
                                    <div class="w-7 h-7 rounded-full bg-blue-500/20 text-blue-400 border border-blue-500/30 flex items-center justify-center font-bold text-xs font-mono shrink-0" id="sms-active-avatar">
                                        #
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-1.5">
                                            <span class="font-black text-xs text-white font-mono truncate" id="sms-active-number">-</span>
                                            <button type="button" id="sms-active-copy-btn" onclick="copyActiveNumber()" class="text-zinc-400 hover:text-white p-0.5 cursor-pointer" title="<%= t.smsCopyNumber || 'Copy number' %>">
                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                                            </button>
                                        </div>
                                        <p class="text-[10px] text-zinc-400 truncate" id="sms-active-contact-name"></p>
                                    </div>
                                </div>

                                <!-- Chat Actions (Dongle selector, delete thread) -->
                                <div class="flex items-center gap-1.5 shrink-0">
                                    <div class="w-40 sm:w-48 shrink-0">
                                        <select id="sms-reply-dongle" class="text-xs font-semibold font-mono" title="<%= t.smsSenderDongle || 'Sender Dongle' %>">
                                            <% if (devices && devices.length > 0) { %>
                                                <% devices.forEach(d => { %>
                                                    <option value="<%= d.ID %>" <%= d.ID === initialSelectedDongleId ? 'selected' : '' %>><%= d.ID %> (<%= d.Number || 'No SIM' %>)</option>
                                                <% }) %>
                                            <% } else { %>
                                                <option value="dongle0">dongle0 (No SIM)</option>
                                            <% } %>
                                        </select>
                                    </div>
                                    <button type="button" onclick="deleteActiveThread()" class="p-1.5 rounded-lg text-zinc-400 hover:text-rose-400 hover:bg-[var(--bg-hover)] transition cursor-pointer" title="<%= t.smsDeleteThreadConfirm || 'Delete thread' %>">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </div>
                            </div>

                            <!-- Scrollable Message Bubbles Stream -->
                            <div id="sms-messages-stream" class="flex-1 overflow-y-auto p-4 space-y-3">
                                <div class="text-center py-16 text-zinc-500 text-xs italic" id="sms-no-thread-selected">
                                    <%= t.smsSelectThreadHint || 'Select a conversation to view chat history' %>
                                </div>
                            </div>

                            <!-- Embedded Bottom Composer -->
                            <form id="sms-quick-composer-form" onsubmit="handleQuickSmsSubmit(event)" class="p-2.5 border-t border-[var(--border-primary)] bg-[var(--bg-card)]/80 flex items-end gap-2 shrink-0">
                                <div class="flex-1 min-w-0 relative">
                                    <textarea id="sms-composer-input" rows="2" required placeholder="<%= t.smsTypePlaceholder || 'Type a message... (Enter to send)' %>" onkeydown="handleComposerKeydown(event)" oninput="handleComposerInput(this)" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-xl p-2.5 text-xs text-[var(--text-primary)] placeholder-zinc-500 focus:outline-none focus:border-[var(--accent-color)] resize-none font-sans text-start" dir="auto"></textarea>
                                    <div class="flex items-center justify-between px-1 text-[9px] font-mono text-zinc-500">
                                        <span id="sms-composer-counter">0/160</span>
                                        <span class="hidden sm:inline text-zinc-500 text-[9px]"><%= t.smsShiftEnterHint || 'Shift+Enter for newline' %></span>
                                    </div>
                                </div>
                                <button type="submit" id="sms-composer-send-btn" class="bg-[var(--accent-color)] hover:opacity-90 text-white font-bold p-2.5 rounded-xl transition cursor-pointer flex items-center justify-center shrink-0 shadow-sm" title="<%= t.smsSendBtn || 'Send' %>">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 2. USSD Console Panel & Terminal Response (Reduced 5/12 or 4/12) -->
                <div class="gsm-console-panel panel-surface rounded-2xl p-5 flex flex-col gap-4 h-[34rem] lg:col-span-5 xl:col-span-4">
                    <!-- USSD Exec Section -->
                    <div class="flex flex-col gap-3 pb-3 border-b border-[var(--border-primary)] shrink-0">
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <h3 class="text-sm font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                                <div id="console-tab-icon" class="flex items-center justify-center text-indigo-400 shrink-0">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="4 17 10 11 4 5"></polyline>
                                        <line x1="12" y1="19" x2="20" y2="19"></line>
                                    </svg>
                                </div>
                                <span id="console-tab-title"><%= t.ussdTitle %></span>
                            </h3>
                            <div class="flex items-center gap-1 p-0.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)]">
                                <button type="button" id="tab-btn-ussd" onclick="switchConsoleTab('ussd')" class="px-3 py-1.5 rounded-lg text-xs font-black transition-all cursor-pointer bg-indigo-600 text-white border border-indigo-400 shadow-md flex items-center gap-1.5">
                                    <span class="font-mono font-black">&gt;_</span>
                                    <span><%= t.cfTabUssd || 'USSD >_' %></span>
                                </button>
                                <button type="button" id="tab-btn-forwarding" onclick="switchConsoleTab('forwarding')" class="px-3 py-1.5 rounded-lg text-xs font-extrabold transition-all cursor-pointer text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] border border-transparent flex items-center gap-1.5">
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l5 5-5 5"/><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v7a4 4 0 004 4h12"/></svg>
                                    <span><%= t.cfTabForwarding || (isRtl ? 'تحويل المكالمات' : 'Call Forwarding') %></span>
                                </button>
                            </div>
                        </div>

                        <form id="ussd-execution-form" class="flex flex-col gap-2.5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                                <div class="w-full">
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="ussd-target-dongle">
                                        <%= isRtl ? 'الشريحة المستهدفة *' : 'Target Dongle *' %>
                                    </label>
                                    <select id="ussd-target-dongle" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required>
                                        <option value="" disabled <%= initialSelectedDongleId ? '' : 'selected' %> hidden><%= t.selectPlaceholder %></option>
                                        <% if (devices && devices.length > 0) { %>
                                            <% devices.forEach(d => { %>
                                                <option value="<%= d.ID %>" <%= d.ID === initialSelectedDongleId ? 'selected' : '' %>><%= d.ID %> (<%= d.Number || 'Unknown SIM' %>)</option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>
                                
                                <div class="w-full">
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="ussd-code-input">
                                        <%= isRtl ? 'رمز الـ USSD *' : 'USSD Code *' %>
                                    </label>
                                    <div class="flex items-center bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-2.5 focus-within:border-indigo-500 transition-colors">
                                        <span class="text-indigo-400 font-bold font-mono text-xs leading-none select-none me-1.5">&gt;_</span>
                                        <input type="text" id="ussd-code-input" class="w-full bg-transparent border-0 outline-none py-1.5 text-xs text-[var(--text-primary)] font-mono placeholder-zinc-500" placeholder="e.g. *100# or *50#" required autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <button type="submit" id="ussd-submit-btn" class="config-btn-primary px-4 py-2 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer shrink-0 w-full">
                                <span id="btn-label"><%= t.sendBtn %></span>
                                <div id="btn-spinner" class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin hidden"></div>
                            </button>
                        </form>

                        <!-- Call Forwarding Helper Form -->
                        <form id="forwarding-execution-form" class="hidden flex flex-col gap-2.5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 items-end">
                                <div>
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-target-dongle">
                                        <%= isRtl ? 'الشريحة المستهدفة *' : 'Target Dongle *' %>
                                    </label>
                                    <select id="cf-target-dongle" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required>
                                        <option value="" disabled <%= initialSelectedDongleId ? '' : 'selected' %> hidden><%= t.selectPlaceholder %></option>
                                        <% if (devices && devices.length > 0) { %>
                                            <% devices.forEach(d => { %>
                                                <option value="<%= d.ID %>" <%= d.ID === initialSelectedDongleId ? 'selected' : '' %>><%= d.ID %> (<%= d.Number || 'Unknown SIM' %>)</option>
                                            <% }) %>
                                        <% } %>
                                    </select>
                                </div>

                                <div>
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-scenario">
                                        <%= t.cfScenario %> *
                                    </label>
                                    <select id="cf-scenario" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required onchange="onCfScenarioChange()">
                                        <option value="21"><%= t.cfAlways %></option>
                                        <option value="67"><%= t.cfBusy %></option>
                                        <option value="61"><%= t.cfNoReply %></option>
                                        <option value="62"><%= t.cfNotReachable %></option>
                                        <option value="004"><%= t.cfAllConditional %></option>
                                        <option value="002"><%= t.cfAllForwarding %></option>
                                    </select>
                                </div>

                                <div>
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-action">
                                        <%= t.cfAction %> *
                                    </label>
                                    <select id="cf-action" class="config-input w-full py-1.5 text-xs font-semibold cursor-pointer" required onchange="onCfActionChange()">
                                        <option value="activate"><%= t.cfActionActivate %></option>
                                        <option value="query"><%= t.cfActionQuery %></option>
                                        <option value="cancel"><%= t.cfActionCancel %></option>
                                    </select>
                                </div>

                                <div id="cf-number-container">
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase block mb-1" for="cf-number-input">
                                        <%= t.cfForwardToNumber %> *
                                    </label>
                                    <div class="flex items-center bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg px-2.5 focus-within:border-emerald-500 transition-colors">
                                        <svg class="w-3.5 h-3.5 text-emerald-400 me-1.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                        <input type="tel" id="cf-number-input" class="w-full bg-transparent border-0 outline-none py-1.5 text-xs text-[var(--text-primary)] font-mono placeholder-zinc-500" placeholder="01011719380" required autocomplete="off">
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between gap-3 pt-1 flex-wrap">
                                <div id="cf-delay-container" class="hidden items-center gap-2">
                                    <label class="text-[10px] font-bold text-[var(--text-secondary)] uppercase" for="cf-delay-select">
                                        <%= t.cfNoReplyDelay %>:
                                    </label>
                                    <select id="cf-delay-select" class="config-input py-1 text-xs font-mono">
                                        <option value="20">20 <%= t.cfDefaultSec %></option>
                                        <option value="5">5 <%= t.cfSeconds %></option>
                                        <option value="10">10 <%= t.cfSeconds %></option>
                                        <option value="15">15 <%= t.cfSeconds %></option>
                                        <option value="25">25 <%= t.cfSeconds %></option>
                                        <option value="30">30 <%= t.cfSeconds %></option>
                                    </select>
                                </div>

                                <div class="ms-auto flex items-center gap-2">
                                    <button type="submit" id="cf-submit-btn" class="config-btn-primary px-5 py-2 text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer">
                                        <span id="cf-btn-label"><%= t.cfSendBtn %></span>
                                        <div id="cf-btn-spinner" class="w-3.5 h-3.5 border-2 border-white/30 border-t-white rounded-full animate-spin hidden"></div>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                    <!-- USSD Terminal Display -->
                    <div class="terminal-container flex flex-col flex-1 min-h-[220px] rounded-xl overflow-hidden shadow-sm">
                        <div class="terminal-screen p-4 flex-1 overflow-y-auto text-xs font-mono flex flex-col gap-2 rounded-xl select-text" id="terminal-screen">
                            <div class="font-mono text-xs select-none p-3.5 rounded-lg" id="terminal-placeholder">
                                <%= t.terminalPlaceholder %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <!-- 4. Dongle & SIM State Duration Analytics Section (Redesigned) -->
        <section class="panel-surface rounded-2xl overflow-hidden shrink-0 flex flex-col gap-0 border border-[var(--border-primary)] mt-4" id="dongle-duration-stats-section">
            <!-- Section Header -->
            <div class="p-4 sm:px-6 border-b border-[var(--border-primary)] bg-[var(--bg-card)]/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="text-sky-400 flex items-center justify-center shrink-0">
                        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10" />
                            <line x1="12" y1="20" x2="12" y2="4" />
                            <line x1="6" y1="20" x2="6" y2="14" />
                            <path d="M3 13l5-5 5 5 8-8" />
                            <polyline points="16 5 21 5 21 10" />
                        </svg>
                    </div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="text-sm sm:text-base font-black text-[var(--text-primary)] uppercase tracking-wider"><%= t.stateDurationTitle %></h3>
                        <span class="text-[10px] px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 font-mono font-bold tracking-wider uppercase"><%= isRtl ? 'الحالات والجهوزية' : 'Activity & States' %></span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="fetchDongleStateReports()" id="dongle-report-refresh-btn" class="dongle-action-button dongle-action-primary cursor-pointer px-3.5 py-1.5 h-8 rounded-xl text-xs font-bold flex items-center gap-1.5">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                        <span><%= isRtl ? 'تحديث' : 'Refresh' %></span>
                    </button>
                </div>
            </div>

            <!-- Filters Bar -->
            <div class="p-4 sm:px-6 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/40 space-y-3">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="reportStartDate"><%= t.reportStartTime %></label>
                        <input type="datetime-local" id="reportStartDate" name="reportStartDate" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] font-mono">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="reportEndDate"><%= t.reportEndTime %></label>
                        <input type="datetime-local" id="reportEndDate" name="reportEndDate" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] font-mono">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="reportDongleSelect"><%= t.reportDongle %></label>
                        <select id="reportDongleSelect" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] font-mono">
                            <option value="ALL"><%= t.reportAllDongles %></option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="reportSimSelect"><%= t.reportSim %></label>
                        <select id="reportSimSelect" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] font-mono">
                            <option value="ALL"><%= t.reportAllSims %></option>
                        </select>
                    </div>
                </div>
                <!-- Working Hours & Shift Filter -->
                <div class="pt-2 border-t border-[var(--border-primary)]/60">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-2.5">
                        <div class="flex items-center gap-3">
                            <label class="relative inline-flex items-center cursor-pointer select-none">
                                <input type="checkbox" id="reportWorkHoursEnabled" class="sr-only peer" onchange="toggleReportWorkHours(this.checked)">
                                <div class="w-9 h-5 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[var(--accent-color)]"></div>
                                <span class="ms-2 text-xs font-bold text-[var(--text-primary)]"><%= t.reportShiftFilter %></span>
                            </label>
                            <span class="text-[10px] text-[var(--text-muted)] hidden sm:inline"><%= t.reportShiftFilterDesc %></span>
                        </div>
                        <div id="report-shift-controls" class="hidden flex-wrap items-center gap-3">
                            <!-- Shift Start & End Hours -->
                            <div class="flex items-center gap-2">
                                <div class="flex items-center gap-1">
                                    <label for="reportShiftStart" class="text-[10px] font-bold text-[var(--text-secondary)] uppercase"><%= t.reportShiftStart %>:</label>
                                    <input type="time" id="reportShiftStart" value="09:00" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2 py-1 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-[var(--accent-color)]">
                                </div>
                                <span class="text-zinc-500 font-bold text-xs">-</span>
                                <div class="flex items-center gap-1">
                                    <label for="reportShiftEnd" class="text-[10px] font-bold text-[var(--text-secondary)] uppercase"><%= t.reportShiftEnd %>:</label>
                                    <input type="time" id="reportShiftEnd" value="17:00" class="bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2 py-1 text-xs text-[var(--text-primary)] font-mono focus:outline-none focus:border-[var(--accent-color)]">
                                </div>
                            </div>
                            <!-- Workdays Quick Presets & Day Pills -->
                            <div class="flex items-center gap-1.5 flex-wrap">
                                <span class="text-[10px] font-bold text-[var(--text-secondary)] uppercase"><%= t.reportWorkDays %>:</span>
                                <button type="button" onclick="setReportWorkDaysPreset('sun-thu')" class="px-2 py-0.5 text-[10px] font-semibold rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-300 hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= t.reportPresetSunThu %></button>
                                <button type="button" onclick="setReportWorkDaysPreset('mon-fri')" class="px-2 py-0.5 text-[10px] font-semibold rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-300 hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= t.reportPresetMonFri %></button>
                                <button type="button" onclick="setReportWorkDaysPreset('all')" class="px-2 py-0.5 text-[10px] font-semibold rounded bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-300 hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer"><%= t.reportPresetAllDays %></button>
                                <!-- Day Pills Checkboxes (0=Sun .. 6=Sat) -->
                                <div class="flex items-center gap-1 ms-1" id="report-workdays-pills">
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="0" checked class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.daySun %></span></label>
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="1" checked class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.dayMon %></span></label>
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="2" checked class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.dayTue %></span></label>
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="3" checked class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.dayWed %></span></label>
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="4" checked class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.dayThu %></span></label>
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="5" class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.dayFri %></span></label>
                                    <label class="cursor-pointer select-none"><input type="checkbox" name="reportWorkDay" value="6" class="sr-only peer"><span class="px-1.5 py-0.5 text-[9px] font-mono font-bold rounded border border-zinc-700 bg-zinc-800 text-zinc-400 peer-checked:bg-sky-500/20 peer-checked:text-sky-300 peer-checked:border-sky-500/40"><%= t.daySat %></span></label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
                    <div class="flex flex-wrap items-center gap-1.5">
                        <span class="text-[11px] font-bold text-zinc-300 me-1"><%= t.reportQuickPresets %></span>
                        <button type="button" onclick="setDongleReportPreset('today')" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-200 hover:text-white hover:border-[var(--accent-color)] hover:bg-[var(--bg-hover)] transition-all cursor-pointer"><%= t.reportToday %></button>
                        <button type="button" onclick="setDongleReportPreset('yesterday')" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-200 hover:text-white hover:border-[var(--accent-color)] hover:bg-[var(--bg-hover)] transition-all cursor-pointer"><%= t.reportYesterday %></button>
                        <button type="button" onclick="setDongleReportPreset('7days')" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-200 hover:text-white hover:border-[var(--accent-color)] hover:bg-[var(--bg-hover)] transition-all cursor-pointer"><%= t.report7Days %></button>
                        <button type="button" onclick="setDongleReportPreset('30days')" class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-zinc-200 hover:text-white hover:border-[var(--accent-color)] hover:bg-[var(--bg-hover)] transition-all cursor-pointer"><%= t.report30Days %></button>
                    </div>

                    <button type="button" onclick="fetchDongleStateReports()" class="bg-[var(--accent-color)] hover:opacity-90 text-white font-bold rounded-xl px-4 py-2 text-xs transition cursor-pointer flex items-center justify-center gap-1.5 shadow-md">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                        <span><%= t.reportGenerateBtn %></span>
                    </button>
                </div>
            </div>

            <!-- Global KPI Summary Cards -->
            <div class="p-4 sm:p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                <!-- Ready / Free KPI -->
                <div class="p-4 rounded-2xl border border-emerald-500/20 bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-transparent flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <span class="text-[11px] font-black uppercase tracking-wider text-emerald-400"><%= t.reportReadyFree %></span>
                            </div>
                            <span class="text-xs font-mono font-black text-emerald-600" id="report-kpi-free-pct">0%</span>
                        </div>
                        <p class="text-2xl font-black text-white mt-2 font-mono" id="report-kpi-free-dur">0s</p>
                        <p class="text-[11px] text-zinc-300 mt-1 font-medium"><%= t.reportReadyFreeDesc %></p>
                    </div>
                </div>

                <!-- In Call / Busy KPI (with Inbound & Outbound branch) -->
                <div class="p-4 rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-500/15 via-blue-500/5 to-transparent flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
                                <span class="text-[11px] font-black uppercase tracking-wider text-blue-400"><%= t.reportInCall %></span>
                            </div>
                            <span class="text-xs font-mono font-black text-blue-300" id="report-kpi-busy-pct">0%</span>
                        </div>
                        <p class="text-2xl font-black text-white mt-1.5 font-mono" id="report-kpi-busy-dur">0s</p>
                        <p class="text-[11px] text-zinc-300 mt-0.5 font-medium"><%= t.reportInCallDesc %></p>
                    </div>
                    <!-- Incoming & Outgoing Branch -->
                    <div class="mt-3 pt-2.5 border-t border-blue-500/20 grid grid-cols-2 gap-2">
                        <div class="p-2 rounded-xl bg-cyan-300 border border-cyan-400 flex flex-col text-black">
                            <div class="flex items-center gap-1 text-black text-[10px] font-bold">
                                <svg class="w-3 h-3 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
                                <span class="text-black font-black"><%= t.reportInboundBranch %></span>
                            </div>
                            <span class="text-sm font-black font-mono text-black mt-1" id="report-kpi-inbound-dur">0s</span>
                            <span class="text-[10px] text-black font-mono font-bold" id="report-kpi-inbound-calls">0 calls</span>
                        </div>
                        <div class="p-2 rounded-xl bg-indigo-200 border border-indigo-300 flex flex-col text-black">
                            <div class="flex items-center gap-1 text-black text-[10px] font-bold">
                                <svg class="w-3 h-3 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                                <span class="text-black font-black"><%= t.reportOutboundBranch %></span>
                            </div>
                            <span class="text-sm font-black font-mono text-black mt-1" id="report-kpi-outbound-dur">0s</span>
                            <span class="text-[10px] text-black font-mono font-bold" id="report-kpi-outbound-calls">0 calls</span>
                        </div>
                    </div>
                </div>

                <!-- Not Initialized KPI -->
                <div class="p-4 rounded-2xl border border-rose-500/20 bg-gradient-to-br from-rose-500/10 via-rose-500/5 to-transparent flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-rose-400"></span>
                                <span class="text-[11px] font-black uppercase tracking-wider text-rose-400"><%= t.reportNotInit %></span>
                            </div>
                            <span class="text-xs font-mono font-black text-rose-600" id="report-kpi-notinit-pct">0%</span>
                        </div>
                        <p class="text-2xl font-black text-white mt-2 font-mono" id="report-kpi-notinit-dur">0s</p>
                        <p class="text-[11px] text-zinc-300 mt-1 font-medium"><%= t.reportNotInitDesc %></p>
                    </div>
                </div>

                <!-- Disconnected KPI -->
                <div class="p-4 rounded-2xl border border-amber-500/20 bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                                <span class="text-[11px] font-black uppercase tracking-wider text-amber-400"><%= t.reportDisconnected %></span>
                            </div>
                            <span class="text-xs font-mono font-black text-amber-600" id="report-kpi-notconn-pct">0%</span>
                        </div>
                        <p class="text-2xl font-black text-white mt-2 font-mono" id="report-kpi-notconn-dur">0s</p>
                        <p class="text-[11px] text-zinc-300 mt-1 font-medium"><%= t.reportDisconnectedDesc %></p>
                    </div>
                </div>
            </div>

            <!-- Detailed Reports Table -->
            <div class="px-4 sm:px-6 pb-6 space-y-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-[var(--bg-card)] p-2.5 rounded-xl border border-[var(--border-primary)]">
                    <!-- Tabs Switcher -->
                    <div class="flex items-center gap-1.5">
                        <button type="button" id="report-tab-dongles-btn" onclick="setDongleReportTab('dongles')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition bg-[var(--accent-color)] text-white shadow-sm cursor-pointer">
                            <%= t.reportTabDongles %>
                        </button>
                        <button type="button" id="report-tab-sims-btn" onclick="setDongleReportTab('sims')" class="px-3.5 py-1.5 rounded-lg text-xs font-bold transition text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] cursor-pointer">
                            <%= t.reportTabSims %>
                        </button>
                    </div>
                    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]">
                        <span><%= t.reportWindow %></span>
                        <span id="report-window-label" class="text-[var(--text-primary)] font-bold">-</span>
                    </div>
                </div>

                <div class="rounded-xl border border-[var(--border-primary)] overflow-hidden bg-[var(--bg-card)]">
                    <div class="overflow-x-auto">
                        <table class="w-full text-start border-collapse text-xs">
                            <thead>
                                <tr class="bg-black/60 border-b border-[var(--border-primary)] text-[11px] uppercase font-black text-zinc-200 tracking-wider">
                                    <th class="py-3 px-4 text-start" id="report-col-target-header"><%= t.reportColDongle %></th>
                                    <th class="py-3 px-4 text-start" id="report-col-subtarget-header"><%= t.reportColSim %></th>
                                    <th class="py-3 px-4 text-start"><%= t.reportColFree %></th>
                                    <th class="py-3 px-4 text-start"><%= t.reportColBusy %></th>
                                    <th class="py-3 px-4 text-start"><%= t.reportColNotInit %></th>
                                    <th class="py-3 px-4 text-start"><%= t.reportColDisconnected %></th>
                                    <th class="py-3 px-4 text-start min-w-[140px]"><%= t.reportColDistribution %></th>
                                    <th class="py-3 px-4 text-start"><%= t.reportColCallsTalk %></th>
                                    <th class="py-3 px-4 text-center"><%= t.reportColUptime %></th>
                                </tr>
                            </thead>
                            <tbody id="report-table-body" class="divide-y divide-[var(--border-primary)]/50 font-mono text-xs">
                                <tr>
                                    <td colspan="9" class="py-8 text-center text-xs text-[var(--text-muted)] font-sans">
                                        <%= t.reportLoading %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </section>

            <!-- Lower Row: Selected Device Details (Short, Wide & Dense Horizontal Card directly under SMS & USSD) -->
            <div id="device-details-panel" class="panel-surface rounded-2xl p-5 flex flex-col gap-4 mt-4 w-full">
                <!-- Header with ID & Live Diagnostics Badges -->
                <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 border-b border-[var(--border-primary)] pb-3">
                    <div class="flex items-center gap-3">
                        <div class="text-[var(--accent-color)] flex items-center justify-center shrink-0 font-bold">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                <path d="M9 3v18M13 8h4M13 12h4M13 16h2"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-sm font-extrabold text-[var(--text-primary)] uppercase tracking-wider flex items-center gap-2 flex-wrap">
                                <span><%= isRtl ? 'تفاصيل ومواصفات الجهاز' : 'Selected Device Specifications' %></span>
                                <span id="info-id" class="px-2.5 py-0.5 rounded-lg bg-red-500/10 text-[var(--accent-color)] border border-red-500/20 font-mono text-xs font-black">-</span>
                            </h4>
                            <p class="text-[10px] text-[var(--text-muted)] mt-0.5"><%= isRtl ? 'بيانات الهوية والعتاد والتشخيص المباشر للمودم المحدد' : 'Hardware identification, firmware specs, and live diagnostics' %></p>
                        </div>
                    </div>

                    <!-- Live Signal & Service Status Strip -->
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)]">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase"><%= isRtl ? 'الإشارة' : 'Signal' %>:</span>
                            <div class="flex items-end gap-0.5 h-[14px] shrink-0" id="diag-signal-bars"></div>
                            <span id="diag-signal-text" class="text-xs font-bold text-[var(--text-primary)] font-mono whitespace-nowrap">-</span>
                        </div>

                        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)]">
                            <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase"><%= isRtl ? 'الخدمة' : 'Service' %>:</span>
                            <div id="diag-service-badge"></div>
                            <span id="diag-carrier-text" class="text-xs font-bold text-[var(--accent-color)]">-</span>
                        </div>

                        <div class="flex items-center gap-2.5 px-3 py-1.5 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[10px]">
                            <div><span class="text-[9px] font-bold text-[var(--text-muted)] uppercase me-1"><%= isRtl ? 'صوت' : 'Voice' %>:</span><span id="chk-voice" class="text-zinc-500 font-bold font-mono">-</span></div>
                            <div class="border-s border-[var(--border-primary)] ps-2.5"><span class="text-[9px] font-bold text-[var(--text-muted)] uppercase me-1"><%= isRtl ? 'رسائل' : 'SMS' %>:</span><span id="chk-sms" class="text-zinc-500 font-bold font-mono">-</span></div>
                            <div class="border-s border-[var(--border-primary)] ps-2.5"><span class="text-[9px] font-bold text-[var(--text-muted)] uppercase me-1">USSD:</span><span id="chk-ussd" class="text-zinc-500 font-bold font-mono">-</span></div>
                        </div>
                    </div>
                </div>

                <!-- Dense Horizontal Multi-Column Grid (8 Columns on Desktop) -->
                <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5">
                    <div class="gsm-detail-field">
                        <span class="gsm-detail-label"><%= t.thNumber %></span>
                        <div class="flex items-center gap-1 min-w-0">
                            <span id="info-number" class="gsm-detail-value font-mono flex-1 text-xs sm:text-sm font-black truncate">-</span>
                            <button onclick="copyToClipboard(document.getElementById('info-number').textContent, this)" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded transition cursor-pointer shrink-0" title="<%= isRtl ? 'نسخ' : 'Copy' %>">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                            </button>
                            <button onclick="editSimNumber(document.getElementById('info-id').textContent, document.getElementById('info-imsi').textContent, document.getElementById('info-number').textContent === 'Unknown' || document.getElementById('info-number').textContent === '-' ? '' : document.getElementById('info-number').textContent)" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] p-1 rounded transition cursor-pointer shrink-0" title="<%= isRtl ? 'تعديل' : 'Edit' %>">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 113 3L12 15l-4 1 1-4z"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.thProvider %></span><span id="info-provider" class="gsm-detail-value text-[var(--accent-color)] text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.thIMEI %></span><span id="info-imei" class="gsm-detail-value font-mono text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.thIMSI %></span><span id="info-imsi" class="gsm-detail-value font-mono text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.model %></span><span id="info-model" class="gsm-detail-value text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.firmware %></span><span id="info-firmware" class="gsm-detail-value font-mono text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.group %></span><span id="info-group" class="gsm-detail-value text-xs sm:text-sm font-black truncate">-</span></div>
                    <div class="gsm-detail-field"><span class="gsm-detail-label"><%= t.mode %> / <%= t.submode %></span><span class="gsm-detail-value text-xs sm:text-sm font-black truncate"><span id="info-mode">-</span> / <span id="info-submode">-</span></span></div>
                </div>
            </div>

        <!-- USB Hardware (lsusb) & Serial Endpoints (/dev/ttyUSB*) Dual Monitor -->
        <section class="panel-surface rounded-2xl p-5 sm:p-6 flex flex-col gap-5 shrink-0">
            <!-- Header with Live Metric Badges -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-[var(--border-primary)]">
                <div>
                    <h3 class="text-sm font-extrabold text-[var(--text-primary)] flex items-center gap-2">
                        <svg class="w-4 h-4 text-[var(--accent-color)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
                        <%= t.usbHardwareMonitor %>
                    </h3>
                    <p class="text-[11px] text-[var(--text-muted)] mt-1"><%= t.usbHardwareDesc %></p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span id="lsusb-modems-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold font-mono bg-purple-500/15 text-purple-300 border border-purple-500/30 flex items-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
                        <span id="lsusb-modems-count">0 <%= t.lsusbModemsBadge %></span>
                    </span>
                    <span id="lsusb-tty-badge" class="px-2.5 py-1 rounded-lg text-xs font-bold font-mono bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        <span id="lsusb-tty-count">0 <%= t.lsusbTtyBadge %></span>
                    </span>
                    <button type="button" onclick="refreshUsbDevices()" class="p-1.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-white hover:border-[var(--accent-color)] transition-all cursor-pointer" title="<%= isRtl ? 'إعادة فحص USB' : 'Refresh USB Devices' %>">
                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </button>
                </div>
            </div>

            <!-- Tier 1: Physical USB Hardware Devices (lsusb) -->
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-secondary)] flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        <%= t.lsusbPhysicalDevices %>
                    </h4>
                    <span class="text-[10px] text-[var(--text-muted)] font-mono">Bus / Dev ID</span>
                </div>
                <div id="lsusb-devices-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                    <div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading physical hardware...</div>
                </div>
            </div>

            <!-- Tier 2: OS Serial Character Endpoints (/dev/ttyUSB*) -->
            <div class="space-y-2 pt-2 border-t border-[var(--border-primary)]/60">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-black uppercase tracking-wider text-[var(--text-secondary)] flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                        <%= t.lsusbSerialEndpoints %>
                    </h4>
                    <span class="text-[10px] text-[var(--text-muted)] font-mono"><%= isRtl ? 'الصوت / البيانات' : 'Audio / Data Channels' %></span>
                </div>
                <div id="usb-devices-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
                    <div class="text-[var(--text-muted)] text-xs italic col-span-full py-4 text-center">Loading serial endpoints...</div>
                </div>
            </div>
        </section>

        <!-- Collapsible logs console (Bottom) -->
        <div class="panel-surface rounded-2xl flex flex-col shrink-0 mt-4">
            <div class="p-4 sm:px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-black/40 border-b border-[var(--border-primary)] rounded-t-2xl <%= isRtl ? 'sm:flex-row-reverse' : '' %>">
                <h3 class="text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider flex items-center gap-2">
                    <div class="relative flex items-center justify-center">
                        <span class="animate-ping absolute inline-flex h-2 w-2 rounded-full bg-[var(--accent-color)] opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--accent-color)]"></span>
                    </div>
                    <%= t.logTitle %>
                </h3>
                
                <div class="w-full sm:w-auto flex flex-wrap items-center gap-3 sm:gap-4 text-xs font-semibold select-none <%= isRtl ? 'flex-row-reverse' : '' %>">
                    <div class="flex items-center gap-2">
                        <span><%= t.logToggle %></span>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="logs-toggle-switch" class="sr-only peer">
                            <div class="w-8 h-4 bg-zinc-800 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-0.5 after:left-[2px] after:bg-white after:border-zinc-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-[var(--accent-color)]"></div>
                        </label>
                    </div>
                    
                    <label class="flex items-center gap-1.5 cursor-pointer">
                        <input type="checkbox" id="logs-autoscroll-chk" checked class="accent-[var(--accent-color)] rounded font-bold">
                        <span><%= t.autoscroll %></span>
                    </label>
                    
                    <button id="clear-logs-btn" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer font-bold uppercase tracking-wider"><%= t.clearBtn %></button>
                </div>
            </div>
            
            <div class="log-screen p-5 text-[10px] text-[var(--text-secondary)] flex flex-col gap-1.5 rounded-b-2xl hidden" id="log-screen-console">
                <div class="text-[var(--text-muted)]">[System] Stream listener initialized. Awaiting hardware events...</div>
            </div>
        </div>

    </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="fixed bottom-5 z-[999999] flex flex-col gap-2.5 max-w-sm pointer-events-none <%= isRtl ? 'left-5' : 'right-5' %>"></div>

    <!-- Top Center Prominent Alert Banner Container (for Critical Hardware / SIM Warnings) -->
    <div id="top-alert-container" class="fixed top-5 left-1/2 -translate-x-1/2 z-[9999999] flex flex-col items-center gap-3 pointer-events-none w-full max-w-xl px-4"></div>

    <!-- SMS Detail Modal -->
    <!-- Send SMS Modal -->
    <div id="send-sms-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200">
        <div id="send-sms-modal-card" class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl w-full max-w-md p-6 scale-95 opacity-0 transition-all duration-200 flex flex-col gap-4 mx-4 shadow-2xl">
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3">
                <h3 class="text-base font-bold text-[var(--text-primary)] flex items-center gap-2">
                    <svg class="text-[var(--accent-color)]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    <span><%= isRtl ? 'إرسال رسالة SMS جديدة' : 'Send SMS Message' %></span>
                </h3>
                <button onclick="closeSendSmsModal()" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer p-1 rounded-lg hover:bg-[var(--bg-hover)]">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>

            <!-- Form -->
            <form id="sendSmsForm" onsubmit="handleSendSmsSubmit(event)" class="flex flex-col gap-4">
                <!-- Sender Selection (Dongle ID or SIM Number) -->
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5" for="smsSenderSelect">
                        <%= isRtl ? 'من الشريحة / الدونجل (From)' : 'Sender (Dongle ID / SIM Number)' %>
                    </label>
                    <select id="smsSenderSelect" class="w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3 py-2 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                        <!-- Populated dynamically from active devices -->
                    </select>
                </div>

                <!-- Recipient Phone Number -->
                <div>
                    <label class="block text-xs font-bold text-[var(--text-secondary)] mb-1.5" for="smsRecipientInput">
                        <%= isRtl ? 'إلى رقم الهاتف (To)' : 'Recipient Phone Number' %>
                    </label>
                    <input type="text" id="smsRecipientInput" required placeholder="+201012345678" class="w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3 py-2 text-sm text-[var(--text-primary)] font-mono focus:outline-none focus:border-[var(--accent-color)]">
                </div>

                <!-- SMS Body -->
                <div>
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="text-xs font-bold text-[var(--text-secondary)]" for="smsMessageInput">
                            <%= isRtl ? 'نص الرسالة' : 'Message' %>
                        </label>
                        <span id="smsCharCounter" class="text-[10px] font-mono text-[var(--text-muted)]">0/160</span>
                    </div>
                    <textarea id="smsMessageInput" required rows="4" oninput="updateSmsCounter(this)" placeholder="<%= isRtl ? 'اكتب نص الرسالة هنا...' : 'Type your message here...' %>" class="w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl p-3 text-sm text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] resize-none"></textarea>
                </div>

                <!-- Modal Actions -->
                <div class="flex justify-end gap-2.5 pt-2 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeSendSmsModal()" class="px-4 py-2 rounded-xl text-xs font-bold text-[var(--text-secondary)] hover:bg-[var(--bg-card)] transition">
                        <%= isRtl ? 'إلغاء' : 'Cancel' %>
                    </button>
                    <button type="submit" id="sendSmsSubmitBtn" class="btn-primary text-xs px-6 py-2.5 min-w-[140px] flex items-center justify-center gap-2">
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
                        <span id="sendSmsSubmitText" class="whitespace-nowrap font-bold"><%= isRtl ? 'إرسال الرسالة' : 'Send Message' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div id="sms-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200">
        <div id="sms-modal-card" class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl w-full max-w-lg p-6 scale-95 opacity-0 transition-all duration-200 flex flex-col gap-4 mx-4">
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3">
                <h3 class="text-lg font-bold text-[var(--text-primary)] flex items-center gap-2">
                    <svg class="text-[var(--accent-color)]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    <span id="sms-modal-title"><%= isRtl ? 'تفاصيل الرسالة' : 'SMS Message Details' %></span>
                </h3>
                <button onclick="closeSmsModal()" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer p-1 rounded-lg hover:bg-[var(--bg-hover)]">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <!-- Modal Body -->
            <div class="flex flex-col gap-3.5">
                <!-- Meta Row -->
                <div class="flex flex-wrap items-center justify-between gap-2 text-xs">
                    <div class="flex items-center gap-2">
                        <span id="sms-modal-dongle" class="bg-[var(--accent-color)] text-white font-mono font-bold px-2 py-0.5 rounded text-[10px] uppercase"></span>
                        <span id="sms-modal-sender" class="text-[var(--text-primary)] font-bold font-mono text-sm"></span>
                        <button id="sms-modal-copy-sender" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] p-0.5 rounded transition cursor-pointer" title="Copy Number">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                        </button>
                    </div>
                    <span id="sms-modal-time" class="text-[var(--text-muted)] font-mono"></span>
                </div>
                <!-- Content Area -->
                <div class="bg-[var(--bg-card)] border border-[var(--border-primary)] p-4 rounded-xl max-h-[250px] overflow-y-auto">
                    <p id="sms-modal-content" class="text-sm text-[var(--text-secondary)] leading-relaxed select-text whitespace-pre-wrap font-sans"></p>
                </div>
            </div>
            <!-- Modal Footer -->
            <div class="flex justify-end pt-2">
                <button onclick="closeSmsModal()" class="bg-[var(--bg-secondary)] hover:bg-[var(--bg-hover)] text-[var(--text-primary)] font-semibold rounded-lg px-5 py-2 text-sm transition cursor-pointer border border-[var(--border-primary)]">
                    <%= isRtl ? 'إغلاق' : 'Close' %>
                </button>
            </div>
        </div>
    </div>

    <!-- Edit TTY Ports Modal -->
    <div id="edit-ports-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-200">
        <div id="edit-ports-modal-card" class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl w-full max-w-md p-6 scale-95 opacity-0 transition-all duration-200 flex flex-col gap-4 mx-4">
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3">
                <h3 class="text-lg font-bold text-[var(--text-primary)] flex items-center gap-2">
                    <svg class="text-[var(--accent-color)]" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 17l6-6-6-6"/><path d="M12 19h8"/><circle cx="7" cy="12" r="3"/><path d="M17 7l4 4-4 4"/>
                    </svg>
                    <span id="edit-ports-modal-title"><%= t.editPortsModalTitle %></span>
                </h3>
                <button type="button" onclick="closeEditPortsModal()" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer p-1 rounded-lg hover:bg-[var(--bg-hover)]">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <!-- Modal Body -->
            <form id="edit-ports-form" onsubmit="saveDonglePorts(event)" class="flex flex-col gap-4">
                <input type="hidden" id="edit-ports-dongle-id" value="">
                
                <div class="flex items-center justify-between p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)]">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-[var(--text-muted)] uppercase"><%= isRtl ? 'الشريحة المستهدفة:' : 'Target Dongle:' %></span>
                        <span id="edit-ports-dongle-badge" class="bg-[var(--accent-color)] text-white font-mono font-bold px-2.5 py-0.5 rounded-lg text-xs uppercase shadow-sm"></span>
                    </div>
                    <span class="text-[10px] text-[var(--text-muted)] font-mono">/etc/asterisk/dongle.conf</span>
                </div>

                <!-- Audio & Data Inputs -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="edit-ports-audio" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1 flex items-center justify-between">
                            <span class="flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                                <%= isRtl ? 'منفذ الصوت (Audio)' : 'Audio Port (Voice)' %>
                            </span>
                        </label>
                        <input type="text" id="edit-ports-audio" required pattern="^/dev/ttyUSB[0-9]+$" placeholder="/dev/ttyUSB1" oninput="validatePortsForm()" class="w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none focus:border-emerald-400">
                        <span class="text-[10px] text-[var(--text-muted)] mt-1 block font-mono">audio=/dev/ttyUSBX</span>
                    </div>

                    <div>
                        <label for="edit-ports-data" class="block text-xs font-bold text-[var(--text-secondary)] uppercase mb-1 flex items-center justify-between">
                            <span class="flex items-center gap-1">
                                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                                <%= isRtl ? 'منفذ الأوامر (Data)' : 'Data Port (AT)' %>
                            </span>
                        </label>
                        <input type="text" id="edit-ports-data" required pattern="^/dev/ttyUSB[0-9]+$" placeholder="/dev/ttyUSB2" oninput="validatePortsForm()" class="w-full bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2.5 text-xs font-mono text-[var(--text-primary)] focus:outline-none focus:border-cyan-400">
                        <span class="text-[10px] text-[var(--text-muted)] mt-1 block font-mono">data=/dev/ttyUSBX</span>
                    </div>
                </div>

                <!-- Conflict Warning -->
                <div id="edit-ports-conflict-warning" class="hidden p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-bold flex items-center gap-2">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span><%= isRtl ? 'تنبيه: لا يمكن أن يكون منفذ الصوت ومنفذ البيانات نفس المنفذ' : 'Conflict: Audio Port and Data Port cannot be the same device' %></span>
                </div>

                <!-- Detected System Serial Devices List -->
                <div class="rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] p-3 flex flex-col gap-2">
                    <div class="flex items-center justify-between border-b border-[var(--border-primary)]/60 pb-2">
                        <span class="text-[10px] font-extrabold text-[var(--text-secondary)] uppercase tracking-wider">
                            <%= isRtl ? 'المنافذ المكتشفة في السيرفر (انقر لتعيين المنفذ فوراً):' : 'Detected System Ports (Click to assign directly):' %>
                        </span>
                        <button type="button" onclick="loadDetectedPortsList()" class="text-[10px] text-[var(--accent-color)] hover:underline font-bold cursor-pointer">
                            <%= isRtl ? 'تحديث المنافذ' : 'Refresh Ports' %>
                        </button>
                    </div>
                    <div id="detected-ports-chips" class="flex flex-col gap-1.5 max-h-[160px] overflow-y-auto pr-1">
                        <span class="text-xs text-[var(--text-muted)] py-2 text-center"><%= isRtl ? 'جاري فحص المنافذ...' : 'Scanning detected ports...' %></span>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="flex items-center justify-end gap-2 pt-2 border-t border-[var(--border-primary)]">
                    <button type="button" onclick="closeEditPortsModal()" class="bg-[var(--bg-secondary)] hover:bg-[var(--bg-hover)] text-[var(--text-primary)] font-semibold rounded-xl px-4 py-2 text-xs transition cursor-pointer border border-[var(--border-primary)]">
                        <%= isRtl ? 'إلغاء' : 'Cancel' %>
                    </button>
                    <button type="submit" id="save-ports-submit-btn" class="bg-[var(--accent-color)] hover:opacity-90 text-white font-bold rounded-xl px-5 py-2 text-xs transition cursor-pointer flex items-center gap-1.5 shadow-md">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                        <span><%= isRtl ? 'حفظ التغييرات' : 'Save Changes' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- GSM Dongle & dongle.conf Audit Modal -->
    <div id="dongle-audit-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-200">
        <div id="dongle-audit-modal-card" class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl w-full max-w-4xl p-5 sm:p-6 scale-95 opacity-0 transition-all duration-200 flex flex-col gap-4 mx-4 max-h-[90vh] overflow-hidden shadow-2xl">
            <!-- Modal Header -->
            <div class="flex items-start justify-between border-b border-[var(--border-primary)] pb-3.5 shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-orange-500/10 border border-orange-500/20 text-[var(--accent-color)] flex items-center justify-center shrink-0">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                        </svg>
                    </div>
                    <div>
                        <h3 class="text-base sm:text-lg font-black text-[var(--text-primary)] tracking-tight"><%= t.auditModalTitle %></h3>
                        <p class="text-[11px] text-[var(--text-muted)] mt-0.5 leading-relaxed"><%= t.auditSubtitle %></p>
                    </div>
                </div>
                <div class="flex items-center gap-1.5">
                    <button type="button" onclick="runDongleAudit()" id="audit-refresh-btn" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer p-1.5 rounded-lg hover:bg-[var(--bg-hover)] flex items-center gap-1 text-xs font-bold" title="<%= t.auditRecheckBtn %>">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 11-2.64-6.36L21 8M21 3v5h-5"/></svg>
                        <span class="hidden sm:inline"><%= t.auditRecheckBtn %></span>
                    </button>
                    <button type="button" onclick="closeDongleAuditModal()" class="text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition cursor-pointer p-1.5 rounded-lg hover:bg-[var(--bg-hover)]">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="flex flex-col gap-4 overflow-y-auto pr-1">
                <!-- KPI Summary Row -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 shrink-0">
                    <div class="p-3 rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] flex flex-col gap-0.5">
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]"><%= t.auditTotalSlots %></span>
                        <span id="audit-kpi-total" class="text-lg font-black text-[var(--text-primary)] font-mono">0</span>
                    </div>
                    <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex flex-col gap-0.5">
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-emerald-400/80"><%= t.auditInSync %></span>
                        <span id="audit-kpi-synced" class="text-lg font-black text-emerald-400 font-mono">0</span>
                    </div>
                    <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/20 flex flex-col gap-0.5">
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-amber-400/80"><%= t.auditIssues %></span>
                        <span id="audit-kpi-issues" class="text-lg font-black text-amber-400 font-mono">0</span>
                    </div>
                    <div class="p-3 rounded-xl bg-zinc-500/10 border border-zinc-500/20 flex flex-col gap-0.5">
                        <span class="text-[10px] font-extrabold uppercase tracking-wider text-[var(--text-muted)]"><%= t.auditDisconnected %></span>
                        <span id="audit-kpi-disconnected" class="text-lg font-black text-[var(--text-secondary)] font-mono">0</span>
                    </div>
                </div>

                <!-- Reconcile Quick Action Banner (Shown when actions are available) -->
                <div id="audit-action-banner" class="p-3.5 rounded-xl bg-gradient-to-r from-orange-500/15 via-amber-500/10 to-transparent border border-orange-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2 h-2 rounded-full bg-orange-400 animate-pulse shrink-0"></span>
                        <p id="audit-banner-text" class="text-xs text-[var(--text-primary)] font-semibold leading-relaxed">
                            <%= isRtl ? 'تم اكتشاف اختلافات بين الإعدادات والأجهزة المتصلة. يمكنك مطابقة الإعدادات بضغطة واحدة.' : 'Hardware detected that is not populated in dongle.conf. Sync configuration to match live devices.' %>
                        </p>
                    </div>
                    <button type="button" onclick="reconcileAllDongles()" id="audit-reconcile-all-btn" class="bg-[var(--accent-color)] hover:opacity-90 text-white font-bold rounded-xl px-4 py-2 text-xs transition cursor-pointer flex items-center justify-center gap-1.5 shrink-0 shadow-lg shadow-orange-500/10">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        <span><%= t.auditReconcileAllBtn %></span>
                    </button>
                </div>

                <!-- Detailed Comparison Table -->
                <div class="rounded-xl border border-[var(--border-primary)] overflow-hidden bg-[var(--bg-card)] flex flex-col">
                    <div class="overflow-x-auto overflow-y-auto max-h-[440px]" style="scrollbar-width: thin;">
                        <table class="w-full text-start text-xs border-collapse">
                            <thead class="sticky top-0 z-10 bg-[var(--bg-card)] shadow-sm">
                                <tr class="bg-black/40 border-b border-[var(--border-primary)] text-[10px] uppercase font-bold text-[var(--text-muted)] tracking-wider">
                                    <th class="px-3.5 py-2.5 text-start"><%= t.auditTableSlot %></th>
                                    <th class="px-3.5 py-2.5 text-start"><%= t.auditTableConfig %></th>
                                    <th class="px-3.5 py-2.5 text-start"><%= t.auditTableLive %></th>
                                    <th class="px-3.5 py-2.5 text-start"><%= t.auditTableStatus %></th>
                                    <th class="px-3.5 py-2.5 text-end"><%= t.auditTableAction %></th>
                                </tr>
                            </thead>
                            <tbody id="audit-slots-table-body" class="divide-y divide-[var(--border-primary)]/50 font-mono">
                                <tr>
                                    <td colspan="5" class="px-4 py-8 text-center text-xs text-[var(--text-muted)] font-sans">
                                        <%= isRtl ? 'جاري فحص الإعدادات والأجهزة...' : 'Scanning configuration and devices...' %>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-between pt-2 border-t border-[var(--border-primary)] shrink-0">
                <span id="audit-timestamp" class="text-[10px] font-mono text-[var(--text-muted)]"></span>
                <button type="button" onclick="closeDongleAuditModal()" class="bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] text-[var(--text-primary)] font-semibold rounded-xl px-5 py-2 text-xs transition cursor-pointer border border-[var(--border-primary)]">
                    <%= t.auditCloseBtn %>
                </button>
            </div>
        </div>
    </div>

    <!-- AT Diagnostics (Root Only) Modal -->
    <div id="at-diag-modal" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-200 p-4">
        <div id="at-diag-modal-card" class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl w-full max-w-2xl scale-95 opacity-0 transition-all duration-200 flex flex-col max-h-[90vh] overflow-hidden shadow-2xl">
            <!-- Modal Header -->
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] px-5 py-4 shrink-0">
                <div class="flex items-center gap-2.5">
                    <span class="p-2 rounded-xl bg-purple-500/10 text-purple-400 border border-purple-500/20">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                    </span>
                    <div>
                        <h3 class="text-sm font-black uppercase tracking-wider text-[var(--text-primary)] flex items-center gap-2">
                            <span><%= t.atDiagModalTitle %></span>
                            <span id="at-diag-target-badge" class="bg-[var(--accent-color)] text-white font-mono text-[10px] px-2 py-0.5 rounded-md uppercase">dongle0</span>
                        </h3>
                        <p class="text-[11px] text-[var(--text-muted)]"><%= t.atDiagModalSubtitle %></p>
                    </div>
                </div>
                <button type="button" onclick="closeAtDiagModal()" class="text-[var(--text-muted)] hover:text-[var(--text-primary)] transition p-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <!-- Modal Scrollable Content -->
            <div class="p-5 overflow-y-auto space-y-4 flex-1">
                <!-- Command Shortcuts Bar -->
                <div>
                    <div class="block text-[11px] font-bold text-[var(--text-secondary)] uppercase tracking-wider mb-2 text-center"><%= t.atDiagShortcuts %></div>
                    <div class="flex flex-wrap items-center justify-center gap-1.5" id="at-diag-shortcuts-container">
                        <button type="button" onclick="executeAtDiag('AT^CARDLOCK?')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT^CARDLOCK?</button>
                        <button type="button" onclick="executeAtDiag('AT^SYSINFO')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT^SYSINFO</button>
                        <button type="button" onclick="executeAtDiag('AT+CREG?')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT+CREG?</button>
                        <button type="button" onclick="executeAtDiag('AT+CSQ')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT+CSQ</button>
                        <button type="button" onclick="executeAtDiag('AT+COPS?')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT+COPS?</button>
                        <button type="button" onclick="executeAtDiag('AT^SYSCFG?')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT^SYSCFG?</button>
                        <button type="button" onclick="executeAtDiag('AT+CPIN?')" class="at-shortcut-chip px-2.5 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] hover:border-zinc-500 text-zinc-300 hover:text-white transition cursor-pointer">AT+CPIN?</button>
                        <div class="flex items-center justify-center gap-1.5 w-full pt-2 border-t border-[var(--border-primary)]/50 mt-1 flex-wrap">
                            <button type="button" onclick="executeAtDiag('AT^SYSCFG=14,2,3FFFFFFF,2,4')" class="at-shortcut-chip px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] text-zinc-300 hover:text-white border border-[var(--border-primary)] hover:border-zinc-500 transition cursor-pointer" title="Lock modem to 3G Only (WCDMA / UMTS)">Lock 3G Only</button>
                            <button type="button" onclick="executeAtDiag('AT^SYSCFG=13,1,3FFFFFFF,2,4')" class="at-shortcut-chip px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] text-zinc-300 hover:text-white border border-[var(--border-primary)] hover:border-zinc-500 transition cursor-pointer" title="Lock modem to 2G Only (GSM / GPRS)">Lock 2G Only</button>
                            <button type="button" onclick="executeAtDiag('AT^SYSCFG=2,2,3FFFFFFF,2,4')" class="at-shortcut-chip px-3 py-1 rounded-lg text-xs font-mono font-semibold bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] text-zinc-300 hover:text-white border border-[var(--border-primary)] hover:border-zinc-500 transition cursor-pointer" title="Auto mode: 3G Preferred with automatic fallback to 2G (Recommended default)">Auto 3G/2G (Default)</button>
                        </div>
                    </div>
                </div>

                <!-- Custom Command Input -->
                <form onsubmit="handleCustomAtSubmit(event)" class="flex gap-2">
                    <div class="relative flex-1">
                        <input type="text" id="at-diag-input" placeholder="<%= t.atDiagCustomPlaceholder %>" class="w-full bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] rounded-xl px-3.5 py-2 text-xs font-mono font-bold focus:outline-none focus:border-[var(--accent-color)] transition" autocomplete="off" />
                    </div>
                    <button type="submit" id="at-diag-submit-btn" class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-[var(--accent-color)] hover:bg-[var(--accent-color)]/90 transition cursor-pointer flex items-center gap-1.5 shrink-0">
                        <span id="at-diag-submit-text"><%= t.atDiagRunBtn %></span>
                    </button>
                </form>

                <!-- Loading State -->
                <div id="at-diag-loading" class="hidden py-8 flex flex-col items-center justify-center gap-3">
                    <div class="w-7 h-7 border-2 border-[var(--accent-color)] border-t-transparent rounded-full animate-spin"></div>
                    <span class="text-xs text-[var(--text-muted)] font-mono animate-pulse"><%= t.atDiagRunning %></span>
                </div>

                <!-- Structured Explanation Section -->
                <div id="at-diag-result-section" class="space-y-3 hidden">
                    <div class="p-4 sm:p-5 rounded-2xl border transition-all" id="at-diag-explanation-card">
                        <div class="flex items-center justify-between gap-2 mb-3 flex-wrap">
                            <span class="text-xs font-black uppercase tracking-wider text-[var(--text-secondary)]"><%= t.atDiagExplanationTitle %></span>
                            <span id="at-diag-badge" class="px-3 py-1 rounded-full text-xs font-black tracking-wide shadow-sm text-black"></span>
                        </div>
                        <h4 id="at-diag-summary" class="text-base sm:text-lg font-black text-[var(--text-primary)] mb-3 leading-snug"></h4>
                        <ul id="at-diag-details" class="space-y-2 text-xs sm:text-sm text-[var(--text-primary)] list-disc list-inside mb-4 font-semibold"></ul>
                        <div id="at-diag-recommendation-box" class="p-3 sm:p-3.5 rounded-xl text-xs sm:text-sm flex items-start gap-2.5 font-black shadow-sm text-black">
                            <span id="at-diag-recommendation-icon" class="shrink-0 mt-0.5 text-amber-500">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 18h6" /><path d="M10 22h4" /><path d="M12 2a7 7 0 0 0-7 7c0 2.38 1.19 4.47 3 5.74V17a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1v-2.26c1.81-1.27 3-3.36 3-5.74a7 7 0 0 0-7-7z" />
                                </svg>
                            </span>
                            <span id="at-diag-recommendation" class="font-black text-black leading-relaxed"></span>
                        </div>
                    </div>

                    <!-- Raw Baseband Output Console -->
                    <div class="rounded-xl bg-[var(--bg-card)] border border-[var(--border-primary)] overflow-hidden shadow-sm">
                        <div class="flex items-center justify-between px-3.5 py-2 bg-[var(--bg-hover)] border-b border-[var(--border-primary)] text-xs font-mono text-[var(--text-secondary)]">
                            <span class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                <span id="at-diag-cmd-executed" class="font-bold">AT</span>
                            </span>
                            <button type="button" onclick="copyAtDiagOutput()" class="hover:text-[var(--text-primary)] transition cursor-pointer flex items-center gap-1">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                                <span>Copy</span>
                            </button>
                        </div>
                        <pre id="at-diag-raw-output" class="p-3.5 text-xs sm:text-sm font-mono font-bold whitespace-pre-wrap overflow-x-auto max-h-48 leading-relaxed select-all text-emerald-700 dark:text-emerald-400 bg-[var(--bg-card)]"></pre>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-end px-5 py-3 border-t border-[var(--border-primary)] shrink-0 bg-[var(--bg-card)]">
                <button type="button" onclick="closeAtDiagModal()" class="px-4 py-2 rounded-xl text-xs font-bold text-[var(--text-secondary)] bg-[var(--bg-hover)] hover:text-[var(--text-primary)] border border-[var(--border-primary)] transition cursor-pointer">
                    <%= t.close %>
                </button>
            </div>
        </div>
    </div>

    <!-- WebSockets Real-time streaming -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        let loadedDevices = <%- JSON.stringify(devices || []) %>;
        window.loadedDevices = loadedDevices;
        const isRtl = <%= isRtl %>;
        const isRootUser = <%- Boolean(typeof isRootUser !== 'undefined' && isRootUser || typeof currentUser !== 'undefined' && currentUser === 'root') %>;
        window.isRootUser = isRootUser;
        window.isRtl = isRtl;
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
        window.escapeHtml = escapeHtml;

        function initDonglesPage() {
            let currentViewMode = localStorage.getItem('dongle_view_mode') || 'grid';
            window.currentViewMode = currentViewMode;

            function updateViewButtons() {
                const btnGrid = document.getElementById('btn-view-grid');
                const btnMinimal = document.getElementById('btn-view-minimal');
                if (!btnGrid || !btnMinimal) return;
                if (currentViewMode === 'minimal') {
                    btnMinimal.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[var(--accent-color)] text-white';
                    btnGrid.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
                } else {
                    btnGrid.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer bg-[var(--accent-color)] text-white';
                    btnMinimal.className = 'px-2.5 py-1 rounded-lg text-xs font-bold flex items-center gap-1.5 transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
                }
            }
            window.updateViewButtons = updateViewButtons;

            window.setDongleViewMode = function(mode) {
                currentViewMode = mode;
                window.currentViewMode = mode;
                localStorage.setItem('dongle_view_mode', mode);
                updateViewButtons();
                if (typeof renderDongleCards === 'function') {
                    renderDongleCards();
                }
            };
            const words = {
                stateFree: "<%= t.stateFree %>",
                stateDisconnected: "<%= t.stateDisconnected %>",
                stateGsmNotResponding: "<%= t.stateGsmNotResponding %>",
                stateNotInitializing: "<%= t.stateNotInitializing %>",
                reloadedSuccess: "<%= t.reloadedSuccess %>",
                sendUssdError: "<%= t.sendUssdError %>",
                sending: "<%= t.sending %>",
                sendBtn: "<%= t.sendBtn %>",
                running: "<%= t.running %>",
                refreshBtn: "<%= t.refreshBtn %>",
                noDongles: "<%= t.noDongles %>",
                selectPlaceholder: "<%= t.selectPlaceholder %>",
                usbNone: "<%= t.usbNone %>",
                usbNoneHint: "<%= t.usbNoneHint %>",
                usbMapped: "<%= isRtl ? 'مسجل في dongle' : 'Mapped' %>",
                usbUnmapped: "<%= isRtl ? 'غير مسجل' : 'Unmapped' %>",
                lsusbNone: "<%= t.lsusbNone %>",
                lsusbNoneHint: "<%= t.lsusbNoneHint %>",
                lsusbModemsBadge: "<%= t.lsusbModemsBadge %>",
                lsusbTtyBadge: "<%= t.lsusbTtyBadge %>",
                lsusbBoundSlot: "<%= t.lsusbBoundSlot %>",
                lsusbBoundPorts: "<%= t.lsusbBoundPorts %>",
                lsusbUnassigned: "<%= t.lsusbUnassigned %>",
                btnRestartDongle: "<%= t.btnRestartDongle %>",
                btnRebootModem: "<%= t.btnRebootModem %>",
                btnVirtualReplug: "<%= t.btnVirtualReplug %>",
                btnResetUsb: "<%= t.btnResetUsb %>",
                btnPopulateHardware: "<%= t.btnPopulateHardware %>",
                populateHardwareConfirm: "<%= t.populateHardwareConfirm %>",
                populateHardwareSuccess: "<%= t.populateHardwareSuccess %>",
                btnEditPorts: "<%= t.btnEditPorts %>",
                editPortsModalTitle: "<%= t.editPortsModalTitle %>",
                editPortsSuccess: "<%= t.editPortsSuccess %>"
            };

            // Socket.io initialization with safety check to prevent halts if blocked/undefined
            let socket = null;
            if (typeof io !== 'undefined') {
                socket = io();
            } else {
                console.warn("Socket.io (io) is not defined. Real-time updates will be disabled.");
            }
            
            // Elements
            const logsToggle = document.getElementById('logs-toggle-switch');
            const logScreen = document.getElementById('log-screen-console');
            const logsAutoscroll = document.getElementById('logs-autoscroll-chk');
            const clearLogsBtn = document.getElementById('clear-logs-btn');
            
            const ussdForm = document.getElementById('ussd-execution-form');
            const ussdTarget = document.getElementById('ussd-target-dongle');
            const ussdInput = document.getElementById('ussd-code-input');
            const ussdSubmitBtn = document.getElementById('ussd-submit-btn');
            const btnLabel = document.getElementById('btn-label');
            const btnSpinner = document.getElementById('btn-spinner');
            const terminalScreen = document.getElementById('terminal-screen');
            const terminalPlaceholder = document.getElementById('terminal-placeholder');
            
            const globalRefreshBtn = document.getElementById('global-refresh-btn');
            const donglesGrid = document.getElementById('dongles-grid');
            const deviceTotalEl = document.getElementById('gsm-device-total');
            const deviceReadyEl = document.getElementById('gsm-device-ready');
            
            // Detail display elements
            const elId = document.getElementById('info-id');
            const elNum = document.getElementById('info-number');
            const elProv = document.getElementById('info-provider');
            const globalResetUsbBtn = document.getElementById('global-reset-usb-btn');
            const elImei = document.getElementById('info-imei');
            const elImsi = document.getElementById('info-imsi');
            const elGroup = document.getElementById('info-group');
            const elModel = document.getElementById('info-model');
            const elFirm = document.getElementById('info-firmware');
            const elMode = document.getElementById('info-mode');
            const elSub = document.getElementById('info-submode');

            let selectedDongleId = null;
            let allSmsMessages = [];
            let activeThreadEndpoint = null;
            let smsSearchQuery = '';
            let lastUssdText = "";
            let lastUssdTime = 0;
            let devicesRefreshInFlight = false;
            let isSyncingSelect = false;
            function getDongleStateView(dev) {
                const rawState = String((dev && dev.State) || 'Not Connected');
                const normalized = rawState.toLowerCase();
                let color = 'red';
                let label = rawState;
                let animate = false;

                if (normalized.includes('not init')) {
                    color = 'yellow';
                    label = words.stateNotInitializing;
                } else if (normalized.includes('not responding')) {
                    label = words.stateGsmNotResponding;
                } else if (normalized.includes('not connec') || normalized === 'not_connected' || normalized.includes('disconnected')) {
                    label = isRtl ? 'غير متصل' : 'Not Connected';
                } else if (normalized === 'free' || normalized === 'idle') {
                    color = 'purple';
                    label = isRtl ? 'جاهز' : 'Free';
                } else if (normalized.includes('sms')) {
                    color = 'pink';
                    label = isRtl ? 'رسالة SMS' : 'SMS';
                    animate = true;
                } else if (normalized.includes('outgoing') || normalized.includes('incoming') || normalized.includes('active') || normalized.includes('busy')) {
                    color = 'green';
                    label = normalized.includes('outgoing')
                        ? (isRtl ? 'مكالمة صادرة' : 'Outgoing Call')
                        : normalized.includes('incoming')
                            ? (isRtl ? 'مكالمة واردة' : 'Incoming Call')
                            : (isRtl ? 'مكالمة نشطة' : 'Active Call');
                    animate = true;
                } else if (normalized.includes('not reg') || normalized.includes('searching') || normalized.includes('no signal') || normalized.includes('gsm')) {
                    color = 'yellow';
                    label = isRtl ? 'غير مسجل' : 'GSM Not Registered';
                } else if (normalized.includes('dial') || normalized.includes('ring') || normalized.includes('calling')) {
                    color = 'blue';
                    label = normalized.includes('dial')
                        ? (isRtl ? 'جاري الاتصال' : 'Dialing')
                        : (isRtl ? 'جاري الرنين' : 'Ringing');
                    animate = true;
                }

                const badge = {
                    red: { bg: 'bg-red-500/15', text: 'text-red-400', border: 'border-red-500/30', dot: 'bg-red-500' },
                    purple: { bg: 'bg-purple-500/15', text: 'text-purple-400', border: 'border-purple-500/30', dot: 'bg-purple-400' },
                    green: { bg: 'bg-emerald-500/15', text: 'text-emerald-400', border: 'border-emerald-500/30', dot: 'bg-emerald-400' },
                    pink: { bg: 'bg-pink-500/20', text: 'text-pink-300', border: 'border-pink-500/40', dot: 'bg-pink-400' },
                    yellow: { bg: 'bg-yellow-500/15', text: 'text-yellow-400', border: 'border-yellow-500/30', dot: 'bg-yellow-400' },
                    blue: { bg: 'bg-blue-500/15', text: 'text-blue-400', border: 'border-blue-500/30', dot: 'bg-blue-400' }
                }[color];

                return {
                    rawState,
                    color,
                    label,
                    animate,
                    badge,
                    isReady: color === 'purple' || color === 'green' || color === 'blue'
                };
            }

            function getDongleSignalView(dev) {
                const rawRssi = Number.parseInt(dev && dev.RSSI, 10);
                const rssi = Number.isFinite(rawRssi) ? Math.max(0, Math.min(31, rawRssi)) : 0;
                const percent = Math.round((rssi / 31) * 100);
                let activeColor = 'var(--status-success-text)';
                let level = isRtl ? 'ممتاز' : 'Excellent';

                if (rssi === 0) {
                    activeColor = 'var(--status-error-text)';
                    level = isRtl ? 'بدون إشارة' : 'No Signal';
                } else if (rssi < 9) {
                    activeColor = 'var(--status-error-text)';
                    level = isRtl ? 'ضعيف جداً' : 'Very Weak';
                } else if (rssi < 15) {
                    activeColor = 'var(--status-error-text)';
                    level = isRtl ? 'ضعيف' : 'Weak';
                } else if (rssi < 20) {
                    activeColor = 'var(--status-warning-text)';
                    level = isRtl ? 'متوسط' : 'Moderate';
                } else if (rssi < 25) {
                    level = isRtl ? 'جيد' : 'Good';
                }

                const thresholds = [1, 7, 14, 21, 28];
                const heights = [3, 6, 9, 12, 14];
                const barsHtml = thresholds.map((threshold, index) => {
                    const fill = rssi >= threshold ? activeColor : 'rgba(127,127,127,0.2)';
                    return `<span style="width:3px;height:${heights[index]}px;border-radius:1px;background:${fill};display:inline-block;flex-shrink:0"></span>`;
                }).join('');
                return { rssi, percent, activeColor, level, barsHtml };
            }

            function renderDongleRouting(dev) {
                try {
                    if (!dev) return '';
                    const imei = String(dev.IMEI || '').trim();
                    const trunks = Array.isArray(dev.customTrunks) ? dev.customTrunks.filter(Boolean) : [];
                    const validImei = /^\d{8,20}$/.test(imei);
                    const emptyMessage = validImei
                        ? (isRtl ? 'لا يوجد مسار اتصال مخصص يحتوي على IMEI هذا الجهاز.' : 'No custom trunk dial string contains this IMEI.')
                        : (isRtl ? 'رقم IMEI غير متاح، لذلك لا يمكن مطابقة المسارات.' : 'IMEI unavailable, so routing cannot be matched.');

                    if (trunks.length === 0) {
                        return `
                            <div class="dongle-routing-panel">
                                <div class="flex items-center gap-2 mb-1.5">
                                    <svg class="text-[var(--text-muted)] shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                    <span class="text-[9px] font-black uppercase tracking-wider text-[var(--text-secondary)]">${isRtl ? 'الربط الصادر عبر IMEI' : 'IMEI-Linked Outbound Routing'}</span>
                                </div>
                                <p class="text-[9px] text-[var(--text-muted)] leading-relaxed">${escapeHtml(emptyMessage)}</p>
                            </div>`;
                    }

                    const routeCount = trunks.reduce((total, trunk) => total + (Array.isArray(trunk?.routes) ? trunk.routes.length : 0), 0);
                    return `
                        <div class="dongle-routing-panel">
                            <div class="flex items-center justify-between gap-2 mb-1.5">
                                <div class="flex items-center gap-2 min-w-0">
                                    <svg class="text-sky-400 shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                                    <span class="text-[9px] font-black uppercase tracking-wider text-[var(--text-secondary)]">${isRtl ? 'الربط الصادر عبر IMEI' : 'IMEI-Linked Outbound Routing'}</span>
                                </div>
                                <span class="text-[8px] font-mono font-bold text-sky-400 shrink-0">${trunks.length} ${isRtl ? 'مسار' : 'trunk'} · ${routeCount} ${isRtl ? 'وجهة' : 'routes'}</span>
                            </div>
                            <div class="space-y-1.5">
                                ${trunks.map(trunk => {
                                    if (!trunk) return '';
                                    const routes = Array.isArray(trunk.routes) ? trunk.routes.filter(Boolean) : [];
                                    const trunkUrl = `/config?tab=trunks&highlightTrunk=${encodeURIComponent(trunk.trunkId || '')}`;
                                    return `
                                        <a href="${trunkUrl}" class="dongle-routing-trunk group/trunk block" title="${isRtl ? 'عرض وتحديد خط الربط هذا في إعدادات المقسم' : 'Click to view and highlight this trunk in PBX Configuration'}">
                                            <div class="flex items-center justify-between gap-2 mb-1">
                                                <div class="min-w-0 flex items-center gap-1.5">
                                                    <span class="text-[10px] font-extrabold text-[var(--text-primary)] group-hover/trunk:text-red-400 transition-colors truncate block">${escapeHtml(trunk.name || `Trunk #${trunk.trunkId || ''}`)}</span>
                                                    <span class="text-[8px] text-[var(--text-muted)] font-mono">Trunk #${escapeHtml(trunk.trunkId || '')}</span>
                                                    <svg class="w-2.5 h-2.5 text-[var(--text-muted)] group-hover/trunk:text-red-400 transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                                </div>
                                                <span class="px-1.5 py-0.5 rounded-full border text-[8px] font-bold shrink-0 ${trunk.disabled ? 'bg-red-500/10 border-red-500/20 text-red-400' : 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400'}">
                                                    ${trunk.disabled ? (isRtl ? 'معطل' : 'Disabled') : (isRtl ? 'مفعل' : 'Enabled')}
                                                </span>
                                            </div>
                                            <div class="dongle-dial-string font-mono mb-1.5" title="${escapeHtml(trunk.dialString || '')}">${escapeHtml(trunk.dialString || '-')}</div>
                                            <div class="flex flex-wrap items-center gap-1">
                                                <span class="text-[8px] font-bold uppercase tracking-wider text-[var(--text-muted)]">${isRtl ? 'المسارات الصادرة' : 'Outbound Routes'}</span>
                                                ${routes.length > 0
                                                    ? routes.map(route => `<span class="dongle-route-chip"><span class="truncate">${escapeHtml(route.name || `Route #${route.routeId || ''}`)}</span><span class="opacity-60 ms-1 shrink-0">#${escapeHtml(route.routeId || '')}</span></span>`).join('')
                                                    : `<span class="text-[8px] italic text-[var(--text-muted)]">${isRtl ? 'غير مرتبط بأي مسار صادر' : 'Not assigned to an outbound route'}</span>`}
                                            </div>
                                        </a>`;
                                }).join('')}
                            </div>
                        </div>`;
                } catch (err) {
                    console.error('Error rendering dongle routing:', err);
                    return '';
                }
            }

            function renderDongleCards() {
                if (!donglesGrid) return;

                updateViewButtons();
                const states = loadedDevices.map(getDongleStateView);
                if (deviceTotalEl) deviceTotalEl.textContent = String(loadedDevices.length);
                if (deviceReadyEl) deviceReadyEl.textContent = String(states.filter(state => state.isReady).length);
                donglesGrid.innerHTML = '';

                if (currentViewMode === 'minimal') {
                    donglesGrid.className = 'flex flex-col gap-2 p-3 sm:p-4';
                } else {
                    donglesGrid.className = 'grid grid-cols-1 md:grid-cols-2 items-start gap-3 p-3 sm:p-4';
                }

                if (loadedDevices.length === 0) {
                    donglesGrid.innerHTML = `
                        <div class="col-span-full py-10 text-center">
                            <div class="mx-auto mb-2 flex items-center justify-center text-[var(--text-muted)]">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17h16M7 13h10M10 9h4"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-[var(--text-secondary)]">${escapeHtml(words.noDongles)}</p>
                        </div>`;
                    return;
                }

                loadedDevices.forEach((dev, index) => {
                    const id = String(dev.ID || '');
                    const phoneNumber = String(dev.Number || 'Unknown');
                    const imsi = String(dev.IMSI || '-');
                    const imei = String(dev.IMEI || '-');
                    const provider = String(dev['Provider Name'] || 'NONE');
                    const model = String(dev.Model || '-');
                    const firmware = String(dev.Firmware || '-');
                    const mode = [dev.Mode, dev.Submode].filter(Boolean).join(' / ') || '-';
                    const state = states[index];
                    const signal = getDongleSignalView(dev);
                    const hasValidHardware = imei && imei !== '-' && imei !== 'Unknown' && imsi && imsi !== '-' && imsi !== 'Unknown';
                    const card = document.createElement('article');

                    card.id = 'row-' + id;
                    card.dataset.dongleId = id;
                    card.dataset.number = phoneNumber === 'Unknown' ? '' : phoneNumber;
                    card.dataset.imsi = imsi;
                    card.dataset.imei = imei;
                    card.dataset.audio = String(dev.audio || '');
                    card.dataset.data = String(dev.data || '');

                    if (currentViewMode === 'minimal') {
                        card.className = `dongle-device-card dongle-state-${state.color} rounded-xl cursor-pointer p-3 sm:px-4 py-2.5 flex items-center justify-between gap-3 text-xs flex-wrap md:flex-nowrap transition-all`;
                        if (id === selectedDongleId) card.classList.add('selected-row');

                        card.innerHTML = `
                            <div class="flex items-center justify-center gap-2.5 min-w-0 md:flex-1 text-center">
                                <div class="w-7 h-7 rounded-lg dongle-icon-box flex items-center justify-center shrink-0">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 18h6M9 6h.01M12 6h.01M15 6h.01"/></svg>
                                </div>
                                <div class="min-w-0">
                                    <h4 class="text-sm font-black text-[var(--text-primary)] font-mono truncate tracking-tight">${escapeHtml(id)}</h4>
                                </div>
                            </div>

                            <div class="flex items-center justify-center gap-1.5 min-w-0 md:flex-1 text-center">
                                <span class="text-[10px] font-extrabold text-[var(--text-muted)] uppercase tracking-wider">IMEI:</span>
                                <span class="font-mono text-xs text-[var(--text-primary)] font-semibold truncate max-w-[140px]" title="${escapeHtml(imei)}">${escapeHtml(imei)}</span>
                                ${imei !== '-' && imei !== 'Unknown' ? `<button type="button" data-dongle-action="copy-imei" class="p-0.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'نسخ IMEI' : 'Copy IMEI'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                            </div>

                            <div class="flex items-center justify-center gap-1.5 min-w-0 md:flex-1 text-center">
                                <span class="text-[10px] font-extrabold text-[var(--text-muted)] uppercase tracking-wider">${isRtl ? 'الشريحة:' : 'SIM:'}</span>
                                <span id="display-num-${escapeHtml(id)}" class="font-mono text-xs text-[var(--text-primary)] font-bold truncate max-w-[130px]">${escapeHtml(phoneNumber)}</span>
                                ${phoneNumber !== 'Unknown' ? `<button type="button" data-dongle-action="copy-number" class="p-0.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer shrink-0" title="${isRtl ? 'نسخ الرقم' : 'Copy number'}"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>` : ''}
                            </div>

                            <div class="flex items-center justify-center md:flex-1 text-center">

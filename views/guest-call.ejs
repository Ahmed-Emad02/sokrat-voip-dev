}
function contrastRatio(foreground, background) {
    const a = relativeLuminance(foreground);
    const b = relativeLuminance(background);
    return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
}
const isLightBackground = relativeLuminance(bgColor) > 0.55;
const resolvedTextColor = contrastRatio(textColor, bgColor) >= 4.5 ? textColor : (isLightBackground ? '#0f172a' : '#f4f4f5');
const resolvedMutedColor = contrastRatio(mutedColor, bgColor) >= 3 ? mutedColor : (isLightBackground ? '#475569' : '#a1a1aa');
const resolvedOnBrand = contrastRatio(onBrandColor, brandColor) >= 3 ? onBrandColor : (relativeLuminance(brandColor) > 0.55 ? '#0a0a0d' : '#ffffff');
const surfaceColor = isLightBackground ? '#ffffff' : '#0b0b0e';
const surfaceStrong = isLightBackground ? '#f8fafc' : '#121217';
const lineColor = isLightBackground ? '#e2e8f0' : '#27272a';
const logoTheme = isLightBackground ? '/logo.png' : '/logo_light_text.png';
const rawLogo = typeof branding.logo_url === 'string' ? branding.logo_url : '';
const logoUrl = /^https?:\/\//i.test(rawLogo) || /^\/uploads\/tenant-logos\/[A-Za-z0-9._-]+\.png$/i.test(rawLogo) ? rawLogo : '';
const consentText = (tenant && tenant.consent_text) || t.consent;
const buttonText = (branding.button_text || t.callNow).toString().slice(0, 40);
%>
<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>" class="<%= previewMode ? 'preview-page-root' : '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="<%= bgColor %>">
    <meta name="robots" content="noindex,nofollow">
    <title><%= tenant.name %> — <%= isRtl ? 'اتصل بنا' : 'Call us' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: <%= brandColor %>;
            --brand-2: <%= brand2Color %>;
            --brand-soft: color-mix(in srgb, var(--brand) 18%, transparent);
            --bg: <%= bgColor %>;
            --surface: <%= surfaceColor %>;
            --surface-2: <%= surfaceStrong %>;
            --line: <%= lineColor %>;
            --text: <%= resolvedTextColor %>;
            --muted: <%= resolvedMutedColor %>;
            --on-brand: <%= resolvedOnBrand %>;
            --ok: #22c55e;
            --danger: #cc090c;
            --shadow: <%= isLightBackground ? '0 18px 50px rgba(15, 23, 42, .10)' : '0 20px 60px rgba(0, 0, 0, .48)' %>;
            color-scheme: <%= isLightBackground ? 'light' : 'dark' %>;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { min-height: 100%; }
        body {
            margin: 0;
            min-height: 100dvh;
            padding: max(16px, env(safe-area-inset-top)) 18px max(18px, env(safe-area-inset-bottom));
            background:
                radial-gradient(ellipse at 50% -18%, color-mix(in srgb, var(--brand) 16%, transparent), transparent 55%),
                var(--bg);
            color: var(--text);
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            user-select: none;
        }
        body.preview-page { height: auto; overflow-y: auto; }
        .sokrat-bar {
            width: min(1080px, 100%);
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
        }
        .brand-mark { display: flex; align-items: center; gap: 9px; min-width: 0; }
        .brand-mark img { width: 30px; height: 30px; object-fit: contain; border-radius: 7px; }
        .brand-mark span { font-size: 11px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; white-space: nowrap; }
        .brand-mark b { color: var(--brand); }
        .bar-actions { display: flex; align-items: center; gap: 8px; }
        .bar-caption { color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
        .audio-settings-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 34px;
            padding: 7px 10px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface);
            color: var(--muted);
            font-family: inherit;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .04em;
            cursor: pointer;
        }
        .audio-settings-btn:hover { color: var(--text); border-color: var(--brand); }
        .audio-settings-btn svg { width: 13px; height: 13px; }
        .hotline-shell {
            width: min(1080px, 100%);
            margin: 0 auto;
            display: grid;
            grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
            gap: 16px;
            align-items: stretch;
        }
        .panel {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 16px;
            box-shadow: var(--shadow);
        }
        .business-panel {
            display: flex;
            flex-direction: column;
            gap: 20px;
            min-height: 560px;
            padding: 24px;
        }
        .identity { display: flex; align-items: center; gap: 14px; min-width: 0; }
        .avatar-wrap {
            width: 62px;
            height: 62px;
            flex: 0 0 62px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: linear-gradient(145deg, var(--brand), var(--brand-2));
            border: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
            overflow: hidden;
        }
        .avatar-wrap img { width: 100%; height: 100%; object-fit: cover; }
        .avatar-initial { font-size: 24px; font-weight: 900; color: var(--on-brand); }
        .identity-copy { min-width: 0; }
        .eyebrow {
            margin: 0 0 5px;
            color: var(--brand);
            font-size: 8.5px;
            font-weight: 900;
            letter-spacing: .13em;
            text-transform: uppercase;
        }
        h1 {
            margin: 0;
            color: var(--text);
            font-family: 'Cairo', 'JetBrains Mono', sans-serif;
            font-size: 22px;
            line-height: 1.2;
            font-weight: 900;
            letter-spacing: -.02em;
            overflow-wrap: anywhere;
        }
        .subtitle { margin: 4px 0 0; color: var(--muted); font-size: 11px; line-height: 1.45; }
        .panel-divider { height: 1px; background: var(--line); }
        .panel-copy { display: flex; flex-direction: column; gap: 7px; }
        .panel-copy p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.65; }
        .panel-copy strong { color: var(--text); font-weight: 800; }
        .steps { display: flex; flex-direction: column; gap: 9px; margin-top: 10px; }
        .step { display: flex; align-items: baseline; gap: 9px; }
        .step-index { color: var(--brand); font-size: 8px; font-weight: 900; letter-spacing: .05em; }
        .step-text { color: var(--text); font-size: 10.5px; font-weight: 700; line-height: 1.4; }
        .panel-bottom { margin-top: auto; display: flex; flex-direction: column; gap: 12px; }
        .consent {
            margin: 0;
            padding-top: 13px;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 9px;
            line-height: 1.55;
        }
        .powered { margin: 0; color: var(--muted); font-size: 8px; letter-spacing: .08em; text-transform: uppercase; }
        .powered b { color: var(--brand); }
        .call-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            min-height: 560px;
            padding: 20px 22px 18px;
            overflow: hidden;
        }
        .call-panel::before {
            content: '';
            position: absolute;
            inset: 0 0 auto;
            height: 2px;
            background: var(--brand);
        }
        .call-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 30px;
            padding: 6px 10px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface-2);
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            line-height: 1.35;
        }
        .status-dot { width: 7px; height: 7px; flex: 0 0 auto; border-radius: 50%; background: var(--muted); }
        [data-state="connecting"] .status-dot { background: var(--brand); animation: sokrBlink 1.2s ease-in-out infinite; }
        [data-state="ringing"] .status-dot { background: #fbbf24; animation: sokrBlink 1s ease-in-out infinite; }
        [data-state="connected"] .status-dot { background: var(--ok); box-shadow: 0 0 9px var(--ok); }
        [data-state="failed"] .status-dot,
        [data-state="mic_denied"] .status-dot { background: var(--danger); }
        [data-state="no_answer"] .status-dot,
        [data-state="busy"] .status-dot { background: #fbbf24; }
        .status-text { overflow-wrap: anywhere; }
        .status-text.error { color: #fca5a5; }
        .connection-mark { color: var(--muted); font-size: 8px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; text-align: end; }
        .call-stage {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            padding: 18px 0 10px;
            text-align: center;
        }
        .call-visual {
            position: relative;
            width: 144px;
            height: 144px;
            display: grid;
            place-items: center;
            margin-bottom: 2px;
        }
        .call-orb {
            position: relative;
            z-index: 2;
            width: 72px;
            height: 72px;
            display: grid;
            place-items: center;
            border-radius: 18px;
            border: 1px solid color-mix(in srgb, var(--text) 14%, transparent);
            background: linear-gradient(145deg, var(--brand), var(--brand-2));
            color: var(--on-brand);
            box-shadow: 0 12px 34px var(--brand-soft);
        }
        .call-orb svg { width: 29px; height: 29px; }
        .call-rings, .call-rings::before, .call-rings::after {
            position: absolute;
            inset: 20px;
            border: 1px solid var(--brand);
            border-radius: 50%;
            opacity: 0;
        }
        .call-rings { z-index: 1; }
        [data-state="ringing"] .call-rings { opacity: .35; animation: sokrPulse 2s ease-out infinite; }
        [data-state="ringing"] .call-rings::before { content: ''; inset: -14px; opacity: .25; animation: sokrPulse 2s ease-out .5s infinite; }
        [data-state="connected"] .call-rings { opacity: .16; border-color: var(--ok); }
        .wave {
            height: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            margin-top: 8px;
            opacity: 0;
            transition: opacity .2s ease;
        }
        [data-state="connecting"] .wave,
        [data-state="ringing"] .wave,
        [data-state="connected"] .wave { opacity: 1; }
        .wave span { display: block; width: 3px; height: 8px; border-radius: 99px; background: var(--brand); animation: sokrWave 1.05s ease-in-out infinite; }
        .wave span:nth-child(2) { animation-delay: .12s; }
        .wave span:nth-child(3) { animation-delay: .24s; }
        .wave span:nth-child(4) { animation-delay: .36s; }
        .wave span:nth-child(5) { animation-delay: .48s; }
        [data-state="connected"] .wave span { background: var(--ok); animation-duration: .72s; }
        .timer {
            display: none;
            margin: 6px 0 0;
            color: var(--text);
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            font-size: 38px;
            font-weight: 900;
            letter-spacing: -.04em;
            font-variant-numeric: tabular-nums;
        }
        [data-state="connected"] .timer { display: block; }
        .state-title {
            margin: 8px 0 0;
            color: var(--text);
            font-family: 'Cairo', 'JetBrains Mono', sans-serif;
            font-size: 19px;
            line-height: 1.3;
            font-weight: 900;
        }
        .state-text {
            max-width: 340px;
            min-height: 18px;
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 10.5px;
            line-height: 1.55;
        }
        .state-text.error { color: #fca5a5; }
        .call-actions {
            width: min(360px, 100%);
            display: flex;
            flex-direction: column;
            align-items: stretch;
            gap: 9px;
            margin: 16px auto 0;
        }
        .primary-action, .secondary-action, .control, .audio-unlock {
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            cursor: pointer;
        }
        .primary-action {
            display: none;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            min-height: 48px;
            padding: 11px 16px;
            border: 0;
            border-radius: 10px;
            background: linear-gradient(180deg, var(--brand), #7b0002);
            color: var(--on-brand);
            font-size: 13px;
            font-weight: 900;
            letter-spacing: .04em;
            box-shadow: 0 10px 24px var(--brand-soft);
        }
        .primary-action:hover { filter: brightness(1.08); }
        .primary-action:active { transform: scale(.985); }
        .secondary-action {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 44px;
            padding: 10px 16px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--surface-2);
            color: var(--text);
            font-size: 11px;
            font-weight: 800;
        }
        .secondary-action:hover { border-color: var(--brand); color: var(--brand); }
        .connected-actions { display: none; align-items: flex-start; justify-content: center; gap: 30px; padding: 4px 0 2px; }
        .control-group { display: flex; flex-direction: column; align-items: center; gap: 6px; }
        .control {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: var(--surface-2);
            color: var(--text);
        }
        .control svg { width: 20px; height: 20px; }
        .control:hover { border-color: var(--brand); }
        .control:active { transform: scale(.94); }
        .control.is-muted { background: var(--brand); border-color: var(--brand); color: var(--on-brand); box-shadow: 0 8px 20px var(--brand-soft); }
        .control.end { background: linear-gradient(180deg, var(--brand), #7b0002); border-color: transparent; color: var(--on-brand); box-shadow: 0 10px 22px var(--brand-soft); }
        .control-label { color: var(--muted); font-size: 8.5px; font-weight: 800; letter-spacing: .03em; }
        .audio-unlock {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            min-height: 38px;
            padding: 8px 12px;
            border: 1px solid var(--line);
            border-radius: 9px;
            background: var(--surface-2);
            color: var(--text);
            font-size: 10px;
            font-weight: 800;
        }
        .audio-unlock:not(.hidden) { display: flex; }
        .call-summary {
            display: none;
            margin: 0;
            color: var(--muted);
            font-size: 10px;
            line-height: 1.5;
            text-align: center;
        }
        [data-state="idle"] #guestCallBtn { display: flex; }
        [data-state="connecting"] #guestCancelBtn,
        [data-state="ringing"] #guestCancelBtn { display: flex; }
        [data-state="connected"] .connected-actions { display: flex; }
        [data-state="ended"] #guestRetryBtn,
        [data-state="failed"] #guestRetryBtn,
        [data-state="no_answer"] #guestRetryBtn,
        [data-state="busy"] #guestRetryBtn,
        [data-state="mic_denied"] #guestRetryBtn { display: flex; }
        [data-state="ended"] .call-summary { display: block; }
        .audio-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            background: rgba(0, 0, 0, .72);
            backdrop-filter: blur(4px);
        }
        .audio-modal-backdrop.open { display: flex; }
        .audio-modal {
            width: min(360px, 100%);
            padding: 16px;
            border: 1px solid var(--line);
            border-radius: 14px;
            background: var(--surface);
            color: var(--text);
            box-shadow: var(--shadow);
            text-align: start;
        }
        .audio-modal-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
        .audio-modal-head h2 { margin: 0; font-family: 'Cairo', 'JetBrains Mono', sans-serif; font-size: 15px; font-weight: 900; }
        .audio-close {
            width: 28px;
            height: 28px;
            border: 1px solid var(--line);
            border-radius: 7px;
            background: var(--surface-2);
            color: var(--muted);
            cursor: pointer;
            font-size: 13px;
            line-height: 1;
        }
        .audio-close:hover { color: var(--text); border-color: var(--brand); }
        .audio-field { display: flex; flex-direction: column; gap: 5px; margin-top: 10px; color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase; }
        .audio-field select {
            width: 100%;
            padding: 9px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface-2);
            color: var(--text);
            font-family: inherit;
            font-size: 11px;
            outline: none;
            color-scheme: inherit;
        }
        .audio-field select:focus { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand-soft); }
        .audio-field select:disabled { opacity: .55; }
        .audio-help { margin: 12px 0 0; color: var(--muted); font-size: 9px; line-height: 1.5; }
        .lab-section {
            width: min(1080px, 100%);
            margin: 16px auto 0;
        }
        .preview-fields {
            border: 1px solid var(--line);
            border-radius: 16px;
            background: var(--surface);
            color: var(--text);
            box-shadow: var(--shadow);
            overflow: hidden;
        }
        .preview-fields summary {
            cursor: pointer;
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 13px 16px;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .05em;
        }
        .preview-fields summary::-webkit-details-marker { display: none; }
        .preview-fields summary::after { content: '⌄'; color: var(--brand); font-size: 18px; line-height: 1; transition: transform .18s ease; }
        .preview-fields[open] summary::after { transform: rotate(180deg); }
        .preview-fields[open] summary { border-bottom: 1px solid var(--line); }
        .preview-fields-body { padding: 14px 16px 16px; }
        .preview-kicker { color: var(--brand); font-size: 8px; font-weight: 900; letter-spacing: .14em; text-transform: uppercase; margin-bottom: 5px; }
        .preview-fields h2 { margin: 0 0 3px; font-family: 'Cairo', 'JetBrains Mono', sans-serif; font-size: 16px; font-weight: 900; }
        .preview-fields p { margin: 0 0 12px; color: var(--muted); font-size: 10px; line-height: 1.6; }
        .preview-field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 9px; }
        .preview-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        .preview-field.full { grid-column: 1 / -1; }
        .preview-field-label { display: flex; align-items: baseline; gap: 6px; color: var(--muted); font-size: 9px; font-weight: 800; letter-spacing: .03em; }
        .preview-field-label small { color: var(--brand); font-size: 8px; font-weight: 800; text-transform: none; letter-spacing: 0; }
        .preview-input {
            width: 100%;
            min-height: 35px;
            padding: 7px 9px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface-2);
            color: var(--text);
            font-family: inherit;
            font-size: 11px;
            outline: none;
            color-scheme: inherit;
        }
        .preview-input:focus { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand-soft); }
        textarea.preview-input { min-height: 58px; resize: vertical; }
        .preview-check {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 35px;
            padding: 7px 9px;
            border: 1px solid var(--line);
            border-radius: 8px;
            background: var(--surface-2);
            color: var(--text);
            font-size: 11px;
        }
        .preview-check input { width: 13px; height: 13px; accent-color: var(--brand); }
        .hidden { display: none !important; }
        @keyframes sokrBlink { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
        @keyframes sokrWave { 0%, 100% { transform: scaleY(.55); opacity: .7; } 50% { transform: scaleY(2.4); opacity: 1; } }
        @keyframes sokrPulse { 0% { transform: scale(.9); opacity: .45; } 100% { transform: scale(1.28); opacity: 0; } }
        @media (max-width: 900px) {
            .hotline-shell { grid-template-columns: 1fr; }
            .business-panel { min-height: 0; }
            .call-panel { min-height: 520px; }
            .panel-bottom { margin-top: 0; }
        }
        @media (max-width: 560px) {
            body { padding: 0; }
            .sokrat-bar { margin: 0; padding: 14px 16px; background: var(--surface); border-bottom: 1px solid var(--line); }
            .bar-caption { display: none; }
            .hotline-shell { width: 100%; gap: 10px; padding: 10px 12px 18px; }
            .panel { border-radius: 14px; }
            .business-panel { padding: 16px; gap: 14px; }
            .avatar-wrap { width: 52px; height: 52px; flex-basis: 52px; border-radius: 12px; }
            h1 { font-size: 20px; }
            .panel-copy p { font-size: 10px; }
            .call-panel { min-height: 500px; padding: 16px 16px 14px; }
            .call-top { align-items: flex-start; }
            .connection-mark { max-width: 84px; }
            .call-stage { padding-top: 10px; }
            .call-visual { width: 120px; height: 120px; }
            .call-orb { width: 64px; height: 64px; border-radius: 16px; }
            .call-orb svg { width: 26px; height: 26px; }
            .timer { font-size: 34px; }
            .state-title { font-size: 18px; }
            .state-text { font-size: 10px; }
            .call-actions { margin-top: 12px; }
            .primary-action { min-height: 46px; font-size: 12px; }
            .preview-field-grid { grid-template-columns: 1fr; }
            .preview-field.full { grid-column: auto; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
        }
    </style>
</head>
<body class="<%= previewMode ? 'preview-page' : '' %>">
    <header class="sokrat-bar">
        <div class="brand-mark">
            <img src="<%= logoTheme %>" alt="Sokrat VOIP">
            <span>Sokrat <b>VOIP</b></span>
        </div>
        <div class="bar-actions">
            <span class="bar-caption"><%= t.secure %></span>
            <button id="guestAudioSettingsBtn" type="button" class="audio-settings-btn" aria-haspopup="dialog">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
                <span><%= t.audioSettings %></span>
            </button>
        </div>
    </header>

    <main class="hotline-shell" id="callCard" data-state="<%= autoStartEnabled ? 'connecting' : 'idle' %>">
        <aside class="business-panel panel">
            <div class="identity">
                <div class="avatar-wrap">
                    <% if (logoUrl) { %>
                        <img src="<%= logoUrl %>" alt="<%= tenant.name %>">
                    <% } else { %>
                        <span class="avatar-initial"><%= String(tenant.name || '?').trim().charAt(0).toUpperCase() %></span>
                    <% } %>
                </div>
                <div class="identity-copy">
                    <p class="eyebrow"><%= t.officialHotline %></p>
                    <h1><%= tenant.name %></h1>
                    <p class="subtitle"><%= link.label || t.directLine %></p>
                </div>
            </div>
            <div class="panel-divider"></div>
            <div class="panel-copy">
                <p class="eyebrow"><%= t.directLine %></p>
                <p><%= t.panelBody %></p>
                <div class="steps">
                    <div class="step"><span class="step-index">01</span><span class="step-text"><%= t.stepCall %></span></div>
                    <div class="step"><span class="step-index">02</span><span class="step-text"><%= t.stepConnect %></span></div>
                    <div class="step"><span class="step-index">03</span><span class="step-text"><%= t.stepTalk %></span></div>
                </div>
            </div>
            <div class="panel-bottom">
                <p class="consent"><%= consentText %></p>
                <p class="powered"><%= t.poweredBy %></p>
            </div>
        </aside>

        <section class="call-panel panel" aria-live="polite">
            <div class="call-top">
                <span class="status-pill"><span class="status-dot"></span><span id="guestStatus" class="status-text"><%= autoStartEnabled ? t.connecting : t.ready %></span></span>
                <span class="connection-mark"><%= t.secure %></span>
            </div>

            <div class="call-stage">
                <div class="call-visual">
                    <span class="call-rings" aria-hidden="true"></span>
                    <span class="call-orb" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6.27 6.27l1.17-1.17a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"/></svg>
                    </span>
                </div>
                <div class="wave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
                <div id="guestTimer" class="timer">00:00</div>
                <h2 id="guestStateTitle" class="state-title"><%= autoStartEnabled ? t.connecting : t.callPrompt %></h2>
                <p id="guestStateText" class="state-text"><%= autoStartEnabled ? t.preparing : t.tapToCall %></p>
            </div>

            <div class="call-actions">
                <button id="guestCallBtn" type="button" class="primary-action"><%= buttonText %></button>
                <button id="guestCancelBtn" type="button" class="secondary-action"><%= t.cancel %></button>
                <button id="guestRetryBtn" type="button" class="primary-action"><%= t.tryAgain %></button>
                <div id="guestInCallActions" class="connected-actions">
                    <div class="control-group">
                        <button id="guestMuteBtn" type="button" class="control" aria-label="<%= t.mute %>" aria-pressed="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
                        </button>
                        <span id="guestMuteLabel" class="control-label"><%= t.mute %></span>
                    </div>
                    <div class="control-group">
                        <button id="guestEndBtn" type="button" class="control end" aria-label="<%= t.hangup %>">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v2a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h2a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 .17 3.4"/></svg>
                        </button>
                        <span class="control-label"><%= t.hangup %></span>
                    </div>
                </div>
                <button id="guestAudioBtn" type="button" class="audio-unlock hidden"><%= t.enableAudio %></button>
                <p id="guestCallSummary" class="call-summary"></p>
            </div>
        </section>
    </main>

    <div class="audio-modal-backdrop" id="guestAudioModal" aria-hidden="true">
        <div class="audio-modal" role="dialog" aria-modal="true" aria-labelledby="guestAudioModalTitle">
            <div class="audio-modal-head">
                <h2 id="guestAudioModalTitle"><%= t.audioSettings %></h2>
                <button type="button" class="audio-close" id="guestAudioCloseBtn" aria-label="<%= t.close %>">✕</button>
            </div>
            <label class="audio-field">
                <span><%= t.microphone %></span>
                <select id="guestAudioInput"><option value=""><%= t.defaultDevice %></option></select>
            </label>
            <label class="audio-field">
                <span><%= t.speaker %></span>
                <select id="guestAudioOutput"><option value=""><%= t.defaultDevice %></option></select>
            </label>
            <p class="audio-help" id="guestAudioSupport"></p>
        </div>
    </div>

    <div id="guestLabMount"></div>
    <template id="guestLabTemplate">
        <section class="lab-section">
            <details class="preview-fields" open>
                <summary><span><%= isRtl ? 'عرض كل أنواع الحقول' : 'Show all field types' %></span></summary>
                <div class="preview-fields-body">
                    <div class="preview-kicker">UI preview · mock data</div>
                    <h2><%= isRtl ? 'كل أنواع الحقول المتاحة' : 'All available field types' %></h2>
                    <p><%= isRtl ? 'دي معاينة للشكل فقط — مفيش بيانات بتتبعت.' : 'Visual preview only — no data is submitted.' %></p>
                    <div class="preview-field-grid">
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'نص' : 'Text' %> <small>text</small></label><input class="preview-input" type="text" value="<%= isRtl ? 'أحمد محمد' : 'Ahmed Mohamed' %>"></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'بريد إلكتروني' : 'Email' %> <small>email</small></label><input class="preview-input" type="email" value="ahmed@example.com"></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'هاتف' : 'Phone' %> <small>tel</small></label><input class="preview-input" type="tel" value="+20 100 123 4567"></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'رقم' : 'Number' %> <small>number</small></label><input class="preview-input" type="number" value="2" min="0"></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'تاريخ' : 'Date' %> <small>date</small></label><input class="preview-input" type="date" value="2026-11-09"></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'قائمة منسدلة' : 'Dropdown' %> <small>select</small></label><select class="preview-input"><option><%= isRtl ? 'القاهرة' : 'Cairo' %></option><option><%= isRtl ? 'الجيزة' : 'Giza' %></option><option><%= isRtl ? 'الإسكندرية' : 'Alexandria' %></option></select></div>
                        <div class="preview-field full"><label class="preview-field-label"><%= isRtl ? 'نص طويل' : 'Long text' %> <small>textarea</small></label><textarea class="preview-input" placeholder="<%= isRtl ? 'اكتب ملاحظاتك هنا...' : 'Write your notes here...' %>"></textarea></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'مربع اختيار' : 'Checkbox' %> <small>checkbox</small></label><label class="preview-check"><input type="checkbox" checked><span><%= isRtl ? 'أوافق على تسجيل المكالمة' : 'I agree to call recording' %></span></label></div>
                        <div class="preview-field"><label class="preview-field-label"><%= isRtl ? 'صورة الشعار' : 'Logo image' %> <small>file / PNG</small></label><input class="preview-input" type="file" accept="image/png"></div>
                    </div>
                </div>
            </details>
        </section>
    </template>

    <div id="sokratGuestConfig"
         data-tenant="<%= tenant.public_id %>"
         data-link="<%= link.slug %>"
         data-lang="<%= lang %>"
         data-embedded="<%= isEmbedded ? '1' : '0' %>"
         data-autostart="<%= autoStartEnabled ? '1' : '0' %>"
         data-preview="<%= previewMode ? '1' : '0' %>"
         data-labels="<%= JSON.stringify({
             ready: t.ready, preparing: t.preparing, connecting: t.connecting, ringing: t.ringing,
             callPrompt: t.callPrompt,
             connected: t.connected, ended: t.ended, failed: t.failed, noAnswer: t.noAnswer,
             tryAgain: t.tryAgain, tapToCall: t.tapToCall, cancelled: t.cancelled,
             enableAudio: t.enableAudio, hangup: t.hangup, mute: t.mute, unmute: t.unmute,
             noAgents: t.noAgents, busy: t.busy, micDenied: t.micDenied,
             audioSettings: t.audioSettings, microphone: t.microphone, speaker: t.speaker,
             defaultDevice: t.defaultDevice, audioUnsupported: t.audioUnsupported,
             duration: t.duration, callAgainHint: t.callAgainHint
         }) %>"
         data-call-label="<%= buttonText %>"></div>

    <script src="/js/jssip.min.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
    <script src="/js/guest-call.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
</body>
</html>

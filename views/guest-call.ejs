<%
const lang = currentLang === 'ar' ? 'ar' : 'en';
const isRtl = lang === 'ar';
const autoStartEnabled = typeof autoStart === 'undefined' ? true : Boolean(autoStart);
const previewMode = typeof preview !== 'undefined' && Boolean(preview);
const t = isRtl ? {
    callNow: 'اتصل الآن',
    connecting: 'جارٍ الاتصال...',
    ringing: 'جارٍ الرنين...',
    connected: 'المكالمة متصلة',
    ended: 'انتهت المكالمة',
    failed: 'تعذر بدء المكالمة',
    noAnswer: 'لم يرد النشاط التجاري. حاول مرة أخرى.',
    tryAgain: 'حاول مرة أخرى',
    tapToCall: 'اضغط للاتصال',
    enableAudio: 'اضغط لسماع المكالمة',
    hangup: 'إنهاء',
    mute: 'كتم',
    unmute: 'إلغاء الكتم',
    consent: 'بالضغط على اتصال، سيتم توصيلك بهذا النشاط التجاري. قد يتم تسجيل المكالمة.',
    poweredBy: 'مدعوم بواسطة Sokrat VOIP',
    noAgents: 'لا يوجد ممثلون متاحون الآن. حاول لاحقاً.',
    busy: 'كل الخطوط مشغولة الآن. حاول بعد قليل.',
    micDenied: 'تم رفض إذن الميكروفون. اسمح بالميكروفون ثم أعد المحاولة.',
    seconds: 'ث'
} : {
    callNow: 'Call now',
    connecting: 'Connecting...',
    ringing: 'Ringing...',
    connected: 'Connected',
    ended: 'Call ended',
    failed: 'Could not start the call',
    noAnswer: 'The business did not answer. Please try again.',
    tryAgain: 'Try again',
    tapToCall: 'Tap to call',
    enableAudio: 'Tap to hear the call',
    hangup: 'Hang up',
    mute: 'Mute',
    unmute: 'Unmute',
    consent: 'By tapping Call, you will be connected to this business. This call may be recorded.',
    poweredBy: 'Powered by Sokrat VOIP',
    noAgents: 'No agents are available right now. Please try again later.',
    busy: 'All lines are busy right now. Please try again shortly.',
    micDenied: 'Microphone permission was denied. Allow the microphone and try again.',
    seconds: 's'
};
const branding = tenant && tenant.branding && typeof tenant.branding === 'object' ? tenant.branding : {};
const hexColor = (value, fallback) => /^#[0-9a-fA-F]{3}(?:[0-9a-fA-F]{3})?(?:[0-9a-fA-F]{2})?$/.test(String(value || '')) ? String(value) : fallback;
const brandColor = hexColor(branding.primary_color, '#cc090c');
const brand2Color = hexColor(branding.secondary_color, '#7b0002');
const bgColor = hexColor(branding.background_color, '#000000');
const textColor = hexColor(branding.text_color, '#f4f4f5');
const mutedColor = hexColor(branding.muted_color, '#a1a1aa');
const onBrandColor = hexColor(branding.button_text_color, '#ffffff');
const rawLogo = typeof branding.logo_url === 'string' ? branding.logo_url : '';
const logoUrl = /^https?:\/\//i.test(rawLogo) || /^\/uploads\/tenant-logos\/[A-Za-z0-9._-]+\.png$/i.test(rawLogo) ? rawLogo : '';
const consentText = (tenant && tenant.consent_text) || t.consent;
const buttonText = (branding.button_text || t.callNow).toString().slice(0, 40);
%>
<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>" class="<%= previewMode ? 'preview-page-root' : '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="<%= bgColor %>">
    <meta name="robots" content="noindex,nofollow">
    <title><%= tenant.name %> — <%= isRtl ? 'اتصل بنا' : 'Call us' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: <%= brandColor %>;
            --brand-2: <%= brand2Color %>;
            --brand-soft: color-mix(in srgb, var(--brand) 22%, transparent);
            --bg: <%= bgColor %>;
            --panel: color-mix(in srgb, var(--bg) 86%, #fff 14%);
            --panel-strong: color-mix(in srgb, var(--bg) 92%, #fff 8%);
            --border: color-mix(in srgb, var(--text) 12%, transparent);
            --text: <%= textColor %>;
            --muted: <%= mutedColor %>;
            --on-brand: <%= onBrandColor %>;
            --ok: #34d399;
            --danger: #ef4444;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html, body { height: 100%; min-height: 100%; }
        body {
            margin: 0;
            min-height: 100dvh;
            overflow: hidden;
            background:
                radial-gradient(circle at 50% -10%, var(--brand-soft), transparent 48%),
                radial-gradient(circle at 90% 90%, rgba(124, 58, 237, .12), transparent 42%),
                var(--bg);
            color: var(--text);
            font-family: 'Cairo', 'JetBrains Mono', 'Segoe UI', Tahoma, Arial, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: max(18px, env(safe-area-inset-top)) 18px max(18px, env(safe-area-inset-bottom));
            user-select: none;
        }
        .orbs { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
        .orb { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .35; animation: sokrFloat 12s ease-in-out infinite; }
        .orb-a { width: 260px; height: 260px; background: var(--brand); top: -90px; left: -70px; }
        .orb-b { width: 220px; height: 220px; background: var(--brand-2); bottom: -80px; right: -60px; animation-delay: -5s; }
        .card {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 430px;
            padding: 26px 24px 22px;
            border: 1px solid var(--border);
            border-radius: 28px;
            background: linear-gradient(180deg, rgba(28, 28, 36, .92), rgba(11, 11, 15, .94));
            box-shadow: 0 30px 100px rgba(0, 0, 0, .55), inset 0 1px 0 rgba(255, 255, 255, .06);
            backdrop-filter: blur(18px);
            text-align: center;
            overflow: hidden;
        }
        .card::before {
            content: '';
            position: absolute;
            inset: 0 0 auto;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--brand), var(--brand-2), var(--brand), transparent);
            opacity: .9;
            animation: sokrLaser 3.2s ease-in-out infinite;
        }
        .brand {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .24em;
            color: var(--muted);
            text-transform: uppercase;
            margin-bottom: 18px;
        }
        .brand b { color: var(--text); font-weight: 900; }
        .brand i {
            width: 7px; height: 7px; border-radius: 50%;
            background: var(--brand);
            box-shadow: 0 0 14px var(--brand);
            animation: sokrBlink 1.8s ease-in-out infinite;
        }
        .avatar-wrap { position: relative; width: 96px; height: 96px; margin: 0 auto 14px; display: grid; place-items: center; }
        .avatar {
            width: 78px; height: 78px; border-radius: 50%;
            display: grid; place-items: center;
            background: linear-gradient(135deg, var(--brand), var(--brand-2));
            font-size: 30px; font-weight: 900;
            box-shadow: 0 12px 34px var(--brand-soft);
            position: relative; z-index: 2;
            overflow: hidden;
        }
        .avatar img { width: 100%; height: 100%; object-fit: cover; }
        .avatar-wrap::before, .avatar-wrap::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 1px solid var(--brand);
            opacity: 0;
        }
        .card[data-state="ringing"] .avatar-wrap::before,
        .card[data-state="connected"] .avatar-wrap::before {
            animation: sokrPulse 2s ease-out infinite;
        }
        .card[data-state="ringing"] .avatar-wrap::after,
        .card[data-state="connected"] .avatar-wrap::after {
            animation: sokrPulse 2s ease-out 1s infinite;
        }
        .card[data-state="connected"] .avatar { box-shadow: 0 0 0 8px rgba(52, 211, 153, .08), 0 12px 34px var(--brand-soft); }
        h1 { font-size: 22px; line-height: 1.2; margin: 0 0 5px; letter-spacing: -.02em; }
        .subtitle { color: var(--muted); font-size: 12.5px; margin: 0 0 16px; }
        .status-row {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            max-width: 100%;
            padding: 8px 13px;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, .035);
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            line-height: 1.35;
        }
        .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--muted); flex: 0 0 auto; }
        .card[data-state="connecting"] .status-dot { background: var(--brand); animation: sokrBlink 1.2s ease-in-out infinite; }
        .card[data-state="ringing"] .status-dot { background: #fbbf24; animation: sokrBlink 1s ease-in-out infinite; }
        .card[data-state="connected"] .status-dot { background: var(--ok); box-shadow: 0 0 10px var(--ok); }
        .card[data-state="failed"] .status-dot { background: var(--danger); }
        .card[data-state="ended"] .status-dot { background: var(--muted); }
        .status-text { white-space: normal; overflow-wrap: anywhere; }
        .status-text.error { color: #fca5a5; }
        .wave { height: 34px; display: flex; align-items: center; justify-content: center; gap: 5px; margin: 14px 0 2px; opacity: 0; transition: opacity .25s; }
        .card[data-state="connecting"] .wave,
        .card[data-state="ringing"] .wave,
        .card[data-state="connected"] .wave { opacity: 1; }
        .wave span {
            display: block; width: 4px; height: 9px; border-radius: 99px;
            background: linear-gradient(180deg, var(--brand), var(--brand-2));
            transform-origin: center;
            animation: sokrWave 1.05s ease-in-out infinite;
        }
        .wave span:nth-child(2) { animation-delay: .12s; }
        .wave span:nth-child(3) { animation-delay: .24s; }
        .wave span:nth-child(4) { animation-delay: .36s; }
        .wave span:nth-child(5) { animation-delay: .48s; }
        .card[data-state="connected"] .wave span { animation-duration: .68s; background: linear-gradient(180deg, var(--ok), #22d3ee); }
        .timer {
            font-size: 42px;
            font-weight: 900;
            letter-spacing: -.04em;
            font-variant-numeric: tabular-nums;
            margin: 2px 0 14px;
            text-shadow: 0 0 30px var(--brand-soft);
        }
        .call-btn {
            width: 100%;
            min-height: 58px;
            border: 0;
            border-radius: 18px;
            padding: 16px 20px;
            background: linear-gradient(135deg, var(--brand), color-mix(in srgb, var(--brand) 70%, #000));
            color: var(--on-brand);
            font-family: inherit;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            box-shadow: 0 14px 34px var(--brand-soft);
            transition: transform .12s ease, filter .12s ease, box-shadow .12s ease;
            touch-action: manipulation;
        }
        .call-btn:hover { filter: brightness(1.08); }
        .call-btn:active { transform: scale(.985); }
        .call-btn:disabled { opacity: .55; cursor: not-allowed; }
        .call-btn.end { background: var(--panel-strong); border: 1px solid var(--border); box-shadow: none; }
        .controls { display: none; justify-content: center; align-items: center; gap: 44px; margin: 8px 0 4px; }
        .card[data-state="connected"] .controls { display: flex; }
        .control-group { display: flex; flex-direction: column; align-items: center; gap: 7px; }
        .control {
            width: 64px; height: 64px; border-radius: 50%;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, .06);
            color: var(--text);
            display: grid; place-items: center;
            cursor: pointer;
            transition: transform .12s ease, background .12s ease;
            touch-action: manipulation;
        }
        .control svg { width: 24px; height: 24px; }
        .control:active { transform: scale(.94); }
        .control.end { background: linear-gradient(135deg, #ef4444, #b91c1c); border-color: transparent; box-shadow: 0 12px 30px rgba(239, 68, 68, .28); }
        .control-label { font-size: 10px; font-weight: 800; color: var(--muted); letter-spacing: .02em; }
        .consent { color: var(--muted); font-size: 10.5px; line-height: 1.65; margin: 18px 0 0; }
        .powered { color: var(--muted); font-size: 9px; margin-top: 14px; letter-spacing: .12em; text-transform: uppercase; }
        .powered b { color: var(--brand); font-weight: 900; }
        .hidden { display: none !important; }
        html.preview-page-root {
            height: auto;
            min-height: 100%;
            overflow-y: auto;
            background: var(--bg);
        }
        html.preview-page-root body.preview-page {
            height: auto;
            min-height: 100dvh;
            overflow-y: auto;
            align-items: flex-start;
            justify-content: flex-start;
            flex-direction: column;
        }
        body.preview-page .card {
            margin: 16px auto 0;
            max-width: 380px;
            padding: 18px 18px 14px;
            border-radius: 16px;
            flex: 0 0 auto;
        }
        body.preview-page .brand { margin-bottom: 8px; font-size: 9px; }
        body.preview-page .avatar-wrap { width: 66px; height: 66px; margin-bottom: 6px; }
        body.preview-page .avatar { width: 56px; height: 56px; font-size: 21px; }
        body.preview-page h1 { font-size: 19px; margin: 4px 0 2px; }
        body.preview-page .subtitle { font-size: 10px; }
        body.preview-page .status-row { margin-top: 8px; padding: 7px 10px; font-size: 10px; }
        body.preview-page .wave { height: 20px; margin-top: 5px; }
        body.preview-page .timer { font-size: 30px; margin: 4px 0 5px; }
        body.preview-page .call-btn { min-height: 46px; padding: 10px 14px; border-radius: 14px; font-size: 13px; }
        body.preview-page .controls { gap: 28px; margin: 4px 0 2px; }
        body.preview-page .control { width: 48px; height: 48px; }
        body.preview-page .control svg { width: 19px; height: 19px; }
        body.preview-page .control-label { font-size: 8px; }
        body.preview-page .consent { font-size: 9px; line-height: 1.45; margin-top: 10px; }
        body.preview-page .powered { font-size: 7.5px; margin-top: 7px; }
        .preview-fields {
            width: min(680px, calc(100% - 28px));
            margin: 12px auto 28px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(28, 28, 36, .92), rgba(11, 11, 15, .94));
            box-shadow: 0 24px 80px rgba(0, 0, 0, .45);
            color: var(--text);
            overflow: hidden;
        }
        .preview-fields summary {
            cursor: pointer;
            list-style: none;
            padding: 11px 15px;
            font-size: 12px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }
        .preview-fields summary::-webkit-details-marker { display: none; }
        .preview-fields summary::after {
            content: '⌄';
            color: var(--brand);
            font-size: 18px;
            line-height: 1;
            transition: transform .18s ease;
        }
        .preview-fields[open] summary::after { transform: rotate(180deg); }
        .preview-fields[open] summary { border-bottom: 1px solid var(--border); }
        .preview-fields-body { padding: 13px 15px 15px; }
        .preview-kicker {
            color: var(--brand);
            font-size: 8px;
            font-weight: 900;
            letter-spacing: .16em;
            text-transform: uppercase;
            margin-bottom: 4px;
        }
        .preview-fields h2 { margin: 0 0 2px; font-size: 15px; font-weight: 900; }
        .preview-fields p { margin: 0 0 10px; color: var(--muted); font-size: 10px; line-height: 1.6; }
        .preview-field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .preview-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
        .preview-field.full { grid-column: 1 / -1; }
        .preview-field-label {
            color: var(--muted);
            font-size: 9px;
            font-weight: 800;
            display: flex;
            gap: 6px;
            align-items: baseline;
        }
        .preview-field-label small { color: var(--brand); font-size: 8px; font-weight: 800; }
        .preview-input {
            width: 100%;
            min-height: 34px;
            padding: 7px 9px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: color-mix(in srgb, var(--bg) 88%, #fff 12%);
            color: var(--text);
            font: inherit;
            font-size: 11px;
            outline: none;
            color-scheme: dark;
        }
        .preview-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
        textarea.preview-input { min-height: 54px; resize: vertical; }
        .preview-check {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 34px;
            padding: 7px 9px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: color-mix(in srgb, var(--bg) 88%, #fff 12%);
            color: var(--text);
            font-size: 11px;
        }
        .preview-check input { width: 13px; height: 13px; accent-color: var(--brand); }
        .preview-help { color: var(--muted); font-size: 8px; }
        @media (max-width: 560px) {
            body.preview-page .card {
                max-width: none;
                min-height: 100dvh;
                border: 0;
                border-radius: 0;
                margin: 0 auto;
                padding: calc(24px + env(safe-area-inset-top)) 18px calc(18px + env(safe-area-inset-bottom));
            }
            .preview-fields { width: calc(100% - 20px); margin: 10px auto 20px; border-radius: 14px; }
            .preview-field-grid { grid-template-columns: 1fr; }
            .preview-field.full { grid-column: auto; }
        }
        @keyframes sokrPulse {
            0% { transform: scale(.86); opacity: .65; }
            100% { transform: scale(1.45); opacity: 0; }
        }
        @keyframes sokrWave {
            0%, 100% { transform: scaleY(.55); opacity: .7; }
            50% { transform: scaleY(2.6); opacity: 1; }
        }
        @keyframes sokrBlink {
            0%, 100% { opacity: 1; }
            50% { opacity: .35; }
        }
        @keyframes sokrLaser {
            0%, 100% { transform: translateX(-60%); opacity: .55; }
            50% { transform: translateX(60%); opacity: 1; }
        }
        @keyframes sokrFloat {
            0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
            50% { transform: translate3d(18px, 24px, 0) scale(1.08); }
        }
        @media (max-width: 560px) {
            body { padding: 0; }
            .card {
                max-width: none;
                min-height: 100dvh;
                border: 0;
                border-radius: 0;
                padding: calc(28px + env(safe-area-inset-top)) 22px calc(22px + env(safe-area-inset-bottom));
                display: flex;
                flex-direction: column;
                justify-content: center;
                box-shadow: none;
            }
            .card::before { height: 3px; }
            .brand { margin-bottom: 14px; }
            .avatar-wrap { width: 104px; height: 104px; margin-bottom: 12px; }
            .avatar { width: 84px; height: 84px; font-size: 32px; }
            h1 { font-size: 24px; }
            .timer { font-size: 46px; }
            .call-btn { min-height: 62px; font-size: 17px; }
            .control { width: 68px; height: 68px; }
            .consent { font-size: 11px; margin-top: 22px; }
        }
        @media (max-height: 640px) {
            .card { padding-top: 18px; padding-bottom: 16px; }
            .avatar-wrap { width: 78px; height: 78px; margin-bottom: 8px; }
            .avatar { width: 66px; height: 66px; font-size: 26px; }
            .timer { font-size: 34px; margin-bottom: 8px; }
            .wave { height: 24px; margin: 8px 0 0; }
            .consent { margin-top: 10px; }
            .powered { margin-top: 8px; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
        }

        /* Sokrat visual system */
        :root {
            --panel: #0b0b0e;
            --panel-strong: #121217;
            --border: #27272a;
            --ok: #22c55e;
            --danger: #cc090c;
        }
        html, body { font-family: 'JetBrains Mono', 'Cairo', monospace; }
        body {
            background:
                radial-gradient(ellipse at 50% -20%, color-mix(in srgb, var(--brand) 18%, transparent), transparent 56%),
                var(--bg);
        }
        .orbs { display: none; }
        .card {
            max-width: 410px;
            padding: 22px 20px 18px;
            border: 1px solid #27272a;
            border-radius: 16px;
            background: linear-gradient(180deg, #121217, #0a0a0d);
            box-shadow: 0 24px 70px rgba(0, 0, 0, .62);
            backdrop-filter: none;
        }
        .card::before {
            height: 2px;
            background: var(--brand);
            animation: none;
            opacity: 1;
        }
        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin: 0 auto 16px;
            color: var(--text);
            font-size: 10px;
            font-weight: 900;
            letter-spacing: .16em;
        }
        .brand img {
            width: 24px;
            height: 24px;
            object-fit: contain;
            border-radius: 6px;
        }
        .brand b { color: var(--brand); }
        .brand i { display: none; }
        .avatar-wrap { width: 64px; height: 64px; margin-bottom: 10px; }
        .avatar {
            width: 56px;
            height: 56px;
            border-radius: 14px;
            border: 1px solid rgba(255, 255, 255, .12);
            background: linear-gradient(145deg, var(--brand), var(--brand-2));
            font-size: 21px;
            box-shadow: none;
        }
        .avatar-wrap::before, .avatar-wrap::after { display: none; }
        h1 {
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            font-size: 20px;
            letter-spacing: -.03em;
            margin-bottom: 4px;
        }
        .subtitle { font-size: 11px; margin-bottom: 14px; }
        .status-row {
            width: 100%;
            justify-content: center;
            border-radius: 8px;
            border-color: #27272a;
            background: #0b0b0e;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .04em;
            padding: 8px 10px;
        }
        .wave { height: 24px; margin: 10px 0 2px; }
        .wave span { width: 3px; background: var(--brand); }
        .card[data-state="connected"] .wave span { background: var(--ok); }
        .timer {
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            font-size: 34px;
            letter-spacing: -.03em;
            text-shadow: none;
            margin: 2px 0 10px;
        }
        .call-btn {
            min-height: 48px;
            padding: 12px 16px;
            border-radius: 10px;
            background: linear-gradient(180deg, var(--brand), #7b0002);
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            font-size: 13px;
            letter-spacing: .04em;
            box-shadow: 0 10px 24px var(--brand-soft);
        }
        .controls { gap: 32px; margin: 8px 0 4px; }
        .control {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: #121217;
            border-color: #27272a;
        }
        .control svg { width: 20px; height: 20px; }
        .control.end {
            background: linear-gradient(180deg, #cc090c, #7b0002);
            border-color: transparent;
            box-shadow: 0 10px 22px rgba(204, 9, 12, .24);
        }
        .control-label { font-size: 9px; letter-spacing: .04em; }
        .consent {
            border-top: 1px solid #27272a;
            padding-top: 11px;
            margin-top: 12px;
            font-size: 9.5px;
        }
        .powered { font-size: 8px; letter-spacing: .1em; margin-top: 10px; }
        .powered b { color: var(--brand); }
        .preview-fields {
            background: #0b0b0e;
            border-color: #27272a;
            border-radius: 14px;
            box-shadow: 0 18px 50px rgba(0, 0, 0, .45);
        }
        .preview-fields summary {
            font-family: 'JetBrains Mono', 'Cairo', monospace;
            letter-spacing: .06em;
        }
        .preview-fields h2,
        .preview-kicker,
        .preview-field-label {
            font-family: 'JetBrains Mono', 'Cairo', monospace;
        }
        .preview-kicker { letter-spacing: .14em; }
        .preview-field-label { letter-spacing: .03em; }
        .preview-input,
        .preview-check {
            background: #000;
            border-color: #27272a;
            border-radius: 8px;
            font-family: 'JetBrains Mono', 'Cairo', monospace;
        }
        .preview-input:focus { box-shadow: 0 0 0 2px var(--brand-soft); }
        @media (max-width: 560px) {
            body { padding: 16px; }
            body.preview-page { padding: 0; }
            .card {
                max-width: none;
                min-height: 0;
                border: 1px solid #27272a;
                border-radius: 16px;
                padding: 22px 20px 18px;
                box-shadow: 0 20px 54px rgba(0, 0, 0, .55);
                display: block;
            }
            body.preview-page .card {
                max-width: none;
                min-height: 0;
                border: 1px solid #27272a;
                border-radius: 16px;
                margin: 16px auto 0;
                padding: 22px 20px 18px;
                box-shadow: 0 20px 54px rgba(0, 0, 0, .55);
            }
            .brand { margin-bottom: 12px; }
            .avatar-wrap { width: 64px; height: 64px; margin-bottom: 8px; }
            .avatar { width: 56px; height: 56px; font-size: 21px; }
            h1 { font-size: 21px; }
            .timer { font-size: 34px; }
            .call-btn { min-height: 48px; font-size: 13px; }
            .control { width: 52px; height: 52px; }
            .consent { font-size: 9.5px; margin-top: 12px; }
        }
    </style>
</head>
<body class="<%= previewMode ? 'preview-page' : '' %>">
    <div class="orbs" aria-hidden="true"><div class="orb orb-a"></div><div class="orb orb-b"></div></div>
    <main class="card" id="callCard" data-state="<%= autoStartEnabled ? 'connecting' : 'idle' %>">
        <div class="brand">
            <img src="/logo_light_text.png" alt="Sokrat VOIP">
            <span>Sokrat <b>VOIP</b></span>
        </div>
        <div class="avatar-wrap">
            <div class="avatar">
                <% if (logoUrl) { %>
                    <img src="<%= logoUrl %>" alt="<%= tenant.name %>">
                <% } else { %>
                    <%= String(tenant.name || '?').trim().charAt(0).toUpperCase() %>
                <% } %>
            </div>
        </div>
        <h1><%= tenant.name %></h1>
        <p class="subtitle"><%= link.label || (isRtl ? 'اتصل بنا مباشرة' : 'Speak to us directly') %></p>

        <div class="status-row"><span class="status-dot"></span><span id="guestStatus" class="status-text" aria-live="polite"><%= autoStartEnabled ? t.connecting : (isRtl ? 'اضغط على الزر لبدء المكالمة' : 'Tap the button to start the call') %></span></div>
        <div class="wave" id="guestWave" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
        <div id="guestTimer" class="timer hidden">00:00</div>

        <button id="guestCallBtn" type="button" class="call-btn<%= autoStartEnabled ? ' hidden' : '' %>"><%= buttonText %></button>
        <button id="guestAudioBtn" type="button" class="call-btn hidden" style="margin-top:10px"><%= t.enableAudio %></button>

        <div class="controls hidden" id="guestInCallActions">
            <div class="control-group">
                <button id="guestMuteBtn" type="button" class="control" aria-label="<%= t.mute %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
                </button>
                <span id="guestMuteLabel" class="control-label"><%= t.mute %></span>
            </div>
            <div class="control-group">
                <button id="guestEndBtn" type="button" class="control end" aria-label="<%= t.hangup %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v2a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h2a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 .17 3.4"/></svg>
                </button>
                <span class="control-label"><%= t.hangup %></span>
            </div>
        </div>

        <p class="consent"><%= consentText %></p>
        <p class="powered"><%= t.poweredBy %></p>
    </main>

    <% if (previewMode) { %>
    <details class="preview-fields" open>
        <summary>
            <span><%= isRtl ? 'عرض كل أنواع الحقول' : 'Show all field types' %></span>
        </summary>
        <div class="preview-fields-body">
            <div class="preview-kicker">UI preview · mock data</div>
            <h2><%= isRtl ? 'كل أنواع الحقول المتاحة' : 'All available field types' %></h2>
            <p><%= isRtl ? 'دي معاينة للشكل فقط — مفيش بيانات بتتبعت.' : 'Visual preview only — no data is submitted.' %></p>
            <div class="preview-field-grid">
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'نص' : 'Text' %> <small>text</small></label>
                    <input class="preview-input" type="text" value="<%= isRtl ? 'أحمد محمد' : 'Ahmed Mohamed' %>">
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'بريد إلكتروني' : 'Email' %> <small>email</small></label>
                    <input class="preview-input" type="email" value="ahmed@example.com">
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'هاتف' : 'Phone' %> <small>tel</small></label>
                    <input class="preview-input" type="tel" value="+20 100 123 4567">
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'رقم' : 'Number' %> <small>number</small></label>
                    <input class="preview-input" type="number" value="2" min="0">
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'تاريخ' : 'Date' %> <small>date</small></label>
                    <input class="preview-input" type="date" value="2026-11-09">
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'قائمة منسدلة' : 'Dropdown' %> <small>select</small></label>
                    <select class="preview-input">
                        <option><%= isRtl ? 'القاهرة' : 'Cairo' %></option>
                        <option><%= isRtl ? 'الجيزة' : 'Giza' %></option>
                        <option><%= isRtl ? 'الإسكندرية' : 'Alexandria' %></option>
                    </select>
                </div>
                <div class="preview-field full">
                    <label class="preview-field-label"><%= isRtl ? 'نص طويل' : 'Long text' %> <small>textarea</small></label>
                    <textarea class="preview-input" placeholder="<%= isRtl ? 'اكتب ملاحظاتك هنا...' : 'Write your notes here...' %>"></textarea>
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'مربع اختيار' : 'Checkbox' %> <small>checkbox</small></label>
                    <label class="preview-check">
                        <input type="checkbox" checked>
                        <span><%= isRtl ? 'أوافق على تسجيل المكالمة' : 'I agree to call recording' %></span>
                    </label>
                </div>
                <div class="preview-field">
                    <label class="preview-field-label"><%= isRtl ? 'صورة الشعار' : 'Logo image' %> <small>file / PNG</small></label>
                    <input class="preview-input" type="file" accept="image/png">
                </div>
            </div>
        </div>
    </details>
    <% } %>

    <div id="sokratGuestConfig"
         data-tenant="<%= tenant.public_id %>"
         data-link="<%= link.slug %>"
         data-lang="<%= lang %>"
         data-embedded="<%= isEmbedded ? '1' : '0' %>"
         data-autostart="<%= autoStartEnabled ? '1' : '0' %>"
         data-preview="<%= previewMode ? '1' : '0' %>"
         data-labels="<%= JSON.stringify({
             connecting: t.connecting, ringing: t.ringing, connected: t.connected,
             ended: t.ended, failed: t.failed, tryAgain: t.tryAgain, tapToCall: t.tapToCall,
             enableAudio: t.enableAudio,
             hangup: t.hangup, mute: t.mute, unmute: t.unmute,
             noAgents: t.noAgents, busy: t.busy, micDenied: t.micDenied, noAnswer: t.noAnswer
         }) %>"
         data-call-label="<%= buttonText %>"></div>

    <script src="/js/jssip.min.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
    <script src="/js/guest-call.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
</body>
</html>

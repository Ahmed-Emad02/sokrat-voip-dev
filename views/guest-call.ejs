const branding = tenant && tenant.branding && typeof tenant.branding === 'object' ? tenant.branding : {};
const hexColor = (value, fallback) => /^#[0-9a-fA-F]{3}(?:[0-9a-fA-F]{3})?(?:[0-9a-fA-F]{2})?$/.test(String(value || '')) ? String(value) : fallback;
const brandColor = hexColor(branding.primary_color, '#cc090c');
const brand2Color = hexColor(branding.secondary_color, '#7b0002');
const bgColor = hexColor(branding.background_color, '#000000');
const textColor = hexColor(branding.text_color, '#f4f4f5');
const mutedColor = hexColor(branding.muted_color, '#a1a1aa');
const onBrandColor = hexColor(branding.button_text_color, '#ffffff');
function hexToRgb(hex) {
    let value = String(hex || '').replace('#', '');
    if (value.length === 3) value = value.split('').map(ch => ch + ch).join('');
    if (value.length > 6) value = value.slice(0, 6);
    return [parseInt(value.slice(0, 2), 16), parseInt(value.slice(2, 4), 16), parseInt(value.slice(4, 6), 16)];
}
function relativeLuminance(hex) {
    const rgb = hexToRgb(hex).map(value => {
        const channel = value / 255;
        return channel <= 0.03928 ? channel / 12.92 : Math.pow((channel + 0.055) / 1.055, 2.4);
    });

<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>" class="<%= previewMode ? 'preview-page-root' : '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="<%= bgColor %>">
    <meta name="robots" content="noindex,nofollow">
    <title><%= tenant.name %> — <%= isRtl ? 'اتصل بنا' : 'Call us' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --brand: <%= brandColor %>;
            --brand-2: <%= brand2Color %>;
            --brand-soft: color-mix(in srgb, var(--brand) 14%, transparent);
            --bg: <%= bgColor %>;
            --surface: <%= surfaceColor %>;
            --surface-2: <%= surfaceStrong %>;
            --line: <%= lineColor %>;
            --text: <%= resolvedTextColor %>;
            --muted: <%= resolvedMutedColor %>;
            --on-brand: <%= resolvedOnBrand %>;
            --sokrat-ink: <%= isLightBackground ? '#0f172a' : '#ffffff' %>;
            --ok: #22c55e;
            --danger: #dc2626;
            --shadow: <%= isLightBackground ? '0 10px 30px rgba(15, 23, 42, .08), 0 1px 3px rgba(15,23,42,.06)' : '0 20px 50px rgba(0, 0, 0, .45)' %>;
            color-scheme: <%= isLightBackground ? 'light' : 'dark' %>;
        }
        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        html { min-height: 100%; }
        body {
            margin: 0;
            min-height: 100dvh;
            padding: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Cairo', system-ui, -apple-system, sans-serif;
            -webkit-font-smoothing: antialiased;
        }
        body.preview-page { height: auto; overflow-y: auto; }
        /* Header — minimal, not competing */
        .sokrat-bar {
            width: min(440px, 100%);
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 14px 6px;
        }
        .brand-mark { display: flex; align-items: center; gap: 8px; min-width: 0; }
        .brand-mark img { width: 28px; height: 28px; object-fit: contain; border-radius: 6px; }
        .brand-mark span { font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
        .brand-mark span { color: var(--sokrat-ink); }
        .brand-mark b { color: var(--sokrat-ink); }
        .bar-actions { display: flex; align-items: center; gap: 8px; }
        .language-switch {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            min-height: 36px;
            padding: 6px 10px;
            border: 1px solid var(--line);
            border-radius: .65rem;
            background: var(--surface-2);
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: .72rem;
            font-weight: 800;
            text-decoration: none;
            white-space: nowrap;
            cursor: pointer;
        }
        .language-switch:hover { border-color: var(--brand); filter: brightness(1.08); }
        .language-switch:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .language-switch svg { width: 15px; height: 15px; color: var(--muted); }
        .language-switch .language-label { line-height: 1; }
        .audio-settings-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 44px;
            min-width: 44px;
            padding: 8px 12px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--surface);
            color: var(--muted);
            font-family: 'Cairo', sans-serif;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
        }
        .audio-settings-btn:hover { color: var(--text); border-color: var(--brand); }
        .audio-settings-btn:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .audio-settings-btn svg { width: 16px; height: 16px; }
        /* Single centered card — P0 fix */
        .hotline-shell {
            width: min(440px, 100%);
            margin: 0 auto;
            padding: 0 16px max(24px, env(safe-area-inset-bottom));
        }
        .panel {
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: 1rem;
            box-shadow: none;
            overflow: hidden;
        }
        .call-panel {
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 0;
        }
        .call-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 14px 18px 0;
        }
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            min-height: 32px;
            padding: 6px 12px;
            border: 1px solid var(--line);
            border-radius: 999px;
            background: var(--surface-2);
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            line-height: 1.2;
        }
        .status-pill[aria-live] { min-width: 0; }
        .status-dot { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--muted); }
        [data-state="connecting"] .status-dot { background: var(--brand); animation: sokrBlink 1.2s ease-in-out infinite; }
        [data-state="ringing"] .status-dot { background: #f59e0b; animation: sokrBlink 1s ease-in-out infinite; }
        [data-state="connected"] .status-dot { background: var(--ok); box-shadow: 0 0 8px rgba(34,197,94,.5); }
        [data-state="failed"] .status-dot,
        [data-state="mic_denied"] .status-dot { background: var(--danger); }
        [data-state="no_answer"] .status-dot,
        [data-state="busy"] .status-dot { background: #f59e0b; }
        .status-text { overflow-wrap: anywhere; font-size: 12px; }
        .status-text.error { color: #fca5a5; }
        .connection-mark { color: var(--muted); font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
        /* Business header inside card — not a separate panel */
        .business-header {
            position: relative;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px 10px;
            border-bottom: 1px solid var(--line);
            overflow: hidden;
        }
        .call-panel.has-header-image {
            background: transparent;
        }
        .hotline-shell.has-header-image {
            width: 100%;
            padding: 0;
        }
        .hotline-shell.has-header-image .call-panel {
            width: 100%;
            border: 0;
            border-radius: 0;
            box-shadow: none;
        }
        .hotline-shell.has-header-image .call-panel > .business-header,
        .hotline-shell.has-header-image .call-panel > .progress-steps,
        .hotline-shell.has-header-image .call-panel > .call-stage,
        .hotline-shell.has-header-image .call-panel > .call-actions {
            width: 100%;
            max-width: 440px;
            margin-left: auto;
            margin-right: auto;
        }
        .call-panel.has-header-image::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            background-image: var(--header-image);
            background-size: cover;
            background-position: center;
            pointer-events: none;
            -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 88%, transparent 100%);
            mask-image: linear-gradient(180deg, #000 0%, #000 58%, transparent 88%, transparent 100%);
        }
        .call-panel.has-header-image::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            background: linear-gradient(180deg, rgba(0, 0, 0, .08) 0%, rgba(0, 0, 0, .24) 40%, rgba(0, 0, 0, .58) 65%, var(--bg) 86%, var(--bg) 100%);
            pointer-events: none;
        }
        .call-panel.has-header-image > * { position: relative; z-index: 2; }
        .call-panel.has-header-image .business-header { min-height: 172px; align-items: flex-end; padding: 16px; border-bottom: 0; }
        .call-panel.has-header-image .business-header h1 { color: #ffffff; text-shadow: 0 1px 8px rgba(0,0,0,.45); }
        .call-panel.has-header-image .business-header .eyebrow { color: rgba(255,255,255,.9); }
        .call-panel.has-header-image .business-header .avatar-wrap { box-shadow: 0 4px 18px rgba(0,0,0,.35); }
        .call-panel.has-header-image .progress-step { color: rgba(255,255,255,.72); }
        .call-panel.has-header-image .step-icon { background: rgba(0,0,0,.35); border-color: rgba(255,255,255,.3); color: #fff; }
        .call-panel.has-header-image .progress-step.is-active { color: #fff; }
        .call-panel.has-header-image .step-arrow { background: rgba(255,255,255,.35); }
        .call-panel.has-header-image .step-arrow::after { border-left-color: rgba(255,255,255,.35); }
        .call-panel.has-header-image .timer,
        .call-panel.has-header-image .state-text { color: #fff; }
        .call-panel.has-header-image .state-text { text-shadow: 0 1px 6px rgba(0,0,0,.5); }
        .call-panel.has-header-image .call-actions {
            background: transparent;
            border-top: 0;
        }
        .call-panel.has-header-image .call-summary { color: rgba(255, 255, 255, .85); }
        .call-panel.has-header-image .control-label { color: rgba(255, 255, 255, .85); }
        .call-panel.has-header-image .control:not(.end) {
            background: rgba(0, 0, 0, .42);
            border-color: rgba(255, 255, 255, .28);
            color: #fff;
        }
        .call-panel.has-header-image .secondary-action,
        .call-panel.has-header-image .audio-unlock {
            background: rgba(0, 0, 0, .42);
            border-color: rgba(255, 255, 255, .3);
            color: #fff;
        }
        .avatar-wrap {
            width: 56px;
            height: 56px;
            flex: 0 0 56px;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: linear-gradient(145deg, var(--brand), var(--brand-2));
            overflow: hidden;
        }
        .avatar-wrap img { width: 100%; height: 100%; object-fit: cover; }
        .avatar-initial { font-size: 22px; font-weight: 800; color: var(--on-brand); }
        .identity-copy { min-width: 0; flex: 1; }
        .eyebrow {
            margin: 0 0 3px;
            color: var(--brand);
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }
        h1 {
            margin: 0;
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: 20px;
            line-height: 1.25;
            font-weight: 700;
            letter-spacing: -.015em;
            overflow-wrap: anywhere;
        }
        .subtitle { margin: 2px 0 0; color: var(--muted); font-size: 13px; line-height: 1.4; font-weight: 400; }
        /* Progress steps — updates with call state */
        .progress-steps {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 14px 0;
        }
        .progress-step {
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--muted);
            font-size: .64rem;
            font-weight: 700;
            transition: color .2s ease;
        }
        .step-icon {
            width: 28px;
            height: 28px;
            display: grid;
            place-items: center;
            border: 1px solid var(--line);
            border-radius: 50%;
            background: var(--surface-2);
            color: var(--muted);
            transition: background .2s ease, border-color .2s ease, color .2s ease, box-shadow .2s ease;
        }
        .step-icon svg { width: 14px; height: 14px; }
        .step-label { white-space: nowrap; }
        .progress-step.is-active { color: var(--brand); }
        .progress-step.is-active .step-icon {
            background: var(--brand);
            border-color: var(--brand);
            color: var(--on-brand);
            box-shadow: 0 0 0 3px var(--brand-soft);
        }
        .progress-step.is-done { color: var(--text); }
        .progress-step.is-done .step-icon {
            background: var(--brand-soft);
            border-color: var(--brand);
            color: var(--brand);
        }
        .step-arrow {
            position: relative;
            flex: 0 0 24px;
            height: 1px;
            background: var(--line);
            transition: background .2s ease;
        }
        .step-arrow::after {
            content: '';
            position: absolute;
            right: 0;
            top: -3px;
            border-left: 5px solid var(--line);
            border-top: 3px solid transparent;
            border-bottom: 3px solid transparent;
            transition: border-color .2s ease;
        }
        .step-arrow.is-done { background: var(--brand); }
        .step-arrow.is-done::after { border-left-color: var(--brand); }
        html[dir="rtl"] .step-arrow::after {
            right: auto;
            left: 0;
            border-left: 0;
            border-right: 5px solid var(--line);
        }
        html[dir="rtl"] .step-arrow.is-done::after { border-right-color: var(--brand); }
        /* Call stage */
        .call-stage {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 2px;
            padding: 10px 14px 4px;
            text-align: center;
        }
        .call-visual {
            position: relative;
            width: 100%;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0;
        }
        .signal-rings {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 96px;
            height: 96px;
            transform: translate(-50%, -50%);
            overflow: visible;
            pointer-events: none;
        }
        .signal-rings .orbit {
            fill: none;
            stroke: var(--brand);
            stroke-width: 1;
            transform-origin: 100px 100px;
        }
        .orbit-a { stroke-dasharray: 1 9; opacity: .55; animation: signalSpin 22s linear infinite; }
        .orbit-b { stroke-dasharray: 2 14; opacity: .28; animation: signalSpin 15s linear infinite reverse; }
        .orbit-c { stroke-dasharray: 1 6; opacity: .16; animation: signalSpin 10s linear infinite; }
        .signal-node {
            fill: var(--brand);
            opacity: .35;
            transform-origin: 100px 100px;
            animation: signalSpin 10s linear infinite;
        }
        [data-state="connecting"] .orbit-a,
        [data-state="ringing"] .orbit-a { animation-duration: 3.2s; opacity: .85; }
        [data-state="connecting"] .orbit-b,
        [data-state="ringing"] .orbit-b { animation-duration: 2.4s; opacity: .55; }
        [data-state="connecting"] .signal-node,
        [data-state="ringing"] .signal-node { animation-duration: 1.8s; opacity: 1; }
        .signal-bars {
            position: relative;
            z-index: 3;
            width: 100%;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0;
            padding: 0 18px;
            opacity: 0;
            transition: opacity .2s ease;
        }
        .signal-bars span {
            display: block;
            width: 3px;
            height: 9px;
            flex: 0 0 3px;
            border-radius: 2px;
            background: var(--brand);
            transform-origin: center;
            animation: signalBar 1.1s ease-in-out infinite;
        }
        .signal-bars span:nth-child(2) { animation-delay: .12s; }
        .signal-bars span:nth-child(3) { animation-delay: .24s; }
        .signal-bars span:nth-child(4) { animation-delay: .36s; }
        .signal-bars span:nth-child(5) { animation-delay: .48s; }
        [data-state="connecting"] .signal-bars,
        [data-state="ringing"] .signal-bars,
        [data-state="connected"] .signal-bars { opacity: 1; }
        .call-visual.is-live .signal-bars span { animation: none; }
        .timer {
            display: none;
            margin: 0;
            color: var(--text);
            font-family: 'JetBrains Mono', monospace;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: -.03em;
            font-variant-numeric: tabular-nums;
        }
        [data-state="connected"] .timer { display: block; }
        .state-title {
            margin: 2px 0 0;
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: 14px;
            line-height: 1.3;
            font-weight: 700;
        }
        .state-text {
            max-width: 300px;
            min-height: 14px;
            margin: 2px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
            font-weight: 400;
        }
        .state-text.error { color: #fca5a5; }
        /* Actions — sticky on mobile */
        .call-actions {
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding: 10px 14px 8px;
        }
        @media (max-width: 560px) {
            .call-actions {
                position: sticky;
                bottom: 0;
                z-index: 2;
                margin-top: 8px;
                padding: 12px 16px max(12px, env(safe-area-inset-bottom));
                background: linear-gradient(to top, var(--surface) 85%, transparent);
                border-top: 1px solid var(--line);
            }
        }
        .primary-action, .secondary-action, .control, .audio-unlock {
            font-family: 'Cairo', sans-serif;
            cursor: pointer;
        }
        /* Exact Sokrat .btn / .btn-primary geometry; only brand colors and label text vary. */
        .primary-action {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: .55rem .8rem;
            border: 1px solid var(--brand);
            border-radius: .65rem;
            background: var(--brand);
            color: var(--on-brand);
            font-family: 'Cairo', sans-serif;
            font-size: .72rem;
            font-weight: 800;
            cursor: pointer;
        }
        #guestCallBtn { font-size: 2.16rem; line-height: 1.1; }
        .primary-action:hover { filter: brightness(1.08); }
        .primary-action:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .secondary-action {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: .55rem .8rem;
            border: 1px solid var(--line);
            border-radius: .65rem;
            background: var(--surface-2);
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: .72rem;
            font-weight: 800;
            cursor: pointer;
        }
        .secondary-action:hover { filter: brightness(1.08); }
        .secondary-action:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        /* State visibility — CTA always SSR-visible via data-state */
        [data-state="idle"] #guestCallBtn { display: flex; }
        [data-state="connecting"] #guestCallBtn,
        [data-state="ringing"] #guestCallBtn,
        [data-state="connected"] #guestCallBtn { display: none; }
        [data-state="connecting"] #guestCancelBtn,
        [data-state="ringing"] #guestCancelBtn { display: flex; }
        [data-state="connected"] .connected-actions { display: flex; }

        /* In-call compact bar: full-width visualizer above the controls. */
        .hotline-shell[data-state="connected"] {
            width: 100%;
            padding: 0;
            position: sticky;
            top: 0;
            z-index: 40;
            background: var(--bg);
        }
        .hotline-shell[data-state="connected"] .call-panel {
            width: 100%;
            border: 0;
            border-radius: 0;
            display: grid;
            grid-template-columns: 1fr auto;
            grid-template-areas:
                "identity timer"
                "visual visual"
                "actions actions";
            gap: 4px 8px;
            padding: 8px 12px;
        }
        [data-state="connected"] .business-header {
            grid-area: identity;
            width: auto;
            max-width: none;
            margin: 0;
            min-width: 0;
            min-height: 0;
            padding: 0;
            border: 0;
            gap: 8px;
        }
        [data-state="connected"] .business-header .avatar-wrap {
            width: 30px;
            height: 30px;
            flex-basis: 30px;
            border-radius: 7px;
        }
        [data-state="connected"] .business-header .avatar-initial { font-size: 14px; }
        [data-state="connected"] .business-header .eyebrow { display: none; }
        [data-state="connected"] .business-header h1 {
            font-size: 12px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        [data-state="connected"] .progress-steps { display: none; }
        [data-state="connected"] .call-stage { display: contents; }
        [data-state="connected"] .call-visual {
            grid-area: visual;
            display: flex;
            width: 100%;
            height: 24px;
            margin: 0;
        }
        [data-state="connected"] .signal-rings { display: none; }
        [data-state="connected"] .signal-bars {
            width: 100%;
            height: 24px;
            padding: 0 2px;
            justify-content: space-between;
        }
        [data-state="connected"] .signal-bars span {
            width: 2px;
            height: 6px;
            flex: 0 0 2px;
        }
        [data-state="connected"] .state-text { display: none; }
        [data-state="connected"] .timer {
            grid-area: timer;
            display: block;
            align-self: center;
            justify-self: end;
            margin: 0;
            font-size: 14px;
            line-height: 1;
        }
        [data-state="connected"] .call-actions {
            grid-area: actions;
            display: flex;
            justify-content: center;
            width: 100%;
            max-width: none;
            margin: 0;
            padding: 0;
            gap: 0;
            position: static;
            background: transparent;
            border: 0;
        }
        [data-state="connected"] .connected-actions {
            display: flex;
            gap: 6px;
            padding: 0;
        }
        [data-state="connected"] .control,
        [data-state="connected"] .control.end {
            width: 38px;
            height: 38px;
            border-radius: .55rem;
        }
        [data-state="connected"] .control svg { width: 16px; height: 16px; }
        [data-state="connected"] .control-label { display: none; }

        /* Beat the full-bleed centering rules when the panel is a compact bar. */
        .hotline-shell.has-header-image[data-state="connected"] .call-panel > .call-stage,
        .hotline-shell.has-header-image[data-state="connected"] .call-panel > .call-actions {
            width: auto;
            max-width: none;
            margin: 0;
        }
        [data-state="ended"] #guestRetryBtn,
        [data-state="failed"] #guestRetryBtn,
        [data-state="no_answer"] #guestRetryBtn,
        [data-state="busy"] #guestRetryBtn,
        [data-state="mic_denied"] #guestRetryBtn { display: flex; }
        [data-state="ended"] .call-summary { display: block; }
        #guestCancelBtn, #guestRetryBtn { display: none; }
        .connected-actions { display: none; align-items: flex-start; justify-content: center; gap: 12px; padding: 4px 0 0; }
        .control-group { display: flex; flex-direction: column; align-items: center; gap: 4px; }
        .control,
        .control.end {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            padding: 0;
            border: 1px solid var(--line);
            border-radius: .65rem;
            background: var(--surface-2);
            color: var(--text);
            cursor: pointer;
            transition: filter .15s ease, border-color .15s ease, background .15s ease;
        }
        .control svg { width: 20px; height: 20px; }
        .control:hover,
        .control.end:hover { border-color: var(--brand); filter: brightness(1.08); }
        .control:active,
        .control.end:active { transform: scale(.96); }
        .control:focus-visible,
        .control.end:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .control.is-muted { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
        .control.end { background: var(--brand); border-color: var(--brand); color: var(--on-brand); }
        .control-label { color: var(--muted); font-size: .64rem; font-weight: 700; line-height: 1.2; max-width: 72px; text-align: center; }
        .audio-unlock {
            display: none;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: .55rem .8rem;
            border: 1px solid var(--line);
            border-radius: .65rem;
            background: var(--surface-2);
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: .72rem;
            font-weight: 800;
            cursor: pointer;
        }
        .audio-unlock:not(.hidden) { display: flex; }
        .audio-unlock:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .call-summary {
            display: none;
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
            text-align: center;
        }
        .consent {
            margin: 0;
            padding: 14px 20px 0;
            border-top: 1px solid var(--line);
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
            font-weight: 400;
        }
        .powered {
            margin: 0;
            padding: 10px 20px 18px;
            color: var(--muted);
            font-size: 10px;
            letter-spacing: .06em;
            text-transform: uppercase;
            text-align: center;
            opacity: .7;
        }
        .powered b { color: var(--muted); font-weight: 600; }
        /* Audio modal */
        .audio-modal-backdrop {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 16px;
            background: rgba(0, 0, 0, .6);
            backdrop-filter: blur(6px);
        }
        .audio-modal-backdrop.open { display: flex; }
        .audio-modal {
            width: min(380px, 100%);
            max-height: calc(100dvh - 32px);
            overflow-y: auto;
            padding: 20px;
            border: 1px solid var(--line);
            border-radius: 16px;
            background: var(--surface);
            color: var(--text);
            box-shadow: var(--shadow);
            text-align: start;
        }
        .audio-modal-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
        .audio-modal-head h2 { margin: 0; font-family: 'Cairo', sans-serif; font-size: 16px; font-weight: 700; }
        .audio-close {
            width: 44px;
            height: 44px;
            border: 1px solid var(--line);
            border-radius: .65rem;
            background: var(--surface-2);
            color: var(--muted);
            cursor: pointer;
            font-size: 14px;
        }
        .audio-close:hover { color: var(--text); border-color: var(--brand); }
        .audio-close:focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
        .audio-field { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; color: var(--muted); font-size: 11px; font-weight: 600; letter-spacing: .02em; text-transform: uppercase; }
        .audio-field select {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: var(--surface-2);
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: 13px;
            outline: none;
        }
        .audio-field select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
        .audio-field select:disabled { opacity: .55; }
        .audio-help { margin: 12px 0 0; color: var(--muted); font-size: 12px; line-height: 1.5; }
        /* Lab — only rendered server-side when previewMode */
        .lab-section { width: min(440px, 100%); margin: 10px auto 0; padding: 0 16px; }
        .preview-fields {
            border: 0;
            border-radius: 0;
            background: transparent;
            color: var(--text);
            box-shadow: none;
            overflow: hidden;
        }
        .preview-fields-body { padding: 10px 12px 12px; }
        .preview-field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
        .preview-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
        .preview-field.full { grid-column: 1 / -1; }
        .preview-field-label { display: flex; align-items: baseline; gap: 8px; color: var(--muted); font-size: 27px; line-height: 1.15; font-weight: 600; }
        .preview-field-label small { color: var(--brand); font-size: 24px; font-weight: 600; }
        .preview-input {
            width: 100%;
            padding: .6rem .75rem;
            border: 1px solid var(--line);
            border-radius: .7rem;
            background: var(--surface-2);
            color: var(--text);
            font-family: 'Cairo', sans-serif;
            font-size: .8rem;
            outline: none;
        }
        .preview-input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
        textarea.preview-input { min-height: 48px; resize: vertical; }
        .preview-check {
            display: flex;
            align-items: center;
            gap: .5rem;
            padding: .6rem .75rem;
            border: 1px solid var(--line);
            border-radius: .7rem;
            background: var(--surface-2);
            color: var(--text);
            font-size: .8rem;
        }
        .preview-check input { width: 12px; height: 12px; accent-color: var(--brand); }
        .hidden { display: none !important; }
        @keyframes sokrBlink { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
        @keyframes signalSpin { to { transform: rotate(360deg); } }
        @keyframes signalBar { 0%, 100% { transform: scaleY(.35); opacity: .45; } 50% { transform: scaleY(1.8); opacity: 1; } }
        @media (max-width: 560px) {
            .sokrat-bar { padding: 8px 10px 4px; }
            .audio-modal-backdrop { padding: 12px; }
            .audio-modal { padding: 16px; }
            .audio-field select { font-size: 16px; }
            .hotline-shell { padding: 0 8px max(10px, env(safe-area-inset-bottom)); }
            h1 { font-size: 17px; }
            .subtitle { font-size: 12px; }
            .progress-steps { gap: 10px; padding: 10px 12px 0; }
            .progress-step { font-size: 10px; }
            .call-stage { padding: 8px 10px 2px; gap: 2px; }
            .call-visual { width: 100%; height: 54px; }
            .signal-bars { height: 30px; gap: 3px; }
            .timer { font-size: 22px; }
            .state-title { font-size: 13px; }
            .state-text { font-size: 10px; }
            .business-header { padding: 10px 12px 8px; }
            .call-panel.has-header-image .business-header { min-height: 148px; padding: 12px; }
            .avatar-wrap { width: 48px; height: 48px; flex-basis: 48px; }
            .call-actions { padding: 10px 14px 8px; gap: 6px; }
            .lab-section { margin: 6px auto 0; padding: 0 8px; }
            .preview-fields-body { padding: 6px 8px 8px; }
            .preview-field-grid { grid-template-columns: 1fr; gap: 4px; }
            .preview-field.full { grid-column: auto; }
            .preview-input { min-height: 30px; padding: 5px 7px; font-size: 11px; }
            textarea.preview-input { min-height: 42px; }
            .preview-check { min-height: 30px; padding: 5px 7px; font-size: 10px; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
        }
    </style>
</head>
<body class="<%= previewMode ? 'preview-page' : '' %>">
    <header class="sokrat-bar">
        <div class="brand-mark">
            <img src="<%= logoTheme %>" alt="Sokrat VOIP">
            <span>Sokrat <b>VOIP</b></span>
        </div>
        <div class="bar-actions">
            <a id="guestLangSwitch" class="language-switch" href="?lang=<%= lang === 'ar' ? 'en' : 'ar' %>" hreflang="<%= lang === 'ar' ? 'en' : 'ar' %>" aria-label="<%= lang === 'ar' ? 'Switch to English' : 'التبديل إلى العربية' %>">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18"/><path d="M12 3a15 15 0 0 0 0 18"/></svg>
                <span class="language-label" lang="<%= lang === 'ar' ? 'en' : 'ar' %>"><%= lang === 'ar' ? 'English' : 'العربية' %></span>
            </a>
        </div>
    </header>

    <main class="hotline-shell<%= headerImage ? ' has-header-image' : '' %>" id="callCard" data-state="<%= autoStartEnabled ? 'connecting' : 'idle' %>" aria-live="polite">
        <section class="call-panel panel<%= headerImage ? ' has-header-image' : '' %>"<% if (headerImage) { %> style="--header-image:url('<%= headerImage %>')"<% } %>>
            <div class="business-header">
                <div class="avatar-wrap">
                    <% if (logoUrl) { %>
                        <img src="<%= logoUrl %>" alt="<%= tenant.name %>">
                    <% } else { %>
                        <span class="avatar-initial"><%= String(tenant.name || '?').trim().charAt(0).toUpperCase() %></span>
                    <% } %>
                </div>
                <div class="identity-copy">
                    <p class="eyebrow"><%= t.officialHotline %></p>
                    <h1><%= tenant.name %></h1>
                </div>
            </div>

            <div class="progress-steps" aria-hidden="true">
                <span class="progress-step is-active" data-progress="call">
                    <span class="step-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.33 1.78.62 2.63a2 2 0 0 1-.45 2.11L8 9.73a16 16 0 0 0 6.27 6.27l1.17-1.17a2 2 0 0 1 2.11-.45c.85.29 1.73.5 2.63.62A2 2 0 0 1 22 16.92Z"/></svg></span>
                    <span class="step-label"><%= t.stepCall %></span>
                </span>
                <span class="step-arrow" data-progress-arrow="1"></span>
                <span class="progress-step" data-progress="connect">
                    <span class="step-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span>
                    <span class="step-label"><%= t.stepConnect %></span>
                </span>
                <span class="step-arrow" data-progress-arrow="2"></span>
                <span class="progress-step" data-progress="talk">
                    <span class="step-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/><path d="M8 10h8"/><path d="M8 14h5"/></svg></span>
                    <span class="step-label"><%= t.stepTalk %></span>
                </span>
            </div>

            <div class="call-stage">
                <div class="call-visual" aria-hidden="true">
                    <svg class="signal-rings" viewBox="0 0 200 200">
                        <circle class="orbit orbit-a" cx="100" cy="100" r="86"/>
                        <circle class="orbit orbit-b" cx="100" cy="100" r="72"/>
                        <circle class="orbit orbit-c" cx="100" cy="100" r="58"/>
                        <circle class="signal-node" cx="100" cy="10" r="3"/>
                    </svg>
                    <span class="signal-bars"><% for (let i = 0; i < 24; i++) { %><span></span><% } %></span>
                </div>
                <div id="guestTimer" class="timer" aria-live="off">00:00</div>
                <p id="guestStateText" class="state-text"><%= autoStartEnabled ? t.preparing : t.tapToCall %></p>
            </div>

            <div class="call-actions">
                <button id="guestCallBtn" type="button" class="primary-action"><%= buttonText %></button>
                <button id="guestCancelBtn" type="button" class="secondary-action"><%= t.cancel %></button>
                <button id="guestRetryBtn" type="button" class="primary-action"><%= t.tryAgain %></button>
                <div id="guestInCallActions" class="connected-actions">
                    <div class="control-group">
                        <button id="guestMuteBtn" type="button" class="control" aria-label="<%= t.mute %>" aria-pressed="false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
                        </button>
                        <span id="guestMuteLabel" class="control-label"><%= t.mute %></span>
                    </div>
                    <div class="control-group">
                        <button id="guestInCallAudioBtn" type="button" class="control" aria-label="<%= t.audioSettings %>" aria-haspopup="dialog">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5Z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
                        </button>
                        <span class="control-label"><%= t.audioSettings %></span>
                    </div>
                    <div class="control-group">
                        <button id="guestEndBtn" type="button" class="control end" aria-label="<%= t.hangup %>">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v2a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h2a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 .17 3.4"/></svg>
                        </button>
                        <span class="control-label"><%= t.hangup %></span>
                    </div>
                </div>
                <button id="guestAudioBtn" type="button" class="audio-unlock hidden"><%= t.enableAudio %></button>
                <p id="guestCallSummary" class="call-summary" aria-live="polite"></p>
            </div>

        </section>
    </main>

    <div class="audio-modal-backdrop" id="guestAudioModal" aria-hidden="true">
        <div class="audio-modal" role="dialog" aria-modal="true" aria-labelledby="guestAudioModalTitle">
            <div class="audio-modal-head">
                <h2 id="guestAudioModalTitle"><%= t.audioSettings %></h2>
                <button type="button" class="audio-close" id="guestAudioCloseBtn" aria-label="<%= t.close %>">✕</button>
            </div>
            <label class="audio-field">
                <span><%= t.microphone %></span>
                <select id="guestAudioInput"><option value=""><%= t.defaultDevice %></option></select>
            </label>
            <label class="audio-field">
                <span><%= t.speaker %></span>
                <select id="guestAudioOutput"><option value=""><%= t.defaultDevice %></option></select>
            </label>
            <p class="audio-help" id="guestAudioSupport"></p>
        </div>
    </div>

<% if (previewMode) { %>
    <div id="guestLabMount"></div>
    <template id="guestLabTemplate">
        <section class="lab-section">
            <div class="preview-fields open">
                <div class="preview-fields-body">
                    <div class="preview-field-grid"></div>
                </div>
            </div>
        </section>
    </template>
<% } %>

    <div id="sokratGuestConfig"
         data-tenant="<%= tenant.public_id %>"
         data-link="<%= link.slug %>"
         data-lang="<%= lang %>"
         data-embedded="<%= isEmbedded ? '1' : '0' %>"
         data-autostart="<%= autoStartEnabled ? '1' : '0' %>"
         data-preview="<%= previewMode ? '1' : '0' %>"
         data-labels="<%= JSON.stringify({
            ready: t.ready, preparing: t.preparing, connecting: t.connecting, ringing: t.ringing,
            callPrompt: t.callPrompt,
            connected: t.connected, ended: t.ended, failed: t.failed, noAnswer: t.noAnswer,
            tryAgain: t.tryAgain, tapToCall: t.tapToCall, cancelled: t.cancelled,
            enableAudio: t.enableAudio, hangup: t.hangup, mute: t.mute, unmute: t.unmute,
            noAgents: t.noAgents, busy: t.busy, micDenied: t.micDenied,
            audioSettings: t.audioSettings, microphone: t.microphone, speaker: t.speaker,
            defaultDevice: t.defaultDevice, audioUnsupported: t.audioUnsupported,
            duration: t.duration, callAgainHint: t.callAgainHint
         }) %>"
         data-call-label="<%= buttonText %>"></div>

    <script src="/js/jssip.min.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
    <script src="/js/guest-call.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '1' %>"></script>
</body>
</html>

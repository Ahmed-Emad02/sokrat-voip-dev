        function pressSoftphoneKey(key) {
            const input = document.getElementById('softphoneDialInput');
            input.value += key;
            if (currentSession && currentSession.state === SIP.SessionState.Established) {
                try { currentSession.sendDTMF(key); } catch(e){}
            }
        }

        function clearSoftphoneDialInput() {
            const input = document.getElementById('softphoneDialInput');
            input.value = input.value.slice(0, -1);
        }

        async function loadWebRtcConfig() {
            try {
                const res = await fetch('/api/webrtc/config');
                const data = await res.json();
                if (!data.success || !data.extensions) return;

                const selectEl = document.getElementById('softphoneExtSelect');
                selectEl.innerHTML = '';
                if (data.extensions.length === 0) {
                    selectEl.innerHTML = '<option value="">No WebRTC Exts</option>';
                    return;
                }
                data.extensions.forEach(ext => {
                    const opt = document.createElement('option');
                    opt.value = ext.extension;
                    opt.dataset.secret = ext.secret;
                    opt.textContent = `${ext.extension} (${ext.name})`;
                    selectEl.appendChild(opt);
                });
                window.webrtcWsUrl = data.wsUrl;
            } catch (e) {
                console.error('Failed to load WebRTC config:', e);
            }
        }
        let ua = null;
        let currentSession = null;
        const remoteAudio = new Audio();
        remoteAudio.autoplay = true;

        function toggleSoftphonePanel() {
            const panel = document.getElementById('softphonePanel');
            panel.classList.toggle('hidden');
        }

        function pressSoftphoneKey(key) {
            const input = document.getElementById('softphoneDialInput');
            input.value += key;
            if (currentSession && currentSession.isInProgress && currentSession.isInProgress()) {
                try { currentSession.sendDTMF(key); } catch(e){}
            }
        }

        function clearSoftphoneDialInput() {
            const input = document.getElementById('softphoneDialInput');
            input.value = input.value.slice(0, -1);
        }

        async function loadWebRtcConfig() {
            try {
                const res = await fetch('/api/webrtc/config');
                const data = await res.json();
                if (!data.success || !data.extensions) return;

                const selectEl = document.getElementById('softphoneExtSelect');
                selectEl.innerHTML = '';
                if (data.extensions.length === 0) {
                    selectEl.innerHTML = '<option value="">No WebRTC Exts</option>';
                    return;
                }
                data.extensions.forEach(ext => {
                    const opt = document.createElement('option');
                    opt.value = ext.extension;
                    opt.dataset.secret = ext.secret;
                    opt.textContent = `${ext.extension} (${ext.name})`;
                    selectEl.appendChild(opt);
                });
                window.webrtcWsUrl = data.wsUrl;
            } catch (e) {
                console.error('Failed to load WebRTC config:', e);
            }
        }

        function updateSoftphoneStatus(text, state) {
            const statusEl = document.getElementById('softphoneStatusText');
            const dotEl = document.getElementById('softphoneStatusDot');
            const pingEl = document.getElementById('softphoneStatusPing');
            if (statusEl) statusEl.textContent = text;

            if (dotEl) {
                dotEl.className = 'relative inline-flex rounded-full h-3 w-3 ' + (
                    state === 'online' ? 'bg-emerald-500' :
                    state === 'incall' ? 'bg-purple-500' :
                    state === 'ringing' ? 'bg-amber-500' : 'bg-zinc-500'
                );
            }
            if (pingEl) {
                if (state === 'online' || state === 'incall' || state === 'ringing') pingEl.classList.remove('hidden');
                else pingEl.classList.add('hidden');
            }
        }

        function toggleSoftphoneRegister() {
            if (ua && ua.isConnected()) {
                ua.stop();
                ua = null;
                document.getElementById('softphoneRegBtn').textContent = '<%= isRtl ? "اتصال" : "Connect" %>';
                updateSoftphoneStatus('<%= isRtl ? "غير متصل" : "Offline" %>', 'offline');
                return;
            }

            const selectEl = document.getElementById('softphoneExtSelect');
            if (!selectEl || !selectEl.value) {
                alert('Please select an extension first');
                return;
            }

            const ext = selectEl.value;
            const selectedOpt = selectEl.options[selectEl.selectedIndex];
            const secret = selectedOpt ? selectedOpt.dataset.secret : '';
            const wsUrl = window.webrtcWsUrl || ((location.protocol === 'https:' ? 'wss://' : 'ws://') + location.hostname + ':5066');

            if (typeof JsSIP === 'undefined') {
                alert('JsSIP library not loaded');
                return;
            }

            try {
                const socket = new JsSIP.WebSocketInterface(wsUrl);
                const configuration = {
                    sockets: [socket],
                    uri: `sip:${ext}@${location.hostname}`,
                    password: secret,
                    register: true
                };

                ua = new JsSIP.UA(configuration);

                ua.on('connecting', () => {
                    updateSoftphoneStatus('Connecting...', 'registering');
                });

                ua.on('connected', () => {
                    updateSoftphoneStatus(`Online (${ext})`, 'online');
                    document.getElementById('softphoneRegBtn').textContent = '<%= isRtl ? "قطع الاتصال" : "Disconnect" %>';
                });

                ua.on('disconnected', () => {
                    updateSoftphoneStatus('Offline', 'offline');
                    document.getElementById('softphoneRegBtn').textContent = '<%= isRtl ? "اتصال" : "Connect" %>';
                });

                ua.on('registrationFailed', (data) => {
                    console.error('Registration failed:', data.cause);
                    updateSoftphoneStatus('Reg Failed', 'offline');
                });

                ua.on('newRTCSession', (data) => {
                    currentSession = data.session;
                    setupSessionListeners(currentSession);

                    if (currentSession.direction === 'incoming') {
                        updateSoftphoneStatus('Ringing...', 'ringing');
                        document.getElementById('softphoneAnswerBtn').classList.remove('hidden');
                        document.getElementById('softphoneHangupBtn').classList.remove('hidden');
                        document.getElementById('softphoneCallBtn').classList.add('hidden');
                    }
                });

                ua.start();
            } catch (err) {
                console.error('JsSIP initialization error:', err);
                updateSoftphoneStatus('Error', 'offline');
            }
        }

        function makeSoftphoneCall() {
            if (!ua || !ua.isConnected()) {
                alert('Please connect softphone first!');
                return;
            }
            const target = document.getElementById('softphoneDialInput').value.trim();
            if (!target) return;

            const eventHandlers = {
                'progress': () => updateSoftphoneStatus(`Ringing ${target}...`, 'incall'),
                'failed': (e) => {
                    console.error('Call failed:', e.cause);
                    updateSoftphoneStatus('Online', 'online');
                    resetCallUI();
                },
                'ended': () => {
                    updateSoftphoneStatus('Online', 'online');
                    resetCallUI();
                },
                'confirmed': () => updateSoftphoneStatus('In Call', 'incall')
            };

            const options = {
                eventHandlers: eventHandlers,
                mediaConstraints: { audio: true, video: false }
            };

            currentSession = ua.call(`sip:${target}@${location.hostname}`, options);
            document.getElementById('softphoneHangupBtn').classList.remove('hidden');
            document.getElementById('softphoneCallBtn').classList.add('hidden');
        }

        function setupSessionListeners(session) {
            session.on('peerconnection', (e) => {
                const pc = e.peerconnection;
                pc.ontrack = (event) => {
                    if (event.streams && event.streams[0]) {
                        remoteAudio.srcObject = event.streams[0];
                        remoteAudio.play();
                    }
                };
            });

            session.on('ended', () => {
                updateSoftphoneStatus('Online', 'online');
                resetCallUI();
            });

            session.on('failed', () => {
                updateSoftphoneStatus('Online', 'online');
                resetCallUI();
            });
        }

        function resetCallUI() {
            currentSession = null;
            document.getElementById('softphoneAnswerBtn').classList.add('hidden');
            document.getElementById('softphoneHangupBtn').classList.add('hidden');
            document.getElementById('softphoneCallBtn').classList.remove('hidden');
        }

        function answerSoftphoneCall() {
            if (currentSession) {
                currentSession.answer({
                    mediaConstraints: { audio: true, video: false }
                });
                document.getElementById('softphoneAnswerBtn').classList.add('hidden');
            }
        }

        function hangupSoftphoneCall() {
            if (currentSession) {
                currentSession.terminate();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadWebRtcConfig();
        });
    </script>
</body>
</html>

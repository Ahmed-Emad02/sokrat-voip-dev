<%
const words = {
    en: {
        title: "Overview", subtitle: "",
        desc: "Real-time call center performance overview",
        startTime: "Start Time", endTime: "End Time",
        roster: "Extension Roster", allExt: "All Extensions",
        status: "Call Status", allDisp: "All Dispositions",
        direction: "Direction", allDir: "All Directions", dirIn: "Inbound", dirOut: "Outbound", dirInternal: "Internal",
        scope: "Call Scope", allScope: "All Scopes", scopeInternal: "Internal Only", scopeExternal: "External Only", scopeFailover: "Failover Only",
        src: "Source", dst: "Destination", did: "DID Number", uid: "Unique ID",
        moreFilters: "More Filters", lessFilters: "Fewer Filters",
        reset: "Reset Filters",
        btn: "Refresh Metrics",
        totalCalls: "Total Calls", answeredCalls: "Answered",
        inbound: "Inbound", outbound: "Outbound",
        answerRate: "Answer Rate", airMinutes: "air minutes", internalCalls: "Internal Calls", externalCalls: "External Calls", chartScope: "Call Scope (Internal vs External)",
        min: "min", sec: "s",
        noAnswer: "No Answer / Missed", busy: "Busy Calls",
        failed: "Failed / Congestion", totalAirtime: "Total Talk Time",
        avgDuration: "Avg Call Duration",
        chartTrend: "Call Volume Trend",
        chartDisposition: "Call Disposition",
        chartHourly: "Hourly Call Distribution",
        chartTopTalkers: "Top Talkers",
        talkTime: "Talk Time",
        calls: "calls",
        saving: "Saving contact...",
        saved: "Contact saved successfully!",
        addedToast: "Contact added to address book",
        failedSave: "Failed to save contact",
        errorSave: "Error: Failed to save contact",
        uploadingCsv: "Uploading and processing CSV...",
        imported: "Contacts imported successfully!",
        importedToast: "Contacts imported successfully",
        failedImport: "Failed to import CSV",
        errorImport: "Error: Failed to import CSV"
    },
    ar: {
        title: "نظرة عامة", subtitle: "",
        desc: "نظرة عامة على أداء مركز الاتصال في الوقت الفعلي",
        startTime: "وقت البداية", endTime: "وقت النهاية",
        roster: "قائمة الموظفين", allExt: "جميع التحويلات",
        status: "حالة المكالمة", allDisp: "جميع الحالات",
        direction: "الاتجاه", allDir: "كل الاتجاهات", dirIn: "وارد", dirOut: "صادر", dirInternal: "داخلي",
        scope: "نطاق المكالمة", allScope: "جميع النطاقات", scopeInternal: "داخلي فقط", scopeExternal: "خارجي فقط", scopeFailover: "تحويل خارجي فقط",
        src: "المصدر", dst: "الوجهة", did: "رقم DID", uid: "المعرف الفريد",
        moreFilters: "المزيد من الفلاتر", lessFilters: "إخفاء الفلاتر",
        reset: "إعادة ضبط",
        btn: "تحديث مؤشرات الأداء",
        totalCalls: "إجمالي المكالمات", answeredCalls: "تم الرد",
        inbound: "وارد", outbound: "صادر",
        answerRate: "نسبة الرد", airMinutes: "دقيقة اتصال", internalCalls: "المكالمات الداخلية", externalCalls: "المكالمات الخارجية", chartScope: "تصنيف نطاق المكالمات (داخلي / خارجي)",
        min: "د", sec: "ث",
        noAnswer: "لم يتم الرد / فائتة", busy: "مشغول",
        failed: "فاشلة / ازدحام", totalAirtime: "إجمالي زمن المحادثات",
        avgDuration: "متوسط مدة المكالمة",
        chartTrend: "اتجاه حجم المكالمات",
        chartDisposition: "تصنيف المكالمات",
        chartHourly: "توزيع المكالمات بالساعة",
        chartTopTalkers: "أكثر المكلمين",
        talkTime: "وقت المحادثة",
        calls: "مكالمات",
        saving: "جارٍ حفظ جهة الاتصال...",
        saved: "تم حفظ جهة الاتصال بنجاح!",
        addedToast: "تمت إضافة جهة الاتصال إلى دفتر العناوين",
        failedSave: "فشل في حفظ جهة الاتصال",
        errorSave: "خطأ: فشل في حفظ جهة الاتصال",
        uploadingCsv: "جارٍ رفع ومعالجة ملف CSV...",
        imported: "تم استيراد جهات الاتصال بنجاح!",
        importedToast: "تم استيراد جهات الاتصال بنجاح",
        failedImport: "فشل في استيراد CSV",
        errorImport: "خطأ: فشل في استيراد CSV"
    }
};
const t = words[currentLang];
const isRtl = currentLang === 'ar';
%>
<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <!-- Prevent theme flickering -->
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
            }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - Dashboard</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="/js/jssip.min.js"></script>
    <style>
        /* Enforce typography across all elements including Tailwind v4 resets */
        html[dir="rtl"], html[dir="rtl"] body, html[dir="rtl"] * {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }
        html:not([dir="rtl"]), html:not([dir="rtl"]) body {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }
        .font-mono, html[dir="rtl"] .font-mono,
        .card-stat-val, html[dir="rtl"] .card-stat-val,
        .card-stat-number, html[dir="rtl"] .card-stat-number,
        html[dir="rtl"] code, html[dir="rtl"] pre, html[dir="rtl"] input[type="time"], html[dir="rtl"] input[type="datetime-local"] {
            font-family: 'JetBrains Mono', monospace !important;
            font-variant-numeric: tabular-nums;
        }
        .card-stat-val .font-sans, html[dir="rtl"] .card-stat-val .font-sans {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #121212;
            --bg-card: #18181b;
            --bg-hover: #27272a;
            --border-primary: #27272a;
            --border-accent: #3f3f46;
            --text-primary: #ffffff;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --accent-color: var(--accent-color);
            --accent-hover: var(--accent-hover);
            --status-online: var(--accent-color);
            --status-offline: #71717a;
            --status-active: var(--accent-color);
        }
        body { 
            background-color: var(--bg-primary); 
            color: var(--text-primary); 
        }
        /* Modern background pattern with subtle gradients */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 10% 20%, rgba(255, 59, 48, 0.06) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(255, 255, 255, 0.02) 0%, transparent 45%);
            pointer-events: none;
            z-index: -1;
        }
        .panel-surface { 
            background-color: var(--bg-secondary); 
            border: 1px solid var(--border-primary); 
        }
        .accent-orange { color: var(--accent-color); }
        .font-vibrant-display { font-weight: 900; letter-spacing: -0.01em; }
        .card-stat { 
            transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1), 
                        border-color 150ms cubic-bezier(0.4, 0, 0.2, 1); 
        }
        .card-stat:hover { 
            transform: translateY(-2px); 
            border-color: var(--border-accent); 
        }
        input, select, button { 
            transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1); 
        }
        /* Unified Filter Typography */
        #dashFilterForm label,
        #dashFilterForm select,
        #dashFilterForm button,
        #dashStatusChecklistBtn,
        #dashExtChecklistBtn,
        .filter-action-btn {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }
        #dashFilterForm input[type="text"],
        #dashFilterForm input[type="datetime-local"],
        #dashFilterForm .font-mono,
        .flatpickr-input {
            font-family: 'JetBrains Mono', monospace !important;
        }
        .filter-action-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            padding: 0.35rem 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            background-color: var(--bg-primary);
            color: var(--text-secondary);
            border: 1px solid var(--border-primary);
            transition: all 150ms cubic-bezier(0.4, 0, 0.2, 1);
            white-space: nowrap;
            cursor: pointer;
            user-select: none;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            text-decoration: none;
        }
        .filter-action-btn:hover {
            background-color: var(--bg-hover);
            color: #ffffff;
            border-color: var(--border-accent);
        }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <div class="flex-1 p-5 md:p-6 relative flex flex-col min-h-screen">

        <div class="mb-3 shrink-0 flex items-center <%= isRtl ? 'justify-start text-right' : 'justify-between' %>">
            <div class="<%= isRtl ? 'text-right w-full' : '' %>">
                <h2 class="text-3xl font-vibrant-display text-white tracking-tight <%= isRtl ? 'text-right' : '' %>"><%= t.title %> <span class="accent-orange"><%= t.subtitle %></span></h2>
            </div>
        </div>

        <!-- Compact Balanced Filter Form -->
        <form id="dashFilterForm" action="/" method="GET" class="panel-surface p-3 px-3.5 rounded-xl mb-4 flex flex-col gap-2.5 relative z-30">
            <input type="hidden" name="lang" value="<%= currentLang %>">
            
            <!-- Row 1: Primary Filters (5-column responsive grid) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2.5">
                <div>
                    <label class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider" for="dashStartDate"><%= t.startTime %></label>
                    <input type="datetime-local" id="dashStartDate" name="startDate" value="<%= moment(filters.startDate).format('YYYY-MM-DDTHH:mm') %>" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                </div>
                <div>
                    <label for="dashEndDate" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.endTime %></label>
                    <input type="datetime-local" id="dashEndDate" name="endDate" value="<%= moment(filters.endDate).format('YYYY-MM-DDTHH:mm') %>" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                </div>
                <div class="relative">
                    <label for="dashTargetExtensionSelect" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.roster %></label>
                    <select name="targetExtension" id="dashTargetExtensionSelect" multiple class="hidden no-enhance">
                        <% 
                          let rosterList = (typeof roster !== 'undefined' && Array.isArray(roster)) ? roster : [];
                          let scopedExts = null;
                          if (typeof userExtensions !== 'undefined' && Array.isArray(userExtensions) && userExtensions.length > 0) {
                              scopedExts = userExtensions;
                          } else if (typeof userExtension !== 'undefined' && userExtension) {
                              scopedExts = String(userExtension).split(',').map(e => e.trim()).filter(Boolean);
                          }
                          const isScopedUser = Boolean(scopedExts && scopedExts.length > 0 && (typeof isSuperAdmin !== 'undefined' && !isSuperAdmin));
                          if (isScopedUser) {
                              rosterList = rosterList.filter(emp => scopedExts.includes(emp.extension));
                          }
                          let selectedExts = Array.isArray(filters.targetExtension) ? filters.targetExtension : (filters.targetExtension && filters.targetExtension !== 'ALL' ? [filters.targetExtension] : ['ALL']);
                          if (isScopedUser) {
                              if (selectedExts.includes('ALL') || selectedExts.length === 0) {
                                  selectedExts = scopedExts;
                              } else {
                                  selectedExts = selectedExts.filter(e => scopedExts.includes(e));
                                  if (selectedExts.length === 0) selectedExts = scopedExts;
                              }
                          }
                          let isAllExt = !isScopedUser && (selectedExts.includes('ALL') || selectedExts.length === 0);
                        %>
                        <% if (!isScopedUser) { %>
                            <option value="ALL" <%= isAllExt ? 'selected' : '' %>><%= t.allExt %></option>
                        <% } %>
                        <% rosterList.forEach(emp => { 
                            let isSel = isScopedUser || (!isAllExt && selectedExts.includes(emp.extension));
                        %>
                            <option value="<%= emp.extension %>" <%= isSel ? 'selected' : '' %>><%= emp.extension %> - <%= emp.name %></option>
                        <% }) %>
                    </select>

                    <button type="button" id="dashExtChecklistBtn" onclick="toggleChecklistMenu('dashExtChecklistMenu', event)" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] flex items-center justify-between gap-2 cursor-pointer text-start">
                        <span id="dashExtChecklistLabel" class="truncate font-semibold"><%= isScopedUser ? (selectedExts.length === 1 ? (rosterList.find(e => e.extension === selectedExts[0]) ? (selectedExts[0] + ' - ' + rosterList.find(e => e.extension === selectedExts[0]).name) : selectedExts[0]) : (selectedExts.length === rosterList.length ? (rosterList[0] ? (rosterList[0].extension + ' - ' + rosterList[0].name) : selectedExts.join(', ')) : (selectedExts.length + ' ' + (isRtl ? 'تحويلات محددة' : 'Extensions')))) : t.allExt %></span>
                        <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <div id="dashExtChecklistMenu" class="checklist-menu hidden absolute left-0 right-0 top-full mt-1 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl p-2 z-[9999] max-h-56 overflow-y-auto space-y-1" style="scrollbar-width:thin">
                        <% if (!isScopedUser) { %>
                            <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_ext_chk_all">
                                <input type="checkbox" id="dash_ext_chk_all" name="dash_ext_chk_all" value="ALL" <%= isAllExt ? 'checked' : '' %> onchange="onExtChecklistChange(this)" class="dash-ext-chk rounded accent-[var(--accent-color)] cursor-pointer">
                                <span class="font-bold text-[var(--text-primary)]"><%= t.allExt %></span>
                            </label>
                        <% } %>
                        <% rosterList.forEach(emp => { 
                            let isSel = isScopedUser || (!isAllExt && selectedExts.includes(emp.extension));
                        %>
                            <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_ext_chk_<%= emp.extension %>">
                                <input type="checkbox" id="dash_ext_chk_<%= emp.extension %>" name="dash_ext_chk" value="<%= emp.extension %>" <%= isSel ? 'checked' : '' %> onchange="onExtChecklistChange(this)" class="dash-ext-chk rounded accent-[var(--accent-color)] cursor-pointer">
                                <span class="text-zinc-300 font-mono"><%= emp.extension %></span>
                                <span class="text-zinc-400 truncate"><%= emp.name %></span>
                            </label>
                        <% }) %>
                    </div>
                </div>
                <div class="relative">
                    <label for="dashStatusFilterSelect" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.status %></label>
                    <select name="statusFilter" id="dashStatusFilterSelect" multiple class="hidden no-enhance">
                        <% 
                          let selectedSt = Array.isArray(filters.statusFilter) ? filters.statusFilter : (filters.statusFilter && filters.statusFilter !== 'ALL' ? [filters.statusFilter] : ['ALL']);
                          let isAllSt = selectedSt.includes('ALL') || selectedSt.length === 0;
                        %>
                        <option value="ALL" <%= isAllSt ? 'selected' : '' %>><%= t.allDisp %></option>
                        <option value="ANSWERED" <%= (!isAllSt && selectedSt.includes('ANSWERED')) ? 'selected' : '' %>>ANSWERED</option>
                        <option value="NO ANSWER" <%= (!isAllSt && selectedSt.includes('NO ANSWER')) ? 'selected' : '' %>>NO ANSWER</option>
                        <option value="BUSY" <%= (!isAllSt && selectedSt.includes('BUSY')) ? 'selected' : '' %>>BUSY</option>
                        <option value="FAILED" <%= (!isAllSt && selectedSt.includes('FAILED')) ? 'selected' : '' %>>FAILED</option>
                    </select>

                    <button type="button" id="dashStatusChecklistBtn" onclick="toggleChecklistMenu('dashStatusChecklistMenu', event)" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] flex items-center justify-between gap-2 cursor-pointer text-start">
                        <span id="dashStatusChecklistLabel" class="truncate font-semibold"><%= t.allDisp %></span>
                        <svg class="w-3.5 h-3.5 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                    </button>

                    <div id="dashStatusChecklistMenu" class="checklist-menu hidden absolute left-0 right-0 top-full mt-1 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl p-2 z-[9999] max-h-56 overflow-y-auto space-y-1" style="scrollbar-width:thin">
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_status_chk_all">
                            <input type="checkbox" id="dash_status_chk_all" name="dash_status_chk_all" value="ALL" <%= isAllSt ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="dash-status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-bold text-[var(--text-primary)]"><%= t.allDisp %></span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_status_chk_ans">
                            <input type="checkbox" id="dash_status_chk_ans" name="dash_status_chk" value="ANSWERED" <%= (!isAllSt && selectedSt.includes('ANSWERED')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="dash-status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-emerald-400 font-bold">ANSWERED</span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_status_chk_noans">
                            <input type="checkbox" id="dash_status_chk_noans" name="dash_status_chk" value="NO ANSWER" <%= (!isAllSt && selectedSt.includes('NO ANSWER')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="dash-status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-teal-400 font-bold">NO ANSWER</span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_status_chk_busy">
                            <input type="checkbox" id="dash_status_chk_busy" name="dash_status_chk" value="BUSY" <%= (!isAllSt && selectedSt.includes('BUSY')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="dash-status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-amber-400 font-bold">BUSY</span>
                        </label>
                        <label class="flex items-center gap-2 px-2 py-1.5 rounded-lg hover:bg-[var(--bg-hover)] cursor-pointer text-xs select-none" for="dash_status_chk_failed">
                            <input type="checkbox" id="dash_status_chk_failed" name="dash_status_chk" value="FAILED" <%= (!isAllSt && selectedSt.includes('FAILED')) ? 'checked' : '' %> onchange="onStatusChecklistChange(this)" class="dash-status-chk rounded accent-[var(--accent-color)] cursor-pointer">
                            <span class="font-mono text-purple-400 font-bold">FAILED</span>
                        </label>
                    </div>
                </div>
                <div>
                    <label for="dashScopeFilter" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.scope %></label>
                    <select id="dashScopeFilter" name="callScopeFilter" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                        <option value="ALL" <%= (filters.callScopeFilter || 'ALL') === 'ALL' ? 'selected' : '' %>><%= t.allScope %></option>
                        <option value="INTERNAL" <%= filters.callScopeFilter === 'INTERNAL' ? 'selected' : '' %>><%= t.scopeInternal %></option>
                        <option value="EXTERNAL" <%= filters.callScopeFilter === 'EXTERNAL' ? 'selected' : '' %>><%= t.scopeExternal %></option>
                        <option value="FAILOVER" <%= filters.callScopeFilter === 'FAILOVER' ? 'selected' : '' %>><%= t.scopeFailover %></option>
                    </select>
                </div>
            </div>

            <!-- Row 2: Secondary / Advanced Filters (Collapsible Drawer) -->
            <% 
                let hasActiveSecondary = (filters.directionFilter && filters.directionFilter !== 'ALL') ||
                                         (filters.searchSrc && filters.searchSrc.trim() !== '') ||
                                         (filters.searchDst && filters.searchDst.trim() !== '') ||
                                         (filters.searchDid && filters.searchDid.trim() !== '') ||
                                         (filters.searchUniqueId && filters.searchUniqueId.trim() !== '');
                let activeSecondaryCount = 0;
                if (filters.directionFilter && filters.directionFilter !== 'ALL') activeSecondaryCount++;
                if (filters.searchSrc && filters.searchSrc.trim() !== '') activeSecondaryCount++;
                if (filters.searchDst && filters.searchDst.trim() !== '') activeSecondaryCount++;
                if (filters.searchDid && filters.searchDid.trim() !== '') activeSecondaryCount++;
                if (filters.searchUniqueId && filters.searchUniqueId.trim() !== '') activeSecondaryCount++;
            %>
            <div id="dashSecondaryFilters" class="<%= hasActiveSecondary ? '' : 'hidden' %> border-t border-[var(--border-primary)]/40 pt-2.5">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-2.5">
                    <div>
                        <label for="dashDirectionFilter" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.direction %></label>
                        <select id="dashDirectionFilter" name="directionFilter" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)]">
                            <option value="ALL" <%= filters.directionFilter === 'ALL' ? 'selected' : '' %>><%= t.allDir %></option>
                            <option value="OUTBOUND" <%= filters.directionFilter === 'OUTBOUND' ? 'selected' : '' %>><%= t.dirOut %></option>
                            <option value="INBOUND" <%= filters.directionFilter === 'INBOUND' ? 'selected' : '' %>><%= t.dirIn %></option>
                            <option value="INTERNAL" <%= filters.directionFilter === 'INTERNAL' ? 'selected' : '' %>><%= t.dirInternal %></option>
                        </select>
                    </div>
                    <div>
                        <label for="dashSearchSrc" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.src %></label>
                        <input type="text" id="dashSearchSrc" name="searchSrc" value="<%= filters.searchSrc || '' %>" placeholder="e.g., 101" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                    </div>
                    <div>
                        <label for="dashSearchDst" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.dst %></label>
                        <input type="text" id="dashSearchDst" name="searchDst" value="<%= filters.searchDst || '' %>" placeholder="e.g., 010..." class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                    </div>
                    <div>
                        <label for="dashSearchDid" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.did %></label>
                        <input type="text" id="dashSearchDid" name="searchDid" value="<%= filters.searchDid || '' %>" placeholder="e.g., 01234567" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                    </div>
                    <div>
                        <label for="dashSearchUid" class="block text-[11px] font-bold uppercase text-[var(--text-secondary)] mb-1 tracking-wider"><%= t.uid %></label>
                        <input type="text" id="dashSearchUid" name="searchUniqueId" value="<%= filters.searchUniqueId || '' %>" placeholder="e.g., 1234567890" class="w-full bg-[var(--bg-primary)] border border-[var(--border-primary)] rounded-lg px-2.5 py-1.5 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[var(--accent-color)]">
                    </div>
                </div>
            </div>

            <!-- Bottom Action Bar -->
            <div class="flex items-center justify-between gap-3 pt-1.5 border-t border-[var(--border-primary)]/50">
                <div class="flex items-center gap-2">
                    <a href="/?lang=<%= currentLang %>" class="filter-action-btn" title="<%= t.reset %>">
                        <svg class="w-3.5 h-3.5 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                        </svg>
                        <span><%= t.reset %></span>
                    </a>
                    <button type="button" id="dashToggleMoreBtn" onclick="toggleDashboardMoreFilters()" class="filter-action-btn" title="<%= hasActiveSecondary ? t.lessFilters : t.moreFilters %>">
                        <svg id="dashToggleMoreFilterIcon" class="w-3.5 h-3.5 shrink-0 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                        </svg>
                        <span id="dashToggleMoreLabel"><%= hasActiveSecondary ? t.lessFilters : t.moreFilters %></span>
                        <svg id="dashToggleMoreIcon" class="w-3.5 h-3.5 transition-transform duration-200 <%= hasActiveSecondary ? 'rotate-180' : '' %>" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        <% if (activeSecondaryCount > 0) { %>
                            <span class="inline-flex items-center px-1.5 py-0.2 text-[10px] font-bold rounded-full bg-[var(--accent-color)]/20 text-[var(--accent-color)] border border-[var(--accent-color)]/30 ms-0.5">
                                <%= activeSecondaryCount %> <%= isRtl ? 'نشط' : 'Active' %>
                            </span>
                        <% } %>
                    </button>
                </div>
                <button type="submit" class="btn-primary px-5 py-1 text-xs uppercase tracking-wider"><%= t.btn %></button>
            </div>
        </form>

        <%
            const formattedStart = encodeURIComponent(moment(filters.startDate).format('YYYY-MM-DDTHH:mm'));
            const formattedEnd = encodeURIComponent(moment(filters.endDate).format('YYYY-MM-DDTHH:mm'));
            let baseUrl = '/cdr?startDate=' + formattedStart + '&endDate=' + formattedEnd + '&lang=' + currentLang;
            if (filters.searchSrc) baseUrl += '&searchSrc=' + encodeURIComponent(filters.searchSrc);
            if (filters.searchDst) baseUrl += '&searchDst=' + encodeURIComponent(filters.searchDst);
            if (filters.searchDid) baseUrl += '&searchDid=' + encodeURIComponent(filters.searchDid);
            if (filters.searchUniqueId) baseUrl += '&searchUniqueId=' + encodeURIComponent(filters.searchUniqueId);
            if (filters.targetExtension && filters.targetExtension !== 'ALL') {
                if (Array.isArray(filters.targetExtension)) {
                    filters.targetExtension.forEach(ext => {
                        if (ext !== 'ALL') baseUrl += '&targetExtension=' + encodeURIComponent(ext);
                    });
                } else {
                    baseUrl += '&targetExtension=' + encodeURIComponent(filters.targetExtension);
                }
            }
        %>
        <%
            const avgSec = stats.avgTalkSec || 0;
            const avgFormatted = avgSec >= 60 
                ? `${Math.floor(avgSec / 60)} ${t.min} ${avgSec % 60} ${t.sec}` 
                : `${avgSec} ${t.sec}`;
            const ansPercent = stats.totalCalls ? Math.round((stats.answeredCalls / stats.totalCalls) * 100) : 0;
        %>

        <!-- Section 1: Hero KPI Cards (4 prominent cards) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6 shrink-0">
            <!-- Hero Card 1: Total Calls -->
            <a href="<%= baseUrl %>&statusFilter=ALL&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض إجمالي المكالمات في سجل الاتصالات' : 'View total calls in Call History' %>"
               class="panel-surface rounded-2xl p-5 card-stat border border-[#27272a]/30 hover:border-[var(--accent-color)] transition-all duration-200 cursor-pointer group relative flex flex-col justify-between overflow-hidden">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <span class="p-2.5 rounded-xl bg-[var(--accent-color)]/10 text-[var(--accent-color)] border border-[var(--accent-color)]/20 shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[11px] font-bold uppercase text-zinc-400 tracking-wider"><%= t.totalCalls %></p>
                            <p class="text-xs text-zinc-500 font-mono mt-0.5"><%= isRtl ? 'إجمالي الحركة' : 'Total volume' %></p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-zinc-600 group-hover:text-[var(--accent-color)] transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M10 19l-7-7m0 0l7-7m-7 7h18' : 'M14 5l7 7m0 0l-7 7m7-7H3' %>"/>
                    </svg>
                </div>
                <div class="mt-4">
                    <p class="text-3xl sm:text-4xl font-black text-white card-stat-val tracking-tight"><%= stats.totalCalls %></p>
                    <div class="mt-3 h-1.5 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-[var(--accent-color)] rounded-full transition-all duration-500" style="width: 100%"></div>
                    </div>
                </div>
            </a>

            <!-- Hero Card 2: Answer Rate -->
            <a href="<%= baseUrl %>&statusFilter=ANSWERED&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات المجابة في سجل الاتصالات' : 'View answered calls in Call History' %>"
               class="panel-surface rounded-2xl p-5 card-stat border border-[#27272a]/30 hover:border-emerald-500 transition-all duration-200 cursor-pointer group relative flex flex-col justify-between overflow-hidden">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[11px] font-bold uppercase text-zinc-400 tracking-wider"><%= t.answerRate %></p>
                            <p class="text-xs text-emerald-400/80 font-mono mt-0.5"><span class="card-stat-val"><%= stats.answeredCalls %></span> / <span class="card-stat-val"><%= stats.totalCalls %></span> <%= isRtl ? 'مجابة' : 'answered' %></p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-zinc-600 group-hover:text-emerald-400 transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M10 19l-7-7m0 0l7-7m-7 7h18' : 'M14 5l7 7m0 0l-7 7m7-7H3' %>"/>
                    </svg>
                </div>
                <div class="mt-4">
                    <p class="text-3xl sm:text-4xl font-black text-white card-stat-val tracking-tight"><%= ansPercent %>%</p>
                    <div class="mt-3 h-1.5 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: <%= ansPercent %>%"></div>
                    </div>
                </div>
            </a>

            <!-- Hero Card 3: Answered Calls -->
            <a href="<%= baseUrl %>&statusFilter=ANSWERED&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات التي تم الرد عليها في سجل الاتصالات' : 'View answered calls in Call History' %>"
               class="panel-surface rounded-2xl p-5 card-stat border border-[#27272a]/30 hover:border-emerald-500 transition-all duration-200 cursor-pointer group relative flex flex-col justify-between overflow-hidden">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[11px] font-bold uppercase text-zinc-400 tracking-wider"><%= t.answeredCalls %></p>
                            <p class="text-xs text-emerald-400/80 font-mono mt-0.5"><span class="card-stat-val"><%= stats.totalCalls ? Math.round((stats.answeredCalls / stats.totalCalls) * 100) : 0 %>%</span> <%= isRtl ? 'نسبة الرد' : 'completion' %></p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-zinc-600 group-hover:text-emerald-400 transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M10 19l-7-7m0 0l7-7m-7 7h18' : 'M14 5l7 7m0 0l-7 7m7-7H3' %>"/>
                    </svg>
                </div>
                <div class="mt-4">
                    <p class="text-3xl sm:text-4xl font-black text-white card-stat-val tracking-tight"><%= stats.answeredCalls %></p>
                    <div class="mt-3 h-1.5 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-emerald-500 rounded-full transition-all duration-500" style="width: <%= stats.totalCalls ? (stats.answeredCalls / stats.totalCalls) * 100 : 0 %>%"></div>
                    </div>
                </div>
            </a>

            <!-- Hero Card 4: External Calls -->
            <a href="<%= baseUrl %>&callScopeFilter=EXTERNAL&statusFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات الخارجية في سجل الاتصالات' : 'View external calls in Call History' %>"
               class="panel-surface rounded-2xl p-5 card-stat border border-[#27272a]/30 hover:border-indigo-500 transition-all duration-200 cursor-pointer group relative flex flex-col justify-between overflow-hidden">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-3">
                        <span class="p-2.5 rounded-xl bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shrink-0 group-hover:scale-110 transition-transform">
                            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 002 2h1.5a2.5 2.5 0 002.5-2.5V8.5a5.5 5.5 0 00-5.5-5.5h-.055M12 3a9 9 0 100 18 9 9 0 000-18z"/>
                            </svg>
                        </span>
                        <div>
                            <p class="text-[11px] font-bold uppercase text-zinc-400 tracking-wider"><%= t.externalCalls %></p>
                            <p class="text-xs text-indigo-400/80 font-mono mt-0.5"><span class="card-stat-val"><%= stats.externalMin || 0 %></span> <%= t.min %> <%= t.airMinutes %></p>
                        </div>
                    </div>
                    <svg class="w-4 h-4 text-zinc-600 group-hover:text-indigo-400 transition-colors shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="<%= isRtl ? 'M10 19l-7-7m0 0l7-7m-7 7h18' : 'M14 5l7 7m0 0l-7 7m7-7H3' %>"/>
                    </svg>
                </div>
                <div class="mt-4">
                    <p class="text-3xl sm:text-4xl font-black text-white card-stat-val tracking-tight"><%= stats.externalCount || 0 %></p>
                    <div class="mt-3 h-1.5 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-indigo-500 rounded-full transition-all duration-500" style="width: <%= stats.totalCalls ? ((stats.externalCount || 0) / stats.totalCalls) * 100 : 0 %>%"></div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Section 2: Flagship Call Volume Trend (Full Width) -->
        <div class="panel-surface border border-[#27272a]/30 rounded-2xl mb-6 shrink-0">
            <div class="px-5 py-4 border-b border-[#27272a] bg-black/20 flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <span class="p-1.5 rounded-lg bg-[var(--accent-color)]/10 text-[var(--accent-color)] border border-[var(--accent-color)]/20 shrink-0">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
                    </span>
                    <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartTrend %></h2>
                </div>
            </div>
            <div class="p-4">
                <div id="trendChart" class="w-full h-72"></div>
            </div>
        </div>

        <!-- Section 3: Operations Row (Hourly Distribution + Top Talkers) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6 shrink-0">
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl flex flex-col h-full overflow-hidden">
                <div class="px-5 py-3 border-b border-[#27272a] bg-black/20 flex items-center flex-wrap gap-x-4 gap-y-2 shrink-0">
                    <div class="flex items-center gap-2.5 min-w-0 mr-auto">
                        <span class="p-1.5 rounded-lg bg-sky-500/10 text-sky-400 border border-sky-500/20 shrink-0">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </span>
                        <div class="min-w-0">
                            <h2 id="hourlyChartTitle" class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartHourly %></h2>
                            <p id="hourlyChartSubtitle" class="text-[11px] text-[var(--text-muted)] font-mono"></p>
                        </div>
                    </div>
                    <!-- Peak Badge -->
                    <span id="hourlyPeakBadge" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 font-mono whitespace-nowrap">
                        <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="currentColor"><path d="M12 23c-4.97 0-9-3.58-9-8 0-2.52 1.17-5.13 3.08-7.46.58-.71 1.26-1.39 1.92-1.97V5c0-.55.45-1 1-1s1 .45 1 1v.57c0 .27-.11.52-.29.71C8.25 7.74 7 9.87 7 12c0 2.76 2.24 5 5 5s5-2.24 5-5c0-1.09-.37-2.13-1-3 .71.88 1.2 1.91 1.44 3.01C17.79 13.35 18 14.16 18 15c0 4.42-4.03 8-6 8z"/><path d="M12 21c2.76 0 5-2.24 5-5 0-1.4-.58-2.67-1.5-3.6-.25-.24-.54-.46-.84-.64.09.42.14.85.14 1.24 0 2.76-2.24 5-5 5-1.38 0-2.63-.56-3.54-1.46C7.32 17.62 9.42 21 12 21z" opacity=".6"/></svg>
                        <span id="hourlyPeakText"></span>
                    </span>
                    <!-- Specific Day Dropdown Selector (only visible when multiple days exist) -->
                    <select id="hourlyDaySelect" onchange="onHourlyDaySelect(this.value)" class="hidden bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg text-xs font-semibold px-2 py-1 text-[var(--text-primary)] focus:outline-none focus:border-[var(--accent-color)] cursor-pointer shrink-0">
                        <option value="all"><%= isRtl ? 'جميع الأيام' : 'All Days' %></option>
                    </select>
                    <!-- Switcher (Hours vs Days) -->
                    <div id="hourlyTimeModeWrapper" class="inline-flex items-center p-0.5 rounded-lg bg-[var(--bg-card)] border border-[var(--border-primary)] gap-0.5 shrink-0">
                        <button type="button" id="btn-dist-hours" onclick="setDistributionMode('hours')" class="px-2.5 py-1 rounded-md text-xs font-bold transition cursor-pointer btn-primary whitespace-nowrap">
                            <span><%= isRtl ? 'بالساعات' : 'Hourly' %></span>
                        </button>
                        <button type="button" id="btn-dist-days" onclick="setDistributionMode('days')" class="px-2.5 py-1 rounded-md text-xs font-bold transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] whitespace-nowrap">
                            <span><%= isRtl ? 'بالأيام' : 'Daily' %></span>
                        </button>
                    </div>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-center">
                    <div id="hourlyChart" class="w-full h-64 min-h-[256px]"></div>
                </div>
            </div>
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 shrink-0">
                            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z"/></svg>
                        </span>
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartTopTalkers %></h2>
                    </div>
                </div>
                <div class="p-4">
                    <div id="topTalkersChart" class="w-full" style="height: 280px"></div>
                </div>
            </div>
        </div>

        <!-- Section 4: Secondary Metric Tiles (8 compact cards) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 mb-6 shrink-0">
            <!-- Tile 1: Total Inbound Calls -->
            <a href="<%= baseUrl %>&directionFilter=INBOUND&statusFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات الواردة في سجل الاتصالات' : 'View inbound calls in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-sky-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.inbound %></span>
                    <span class="w-2 h-2 rounded-full bg-sky-500 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.inboundCount %></p>
                    <p class="text-[10px] font-bold text-sky-400 font-mono mt-1 truncate"><span class="card-stat-val"><%= stats.inboundMin %></span> <%= t.min %></p>
                </div>
            </a>

            <!-- Tile 2: Total Outbound Calls -->
            <a href="<%= baseUrl %>&directionFilter=OUTBOUND&statusFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات الصادرة في سجل الاتصالات' : 'View outbound calls in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-amber-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.outbound %></span>
                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.outboundCount %></p>
                    <p class="text-[10px] font-bold text-amber-400/80 font-mono mt-1 truncate"><span class="card-stat-val"><%= stats.outboundMin %></span> <%= t.min %></p>
                </div>
            </a>

            <!-- Tile 3: Internal Calls -->
            <a href="<%= baseUrl %>&callScopeFilter=INTERNAL&statusFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات الداخلية في سجل الاتصالات' : 'View internal calls in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-purple-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.internalCalls %></span>
                    <span class="w-2 h-2 rounded-full bg-purple-500 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.internalCount || 0 %></p>
                    <p class="text-[10px] font-bold text-purple-400 font-mono mt-1 truncate"><span class="card-stat-val"><%= stats.internalMin || 0 %></span> <%= t.min %></p>
                </div>
            </a>

            <!-- Tile 4: No Answer / Missed -->
            <a href="<%= baseUrl %>&statusFilter=NO ANSWER&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات الفائتة في سجل الاتصالات' : 'View missed calls in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-rose-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.noAnswer %></span>
                    <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.noAnswerCalls %></p>
                    <div class="mt-2 h-1 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-rose-500 rounded-full" style="width: <%= stats.totalCalls ? (stats.noAnswerCalls / stats.totalCalls) * 100 : 0 %>%"></div>
                    </div>
                </div>
            </a>

            <!-- Tile 5: Busy Calls -->
            <a href="<%= baseUrl %>&statusFilter=BUSY&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات المشغولة في سجل الاتصالات' : 'View busy calls in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-amber-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.busy %></span>
                    <span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.busyCalls %></p>
                    <div class="mt-2 h-1 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-amber-500 rounded-full" style="width: <%= stats.totalCalls ? (stats.busyCalls / stats.totalCalls) * 100 : 0 %>%"></div>
                    </div>
                </div>
            </a>

            <!-- Tile 6: Failed Calls -->
            <a href="<%= baseUrl %>&statusFilter=FAILED&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض المكالمات الفاشلة في سجل الاتصالات' : 'View failed calls in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-red-600 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.failed %></span>
                    <span class="w-2 h-2 rounded-full bg-red-600 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.failedCalls %></p>
                    <div class="mt-2 h-1 w-full bg-zinc-800/50 rounded-full overflow-hidden">
                        <div class="h-full bg-red-600 rounded-full" style="width: <%= stats.totalCalls ? (stats.failedCalls / stats.totalCalls) * 100 : 0 %>%"></div>
                    </div>
                </div>
            </a>

            <!-- Tile 7: Total Talk Time -->
            <a href="<%= baseUrl %>&statusFilter=ANSWERED&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض تفاصيل أوقات المكالمات في سجل الاتصالات' : 'View total talk time in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-cyan-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.totalAirtime %></span>
                    <span class="w-2 h-2 rounded-full bg-cyan-400 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val"><%= stats.totalTalkMin %> <span class="text-[11px] font-bold text-cyan-400 font-mono"><%= t.min %></span></p>
                    <p class="text-[10px] font-bold text-cyan-400/80 font-mono mt-1 truncate"><span class="card-stat-val"><%= Math.round(stats.totalTalkSec) %></span> <%= t.sec %></p>
                </div>
            </a>

            <!-- Tile 8: Avg Call Duration -->
            <a href="<%= baseUrl %>&statusFilter=ANSWERED&directionFilter=ALL" 
               title="<%= isRtl ? 'عرض تفاصيل مدة المكالمات في سجل الاتصالات' : 'View average duration in Call History' %>"
               class="panel-surface rounded-xl p-3.5 card-stat border border-[#27272a]/30 hover:border-indigo-500 transition-all duration-200 cursor-pointer group flex flex-col justify-between overflow-hidden">
                <div class="flex items-center justify-between gap-1">
                    <span class="text-[10px] font-bold uppercase text-zinc-400 tracking-wider truncate"><%= t.avgDuration %></span>
                    <span class="w-2 h-2 rounded-full bg-indigo-400 shrink-0"></span>
                </div>
                <div class="mt-2">
                    <p class="text-xl font-bold text-white card-stat-val">
                        <% if (avgSec >= 60) { %>
                            <span><%= Math.floor(avgSec / 60) %></span><span class="text-[11px] font-bold font-mono"><%= t.min %></span> <span><%= avgSec % 60 %></span><span class="text-[11px] font-bold font-mono"><%= t.sec %></span>
                        <% } else { %>
                            <span><%= avgSec %></span><span class="text-[11px] font-bold font-mono"><%= t.sec %></span>
                        <% } %>
                    </p>
                    <p class="text-[10px] font-bold text-indigo-400/80 mt-1 truncate"><%= isRtl ? 'لكل مكالمة' : 'per call' %></p>
                </div>
            </a>
        </div>

        <!-- Section 5: Proportional Breakdown Row (3 Donuts) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6 shrink-0">
            <!-- Donut 1: Call Disposition -->
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl flex flex-col">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </span>
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartDisposition %></h2>
                    </div>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-center">
                    <div id="dispositionChart" class="w-full h-64 min-h-[256px]"></div>
                </div>
            </div>

            <!-- Donut 2: Call Duration Breakdown -->
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl flex flex-col">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/20 shrink-0">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        </span>
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= isRtl ? 'تصنيف مدة المكالمات' : 'Call Duration Breakdown' %></h2>
                    </div>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-center">
                    <div id="durationChart" class="w-full h-64 min-h-[256px]"></div>
                </div>
            </div>

            <!-- Donut 3: Call Scope Breakdown -->
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl flex flex-col">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <span class="p-1.5 rounded-lg bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 shrink-0">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                        </span>
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartScope %></h2>
                    </div>
                </div>
                <div class="p-4 flex-1 flex flex-col justify-center">
                    <div id="scopeChart" class="w-full h-64 min-h-[256px]"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const trendData = <%- (typeof trendData !== 'undefined' && trendData) ? trendData : '[]' %>;
        const dispositionData = <%- (typeof dispositionData !== 'undefined' && dispositionData) ? dispositionData : '[]' %>;
        const hourlyData = <%- (typeof hourlyData !== 'undefined' && hourlyData) ? hourlyData : '[]' %>;
        const hourlyByDayData = <%- (typeof hourlyByDay !== 'undefined' && hourlyByDay) ? hourlyByDay : '{}' %>;
        const topTalkersData = <%- (typeof topTalkers !== 'undefined' && topTalkers) ? topTalkers : '[]' %>;
        const durationData = <%- (typeof durationData !== 'undefined' && durationData) ? durationData : '[]' %>;
        const scopeData = <%- (typeof scopeData !== 'undefined' && scopeData) ? scopeData : '[]' %>;
        const _isRtl = <%= (typeof isRtl !== 'undefined' && isRtl) ? 'true' : 'false' %>;
        const _t = {
            talkTime: '<%= t.talkTime %>',
            min: '<%= t.min %>',
            calls: '<%= t.calls %>',
            total: '<%= isRtl ? "الإجمالي" : "Total" %>',
            inbound: '<%= t.inbound %>',
            outbound: '<%= t.outbound %>',
            saving: '<%= t.saving %>',
            saved: '<%= t.saved %>',
            addedToast: '<%= t.addedToast %>',
            failedSave: '<%= t.failedSave %>',
            errorSave: '<%= t.errorSave %>',
            uploadingCsv: '<%= t.uploadingCsv %>',
            imported: '<%= t.imported %>',
            importedToast: '<%= t.importedToast %>',
            failedImport: '<%= t.failedImport %>',
            errorImport: '<%= t.errorImport %>'
        };
        const _dispTranslations = {
            'ANSWERED': '<%= isRtl ? "تم الرد" : "ANSWERED" %>',
            'BUSY': '<%= isRtl ? "مشغول" : "BUSY" %>',
            'NO ANSWER': '<%= isRtl ? "لم يتم الرد" : "NO ANSWER" %>',
            'FAILED': '<%= isRtl ? "فاشلة" : "FAILED" %>',
            'CONGESTION': '<%= isRtl ? "ازدحام" : "CONGESTION" %>',
            'UNKNOWN': '<%= isRtl ? "غير معروف" : "UNKNOWN" %>'
        };
        const _durTranslations = {
            'Short (<30s)': '<%= isRtl ? "قصيرة (أقل من 30 ث)" : "Short (< 30s)" %>',
            'Medium (30s-3m)': '<%= isRtl ? "متوسطة (30 ث - 3 د)" : "Medium (30s - 3m)" %>',
            'Long (>3m)': '<%= isRtl ? "طويلة (أكثر من 3 د)" : "Long (> 3m)" %>'
        };
        const _scopeTranslations = {
            'Internal': '<%= isRtl ? "داخلي" : "Internal" %>',
            'External': '<%= isRtl ? "خارجي" : "External" %>'
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.updateClock === 'function') window.updateClock();
            if (typeof anime !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                anime({
                    targets: '.card-stat',
                    opacity: [0, 1],
                    translateY: [15, 0],
                    delay: anime.stagger(50),
                    duration: 450,
                    easing: 'easeOutCubic'
                });
            }

            const isLight = document.documentElement.classList.contains('light-theme');
            const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim() || '#dc2626';

            // -- Call Volume Trend --
            const trendChart = echarts.init(document.getElementById('trendChart'), isLight ? null : 'dark');
            trendChart.setOption({
                textStyle: {
                    fontFamily: _isRtl ? "'JetBrains Mono', 'Cairo', monospace" : "'JetBrains Mono', monospace"
                },
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                legend: {
                    bottom: 0,
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold' }
                },
                grid: { left: 40, right: 20, top: 20, bottom: 50 },
                xAxis: {
                    type: 'category',
                    data: trendData.map(d => d.date.slice(5)),
                    axisLine: { lineStyle: { color: '#27272a' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9, fontWeight: 'bold' }
                },
                yAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9 }
                },
                series: [
                    {
                        name: _t.total,
                        type: 'line',
                        smooth: true,
                        symbol: 'circle',
                        symbolSize: 6,
                        lineStyle: { width: 2.5, color: accent },
                        areaStyle: {
                            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                { offset: 0, color: accent + '60' },
                                { offset: 1, color: accent + '05' }
                            ])
                        },
                        itemStyle: { color: accent },
                        data: trendData.map(d => d.total)
                    },
                    {
                        name: _t.inbound,
                        type: 'bar',
                        barWidth: 6,
                        barGap: '20%',
                        itemStyle: { color: accent, borderRadius: [3, 3, 0, 0] },
                        data: trendData.map(d => d.inbound)
                    },
                    {
                        name: _t.outbound,
                        type: 'bar',
                        barWidth: 6,
                        barGap: '20%',
                        itemStyle: { color: '#00b4d8', borderRadius: [3, 3, 0, 0] },
                        data: trendData.map(d => d.outbound)
                    }
                ]
            });
            window.addEventListener('resize', () => trendChart.resize());

            // -- Disposition Breakdown --
            const accentColor = accent;
            const dispPalette = {
                'ANSWERED': accentColor,
                'BUSY': '#fbbf24',
                'NO ANSWER': '#2dd4bf',
                'FAILED': '#a855f7',
                'CONGESTION': '#f97316',
                'UNKNOWN': '#71717a'
            };
            const dispChart = echarts.init(document.getElementById('dispositionChart'), isLight ? null : 'dark');
            dispChart.setOption({
                textStyle: {
                    fontFamily: _isRtl ? "'JetBrains Mono', 'Cairo', monospace" : "'JetBrains Mono', monospace"
                },
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'item',
                    formatter: function(params) { return params.name + ': ' + params.value + ' ' + _t.calls + ' (' + params.percent + '%)'; },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                legend: {
                    bottom: 0,
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    type: 'pie',
                    radius: ['35%', '65%'],
                    center: ['50%', '45%'],
                    roseType: 'area',
                    itemStyle: {
                        borderRadius: 6,
                        borderColor: isLight ? '#ffffff' : '#121212',
                        borderWidth: 2.5
                    },
                    label: {
                        show: true,
                        formatter: '{b}\n{d}%',
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#27272a' : '#d4d4d8'
                    },
                    data: dispositionData.map(d => ({
                        value: d.value,
                        name: _dispTranslations[d.name] || d.name,
                        itemStyle: { color: dispPalette[d.name] || '#71717a' }
                    })),
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => dispChart.resize());

            // -- Hourly / Daily Call Distribution --
            const hourlyChart = echarts.init(document.getElementById('hourlyChart'), isLight ? null : 'dark');

            const _dashStartDate = '<%= filters.startDate %>';
            const _dashEndDate = '<%= filters.endDate %>';
            const _filterHours = (typeof moment !== 'undefined') ? Math.max(1, moment(_dashEndDate).diff(moment(_dashStartDate), 'hours')) : 24;
            const _filterDaysCalc = (typeof moment !== 'undefined') ? Math.max(1, Math.ceil(moment(_dashEndDate).diff(moment(_dashStartDate), 'days', true))) : 1;
            const _availableDays = Object.keys(hourlyByDayData || {}).sort();
            const _trendDaysCount = (trendData || []).filter(d => (d.total || 0) > 0).length || _availableDays.length || (trendData || []).length || 1;
            const _effectiveDays = Math.max(_trendDaysCount, _filterDaysCalc, _availableDays.length);
            const _isMultiDay = _effectiveDays > 1 && _availableDays.length > 1;

            let currentDistMode = 'hours';
            let selectedSpecificDay = 'all';

            function formatDayLabel(rawDate) {
                if (!rawDate) return '';
                if (typeof moment !== 'undefined') {
                    const fullDate = rawDate.length === 5 ? (moment().year() + '-' + rawDate) : rawDate;
                    const m = moment(fullDate);
                    if (m.isValid()) {
                        return _isRtl ? m.format('D MMM') : m.format('MMM D');
                    }
                }
                return rawDate;
            }

            function formatFullDayName(rawDate) {
                if (!rawDate) return '';
                if (typeof moment !== 'undefined') {
                    const m = moment(rawDate);
                    if (m.isValid()) {
                        return _isRtl ? m.format('dddd، D MMMM YYYY') : m.format('dddd, MMMM D, YYYY');
                    }
                }
                return rawDate;
            }

            // Populate the day selector dropdown if multiple days exist
            const daySelectEl = document.getElementById('hourlyDaySelect');
            if (daySelectEl && _isMultiDay) {
                daySelectEl.classList.remove('hidden');
                daySelectEl.innerHTML = '';

                const optAll = document.createElement('option');
                optAll.value = 'all';
                optAll.textContent = _isRtl ? 'جميع الأيام (تجميعي)' : 'All Days (Aggregated)';
                daySelectEl.appendChild(optAll);

                _availableDays.forEach(dayStr => {
                    const opt = document.createElement('option');
                    opt.value = dayStr;
                    opt.textContent = formatDayLabel(dayStr);
                    daySelectEl.appendChild(opt);
                });
            }

            window.onHourlyDaySelect = function(val) {
                selectedSpecificDay = val;
                if (val !== 'all') {
                    currentDistMode = 'hours';
                    updateDistButtons();
                }
                renderHourlyChart();
            };

            window.setDistributionMode = function(mode) {
                currentDistMode = mode;
                if (mode === 'days') {
                    selectedSpecificDay = 'all';
                    if (daySelectEl) daySelectEl.value = 'all';
                }
                updateDistButtons();
                renderHourlyChart();
            };

            function updateDistButtons() {
                const btnH = document.getElementById('btn-dist-hours');
                const btnD = document.getElementById('btn-dist-days');
                const activeCls = 'px-2.5 py-1 rounded-md text-xs font-bold transition cursor-pointer btn-primary whitespace-nowrap';
                const inactiveCls = 'px-2.5 py-1 rounded-md text-xs font-bold transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] whitespace-nowrap';
                if (btnH && btnD) {
                    btnH.className = currentDistMode === 'hours' ? activeCls : inactiveCls;
                    btnD.className = currentDistMode === 'days' ? activeCls : inactiveCls;
                }
            }

            function renderHourlyChart() {
                const titleEl = document.getElementById('hourlyChartTitle');
                const subEl = document.getElementById('hourlyChartSubtitle');
                const peakBadge = document.getElementById('hourlyPeakBadge');
                const peakText = document.getElementById('hourlyPeakText');

                // Locked, unified grid margins for zero layout shifts
                const commonGrid = { left: 45, right: 20, top: 22, bottom: 32, containLabel: true };

                if (currentDistMode === 'days') {
                    // Daily Distribution Mode
                    if (titleEl) titleEl.textContent = _isRtl ? 'توزيع المكالمات بالأيام' : 'Daily Call Distribution';
                    if (subEl) {
                        subEl.textContent = _effectiveDays === 1 
                            ? (_isRtl ? 'يوم واحد (اليوم)' : 'Single Day (Today)')
                            : (_isRtl ? `عبر ${_effectiveDays} أيام` : `Across ${_effectiveDays} days`);
                    }

                    const rawDates = (trendData || []).map(d => d.date ? d.date.slice(5) : '');
                    const dayLabels = rawDates.map(d => formatDayLabel(d));
                    const dayValues = (trendData || []).map(d => d.total || 0);
                    const maxDayVal = Math.max(...dayValues, 0);
                    const peakDayIndex = dayValues.indexOf(maxDayVal);

                    if (peakBadge && peakText) {
                        if (maxDayVal > 0 && peakDayIndex >= 0) {
                            peakBadge.classList.remove('hidden');
                            peakText.textContent = (_isRtl ? 'الذروة: ' : 'Peak: ') + dayLabels[peakDayIndex] + ` (${maxDayVal} ${_t.calls})`;
                        } else {
                            peakBadge.classList.add('hidden');
                        }
                    }


    <script>
        // Fix Flatpickr month dropdown: force <select> visible, handle click for showPicker()
        (function() {
            function forceMonthSelect() {
                document.querySelectorAll('.flatpickr-current-month').forEach(function(el) {
                    var sel = el.querySelector('.flatpickr-monthDropdown-months');
                    var cur = el.querySelector('.cur-month');
                    if (!sel) return;
                    if (cur) cur.style.setProperty('display', 'none', 'important');
                    sel.style.setProperty('display', 'inline-block', 'important');
                    sel.style.setProperty('pointer-events', 'auto', 'important');
                    sel.style.setProperty('cursor', 'pointer', 'important');
                    sel.style.setProperty('opacity', '1', 'important');
                });
            }
            // Add click handlers separately (non-polled, one-time)
            document.addEventListener('click', function(e) {
                var el = e.target.closest('.flatpickr-current-month');
                if (!el) return;
                var sel = el.querySelector('.flatpickr-monthDropdown-months');
                if (!sel) return;
                if (e.target === sel) return; // let native click work
                e.preventDefault();
                e.stopPropagation();
                if (typeof sel.showPicker === 'function') {
                    sel.showPicker();
                } else {
                    try { sel.click(); } catch(_) {}
                }
            }, true);
            // Initial run + poll aggressively for 3 seconds
            forceMonthSelect();
            var pollTimer = setInterval(function() {
                forceMonthSelect();
            }, 100);
            setTimeout(function() { clearInterval(pollTimer); }, 3000);
            // Watch for new calendars
            var obs = new MutationObserver(function(muts) {
                muts.forEach(function(mut) {
                    mut.addedNodes.forEach(function(n) {
                        if (n.nodeType === 1) {
                            if (n.querySelectorAll) forceMonthSelect();
                        }
                    });
                });
            });
            obs.observe(document.body, { childList: true, subtree: true });
        })();
    </script>

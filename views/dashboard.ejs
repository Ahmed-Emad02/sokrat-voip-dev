                            shadowOffsetX: 3
                        }
                    },
                    data: topTalkersData.map(d => Math.round(d.talkSec / 60)),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const data = topTalkersData[params.dataIndex];
                            return data.calls + ' ' + _t.calls;
                        },
                        fontSize: 9,
                        fontWeight: '600',
                        color: isLight ? '#71717a' : '#a1a1aa',
                        fontFamily: _chartFont
                    },
                    animationEasing: 'elasticOut',
                    animationDuration: 800,
                    animationDelay: function(idx) { return idx * 60; }
                }]
            });
            window.addEventListener('resize', () => talkersChart.resize());

            // -- Call Duration (Modern Donut with Center Metric & Non-Clipping Legend) --
            const durationChart = echarts.init(document.getElementById('durationChart'), isLight ? null : 'dark');
            const durationColors = {
                'Short (<30s)': '#38bdf8',
                'Medium (30s-3m)': '#f59e0b',
                'Long (>3m)': '#f43f5e'
            };
            const totalDurActual = durationData.reduce((acc, curr) => acc + (curr.value || 0), 0);
            const totalDurVal = totalDurActual || 1;

            function renderDurationChart() {
                const chartEl = document.getElementById('durationChart');
                const width = chartEl ? chartEl.offsetWidth : 753;
                const isNarrow = width < 480;

                const centerPos = isNarrow ? ['50%', '38%'] : (_isRtl ? ['68%', '50%'] : ['32%', '50%']);
                const titleLeft = isNarrow ? '50%' : (_isRtl ? '68%' : '32%');
                const titleTop = isNarrow ? '28%' : '38%';

                durationChart.setOption({
                    textStyle: {
                        fontFamily: _chartFont
                    },
                    backgroundColor: 'transparent',
                    tooltip: {
                        trigger: 'item',
                        backgroundColor: isLight ? '#ffffff' : '#18181b',
                        borderColor: isLight ? '#e4e4e7' : '#27272a',
                        borderWidth: 1,
                        padding: [8, 12],
                        textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11, fontFamily: _chartFont },
                        formatter: function(params) {
                            const pct = totalDurActual > 0 ? Math.round((params.value / totalDurVal) * 100) : 0;
                            return `<b>${params.name}</b><br/>${params.value} ${_t.calls} (${pct}%)`;
                        }
                    },
                    legend: {
                        orient: isNarrow ? 'horizontal' : 'vertical',
                        left: isNarrow ? 'center' : (_isRtl ? '6%' : 'auto'),
                        right: isNarrow ? 'auto' : (_isRtl ? 'auto' : '6%'),
                        top: isNarrow ? 'bottom' : 'middle',
                        itemGap: isNarrow ? 10 : 16,
                        itemWidth: 12,
                        itemHeight: 12,
                        textStyle: {
                            color: isLight ? '#27272a' : '#d4d4d8',
                            fontSize: 11,
                            fontWeight: 'bold',
                            fontFamily: _chartFont
                        },
                        formatter: function(name) {
                            const item = durationData.find(d => (_durTranslations[d.name] || d.name) === name);
                            const val = item ? (item.value || 0) : 0;
                            const pct = totalDurActual > 0 ? Math.round((val / totalDurVal) * 100) : 0;
                            return `${name} :  ${val} (${pct}%)`;
                        }
                    },
                    title: {
                        text: String(totalDurActual),
                        subtext: _isRtl ? 'مكالمة' : 'Calls',
                        left: titleLeft,
                        top: titleTop,
                        textAlign: 'center',
                        textStyle: {
                            fontSize: 20,
                            fontWeight: '900',
                            color: isLight ? '#09090b' : '#ffffff',
                            fontFamily: _chartFont
                        },
                        subtextStyle: {
                            fontSize: 10,
                            fontWeight: 'bold',
                            color: isLight ? '#71717a' : '#a1a1aa',
                            fontFamily: _chartFont
                        }
                    },
                    series: [{
                        name: _isRtl ? 'مدة المكالمات' : 'Call Duration',
                        type: 'pie',
                        radius: ['52%', '78%'],
                        center: centerPos,
                        avoidLabelOverlap: false,
                        itemStyle: {
                            borderRadius: 8,
                            borderColor: isLight ? '#ffffff' : '#18181b',
                            borderWidth: 3
                        },
                        label: { show: false },
                        emphasis: {
                            scale: true,
                            scaleSize: 6,
                            label: { show: false }
                        },
                        data: durationData.map(d => ({
                            value: d.value || 0,
                            name: _durTranslations[d.name] || d.name,
                            itemStyle: { color: durationColors[d.name] || '#64748b' }
                        })),
                        animationEasing: 'cubicOut',
                        animationDuration: 650
                    }]
                });
            }

            renderDurationChart();
            window.addEventListener('resize', () => {
                renderDurationChart();
                durationChart.resize();
            });

            // -- Call Scope Breakdown (Internal vs External) --
            const scopeChart = echarts.init(document.getElementById('scopeChart'), isLight ? null : 'dark');
            const scopeColors = {
                'Internal': '#9333ea',
                'External': '#0284c7'
            };
            const totalScopeVal = scopeData.reduce((acc, curr) => acc + (curr.value || 0), 0) || 1;

            scopeChart.setOption({
                textStyle: {
                    fontFamily: _chartFont
                },
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'axis',
                    axisPointer: { type: 'shadow' },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11, fontFamily: _chartFont },
                    formatter: function(params) {
                        const p = params[0];
                        const pct = Math.round((p.value / totalScopeVal) * 100);
                        return p.name + ': ' + p.value + ' ' + _t.calls + ' (' + pct + '%)';
                    }
                },
                grid: { left: 10, right: 25, top: 10, bottom: 15, containLabel: true },
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9, fontFamily: _chartFont }
                },
                yAxis: {
                    type: 'category',
                    data: scopeData.map(d => _scopeTranslations[d.name] || d.name),
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: { color: isLight ? '#27272a' : '#ffffff', fontSize: 10, fontWeight: 'bold', fontFamily: _chartFont }
                },
                series: [{
                    name: 'Calls',
                    type: 'bar',
                    barWidth: '45%',
                    itemStyle: {
                        borderRadius: [0, 6, 6, 0]
                    },
                    data: scopeData.map(d => ({
                        value: d.value,
                        name: _scopeTranslations[d.name] || d.name,
                        itemStyle: { color: scopeColors[d.name] || '#64748b' }
                    })),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const pct = Math.round((params.value / totalScopeVal) * 100);
                            return params.value + ' (' + pct + '%)';
                        },
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#52525b' : '#a1a1aa'
                    },
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => scopeChart.resize());

            // Force ECharts to repaint once web fonts (Cairo) are fully loaded in the browser
            const allDashboardCharts = [trendChart, dispChart, hourlyChart, talkersChart, durationChart, scopeChart];
            const resizeAllDashboardCharts = () => {
                allDashboardCharts.forEach(c => {
                    if (c && typeof c.resize === 'function') {
                        c.resize();
                    }
                });
            };

            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(() => {
                    resizeAllDashboardCharts();
                });
            }

            // Continuous ResizeObserver on chart parent containers so charts always fill empty flex space
            if (typeof window !== 'undefined' && window.ResizeObserver) {
                const chartResizeObserver = new ResizeObserver(() => {
                    resizeAllDashboardCharts();
                });
                ['trendChart', 'hourlyChart', 'topTalkersChart', 'dispositionChart', 'durationChart', 'scopeChart'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) {
                        chartResizeObserver.observe(el);
                        if (el.parentElement) chartResizeObserver.observe(el.parentElement);
                    }
                });
            }

            // Initialize Flatpickr on datetime inputs
            flatpickr('input[type="datetime-local"]', {
                enableTime: true,
                dateFormat: "Y-m-d\\TH:i",
                altInput: true,
                altFormat: "m/d/Y h:i K",
                time_24hr: false,
                allowInput: true,
                scrollInputIntoView: false,
                appendTo: document.body,
                monthSelectorType: "dropdown",
                onReady: function(selectedDates, dateStr, instance) {
                    if (instance.altInput) {
                        var origId = instance.input.id || (instance.input.name ? instance.input.name + 'Input' : 'datePicker_' + Math.random().toString(36).substring(2, 7));
                        if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                        instance.input.id = origId + '_raw';
                        instance.altInput.id = origId;
                        instance.altInput.name = (instance.input.name || origId) + '_display';
                        instance.altInput.setAttribute('autocomplete', 'off');
                        var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                        instance.altInput.setAttribute('aria-label', ariaLabel);
                    }
                }
            });
        });
    </script>
    <script>
        function toggleChecklistMenu(menuId, event) {
            if (event) event.stopPropagation();
            const menu = document.getElementById(menuId);
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden');
            document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            if (isHidden) menu.classList.remove('hidden');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.checklist-menu') && !e.target.closest('button[onclick*="toggleChecklistMenu"]')) {
                document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            }
        });

        function syncExtChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-ext-chk'));
            const select = document.getElementById('dashTargetExtensionSelect');
            const labelSpan = document.getElementById('dashExtChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allExt) %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onExtChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-ext-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncExtChecklistUI();
        }

function syncStatusChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-status-chk'));
            const select = document.getElementById('dashStatusFilterSelect');
            const labelSpan = document.getElementById('dashStatusChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allDisp) %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onStatusChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-status-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncStatusChecklistUI();
        }

        function syncDashTrunkChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-trk-chk'));
            const select = document.getElementById('dashTrunkFilter');
            const labelSpan = document.getElementById('dashTrunkChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allTrunks) %>;
            } else if (nonAllSelected.length === 1) {
                const opt = Array.from(select.options).find(o => o.value === nonAllSelected[0]);
                labelSpan.textContent = opt ? opt.textContent : nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onDashTrunkChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-trk-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncDashTrunkChecklistUI();
        }

        function toggleDashboardMoreFilters(forcedState, immediate) {
            const drawer = document.getElementById('dashSecondaryFilters');
            const label = document.getElementById('dashToggleMoreLabel');
            const icon = document.getElementById('dashToggleMoreIcon');
            if (!drawer) return;

            const isCurrentlyHidden = drawer.classList.contains('hidden') || drawer.style.display === 'none' || drawer.offsetHeight === 0;
            const expand = (typeof forcedState === 'boolean') ? forcedState : isCurrentlyHidden;

            if (expand) {
                if (!drawer.classList.contains('hidden') && drawer.offsetHeight > 0 && !drawer.dataset.animating) {
                    return;
                }

                if (immediate) {
                    drawer.classList.remove('hidden');
                    drawer.style.display = 'block';
                    drawer.style.maxHeight = 'none';
                    drawer.style.opacity = '1';
                    drawer.style.overflow = 'visible';
                    drawer.style.transition = 'none';
                    if (label) label.textContent = <%- JSON.stringify(t.lessFilters) %>;
                    if (icon) icon.classList.add('rotate-180');
                    try { localStorage.setItem('dash_filters_expanded', 'true'); } catch (e) {}
                    return;
                }

                drawer.dataset.animating = 'true';
                drawer.classList.remove('hidden');
                drawer.style.display = 'block';
                drawer.style.overflow = 'hidden';
                drawer.style.transition = 'none';
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';

                // Measure real target height with contents rendered
                const targetHeight = drawer.scrollHeight;

                // Force layout reflow before starting transition
                void drawer.offsetHeight;

                drawer.style.transition = 'max-height 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease-out';

                requestAnimationFrame(() => {
                    drawer.style.maxHeight = targetHeight + 'px';
                    drawer.style.opacity = '1';
                });

                let finished = false;
                const finishExpand = () => {
                    if (finished) return;
                    finished = true;
                    delete drawer.dataset.animating;
                    drawer.style.transition = 'none';
                    drawer.style.maxHeight = 'none';
                    drawer.style.overflow = 'visible';
                };

                const onEnd = (e) => {
                    if (e && (e.target !== drawer || e.propertyName !== 'max-height')) return;
                    drawer.removeEventListener('transitionend', onEnd);
                    finishExpand();
                };
                drawer.addEventListener('transitionend', onEnd);
                setTimeout(finishExpand, 350);

                if (label) label.textContent = <%- JSON.stringify(t.lessFilters) %>;
                if (icon) icon.classList.add('rotate-180');
                try { localStorage.setItem('dash_filters_expanded', 'true'); } catch (e) {}
            } else {
                if (drawer.classList.contains('hidden') && !drawer.dataset.animating) {
                    return;
                }

                if (immediate) {
                    drawer.classList.add('hidden');
                    drawer.style.display = '';
                    drawer.style.maxHeight = '';
                    drawer.style.opacity = '';
                    drawer.style.overflow = '';
                    drawer.style.transition = '';
                    if (label) label.textContent = <%- JSON.stringify(t.moreFilters) %>;
                    if (icon) icon.classList.remove('rotate-180');
                    try { localStorage.setItem('dash_filters_expanded', 'false'); } catch (e) {}
                    return;
                }

                drawer.dataset.animating = 'true';
                drawer.style.overflow = 'hidden';

                // 1. Lock current computed pixel height without transition to eliminate jumps from 'none'
                const startHeight = drawer.offsetHeight || drawer.scrollHeight;
                drawer.style.transition = 'none';
                drawer.style.maxHeight = startHeight + 'px';
                drawer.style.opacity = '1';

                // 2. Force layout reflow so the browser commits the start height
                void drawer.offsetHeight;

                // 3. Apply smooth collapse transition and animate to 0
                drawer.style.transition = 'max-height 0.26s cubic-bezier(0.2, 0, 0, 1), opacity 0.2s ease-in';

                requestAnimationFrame(() => {
                    drawer.style.maxHeight = '0px';
                    drawer.style.opacity = '0';
                });

                let finished = false;
                const finishCollapse = () => {
                    if (finished) return;
                    finished = true;
                    delete drawer.dataset.animating;
                    drawer.classList.add('hidden');
                    drawer.style.display = '';
                    drawer.style.maxHeight = '';
                    drawer.style.opacity = '';
                    drawer.style.overflow = '';
                    drawer.style.transition = '';
                };

                const onEnd = (e) => {
                    if (e && (e.target !== drawer || e.propertyName !== 'max-height')) return;
                    drawer.removeEventListener('transitionend', onEnd);
                    finishCollapse();
                };
                drawer.addEventListener('transitionend', onEnd);
                setTimeout(finishCollapse, 320);

                if (label) label.textContent = <%- JSON.stringify(t.moreFilters) %>;
                if (icon) icon.classList.remove('rotate-180');
                try { localStorage.setItem('dash_filters_expanded', 'false'); } catch (e) {}
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            syncExtChecklistUI();
            syncStatusChecklistUI();
            syncDashTrunkChecklistUI();
            
            const hasServerActiveSecondary = <%= hasActiveSecondary ? 'true' : 'false' %>;
            if (!hasServerActiveSecondary) {
                try {
                    const savedExpanded = localStorage.getItem('dash_filters_expanded');
                    if (savedExpanded === 'true') {
                        toggleDashboardMoreFilters(true, true);
                    }
                } catch (e) {}
            }
        });
    </script>
    <script>
        // Federation node rail. Read-only: the rail shows cached health from the
        // central node and degrades each card independently when a peer is down.
        (function() {
            const isRtl = <%= isRtl ? 'true' : 'false' %>;
            const rail = document.getElementById('federationNodeRail');
            const nodesEl = document.getElementById('fedRailNodes');
            const totalsEl = document.getElementById('fedRailTotals');
            if (!rail || !nodesEl) return;

            const labels = {
                local: isRtl ? 'محلي' : 'Local',
                online: isRtl ? 'متصل' : 'Online',
                offline: isRtl ? 'غير متصل' : 'Offline',
                degraded: isRtl ? 'محدود' : 'Degraded',
                ext: isRtl ? 'تحويلة' : 'ext',
                dongles: isRtl ? 'شرائح' : 'SIMs',
                calls: isRtl ? 'مكالمات' : 'calls',
                ms: 'ms'
            };

            function esc(value) {
                return String(value == null ? '' : value)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function statusColor(status) {
                if (status === 'online') return '#22c55e';
                if (status === 'degraded') return '#f59e0b';
                return '#ef4444';
            }

            function renderCard(node) {
                const status = node.status || 'offline';
                const color = statusColor(status);
                const statusLabel = labels[status] || status;
                const name = esc(node.nodeName || ('Site ' + node.siteCode));
                const site = esc(node.siteCode || '');
                const extTotal = Number(node.extensionsTotal || 0);
                const extOnline = Number(node.extensionsOnline || 0);
                const dongles = Number(node.donglesTotal || 0);
                const donglesFree = Number(node.donglesFree || 0);
                const calls = Number(node.activeCalls || 0);
                const latency = node.latencyMs != null ? `${node.latencyMs} ${labels.ms}` : '';
                const isLocal = Boolean(node.isLocal);

                return `
                    <div class="shrink-0 min-w-[190px] rounded-lg border px-3 py-2 bg-[var(--bg-primary)]"
                         style="border-color:${color}55">
                        <div class="flex items-center justify-between gap-2">
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full shrink-0" style="background:${color}"></span>
                                    <span class="text-xs font-extrabold text-[var(--text-primary)] truncate">${name}</span>
                                </div>
                                <div class="text-[10px] font-mono text-[var(--text-muted)] mt-0.5">
                                    ${isLocal ? labels.local : ('Site ' + site)}
                                    ${latency ? ' · ' + esc(latency) : ''}
                                </div>
                            </div>
                            <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded shrink-0"
                                  style="color:${color};background:${color}1a">${esc(statusLabel)}</span>
                        </div>
                        <div class="mt-1.5 grid grid-cols-3 gap-1 text-center">
                            <div>
                                <div class="text-[11px] font-bold font-mono text-[var(--text-primary)]">${extOnline}/${extTotal}</div>
                                <div class="text-[9px] text-[var(--text-muted)] uppercase">${labels.ext}</div>
                            </div>
                            <div>
                                <div class="text-[11px] font-bold font-mono text-[var(--text-primary)]">${donglesFree}/${dongles}</div>
                                <div class="text-[9px] text-[var(--text-muted)] uppercase">${labels.dongles}</div>
                            </div>
                            <div>
                                <div class="text-[11px] font-bold font-mono" style="color:${calls > 0 ? '#f59e0b' : 'var(--text-primary)'}">${calls}</div>
                                <div class="text-[9px] text-[var(--text-muted)] uppercase">${labels.calls}</div>
                            </div>
                        </div>
                    </div>
                `;
            }

            function render(overview) {
                const nodes = Array.isArray(overview && overview.nodes) ? overview.nodes : [];
                if (!nodes.length) {
                    rail.classList.add('hidden');
                    return;
                }
                rail.classList.remove('hidden');
                nodesEl.innerHTML = nodes.map(renderCard).join('');
                const totals = overview.totals || {};
                if (totalsEl) {
                    totalsEl.textContent =
                        `${Number(totals.extensionOnline || 0)}/${Number(totals.extensionTotal || 0)} ${labels.ext} · ` +
                        `${Number(totals.dongleFree || 0)}/${Number(totals.dongleTotal || 0)} ${labels.dongles} · ` +
                        `${Number(totals.activeCalls || 0)} ${labels.calls}`;
                }
            }

            async function refresh() {
                try {
                    const res = await fetch('/api/federation/overview', { headers: { Accept: 'application/json' } });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data && data.success) render(data);
                } catch (_) {}
            }

            refresh();
            setInterval(refresh, 10000);

            try {
                if (typeof io === 'function') {
                    const socket = io();
                    socket.on('federation:overview', render);
                }
            } catch (_) {}
        })();
    </script>
    <script>
        // Fix Flatpickr month dropdown: force select dropdown visible, handle click for showPicker()
        (function() {
            function forceMonthSelect() {
                document.querySelectorAll('.flatpickr-current-month').forEach(function(el) {
                    var sel = el.querySelector('.flatpickr-monthDropdown-months');
                    var cur = el.querySelector('.cur-month');
                    if (!sel) return;
                    if (cur) cur.style.setProperty('display', 'none', 'important');
                    sel.style.setProperty('display', 'inline-block', 'important');
                    sel.style.setProperty('pointer-events', 'auto', 'important');
                    sel.style.setProperty('cursor', 'pointer', 'important');
                    sel.style.setProperty('opacity', '1', 'important');
                });
            }
            // Force month select element display
            // Initial run + poll aggressively for 3 seconds
            forceMonthSelect();
            var pollTimer = setInterval(function() {
                forceMonthSelect();
            }, 100);
            setTimeout(function() { clearInterval(pollTimer); }, 3000);
            // Watch for new calendars
            var obs = new MutationObserver(function(muts) {
                muts.forEach(function(mut) {
                    mut.addedNodes.forEach(function(n) {
                        if (n.nodeType === 1) {
                            if (n.querySelectorAll) forceMonthSelect();
                        }
                    });
                });
            });
            obs.observe(document.body, { childList: true, subtree: true });
        })();
    </script>
</body>
</html>

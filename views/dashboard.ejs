                }] : [],
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#f4f4f5' : '#1e1e22', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#a1a1aa' : '#52525b', fontSize: 9, fontFamily: _chartFont, formatter: function(v) { return v + ' ' + _t.min; } },
                    axisLine: { show: false },
                    axisTick: { show: false }
                },
                yAxis: {
                    type: 'category',
                    data: topTalkersData.map(d => d.name.split(' (')[0]),
                    inverse: true,
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: {
                        color: isLight ? '#27272a' : '#e4e4e7',
                        fontSize: 10,
                        fontWeight: '600',
                        fontFamily: _chartFont,
                        rich: {
                            trophy: {
                                backgroundColor: {
                                    image: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23f59e0b'%3E%3Cpath d='M19 5h-2V3H7v2H5c-1.1 0-2 .9-2 2v1c0 2.55 1.92 4.63 4.39 4.94.63 1.5 1.98 2.63 3.61 2.96V19H7v2h10v-2h-4v-3.1c1.63-.33 2.98-1.46 3.61-2.96C19.08 12.63 21 10.55 21 8V7c0-1.1-.9-2-2-2zM5 8V7h2v3.82C5.84 10.4 5 9.3 5 8zm14 0c0 1.3-.84 2.4-2 2.82V7h2v1z'/%3E%3C/svg%3E"
                                },
                                width: 13,
                                height: 13,
                                align: 'center'
                            },
                            name: {
                                color: isLight ? '#27272a' : '#e4e4e7',
                                fontSize: 10,
                                fontWeight: '600',
                                fontFamily: _chartFont,
                                padding: [0, 0, 0, 3]
                            }
                        },
                        formatter: function(name, idx) {
                            return talkersCount > 0 && idx === 0 ? '{trophy|}{name|' + name + '}' : name;
                        }
                    }
                },
                series: [{
                    type: 'bar',
                    barWidth: '55%',
                    barCategoryGap: '25%',
                    showBackground: true,
                    backgroundStyle: {
                        color: isLight ? 'rgba(0,0,0,0.02)' : 'rgba(255,255,255,0.02)',
                        borderRadius: [0, 20, 20, 0]
                    },
                    itemStyle: {
                        borderRadius: [0, 20, 20, 0],
                        color: function(params) {
                            const rank = params.dataIndex / Math.max(talkersCount - 1, 1);
                            const palette = [
                                ['#dc2626', '#ef4444', '#f87171'],
                                ['#e04040', '#f06060', '#f98080'],
                                ['#c44', '#d66', '#e88'],
                                ['#a33', '#c55', '#d77']
                            ];
                            const i = Math.min(Math.floor(rank * palette.length), palette.length - 1);
                            const c = palette[i];
                            return new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                                { offset: 0, color: c[0] },
                                { offset: 0.6, color: c[1] },
                                { offset: 1, color: c[2] }
                            ]);
                        },
                        shadowColor: 'rgba(220,38,38,0.18)',
                        shadowBlur: 8,
                        shadowOffsetX: 2,
                        shadowOffsetY: 0
                    },
                    emphasis: {
                        itemStyle: {
                            shadowColor: 'rgba(220,38,38,0.35)',

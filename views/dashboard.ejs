            renderHourlyChart();
            window.addEventListener('resize', () => hourlyChart.resize());

            // -- Top Talkers --
            const talkersChart = echarts.init(talkersEl, isLight ? null : "dark");
            talkersChart.setOption({
                textStyle: {
                    fontFamily: _chartFont
                },
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    axisPointer: { type: 'shadow', shadowStyle: { color: isLight ? 'rgba(0,0,0,0.03)' : 'rgba(255,255,255,0.03)' } },
                    backgroundColor: isLight ? 'rgba(255,255,255,0.96)' : 'rgba(24,24,27,0.96)',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    borderRadius: 10,
                    padding: [10, 14],
                    textStyle: { color: isLight ? '#09090b' : '#fafafa', fontSize: 11, fontFamily: _chartFont },
                    extraCssText: 'box-shadow: 0 8px 24px rgba(0,0,0,0.16); backdrop-filter: blur(8px);',
                    formatter: function(params) {
                        const p = params[0];
                        const data = topTalkersData[p.dataIndex];
                        const mins = Math.round(data.talkSec / 60);
                        return '<span style="font-weight:700;font-size:12px;font-family:' + _chartFont + '">' + p.name + '</span><br/>'
                            + '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#ef4444;margin-right:6px"></span>'
                            + _t.talkTime + ': <b>' + mins + '</b> ' + _t.min + '<br/>'
                            + '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#71717a;margin-right:6px"></span>'
                            + _t.calls + ': <b>' + data.calls + '</b>';
                    }
                },
                grid: { left: 10, right: needsScroll ? 60 : 45, top: 10, bottom: 25, containLabel: true },
                dataZoom: needsScroll ? [{
                    type: 'slider',
                    yAxisIndex: 0,
                    right: 5,
                    width: 8,
                    startValue: 0,
                    endValue: talkersVisibleMax - 1,
                    minValueSpan: talkersVisibleMax - 1,
                    zoomLock: true,
                    brushSelect: false,
                    handleSize: '60%',
                    borderColor: 'transparent',
                    fillerColor: 'rgba(239,68,68,0.18)',
                    handleStyle: { color: '#ef4444', borderColor: '#dc2626' },
                    dataBackground: { lineStyle: { opacity: 0 }, areaStyle: { opacity: 0 } },
                    selectedDataBackground: { lineStyle: { opacity: 0 }, areaStyle: { opacity: 0 } },
                    textStyle: { color: 'transparent' }
                }, {
                    type: 'inside',
                    yAxisIndex: 0,
                    orient: 'vertical',
                    zoomLock: true,
                    zoomOnMouseWheel: false,
                    moveOnMouseWheel: true,
                    moveOnMouseMove: false,

                    </div>
                </div>
                <div class="p-2 sm:px-2 sm:py-2 flex-1 flex flex-col w-full h-full">
                    <div id="topTalkersChart" class="w-full flex-1 min-h-[280px] h-full" style="height: 100%; min-height: 280px;"></div>
                </div>
            </div>
        </div>

        <!-- Section 5: Proportional Breakdown Row (3 Donuts) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6 shrink-0">
            <!-- Donut 1: Call Disposition -->
            <div class="rounded-2xl flex flex-col bg-transparent border-0 border-none shadow-none">
                <div class="px-2 py-3 bg-transparent border-none flex items-center justify-between">
                    <div class="flex items-center">
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartDisposition %></h2>
                    </div>
                </div>
                <div class="p-2 sm:px-2 sm:py-2 flex-1 flex flex-col w-full h-full">
                    <div id="dispositionChart" class="w-full flex-1 min-h-[280px] h-full" style="height: 100%; min-height: 280px;"></div>
                </div>
            </div>

            <!-- Donut 2: Call Duration -->
            <div class="rounded-2xl flex flex-col bg-transparent border-0 border-none shadow-none">
                <div class="px-2 py-3 bg-transparent border-none flex items-center justify-between">
                    <div class="flex items-center">
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartDuration %></h2>
                    </div>
                </div>
                <div class="p-2 sm:px-2 sm:py-2 flex-1 flex flex-col w-full h-full">
                    <div id="durationChart" class="w-full flex-1 min-h-[280px] h-full" style="height: 100%; min-height: 280px;"></div>
                </div>
            </div>

            <!-- Donut 3: Call Scope Breakdown -->
            <div class="rounded-2xl flex flex-col bg-transparent border-0 border-none shadow-none">
                <div class="px-2 py-3 bg-transparent border-none flex items-center justify-between">
                    <div class="flex items-center">
                        <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartScope %></h2>
                    </div>
                </div>
                <div class="p-2 sm:px-2 sm:py-2 flex-1 flex flex-col w-full h-full">
                    <div id="scopeChart" class="w-full flex-1 min-h-[280px] h-full" style="height: 100%; min-height: 280px;"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const trendData = <%- (typeof trendData !== 'undefined' && trendData) ? trendData : '[]' %>;
        const dispositionData = <%- (typeof dispositionData !== 'undefined' && dispositionData) ? dispositionData : '[]' %>;
        const hourlyData = <%- (typeof hourlyData !== 'undefined' && hourlyData) ? hourlyData : '[]' %>;
        const hourlyByDayData = <%- (typeof hourlyByDay !== 'undefined' && hourlyByDay) ? hourlyByDay : '{}' %>;
        const topTalkersData = <%- (typeof topTalkers !== 'undefined' && topTalkers) ? topTalkers : '[]' %>;
        const durationData = <%- (typeof durationData !== 'undefined' && durationData) ? durationData : '[]' %>;
        const scopeData = <%- (typeof scopeData !== 'undefined' && scopeData) ? scopeData : '[]' %>;
        const _isRtl = <%= (typeof isRtl !== 'undefined' && isRtl) ? 'true' : 'false' %>;
        const _t = {
            talkTime: '<%= t.talkTime %>',
            min: '<%= t.min %>',
            calls: '<%= t.calls %>',
            total: '<%= isRtl ? "الإجمالي" : "Total" %>',
            inbound: '<%= t.inbound %>',
            outbound: '<%= t.outbound %>',
            saving: '<%= t.saving %>',
            saved: '<%= t.saved %>',
            addedToast: '<%= t.addedToast %>',
            failedSave: '<%= t.failedSave %>',
            errorSave: '<%= t.errorSave %>',
            uploadingCsv: '<%= t.uploadingCsv %>',
            imported: '<%= t.imported %>',
            importedToast: '<%= t.importedToast %>',
            failedImport: '<%= t.failedImport %>',
            errorImport: '<%= t.errorImport %>'
        };
        const _dispTranslations = {
            'ANSWERED': '<%= isRtl ? "تم الرد" : "ANSWERED" %>',
            'BUSY': '<%= isRtl ? "مشغول" : "BUSY" %>',
            'NO ANSWER': '<%= isRtl ? "لم يتم الرد" : "NO ANSWER" %>',
            'FAILED': '<%= isRtl ? "فاشلة" : "FAILED" %>',
            'CONGESTION': '<%= isRtl ? "ازدحام" : "CONGESTION" %>',
            'UNKNOWN': '<%= isRtl ? "غير معروف" : "UNKNOWN" %>'
        };
        const _durTranslations = {
            'Short (<30s)': '<%= isRtl ? "قصيرة (أقل من 30 ث)" : "Short (< 30s)" %>',
            'Medium (30s-3m)': '<%= isRtl ? "متوسطة (30 ث - 3 د)" : "Medium (30s - 3m)" %>',
            'Long (>3m)': '<%= isRtl ? "طويلة (أكثر من 3 د)" : "Long (> 3m)" %>'
        };
        const _scopeTranslations = {
            'Internal': '<%= isRtl ? "داخلي" : "Internal" %>',
            'External': '<%= isRtl ? "خارجي" : "External" %>'
        };

        document.addEventListener('DOMContentLoaded', () => {
            if (typeof window.updateClock === 'function') window.updateClock();
            if (typeof anime !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                anime({
                    targets: '.card-stat, .hero-stat-card',
                    opacity: [0, 1],
                    translateY: [15, 0],
                    delay: anime.stagger(50),
                    duration: 450,
                    easing: 'easeOutCubic'
                });
            }

            /* Premium stat card hover: cursor-tracking spotlight.
               One delegated pointermove listener feeds --glow-x / --glow-y to the
               hovered card. rAF-throttled so it never blocks the main thread. */
            (function initStatCardSpotlight() {
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                let activeCard = null;
                let latest = null;
                let rafId = null;

                const applyGlow = () => {
                    rafId = null;
                    if (!activeCard || !latest) return;
                    const rect = activeCard.getBoundingClientRect();
                    if (!rect.width || !rect.height) return;
                    const x = ((latest.clientX - rect.left) / rect.width) * 100;
                    const y = ((latest.clientY - rect.top) / rect.height) * 100;
                    activeCard.style.setProperty('--glow-x', x.toFixed(2) + '%');
                    activeCard.style.setProperty('--glow-y', y.toFixed(2) + '%');
                };

                document.addEventListener('pointermove', (e) => {
                    const card = e.target && e.target.closest ? e.target.closest('.hero-stat-card') : null;
                    if (!card) return;
                    if (card !== activeCard) activeCard = card;
                    latest = e;
                    if (rafId) return;
                    rafId = requestAnimationFrame(applyGlow);
                }, { passive: true });

                // Keep the glow anchored to the card when the pointer leaves the window.
                document.addEventListener('pointerout', (e) => {
                    if (!e.relatedTarget) {
                        latest = null;
                    }
                }, { passive: true });
            })();

            const isLight = document.documentElement.classList.contains('light-theme');
            const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim() || '#dc2626';
            const _chartFont = _isRtl ? "'Cairo', 'JetBrains Mono', sans-serif" : "'JetBrains Mono', 'Cairo', monospace";

            // -- Call Volume Trend --
            const trendChart = echarts.init(document.getElementById('trendChart'), isLight ? null : 'dark');
            trendChart.setOption({
                textStyle: {
                    fontFamily: _chartFont
                },
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11, fontFamily: _chartFont }
                },
                legend: {
                    bottom: 0,
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold', fontFamily: _chartFont }
                },
                grid: { left: 40, right: 20, top: 20, bottom: 50 },
                xAxis: {
                    type: 'category',
                    data: trendData.map(d => d.date.slice(5)),
                    axisLine: { lineStyle: { color: '#27272a' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9, fontWeight: 'bold', fontFamily: _chartFont }
                },
                yAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9, fontFamily: _chartFont }
                },
                series: [
                    {
                        name: _t.total,
                        type: 'line',
                        smooth: true,
                        symbol: 'circle',
                        symbolSize: 6,
                        lineStyle: { width: 2.5, color: accent },
                        areaStyle: {
                            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                { offset: 0, color: accent + '60' },
                                { offset: 1, color: accent + '05' }
                            ])
                        },
                        itemStyle: { color: accent },
                        data: trendData.map(d => d.total)
                    },
                    {
                        name: _t.inbound,
                        type: 'bar',
                        barWidth: 6,
                        barGap: '20%',
                        itemStyle: { color: accent, borderRadius: [3, 3, 0, 0] },
                        data: trendData.map(d => d.inbound)
                    },
                    {
                        name: _t.outbound,
                        type: 'bar',
                        barWidth: 6,
                        barGap: '20%',
                        itemStyle: { color: '#00b4d8', borderRadius: [3, 3, 0, 0] },
                        data: trendData.map(d => d.outbound)
                    }
                ]
            });
            window.addEventListener('resize', () => trendChart.resize());

            // -- Disposition Breakdown --
            const accentColor = accent;
            const dispPalette = {
                'ANSWERED': accentColor,
                'BUSY': '#fbbf24',
                'NO ANSWER': '#2dd4bf',
                'FAILED': '#a855f7',
                'CONGESTION': '#f97316',
                'UNKNOWN': '#71717a'
            };
            const dispChart = echarts.init(document.getElementById('dispositionChart'), isLight ? null : 'dark');
            dispChart.setOption({
                textStyle: {
                    fontFamily: _chartFont
                },
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'item',
                    formatter: function(params) { return params.name + ': ' + params.value + ' ' + _t.calls + ' (' + params.percent + '%)'; },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11, fontFamily: _chartFont }
                },
                legend: {
                    bottom: 0,
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold', fontFamily: _chartFont }
                },
                series: [{
                    type: 'pie',
                    radius: ['38%', '75%'],
                    center: ['50%', '50%'],
                    roseType: 'area',
                    itemStyle: {
                        borderRadius: 6,
                        borderColor: isLight ? '#ffffff' : '#121212',
                        borderWidth: 2.5
                    },
                    label: {
                        show: true,
                        formatter: '{b}\n{d}%',
                        fontSize: 10,
                        fontWeight: 'bold',
                        fontFamily: _chartFont,
                        color: isLight ? '#27272a' : '#d4d4d8'
                    },
                    data: dispositionData.map(d => ({
                        value: d.value,
                        name: _dispTranslations[d.name] || d.name,
                        itemStyle: { color: dispPalette[d.name] || '#71717a' }
                    })),
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => dispChart.resize());

            // -- Hourly / Daily Call Distribution --
            // -- Synchronize Operations Row Chart Dimensions --
            const hourlyEl = document.getElementById("hourlyChart");
            const talkersEl = document.getElementById("topTalkersChart");
            const talkersCount = (typeof topTalkersData !== "undefined" && topTalkersData) ? topTalkersData.length : 0;
            const talkersVisibleMax = 8;
            const needsScroll = talkersCount > talkersVisibleMax;
            const opsChartsHeight = needsScroll ? "320px" : "280px";
            if (hourlyEl) hourlyEl.style.height = opsChartsHeight;
            if (talkersEl) talkersEl.style.height = opsChartsHeight;

            // -- Hourly / Daily Call Distribution --
            const hourlyChart = echarts.init(hourlyEl, isLight ? null : "dark");

            const _dashStartDate = '<%= filters.startDate %>';
            const _dashEndDate = '<%= filters.endDate %>';
            const _filterHours = (typeof moment !== 'undefined') ? Math.max(1, moment(_dashEndDate).diff(moment(_dashStartDate), 'hours')) : 24;
            const _filterDaysCalc = (typeof moment !== 'undefined') ? Math.max(1, Math.ceil(moment(_dashEndDate).diff(moment(_dashStartDate), 'days', true))) : 1;
            const _availableDays = Object.keys(hourlyByDayData || {}).sort();
            const _trendDaysCount = (trendData || []).filter(d => (d.total || 0) > 0).length || _availableDays.length || (trendData || []).length || 1;
            const _effectiveDays = Math.max(_trendDaysCount, _filterDaysCalc, _availableDays.length);
            const _isMultiDay = _effectiveDays > 1 && _availableDays.length > 1;

            let currentDistMode = 'hours';
            let selectedSpecificDay = 'all';

            function formatDayLabel(rawDate) {
                if (!rawDate) return '';
                if (typeof moment !== 'undefined') {
                    const fullDate = rawDate.length === 5 ? (moment().year() + '-' + rawDate) : rawDate;
                    const m = moment(fullDate);
                    if (m.isValid()) {
                        return _isRtl ? m.format('D MMM') : m.format('MMM D');
                    }
                }
                return rawDate;
            }

            function formatFullDayName(rawDate) {
                if (!rawDate) return '';
                if (typeof moment !== 'undefined') {
                    const m = moment(rawDate);
                    if (m.isValid()) {
                        return _isRtl ? m.format('dddd، D MMMM YYYY') : m.format('dddd, MMMM D, YYYY');
                    }
                }
                return rawDate;
            }

            // Populate the day selector dropdown if multiple days exist
            const daySelectEl = document.getElementById('hourlyDaySelect');
            const daySelectContainer = document.getElementById('hourlyDaySelectContainer');
            if (daySelectEl && _isMultiDay) {
                daySelectEl.classList.remove('hidden');
                if (daySelectContainer) daySelectContainer.classList.remove('hidden');
                daySelectEl.innerHTML = '';

                const optAll = document.createElement('option');
                optAll.value = 'all';
                optAll.textContent = _isRtl ? 'جميع الأيام (تجميعي)' : 'All Days (Aggregated)';
                daySelectEl.appendChild(optAll);

                _availableDays.forEach(dayStr => {
                    const opt = document.createElement('option');
                    opt.value = dayStr;
                    opt.textContent = formatDayLabel(dayStr);
                    daySelectEl.appendChild(opt);
                });
            }

            window.onHourlyDaySelect = function(val) {
                selectedSpecificDay = val;
                if (val !== 'all') {
                    currentDistMode = 'hours';
                    updateDistButtons();
                }
                renderHourlyChart();
            };

            window.setDistributionMode = function(mode) {
                currentDistMode = mode;
                if (mode === 'days') {
                    selectedSpecificDay = 'all';
                    if (daySelectEl) daySelectEl.value = 'all';
                }
                updateDistButtons();
                renderHourlyChart();
            };

            function updateDistButtons() {
                const btnH = document.getElementById('btn-dist-hours');
                const btnD = document.getElementById('btn-dist-days');
                const activeCls = 'px-2.5 py-1 rounded-md text-xs font-bold transition cursor-pointer btn-primary whitespace-nowrap';
                const inactiveCls = 'px-2.5 py-1 rounded-md text-xs font-bold transition cursor-pointer text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-hover)] whitespace-nowrap';
                if (btnH && btnD) {
                    btnH.className = currentDistMode === 'hours' ? activeCls : inactiveCls;
                    btnD.className = currentDistMode === 'days' ? activeCls : inactiveCls;
                }
            }

            function renderHourlyChart() {
                const titleEl = document.getElementById('hourlyChartTitle');

                // Locked, unified grid margins for zero layout shifts
                const commonGrid = { left: 0, right: 0, top: 10, bottom: 6, containLabel: true };

                if (currentDistMode === 'days') {
                    // Daily Distribution Mode
                    if (titleEl) titleEl.textContent = _isRtl ? 'توزيع المكالمات بالأيام' : 'Daily Call Distribution';

                    const rawDates = (trendData || []).map(d => d.date ? d.date.slice(5) : '');
                    const dayLabels = rawDates.map(d => formatDayLabel(d));
                    const dayValues = (trendData || []).map(d => d.total || 0);
                    const maxDayVal = Math.max(...dayValues, 0);
                    const peakDayIndex = dayValues.indexOf(maxDayVal);

                    hourlyChart.setOption({
                        textStyle: {
                            fontFamily: _chartFont
                        },
                        backgroundColor: 'transparent',
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'shadow',
                                shadowStyle: { color: isLight ? 'rgba(0,0,0,0.04)' : 'rgba(255,255,255,0.04)' }
                            },
                            backgroundColor: isLight ? '#ffffff' : '#18181b',
                            borderColor: isLight ? '#e4e4e7' : '#27272a',
                            borderWidth: 1,
                            padding: [8, 12],
                            textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11, fontFamily: _chartFont },
                            formatter: function(params) {
                                const p = params[0];
                                const d = (trendData || [])[p.dataIndex] || {};
                                const isPeak = p.value === maxDayVal && maxDayVal > 0;
                                return `
                                    <div class="font-bold text-xs text-white mb-1.5 flex items-center gap-1.5">
                                        <span><svg style="display:inline-block;vertical-align:middle;width:12px;height:12px;margin-right:2px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> ${dayLabels[p.dataIndex] || d.date || p.name}</span>
                                        ${isPeak ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30 ${_isRtl ? 'font-sans' : 'font-mono'}">${_isRtl ? 'الذروة' : 'Peak'}</span>` : ''}
                                    </div>
                                    <div class="text-xs text-zinc-300 font-semibold space-y-1">
                                        <div class="flex justify-between gap-4"><span>${_t.total}:</span><b class="text-white">${p.value}</b></div>
                                        <div class="flex justify-between gap-4 text-emerald-400"><span>${_t.inbound}:</span><b>${d.inbound || 0}</b></div>
                                        <div class="flex justify-between gap-4 text-sky-400"><span>${_t.outbound}:</span><b>${d.outbound || 0}</b></div>
                                    </div>
                                    <div class="text-[10px] text-zinc-500 mt-1 italic">${_isRtl ? 'انقر لعرض تفاصيل ساعات هذا اليوم' : 'Click bar to view this day\'s hourly breakdown'}</div>
                                `;
                            }
                        },
                        grid: commonGrid,
                        xAxis: {
                            type: 'category',
                            data: dayLabels,
                            axisLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a' } },
                            axisTick: { show: false },
                            axisLabel: {
                                color: isLight ? '#52525b' : '#a1a1aa',
                                fontSize: 10,
                                fontWeight: 'bold',
                                fontFamily: _chartFont,
                                interval: (dayLabels.length > 12) ? Math.ceil(dayLabels.length / 10) : 0,
                                rotate: (dayLabels.length > 14) ? 25 : 0
                            }
                        },
                        yAxis: {
                            type: 'value',
                            splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                            axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9, fontFamily: _chartFont }
                        },
                        series: [{
                            name: _t.calls,
                            type: 'bar',
                            barMaxWidth: (dayLabels.length <= 4) ? 80 : 44,
                            barWidth: (dayLabels.length > 14) ? '70%' : '55%',
                            itemStyle: {
                                borderRadius: [6, 6, 0, 0],
                                color: function(params) {
                                    if (params.value === maxDayVal && maxDayVal > 0) {
                                        return new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                            { offset: 0, color: '#f59e0b' },
                                            { offset: 1, color: '#b45309' }
                                        ]);
                                    }
                                    return new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                        { offset: 0, color: accent },
                                        { offset: 1, color: accent + '30' }
                                    ]);
                                }
                            },
                            data: dayValues,
                            animationEasing: 'cubicOut',
                            animationDuration: 400
                        }]
                    }, true);

                } else {
                    // Hourly Distribution Mode (24 Hours)
                    const isSingleSpecificDay = selectedSpecificDay !== 'all' && Boolean(hourlyByDayData[selectedSpecificDay]);
                    const activeHoursList = isSingleSpecificDay ? hourlyByDayData[selectedSpecificDay] : (hourlyData || []);

                    if (titleEl) titleEl.textContent = _isRtl ? 'توزيع المكالمات بالساعة' : 'Hourly Call Distribution';

                    const hourVals = (activeHoursList || []).map(d => d.calls || 0);
                    const maxHourVal = Math.max(...hourVals, 0);
                    const peakHourIndex = hourVals.indexOf(maxHourVal);

                    hourlyChart.setOption({
                        textStyle: {
                            fontFamily: _chartFont
                        },
                        backgroundColor: 'transparent',
                        tooltip: {
                            trigger: 'axis',
                            axisPointer: {
                                type: 'shadow',
                                shadowStyle: { color: isLight ? 'rgba(0,0,0,0.04)' : 'rgba(255,255,255,0.04)' }
                            },
                            backgroundColor: isLight ? '#ffffff' : '#18181b',
                            borderColor: isLight ? '#e4e4e7' : '#27272a',
                            borderWidth: 1,
                            padding: [8, 12],
                            textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11, fontFamily: _chartFont },
                            formatter: function(params) {
                                const p = params[0];
                                const h = parseInt(p.name, 10);
                                const nextH = (h + 1) % 24;
                                const timeRange = `${String(h).padStart(2, '0')}:00 - ${String(nextH).padStart(2, '0')}:00`;
                                const isPeak = p.value === maxHourVal && maxHourVal > 0;
                                const dayContext = isSingleSpecificDay 
                                    ? `<div class="text-[11px] text-sky-400 font-mono mb-1"><svg style="display:inline-block;vertical-align:middle;width:11px;height:11px;margin-right:2px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> ${formatDayLabel(selectedSpecificDay)}</div>` 
                                    : (_isMultiDay ? `<div class="text-[11px] text-zinc-400 mt-1 flex justify-between gap-4"><span>${_isRtl ? 'المعدل اليومي' : 'Daily Avg'}:</span><b class="text-amber-400">${(p.value / _effectiveDays).toFixed(1)} ${_t.calls}/${_isRtl ? 'يوم' : 'day'}</b></div>` : '');
                                return `
                                    <div class="font-bold text-xs text-white mb-1 flex items-center gap-1.5">
                                        <span><svg style="display:inline-block;vertical-align:middle;width:12px;height:12px;margin-right:2px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> ${timeRange}</span>
                                        ${isPeak ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30 ${_isRtl ? 'font-sans' : 'font-mono'}">${_isRtl ? '<svg style="display:inline-block;vertical-align:middle;width:10px;height:10px;margin-left:2px" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg> ساعة الذروة' : '<svg style="display:inline-block;vertical-align:middle;width:10px;height:10px;margin-right:2px" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5.67s.74 2.65.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg> Peak Hour'}</span>` : ''}
                                    </div>
                                    ${isSingleSpecificDay ? dayContext : ''}
                                    <div class="text-xs text-zinc-300 font-semibold flex justify-between gap-4">
                                        <span>${_isRtl ? 'المكالمات' : 'Calls'}:</span>
                                        <b class="text-white">${p.value} ${_t.calls}</b>
                                    </div>
                                    ${!isSingleSpecificDay ? dayContext : ''}
                                `;
                            }
                        },
                        grid: commonGrid,
                        xAxis: {
                            type: 'category',
                            data: (activeHoursList || []).map(d => d.hour),
                            axisLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a' } },
                            axisTick: { show: false },
                            axisLabel: {
                                color: isLight ? '#52525b' : '#a1a1aa',
                                fontSize: 10,

                tooltip: { 
                    trigger: 'axis',
                    axisPointer: { type: 'shadow' },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 },
                    formatter: function(params) {
                        const p = params[0];
                        const pct = Math.round((p.value / totalScopeVal) * 100);
                        return p.name + ': ' + p.value + ' ' + _t.calls + ' (' + pct + '%)';
                    }
                },
                grid: { left: 90, right: 60, top: 25, bottom: 25, containLabel: true },
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9 }
                },
                yAxis: {
                    type: 'category',
                    data: scopeData.map(d => _scopeTranslations[d.name] || d.name),
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: { color: isLight ? '#27272a' : '#ffffff', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    name: 'Calls',
                    type: 'bar',
                    barWidth: '45%',
                    itemStyle: {
                        borderRadius: [0, 6, 6, 0]
                    },
                    data: scopeData.map(d => ({
                        value: d.value,
                        name: _scopeTranslations[d.name] || d.name,
                        itemStyle: { color: scopeColors[d.name] || '#64748b' }
                    })),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const pct = Math.round((params.value / totalScopeVal) * 100);
                            return params.value + ' (' + pct + '%)';
                        },
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#52525b' : '#a1a1aa'
                    },
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => scopeChart.resize());

            // Initialize Flatpickr on datetime inputs
            flatpickr('input[type="datetime-local"]', {
                enableTime: true,
                dateFormat: "Y-m-d\\TH:i",
                altInput: true,
                altFormat: "m/d/Y h:i K",
                time_24hr: false,
                allowInput: true,
                scrollInputIntoView: false,
                appendTo: document.body,
                monthSelectorType: "dropdown",
                onReady: function(selectedDates, dateStr, instance) {
                    if (instance.altInput) {
                        var origId = instance.input.id || (instance.input.name ? instance.input.name + 'Input' : 'datePicker_' + Math.random().toString(36).substring(2, 7));
                        if (origId.endsWith('_raw')) origId = origId.replace(/_raw$/, '');
                        instance.input.id = origId + '_raw';
                        instance.altInput.id = origId;
                        instance.altInput.name = (instance.input.name || origId) + '_display';
                        instance.altInput.setAttribute('autocomplete', 'off');
                        var ariaLabel = instance.input.getAttribute('aria-label') || instance.input.name || origId;
                        instance.altInput.setAttribute('aria-label', ariaLabel);
                    }
                }
            });
        });
    </script>
    <script>
        function toggleChecklistMenu(menuId, event) {
            if (event) event.stopPropagation();
            const menu = document.getElementById(menuId);
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden');
            document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            if (isHidden) menu.classList.remove('hidden');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.checklist-menu') && !e.target.closest('button[onclick*="toggleChecklistMenu"]')) {
                document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            }
        });

        function syncExtChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-ext-chk'));
            const select = document.getElementById('dashTargetExtensionSelect');
            const labelSpan = document.getElementById('dashExtChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allExt) %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onExtChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-ext-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncExtChecklistUI();
        }

        function syncStatusChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-status-chk'));
            const select = document.getElementById('dashStatusFilterSelect');
            const labelSpan = document.getElementById('dashStatusChecklistLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(t.allDisp) %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onStatusChecklistChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-status-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncStatusChecklistUI();
        }

        function toggleDashboardMoreFilters(forcedState) {
            const drawer = document.getElementById('dashSecondaryFilters');
            const label = document.getElementById('dashToggleMoreLabel');
            const icon = document.getElementById('dashToggleMoreIcon');
            if (!drawer) return;

            const isCurrentlyHidden = drawer.classList.contains('hidden');
            const expand = (typeof forcedState === 'boolean') ? forcedState : isCurrentlyHidden;

            if (expand) {
                drawer.classList.remove('hidden');
                if (label) label.textContent = <%- JSON.stringify(t.lessFilters) %>;
                if (icon) icon.classList.add('rotate-180');
                try { localStorage.setItem('dash_filters_expanded', 'true'); } catch (e) {}
            } else {
                drawer.classList.add('hidden');
                if (label) label.textContent = <%- JSON.stringify(t.moreFilters) %>;
                if (icon) icon.classList.remove('rotate-180');
                try { localStorage.setItem('dash_filters_expanded', 'false'); } catch (e) {}
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            syncExtChecklistUI();
            syncStatusChecklistUI();
            
            const hasServerActiveSecondary = <%= hasActiveSecondary ? 'true' : 'false' %>;
            if (!hasServerActiveSecondary) {
                try {
                    const savedExpanded = localStorage.getItem('dash_filters_expanded');
                    if (savedExpanded === 'true') {
                        toggleDashboardMoreFilters(true);
                    }
                } catch (e) {}
            }
        });
    </script>
    <script>
        // Fix Flatpickr month dropdown: force select dropdown visible, handle click for showPicker()
        (function() {
            function forceMonthSelect() {
                document.querySelectorAll('.flatpickr-current-month').forEach(function(el) {
                    var sel = el.querySelector('.flatpickr-monthDropdown-months');
                    var cur = el.querySelector('.cur-month');
                    if (!sel) return;
                    if (cur) cur.style.setProperty('display', 'none', 'important');
                    sel.style.setProperty('display', 'inline-block', 'important');
                    sel.style.setProperty('pointer-events', 'auto', 'important');
                    sel.style.setProperty('cursor', 'pointer', 'important');
                    sel.style.setProperty('opacity', '1', 'important');
                });
            }
            // Force month select element display
            // Initial run + poll aggressively for 3 seconds
            forceMonthSelect();
            var pollTimer = setInterval(function() {
                forceMonthSelect();
            }, 100);
            setTimeout(function() { clearInterval(pollTimer); }, 3000);
            // Watch for new calendars
            var obs = new MutationObserver(function(muts) {
                muts.forEach(function(mut) {
                    mut.addedNodes.forEach(function(n) {
                        if (n.nodeType === 1) {
                            if (n.querySelectorAll) forceMonthSelect();
                        }
                    });
                });
            });
            obs.observe(document.body, { childList: true, subtree: true });
        })();
    </script>
</body>
</html>

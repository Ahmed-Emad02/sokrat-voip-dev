            <div class="panel-surface border border-[#27272a]/30 rounded-2xl shadow-xl">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20">
                    <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartHourly %></h2>
                </div>
                <div class="p-4">
                    <div id="hourlyChart" class="w-full h-64"></div>
                </div>
            </div>
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl shadow-xl">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20">
                    <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartTopTalkers %></h2>
                </div>
                <div class="p-4">
                    <div id="topTalkersChart" class="w-full h-64"></div>
                </div>
            </div>
        </div>

        <!-- Charts Row 3: Call Duration Breakdown + Call Scope Breakdown -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6 shrink-0">
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl shadow-xl">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20">
                    <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= isRtl ? 'تصنيف مدة المكالمات' : 'Call Duration Breakdown' %></h2>
                </div>
                <div class="p-4">
                    <div id="durationChart" class="w-full h-64 min-h-[256px]"></div>
                </div>
            </div>
            <div class="panel-surface border border-[#27272a]/30 rounded-2xl shadow-xl">
                <div class="px-5 py-4 border-b border-[#27272a] bg-black/20">
                    <h2 class="text-sm font-bold text-white uppercase tracking-wider"><%= t.chartScope %></h2>
                </div>
                <div class="p-4">
                    <div id="scopeChart" class="w-full h-64 min-h-[256px]"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const trendData = <%- (typeof trendData !== 'undefined' && trendData) ? trendData : '[]' %>;
        const dispositionData = <%- (typeof dispositionData !== 'undefined' && dispositionData) ? dispositionData : '[]' %>;
        const hourlyData = <%- (typeof hourlyData !== 'undefined' && hourlyData) ? hourlyData : '[]' %>;
        const topTalkersData = <%- (typeof topTalkers !== 'undefined' && topTalkers) ? topTalkers : '[]' %>;
        const durationData = <%- (typeof durationData !== 'undefined' && durationData) ? durationData : '[]' %>;
        const scopeData = <%- (typeof scopeData !== 'undefined' && scopeData) ? scopeData : '[]' %>;
        const _isRtl = <%= (typeof isRtl !== 'undefined' && isRtl) ? 'true' : 'false' %>;
        const _t = {
            talkTime: '<%= t.talkTime %>',
            min: '<%= t.min %>',
            calls: '<%= t.calls %>',
            saving: '<%= t.saving %>',
            saved: '<%= t.saved %>',
            addedToast: '<%= t.addedToast %>',
            failedSave: '<%= t.failedSave %>',
            errorSave: '<%= t.errorSave %>',
            uploadingCsv: '<%= t.uploadingCsv %>',
            imported: '<%= t.imported %>',
            importedToast: '<%= t.importedToast %>',
            failedImport: '<%= t.failedImport %>',
            errorImport: '<%= t.errorImport %>'
        };

        document.addEventListener('DOMContentLoaded', () => {
            const clockEl = document.getElementById('digitalClock');
            if (clockEl) { setInterval(() => { clockEl.textContent = new Date().toTimeString().split(' ')[0]; }, 1000); }
            if (typeof anime !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                anime({
                    targets: '.card-stat',
                    opacity: [0, 1],
                    translateY: [15, 0],
                    delay: anime.stagger(50),
                    duration: 450,
                    easing: 'easeOutCubic'
                });
            }

            const isLight = document.documentElement.classList.contains('light-theme');
            const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent-color').trim() || '#dc2626';

            // -- Call Volume Trend --
            const trendChart = echarts.init(document.getElementById('trendChart'), isLight ? null : 'dark');
            trendChart.setOption({
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                legend: {
                    bottom: 0,
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold' }
                },
                grid: { left: 40, right: 20, top: 20, bottom: 50 },
                xAxis: {
                    type: 'category',
                    data: trendData.map(d => d.date.slice(5)),
                    axisLine: { lineStyle: { color: '#27272a' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9, fontWeight: 'bold' }
                },
                yAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9 }
                },
                series: [
                    {
                        name: 'Total',
                        type: 'line',
                        smooth: true,
                        symbol: 'circle',
                        symbolSize: 6,
                        lineStyle: { width: 2.5, color: accent },
                        areaStyle: {
                            color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                                { offset: 0, color: accent + '60' },
                                { offset: 1, color: accent + '05' }
                            ])
                        },
                        itemStyle: { color: accent },
                        data: trendData.map(d => d.total)
                    },
                    {
                        name: 'Inbound',
                        type: 'bar',
                        barWidth: 6,
                        barGap: '20%',
                        itemStyle: { color: accent, borderRadius: [3, 3, 0, 0] },
                        data: trendData.map(d => d.inbound)
                    },
                    {
                        name: 'Outbound',
                        type: 'bar',
                        barWidth: 6,
                        itemStyle: { color: '#00b4d8', borderRadius: [3, 3, 0, 0] },
                        data: trendData.map(d => d.outbound)
                    }
                ]
            });
            window.addEventListener('resize', () => trendChart.resize());

            // -- Disposition Breakdown --
            const accentColor = accent;
            const dispPalette = {
                'ANSWERED': accentColor,
                'BUSY': '#fbbf24',
                'NO ANSWER': '#2dd4bf',
                'FAILED': '#a855f7',
                'CONGESTION': '#f97316',
                'UNKNOWN': '#71717a'
            };
            const dispChart = echarts.init(document.getElementById('dispositionChart'), isLight ? null : 'dark');
            dispChart.setOption({
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'item',
                    formatter: function(params) { return params.name + ': ' + params.value + ' ' + _t.calls + ' (' + params.percent + '%)'; },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                legend: {
                    bottom: 0,
                    textStyle: { color: isLight ? '#27272a' : '#a1a1aa', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    type: 'pie',
                    radius: ['35%', '65%'],
                    center: ['50%', '45%'],
                    roseType: 'area',
                    itemStyle: {
                        borderRadius: 6,
                        borderColor: isLight ? '#ffffff' : '#121212',
                        borderWidth: 2.5,
                        shadowBlur: 20,
                        shadowColor: 'rgba(0, 0, 0, 0.25)'
                    },
                    label: {
                        show: true,
                        formatter: '{b}\n{d}%',
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#27272a' : '#d4d4d8'
                    },
                    data: dispositionData.map(d => ({
                        value: d.value,
                        name: d.name,
                        itemStyle: { color: dispPalette[d.name] || '#71717a' }
                    })),
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => dispChart.resize());

            // -- Hourly Distribution --
            const hourlyChart = echarts.init(document.getElementById('hourlyChart'), isLight ? null : 'dark');
            hourlyChart.setOption({
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 }
                },
                grid: { left: 40, right: 20, top: 20, bottom: 30 },
                xAxis: {
                    type: 'category',
                    data: hourlyData.map(d => d.hour),
                    axisLine: { lineStyle: { color: '#27272a' } },
                    axisLabel: { color: isLight ? '#52525b' : '#a1a1aa', fontSize: 9, fontWeight: 'bold' }
                },
                yAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9 }
                },
                series: [{
                    type: 'bar',
                    barWidth: '70%',
                    itemStyle: {
                        color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [
                            { offset: 0, color: accent },
                            { offset: 1, color: accent + '40' }
                        ]),
                        borderRadius: [4, 4, 0, 0]
                    },
                    data: hourlyData.map(d => d.calls),
                    animationEasing: 'cubicOut',
                    animationDuration: 500
                }]
            });
            window.addEventListener('resize', () => hourlyChart.resize());

            // -- Top Talkers --
            const talkersChart = echarts.init(document.getElementById('topTalkersChart'), isLight ? null : 'dark');
            talkersChart.setOption({
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    axisPointer: { type: 'shadow' },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 },
                    formatter: function(params) {
                        const p = params[0];
                        const data = topTalkersData[p.dataIndex];
                        return p.name + '<br/>' + _t.talkTime + ': ' + Math.round(data.talkSec / 60) + ' ' + _t.min + '<br/>' + _t.calls + ': ' + data.calls;
                    }
                },
                grid: { left: 120, right: 40, top: 10, bottom: 30 },
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9, formatter: function(v) { return v + ' ' + _t.min; } }
                },
                yAxis: {
                    type: 'category',
                    data: topTalkersData.map(d => d.name.split(' (')[0]),
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: { color: isLight ? '#27272a' : '#ffffff', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    type: 'bar',
                    barWidth: '60%',
                    itemStyle: {
                        color: new echarts.graphic.LinearGradient(0, 0, 1, 0, [
                            { offset: 0, color: accent },
                            { offset: 1, color: '#00b4d8' }
                        ]),
                        borderRadius: [0, 4, 4, 0]
                    },
                    data: topTalkersData.map(d => Math.round(d.talkSec / 60)),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const data = topTalkersData[params.dataIndex];
                            return data.calls + ' ' + _t.calls;
                        },
                        fontSize: 9,
                        fontWeight: 'bold',
                        color: isLight ? '#52525b' : '#a1a1aa'
                    },
                    animationEasing: 'cubicOut',
                    animationDuration: 600
                }]
            });
            window.addEventListener('resize', () => talkersChart.resize());

            // -- Call Duration Breakdown --
            const durationChart = echarts.init(document.getElementById('durationChart'), isLight ? null : 'dark');
            const durationColors = {
                'Short (<30s)': '#38bdf8',
                'Medium (30s-3m)': '#f59e0b',
                'Long (>3m)': '#e11d48'
            };
            const totalDurVal = durationData.reduce((acc, curr) => acc + (curr.value || 0), 0) || 1;

            durationChart.setOption({
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'axis',
                    axisPointer: { type: 'shadow' },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 },
                    formatter: function(params) {
                        const p = params[0];
                        const pct = Math.round((p.value / totalDurVal) * 100);
                        return p.name + ': ' + p.value + ' ' + _t.calls + ' (' + pct + '%)';
                    }
                },
                grid: { left: 110, right: 60, top: 20, bottom: 20, containLabel: true },
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9 }
                },
                yAxis: {
                    type: 'category',
                    data: durationData.map(d => d.name),
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: { color: isLight ? '#27272a' : '#ffffff', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    name: 'Calls',
                    type: 'bar',
                    barWidth: '45%',
                    itemStyle: {
                        borderRadius: [0, 6, 6, 0]
                    },
                    data: durationData.map(d => ({
                        value: d.value,
                        name: d.name,
                        itemStyle: { color: durationColors[d.name] || '#64748b' }
                    })),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const pct = Math.round((params.value / totalDurVal) * 100);
                            return params.value + ' (' + pct + '%)';
                        },
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#52525b' : '#a1a1aa'
                    },
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => durationChart.resize());

            // -- Call Scope Breakdown (Internal vs External) --
            const scopeChart = echarts.init(document.getElementById('scopeChart'), isLight ? null : 'dark');
            const scopeColors = {
                'Internal': '#9333ea',
                'External': '#0284c7'
            };
            const totalScopeVal = scopeData.reduce((acc, curr) => acc + (curr.value || 0), 0) || 1;

            scopeChart.setOption({
                backgroundColor: 'transparent',
                tooltip: { 
                    trigger: 'axis',
                    axisPointer: { type: 'shadow' },
                    backgroundColor: isLight ? '#ffffff' : '#18181b',
                    borderColor: isLight ? '#e4e4e7' : '#27272a',
                    textStyle: { color: isLight ? '#09090b' : '#ffffff', fontSize: 11 },
                    formatter: function(params) {
                        const p = params[0];
                        const pct = Math.round((p.value / totalScopeVal) * 100);
                        return p.name + ': ' + p.value + ' ' + _t.calls + ' (' + pct + '%)';
                    }
                },
                grid: { left: 90, right: 60, top: 25, bottom: 25, containLabel: true },
                xAxis: {
                    type: 'value',
                    splitLine: { lineStyle: { color: isLight ? '#e4e4e7' : '#27272a', type: 'dashed' } },
                    axisLabel: { color: isLight ? '#52525b' : '#71717a', fontSize: 9 }
                },
                yAxis: {
                    type: 'category',
                    data: scopeData.map(d => d.name),
                    axisLine: { show: false },
                    axisTick: { show: false },
                    axisLabel: { color: isLight ? '#27272a' : '#ffffff', fontSize: 10, fontWeight: 'bold' }
                },
                series: [{
                    name: 'Calls',
                    type: 'bar',
                    barWidth: '45%',
                    itemStyle: {
                        borderRadius: [0, 6, 6, 0]
                    },
                    data: scopeData.map(d => ({
                        value: d.value,
                        name: d.name,
                        itemStyle: { color: scopeColors[d.name] || '#64748b' }
                    })),
                    label: {
                        show: true,
                        position: 'right',
                        formatter: function(params) {
                            const pct = Math.round((params.value / totalScopeVal) * 100);
                            return params.value + ' (' + pct + '%)';
                        },
                        fontSize: 10,
                        fontWeight: 'bold',
                        color: isLight ? '#52525b' : '#a1a1aa'
                    },
                    animationEasing: 'cubicOut',
                    animationDuration: 650
                }]
            });
            window.addEventListener('resize', () => scopeChart.resize());

            // Initialize Flatpickr on datetime inputs
            flatpickr('input[type="datetime-local"]', {
                enableTime: true,
                dateFormat: "Y-m-d H:i:S",
                altInput: true,
                altFormat: "m/d/Y h:i K",
                time_24hr: false,
                allowInput: true,
                scrollInputIntoView: false,
                appendTo: document.body,
                monthSelectorType: "dropdown"
            });
        });
    </script>
    <script>
        function toggleChecklistMenu(menuId, event) {
            if (event) event.stopPropagation();
            const menu = document.getElementById(menuId);
            if (!menu) return;
            const isHidden = menu.classList.contains('hidden');
            document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            if (isHidden) menu.classList.remove('hidden');
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('.checklist-menu') && !e.target.closest('button[onclick*="toggleChecklistMenu"]')) {
                document.querySelectorAll('.checklist-menu').forEach(m => m.classList.add('hidden'));
            }
        });

        function syncDashExtChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-ext-chk'));
            const select = document.getElementById('dashTargetExtSelect');
            const labelSpan = document.getElementById('dashExtLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(isRtl ? 'جميع التحويلات' : 'All Extensions') %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onDashExtChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-ext-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncDashExtChecklistUI();
        }

        function syncDashStatusChecklistUI() {
            const chks = Array.from(document.querySelectorAll('.dash-status-chk'));
            const select = document.getElementById('dashStatusSelect');
            const labelSpan = document.getElementById('dashStatusLabel');
            if (!select || !labelSpan) return;

            const selectedVals = chks.filter(c => c.checked).map(c => c.value);
            Array.from(select.options).forEach(opt => {
                opt.selected = selectedVals.includes(opt.value);
            });

            const nonAllSelected = selectedVals.filter(v => v !== 'ALL');
            if (selectedVals.includes('ALL') || nonAllSelected.length === 0) {
                labelSpan.textContent = <%- JSON.stringify(isRtl ? 'جميع الحالات' : 'All Dispositions') %>;
            } else if (nonAllSelected.length === 1) {
                labelSpan.textContent = nonAllSelected[0];
            } else {
                const isRtl = <%= isRtl ? 'true' : 'false' %>;
                const countText = isRtl ? ('محدد (' + nonAllSelected.length + ')') : (nonAllSelected.length + ' Selected');
                labelSpan.textContent = countText;
            }
        }

        function onDashStatusChange(chk) {
            const chks = Array.from(document.querySelectorAll('.dash-status-chk'));
            const allChk = chks.find(c => c.value === 'ALL');
            if (chk.value === 'ALL') {
                if (chk.checked) {
                    chks.forEach(c => { if (c !== chk) c.checked = false; });
                } else {
                    chk.checked = true;
                }
            } else {
                if (allChk) allChk.checked = false;
                const checkedCount = chks.filter(c => c.checked && c.value !== 'ALL').length;
                if (checkedCount === 0 && allChk) allChk.checked = true;
            }
            syncDashStatusChecklistUI();
        }

        document.addEventListener('DOMContentLoaded', () => {
            syncDashExtChecklistUI();
            syncDashStatusChecklistUI();
        });
    </script>

    <% if (isSuperAdmin) { %>
    <!-- Add Contact Modal -->
    <div id="addContactModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">

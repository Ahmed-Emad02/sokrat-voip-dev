                            },
                            data: hourVals,
                            animationEasing: 'cubicOut',
                            animationDuration: 400
                        }]
                    }, true);
                }

                hourlyChart.resize();
            }

            // Drill down when clicking a daily bar
            hourlyChart.on('click', function(params) {
                if (currentDistMode === 'days') {
                    const rawDate = (trendData || [])[params.dataIndex]?.date;
                    if (rawDate && hourlyByDayData[rawDate]) {
                        selectedSpecificDay = rawDate;
                        if (daySelectEl) daySelectEl.value = rawDate;
                        currentDistMode = 'hours';
                        updateDistButtons();

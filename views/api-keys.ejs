<!DOCTYPE html>
<html lang="<%= currentLang %>" dir="<%= currentLang === 'ar' ? 'rtl' : 'ltr' %>" class="h-full">
<head>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'dark';
            if (theme === 'light') { document.documentElement.classList.add('light-theme'); }
            else { document.documentElement.classList.remove('light-theme'); }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - <%= currentLang === 'ar' ? 'إدارة مفاتيح API' : 'API Key Manager' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.30.1/moment.min.js"></script>
    <style>
        :root {
            --bg-primary: #09090b;
            --bg-secondary: #18181b;
            --bg-card: #121215;
            --bg-hover: #27272a;
            --text-primary: #f4f4f5;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --border-primary: #27272a;
            --accent-color: #dc2626;
            --accent-hover: #b91c1c;
        }

        html.light-theme, body.light-theme {
            --bg-primary: #f8fafc !important;
            --bg-secondary: #ffffff !important;
            --bg-card: #ffffff !important;
            --bg-hover: #f1f5f9 !important;
            --text-primary: #0f172a !important;
            --text-secondary: #334155 !important;
            --text-muted: #64748b !important;
            --border-primary: #e2e8f0 !important;
        }

        body {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
            background-color: var(--bg-primary);
            color: var(--text-primary);
        }

        .panel-surface {
            background-color: var(--bg-secondary);
            border: 1px solid var(--border-primary);
        }

        html.light-theme .panel-surface {
            background-color: #ffffff !important;
            border-color: #e2e8f0 !important;
        }

        html.light-theme .text-white { color: #0f172a !important; }
        html.light-theme .text-zinc-400 { color: #475569 !important; }
        html.light-theme .text-zinc-300 { color: #334155 !important; }
        html.light-theme .text-zinc-200 { color: #1e293b !important; }

        html.light-theme .bg-black\/40,
        html.light-theme .bg-black\/30 {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }

        html.light-theme .bg-zinc-800 {
            background-color: #e2e8f0 !important;
            color: #1e293b !important;
        }

        html.light-theme .bg-zinc-800:hover {
            background-color: #cbd5e1 !important;
        }

        html.light-theme input,
        html.light-theme select {
            background-color: #f8fafc !important;
            color: #0f172a !important;
            border-color: #cbd5e1 !important;
        }

        /* Root Domain Badge Styling */
        .badge-root-domain {
            background: linear-gradient(135deg, rgba(220, 38, 38, 0.25), rgba(153, 27, 27, 0.4));
            color: #fecaca !important; /* High-contrast bright light-crimson */
            border: 1px solid rgba(239, 68, 68, 0.7) !important;
            box-shadow: 0 0 14px rgba(239, 68, 68, 0.25);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
        }
        .badge-root-domain .indicator-dot {
            background-color: #ef4444;
            box-shadow: 0 0 8px #ef4444;
        }

        html.light-theme .badge-root-domain {
            background: #fee2e2 !important; /* Soft rose background */
            color: #991b1b !important; /* Dark solid crimson for maximum readability */
            border: 1px solid #f87171 !important;
            box-shadow: 0 1px 3px rgba(185, 28, 28, 0.12) !important;
            text-shadow: none !important;
        }
        html.light-theme .badge-root-domain .indicator-dot {
            background-color: #dc2626 !important;
            box-shadow: none !important;
        }

        /* High-Contrast Code Terminal Surfaces */
        .code-block-surface {
            background-color: #090d16 !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            color: #f8fafc !important;
            box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.6);
        }
        html.light-theme .code-block-surface {
            background-color: #0b0f19 !important; /* Keep code terminal deeply dark in light mode for max contrast */
            border-color: #334155 !important;
            color: #f8fafc !important;
        }

        /* Light-theme badge overrides for table status tags */
        html.light-theme .bg-emerald-950 {
            background-color: #ecfdf5 !important;
            border-color: #6ee7b7 !important;
            color: #065f46 !important;
        }
        html.light-theme .bg-rose-950 {
            background-color: #ffe4e6 !important;
            border-color: #fda4af !important;
            color: #9f1239 !important;
        }
        html.light-theme .bg-blue-950 {
            background-color: #eff6ff !important;
            border-color: #93c5fd !important;
            color: #1e40af !important;
        }
        html.light-theme .bg-amber-950 {
            background-color: #fffbeb !important;
            border-color: #fcd34d !important;
            color: #92400e !important;
        }

        /* Multi-Select Scope Chips */
        .scope-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.2rem 0.5rem;
            border-radius: 0.45rem;
            font-size: 0.72rem;
            font-weight: 700;
            font-family: monospace;
            background: rgba(220, 38, 38, 0.18);
            color: #fecaca;
            border: 1px solid rgba(239, 68, 68, 0.4);
            transition: all 0.15s ease;
        }
        .scope-chip.chip-full-access {
            background: rgba(59, 130, 246, 0.2);
            color: #93c5fd;
            border-color: rgba(59, 130, 246, 0.5);
        }
        .scope-chip button {
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            opacity: 0.75;
            transition: opacity 0.15s ease;
            font-size: 0.75rem;
        }
        .scope-chip button:hover {
            opacity: 1;
            color: #ffffff;
        }
        html.light-theme .scope-chip {
            background: #fee2e2 !important;
            color: #991b1b !important;
            border-color: #f87171 !important;
        }
        html.light-theme .scope-chip.chip-full-access {
            background: #eff6ff !important;
            color: #1e40af !important;
            border-color: #93c5fd !important;
        }

        .btn-primary {
            background-color: var(--accent-color);
            color: #ffffff;
            border-radius: 0.75rem;
            transition: all 0.15s ease-in-out;
        }
        .btn-primary:hover {
            background-color: var(--accent-hover);
        }
    </style>
</head>
<body class="h-full flex overflow-hidden">
    <%- include('sidebar') %>

    <main class="flex-1 overflow-y-auto p-6 bg-[var(--bg-primary)]">
        <div class="max-w-7xl mx-auto space-y-6">

            <!-- Page Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2.5">
                        <h1 class="text-2xl font-black text-[var(--text-primary)]">
                            <%= currentLang === 'ar' ? 'إدارة مفاتيح API' : 'API Key Manager' %>
                        </h1>
                        <span class="badge-root-domain inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-black uppercase tracking-wider rounded-full">
                            <span class="indicator-dot w-2 h-2 rounded-full animate-pulse"></span>
                            <%= currentLang === 'ar' ? 'حساب الجذر فقط (Root Only)' : 'Root Security Domain' %>
                        </span>
                    </div>
                    <p class="text-xs text-[var(--text-secondary)] mt-1">
                        <%= currentLang === 'ar' 
                            ? 'إدارة مفاتيح API الثابتة لتأمين وحماية جميع واجهات REST البرمجية للـ CRM والأنظمة الخارجية' 
                            : 'Generate and manage static API keys to secure all REST endpoints for CRM, webhooks, and external integrations' %>
                    </p>
                </div>
                <button id="btnOpenCreateModal" class="btn-primary px-4 py-2.5 text-xs uppercase font-bold tracking-wider flex items-center gap-2 shadow-lg shadow-red-900/20">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12h14"/></svg>
                    <span><%= currentLang === 'ar' ? 'إنشاء مفتاح جديد' : 'Generate New API Key' %></span>
                </button>
            </div>

            <!-- Newly Created Key Alert Banner (Shown after creation) -->
            <div id="newKeyBanner" class="hidden bg-emerald-950/70 border border-emerald-500/50 rounded-2xl p-5 text-emerald-200 shadow-xl">
                <div class="flex items-start justify-between">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <h3 class="text-sm font-bold text-emerald-300 uppercase tracking-wider">
                                <%= currentLang === 'ar' ? 'تم إنشاء مفتاح API بنجاح' : 'New API Key Successfully Generated' %>
                            </h3>
                        </div>
                        <p class="text-xs text-emerald-200/80 mt-1">
                            <%= currentLang === 'ar' 
                                ? 'انسخ المفتاح السري أدناه واستخدمه في ترويسة X-API-Key في نظام CRM الخاص بك:' 
                                : 'Copy this secret API key and provide it to your CRM developer as the X-API-Key header:' %>
                        </p>
                    </div>
                    <button id="btnCloseKeyBanner" class="text-emerald-400 hover:text-white p-1 text-sm font-bold">✕</button>
                </div>
                <div class="mt-4 flex flex-col sm:flex-row items-center gap-3">
                    <input type="text" id="newKeyValue" readonly class="w-full font-mono text-sm font-bold bg-black/50 border border-emerald-500/40 rounded-xl px-4 py-3 text-emerald-100 select-all tracking-wide">
                    <button id="btnCopyNewKey" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider shrink-0 transition flex items-center justify-center gap-2">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        <span id="copyBtnText"><%= currentLang === 'ar' ? 'نسخ المفتاح' : 'Copy Key' %></span>
                    </button>
                </div>
            </div>

            <!-- KPI Metric Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="panel-surface rounded-2xl p-5 border border-[var(--border-primary)]">
                    <div class="text-xs text-[var(--text-secondary)] font-bold uppercase tracking-wider">
                        <%= currentLang === 'ar' ? 'إجمالي المفاتيح' : 'Total API Keys' %>
                    </div>
                    <div class="text-2xl font-black text-[var(--text-primary)] mt-1 font-mono">
                        <%= keys.length %>
                    </div>
                </div>
                <div class="panel-surface rounded-2xl p-5 border border-[var(--border-primary)]">
                    <div class="text-xs text-[var(--text-secondary)] font-bold uppercase tracking-wider">
                        <%= currentLang === 'ar' ? 'المفاتيح النشطة' : 'Active Keys' %>
                    </div>
                    <div class="text-2xl font-black text-emerald-500 mt-1 font-mono">
                        <%= keys.filter(k => k.status === 'active').length %>
                    </div>
                </div>
                <div class="panel-surface rounded-2xl p-5 border border-[var(--border-primary)]">
                    <div class="text-xs text-[var(--text-secondary)] font-bold uppercase tracking-wider">
                        <%= currentLang === 'ar' ? 'المفاتيح المعطلة' : 'Revoked Keys' %>
                    </div>
                    <div class="text-2xl font-black text-rose-500 mt-1 font-mono">
                        <%= keys.filter(k => k.status === 'revoked').length %>
                    </div>
                </div>
                <div class="panel-surface rounded-2xl p-5 border border-[var(--border-primary)]">
                    <div class="text-xs text-[var(--text-secondary)] font-bold uppercase tracking-wider">
                        <%= currentLang === 'ar' ? 'نوع الحماية' : 'Auth Header' %>
                    </div>
                    <div class="text-sm font-black text-amber-400 mt-2 font-mono flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        X-API-Key / Bearer
                    </div>
                </div>
            </div>

            <!-- API Keys Table Section -->
            <div class="panel-surface rounded-2xl border border-[var(--border-primary)] p-6">
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider">
                        <%= currentLang === 'ar' ? 'مفاتيح API المسجلة' : 'Registered Static API Keys' %>
                    </h2>
                    <span class="text-xs text-[var(--text-muted)] font-mono">
                        <%= keys.length %> <%= currentLang === 'ar' ? 'مفتاح' : 'Keys configured' %>
                    </span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-start border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-[var(--border-primary)] text-[var(--text-secondary)] font-bold uppercase tracking-wider text-start">
                                <th class="pb-3 text-start"><%= currentLang === 'ar' ? 'اسم المفتاح / الوصف' : 'Name / Label' %></th>
                                <th class="pb-3 text-start"><%= currentLang === 'ar' ? 'المفتاح' : 'Key Token' %></th>
                                <th class="pb-3 text-start"><%= currentLang === 'ar' ? 'الصلاحيات' : 'Scopes' %></th>
                                <th class="pb-3 text-start"><%= currentLang === 'ar' ? 'الآي بي المسموح' : 'Allowed IPs' %></th>
                                <th class="pb-3 text-start"><%= currentLang === 'ar' ? 'آخر استخدام' : 'Last Used' %></th>
                                <th class="pb-3 text-start"><%= currentLang === 'ar' ? 'الحالة' : 'Status' %></th>
                                <th class="pb-3 text-end"><%= currentLang === 'ar' ? 'إجراءات' : 'Actions' %></th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[var(--border-primary)]/40 text-[var(--text-primary)] font-mono">
                            <% if (keys.length === 0) { %>
                                <tr>
                                    <td colspan="7" class="py-12 text-center text-[var(--text-muted)] font-mono">
                                        <div class="flex flex-col items-center justify-center gap-2">
                                            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-[var(--text-muted)] opacity-60"><path d="m21 2-2 2m-6 6 7 7-3 3-4-4v-4l-4-4m-2 2L4 12l2-2 3 3 2-2-3-3 2-2 4 4Z"/><circle cx="7.5" cy="7.5" r="2.5"/></svg>
                                            <span><%= currentLang === 'ar' ? 'لا توجد مفاتيح API حتى الآن. انقر على "إنشاء مفتاح جديد" لإنشاء أول مفتاح.' : 'No API keys created yet. Click "Generate New API Key" above to create one.' %></span>
                                        </div>
                                    </td>
                                </tr>
                            <% } %>

                            <% keys.forEach(key => { %>
                                <tr class="hover:bg-[var(--bg-hover)]/40 transition">
                                    <td class="py-3.5 font-bold text-[var(--text-primary)]">
                                        <div class="flex items-center gap-2">
                                            <div class="w-2 h-2 rounded-full <%= key.status === 'active' ? 'bg-emerald-400' : 'bg-rose-500' %>"></div>
                                            <span><%= key.name %></span>
                                        </div>
                                        <div class="text-[10px] text-[var(--text-muted)] font-normal mt-0.5">
                                            Created <%= moment(key.created_at).format('YYYY-MM-DD HH:mm') %> by <%= key.created_by %>
                                        </div>
                                    </td>
                                    <td class="py-3.5 text-[var(--text-primary)]">
                                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-black/40 border border-[var(--border-primary)]">
                                            <span class="font-mono text-zinc-300"><%= key.key_prefix %></span>
                                            <button type="button" 
                                                    class="btn-reveal text-zinc-400 hover:text-white transition p-0.5" 
                                                    data-id="<%= key.id %>" 
                                                    title="<%= currentLang === 'ar' ? 'إظهار ونسخ المفتاح الكامل' : 'Reveal & Copy Full Key' %>">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="py-3.5">
                                        <% if (key.scopes === '*' || !key.scopes) { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-950 text-blue-300 border border-blue-800">
                                                * Full Access
                                            </span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-zinc-800 text-zinc-300 border border-zinc-700">
                                                <%= key.scopes %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5">
                                        <% if (!key.allowed_ips || key.allowed_ips === '*') { %>
                                            <span class="text-[11px] text-[var(--text-muted)]">Any IP</span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-800">
                                                <%= key.allowed_ips %>
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 text-[var(--text-muted)] text-[11px]">
                                        <% if (key.last_used_at) { %>
                                            <div><%= moment(key.last_used_at).fromNow() %></div>
                                            <% if (key.last_used_ip) { %>
                                                <div class="text-[10px] text-zinc-400"><%= key.last_used_ip %></div>
                                            <% } %>
                                        <% } else { %>
                                            <span>Never</span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5">
                                        <% if (key.status === 'active') { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-800">
                                                ACTIVE
                                            </span>
                                        <% } else { %>
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-950 text-rose-300 border border-rose-800">
                                                REVOKED
                                            </span>
                                        <% } %>
                                    </td>
                                    <td class="py-3.5 text-end font-mono">
                                        <div class="inline-flex items-center gap-1.5">
                                            <button type="button" 
                                                    class="btn-toggle-status px-2.5 py-1 text-[11px] rounded-lg transition <%= key.status === 'active' ? 'bg-zinc-800 hover:bg-zinc-700 text-zinc-300' : 'bg-emerald-950 hover:bg-emerald-900 text-emerald-300' %>" 
                                                    data-id="<%= key.id %>" 
                                                    data-status="<%= key.status %>">
                                                <%= key.status === 'active' ? (currentLang === 'ar' ? 'تعطيل' : 'Revoke') : (currentLang === 'ar' ? 'تفعيل' : 'Activate') %>
                                            </button>
                                            <button type="button" 
                                                    class="btn-delete px-2.5 py-1 text-[11px] bg-rose-950 hover:bg-rose-900 text-rose-300 rounded-lg transition" 
                                                    data-id="<%= key.id %>" 
                                                    data-name="<%= key.name %>">
                                                <%= currentLang === 'ar' ? 'حذف' : 'Delete' %>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Integration Developer Guide & Code Snippets -->
            <div class="panel-surface rounded-2xl border border-[var(--border-primary)] p-6 space-y-4">
                <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3">
                    <h2 class="text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider flex items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                        <span><%= currentLang === 'ar' ? 'دليل الربط للمطورين (Integration Cheat Sheet)' : 'CRM Developer Integration Guide' %></span>
                    </h2>
                    <span class="text-[11px] text-[var(--text-muted)] font-mono">Port 8080 • JSON REST</span>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 text-xs font-mono">
                    <!-- cURL Example 1: Single Call -->
                    <div class="bg-black/40 border border-[var(--border-primary)] rounded-xl p-4 space-y-2">
                        <div class="text-[var(--text-primary)] font-bold text-xs flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                            1. Query Call by Unique ID (Header)
                        </div>
                        <pre class="code-block-surface overflow-x-auto p-3 rounded-xl text-xs font-mono leading-relaxed select-all"><code><span class="text-amber-300 font-bold">curl</span> <span class="text-zinc-200 font-semibold">-X GET</span> <span class="text-sky-300 font-semibold">"http://<%= reqHost %>/api/cdr/1790496202.18"</span> \
     <span class="text-zinc-400 font-semibold">-H</span> <span class="text-purple-300 font-bold">"X-API-Key:</span> <span class="text-emerald-300 font-bold">sokrat_live_your_key_here"</span></code></pre>
                    </div>

                    <!-- cURL Example 2: Phone Search -->
                    <div class="bg-black/40 border border-[var(--border-primary)] rounded-xl p-4 space-y-2">
                        <div class="text-[var(--text-primary)] font-bold text-xs flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
                            2. Search Calls by Phone (Bearer Header)
                        </div>
                        <pre class="code-block-surface overflow-x-auto p-3 rounded-xl text-xs font-mono leading-relaxed select-all"><code><span class="text-amber-300 font-bold">curl</span> <span class="text-zinc-200 font-semibold">-X GET</span> <span class="text-sky-300 font-semibold">"http://<%= reqHost %>/api/cdr/phone/01011719380?limit=25"</span> \
     <span class="text-zinc-400 font-semibold">-H</span> <span class="text-purple-300 font-bold">"Authorization: Bearer</span> <span class="text-emerald-300 font-bold">sokrat_live_your_key_here"</span></code></pre>
                    </div>

                    <!-- HTML Audio Player -->
                    <div class="bg-black/40 border border-[var(--border-primary)] rounded-xl p-4 space-y-2">
                        <div class="text-[var(--text-primary)] font-bold text-xs flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                            3. HTML5 Audio Stream (Browser Player)
                        </div>
                        <pre class="code-block-surface overflow-x-auto p-3 rounded-xl text-xs font-mono leading-relaxed select-all"><code><span class="text-rose-400 font-bold">&lt;audio</span> <span class="text-amber-300 font-semibold">controls</span> <span class="text-cyan-300 font-semibold">src</span>=<span class="text-sky-300 font-semibold">"http://<%= reqHost %>/api/cdr/audio/1790496202.18?api_key=<span class="text-emerald-300 font-bold">sokrat_live_your_key_here</span>"</span><span class="text-rose-400 font-bold">&gt;&lt;/audio&gt;</span></code></pre>
                    </div>

                    <!-- PHP / Laravel Example -->
                    <div class="bg-black/40 border border-[var(--border-primary)] rounded-xl p-4 space-y-2">
                        <div class="text-[var(--text-primary)] font-bold text-xs flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                            4. PHP / Laravel CRM HTTP Request
                        </div>
                        <pre class="code-block-surface overflow-x-auto p-3 rounded-xl text-xs font-mono leading-relaxed select-all"><code><span class="text-sky-300 font-semibold">$response</span> = <span class="text-purple-300 font-bold">Http</span>::<span class="text-amber-300 font-semibold">withHeaders</span>([
    <span class="text-sky-200 font-semibold">'X-API-Key'</span> =&gt; <span class="text-emerald-300 font-bold">'sokrat_live_your_key_here'</span>
])-&gt;<span class="text-amber-300 font-semibold">get</span>(<span class="text-sky-300 font-semibold">'http://<%= reqHost %>/api/cdr/phone/01011719380'</span>);</code></pre>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <!-- Create API Key Modal -->
    <div id="createModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl max-w-lg w-full p-6 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3">
                <h3 class="text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider">
                    <%= currentLang === 'ar' ? 'إنشاء مفتاح API جديد' : 'Generate Static API Key' %>
                </h3>
                <button type="button" id="btnCloseCreateModal" class="text-zinc-400 hover:text-[var(--text-primary)]">✕</button>
            </div>

            <form id="createKeyForm" class="space-y-4 text-xs">
                <div>
                    <label class="block text-[var(--text-secondary)] mb-1 font-bold" for="keyName">
                        <%= currentLang === 'ar' ? 'اسم المفتاح / النظام المرتبط' : 'Key Name / CRM System' %> *
                    </label>
                    <input type="text" id="keyName" required placeholder="e.g. Zoho CRM Production" class="w-full bg-black/40 border border-[var(--border-primary)] rounded-lg p-2.5 text-[var(--text-primary)] font-mono text-xs focus:border-red-500 focus:outline-none">
                </div>

                <div class="relative">
                    <label class="block text-[var(--text-secondary)] mb-1 font-bold">
                        <%= currentLang === 'ar' ? 'نطاق الصلاحيات' : 'Granted Scopes' %> *
                    </label>
                    <div id="scopesDropdownTrigger" class="min-h-[42px] w-full bg-black/40 border border-[var(--border-primary)] rounded-lg p-2 flex items-center justify-between gap-1.5 cursor-pointer hover:border-zinc-500 transition relative">
                        <div id="scopesChipsContainer" class="flex flex-wrap items-center gap-1.5 flex-1">
                            <!-- Chips rendered dynamically -->
                        </div>
                        <svg class="w-4 h-4 text-zinc-400 shrink-0 ms-2 transition-transform duration-200" id="scopesDropdownChevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                    </div>

                    <input type="hidden" id="keyScopes" name="scopes" value="*">

                    <div id="scopesDropdownPanel" class="hidden absolute left-0 right-0 mt-1 bg-[var(--bg-secondary)] border border-[var(--border-accent)] rounded-xl shadow-2xl p-3 z-50 space-y-2.5 max-h-64 overflow-y-auto">
                        <div class="flex items-center justify-between pb-2 border-b border-[var(--border-primary)] text-[11px]">
                            <button type="button" id="btnSelectAllScopes" class="text-emerald-400 hover:text-emerald-300 font-bold transition flex items-center gap-1 cursor-pointer">
                                <span>✓</span> <%= currentLang === 'ar' ? 'تحديد الكل (* كامل الصلاحيات)' : 'Select All (* Full Access)' %>
                            </button>
                            <button type="button" id="btnClearScopes" class="text-rose-400 hover:text-rose-300 font-bold transition flex items-center gap-1 cursor-pointer">
                                <span>✕</span> <%= currentLang === 'ar' ? 'مسح التحديد' : 'Clear All' %>
                            </button>
                        </div>
                        <div id="scopesOptionsList" class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs font-mono">
                            <!-- Checkboxes injected by JS -->
                        </div>
                    </div>
                    <span class="text-[10px] text-[var(--text-muted)] mt-1 block">
                        <%= currentLang === 'ar' 
                            ? 'حدد الصلاحيات المصرح لهذا المفتاح باستخدامها. خيار * يمنح وصولاً كاملاً لجميع العمليات.' 
                            : 'Select specific API capabilities or grant full access with *. External calls missing a scope will receive HTTP 403 Forbidden.' %>
                    </span>
                </div>

                <div>
                    <label class="block text-[var(--text-secondary)] mb-1 font-bold" for="keyAllowedIps">
                        <%= currentLang === 'ar' ? 'تقييد عناوين IP (اختياري)' : 'IP Whitelist (Optional)' %>
                    </label>
                    <input type="text" id="keyAllowedIps" placeholder="e.g. 192.168.1.100, 10.0.0.0/24 (leave blank for any IP)" class="w-full bg-black/40 border border-[var(--border-primary)] rounded-lg p-2.5 text-[var(--text-primary)] font-mono text-xs focus:border-red-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-[var(--text-secondary)] mb-1 font-bold" for="keyExpires">
                        <%= currentLang === 'ar' ? 'فترة الصلاحية' : 'Expiration' %>
                    </label>
                    <select id="keyExpires" class="w-full bg-black/40 border border-[var(--border-primary)] rounded-lg p-2.5 text-[var(--text-primary)] font-mono text-xs focus:border-red-500 focus:outline-none">
                        <option value="0">Never Expires</option>
                        <option value="30">30 Days</option>
                        <option value="90">90 Days</option>
                        <option value="365">1 Year</option>
                    </select>
                </div>

                <div class="flex justify-end gap-2 pt-3 border-t border-[var(--border-primary)]">
                    <button type="button" id="btnCancelCreate" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded-lg font-bold">
                        <%= currentLang === 'ar' ? 'إلغاء' : 'Cancel' %>
                    </button>
                    <button type="submit" id="btnSubmitCreate" class="btn-primary px-5 py-2 font-bold flex items-center gap-2">
                        <span><%= currentLang === 'ar' ? 'إنشاء المفتاح' : 'Generate Key' %></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Reveal Key Modal -->
    <div id="revealModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
        <div class="bg-[var(--bg-secondary)] border border-[var(--border-primary)] rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
            <div class="flex items-center justify-between border-b border-[var(--border-primary)] pb-3">
                <h3 class="text-sm font-bold text-[var(--text-primary)] uppercase tracking-wider" id="revealModalTitle">
                    <%= currentLang === 'ar' ? 'المفتاح السري' : 'Static API Key Token' %>
                </h3>
                <button type="button" id="btnCloseRevealModal" class="text-zinc-400 hover:text-[var(--text-primary)]">✕</button>
            </div>

            <div class="space-y-3">
                <p class="text-xs text-[var(--text-secondary)]">
                    <%= currentLang === 'ar' ? 'المفتاح الكامل المشفر المخزن في النظام:' : 'Full decrypted key token for this client:' %>
                </p>
                <div class="relative">
                    <input type="text" id="revealedKeyValue" readonly class="w-full font-mono text-xs font-bold bg-black/50 border border-[var(--border-primary)] rounded-xl p-3 text-emerald-400 select-all tracking-wide">
                </div>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" id="btnCopyRevealedKey" class="btn-primary px-4 py-2 font-bold text-xs uppercase tracking-wider flex items-center gap-1.5">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        <span id="copyRevealedBtnText"><%= currentLang === 'ar' ? 'نسخ إلى الحافظة' : 'Copy Key' %></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        const createModal = document.getElementById('createModal');
        const revealModal = document.getElementById('revealModal');
        const newKeyBanner = document.getElementById('newKeyBanner');
        const newKeyValue = document.getElementById('newKeyValue');

        // Multi-Select Scopes Configuration
        const SCOPES_CONFIG = [
            { key: '*', label: '<%= currentLang === "ar" ? "* كامل الصلاحيات" : "* Full Access" %>', desc: '<%= currentLang === "ar" ? "وصول شامل وغير مقيد لكافة العمليات" : "Unrestricted full access to all endpoints" %>' },
            { key: 'cdr:read', label: 'cdr:read', desc: '<%= currentLang === "ar" ? "عرض والبحث بسجل المكالمات" : "Query & search CDR call logs" %>' },
            { key: 'cdr:audio', label: 'cdr:audio', desc: '<%= currentLang === "ar" ? "بث وتحميل التسجيلات الصوتية" : "Stream & download recordings" %>' },
            { key: 'calls:read', label: 'calls:read', desc: '<%= currentLang === "ar" ? "بحث مكالمات العميل بالهاتف" : "Search calls by phone number" %>' },
            { key: 'extensions:read', label: 'extensions:read', desc: '<%= currentLang === "ar" ? "استعلام حالة التحويلات" : "Read extensions and live state" %>' },
            { key: 'operator', label: 'operator', desc: '<%= currentLang === "ar" ? "لوحة المراقبة وإجراءات التجسس" : "Live switchboard actions" %>' },
            { key: 'dialer', label: 'dialer', desc: '<%= currentLang === "ar" ? "حملات الاتصال الآلي والعملاء" : "Manage outbound campaigns" %>' },
            { key: 'dongles', label: 'dongles', desc: '<%= currentLang === "ar" ? "شرائح GSM ورسائل SMS" : "GSM modems & SMS messaging" %>' },
            { key: 'contacts', label: 'contacts', desc: '<%= currentLang === "ar" ? "دليل الهاتف وجهات الاتصال" : "Address book contacts" %>' },
            { key: 'voicemails', label: 'voicemails', desc: '<%= currentLang === "ar" ? "صناديق البريد الصوتي" : "Voicemail mailboxes" %>' },
            { key: 'config', label: 'config', desc: '<%= currentLang === "ar" ? "إعدادات المقسم والخطوط" : "PBX trunks, routes & IVRs" %>' },
            { key: 'storage', label: 'storage', desc: '<%= currentLang === "ar" ? "مراقبة النظام والنسخ الاحتياطي" : "SysMon telemetry & backup" %>' }
        ];

        let selectedScopes = ['*'];

        function renderScopesDropdown() {
            const chipsContainer = document.getElementById('scopesChipsContainer');
            const hiddenInput = document.getElementById('keyScopes');
            const optionsList = document.getElementById('scopesOptionsList');

            chipsContainer.innerHTML = '';
            if (selectedScopes.length === 0) {
                chipsContainer.innerHTML = '<span class="text-zinc-500 font-mono text-xs select-none"><%= currentLang === "ar" ? "اختر الصلاحيات من القائمة..." : "Select scopes from dropdown..." %></span>';
                hiddenInput.value = '';
            } else {
                hiddenInput.value = selectedScopes.join(',');
                selectedScopes.forEach(scopeKey => {
                    const chip = document.createElement('span');
                    chip.className = 'scope-chip' + (scopeKey === '*' ? ' chip-full-access' : '');
                    chip.innerHTML = `<span>${scopeKey}</span><button type="button" title="Remove">✕</button>`;
                    chip.querySelector('button').addEventListener('click', (e) => {
                        e.stopPropagation();
                        removeScope(scopeKey);
                    });
                    chipsContainer.appendChild(chip);
                });
            }

            optionsList.innerHTML = '';
            SCOPES_CONFIG.forEach(item => {
                const isChecked = selectedScopes.includes(item.key);
                const opt = document.createElement('label');
                opt.className = 'flex items-start gap-2 p-2 rounded-lg cursor-pointer transition hover:bg-[var(--bg-hover)] ' + (isChecked ? 'bg-black/30 border border-zinc-700/60' : 'border border-transparent');
                opt.innerHTML = `
                    <input type="checkbox" value="${item.key}" ${isChecked ? 'checked' : ''} class="mt-0.5 rounded border-zinc-700 text-red-600 focus:ring-red-500">
                    <div class="flex-1 min-w-0">
                        <div class="font-bold text-[11px] text-[var(--text-primary)] leading-tight">${item.label}</div>
                        <div class="text-[10px] text-[var(--text-muted)] leading-tight truncate mt-0.5">${item.desc}</div>
                    </div>
                `;
                opt.querySelector('input').addEventListener('change', (e) => {
                    toggleScope(item.key, e.target.checked);
                });
                optionsList.appendChild(opt);
            });
        }

        function toggleScope(scopeKey, isChecked) {
            if (scopeKey === '*') {
                selectedScopes = isChecked ? ['*'] : [];
            } else {
                selectedScopes = selectedScopes.filter(s => s !== '*');
                if (isChecked) {
                    if (!selectedScopes.includes(scopeKey)) selectedScopes.push(scopeKey);
                } else {
                    selectedScopes = selectedScopes.filter(s => s !== scopeKey);
                }
            }
            renderScopesDropdown();
        }

        function removeScope(scopeKey) {
            selectedScopes = selectedScopes.filter(s => s !== scopeKey);
            renderScopesDropdown();
        }

        const scopesTrigger = document.getElementById('scopesDropdownTrigger');
        const scopesPanel = document.getElementById('scopesDropdownPanel');
        const scopesChevron = document.getElementById('scopesDropdownChevron');

        scopesTrigger.addEventListener('click', () => {
            const isClosed = scopesPanel.classList.contains('hidden');
            if (isClosed) {
                scopesPanel.classList.remove('hidden');
                scopesChevron.classList.add('rotate-180');
            } else {
                scopesPanel.classList.add('hidden');
                scopesChevron.classList.remove('rotate-180');
            }
        });

        document.getElementById('btnSelectAllScopes').addEventListener('click', (e) => {
            e.stopPropagation();
            selectedScopes = ['*'];
            renderScopesDropdown();
        });

        document.getElementById('btnClearScopes').addEventListener('click', (e) => {
            e.stopPropagation();
            selectedScopes = [];
            renderScopesDropdown();
        });

        document.addEventListener('click', (e) => {
            if (!scopesTrigger.contains(e.target) && !scopesPanel.contains(e.target)) {
                scopesPanel.classList.add('hidden');
                scopesChevron.classList.remove('rotate-180');
            }
        });

        // Initialize dropdown
        renderScopesDropdown();

        // Modal controls
        document.getElementById('btnOpenCreateModal').addEventListener('click', () => {
            document.getElementById('keyName').value = '';
            selectedScopes = ['*'];
            renderScopesDropdown();
            document.getElementById('keyAllowedIps').value = '';
            document.getElementById('keyExpires').value = '0';
            createModal.classList.remove('hidden');
        });

        document.getElementById('btnCloseCreateModal').addEventListener('click', () => createModal.classList.add('hidden'));
        document.getElementById('btnCancelCreate').addEventListener('click', () => createModal.classList.add('hidden'));
        document.getElementById('btnCloseKeyBanner').addEventListener('click', () => newKeyBanner.classList.add('hidden'));
        document.getElementById('btnCloseRevealModal').addEventListener('click', () => revealModal.classList.add('hidden'));

        // Copy new key
        document.getElementById('btnCopyNewKey').addEventListener('click', async () => {
            try {
                await navigator.clipboard.writeText(newKeyValue.value);
                const txt = document.getElementById('copyBtnText');
                const orig = txt.textContent;
                txt.textContent = 'Copied!';
                setTimeout(() => { txt.textContent = orig; }, 2000);
            } catch (_) {
                newKeyValue.select();
                document.execCommand('copy');
            }
        });

        // Copy revealed key
        document.getElementById('btnCopyRevealedKey').addEventListener('click', async () => {
            const input = document.getElementById('revealedKeyValue');
            try {
                await navigator.clipboard.writeText(input.value);
                const txt = document.getElementById('copyRevealedBtnText');
                const orig = txt.textContent;
                txt.textContent = 'Copied!';
                setTimeout(() => { txt.textContent = orig; }, 2000);
            } catch (_) {
                input.select();
                document.execCommand('copy');
            }
        });

        // Create key form submission
        document.getElementById('createKeyForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const scopesVal = document.getElementById('keyScopes').value.trim();
            if (!scopesVal) {
                alert('<%= currentLang === "ar" ? "يرجى تحديد صلاحية واحدة على الأقل أو اختيار * لكامل الصلاحيات." : "Please select at least one granted scope (or * for full access)." %>');
                return;
            }
            const btn = document.getElementById('btnSubmitCreate');
            btn.disabled = true;
            btn.textContent = 'Generating...';

            try {
                const res = await fetch('/api/admin/api-keys', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name: document.getElementById('keyName').value.trim(),
                        scopes: scopesVal || '*',
                        allowed_ips: document.getElementById('keyAllowedIps').value.trim() || null,
                        expires_in_days: parseInt(document.getElementById('keyExpires').value, 10) || 0
                    })
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    alert('Error creating API key: ' + (data.error || 'Unknown error'));
                    btn.disabled = false;
                    btn.textContent = 'Generate Key';
                    return;
                }

                createModal.classList.add('hidden');
                newKeyValue.value = data.key.rawKey;
                newKeyBanner.classList.remove('hidden');
                newKeyBanner.scrollIntoView({ behavior: 'smooth' });

                setTimeout(() => { window.location.reload(); }, 3500);
            } catch (err) {
                alert('Connection error: ' + err.message);
                btn.disabled = false;
                btn.textContent = 'Generate Key';
            }
        });

        // Reveal key
        document.querySelectorAll('.btn-reveal').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                try {
                    const res = await fetch(`/api/admin/api-keys/${id}/reveal`);
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        alert(data.error || 'Failed to reveal key');
                        return;
                    }
                    document.getElementById('revealedKeyValue').value = data.rawKey;
                    document.getElementById('revealModalTitle').textContent = data.name + ' - Key Token';
                    revealModal.classList.remove('hidden');
                } catch (err) {
                    alert('Error: ' + err.message);
                }
            });
        });

        // Toggle status (revoke/activate)
        document.querySelectorAll('.btn-toggle-status').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                const curStatus = btn.getAttribute('data-status');
                const nextStatus = curStatus === 'active' ? 'revoked' : 'active';
                const confirmMsg = curStatus === 'active' 
                    ? 'Revoke this API key? External requests using this key will be rejected immediately.' 
                    : 'Re-activate this API key?';

                if (!confirm(confirmMsg)) return;

                try {
                    const res = await fetch(`/api/admin/api-keys/${id}/status`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ status: nextStatus })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        alert(data.error || 'Action failed');
                        return;
                    }
                    window.location.reload();
                } catch (err) {
                    alert('Error: ' + err.message);
                }
            });
        });

        // Delete key
        document.querySelectorAll('.btn-delete').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                if (!confirm(`Are you sure you want to permanently delete API key "${name}"? This action cannot be undone.`)) {
                    return;
                }

                try {
                    const res = await fetch(`/api/admin/api-keys/${id}`, {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        alert(data.error || 'Delete failed');
                        return;
                    }
                    window.location.reload();
                } catch (err) {
                    alert('Error: ' + err.message);
                }
            });
        });
    </script>
</body>
</html>

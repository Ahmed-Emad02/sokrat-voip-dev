<% const isRtl = currentLang === 'ar'; %>
<% const isLightInitial = (typeof currentTheme !== 'undefined' && currentTheme === 'light'); %>
<!DOCTYPE html>
<html lang="<%= currentLang === 'ar' ? 'ar' : 'en' %>" dir="<%= currentLang === 'ar' ? 'rtl' : 'ltr' %>" class="<%= isLightInitial ? 'light-theme' : '' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isRtl ? 'Sokrat VOIP - تسجيل الدخول' : 'Sokrat VOIP - Login' %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <script>
        (function() {
            // HTTPS enforcement
            if (window.location.protocol !== 'https:'
                && window.location.hostname !== 'localhost'
                && window.location.hostname !== '127.0.0.1'
                && window.location.hostname !== '::1') {
                window.location.replace(
                    'https://' + window.location.hostname + window.location.pathname + window.location.search
                );
            }
            // Prevent theme flickering
            try {
                var serverTheme = '<%= typeof currentTheme !== "undefined" ? currentTheme : "" %>';
                var savedTheme = localStorage.getItem('theme') || serverTheme || 'dark';
                if (savedTheme === 'light') {
                    document.documentElement.classList.add('light-theme');
                } else {
                    document.documentElement.classList.remove('light-theme');
                }
            } catch (_) {}

            // Auto-align language from localStorage if not explicitly requested in query
            try {
                var url = new URL(window.location.href);
                var savedLang = localStorage.getItem('lang');
                if (savedLang && (savedLang === 'ar' || savedLang === 'en') && !url.searchParams.has('lang')) {
                    var serverLang = '<%= currentLang %>';
                    if (savedLang !== serverLang) {
                        url.searchParams.set('lang', savedLang);
                        window.location.replace(url.toString());
                    }
                }
            } catch (_) {}
        })();
    </script>
    <style>
        :root {
            --bg-primary: #050507;
            --bg-secondary: #0b0b0e;
            --bg-card: rgba(13, 13, 18, 0.88);
            --border-primary: rgba(255, 255, 255, 0.08);
            --border-input: #27272a;
            --text-primary: #f4f4f5;
            --text-secondary: #a1a1aa;
            --text-muted: #71717a;
            --input-bg: #121217;
            --accent-color: #cc090c;
            --accent-hover: #e62629;
            --accent-dark: #7b0002;
            --top-half-bg: #07070a;
            --top-half-title: #ffffff;
            --top-half-subtitle: #a1a1aa;
            --bottom-half-from: #7b0002;
            --bottom-half-to: #180001;
            --control-bg: rgba(255, 255, 255, 0.08);
            --control-border: rgba(255, 255, 255, 0.12);
            --control-text: #e4e4e7;
            --control-hover: rgba(255, 255, 255, 0.16);
            --card-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 35px rgba(204, 9, 12, 0.15);
        }

        .light-theme {
            --bg-primary: #f8fafc;
            --bg-secondary: #ffffff;
            --bg-card: #ffffff;
            --border-primary: #e2e8f0;
            --border-input: #cbd5e1;
            --text-primary: #0f172a;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --input-bg: #f8fafc;
            --accent-color: #b91c1c;
            --accent-hover: #991b1b;
            --accent-dark: #7b0002;
            --top-half-bg: #ffffff;
            --top-half-title: #0f172a;
            --top-half-subtitle: #64748b;
            --bottom-half-from: #7b0002;
            --bottom-half-to: #3a0002;
            --control-bg: rgba(0, 0, 0, 0.05);
            --control-border: rgba(0, 0, 0, 0.12);
            --control-text: #1e293b;
            --control-hover: rgba(0, 0, 0, 0.10);
            --card-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 30px rgba(185, 28, 28, 0.08);
        }

        body {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background-color: var(--bg-primary);
            color: var(--text-primary);
            transition: background-color 0.25s ease, color 0.25s ease;
        }

        /* Language specific overrides */
        [dir="rtl"] {
            font-family: 'JetBrains Mono', 'Cairo', monospace !important;
        }

        /* Top and Bottom Sections */
        .login-top-half {
            background-color: var(--top-half-bg);
            transition: background-color 0.25s ease;
        }
        .login-top-title {
            color: var(--top-half-title);
            transition: color 0.25s ease;
        }
        .login-bottom-half {
            background: linear-gradient(to bottom, var(--bottom-half-from), var(--bottom-half-to));
            transition: background 0.3s ease;
        }

        /* Card Container */
        .login-main-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-primary);
            box-shadow: var(--card-shadow);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        }

        /* Input Controls */
        .login-input-wrapper {
            background-color: var(--input-bg);
            border: 1px solid var(--border-input);
            transition: all 0.2s ease;
        }
        .login-input-wrapper:focus-within {
            border-color: var(--accent-color);
            box-shadow: 0 0 0 2px rgba(204, 9, 12, 0.25);
        }
        .login-field-input {
            color: var(--text-primary);
        }
        .login-field-input::placeholder {
            color: var(--text-muted);
        }

        /* Theme Logo Switching */
        .logo-dark-theme { display: block; }
        .logo-light-theme { display: none; }
        .light-theme .logo-dark-theme { display: none; }
        .light-theme .logo-light-theme { display: block; }

        /* Theme Toggle Icon Switching */
        .theme-icon-sun { display: block; }
        .theme-icon-moon { display: none; }
        .light-theme .theme-icon-sun { display: none; }
        .light-theme .theme-icon-moon { display: block; }

        /* Top Bar Controls */
        .login-ctrl-btn {
            background-color: var(--control-bg);
            border: 1px solid var(--control-border);
            color: var(--control-text);
            transition: all 0.2s ease;
        }
        .login-ctrl-btn:hover {
            background-color: var(--control-hover);
        }

        /* Logo breathing and floating animation */
        @keyframes float-breathing {
            0%, 100% { transform: translateY(0) scale(1); }
            50% { transform: translateY(-6px) scale(1.03); }
        }
        .logo-float-animation {
            animation: float-breathing 4s ease-in-out infinite;
        }

        /* Button shutter effect */
        button {
            position: relative;
            overflow: hidden;
            isolation: isolate;
        }
        button::before {
            content: "";
            position: absolute;
            z-index: -1;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            transform: scaleX(1);
            transform-origin: 50%;
            transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
            background: rgba(0, 0, 0, 0.25);
        }
        button:hover::before, button:focus-visible::before {
            transform: scaleX(0);
        }
    
        /* Anatomy Skill High-Contrast Theme Variables */
        .iso {
            --anatomy-page: #050507;
            --anatomy-card: #0d0d12;
            --anatomy-paper: #181820;
            --anatomy-face: #22222d;
            --anatomy-top: #2c2c3b;
            --anatomy-shade-0: #14141c;
            --anatomy-shade-1: #1a1a24;
            --anatomy-shade-2: #21212e;
            --anatomy-shade-3: #282837;
            --anatomy-lit-top: #3b3b4f;
            --anatomy-lit-shade: #2e2e3e;
            --anatomy-hi: #e4e4e7;
            --anatomy-mid: #a1a1aa;
            --anatomy-lo: #52525b;
            --anatomy-faint: #3f3f46;
            --anatomy-lit: #ffffff;
            --anatomy-dot: #f4f4f5;
            --anatomy-red: #ef4444;
            --anatomy-green: #10b981;
            --anatomy-blue: #38bdf8;
            --anatomy-halo: transparent;
            --anatomy-weight: 0.85px;
            --anatomy-mono: 'JetBrains Mono', 'Cairo', monospace;
        }

                .light-theme .iso {
            --anatomy-page: #ffffff;
            --anatomy-card: #ffffff;
            --anatomy-paper: #f1f5f9;
            --anatomy-face: #e2e8f0;
            --anatomy-top: #ffffff;
            --anatomy-shade-0: #94a3b8;
            --anatomy-shade-1: #cbd5e1;
            --anatomy-shade-2: #e2e8f0;
            --anatomy-shade-3: #f1f5f9;
            --anatomy-lit-top: #ffffff;
            --anatomy-lit-shade: #e2e8f0;
            --anatomy-hi: #0f172a;
            --anatomy-mid: #334155;
            --anatomy-lo: #64748b;
            --anatomy-faint: #94a3b8;
            --anatomy-lit: #0284c7;
            --anatomy-dot: #0f172a;
            --anatomy-red: #dc2626;
            --anatomy-green: #047857;
            --anatomy-blue: #0284c7;
            --anatomy-halo: transparent;
            --anatomy-weight: 0.85px;
            --anatomy-mono: 'JetBrains Mono', 'Cairo', monospace;
        }

        .iso-svg { display: block; width: 100%; height: auto; overflow: visible; }
        .iso-svg path, .iso-svg circle, .iso-svg line { vector-effect: non-scaling-stroke; }
        .iso-fill { fill: var(--anatomy-paper); stroke: none; }
        .iso-solid[data-lit] > .iso-fill { fill: var(--anatomy-face); }
        .iso-shade, .iso-top { stroke: none; }
        .iso-shade[data-shade="0"] { fill: var(--anatomy-shade-0); }
        .iso-shade[data-shade="1"] { fill: var(--anatomy-shade-1); }
        .iso-shade[data-shade="2"] { fill: var(--anatomy-shade-2); }
        .iso-shade[data-shade="3"] { fill: var(--anatomy-shade-3); }
        .iso-top { fill: var(--anatomy-top); }
        .iso-solid[data-lit] > .iso-top { fill: var(--anatomy-lit-top); }
        .iso-solid[data-lit] > .iso-shade { fill: var(--anatomy-lit-shade); }
        .iso-solid[data-seamless] > .iso-shade, .iso-solid[data-seamless] > .iso-top { stroke-width: 0.4; stroke-linejoin: round; }
        .iso-solid[data-seamless] > .iso-shade[data-shade="0"] { stroke: var(--anatomy-shade-0); }
        .iso-solid[data-seamless] > .iso-shade[data-shade="1"] { stroke: var(--anatomy-shade-1); }
        .iso-solid[data-seamless] > .iso-shade[data-shade="2"] { stroke: var(--anatomy-shade-2); }
        .iso-solid[data-seamless] > .iso-shade[data-shade="3"] { stroke: var(--anatomy-shade-3); }
        .iso-solid[data-seamless] > .iso-top { stroke: var(--anatomy-top); }
        .iso-solid > .iso-edge { fill: none; stroke: var(--anatomy-mid); stroke-width: var(--anatomy-weight); stroke-linejoin: round; }
        .iso-solid[data-tone="hi"] > .iso-edge { stroke: var(--anatomy-hi); }
        .iso-solid[data-tone="lo"] > .iso-edge { stroke: var(--anatomy-lo); }
        .iso-solid[data-tone="faint"] > .iso-edge { stroke: var(--anatomy-faint); }
        .iso-solid[data-lit] > .iso-edge { stroke: var(--anatomy-lit); }
        .iso-crease { fill: none; stroke: var(--anatomy-lo); stroke-width: var(--anatomy-weight); stroke-linejoin: round; }
        .iso-bevel { fill: none; stroke: var(--anatomy-hi); stroke-width: var(--anatomy-weight); stroke-linejoin: round; }
        .iso-halo { fill: var(--anatomy-halo, rgba(0,0,0,0.5)); stroke: none; filter: blur(6px); opacity: 0.45; }
        .iso-line { fill: none; stroke: var(--anatomy-lo); stroke-width: var(--anatomy-weight); stroke-linecap: round; stroke-linejoin: round; }
        .iso-line[data-tone="hi"] { stroke: var(--anatomy-hi); }
        .iso-line[data-tone="mid"] { stroke: var(--anatomy-mid); }
        .iso-line[data-tone="lo"] { stroke: var(--anatomy-lo); }
        .iso-line[data-tone="faint"] { stroke: var(--anatomy-faint); }
        .iso-line[data-tone="lit"] { stroke: var(--anatomy-lit); }
        .iso-dots circle { fill: var(--anatomy-dot); stroke: none; opacity: 0.8; }
        .iso-dots[data-tone="hi"] circle { opacity: 0.95; }
        .iso-dots[data-tone="lit"] circle { opacity: 1; fill: var(--anatomy-lit); }
        .iso-wire { fill: none; stroke: var(--anatomy-lo); stroke-width: 1.2px; stroke-linecap: round; stroke-linejoin: round; }
        .iso-wire-end { fill: var(--anatomy-paper); stroke: var(--anatomy-hi); stroke-width: 1px; }

    </style>
</head>
<body>
    <!-- Floating Top Header: Language and Theme Controls -->
    <header class="absolute top-0 right-0 z-30 p-3 sm:p-5 flex items-center justify-end pointer-events-auto select-none" dir="ltr">
        <!-- Controls: Theme Toggle & Language Switcher -->
        <div class="flex items-center gap-2 sm:gap-2.5">
            <!-- Theme Toggle Button -->
            <button id="themeToggleBtn" type="button" onclick="toggleTheme()" class="login-ctrl-btn flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold cursor-pointer backdrop-blur-md" title="<%= isRtl ? 'تبديل المظهر (ليلي / نهاري)' : 'Toggle Theme (Dark / Light)' %>" aria-label="<%= isRtl ? 'تبديل المظهر' : 'Toggle Theme' %>">
                <!-- Sun Icon (Shown in Dark Mode) -->
                <svg class="theme-icon-sun w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
                </svg>
                <!-- Moon Icon (Shown in Light Mode) -->
                <svg class="theme-icon-moon w-3.5 h-3.5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
                <span id="themeLabelText" class="hidden sm:inline text-[11px]">
                    <%= isRtl ? 'المظهر' : 'Theme' %>
                </span>
            </button>

            <!-- Language Switcher: Segmented Control -->
            <div class="flex items-center p-0.5 rounded-full login-ctrl-btn backdrop-blur-md text-[11px] font-bold" role="group" aria-label="<%= isRtl ? 'اختيار اللغة' : 'Select Language' %>">
                <!-- English Button -->
                <button type="button" onclick="setLanguage('en')" class="px-2.5 py-1 rounded-full cursor-pointer transition-all duration-200 <%= currentLang === 'en' ? 'bg-red-600 text-white shadow-sm font-black' : 'opacity-70 hover:opacity-100' %>" aria-pressed="<%= currentLang === 'en' %>">
                    EN
                </button>
                <!-- Arabic Button -->
                <button type="button" onclick="setLanguage('ar')" class="px-2.5 py-1 rounded-full cursor-pointer transition-all duration-200 <%= currentLang === 'ar' ? 'bg-red-600 text-white shadow-sm font-black' : 'opacity-70 hover:opacity-100' %>" aria-pressed="<%= currentLang === 'ar' %>">
                    العربية
                </button>
            </div>
        </div>
    </header>

    <!-- Opposite Side: GSM Gateway Anatomy -->
    <div id="gsmGatewayStandalone" class="iso absolute top-1/2 left-[25%] -translate-x-1/2 -translate-y-1/2 z-20 w-36 sm:w-44 md:w-56 lg:w-64 xl:w-[280px] 2xl:w-[320px] max-w-[24vw] sm:max-w-none pointer-events-none select-none bg-transparent border-0 border-none shadow-none">
        <div class="w-full aspect-[3/2] flex items-center justify-center bg-transparent border-0 border-none shadow-none">
            <svg viewBox="0 0 600 400" width="100%" height="100%" class="iso-svg select-none" style="display:block;background:transparent;border:none;overflow:visible;">
<style>

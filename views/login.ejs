    <!-- Live Motion Script for Dongle & Sokrat VoIP Console -->
    <script>
        function initDongleAnatomyMotion() {
            const simTrays = document.querySelectorAll("#simTrayGroup");
            const signKeys = document.querySelectorAll("#loginKeyGroup");
            const dongleLeds = document.querySelectorAll("#dongleStatusLed");
            const readouts = document.querySelectorAll("[data-readout]");

            let clock = 0;
            let last = 0;

            function tick(now) {
                const dt = last ? Math.min((now - last) / 1000, 1 / 30) : 1 / 60;
                last = now;
                clock += dt;

                const t = clock % 7.0;

                // 1. SIM Tray glides in (0.3s to 2.0s)
                let simOffset = 0;
                if (t < 0.3) {
                    simOffset = 0;
                    readouts.forEach(r => r.textContent = "SIM TRAY EXTENDED · INSERTING...");
                    dongleLeds.forEach(led => {
                        led.style.fill = "#f59e0b";
                        led.style.filter = "drop-shadow(0 0 3px #f59e0b)";
                    });
                } else if (t < 2.0) {
                    const p = Math.min(1, (t - 0.3) / 1.4);
                    const ease = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
                    simOffset = -18.5 * ease;
                    readouts.forEach(r => r.textContent = "SIM TRAY GLIDING IN · 1.8V SMART CARD");
                    const blink = Math.sin((t - 0.3) * 15) > 0;
                    dongleLeds.forEach(led => {
                        led.style.fill = blink ? "#38bdf8" : "#0284c7";
                        led.style.filter = blink ? "drop-shadow(0 0 5px #38bdf8)" : "none";
                    });
                } else {
                    simOffset = -18.5; // seated completely flush
                }

                simTrays.forEach(tray => {
                    const dx = simOffset * 0.98;
                    const dy = simOffset * 0.58;
                    tray.setAttribute("transform", "translate(" + dx.toFixed(2) + " " + dy.toFixed(2) + ")");
                });

                // 2. LED blink -> solid (2.0s to 3.8s)
                if (t >= 2.0 && t < 3.8) {
                    dongleLeds.forEach(led => {
                        led.style.fill = "#38bdf8";
                        led.style.filter = "drop-shadow(0 0 6px #38bdf8)";
                    });
                    readouts.forEach(r => r.textContent = "LTE CARRIER LOCK · SYNCING ASTERISK");
                }

                // 3. Sign-in key presses itself (3.8s to 4.8s)
                let keyDepress = 0;
                if (t >= 3.8 && t < 4.8) {
                    const p = (t - 3.8) / 1.0;
                    keyDepress = Math.sin(p * Math.PI) * 2.5;
                    readouts.forEach(r => r.textContent = "SOKRAT VOIP LOGIN · SIGN-IN ACTIVE");
                }

                signKeys.forEach(key => {
                    const kx = 0;
                    const ky = keyDepress * 1.0;
                    key.setAttribute("transform", "translate(" + kx + " " + ky.toFixed(2) + ")");
                });

                // 4. Settled State (4.8s to 7.0s): "4G · −97 dBm · Registered"
                if (t >= 4.8) {
                    dongleLeds.forEach(led => {
                        led.style.fill = "#34d399";
                        led.style.filter = "drop-shadow(0 0 6px #10b981)";
                    });
                    readouts.forEach(r => r.textContent = "4G · −97 dBm · Registered");
                }

                requestAnimationFrame(tick);
            }

            requestAnimationFrame(tick);
        }

        function toggleMobileAnatomyModal() {
            const modal = document.getElementById("mobileAnatomyModal");
            if (modal) modal.classList.toggle("hidden");
        }
        window.toggleMobileAnatomyModal = toggleMobileAnatomyModal;

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initDongleAnatomyMotion);
        } else {
            initDongleAnatomyMotion();
        }
    </script>

    <!-- Top Half: Brand Logo & Title -->
    <div class="login-top-half min-h-[36vh] h-auto flex flex-col items-center justify-center relative z-10 shrink-0 select-none px-4 pt-10 pb-4 sm:py-8">

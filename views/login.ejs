    <!-- Live Motion Script for SIM Tray Glide & LED State -->
    <script>
        (function() {
            function initDongleMotion() {
                const simTray = document.getElementById("simTrayGroup");
                const dongleLed = document.getElementById("dongleStatusLed");
                if (!simTray && !dongleLed) return;

                let clock = 0;
                let last = 0;

                function tick(now) {
                    const dt = last ? Math.min((now - last) / 1000, 1 / 30) : 1 / 60;
                    last = now;
                    clock += dt;

                    const t = clock % 6.0;

                    // 1. SIM Tray glides in (0.4s to 2.2s)
                    let simOffset = 0;
                    if (t < 0.4) {
                        simOffset = 0; // extended
                        if (dongleLed) {
                            dongleLed.style.fill = "#f59e0b";
                            dongleLed.style.filter = "drop-shadow(0 0 3px #f59e0b)";
                        }
                    } else if (t < 2.2) {
                        const p = Math.min(1, (t - 0.4) / 1.6);
                        const ease = p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2;
                        simOffset = -18.0 * ease;

                        // Blinking search LED
                        const blink = Math.sin((t - 0.4) * 16) > 0;
                        if (dongleLed) {
                            dongleLed.style.fill = blink ? "#38bdf8" : "#0284c7";
                            dongleLed.style.filter = blink ? "drop-shadow(0 0 5px #38bdf8)" : "none";
                        }
                    } else {
                        simOffset = -18.0; // seated
                        if (dongleLed) {
                            dongleLed.style.fill = "#34d399";
                            dongleLed.style.filter = "drop-shadow(0 0 6px #10b981)";
                        }
                    }

                    if (simTray) {
                        const dx = simOffset * 0.98;
                        const dy = simOffset * 0.58;
                        simTray.setAttribute("transform", "translate(" + dx.toFixed(2) + " " + dy.toFixed(2) + ")");
                    }

                    requestAnimationFrame(tick);
                }

                requestAnimationFrame(tick);
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", initDongleMotion);
            } else {
                initDongleMotion();
            }
        })();
    </script>
        <div class="flex flex-col items-center gap-2 sm:gap-3">
            <!-- Theme-Aware Brand Logos -->
            <img src="/logo_light_text.png" alt="Sokrat VOIP" class="w-48 h-48 sm:w-64 sm:h-64 max-h-[28vh] max-w-[80vw] object-contain logo-dark-theme">
            <img src="/logo_dark.png" alt="Sokrat VOIP" class="w-48 h-48 sm:w-64 sm:h-64 max-h-[28vh] max-w-[80vw] object-contain logo-light-theme">
            
            <!-- Brand Title -->
            <h1 class="login-top-title text-2xl sm:text-3xl font-black tracking-[0.14em] uppercase mt-1">
                Sokrat <span class="text-[var(--accent-color)]">VOIP</span>
            </h1>
        </div>
    </div>

    <!-- Bottom Half: Deep dark red gradient and login container -->
    <div class="login-bottom-half flex-1 flex items-center justify-center p-4 sm:p-6 relative z-0">
        <div class="w-full max-w-[420px] flex flex-col items-center">
            
            <!-- Error Notification Banner -->
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="w-full mb-4 text-center text-xs font-bold text-red-600 dark:text-red-300 bg-red-50 dark:bg-red-950/70 border border-red-200 dark:border-red-800 rounded-xl px-4 py-3 shadow-md">
                    <% if (isRtl && error === 'Invalid credentials') { %>
                        بيانات الاعتماد غير صالحة. يرجى التحقق من اسم المستخدم وكلمة المرور.
                    <% } else if (isRtl && error === 'Username and password are required') { %>
                        اسم المستخدم وكلمة المرور مطلوبان.
                    <% } else { %>
                        <%= error %>
                    <% } %>
                </div>
            <% } %>

            <!-- Password Reset Success Notification -->
            <% if (typeof reset !== 'undefined' && reset === 'success') { %>
                <div class="w-full bg-emerald-50 dark:bg-emerald-950/70 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 rounded-xl px-4 py-3 text-xs sm:text-sm text-center mb-4 font-bold shadow-md">
                    <%= isRtl ? 'تمت إعادة تعيين كلمة المرور بنجاح. يرجى تسجيل الدخول.' : 'Password reset successful. Please login.' %>
                </div>
            <% } %>

            <!-- Form Card Container -->
            <div class="login-main-card rounded-2xl w-full p-6 sm:p-8 flex flex-col">
                <form id="loginForm" method="POST" action="/login" class="space-y-4">
                    <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/' %>">
                    <input type="hidden" name="lang" id="loginFormLang" value="<%= currentLang %>">
                    <input type="hidden" name="theme" id="loginFormTheme" value="<%= typeof currentTheme !== 'undefined' ? currentTheme : 'dark' %>">
                    
                    <!-- Username -->
                    <div class="space-y-1.5">
                        <label for="username" class="block text-xs font-bold uppercase tracking-wider mb-1 <%= isRtl ? 'text-right' : 'text-left' %>" style="color: var(--text-secondary);">
                            <%= isRtl ? 'اسم المستخدم' : 'Username' %>
                        </label>
                        <div class="login-input-wrapper relative flex items-center rounded-lg overflow-hidden">
                            <div class="<%= isRtl ? 'pr-3.5 pl-1' : 'pl-3.5 pr-1' %> text-[var(--text-muted)]">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </div>
                            <input type="text" id="username" name="username" value="<%= typeof username !== 'undefined' && username ? username : '' %>" placeholder="<%= isRtl ? 'أدخل اسم المستخدم' : 'Enter username' %>" required autocomplete="username" autofocus class="login-field-input w-full h-11 px-3 bg-transparent border-0 focus:outline-none focus:ring-0 text-[14px] font-medium">
                        </div>
                    </div>

                    <!-- Password -->
                    <div class="space-y-1.5">
                        <label for="password" class="block text-xs font-bold uppercase tracking-wider mb-1 <%= isRtl ? 'text-right' : 'text-left' %>" style="color: var(--text-secondary);">
                            <%= isRtl ? 'كلمة المرور' : 'Password' %>
                        </label>
                        <div class="login-input-wrapper relative flex items-center rounded-lg overflow-hidden">
                            <div class="<%= isRtl ? 'pr-3.5 pl-1' : 'pl-3.5 pr-1' %> text-[var(--text-muted)]">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>
                            <input type="password" id="password" name="password" placeholder="••••••••••••" required autocomplete="current-password" class="login-field-input w-full h-11 px-3 bg-transparent border-0 focus:outline-none focus:ring-0 text-[14px]">
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="w-full bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-4 rounded-lg transition-colors flex justify-center items-center gap-2 mt-6 cursor-pointer shadow-lg shadow-red-950/30">
                        <span><%= isRtl ? 'تسجيل الدخول' : 'Sign In' %></span>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="<%= isRtl ? 'rotate-180' : '' %>">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </form>

                <!-- Forgot Password Link -->
                <div class="mt-4 text-center">
                    <a href="javascript:void(0)" onclick="showForgot()" class="text-xs font-bold text-red-600 dark:text-red-400 hover:underline transition-colors cursor-pointer">
                        <%= isRtl ? 'نسيت كلمة المرور؟' : 'Forgot Password?' %>
                    </a>
                </div>

                <!-- Forgot Password Form Block -->
                <div id="forgotForm" class="mt-4 hidden pt-4 border-t" style="border-color: var(--border-primary);">
                    <p class="text-xs mb-3 <%= isRtl ? 'text-right' : 'text-left' %>" style="color: var(--text-secondary);">
                        <%= isRtl ? 'أدخل اسم المستخدم والبريد الإلكتروني لاستعادة الحساب:' : 'Enter your username and email to reset your password:' %>
                    </p>
                    <div class="flex flex-col gap-2.5">
                        <div class="login-input-wrapper relative flex items-center rounded-lg overflow-hidden">
                            <input type="text" id="forgotUsername" placeholder="<%= isRtl ? 'اسم المستخدم' : 'Username' %>" class="login-field-input w-full h-10 px-3 bg-transparent border-0 text-xs focus:outline-none focus:ring-0">
                        </div>
                        <div class="login-input-wrapper relative flex items-center rounded-lg overflow-hidden">
                            <input type="email" id="forgotEmail" name="email" autocomplete="email" placeholder="<%= isRtl ? 'البريد الإلكتروني' : 'email@example.com' %>" class="login-field-input w-full h-10 px-3 bg-transparent border-0 text-xs focus:outline-none focus:ring-0">
                        </div>
                        <div class="flex items-center gap-2 mt-1">
                            <button onclick="sendReset(event)" class="h-10 flex-1 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-bold uppercase tracking-wider cursor-pointer transition shadow-sm">
                                <%= isRtl ? 'إرسال' : 'Send' %>
                            </button>
                            <button type="button" onclick="showForgot()" class="h-10 px-3 rounded-lg text-xs font-semibold login-ctrl-btn cursor-pointer">
                                <%= isRtl ? 'إلغاء' : 'Cancel' %>
                            </button>
                        </div>
                    </div>
                    <p id="forgotMsg" class="text-xs mt-2.5 hidden text-center font-bold"></p>
                </div>
            </div>
            
            <!-- Footer Copyright -->
            <p class="text-[11px] text-white/70 mt-6 text-center select-none font-mono">
                Sokrat Pro Tech est. 1999 - 2026
            </p>
        </div>
    </div>

    <script>
        var uiLabels = {
            sending: '<%= isRtl ? "جاري الإرسال..." : "Sending..." %>',
            send: '<%= isRtl ? "إرسال" : "Send" %>',
            errorMsg: '<%= isRtl ? "حدث خطأ أثناء إرسال الطلب" : "Error sending request" %>'
        };

        // Theme Toggle Functionality
        function applyTheme(theme) {
            var isLight = theme === 'light';
            if (isLight) {
                document.documentElement.classList.add('light-theme');
                document.body.classList.add('light-theme');
            } else {
                document.documentElement.classList.remove('light-theme');
                document.body.classList.remove('light-theme');
            }
            try {
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
                document.cookie = 'theme=' + (isLight ? 'light' : 'dark') + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (_) {}

            var themeInput = document.getElementById('loginFormTheme');
            if (themeInput) {
                themeInput.value = isLight ? 'light' : 'dark';
            }
            
            var label = document.getElementById('themeLabelText');
            if (label) {
                label.textContent = isLight 
                    ? ('<%= isRtl ? "نهاري" : "Light" %>') 
                    : ('<%= isRtl ? "ليلي" : "Dark" %>');
            }
        }

        function toggleTheme() {
            var isCurrentlyLight = document.documentElement.classList.contains('light-theme');
            var newTheme = isCurrentlyLight ? 'dark' : 'light';
            applyTheme(newTheme);
        }

        // Language Switcher Functionality
        function setLanguage(lang) {
            if (lang !== 'en' && lang !== 'ar') return;
            var currentActiveTheme = document.documentElement.classList.contains('light-theme') ? 'light' : 'dark';
            try {
                localStorage.setItem('lang', lang);
                localStorage.setItem('theme', currentActiveTheme);
                document.cookie = 'lang=' + lang + ';path=/;max-age=31536000;SameSite=Lax';
                document.cookie = 'theme=' + currentActiveTheme + ';path=/;max-age=31536000;SameSite=Lax';
            } catch (_) {}

            var url = new URL(window.location.href);
            url.searchParams.set('lang', lang);
            url.searchParams.set('theme', currentActiveTheme);

            // Preserve typed username if user already started typing
            var userField = document.getElementById('username');
            if (userField && userField.value.trim()) {
                url.searchParams.set('username', userField.value.trim());
            }

            window.location.href = url.toString();
        }

        // Toggle forgot password section
        function showForgot() {
            var f = document.getElementById('forgotForm');
            if (f) f.classList.toggle('hidden');
        }

        // Submit forgot password request
        async function sendReset(evt) {
            var username = document.getElementById('forgotUsername').value;
            var email = document.getElementById('forgotEmail').value;
            var btn = evt ? evt.target : document.querySelector('#forgotForm button');
            if (btn) {
                btn.disabled = true;
                btn.textContent = uiLabels.sending;
            }
            try {
                var resp = await fetch('/api/auth/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: username, email: email })
                });
                var data = await resp.json();
                var msg = document.getElementById('forgotMsg');
                msg.classList.remove('hidden');
                msg.textContent = data.message || data.error || (uiLabels.send);
                msg.className = 'text-xs mt-2.5 font-bold ' + (data.success !== false ? 'text-emerald-500' : 'text-red-500');
            } catch(e) {
                var msg = document.getElementById('forgotMsg');
                msg.classList.remove('hidden');
                msg.textContent = uiLabels.errorMsg;
                msg.className = 'text-xs mt-2.5 font-bold text-red-500';
            }
            if (btn) {
                btn.disabled = false;
                btn.textContent = uiLabels.send;
            }
        }

        // Form submission sync
        var loginForm = document.getElementById('loginForm');
        if (loginForm) {
            loginForm.addEventListener('submit', function() {
                var isLight = document.documentElement.classList.contains('light-theme');
                var themeInput = document.getElementById('loginFormTheme');
                if (themeInput) {
                    themeInput.value = isLight ? 'light' : 'dark';
                }
            });
        }

        // Initialize UI state on page load
        document.addEventListener('DOMContentLoaded', function() {
            var serverTheme = '<%= typeof currentTheme !== "undefined" ? currentTheme : "" %>';
            var currentTheme = localStorage.getItem('theme') || serverTheme || 'dark';
            applyTheme(currentTheme);
        });
    </script>
</body>
</html>
        <div class="w-full aspect-[234/172] flex items-center justify-center bg-transparent border-0 border-none shadow-none">
            <svg viewBox="80 42 234 172" width="100%" height="100%" class="iso-svg select-none" style="display:block;background:transparent;border:none;overflow:visible;">

        function filterTimeConditionsTable() {
            const input = document.getElementById('timeconditions-search-input') || document.getElementById('timecondition-search-input');
            if (!input) return;
            const q = input.value.trim().toLowerCase();
            const rows = document.querySelectorAll('.timecondition-row');
            rows.forEach(row => {
                const search = row.getAttribute('data-search') || '';
                const text = row.textContent.toLowerCase();
                if (!q || search.includes(q) || text.includes(q)) {
                    row.classList.remove('hidden');
                } else {
                    row.classList.add('hidden');
                }
            });
        }


        // Shared upload helper: uploads a system recording (file + display name +
        // initial headroom) and returns the API result. Used by the System
        // Recordings tab and by the Announcements modal.
        function uploadRecordingFile(file, name, gainDb, onProgress) {
            return new Promise((resolve, reject) => {
                const formData = new FormData();
                formData.append('file', file);
                formData.append('name', String(name || '').trim());
                formData.append('gainDb', (gainDb === undefined || gainDb === null || gainDb === '') ? '0' : String(gainDb));
                const xhr = new XMLHttpRequest();
                xhr.upload.addEventListener('progress', (ev) => {
                    if (ev.lengthComputable && typeof onProgress === 'function') {
                        onProgress(Math.round((ev.loaded / ev.total) * 100));
                    }
                });
                xhr.addEventListener('load', () => {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        try { resolve(JSON.parse(xhr.responseText)); }
                        catch (err) { reject({ error: 'Invalid server response' }); }
                    } else {
                        try { reject(JSON.parse(xhr.responseText)); }
                        catch (err) { reject({ error: 'HTTP ' + xhr.status }); }
                    }
                });
                xhr.addEventListener('error', () => reject({ error: 'Network error' }));
                xhr.open('POST', '/api/settings/recordings/upload');
                xhr.send(formData);
            });
        }

        async function uploadSystemRecording(e) {
            e.preventDefault();
            const nameInput = document.getElementById('sysRecName');
            const fileInput = document.getElementById('sysRecFile');
            const submitBtn = document.getElementById('sysRecSubmitBtn');
            const progressWrap = document.getElementById('sysRecProgressWrap');
            const progressBar = document.getElementById('sysRecProgressBar');
            const percentText = document.getElementById('sysRecPercent');
            const statusText = document.getElementById('sysRecStatus');

            if (!fileInput.files.length) {
                showToast('Please select an audio file.', 'error');
                return;
            }

            submitBtn.disabled = true;
            progressWrap.classList.remove('hidden');
            progressBar.style.width = '0%';
            percentText.textContent = '0%';
            statusText.textContent = 'Uploading & converting...';

            try {
                const gainSelect = document.getElementById('sysRecGain');
                const result = await uploadRecordingFile(
                    fileInput.files[0],
                    nameInput.value,
                    gainSelect ? gainSelect.value : '0',
                    (pct) => {
                        progressBar.style.width = pct + '%';
                        percentText.textContent = pct + '%';
                    }
                );

                if (result.success) {
                    showToast(result.message, 'success');
                    document.getElementById('systemRecordingUploadForm').reset();
                    fetchRecordings();
                } else {
                    showToast(result.error || 'Upload failed', 'error');
                }
            } catch (err) {
                showToast(err.error || err.message || 'Upload failed', 'error');
            } finally {
                submitBtn.disabled = false;
                setTimeout(() => {
                    progressWrap.classList.add('hidden');
                    progressBar.style.width = '0%';
                }, 3000);
            }
        }

        let activeRecordingAudio = null;
        let activeRecordingBtn = null;

        function togglePlayRecording(id, btn) {
            const url = `/api/config/recordings/audio/${id}`;

            if (activeRecordingAudio && activeRecordingBtn === btn) {
                if (activeRecordingAudio.paused) {
                    activeRecordingAudio.play();
                    setPlayBtnState(btn, true);
                } else {
                    activeRecordingAudio.pause();
                    setPlayBtnState(btn, false);
                }
                return;
            }

            if (activeRecordingAudio) {
                activeRecordingAudio.pause();
                if (activeRecordingBtn) setPlayBtnState(activeRecordingBtn, false);
            }

            activeRecordingAudio = new Audio(url);
            activeRecordingBtn = btn;

            activeRecordingAudio.addEventListener('play', () => setPlayBtnState(btn, true));
            activeRecordingAudio.addEventListener('pause', () => setPlayBtnState(btn, false));
            activeRecordingAudio.addEventListener('ended', () => {
                setPlayBtnState(btn, false);
                activeRecordingAudio = null;
                activeRecordingBtn = null;
            });

            activeRecordingAudio.play().catch(err => {
                showToast("Playback error: " + err.message, "error");
                setPlayBtnState(btn, false);
            });
        }

        function setPlayBtnState(btn, isPlaying) {
            if (!btn) return;
            const span = btn.querySelector('span');
            const svg = btn.querySelector('svg');
            const isRtl = '<%= isRtl %>' === 'true';

            if (isPlaying) {
                if (span) span.textContent = isRtl ? 'إيقاف' : 'Pause';
                if (svg) {
                    svg.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
                    svg.setAttribute('class', 'w-3 h-3 fill-emerald-400');
                    svg.setAttribute('viewBox', '0 0 24 24');
                }
            } else {
                if (span) span.textContent = isRtl ? 'تشغيل' : 'Play';
                if (svg) {
                    svg.innerHTML = '<path d="M8 5v14l11-7z"/>';
                    svg.setAttribute('class', 'w-3 h-3 fill-emerald-400');
                    svg.setAttribute('viewBox', '0 0 24 24');
                }
            }
        }

        function deleteRecording(id) {
            const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(id));
            const name = rec ? (rec.displayname || ('#' + id)) : ('#' + id);
            const confirmMsg = isRtl
                ? `هل أنت متأكد من حذف التسجيل الصوتي '${name}' (رقم #${id})؟`
                : `Delete system recording '${name}' (ID #${id})?`;
            if (!confirm(confirmMsg)) return;
            fetch('/api/config/recordings/' + id, { method: 'DELETE' })
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    return res.json();
                })
                .then(data => {
                    if (data.success) {
                        showToast(data.message || (isRtl ? 'تم حذف التسجيل بنجاح' : 'Recording deleted successfully'), 'success');
                        fetchRecordings();
                    } else {
                        showToast(data.error || (isRtl ? 'فشل حذف التسجيل' : 'Failed to delete recording'), 'error');
                    }
                })
                .catch(err => {
                    if (err.message !== 'Unauthorized') {
                        showToast(err.message || (isRtl ? 'خطأ في الاتصال بالخادم' : 'Server connection error'), 'error');
                    }
                });
        }
        window.fetchRecordings = fetchRecordings;
        window.uploadSystemRecording = uploadSystemRecording;
        window.uploadRecording = uploadSystemRecording;
        window.togglePlayRecording = togglePlayRecording;
        window.deleteRecording = deleteRecording;
        window.setPlayBtnState = setPlayBtnState;
        async function saveRecordingVolume(id) {
            const input = document.getElementById('recGainRange_' + id);
            if (!input) return;
            const gainDb = parseInt(input.value, 10);
            const isRtl = '<%= isRtl %>' === 'true';

            try {
                const res = await fetch(`/api/config/recordings/${id}/volume`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gainDb })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || (isRtl ? 'تم تحديث مستوى الصوت بنجاح' : 'Volume updated successfully'), 'success');
                    const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(id));
                    if (rec) rec.gain_db = data.gainDb;
                    const badge = document.getElementById('recGainBadge_' + id);
                    if (badge) {
                        badge.textContent = (data.gainDb > 0 ? '+' : '') + data.gainDb + ' dB';
                        badge.className = 'font-mono font-bold text-xs ' + (data.gainDb === 0 ? 'text-[var(--text-muted)]' : (data.gainDb < 0 ? 'text-amber-400' : 'text-emerald-400'));
                    }
                } else {
                    showToast(data.error || 'Failed to update volume', 'error');
                }
            } catch (err) {
                showToast(err.message || 'Error updating volume', 'error');
            }
        }

        function setRecordingGainQuick(id, gainDb) {
            const input = document.getElementById('recGainRange_' + id);
            const badge = document.getElementById('recGainBadge_' + id);
            if (input) input.value = gainDb;
            if (badge) {
                badge.textContent = (gainDb > 0 ? '+' : '') + gainDb + ' dB';
                badge.className = 'font-mono font-bold text-xs ' + (gainDb === 0 ? 'text-[var(--text-muted)]' : (gainDb < 0 ? 'text-amber-400' : 'text-emerald-400'));
            }
            saveRecordingVolume(id);
        }

        window.saveRecordingVolume = saveRecordingVolume;
        window.setRecordingGainQuick = setRecordingGainQuick;

        let studioPreviewAudio = null;

        // The studio works on two kinds of targets: a system recording
        // (asterisk.recordings) or a Music-on-Hold track (a file inside a MoH
        // category folder). The target descriptor drives every URL the modal
        // talks to.
        let studioTarget = { kind: 'recording', id: null, category: '', filename: '', label: '' };

        function studioEndpoints() {
            if (studioTarget && studioTarget.kind === 'moh') {
                const cat = encodeURIComponent(studioTarget.category || '');
                const file = encodeURIComponent(studioTarget.filename || '');
                return {
                    info: `/api/config/moh/file/info?category=${cat}&file=${file}`,
                    audio: `/api/config/moh/stream/${cat}/${file}`,
                    dsp: '/api/config/moh/file/dsp'
                };
            }
            const id = (studioTarget && studioTarget.id) || '';
            return {
                info: `/api/config/recordings/${id}/info`,
                audio: `/api/config/recordings/audio/${id}`,
                dsp: `/api/config/recordings/${id}/dsp`
            };
        }
        window.studioEndpoints = studioEndpoints;

        // Open the studio for a Music-on-Hold track.
        async function openMohStudioModal(category, filename) {
            const cat = String(category || '').trim();
            const file = String(filename || '').trim();
            if (!cat || !file) return;
            closeAllModals();
            studioTarget = { kind: 'moh', id: null, category: cat, filename: file, label: file };
            document.getElementById('dspRecId').value = file;
            document.getElementById('dspRecFilename').value = file;
            document.getElementById('dspDisplayTitle').textContent = file;
            document.getElementById('dspTargetNameBadge').textContent = cat + ' / ' + file;
            if (studioPreviewAudio) {
                studioPreviewAudio.pause();
                studioPreviewAudio = null;
            }
            const playIcon = document.getElementById('dspPlayIcon');
            if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';

            try {
                const res = await fetch(studioEndpoints().info);
                const data = await res.json();
                if (!res.ok || !data.success) {
                    showToast(data.error || 'Could not load the MoH track.', 'error');
                    return;
                }
                if (data.dspSettings && typeof data.dspSettings === 'object') {
                    const s = data.dspSettings;
                    if (s.normDb !== undefined && s.normDb !== null) document.getElementById('dspNormDb').value = String(s.normDb);
                    if (s.gainDb !== undefined && s.gainDb !== null) {
                        document.getElementById('dspGainDb').value = s.gainDb;
                        document.getElementById('dspGainBadge').textContent = (s.gainDb > 0 ? '+' : '') + s.gainDb + ' dB';
                    }
                    if (s.compand) document.getElementById('dspCompand').value = s.compand;
                } else if (data.gainDb) {
                    document.getElementById('dspGainDb').value = data.gainDb;
                    document.getElementById('dspGainBadge').textContent = (data.gainDb > 0 ? '+' : '') + data.gainDb + ' dB';
                }
                if (data.stat) {
                    if (data.stat.length) document.getElementById('dspStatDuration').textContent = data.stat.length + 's';
                    if (data.stat.maxAmplitude) document.getElementById('dspStatPeak').textContent = data.stat.maxAmplitude;
                    if (data.stat.rmsAmplitude) document.getElementById('dspStatRms').textContent = data.stat.rmsAmplitude;
                }
            } catch (err) {
                console.error('MoH studio load error:', err.message);
            }

            openModal('recordingStudioModal');
            if (typeof syncStudioSilenceControls === 'function') syncStudioSilenceControls();
        }
        window.openMohStudioModal = openMohStudioModal;

        async function openRecordingStudioModal(id) {
            closeAllModals();
            const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(id));
            if (!rec) return;
            studioTarget = { kind: 'recording', id: id, category: '', filename: rec.filename || '', label: rec.displayname || ('#' + id) };

            document.getElementById('dspRecId').value = id;
            document.getElementById('dspRecFilename').value = rec.filename || '';
            document.getElementById('dspDisplayTitle').textContent = rec.displayname || ('#' + id);
            document.getElementById('dspTargetNameBadge').textContent = '#' + id + ' ' + (rec.displayname || '');

            if (studioPreviewAudio) {
                studioPreviewAudio.pause();
                studioPreviewAudio = null;
            }
            const playIcon = document.getElementById('dspPlayIcon');
            if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';

            // Reset UI controls to defaults before fetching
            document.getElementById('dspNormDb').value = '-18';
            document.getElementById('dspGainDb').value = '0';
            document.getElementById('dspGainBadge').textContent = '0 dB';
            document.getElementById('dspCompand').value = 'off';
            document.getElementById('dspFadeIn').value = '0.05';
            document.getElementById('dspFadeOut').value = '0.05';
            document.getElementById('dspBandpass').checked = true;
            document.getElementById('dspHissFilter').checked = false;
            document.getElementById('dspBass').value = '0';
            document.getElementById('dspBassBadge').textContent = '0 dB';
            document.getElementById('dspTreble').value = '0';
            document.getElementById('dspTrebleBadge').textContent = '0 dB';
            document.getElementById('dspTrimSilence').checked = true;
            document.getElementById('dspTempo').value = '1.00';
            document.getElementById('dspTempoBadge').textContent = '1.00x';
            document.getElementById('dspEnablePadLead').checked = true;
            document.getElementById('dspEnablePadTrail').checked = true;
            document.getElementById('dspPadLead').value = '0.20';
            document.getElementById('dspPadLeadRange').value = '0.20';
            document.getElementById('dspPadTrail').value = '0.20';
            document.getElementById('dspPadTrailRange').value = '0.20';
            document.getElementById('dspGenerateCodecs').checked = true;
            syncStudioSilenceControls();
            try {
                const res = await fetch(studioEndpoints().info);
                if (res.ok) {
                    const data = await res.json();
                    if (data.stat) {
                        document.getElementById('dspStatDuration').textContent = data.stat.length ? data.stat.length + 's' : '-';
                        document.getElementById('dspStatPeak').textContent = data.stat.maxAmplitude ? data.stat.maxAmplitude : '-';
                        document.getElementById('dspStatRms').textContent = data.stat.rmsAmplitude ? data.stat.rmsAmplitude : '-';
                    }
                    if (data.codecs) {
                        document.getElementById('dspGsmStatus').innerHTML = data.codecs.gsm ? '<span class="text-emerald-400 font-bold">✓</span>' : '<span class="text-[var(--text-muted)]">-</span>';
                        document.getElementById('dspAlawStatus').innerHTML = data.codecs.alaw ? '<span class="text-emerald-400 font-bold">✓</span>' : '<span class="text-[var(--text-muted)]">-</span>';
                        document.getElementById('dspUlawStatus').innerHTML = data.codecs.ulaw ? '<span class="text-emerald-400 font-bold">✓</span>' : '<span class="text-[var(--text-muted)]">-</span>';
                    }
                    if (data.dspSettings && typeof data.dspSettings === 'object') {
                        const s = data.dspSettings;
                        if (s.normDb !== undefined && s.normDb !== null) document.getElementById('dspNormDb').value = String(s.normDb);
                        if (s.gainDb !== undefined && s.gainDb !== null) {
                            document.getElementById('dspGainDb').value = s.gainDb;
                            document.getElementById('dspGainBadge').textContent = (s.gainDb > 0 ? '+' : '') + s.gainDb + ' dB';
                        }
                        if (s.compand) document.getElementById('dspCompand').value = s.compand;
                        if (s.fadeIn !== undefined) document.getElementById('dspFadeIn').value = s.fadeIn;
                        if (s.fadeOut !== undefined) document.getElementById('dspFadeOut').value = s.fadeOut;
                        if (s.bandpass !== undefined) document.getElementById('dspBandpass').checked = Boolean(s.bandpass);
                        if (s.hissFilter !== undefined) document.getElementById('dspHissFilter').checked = Boolean(s.hissFilter);
                        if (s.bass !== undefined) {
                            document.getElementById('dspBass').value = s.bass;
                            document.getElementById('dspBassBadge').textContent = (s.bass > 0 ? '+' : '') + s.bass + ' dB';
                        }
                        if (s.treble !== undefined) {
                            document.getElementById('dspTreble').value = s.treble;
                            document.getElementById('dspTrebleBadge').textContent = (s.treble > 0 ? '+' : '') + s.treble + ' dB';
                        }
                        if (s.trimSilence !== undefined) document.getElementById('dspTrimSilence').checked = Boolean(s.trimSilence);
                        if (s.tempo !== undefined) {
                            document.getElementById('dspTempo').value = s.tempo;
                            document.getElementById('dspTempoBadge').textContent = parseFloat(s.tempo).toFixed(2) + 'x';
                        }
                        if (s.enablePadLead !== undefined) document.getElementById('dspEnablePadLead').checked = Boolean(s.enablePadLead);
                        if (s.enablePadTrail !== undefined) document.getElementById('dspEnablePadTrail').checked = Boolean(s.enablePadTrail);
                        if (s.padLead !== undefined) {
                            document.getElementById('dspPadLead').value = s.padLead;
                            document.getElementById('dspPadLeadRange').value = s.padLead;
                        }
                        if (s.padTrail !== undefined) {
                            document.getElementById('dspPadTrail').value = s.padTrail;
                            document.getElementById('dspPadTrailRange').value = s.padTrail;
                        }
                        syncStudioSilenceControls();
                        if (s.generateCodecs !== undefined) document.getElementById('dspGenerateCodecs').checked = Boolean(s.generateCodecs);
                    }
                }
            } catch (_) {}

            openModal('recordingStudioModal');
        }
        function syncStudioSilenceControls() {
            const enableLeadEl = document.getElementById('dspEnablePadLead');
            const enableTrailEl = document.getElementById('dspEnablePadTrail');
            if (!enableLeadEl || !enableTrailEl) return;

            const isRtl = '<%= isRtl %>' === 'true';
            const enableLead = enableLeadEl.checked;
            const enableTrail = enableTrailEl.checked;

            const leadVal = enableLead ? (parseFloat(document.getElementById('dspPadLead').value) || 0) : 0;
            const trailVal = enableTrail ? (parseFloat(document.getElementById('dspPadTrail').value) || 0) : 0;

            document.getElementById('dspPadLeadRange').disabled = !enableLead;
            document.getElementById('dspPadLead').disabled = !enableLead;
            document.getElementById('dspPadTrailRange').disabled = !enableTrail;
            document.getElementById('dspPadTrail').disabled = !enableTrail;

            document.getElementById('dspPadLeadBadge').textContent = enableLead ? leadVal.toFixed(2) + 's' : (isRtl ? 'معطل' : 'Off');
            document.getElementById('dspPadTrailBadge').textContent = enableTrail ? trailVal.toFixed(2) + 's' : (isRtl ? 'معطل' : 'Off');

            const preBox = document.getElementById('timelinePreRoll');
            const preVal = document.getElementById('timelinePreRollVal');
            if (preBox && preVal) {
                preVal.textContent = enableLead ? `+${leadVal.toFixed(2)}s` : '0.00s';
                preBox.style.opacity = enableLead ? '1' : '0.4';
            }

            const postBox = document.getElementById('timelinePostRoll');
            const postVal = document.getElementById('timelinePostRollVal');
            if (postBox && postVal) {
                postVal.textContent = enableTrail ? `+${trailVal.toFixed(2)}s` : '0.00s';
                postBox.style.opacity = enableTrail ? '1' : '0.4';
            }
        }

        function syncStudioSilenceFromRange(type) {
            if (type === 'lead') {
                const val = parseFloat(document.getElementById('dspPadLeadRange').value) || 0;
                document.getElementById('dspPadLead').value = val.toFixed(2);
            } else {
                const val = parseFloat(document.getElementById('dspPadTrailRange').value) || 0;
                document.getElementById('dspPadTrail').value = val.toFixed(2);
            }
            syncStudioSilenceControls();
        }

        function syncStudioSilenceFromInput(type) {
            if (type === 'lead') {
                const val = Math.max(0, Math.min(10, parseFloat(document.getElementById('dspPadLead').value) || 0));
                document.getElementById('dspPadLeadRange').value = val;
            } else {
                const val = Math.max(0, Math.min(10, parseFloat(document.getElementById('dspPadTrail').value) || 0));
                document.getElementById('dspPadTrailRange').value = val;
            }
            syncStudioSilenceControls();
        }

        function setStudioSilenceQuick(type, seconds) {
            if (type === 'lead') {
                document.getElementById('dspEnablePadLead').checked = true;
                document.getElementById('dspPadLead').value = seconds.toFixed(2);
                document.getElementById('dspPadLeadRange').value = seconds;
            } else {
                document.getElementById('dspEnablePadTrail').checked = true;
                document.getElementById('dspPadTrail').value = seconds.toFixed(2);
                document.getElementById('dspPadTrailRange').value = seconds;
            }
            syncStudioSilenceControls();
        }


        function toggleStudioAudioPreview() {
            const id = document.getElementById('dspRecId').value;
            if (!id) return;
            const playIcon = document.getElementById('dspPlayIcon');
            const url = `${studioEndpoints().audio}?t=${Date.now()}`;

            if (studioPreviewAudio) {
                if (studioPreviewAudio.paused) {
                    studioPreviewAudio.play();
                    if (playIcon) playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
                } else {
                    studioPreviewAudio.pause();
                    if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
                }
                return;
            }

            studioPreviewAudio = new Audio(url);
            studioPreviewAudio.addEventListener('play', () => {
                if (playIcon) playIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
            });
            studioPreviewAudio.addEventListener('pause', () => {
                if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
            });
            studioPreviewAudio.addEventListener('ended', () => {
                if (playIcon) playIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
                studioPreviewAudio = null;
            });
            studioPreviewAudio.play().catch(err => showToast('Playback error: ' + err.message, 'error'));
        }

        function applyDspPreset(preset) {
            if (preset === 'dongle') {
                document.getElementById('dspNormDb').value = '-18';
                document.getElementById('dspGainDb').value = '0';
                document.getElementById('dspGainBadge').textContent = '0 dB';
                document.getElementById('dspCompand').value = 'off';
                document.getElementById('dspFadeIn').value = '0.05';
                document.getElementById('dspFadeOut').value = '0.05';
                document.getElementById('dspBandpass').checked = true;
                document.getElementById('dspHissFilter').checked = false;
                document.getElementById('dspBass').value = '0';
                document.getElementById('dspBassBadge').textContent = '0 dB';
                document.getElementById('dspTreble').value = '0';
                document.getElementById('dspTrebleBadge').textContent = '0 dB';
                document.getElementById('dspTrimSilence').checked = true;
                document.getElementById('dspTempo').value = '1.00';
                document.getElementById('dspTempoBadge').textContent = '1.00x';
                document.getElementById('dspEnablePadLead').checked = true;
                document.getElementById('dspEnablePadTrail').checked = true;
                document.getElementById('dspPadLead').value = '0.20';
                document.getElementById('dspPadLeadRange').value = '0.20';
                document.getElementById('dspPadTrail').value = '0.20';
                document.getElementById('dspPadTrailRange').value = '0.20';
                syncStudioSilenceControls();
            } else if (preset === 'broadcast') {
                document.getElementById('dspNormDb').value = '-12';
                document.getElementById('dspGainDb').value = '0';
                document.getElementById('dspGainBadge').textContent = '0 dB';
                document.getElementById('dspCompand').value = 'broadcast';
                document.getElementById('dspFadeIn').value = '0.05';
                document.getElementById('dspFadeOut').value = '0.05';
                document.getElementById('dspBandpass').checked = true;
                document.getElementById('dspHissFilter').checked = false;
                document.getElementById('dspBass').value = '2';
                document.getElementById('dspBassBadge').textContent = '+2 dB';
                document.getElementById('dspTreble').value = '1';
                document.getElementById('dspTrebleBadge').textContent = '+1 dB';
                document.getElementById('dspTrimSilence').checked = true;
                document.getElementById('dspTempo').value = '1.00';
                document.getElementById('dspTempoBadge').textContent = '1.00x';
                document.getElementById('dspEnablePadLead').checked = true;
                document.getElementById('dspEnablePadTrail').checked = true;
                document.getElementById('dspPadLead').value = '0.20';
                document.getElementById('dspPadLeadRange').value = '0.20';
                document.getElementById('dspPadTrail').value = '0.20';
                document.getElementById('dspPadTrailRange').value = '0.20';
                syncStudioSilenceControls();
            } else if (preset === 'clean') {
                document.getElementById('dspNormDb').value = '-12';
                document.getElementById('dspGainDb').value = '0';
                document.getElementById('dspGainBadge').textContent = '0 dB';
                document.getElementById('dspCompand').value = 'soft';
                document.getElementById('dspFadeIn').value = '0.05';
                document.getElementById('dspFadeOut').value = '0.05';
                document.getElementById('dspBandpass').checked = true;
                document.getElementById('dspHissFilter').checked = true;
                document.getElementById('dspBass').value = '0';
                document.getElementById('dspBassBadge').textContent = '0 dB';
                document.getElementById('dspTreble').value = '0';
                document.getElementById('dspTrebleBadge').textContent = '0 dB';
                document.getElementById('dspTrimSilence').checked = true;
                document.getElementById('dspTempo').value = '1.00';
                document.getElementById('dspTempoBadge').textContent = '1.00x';
                document.getElementById('dspEnablePadLead').checked = true;
                document.getElementById('dspEnablePadTrail').checked = true;
                document.getElementById('dspPadLead').value = '0.20';
                document.getElementById('dspPadLeadRange').value = '0.20';
                document.getElementById('dspPadTrail').value = '0.20';
                document.getElementById('dspPadTrailRange').value = '0.20';
                syncStudioSilenceControls();
            } else if (preset === 'reset') {
                resetRecordingStudioMaster();
                return;
            }
            showToast('Preset loaded! Click "Apply & Save" to process audio.', 'info');
        }

        async function saveRecordingStudioDsp() {
            const id = document.getElementById('dspRecId').value;
            if (!id) return;
            const applyBtn = document.getElementById('dspApplyBtn');
            const isRtl = '<%= isRtl %>' === 'true';

            const payload = {
                normDb: document.getElementById('dspNormDb').value !== '' ? parseInt(document.getElementById('dspNormDb').value, 10) : null,
                gainDb: parseInt(document.getElementById('dspGainDb').value, 10) || 0,
                compand: document.getElementById('dspCompand').value,
                fadeIn: parseFloat(document.getElementById('dspFadeIn').value) || 0,
                fadeOut: parseFloat(document.getElementById('dspFadeOut').value) || 0,
                bandpass: document.getElementById('dspBandpass').checked,
                hissFilter: document.getElementById('dspHissFilter').checked,
                bass: parseInt(document.getElementById('dspBass').value, 10) || 0,
                treble: parseInt(document.getElementById('dspTreble').value, 10) || 0,
                trimSilence: document.getElementById('dspTrimSilence').checked,
                tempo: parseFloat(document.getElementById('dspTempo').value) || 1.0,
                enablePadLead: document.getElementById('dspEnablePadLead').checked,
                enablePadTrail: document.getElementById('dspEnablePadTrail').checked,
                padLead: parseFloat(document.getElementById('dspPadLead').value) || 0,
                padTrail: parseFloat(document.getElementById('dspPadTrail').value) || 0,
                generateCodecs: document.getElementById('dspGenerateCodecs').checked
            };

            // MoH targets need their category / file in the payload
            if (studioTarget && studioTarget.kind === 'moh') {
                payload.category = studioTarget.category;
                payload.filename = studioTarget.filename;
            }

            applyBtn.disabled = true;
            applyBtn.innerHTML = `<svg class="animate-spin h-3.5 w-3.5 text-white inline-block shrink-0 mr-1.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> <span>${isRtl ? 'جاري معالجة الصوت...' : 'Processing audio...'}</span>`;

            try {
                const res = await fetch(studioEndpoints().dsp, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || (isRtl ? 'تم تطبيق ومعالجة الصوت بنجاح' : 'Audio effects applied successfully!'), 'success');
                    if (data.stat) {
                        document.getElementById('dspStatDuration').textContent = data.stat.length ? data.stat.length + 's' : '-';
                        document.getElementById('dspStatPeak').textContent = data.stat.maxAmplitude ? data.stat.maxAmplitude : '-';
                        document.getElementById('dspStatRms').textContent = data.stat.rmsAmplitude ? data.stat.rmsAmplitude : '-';
                    }
                    if (studioPreviewAudio) {
                        studioPreviewAudio.pause();
                        studioPreviewAudio = null;
                    }
                    fetchRecordings();
                } else {
                    showToast(data.error || 'Failed to process DSP audio', 'error');
                }
            } catch (err) {
                showToast(err.message || 'Error processing audio', 'error');
            } finally {
                applyBtn.disabled = false;
                applyBtn.innerHTML = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> <span>${isRtl ? 'تطبيق وحفظ المؤثرات' : 'Apply & Save Audio DSP'}</span>`;
            }
        }

        async function resetRecordingStudioMaster() {
            const id = document.getElementById('dspRecId').value;
            if (!id) return;
            const isRtl = '<%= isRtl %>' === 'true';
            if (!confirm(isRtl ? 'هل أنت متأكد من استعادة الملف الأصلي الخام وإلغاء جميع الفلاتر والمؤثرات؟' : 'Revert audio to untouched original master and clear all DSP effects?')) return;

            const resetBody = { resetToOriginal: true };
            if (studioTarget && studioTarget.kind === 'moh') {
                resetBody.category = studioTarget.category;
                resetBody.filename = studioTarget.filename;
            }

            try {
                const res = await fetch(studioEndpoints().dsp, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(resetBody)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تمت استعادة الملف الأصلي بنجاح' : 'Reverted to original master audio', 'success');
                    if (studioPreviewAudio) {
                        studioPreviewAudio.pause();
                        studioPreviewAudio = null;
                    }
                    if (studioTarget && studioTarget.kind === 'moh') {
                        openMohStudioModal(studioTarget.category, studioTarget.filename);
                    } else {
                        openRecordingStudioModal(id);
                    }
                    fetchRecordings();
                } else {
                    showToast(data.error || 'Failed to reset recording', 'error');
                }
            } catch (err) {
                showToast(err.message || 'Error resetting recording', 'error');
            }
        }

        window.openRecordingStudioModal = openRecordingStudioModal;
        window.toggleStudioAudioPreview = toggleStudioAudioPreview;
        window.applyDspPreset = applyDspPreset;
        window.saveRecordingStudioDsp = saveRecordingStudioDsp;
        window.resetRecordingStudioMaster = resetRecordingStudioMaster;
        // --- IVR MENUS ---
        let ivrEntryCounter = 0;

        function fetchIvrs() {
            const tbody = document.getElementById('ivrs-table-body');
            return fetch('/api/config/ivrs')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    loadedIvrsList = Array.isArray(data.ivrs) ? data.ivrs : [];
                    const list = loadedIvrsList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد قوائم رد آلي.' : 'No IVR menus found.') + '</td></tr>';
                        return;
                    }
                    list.forEach((ivr) => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const recMatch = (loadedRecordingsList || []).find(r => r.id == ivr.announcement);
                        const recName = recMatch ? escapeHtml(recMatch.displayname || recMatch.filename) : (ivr.announcement ? `Recording #${ivr.announcement}` : 'None');
                        const optionsCount = (ivr.entries || []).length;
                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono text-xs font-bold text-amber-400">#${ivr.id}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ivr.name || '')}</td>
                            <td class="py-3 px-4 text-xs text-[var(--text-secondary)]">${escapeHtml(ivr.description || '-')}</td>
                            <td class="py-3 px-4 text-xs text-purple-400 font-mono">${recName}</td>
                            <td class="py-3 px-4 text-xs font-mono">${ivr.directdial === 'disabled' ? '<span class="text-rose-400">Disabled</span>' : '<span class="text-emerald-400">Extensions</span>'}</td>
                            <td class="py-3 px-4 text-xs font-mono text-cyan-400 font-bold">${optionsCount} ${optionsCount === 1 ? 'option' : 'options'}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="openIvrModal(${ivr.id})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteIvr(${ivr.id})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function populateIvrAnnouncementSelect(selectedId) {
            const sel = document.getElementById('ivrAnnouncement');
            if (!sel) return;
            sel.innerHTML = '<option value="0">== None / Default ==</option>';
            (loadedRecordingsList || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = `${r.displayname || r.filename} (#${r.id})`;
                if (r.id == selectedId) opt.selected = true;
                sel.appendChild(opt);
            });
        }

        function populateIvrTargetSelect(selectEl, type, currentDest) {
            if (!selectEl) return;
            selectEl.innerHTML = '<option value="">== ' + (isRtl ? 'اختر الهدف Target' : 'choose target') + ' ==</option>';
            if (type === 'extensions') {
                (loadedExtensionsList || []).forEach(e => {
                    const opt = document.createElement('option');
                    opt.value = `from-did-direct,${e.extension},1`;
                    opt.textContent = `${e.extension} - ${e.name}`;
                    if (currentDest === opt.value || currentDest === `ext-local,${e.extension},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'ringgroups') {
                (loadedRingGroupsList || []).forEach(rg => {
                    const opt = document.createElement('option');
                    opt.value = `ext-group,${rg.grpnum},1`;
                    opt.textContent = `Group ${rg.grpnum} - ${rg.description}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'queues') {
                (loadedQueuesList || []).forEach(q => {
                    const opt = document.createElement('option');
                    opt.value = `ext-queues,${q.extension},1`;
                    opt.textContent = `Queue ${q.extension} - ${q.descr}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'ivr') {
                (loadedIvrsList || []).forEach(i => {
                    const opt = document.createElement('option');
                    opt.value = `ivr-${i.id},s,1`;
                    opt.textContent = `IVR #${i.id} - ${i.name}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'voicemail') {
                (loadedExtensionsList || []).forEach(e => {
                    const opt = document.createElement('option');
                    opt.value = `ext-local,vmu${e.extension},1`;
                    opt.textContent = `VM: ${e.extension} - ${e.name}`;
                    if (currentDest === opt.value || currentDest === `ext-withvm,${e.extension},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'announcements') {
                (loadedAnnouncementsList || []).forEach(a => {
                    const opt = document.createElement('option');
                    opt.value = `app-announcement-${a.announcement_id},s,1`;
                    opt.textContent = `Announcement: ${a.description}`;
                    if (currentDest === opt.value) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'timeconditions') {
                (loadedTimeConditionsList || []).forEach(tc => {
                    const opt = document.createElement('option');
                    opt.value = `timeconditions,${tc.timeconditions_id},1`;
                    opt.textContent = `Time Condition: ${tc.displayname}`;
                    if (currentDest === opt.value || currentDest === `ext-timeconditions,${tc.timeconditions_id},1`) opt.selected = true;
                    selectEl.appendChild(opt);
                });
            } else if (type === 'musiconhold') {
                const mohList = typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : [];
                if (mohList.length === 0) {
                    const optDef = document.createElement('option');
                    optDef.value = 'musiconhold,default,1';
                    optDef.textContent = 'Default MoH Class';
                    if (currentDest === optDef.value || currentDest === 'app-blackhole,musiconhold,1') optDef.selected = true;
                    selectEl.appendChild(optDef);
                } else {
                    mohList.forEach(cat => {
                        const opt = document.createElement('option');
                        opt.value = `musiconhold,${cat.name},1`;
                        opt.textContent = `MoH: ${cat.name} (${cat.fileCount || 0} tracks)${cat.isDefault ? ' [System]' : ''}`;
                        if (currentDest === opt.value) opt.selected = true;
                        selectEl.appendChild(opt);
                    });
                }
                const optHold = document.createElement('option');
                optHold.value = 'app-blackhole,musiconhold,1';
                optHold.textContent = isRtl ? 'وضع المتصل في الانتظار الدائم (Hold Forever)' : 'Hold Forever (Blackhole MoH)';
                if (currentDest === optHold.value) optHold.selected = true;
                selectEl.appendChild(optHold);
            } else if (type === 'terminate') {
                const opt = document.createElement('option');
                opt.value = 'app-blackhole,hangup,1';
                opt.textContent = isRtl ? 'إنهاء المكالمة (Hangup)' : 'Terminate Call (Hangup)';
                opt.selected = true;
                selectEl.appendChild(opt);
            }
        }

        function addIvrEntryRow(selection = '1', dest = '') {
            const container = document.getElementById('ivrEntriesContainer');
            if (!container) return;
            const rowId = 'ivr-entry-row-' + (++ivrEntryCounter);

            const div = document.createElement('div');
            div.id = rowId;
            div.className = 'grid grid-cols-1 sm:grid-cols-12 gap-2 items-center bg-[var(--bg-secondary)] p-2.5 border border-[var(--border-primary)] rounded-lg text-xs';

            const digits = ['1','2','3','4','5','6','7','8','9','0','*','#','t','i'];
            const optionHtml = digits.map(d => `<option value="${d}" ${d === String(selection) ? 'selected' : ''}>Press ${d}</option>`).join('');

            div.innerHTML = `
                <div class="sm:col-span-3">
                    <span class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-0.5">Digit Key</span>
                    <select name="ivr_entry_key[]" id="ivr_key_${rowId}" aria-label="Digit Key" class="ivr-entry-selection config-input w-full py-1 text-xs font-bold text-cyan-400">
                        ${optionHtml}
                    </select>
                </div>
                <div class="sm:col-span-4">
                    <span class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-0.5">Destination Type</span>
                    <select name="ivr_entry_type[]" id="ivr_type_${rowId}" aria-label="Destination Type" onchange="onIvrEntryTypeChange('${rowId}')" class="ivr-entry-type config-input w-full py-1 text-xs">
                        <option value="extensions">Extensions</option>
                        <option value="ringgroups">Ring Groups</option>
                        <option value="queues">Queues</option>
                        <option value="ivr">IVR Menu</option>
                        <option value="voicemail">Voicemail</option>
                        <option value="announcements">Announcements</option>
                        <option value="timeconditions">Time Conditions</option>
                        <option value="musiconhold">Music on Hold (MoH)</option>
                        <option value="terminate">Terminate Call (Hangup)</option>
                        <option value="external">${isRtl ? 'رقم خارجي / جوال' : 'External Number / Mobile'}</option>
                        <option value="custom">Custom</option>
                    </select>
                </div>
                <div class="sm:col-span-4">
                    <span class="block text-[10px] font-bold text-[var(--text-secondary)] uppercase mb-0.5">Target</span>
                    <select name="ivr_entry_target[]" id="ivr_target_${rowId}" aria-label="Target" onchange="updateIvrEntryDestValue('${rowId}')" class="ivr-entry-target-select config-input w-full py-1 text-xs font-medium">
                        <option value="">== choose target ==</option>
                    </select>
                    <div id="ivr_external_wrap_${rowId}" class="ivr-entry-external-wrap hidden space-y-1">
                        <input type="tel" autocomplete="tel" id="ivr_ext_phone_${rowId}" placeholder="${isRtl ? 'رقم الهاتف (مثال: 010...)' : 'Phone number (e.g. 010...)'}" oninput="updateIvrEntryDestValue('${rowId}')" class="ivr-entry-external-phone config-input w-full py-1 text-xs font-mono font-bold">
                        <div class="flex items-center gap-1">
                            <label for="ivr_ext_dongle_${rowId}" class="text-[10px] text-[var(--text-muted)] font-bold shrink-0">${isRtl ? 'الشريحة:' : 'SIM:'}</label>
                            <select id="ivr_ext_dongle_${rowId}" onchange="updateIvrEntryDestValue('${rowId}')" class="ivr-entry-external-dongle config-input w-full py-0.5 text-[11px] font-mono">
                                <option value="dongle1" selected>dongle1 (${isRtl ? 'الشريحة الثانية - ربط مباشر' : 'Direct SIM 2 - Recommended'})</option>
                                <option value="dongle0">dongle0 (${isRtl ? 'الشريحة الأولى - ربط مباشر' : 'Direct SIM 1 - Bridge'})</option>
                                <option value="dongle2">dongle2 (SIM 3)</option>
                                <option value="dongle3">dongle3 (SIM 4)</option>
                                <option value="">${isRtl ? 'تلقائي (اختيار أوتوماتيكي للخط المتفرغ)' : 'Auto (Smart Alternate SIM Selection)'}</option>
                            </select>
                        </div>
                    </div>
                    <input type="text" name="ivr_entry_custom[]" id="ivr_custom_${rowId}" aria-label="Custom Target" oninput="updateIvrEntryDestValue('${rowId}')" placeholder="e.g. custom,s,1" class="ivr-entry-target-input config-input w-full py-1 text-xs font-mono hidden">
                    <input type="hidden" name="ivr_entry_dest[]" id="ivr_dest_${rowId}" class="ivr-entry-dest-hidden" value="${escapeHtml(dest)}">
                </div>
                <div class="sm:col-span-1 flex justify-end pt-3 sm:pt-0">
                    <button type="button" onclick="document.getElementById('${rowId}').remove()" class="text-rose-400 hover:text-rose-300 font-bold text-sm px-1.5 py-0.5 hover:bg-rose-500/10 rounded cursor-pointer" aria-label="Remove Entry">✕</button>
                </div>
            `;

            container.appendChild(div);

            const typeSelect = div.querySelector('.ivr-entry-type');
            if (dest.startsWith('ext-local,vmu')) {
                typeSelect.value = 'voicemail';
            } else if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                typeSelect.value = 'extensions';
            } else if (dest.startsWith('ext-group,')) {
                typeSelect.value = 'ringgroups';
            } else if (dest.startsWith('ext-queues,')) {
                typeSelect.value = 'queues';
            } else if (dest.startsWith('ivr-')) {
                typeSelect.value = 'ivr';
            } else if (dest.startsWith('app-announcement-')) {
                typeSelect.value = 'announcements';
            } else if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                typeSelect.value = 'timeconditions';
            } else if (dest.startsWith('musiconhold,') || dest.startsWith('ext-moh,') || dest === 'app-blackhole,musiconhold,1') {
                typeSelect.value = 'musiconhold';
            } else if (dest === 'app-blackhole,hangup,1') {
                typeSelect.value = 'terminate';
            } else if (dest.startsWith('ext-external-failover,') || (dest.startsWith('from-internal,') && !dest.startsWith('from-internal-xfer,'))) {
                const rawTarget = dest.split(',')[1] || '';
                const phone = rawTarget.split('/')[0].split('@')[0];
                const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                if (phone && /^[0-9+*#]{3,25}$/.test(phone) && !/^[1-9][0-9]{1,3}$/.test(phone)) {
                    typeSelect.value = 'external';
                    const phoneInput = div.querySelector('.ivr-entry-external-phone');
                    const dongleSelect = div.querySelector('.ivr-entry-external-dongle');
                    if (phoneInput) phoneInput.value = phone;
                    if (dongleSelect) dongleSelect.value = (dongle && dongle !== 'auto') ? dongle : '';
                } else {
                    typeSelect.value = 'custom';
                }
            } else if (dest) {
                typeSelect.value = 'custom';
            }

            onIvrEntryTypeChange(rowId);
        }

        function onIvrEntryTypeChange(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            if (typeof closeConfigDropdowns === 'function') closeConfigDropdowns();

            const type = row.querySelector('.ivr-entry-type').value;
            const targetSelect = row.querySelector('.ivr-entry-target-select');
            const targetInput = row.querySelector('.ivr-entry-target-input');
            const externalWrap = row.querySelector('.ivr-entry-external-wrap');
            const hiddenDest = row.querySelector('.ivr-entry-dest-hidden');

            const setFieldVisibility = (el, show) => {
                if (!el) return;
                const wrapper = el.closest('.custom-select-wrapper');
                if (show) {
                    el.classList.remove('hidden');
                    if (wrapper) wrapper.classList.remove('hidden');
                } else {
                    el.classList.add('hidden');
                    if (wrapper) {
                        wrapper.classList.add('hidden');
                        const trigger = wrapper.querySelector('.custom-select-trigger');
                        if (trigger) {
                            const menuId = trigger.getAttribute('aria-controls');
                            if (menuId) {
                                const m = document.getElementById(menuId);
                                if (m) m.classList.add('hidden');
                            }
                            trigger.setAttribute('aria-expanded', 'false');
                        }
                    }
                }
            };

            if (['extensions', 'ringgroups', 'queues', 'ivr', 'voicemail', 'announcements', 'timeconditions', 'musiconhold'].includes(type)) {
                setFieldVisibility(targetSelect, true);
                setFieldVisibility(targetInput, false);
                setFieldVisibility(externalWrap, false);
                populateIvrTargetSelect(targetSelect, type, hiddenDest.value);
            } else if (type === 'terminate') {
                setFieldVisibility(targetSelect, false);
                setFieldVisibility(targetInput, false);
                setFieldVisibility(externalWrap, false);
                hiddenDest.value = 'app-blackhole,hangup,1';
            } else if (type === 'external') {
                setFieldVisibility(targetSelect, false);
                setFieldVisibility(targetInput, false);
                setFieldVisibility(externalWrap, true);
            } else if (type === 'custom') {
                setFieldVisibility(targetSelect, false);
                setFieldVisibility(targetInput, true);
                setFieldVisibility(externalWrap, false);
                targetInput.value = hiddenDest.value;
            }
            updateIvrEntryDestValue(rowId);
        }

        function updateIvrEntryDestValue(rowId) {
            const row = document.getElementById(rowId);
            if (!row) return;
            const type = row.querySelector('.ivr-entry-type').value;
            const targetSelect = row.querySelector('.ivr-entry-target-select');
            const targetInput = row.querySelector('.ivr-entry-target-input');
            const externalWrap = row.querySelector('.ivr-entry-external-wrap');
            const hiddenDest = row.querySelector('.ivr-entry-dest-hidden');

            if (['extensions', 'ringgroups', 'queues', 'ivr', 'voicemail', 'announcements', 'timeconditions', 'musiconhold'].includes(type)) {
                hiddenDest.value = targetSelect.value || '';
            } else if (type === 'terminate') {
                hiddenDest.value = 'app-blackhole,hangup,1';
            } else if (type === 'external') {
                const phoneInput = row.querySelector('.ivr-entry-external-phone');
                const dongleSelect = row.querySelector('.ivr-entry-external-dongle');
                const rawPhone = phoneInput ? phoneInput.value.trim().replace(/\s+/g, '') : '';
                const dongle = dongleSelect ? dongleSelect.value.trim() : '';
                if (!rawPhone) {
                    hiddenDest.value = 'app-blackhole,hangup,1';
                } else if (dongle && dongle !== 'auto') {
                    hiddenDest.value = `ext-external-failover,${rawPhone}/${dongle},1`;
                } else {
                    hiddenDest.value = `ext-external-failover,${rawPhone},1`;
                }
            } else if (type === 'custom') {
                hiddenDest.value = targetInput.value.trim();
            }
        }

        function setIvrTimeoutDest(destVal) {
            initDestinationSelectInstances();
            if (ivrTimeoutDestSelectInstance) ivrTimeoutDestSelectInstance.setDialplan(destVal || 'app-blackhole,hangup,1');
            const hidden = document.getElementById('ivrTimeoutDestination');
            if (hidden) hidden.value = destVal || 'app-blackhole,hangup,1';
        }

        function setIvrInvalidDest(destVal) {
            initDestinationSelectInstances();
            if (ivrInvalidDestSelectInstance) ivrInvalidDestSelectInstance.setDialplan(destVal || 'app-blackhole,hangup,1');
            const hidden = document.getElementById('ivrInvalidDestination');
            if (hidden) hidden.value = destVal || 'app-blackhole,hangup,1';
        }

        function openIvrModal(id = null) {
            openModal('ivrModal');
            const form = document.getElementById('ivrForm');
            const title = document.getElementById('ivrModalTitle');
            const editId = document.getElementById('ivrEditId');
            const container = document.getElementById('ivrEntriesContainer');

            if (form) form.reset();
            if (container) container.innerHTML = '';

            populateIvrAnnouncementSelect(0);
            if (id) {
                const ivr = (loadedIvrsList || []).find(i => i.id == id);
                if (ivr) {
                    title.textContent = isRtl ? `تعديل قائمة الرد الآلي #${ivr.id}` : `Edit IVR Menu #${ivr.id}`;
                    editId.value = ivr.id;
                    document.getElementById('ivrName').value = ivr.name || '';
                    document.getElementById('ivrDescription').value = ivr.description || '';
                    populateIvrAnnouncementSelect(ivr.announcement || 0);
                    document.getElementById('ivrDirectDial').value = ivr.directdial || 'disabled';

                    document.getElementById('ivrTimeoutTime').value = ivr.timeout_time || 10;
                    document.getElementById('ivrTimeoutLoops').value = ivr.timeout_loops || 3;
                    setIvrTimeoutDest(ivr.timeout_destination || 'app-blackhole,hangup,1');

                    document.getElementById('ivrInvalidLoops').value = ivr.invalid_loops || 3;
                    setIvrInvalidDest(ivr.invalid_destination || 'app-blackhole,hangup,1');

                    if (ivr.entries && ivr.entries.length) {
                        ivr.entries.forEach(e => addIvrEntryRow(e.selection, e.dest));
                    } else {
                        addIvrEntryRow('1', '');
                    }
                }
            } else {
                title.textContent = isRtl ? 'إضافة قائمة رد آلي جديدة' : 'Add IVR Menu';
                editId.value = '';
                document.getElementById('ivrTimeoutTime').value = 10;
                document.getElementById('ivrTimeoutLoops').value = 3;
                setIvrTimeoutDest('app-blackhole,hangup,1');
                document.getElementById('ivrInvalidLoops').value = 3;
                setIvrInvalidDest('app-blackhole,hangup,1');

                addIvrEntryRow('1', '');
                addIvrEntryRow('2', '');
            }

            syncModalSelects(document.getElementById('ivrModal'));
            if (typeof ensureAllConfigListsLoaded === 'function') {
                ensureAllConfigListsLoaded().then(() => {
                    if (id) {
                        const ivr = (loadedIvrsList || []).find(i => i.id == id);
                        if (ivr) {
                            populateIvrAnnouncementSelect(ivr.announcement || 0);
                            setIvrTimeoutDest(ivr.timeout_destination || 'app-blackhole,hangup,1');
                            setIvrInvalidDest(ivr.invalid_destination || 'app-blackhole,hangup,1');
                        }
                    } else {
                        populateIvrAnnouncementSelect(0);
                    }
                    syncModalSelects(document.getElementById('ivrModal'));
                }).catch(() => {});
            }
        }
        function saveIvr(e) {
            e.preventDefault();
            const editId = document.getElementById('ivrEditId').value;
            const name = document.getElementById('ivrName').value.trim();
            const description = document.getElementById('ivrDescription').value.trim();
            const announcement = document.getElementById('ivrAnnouncement').value;
            const directdial = document.getElementById('ivrDirectDial').value;

            const timeout_time = document.getElementById('ivrTimeoutTime').value;
            const timeout_loops = document.getElementById('ivrTimeoutLoops').value;
            const timeout_destination = document.getElementById('ivrTimeoutDestination').value;

            const invalid_loops = document.getElementById('ivrInvalidLoops').value;
            const invalid_destination = document.getElementById('ivrInvalidDestination').value;

            const entries = [];
            document.querySelectorAll('#ivrEntriesContainer > div').forEach(row => {
                const sel = row.querySelector('.ivr-entry-selection').value;
                const dest = row.querySelector('.ivr-entry-dest-hidden').value;
                if (sel && dest) {
                    entries.push({ selection: sel, dest: dest });
                }
            });

            const body = {
                name, description, announcement, directdial,
                timeout_time, timeout_loops, timeout_destination,
                invalid_loops, invalid_destination,
                entries
            };

            const url = editId ? `/api/config/ivrs/${editId}` : '/api/config/ivrs';
            const method = editId ? 'PUT' : 'POST';
            const submitBtn = e.target ? (e.target.matches('button') ? e.target : e.target.querySelector('button[type="submit"]')) : null;
            if (submitBtn) setButtonLoading(submitBtn, true);

            fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message || 'IVR saved successfully', 'success');
                    closeModal('ivrModal');
                    fetchIvrs();
                } else {
                    showToast(data.error || 'Failed to save IVR', 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'))
            .finally(() => {
                if (submitBtn) setButtonLoading(submitBtn, false);
            });
        }

        async function deleteIvr(id) {
            const ok = await window.sokratConfirm({
                title: isRtl ? 'حذف الرد الآلي' : 'Delete IVR',
                message: isRtl ? `هل أنت متأكد من حذف قائمة الرد الآلي #${id}؟` : `Are you sure you want to delete IVR #${id}?`,
                confirmText: isRtl ? 'حذف' : 'Delete',
                type: 'danger'
            });
            if (!ok) return;
            fetch(`/api/config/ivrs/${id}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message || 'IVR deleted successfully', 'success');
                        fetchIvrs();
                    } else {
                        showToast(data.error || 'Failed to delete IVR', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }
        window.openIvrModal = openIvrModal;
        window.editIvr = openIvrModal;
        window.saveIvr = saveIvr;
        window.deleteIvr = deleteIvr;
        window.fetchIvrs = fetchIvrs;
        window.addIvrEntryRow = addIvrEntryRow;
        window.onIvrEntryTypeChange = onIvrEntryTypeChange;
        window.updateIvrEntryDestValue = updateIvrEntryDestValue;
        window.populateIvrAnnouncementSelect = populateIvrAnnouncementSelect;
        window.populateIvrTargetSelect = populateIvrTargetSelect;
        window.setIvrTimeoutDest = setIvrTimeoutDest;
        window.setIvrInvalidDest = setIvrInvalidDest;

        // --- 4. TRUNKS ---
        function onTrunkTechChange() {
            const tech = document.getElementById('trunkTech').value;
            const customDiv = document.getElementById('trunkCustomFields');
            const sipIaxDiv = document.getElementById('trunkSipIaxFields');
            const cidSection = document.getElementById('trunkCidSection');
            const dialInput = document.getElementById('trunkDialString');
            const hostInput = document.getElementById('trunkHost');
            const channelIdInput = document.getElementById('trunkChannelId');

            if (tech === 'custom') {
                customDiv.classList.remove('hidden');
                sipIaxDiv.classList.add('hidden');
                if (cidSection) cidSection.classList.add('hidden');
                if (dialInput) dialInput.required = true;
                if (hostInput) hostInput.required = false;
                if (channelIdInput) channelIdInput.required = false;
            } else {
                customDiv.classList.add('hidden');
                sipIaxDiv.classList.remove('hidden');
                if (cidSection) cidSection.classList.remove('hidden');
                if (dialInput) dialInput.required = false;
                if (hostInput) hostInput.required = false;
                if (channelIdInput) channelIdInput.required = false;
            }
        }

        function fetchTrunks() {
            const tbody = document.getElementById('trunks-table-body');
            return Promise.all([
                fetch('/api/config/trunks').then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                }),
                fetch('/api/gsm-dongles').then(res => res.ok ? res.json() : { success: false, devices: [] }).catch(() => ({ success: false, devices: [] }))
            ])
            .then(([trunksData, gsmData]) => {
                if (!trunksData || !trunksData.success || !trunksData.trunks) return;
                const gsmDevices = (gsmData && gsmData.success && Array.isArray(gsmData.devices)) ? gsmData.devices : [];
                loadedTrunksList = Array.isArray(trunksData.trunks) ? trunksData.trunks : [];
                const list = loadedTrunksList;
                if (!tbody) return;
                tbody.innerHTML = '';
                if (list.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد خطوط ربط.' : 'No trunks found.') + '</td></tr>';
                    return;
                }
                const urlParams = new URLSearchParams(window.location.search);
                const highlightTrunk = urlParams.get('highlightTrunk') || urlParams.get('trunkId') || urlParams.get('highlight');
                let highlightedRow = null;

                list.forEach(t => {
                    const tr = document.createElement('tr');
                    tr.id = 'trunk-row-' + t.trunkid;
                    tr.dataset.trunkId = String(t.trunkid);

                    const isHighlighted = highlightTrunk && (
                        String(t.trunkid) === String(highlightTrunk) ||
                        String(t.name).toLowerCase() === String(highlightTrunk).toLowerCase()
                    );

                    if (isHighlighted) {
                        tr.className = 'trunk-highlighted-red transition-all duration-300';
                        highlightedRow = tr;
                    } else {
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                    }
                    const techUpper = String(t.tech || 'custom').toUpperCase();
                    let techBadgeClass = 'bg-slate-500/15 text-slate-300 border-slate-500/20';
                    if (techUpper === 'SIP') techBadgeClass = 'bg-cyan-500/15 text-cyan-400 border-cyan-500/20';
                    else if (techUpper === 'IAX2' || techUpper === 'IAX') techBadgeClass = 'bg-purple-500/15 text-purple-400 border-purple-500/20';
                    else if (techUpper === 'CUSTOM') techBadgeClass = 'bg-amber-500/15 text-amber-400 border-amber-500/20';

                    // Resolve SIM Number for this trunk
                    let simNum = (t.simNumber && t.simNumber !== 'Unknown' && t.simNumber !== '-' && t.simNumber !== 'None') ? t.simNumber : null;
                    let dongleId = t.dongleId || null;

                    if (!simNum && gsmDevices.length > 0) {
                        const trunkIdNum = Number.parseInt(t.trunkid, 10);
                        const channelId = String(t.channelid || '').toLowerCase();
                        const trunkName = String(t.name || '').toLowerCase();

                        for (const dev of gsmDevices) {
                            const devNum = (dev.Number && dev.Number !== 'Unknown' && dev.Number !== '-' && dev.Number !== 'None') ? dev.Number : (dev.phoneNumber || dev.simNumber || null);
                            const devId = String(dev.ID || '').toLowerCase();
                            const devImei = String(dev.IMEI || '').replace(/\s+/g, '').toLowerCase();
                            const devImsi = String(dev.IMSI || '').replace(/\s+/g, '').toLowerCase();

                            let isMatch = false;
                            if (Array.isArray(dev.customTrunks)) {
                                isMatch = dev.customTrunks.some(ct =>
                                    Number.parseInt(ct.trunkId, 10) === trunkIdNum ||
                                     (ct.name && String(ct.name).toLowerCase() === trunkName)
                                 );
                             }
                             if (!isMatch && channelId.includes('dongle/')) {
                                 if (devImei && devImei.length >= 8 && channelId.includes(devImei)) isMatch = true;
                                 else if (devImsi && devImsi.length >= 8 && channelId.includes(devImsi)) isMatch = true;
                                 else if (devId && (channelId.includes(`/${devId}/`) || channelId.endsWith(`/${devId}`))) isMatch = true;
                             }

                             if (isMatch) {
                                 simNum = devNum;
                                 dongleId = dev.ID;
                                 break;
                             }
                         }
                     }

                     const isDongleTrunk = Boolean(dongleId || (t.channelid && String(t.channelid).toLowerCase().includes('dongle/')));
                     let simDisplay = '';

                     if (simNum && simNum !== 'Unknown' && simNum !== '-' && simNum !== 'None') {
                         simDisplay = `
                             <div class="flex items-center gap-1.5 flex-wrap">
                                 <a href="/gsm-dongles" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 hover:bg-emerald-500/20 hover:border-emerald-500/40 transition-all cursor-pointer" title="${isRtl ? 'عرض في صفحة مودمات GSM' : 'View in GSM Dongles'}">
                                     <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                                     <span>${escapeHtml(simNum)}</span>
                                 </a>
                                 ${dongleId ? `<span class="text-[10px] font-mono text-[var(--text-muted)] font-bold">(${escapeHtml(dongleId)})</span>` : ''}
                             </div>
                         `;
                     } else if (isDongleTrunk) {
                         simDisplay = `
                             <div class="flex items-center gap-1.5 flex-wrap">
                                 <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono font-bold text-amber-400 bg-amber-500/10 border border-amber-500/25">
                                     <span>${dongleId ? escapeHtml(dongleId) + ': ' : ''}${isRtl ? 'غير محدد' : 'Unknown'}</span>
                                 </span>
                             </div>
                         `;
                     } else {
                         simDisplay = `<span class="text-xs text-[var(--text-muted)] font-mono">-</span>`;
                     }

                     const targetStr = (t.tech === 'custom' ? t.channelid : t.host) || '-';

                     tr.innerHTML = `
                         <td class="py-3 px-4 font-mono font-bold text-[var(--text-muted)]">${escapeHtml(t.trunkid)}</td>
                         <td class="py-3 px-4 font-bold text-[var(--text-primary)] font-mono">${escapeHtml(t.name)}</td>
                         <td class="py-3 px-4"><span class="px-2 py-0.5 text-[10px] font-extrabold rounded border ${techBadgeClass}">${techUpper}</span></td>
                         <td class="py-3 px-4 font-mono text-xs">${simDisplay}</td>
                         <td class="py-3 px-4 font-mono text-xs text-blue-400 font-semibold">${escapeHtml(targetStr)}</td>
                         <td class="py-3 px-4 text-center">
                             <div class="flex items-center justify-center gap-2">
                                 <button type="button" onclick="editTrunkByIndex(${t.trunkid})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                 <button type="button" onclick="deleteTrunk(${t.trunkid})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                             </div>
                         </td>
                     `;
                     tbody.appendChild(tr);
                 });

                    if (highlightedRow) {
                        setTimeout(() => {
                            highlightedRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }, 150);

                        setTimeout(() => {
                            if (highlightedRow && highlightedRow.parentNode) {
                                highlightedRow.classList.remove('trunk-highlighted-red');
                                highlightedRow.className = 'hover:bg-[var(--bg-hover)] transition-all duration-700';
                                try {
                                    const cleanUrl = new URL(window.location.href);
                                    cleanUrl.searchParams.delete('highlightTrunk');
                                    cleanUrl.searchParams.delete('trunkId');
                                    cleanUrl.searchParams.delete('highlight');
                                    window.history.replaceState({}, '', cleanUrl.toString());
                                } catch (_) {}
                            }
                        }, 5000);
                    }
                })
                .catch(err => console.error(err));
        }

        function editTrunkByIndex(trunkid) {
            const t = (loadedTrunksList || []).find(x => String(x.trunkid) === String(trunkid));
            if (t) {
                editTrunk(t);
            } else {
                openTrunkModal();
            }
        }

        function renderTrunkDialRules(rules = []) {
            const container = document.getElementById('trunkDialRulesContainer');
            if (!container) return;
            container.innerHTML = '';
            const list = Array.isArray(rules) && rules.length ? rules : [{ prepend: '', prefix: '', pattern: '' }];
            list.forEach(r => addTrunkDialRuleRow(r.prepend || '', r.prefix || '', r.pattern || r.match_pattern || ''));
        }

        function addTrunkDialRuleRow(prepend = '', prefix = '', pattern = '') {
            const container = document.getElementById('trunkDialRulesContainer');
            if (!container) return;
            const row = document.createElement('div');
            row.className = 'trunk-dial-rule-row grid grid-cols-12 gap-2 items-center bg-black/20 p-2 rounded-lg border border-[var(--border-primary)]/40';
            row.innerHTML = `
                <div class="col-span-3">
                    <input type="text" name="trunk_prepend[]" aria-label="Prepend" placeholder="( ${isRtl ? 'إضافة' : 'prepend'} )" value="${escapeHtml(prepend)}" class="trunk-rule-prepend config-input w-full font-mono text-[11px] px-2 py-1">
                </div>
                <div class="col-span-1 text-center font-bold text-amber-400 text-xs">+</div>
                <div class="col-span-3">
                    <input type="text" name="trunk_prefix[]" aria-label="Prefix" placeholder="prefix" value="${escapeHtml(prefix)}" class="trunk-rule-prefix config-input w-full font-mono text-[11px] px-2 py-1">
                </div>
                <div class="col-span-1 text-center font-bold text-amber-400 text-xs">|</div>
                <div class="col-span-3">
                    <input type="text" name="trunk_pattern[]" aria-label="Match Pattern" placeholder="[ ${isRtl ? 'نمط المطابقة' : 'match pattern'} ]" value="${escapeHtml(pattern)}" class="trunk-rule-pattern config-input w-full font-mono text-[11px] px-2 py-1">
                </div>
                <div class="col-span-1 text-center">
                    <button type="button" onclick="this.closest('.trunk-dial-rule-row').remove()" class="text-red-400 hover:text-red-300 text-xs font-bold p-1 cursor-pointer" title="${isRtl ? 'حذف' : 'Remove'}" aria-label="Remove Rule">✕</button>
                </div>
            `;
            container.appendChild(row);
        }

        function getTrunkDialRulesFromForm() {
            const rows = document.querySelectorAll('.trunk-dial-rule-row');
            const rules = [];
            rows.forEach(row => {
                const prepend = (row.querySelector('.trunk-rule-prepend')?.value || '').trim();
                const prefix = (row.querySelector('.trunk-rule-prefix')?.value || '').trim();
                const pattern = (row.querySelector('.trunk-rule-pattern')?.value || '').trim();
                if (prepend || prefix || pattern) {
                    rules.push({ prepend, prefix, pattern });
                }
            });
            return rules;

        function fetchFederationPeers() {
            const tbody = document.getElementById('federationPeersTableBody');
            return fetch('/api/config/federation/peers')
                .then(res => res.json())
                .then(data => {
                    if (data.success && Array.isArray(data.peers)) {
                        loadedFederationPeersList = data.peers;
                        loadedRemoteExtensionsList = data.remoteExtensions || [];
                        renderFederationPeersTable(data.peers);
                        fetchRemoteExtensionsDirectory();
                        if (typeof renderQuickPickPills === 'function') renderQuickPickPills();
                        if (typeof renderQueueAgentChecklist === 'function') renderQueueAgentChecklist();
                    } else {
                        if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-xs text-red-400">${data.error || 'Failed to load peers.'}</td></tr>`;
                    }
                })
                .catch(err => {
                    console.error('fetchFederationPeers error:', err);
                    if (tbody) tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-xs text-red-400">Connection error loading peers.</td></tr>`;
                });

                    }
                    loadedExtensionsList = Array.isArray(data.extensions) ? data.extensions : [];
                    const list = loadedExtensionsList;
                    renderQuickPickPills();
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {

                const trigger = this.container.querySelector('.dest-combobox-trigger');
                const menu = this.container.querySelector('.dest-dropdown-menu');
                const searchInput = this.container.querySelector('.dest-search-input');

                if (catMenu && catMenu.parentNode !== document.body) {
                    document.body.appendChild(catMenu);
                    this.currentCatMenu = catMenu;
                }

                if (menu && menu.parentNode !== document.body) {
                    document.body.appendChild(menu);
                    this.currentMenu = menu;
                }

                const positionCatMenu = () => {
                    if (!catTrigger || !catMenu) return;
                    if (typeof window.positionConfigDropdown === 'function') {
                        window.positionConfigDropdown(catTrigger, catMenu);
                    }
                };
                const hideCatMenu = () => {
                    if (!catMenu) return;
                    if (typeof window.closeConfigDropdownMenu === 'function') {
                        window.closeConfigDropdownMenu(catMenu);
                    } else {
                        catMenu.classList.add('hidden');
                        catTrigger?.setAttribute('aria-expanded', 'false');
                    }
                };
                const chooseCategory = item => {
                    this.selectedCategory = item.getAttribute('data-cat-id');
                    const categories = DestinationSelect.getCategories();
                    const category = categories.find(c => c.id === this.selectedCategory);
                    if (this.selectedCategory === 'custom') {
                        this.selectedTarget = 'custom';
                        this.dialplanString = this.customDialplanString || '';
                    } else if (this.selectedCategory === 'external') {
                        this.selectedTarget = (this.selectedTarget && this.selectedTarget !== 'external') ? this.selectedTarget : '';
                        this.dialplanString = this.selectedTarget ? `ext-external-failover,${this.selectedTarget},1` : 'app-blackhole,hangup,1';
                    } else if (category && category.targets && category.targets.length) {
                        this.selectedTarget = category.targets[0].id;
                        this.dialplanString = category.targets[0].dialplanString;
                    } else {
                        this.selectedTarget = '';
                        this.dialplanString = '';
                    }
                    this.searchTerm = '';
                    hideCatMenu();
                    this.render();
                    this.emitChange();
                };

                if (catTrigger && catMenu) {
                    catMenu._reposition = positionCatMenu;
                    catMenu._trigger = catTrigger;
                    catTrigger.addEventListener('click', event => {
                        event.stopPropagation();
                        const isOpening = catMenu.classList.contains('hidden');
                        if (!isOpening) {
                            hideCatMenu();
                            return;
                        }
                        if (typeof window.closeConfigDropdowns === 'function') {
                            window.closeConfigDropdowns(catMenu);

        function filterRemoteExtensionsDirectory() {
            const query = (document.getElementById('fedRemoteExtSearchInput')?.value || '').toLowerCase().trim();
            const grid = document.getElementById('fedRemoteExtensionsGrid');
            if (!grid) return;
            grid.querySelectorAll('.panel-surface').forEach(card => {
                const text = card.textContent.toLowerCase();
                card.style.display = text.includes(query) ? '' : 'none';
            });
        }

        function openConnectPbxModal() {
            openModal('connectPbxModal');
            const statusArea = document.getElementById('connBootstrapStatusArea');
            if (statusArea) statusArea.classList.add('hidden');
            const btn = document.getElementById('connBootstrapSubmitBtn');
            if (btn) btn.disabled = false;
        }

        function submitBootstrapPbx(e) {
            e.preventDefault();
            const host = document.getElementById('connRemoteHost').value.trim();
            const sshPort = parseInt(document.getElementById('connRemoteSshPort').value, 10) || 22;
            const sshUser = document.getElementById('connRemoteSshUser').value.trim() || 'root';
            const sshPassword = document.getElementById('connRemoteSshPass').value;
            const siteCode = document.getElementById('connRemoteSiteCode').value.trim();
            const nodeName = document.getElementById('connRemoteNodeName').value.trim();
            const allowInternal = document.getElementById('connAllowInternal').checked ? 1 : 0;
            const allowEgress = document.getElementById('connAllowEgress').checked ? 1 : 0;
            const forceCodeSync = document.getElementById('connSyncCode') ? document.getElementById('connSyncCode').checked : false;

            const statusArea = document.getElementById('connBootstrapStatusArea');
            const statusText = document.getElementById('connBootstrapStatusText');
            const submitBtn = document.getElementById('connBootstrapSubmitBtn');

            if (statusArea) statusArea.classList.remove('hidden');
            if (statusText) statusText.textContent = isRtl ? 'جاري الاتصال بالسيرفر وإعداد النفق ومزامنة البيانات...' : 'Connecting via SSH, provisioning bilateral IAX2 link and syncing entities...';
            if (submitBtn) submitBtn.disabled = true;

            fetch('/api/config/federation/bootstrap', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    host,
                    sshPort,
                    sshUser,
                    sshPassword,
                    siteCode,
                    nodeName,
                    allowInternalDialing: allowInternal,
                    allowOutboundEgress: allowEgress,
                    codeSync: forceCodeSync ? 'force' : 'auto'
                })
            })
            .then(res => res.json())
            .then(data => {
                if (submitBtn) submitBtn.disabled = false;
                if (data.success) {
                    showToast(isRtl ? `تم ربط السيرفر بنجاح! الاستجابة: ${data.latencyMs || 1}ms (${data.extensionsSynced || 0} تحويلة)` : `PBX connected successfully! Latency: ${data.latencyMs || 1}ms (${data.extensionsSynced || 0} exts)`, 'success');
                    closeModal('connectPbxModal');
                    fetchFederationSettings();
                    fetchFederationPeers();
                } else {
                    if (statusText) statusText.textContent = data.error || 'Bootstrap failed';
                    showToast(data.error || 'Bootstrap failed', 'error');
                }
            })
            .catch(err => {
                if (submitBtn) submitBtn.disabled = false;
                if (statusText) statusText.textContent = err.message;
                showToast(err.message, 'error');
            });
        }

        async function openFederationSettingsModal() {
            try {
                const res = await fetch('/api/config/federation/settings');
                const data = await res.json();
                if (data.success && data.settings) {
                    loadedFederationSettings = data.settings;
                }
            } catch (_) {}
            if (loadedFederationSettings) {
                const codeInp = document.getElementById('localSiteCodeInput');
                if (codeInp) codeInp.value = loadedFederationSettings.local_site_code || '10';
                const nameInp = document.getElementById('localNodeNameInput');
                if (nameInp) nameInp.value = loadedFederationSettings.local_node_name || 'Main PBX';
                const roleSel = document.getElementById('localPanelRoleSelect');
                if (roleSel) roleSel.value = loadedFederationSettings.panel_role || 'local';
            }
            openModal('federationSettingsModal');
        }

        function saveFederationSettings(e) {
            e.preventDefault();
            const local_site_code = document.getElementById('localSiteCodeInput').value.trim();
            const local_node_name = document.getElementById('localNodeNameInput').value.trim();
            const panel_role = document.getElementById('localPanelRoleSelect').value;

            fetch('/api/config/federation/settings', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ local_site_code, local_node_name, panel_role })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ إعدادات السيرفر وتحديث النفق بنجاح' : 'Local PBX settings updated and IAX2 configuration reloaded', 'success');
                    closeModal('federationSettingsModal');
                    fetchFederationSettings();
                    fetchFederationPeers();
                } else {
                    showToast(data.error || 'Failed to update settings', 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'));
        }

        function openEditPeerModal(peerId) {
            const peer = loadedFederationPeersList.find(p => Number(p.id) === Number(peerId));
            if (!peer) return;
            document.getElementById('editPeerId').value = peer.id;
            document.getElementById('editPeerNodeName').value = peer.node_name || '';
            document.getElementById('editPeerHost').value = peer.host || '';
            document.getElementById('editPeerAllowInternal').checked = Number(peer.allow_internal_dialing) !== 0;
            document.getElementById('editPeerAllowEgress').checked = Number(peer.allow_outbound_egress) !== 0;
            const reportRead = document.getElementById('editPeerAllowReportRead');
            if (reportRead) reportRead.checked = Number(peer.allow_report_read) !== 0;
            const contactWrite = document.getElementById('editPeerAllowContactWrite');
            if (contactWrite) contactWrite.checked = Number(peer.allow_contact_write) !== 0;
            const dongleControl = document.getElementById('editPeerAllowDongleControl');
            if (dongleControl) dongleControl.checked = Number(peer.allow_dongle_control) !== 0;
            const campaignControl = document.getElementById('editPeerAllowCampaignControl');
            if (campaignControl) campaignControl.checked = Number(peer.allow_campaign_control) !== 0;
            const configWrite = document.getElementById('editPeerAllowConfigWrite');
            if (configWrite) configWrite.checked = Number(peer.allow_config_write) !== 0;
            openModal('editPeerModal');
        }

        function savePeerEdit(e) {
            e.preventDefault();
            const id = document.getElementById('editPeerId').value;
            const node_name = document.getElementById('editPeerNodeName').value.trim();
            const host = document.getElementById('editPeerHost').value.trim();
            const allow_internal_dialing = document.getElementById('editPeerAllowInternal').checked ? 1 : 0;
            const allow_outbound_egress = document.getElementById('editPeerAllowEgress').checked ? 1 : 0;
            const allow_report_read = document.getElementById('editPeerAllowReportRead')?.checked ? 1 : 0;
            const allow_contact_write = document.getElementById('editPeerAllowContactWrite')?.checked ? 1 : 0;
            const allow_dongle_control = document.getElementById('editPeerAllowDongleControl')?.checked ? 1 : 0;
            const allow_campaign_control = document.getElementById('editPeerAllowCampaignControl')?.checked ? 1 : 0;
            const allow_config_write = document.getElementById('editPeerAllowConfigWrite')?.checked ? 1 : 0;

            fetch(`/api/config/federation/peers/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    node_name, host, allow_internal_dialing, allow_outbound_egress,
                    allow_report_read, allow_contact_write, allow_dongle_control, allow_campaign_control,
                    allow_config_write
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(isRtl ? 'تم تحديث بيانات السيرفر بنجاح' : 'Peer updated successfully', 'success');
                    closeModal('editPeerModal');
                    fetchFederationPeers();
                } else {
                    showToast(data.error || 'Failed to update peer', 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'));
        }

        function syncFederationPeer(peerId) {
            showToast(isRtl ? 'جاري مزامنة التحويلات والخطوط من السيرفر...' : 'Syncing extensions & dongles from remote peer...', 'info');
            fetch(`/api/config/federation/peers/${peerId}/sync`, { method: 'POST', headers: { 'Content-Type': 'application/json' } })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? `تمت المزامنة: ${data.extensionsCount || 0} تحويلة و ${data.donglesCount || 0} شريحة` : `Sync complete: ${data.extensionsCount || 0} extensions and ${data.donglesCount || 0} dongles`, 'success');
                        fetchFederationPeers();
                    } else {
                        showToast(data.error || 'Sync failed', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }

        function qualifyFederationPeer(peerId) {
            showToast(isRtl ? 'جاري فحص استجابة السيرفر (Qualify)...' : 'Checking peer latency (Qualify)...', 'info');
            fetch(`/api/config/federation/peers/${peerId}/qualify`, { method: 'POST' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const lat = data.latencyMs ? `${data.latencyMs}ms` : data.status;
                        showToast(isRtl ? `حالة السيرفر: ${data.status} (الاستجابة: ${lat})` : `Peer status: ${data.status} (${lat})`, data.status === 'online' ? 'success' : 'warning');
                        fetchFederationPeers();
                    } else {
                        showToast(data.error || 'Qualify failed', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }

        function deleteFederationPeer(peerId) {
            if (!confirm(isRtl ? 'هل أنت متأكد من حذف هذا السيرفر وإلغاء الربط بينهما؟' : 'Are you sure you want to disconnect and remove this PBX node?')) {
                return;
            }
            fetch(`/api/config/federation/peers/${peerId}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(isRtl ? 'تم حذف السيرفر وتحديث إعدادات أستيركس بنجاح' : 'Peer removed and Asterisk reloaded successfully', 'success');
                        fetchFederationPeers();
                    } else {
                        showToast(data.error || 'Delete failed', 'error');
                    }
                })
                .catch(err => showToast(err.message, 'error'));
        }

        window.fetchFederationSettings = fetchFederationSettings;
        window.fetchFederationPeers = fetchFederationPeers;
        window.openConnectPbxModal = openConnectPbxModal;
        window.submitBootstrapPbx = submitBootstrapPbx;
        window.openFederationSettingsModal = openFederationSettingsModal;
        window.saveFederationSettings = saveFederationSettings;
        window.openEditPeerModal = openEditPeerModal;
        window.savePeerEdit = savePeerEdit;
        window.syncFederationPeer = syncFederationPeer;
        window.qualifyFederationPeer = qualifyFederationPeer;
        window.deleteFederationPeer = deleteFederationPeer;
        window.filterRemoteExtensionsDirectory = filterRemoteExtensionsDirectory;

        // =========================================================================
        // LOCAL NETWORK IP & PORT SCANNER (nmap) CONTROLLER
        // =========================================================================
        let ipscanCachedResults = [];
        let ipscanActiveChipFilter = 'all';
        let ipscanPollInterval = null;
        let ipscanSecondsElapsed = 0;
        let ipscanTimerInterval = null;

        async function fetchIpscanInterfaces() {
            try {
                const res = await fetch('/api/config/ipscan/interfaces');
                const data = await res.json();
                if (!data.success || !Array.isArray(data.interfaces)) return;

                const select = document.getElementById('ipscan-iface-select');
                if (!select) return;

                select.innerHTML = '';
                if (data.interfaces.length === 0) {
                    select.innerHTML = '<option value="">' + (isRtl ? 'لا توجد كروت شبكة محلية متاحة' : 'No local physical interfaces found') + '</option>';
                    return;
                }

                data.interfaces.forEach((iface, idx) => {
                    const opt = document.createElement('option');
                    opt.value = iface.subnet;
                    opt.textContent = `${iface.iface} · ${iface.subnet} (${iface.ip})`;
                    opt.dataset.ip = iface.ip;
                    opt.dataset.subnet = iface.subnet;
                    if (idx === 0) opt.selected = true;
                    select.appendChild(opt);
                });

                // Auto-fill target with first interface subnet if empty
                const targetInput = document.getElementById('ipscan-target-input');
                if (targetInput && !targetInput.value) {
                    targetInput.value = data.interfaces[0].subnet;
                }
            } catch (err) {
                console.error('Failed to load local network interfaces:', err);
            }
        }

        function onIpscanIfaceChange() {
            const select = document.getElementById('ipscan-iface-select');
            const targetInput = document.getElementById('ipscan-target-input');
            if (select && targetInput && select.value) {
                targetInput.value = select.value;
            }
        }

        function onIpscanProfileChange() {
            const profSelect = document.getElementById('ipscan-profile-select');
            const customWrap = document.getElementById('ipscan-custom-ports-wrap');
            if (!profSelect || !customWrap) return;
            customWrap.classList.toggle('hidden', profSelect.value !== 'custom');
        }

        async function startIpScan(customTarget = null, customProfile = null) {
            const target = customTarget || (document.getElementById('ipscan-target-input')?.value || '').trim();
            const profile = customProfile || (document.getElementById('ipscan-profile-select')?.value || 'voip');
            const customPorts = (document.getElementById('ipscan-custom-ports')?.value || '').trim();

            if (!target) {
                showToast(isRtl ? 'يرجى تحديد عنوان IP أو مدى الشبكة المستهدفة' : 'Target subnet or IP address is required', 'warning');
                return;
            }

            const btnStart = document.getElementById('btn-ipscan-start');
            const btnStop = document.getElementById('btn-ipscan-stop');
            const timerBadge = document.getElementById('ipscan-timer-badge');
            const radarIcon = document.getElementById('icon-ipscan-radar');

            if (btnStart) btnStart.disabled = true;
            if (btnStop) btnStop.classList.remove('hidden');
            if (radarIcon) radarIcon.classList.add('animate-spin');

            showToast(isRtl ? 'بدء فحص الشبكة المحلية...' : `Starting ${profile} scan on ${target}...`, 'info');

            try {
                const res = await fetch('/api/config/ipscan/scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ target, profile, customPorts })
                });
                const data = await res.json();
                if (!data.success) {
                    showToast(data.error || 'Failed to start scan', 'error');
                    resetIpscanUiState();
                    return;
                }

                // Start live poll and timer
                ipscanSecondsElapsed = 0;
                if (timerBadge) timerBadge.textContent = 'Scanning: 0s';
                if (ipscanTimerInterval) clearInterval(ipscanTimerInterval);
                ipscanTimerInterval = setInterval(() => {
                    ipscanSecondsElapsed++;
                    if (timerBadge) timerBadge.textContent = `Scanning: ${ipscanSecondsElapsed}s`;
                    const durKpi = document.getElementById('ipscan-kpi-duration');
                    if (durKpi) durKpi.textContent = `${ipscanSecondsElapsed}s`;
                }, 1000);

                startIpscanPolling();
            } catch (err) {
                showToast(err.message || 'Network error starting scan', 'error');
                resetIpscanUiState();
            }
        }

        function startIpscanPolling() {
            if (ipscanPollInterval) {
                if (typeof ipscanPollInterval.stop === 'function') ipscanPollInterval.stop();
                else clearInterval(ipscanPollInterval);
            }
            ipscanPollInterval = window.sokratPoll(fetchIpscanStatus, 1500);
        }

        async function fetchIpscanStatus() {
            try {
                const res = await fetch('/api/config/ipscan/status');
                const data = await res.json();
                if (!data.success || !data.status) return;

                const st = data.status;
                const timerBadge = document.getElementById('ipscan-timer-badge');

                if (st.scanning) {
                    const dur = st.durationSec || ipscanSecondsElapsed;
                    if (timerBadge) timerBadge.textContent = `Scanning: ${dur}s`;
                    const durKpi = document.getElementById('ipscan-kpi-duration');
                    if (durKpi) durKpi.textContent = `${dur}s`;
                    return;
                }

                // Scan is complete or stopped
                if (ipscanPollInterval) {
                    if (ipscanPollInterval && typeof ipscanPollInterval.stop === 'function') ipscanPollInterval.stop();
                    else clearInterval(ipscanPollInterval);
                    ipscanPollInterval = null;
                }
                if (ipscanTimerInterval) {
                    clearInterval(ipscanTimerInterval);
                    ipscanTimerInterval = null;
                }

                resetIpscanUiState();

                if (timerBadge) {
                    timerBadge.textContent = st.error ? 'Error' : `Complete (${st.durationSec}s)`;
                }
                const durKpi = document.getElementById('ipscan-kpi-duration');
                if (durKpi) durKpi.textContent = `${st.durationSec}s`;

                if (st.error) {
                    showToast(st.error, 'warning');
                } else if (Array.isArray(st.results)) {
                    showToast(isRtl ? `اكتمل الفحص: تم العثور على ${st.results.length} جهاز متصل` : `Scan complete: Found ${st.results.length} live host(s)`, 'success');
                }

                ipscanCachedResults = st.results || [];
                renderIpscanResults();
            } catch (err) {
                console.error('Error polling ipscan status:', err);
            }
        }

        async function stopIpScan() {
            const btnStop = document.getElementById('btn-ipscan-stop');
            if (btnStop) btnStop.disabled = true;
            try {
                await fetch('/api/config/ipscan/stop', { method: 'POST' });
                showToast(isRtl ? 'تم إيقاف الفحص' : 'Scan stopped', 'warning');
            } catch (err) {
                showToast(err.message, 'error');
            } finally {
                if (btnStop) btnStop.disabled = false;
                resetIpscanUiState();
            }
        }

        function resetIpscanUiState() {
            const btnStart = document.getElementById('btn-ipscan-start');
            const btnStop = document.getElementById('btn-ipscan-stop');
            const radarIcon = document.getElementById('icon-ipscan-radar');
            if (btnStart) btnStart.disabled = false;
            if (btnStop) btnStop.classList.add('hidden');
            if (radarIcon) radarIcon.classList.remove('animate-spin');
        }

        function renderIpscanResults() {
            const tbody = document.getElementById('ipscan-table-body');
            const kpiHosts = document.getElementById('ipscan-kpi-hosts');
            const kpiVoip = document.getElementById('ipscan-kpi-voip');
            const kpiPorts = document.getElementById('ipscan-kpi-ports');

            const allHosts = ipscanCachedResults || [];

            // Update KPIs
            const totalHosts = allHosts.length;
            const totalVoip = allHosts.filter(h => h.isVoipDevice).length;
            let totalOpenPorts = 0;
            allHosts.forEach(h => { totalOpenPorts += (h.ports || []).length; });

            if (kpiHosts) kpiHosts.textContent = totalHosts;
            if (kpiVoip) kpiVoip.textContent = totalVoip;
            if (kpiPorts) kpiPorts.textContent = totalOpenPorts;

            if (!tbody) return;

            // Apply Search & Filter Chips
            const searchTerm = (document.getElementById('ipscan-search-input')?.value || '').toLowerCase().trim();
            const filtered = allHosts.filter(h => {
                // Chip Filter
                if (ipscanActiveChipFilter === 'voip' && !h.isVoipDevice) return false;
                if (ipscanActiveChipFilter === 'web') {
                    const hasWeb = (h.ports || []).some(p => [80, 443, 8080, 8443].includes(p.port));
                    if (!hasWeb) return false;
                }
                if (ipscanActiveChipFilter === 'ssh') {
                    const hasSsh = (h.ports || []).some(p => p.port === 22);
                    if (!hasSsh) return false;
                }

                // Text search
                if (!searchTerm) return true;
                const matchIp = h.ip.toLowerCase().includes(searchTerm);
                const matchVendor = (h.vendor || '').toLowerCase().includes(searchTerm);
                const matchHost = (h.hostname || '').toLowerCase().includes(searchTerm);
                const matchMac = (h.mac || '').toLowerCase().includes(searchTerm);
                const matchWeb = (h.httpServerName || '').toLowerCase().includes(searchTerm) || (h.httpServer || '').toLowerCase().includes(searchTerm);
                const matchPorts = (h.ports || []).some(p => `${p.port}`.includes(searchTerm) || (p.service || '').toLowerCase().includes(searchTerm));
                return matchIp || matchVendor || matchHost || matchMac || matchWeb || matchPorts;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="py-8 text-center text-xs text-[var(--text-muted)]">
                            ${allHosts.length === 0
                                ? (isRtl ? 'لا توجد أجهزة متصلة مكتشفة بعد. اختر المدى واضغط "بدء فحص الشبكة".' : 'No devices detected yet. Select your local LAN subnet and click "Start Network Scan".')
                                : (isRtl ? 'لا توجد أجهزة تطابق معايير البحث والفلترة.' : 'No devices match your search and filter criteria.')}
                        </td>
                    </tr>
                `;
                return;
            }

            let html = '';
            filtered.forEach(h => {
                const isVoip = h.isVoipDevice;
                const vendorBadge = isVoip
                    ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-extrabold bg-purple-500/20 text-purple-300 border border-purple-500/35"><svg class="w-3 h-3 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg><span>${escapeHtml(h.vendor)}</span></span>`
                    : `<span class="text-xs font-semibold text-[var(--text-secondary)]">${escapeHtml(h.vendor || 'Unknown')}</span>`;

                // Web Server Info HTML
                let webServerHtml = '<span class="text-[11px] text-[var(--text-muted)] italic">--</span>';
                if (h.httpServerName) {
                    const webPort = h.httpPort || (h.ports.find(p => [80, 443, 8080, 8443].includes(p.port))?.port) || 80;
                    const proxyUrl = `/api/config/ipscan/proxy/${encodeURIComponent(h.ip)}/${encodeURIComponent(webPort)}/`;

                    webServerHtml = `
                        <div class="flex flex-col gap-1 max-w-[260px]">
                            <button type="button" onclick="openDeviceWebConsole('${h.ip}', ${webPort}, '${escapeHtml(h.httpTitle || h.httpServerName || h.ip)}')" class="inline-flex items-center gap-1.5 font-bold text-xs text-cyan-400 hover:text-cyan-300 transition text-left cursor-pointer truncate group" title="<%= isRtl ? 'فتح في المتصفح المدمج (بروكسي مباشر)' : 'Open in Built-in Browser Console (Direct Proxy)' %>">
                                <svg class="w-3.5 h-3.5 text-cyan-400 shrink-0 group-hover:scale-110 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
                                <span class="truncate underline decoration-cyan-500/40 underline-offset-2">${escapeHtml(h.httpTitle || h.httpServerName)}</span>
                            </button>
                            <div class="flex items-center gap-2">
                                ${h.httpServer ? `<span class="text-[10px] font-mono text-[var(--text-muted)] truncate" title="${escapeHtml(h.httpServer)}">${escapeHtml(h.httpServer)}</span>` : ''}
                                <a href="${proxyUrl}" target="_blank" class="text-[10px] text-cyan-400/80 hover:text-cyan-300 font-mono hover:underline inline-flex items-center gap-0.5" title="<%= isRtl ? 'فتح في نافذة متصفح منفصلة' : 'Open in separate tab' %>">
                                    <span>[tab ↗]</span>
                                </a>
                            </div>
                        </div>
                    `;
                }

                // Ports list pills
                let portsHtml = '';
                if (!h.ports || h.ports.length === 0) {
                    portsHtml = `<span class="text-[11px] text-[var(--text-muted)] italic">${isRtl ? 'لا منافذ مفتوحة' : 'No open ports'}</span>`;
                } else {
                    portsHtml = '<div class="flex items-center gap-1.5 flex-wrap">';
                    h.ports.forEach(p => {
                        let colorCls = 'bg-zinc-500/15 text-zinc-300 border-zinc-500/30';
                        let linkTag = '';
                        if (p.port === 80 || p.port === 8080) {
                            colorCls = 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30 hover:bg-cyan-500/25';
                            const proxyUrl = `/api/config/ipscan/proxy/${encodeURIComponent(h.ip)}/${encodeURIComponent(p.port)}/`;
                            linkTag = `href="${proxyUrl}" onclick="openDeviceWebConsole('${h.ip}', ${p.port}, '${escapeHtml(p.webServerName || h.httpServerName || h.ip)}'); return false;"`;
                        } else if (p.port === 443 || p.port === 8443) {
                            colorCls = 'bg-sky-500/15 text-sky-300 border-sky-500/30 hover:bg-sky-500/25';
                            const proxyUrl = `/api/config/ipscan/proxy/${encodeURIComponent(h.ip)}/${encodeURIComponent(p.port)}/`;
                            linkTag = `href="${proxyUrl}" onclick="openDeviceWebConsole('${h.ip}', ${p.port}, '${escapeHtml(p.webServerName || h.httpServerName || h.ip)}'); return false;"`;
                        } else if (p.port === 5060 || p.port === 5061 || p.service === 'sip') {
                            colorCls = 'bg-purple-500/15 text-purple-300 border-purple-500/30';
                        } else if (p.port === 22) {
                            colorCls = 'bg-amber-500/15 text-amber-300 border-amber-500/30';
                        }
                        const portTitle = p.webServerName ? `title="${escapeHtml(p.webServerName)} (Click for Web Console)"` : 'title="Click to Open in Console"';
                        if (linkTag) {
                            portsHtml += `<a ${linkTag} class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-mono font-bold border transition ${colorCls} cursor-pointer" ${portTitle}>${p.port}/${p.protocol} (${p.service || 'web'}) ↗</a>`;
                        } else {
                            portsHtml += `<span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-mono font-bold border ${colorCls}">${p.port}/${p.protocol}${p.service ? ' (' + p.service + ')' : ''}</span>`;
                        }
                    });
                    portsHtml += '</div>';
                }

                const webPort = h.httpPort || (h.ports.find(p => [80, 443, 8080, 8443].includes(p.port))?.port);
                const webConsoleBtn = webPort ? `
                    <button type="button" onclick="openDeviceWebConsole('${h.ip}', ${webPort}, '${escapeHtml(h.httpTitle || h.httpServerName || h.ip)}')" class="px-2 py-1 text-[11px] font-bold rounded-lg bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-300 border border-cyan-500/30 transition cursor-pointer flex items-center gap-1 shadow-xs" title="<%= isRtl ? 'فتح في المتصفح المدمج عبر البروكسي الداخلي' : 'Open in Built-in Browser Console' %>">
                        <svg class="w-3 h-3 text-cyan-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        <span><%= isRtl ? 'المتصفح' : 'Console' %></span>
                    </button>
                ` : '';

                html += `
                    <tr class="hover:bg-[var(--bg-hover)] transition-colors">
                        <td class="py-2.5 px-3.5">
                            <span class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400">
                                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span>UP</span>
                            </span>
                        </td>
                        <td class="py-2.5 px-3.5 font-mono font-black text-sm text-[var(--text-primary)]">
                            <div class="flex items-center gap-1.5">
                                <span>${h.ip}</span>
                                <button type="button" onclick="navigator.clipboard.writeText('${h.ip}'); showToast('Copied', 'IP copied to clipboard', 'info');" class="text-[var(--text-muted)] hover:text-white transition p-0.5 cursor-pointer" title="Copy IP">
                                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
                                </button>
                            </div>
                        </td>
                        <td class="py-2.5 px-3.5">${vendorBadge}</td>
                        <td class="py-2.5 px-3.5 font-mono text-[var(--text-secondary)]">${escapeHtml(h.hostname || '--')}</td>
                        <td class="py-2.5 px-3.5">${webServerHtml}</td>
                        <td class="py-2.5 px-3.5 font-mono text-xs text-[var(--text-muted)]">${h.mac || '--'}</td>
                        <td class="py-2.5 px-3.5 font-mono text-xs text-[var(--text-muted)]">${h.latencyMs ? h.latencyMs + 'ms' : '--'}</td>
                        <td class="py-2.5 px-3.5">${portsHtml}</td>
                        <td class="py-2.5 px-3.5 text-center">
                            <div class="flex items-center justify-center gap-1.5 flex-wrap">
                                ${webConsoleBtn}
                                <button type="button" onclick="startIpScan('${h.ip}', 'ports')" class="px-2 py-1 text-[11px] font-bold rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 transition cursor-pointer" title="${isRtl ? 'فحص كامل لمنافذ هذا الجهاز فقط' : 'Scan all ports on this device'}">
                                    ${isRtl ? 'المنافذ' : 'Ports'}
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function filterIpscanResults() {
            renderIpscanResults();
        }

        function setIpscanChipFilter(chip) {
            ipscanActiveChipFilter = chip;
            document.querySelectorAll('.ipscan-chip-btn').forEach(btn => {
                const isMatch = btn.dataset.chip === chip;
                btn.className = isMatch
                    ? 'ipscan-chip-btn px-3 py-1.5 rounded-lg font-bold border transition bg-cyan-600 border-cyan-500'
                    : 'ipscan-chip-btn px-3 py-1.5 rounded-lg font-bold border transition bg-[var(--bg-primary)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-cyan-500/50';
            });
            renderIpscanResults();
        }

        function exportIpscanCsv() {
            window.location.href = '/api/config/ipscan/export';
        }

        // --- BUILT-IN DEVICE WEB CONSOLE (LIVE REVERSE PROXY) ---
        let deviceWebConsoleIsFullscreen = false;

        function openDeviceWebConsole(ip, port, name) {
            const modal = document.getElementById('deviceWebConsoleModal');
            const iframe = document.getElementById('deviceWebConsoleIframe');
            const titleEl = document.getElementById('deviceWebConsoleTitle');
            const subTitleEl = document.getElementById('deviceWebConsoleSubTitle');
            const urlBar = document.getElementById('deviceWebConsoleUrlBar');
            const newTabBtn = document.getElementById('deviceWebConsoleNewTabBtn');
            const loader = document.getElementById('deviceWebConsoleLoading');

            if (!modal || !iframe) return;

            const cleanPort = port || 80;
            const proxyUrl = `/api/config/ipscan/proxy/${encodeURIComponent(ip)}/${encodeURIComponent(cleanPort)}/`;

            if (titleEl) titleEl.textContent = name || `Device ${ip}`;
            if (subTitleEl) subTitleEl.textContent = `${ip}:${cleanPort}`;
            if (urlBar) urlBar.value = `http://${ip}:${cleanPort}/`;
            if (newTabBtn) newTabBtn.href = proxyUrl;
            if (loader) loader.classList.remove('hidden');

            iframe.src = proxyUrl;
            modal.classList.remove('hidden');
        }

        function closeDeviceWebConsoleModal() {
            const modal = document.getElementById('deviceWebConsoleModal');
            const iframe = document.getElementById('deviceWebConsoleIframe');
            if (iframe) iframe.src = 'about:blank';
            if (modal) modal.classList.add('hidden');
        }

        function reloadDeviceWebConsole() {
            const iframe = document.getElementById('deviceWebConsoleIframe');
            const loader = document.getElementById('deviceWebConsoleLoading');
            if (loader) loader.classList.remove('hidden');
            if (iframe && iframe.src && iframe.src !== 'about:blank') {
                iframe.src = iframe.src;
            }
        }

        function onDeviceWebConsoleIframeLoaded() {
            const loader = document.getElementById('deviceWebConsoleLoading');
            if (loader) loader.classList.add('hidden');
        }

        function toggleDeviceWebConsoleFullscreen() {
            const dialog = document.getElementById('deviceWebConsoleDialog');
            if (!dialog) return;
            deviceWebConsoleIsFullscreen = !deviceWebConsoleIsFullscreen;
            if (deviceWebConsoleIsFullscreen) {
                dialog.className = 'bg-[var(--bg-secondary)] w-full h-full flex flex-col shadow-2xl transition-all duration-200 overflow-hidden';
            } else {
                dialog.className = 'bg-[var(--bg-secondary)] rounded-2xl border border-[var(--border-primary)] w-full max-w-6xl h-[92vh] flex flex-col shadow-2xl transition-all duration-200 overflow-hidden';
            }
        }

        window.addEventListener('message', function(e) {
            if (e.data && e.data.type === 'sokrat_proxy_nav') {
                const urlBar = document.getElementById('deviceWebConsoleUrlBar');
                const subTitleEl = document.getElementById('deviceWebConsoleSubTitle');
                if (urlBar && e.data.pathname) {
                    const hostPrefix = subTitleEl ? subTitleEl.textContent.trim() : '';
                    urlBar.value = (hostPrefix ? `http://${hostPrefix}` : '') + e.data.pathname + (e.data.search || '');
                }
            }
        });

        window.openDeviceWebConsole = openDeviceWebConsole;
        window.closeDeviceWebConsoleModal = closeDeviceWebConsoleModal;
        window.reloadDeviceWebConsole = reloadDeviceWebConsole;
        window.onDeviceWebConsoleIframeLoaded = onDeviceWebConsoleIframeLoaded;
        window.toggleDeviceWebConsoleFullscreen = toggleDeviceWebConsoleFullscreen;

        window.fetchIpscanInterfaces = fetchIpscanInterfaces;
        window.onIpscanIfaceChange = onIpscanIfaceChange;
        window.onIpscanProfileChange = onIpscanProfileChange;
        window.startIpScan = startIpScan;
        window.stopIpScan = stopIpScan;
        window.fetchIpscanStatus = fetchIpscanStatus;
        window.renderIpscanResults = renderIpscanResults;
        window.filterIpscanResults = filterIpscanResults;
        window.setIpscanChipFilter = setIpscanChipFilter;
        window.exportIpscanCsv = exportIpscanCsv;

        let allRecentTranscripts = [];
        async function loadRecentTranscripts() {
            const tbody = document.getElementById('sttRecentTableBody');
            if (!tbody) return;
            try {
                const res = await fetch('/api/transcripts/recent');
                const data = await res.json();
                if (data.success && Array.isArray(data.transcripts)) {
                    allRecentTranscripts = data.transcripts;
                    const badge = document.getElementById('sttRecentCountBadge');
                    if (badge) badge.textContent = allRecentTranscripts.length + ' <%= isRtl ? "مكالمة" : "calls" %>';
                    renderRecentTranscripts(allRecentTranscripts);
                } else {
                    tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-[var(--text-muted)]">${data.error || 'Failed to load'}</td></tr>`;
                }
            } catch (e) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-red-400">Error: ${e.message}</td></tr>`;
            }
        }
        function filterRecentTranscripts() {
            const q = (document.getElementById('sttTranscriptSearchInput')?.value || '').toLowerCase().trim();
            if (!q) return renderRecentTranscripts(allRecentTranscripts);
            const filtered = allRecentTranscripts.filter(t =>
                (t.transcript || '').toLowerCase().includes(q) ||
                String(t.src || '').includes(q) ||
                String(t.dst || '').includes(q)
            );
            renderRecentTranscripts(filtered);
        }
        function renderRecentTranscripts(list) {
            const tbody = document.getElementById('sttRecentTableBody');
            if (!tbody) return;
            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="py-6 text-center text-[var(--text-muted)]"><%= isRtl ? "لا توجد تفريغات حديثة مسجلة بعد." : "No recent transcriptions found." %></td></tr>';
                return;
            }
            tbody.innerHTML = list.map(item => {
                const dt = item.calldate ? new Date(item.calldate).toLocaleString() : (item.created_at ? new Date(item.created_at).toLocaleString() : '-');
                const srcDst = (item.src || '-') + ' &rarr; ' + (item.dst || '-');
                const dur = (item.duration_sec != null ? item.duration_sec : '-') + 's';
                let statusBadge = '<span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-blue-500/10 text-blue-400 border border-blue-500/20">Pending</span>';
                if (item.status === 'completed') {
                    const time = item.processing_ms ? ` (${(item.processing_ms/1000).toFixed(1)}s)` : '';
                    statusBadge = `<span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">Done${time}</span>`;
                } else if (item.status === 'processing') {
                    statusBadge = '<span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 animate-pulse">Running</span>';
                } else if (item.status === 'failed') {
                    statusBadge = '<span class="px-2 py-0.5 text-[10px] font-mono font-bold rounded bg-red-500/10 text-red-400 border border-red-500/20">Failed</span>';
                }
                const text = item.transcript || (item.status === 'completed' ? '[No speech detected]' : '-');
                return `
                    <tr class="hover:bg-[var(--bg-card)]/60 transition">
                        <td class="py-3 px-4 font-mono text-[11px] text-[var(--text-muted)] whitespace-nowrap">${dt}</td>
                        <td class="py-3 px-4 font-mono font-bold text-xs text-[var(--text-primary)] whitespace-nowrap">${srcDst}</td>
                        <td class="py-3 px-4 text-center font-mono text-[11px] text-[var(--text-muted)]">${dur}</td>
                        <td class="py-3 px-4 text-center whitespace-nowrap">${statusBadge}</td>
                        <td class="py-3 px-4 text-xs font-medium text-[var(--text-primary)] leading-relaxed dir-rtl text-right">${escapeSttHtml(text)}</td>
                    </tr>
                `;
            }).join('');
        }
        function escapeSttHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
        window.loadRecentTranscripts = loadRecentTranscripts;
        window.filterRecentTranscripts = filterRecentTranscripts;


        function renderModalPatterns() {
            const listEl = document.getElementById('outboundPatternsList');
            if (!listEl) return;
            listEl.innerHTML = '';
            if (modalPatternsList.length === 0) {
                listEl.innerHTML = '<span class="text-xs text-[var(--text-muted)] italic">No patterns added yet.</span>';
                return;
            }
            modalPatternsList.forEach((pat, idx) => {
                const div = document.createElement('div');
                if (idx === editingPatternIndex) {
                    div.className = 'flex items-center justify-between bg-blue-500/5 border border-blue-500/50 px-3 py-2 rounded-lg text-xs ring-1 ring-blue-500/60';
                } else {
                    div.className = 'flex items-center justify-between bg-[var(--bg-secondary)] border border-[var(--border-primary)] px-3 py-2 rounded-lg text-xs';
                }

                let htmlParts = [];
                if (pat.prepend) htmlParts.push(`<span class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-1 py-0.5 rounded font-mono font-bold">prepend: ${pat.prepend}</span>`);
                if (pat.prefix) htmlParts.push(`<span class="bg-blue-500/10 text-blue-400 border border-blue-500/20 px-1 py-0.5 rounded font-mono font-bold">prefix: ${pat.prefix}</span>`);
                htmlParts.push(`<span class="bg-[var(--bg-card)] text-[var(--text-primary)] border border-[var(--border-primary)] px-1.5 py-0.5 rounded font-mono font-extrabold text-blue-300">pattern: ${pat.pattern}</span>`);
                if (pat.cid) htmlParts.push(`<span class="bg-purple-500/10 text-purple-400 border border-purple-500/20 px-1 py-0.5 rounded font-mono font-bold">CID: ${pat.cid}</span>`);

                div.innerHTML = `
                    <div class="flex items-center gap-2 flex-wrap min-w-0">
                        ${htmlParts.join('')}
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <button type="button" onclick="editDialPatternInModalList(${idx})" class="text-blue-400 hover:underline text-[11px] cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                        <button type="button" onclick="removeDialPatternFromModalList(${idx})" class="text-red-400 hover:underline text-[11px] cursor-pointer"><span>${isRtl ? 'حذف' : 'Remove'}</span></button>
                    </div>
                `;
                listEl.appendChild(div);
            });
        }

        function editDialPatternInModalList(idx) {
            editingPatternIndex = idx;
            const pat = modalPatternsList[idx];
            document.getElementById('patPrepend').value = pat.prepend || '';
            document.getElementById('patPrefix').value = pat.prefix || '';
            document.getElementById('patPattern').value = pat.pattern || '';
            document.getElementById('patCid').value = pat.cid || '';

            renderModalPatterns();

            const btn = document.getElementById('addPatternBtn');
            if (btn) btn.textContent = isRtl ? 'تحديث النمط' : 'Update Pattern';
        }

        function addDialPatternToModalList() {
            const patternInput = document.getElementById('patPattern');
            const pattern = patternInput.value.trim();
            if (!pattern) {
                showToast(isRtl ? 'حقل النمط مطلوب.' : 'Pattern field is required.', 'error');
                return;
            }
            const prepend = document.getElementById('patPrepend').value.trim();
            const prefix = document.getElementById('patPrefix').value.trim();
            const cid = document.getElementById('patCid').value.trim();

            if (editingPatternIndex > -1) {
                modalPatternsList[editingPatternIndex] = { prepend, prefix, pattern, cid };
                editingPatternIndex = -1;
                const btn = document.getElementById('addPatternBtn');
                if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';
            } else {
                modalPatternsList.push({ prepend, prefix, pattern, cid });
            }

            renderModalPatterns();

            patternInput.value = '';
            document.getElementById('patPrepend').value = '';
            document.getElementById('patPrefix').value = '';
            document.getElementById('patCid').value = '';
        }

        function removeDialPatternFromModalList(idx) {
            modalPatternsList.splice(idx, 1);
            if (editingPatternIndex === idx) {
                editingPatternIndex = -1;
                const btn = document.getElementById('addPatternBtn');
                if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';
                document.getElementById('patPattern').value = '';
                document.getElementById('patPrepend').value = '';
                document.getElementById('patPrefix').value = '';
                document.getElementById('patCid').value = '';
            } else if (editingPatternIndex > idx) {
                editingPatternIndex--;
            }
            renderModalPatterns();
        }

        function renderModalTrunksSequence() {
            const listEl = document.getElementById('outboundTrunksSequenceList');
            if (!listEl) return;
            listEl.innerHTML = '';
            if (modalTrunksSequence.length === 0) {
                listEl.innerHTML = '<span class="text-xs text-[var(--text-muted)] italic">No trunks in sequence yet.</span>';
                return;
            }
            modalTrunksSequence.forEach((trunkId, idx) => {
                const trunkMatch = (loadedTrunksList || []).find(t => String(t.trunkid) === String(trunkId));
                let trunkName = trunkMatch ? trunkMatch.name : '';
                if (!trunkName && String(trunkId).startsWith('fed_peer_')) {
                    const pid = String(trunkId).replace('fed_peer_', '');
                    const peerMatch = (loadedFederationPeersList || []).find(p => String(p.id) === pid);
                    trunkName = peerMatch ? `[Remote PBX] ${peerMatch.node_name || 'Site ' + peerMatch.site_code}` : `Remote PBX #${pid}`;
                }
                if (!trunkName) trunkName = `Trunk ID #${trunkId}`;
                const div = document.createElement('div');
                div.className = 'flex items-center justify-between bg-[var(--bg-secondary)] border border-[var(--border-primary)] px-3 py-1.5 rounded-lg text-xs';
                div.innerHTML = `
                    <span class="font-bold text-[var(--text-primary)] font-mono">${idx + 1}. ${trunkName}</span>
                    <div class="flex items-center gap-2">
                        <button type="button" onclick="moveTrunkInSequence(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="text-blue-400 hover:text-blue-500 disabled:opacity-35 disabled:cursor-not-allowed text-[11px] cursor-pointer">▲</button>
                        <button type="button" onclick="moveTrunkInSequence(${idx}, 1)" ${idx === modalTrunksSequence.length - 1 ? 'disabled' : ''} class="text-blue-400 hover:text-blue-500 disabled:opacity-35 disabled:cursor-not-allowed text-[11px] cursor-pointer">▼</button>
                        <button type="button" onclick="removeTrunkFromModalSequence(${idx})" class="text-red-400 hover:text-red-500 ml-2 cursor-pointer">✕</button>
                    </div>
                `;
                listEl.appendChild(div);
            });
        }

        function addTrunkToModalSequence() {
            const selectEl = document.getElementById('sequenceTrunkSelect');
            const trunkId = selectEl.value;
            if (!trunkId) return;
            if (modalTrunksSequence.includes(trunkId)) {
                showToast(isRtl ? 'خط الربط موجود بالفعل في التسلسل.' : 'Trunk is already in the sequence.', 'error');
                return;
            }
            modalTrunksSequence.push(trunkId);
            renderModalTrunksSequence();
            selectEl.value = '';
        }

        function moveTrunkInSequence(idx, dir) {
            const targetIdx = idx + dir;
            if (targetIdx < 0 || targetIdx >= modalTrunksSequence.length) return;
            const temp = modalTrunksSequence[idx];
            modalTrunksSequence[idx] = modalTrunksSequence[targetIdx];
            modalTrunksSequence[targetIdx] = temp;
            renderModalTrunksSequence();
        }

        function removeTrunkFromModalSequence(idx) {
            modalTrunksSequence.splice(idx, 1);
            renderModalTrunksSequence();
        }


        let draggedOutboundRouteIndex = null;

        function fetchOutboundRoutes() {
            return fetch('/api/config/routes/outbound')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.routes) return;
                    loadedOutboundRoutesList = Array.isArray(data.routes) ? data.routes : [];
                    renderOutboundRoutesTable();
                })
                .catch(err => console.error(err));
        }

        function renderOutboundRoutesTable() {
            const tbody = document.getElementById('outbound-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';
            const list = loadedOutboundRoutesList || [];
            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد مسارات صادرة.' : 'No outbound routes found.') + '</td></tr>';
                return;
            }

            list.forEach((r, idx) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-[var(--bg-hover)] transition-colors border-b border-[var(--border-primary)]/50 group select-none cursor-grab active:cursor-grabbing';
                tr.dataset.routeId = r.route_id;
                tr.dataset.index = idx;
                tr.setAttribute('draggable', 'true');

                const priorityNumber = idx + 1;
                const patterns = Array.isArray(r.patterns) ? r.patterns : [];
                const patHtml = patterns.map(p => {
                    const textParts = [];
                    if (p.prepend) textParts.push(`<span class="text-emerald-400 font-bold font-mono" title="Prepend">(${p.prepend})</span>`);
                    if (p.prefix) textParts.push(`<span class="text-amber-400 font-mono" title="Prefix">${p.prefix} |</span>`);
                    textParts.push(`<span class="text-[var(--text-primary)] font-extrabold font-mono" title="Match Pattern">${p.pattern}</span>`);
                    if (p.cid) textParts.push(`<span class="text-purple-400 font-mono" title="Caller ID">/ ${p.cid}</span>`);
                    return `<div class="font-mono text-xs bg-[var(--bg-secondary)] px-2.5 py-1 rounded border border-[var(--border-primary)]/80 inline-flex items-center gap-1 mr-1.5 mb-1.5">${textParts.join('')}</div>`;
                }).join(' ') || '<span class="text-[var(--text-muted)]">-</span>';

                const trunks = Array.isArray(r.trunks) ? r.trunks : [];
                const trunkHtml = trunks.map(t => {
                    return `<div class="font-mono text-xs text-emerald-400 font-semibold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20 w-fit inline-block mr-1 mb-1">${escapeHtml(t.trunk_name || t.name || t.trunk_id || '')}</div>`;
                }).join(' ➔ ') || '<span class="text-[var(--text-muted)]">-</span>';

                tr.innerHTML = `
                    <td class="py-3 px-3 text-center">
                        <div class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-[var(--bg-secondary)] border border-[var(--border-primary)] text-xs font-bold text-[var(--text-secondary)] group-hover:border-blue-500/40 group-hover:text-blue-400 transition-colors" title="${isRtl ? 'اسحب لإعادة الترتيب' : 'Drag to reorder priority'}">
                            <svg class="w-3.5 h-3.5 text-[var(--text-muted)] group-hover:text-blue-400 shrink-0 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4 8h16M4 16h16" />
                            </svg>
                            <span>#${priorityNumber}</span>
                        </div>
                    </td>
                    <td class="py-3 px-4 font-mono font-bold text-[var(--text-muted)]">${r.route_id}</td>
                    <td class="py-3 px-4 font-bold text-[var(--text-primary)]">
                        <div>${escapeHtml(r.name)}</div>
                        ${r.outcid ? `<span class="inline-block mt-0.5 px-1.5 py-0.5 rounded bg-violet-500/15 text-violet-400 border border-violet-500/30 text-[10px] font-mono font-normal">CID: ${escapeHtml(r.outcid)}</span>` : '<span class="text-[10px] text-[var(--text-muted)] font-normal italic">All Extensions (Ext CID)</span>'}
                    </td>
                    <td class="py-3 px-4">${patHtml}</td>
                    <td class="py-3 px-4">${trunkHtml}</td>
                    <td class="py-3 px-4 text-center">
                        <div class="flex items-center justify-center gap-1.5">
                            <button type="button" title="${isRtl ? 'تحريك للأعلى' : 'Move Up'}" onclick="moveOutboundRoute(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="p-1 text-xs font-semibold ${idx === 0 ? 'opacity-25 cursor-not-allowed text-[var(--text-muted)]' : 'text-blue-400 hover:bg-blue-500/10 cursor-pointer'} rounded border border-[var(--border-primary)] transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" /></svg>
                            </button>
                            <button type="button" title="${isRtl ? 'تحريك للأسفل' : 'Move Down'}" onclick="moveOutboundRoute(${idx}, 1)" ${idx === list.length - 1 ? 'disabled' : ''} class="p-1 text-xs font-semibold ${idx === list.length - 1 ? 'opacity-25 cursor-not-allowed text-[var(--text-muted)]' : 'text-blue-400 hover:bg-blue-500/10 cursor-pointer'} rounded border border-[var(--border-primary)] transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
                            </button>
                            <button type="button" onclick="editOutboundRouteByIndex(${idx})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer transition-colors"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                            <button type="button" onclick="deleteOutboundRoute(${r.route_id})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer transition-colors"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                        </div>
                    </td>
                `;

                // Drag and Drop Event Listeners
                tr.addEventListener('dragstart', (e) => {
                    draggedOutboundRouteIndex = idx;
                    e.dataTransfer.effectAllowed = 'move';
                    e.dataTransfer.setData('text/plain', String(idx));
                    tr.classList.add('opacity-40', 'bg-blue-500/10');
                });

                tr.addEventListener('dragend', () => {
                    tr.classList.remove('opacity-40', 'bg-blue-500/10');
                    document.querySelectorAll('#outbound-table-body tr').forEach(row => {
                        row.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                    });
                });

                tr.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    const rect = tr.getBoundingClientRect();
                    const offset = e.clientY - rect.top;
                    document.querySelectorAll('#outbound-table-body tr').forEach(row => {
                        if (row !== tr) row.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                    });
                    if (offset < rect.height / 2) {
                        tr.classList.add('border-t-2', 'border-blue-500');
                        tr.classList.remove('border-b-2');
                    } else {
                        tr.classList.add('border-b-2', 'border-blue-500');
                        tr.classList.remove('border-t-2');
                    }
                });

                tr.addEventListener('dragleave', () => {
                    tr.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                });

                tr.addEventListener('drop', (e) => {
                    e.preventDefault();
                    tr.classList.remove('border-t-2', 'border-b-2', 'border-blue-500');
                    const fromIdx = draggedOutboundRouteIndex;
                    if (fromIdx === null || fromIdx === undefined || isNaN(fromIdx)) return;

                    const rect = tr.getBoundingClientRect();
                    const offset = e.clientY - rect.top;
                    let toIdx = idx;

                    if (fromIdx === toIdx) return;

                    const movedItem = loadedOutboundRoutesList.splice(fromIdx, 1)[0];
                    let targetInsertIdx = toIdx;
                    if (offset >= rect.height / 2) {
                        targetInsertIdx = fromIdx < toIdx ? toIdx : toIdx + 1;
                    } else {
                        targetInsertIdx = fromIdx < toIdx ? toIdx - 1 : toIdx;
                    }
                    if (targetInsertIdx < 0) targetInsertIdx = 0;
                    if (targetInsertIdx > loadedOutboundRoutesList.length) targetInsertIdx = loadedOutboundRoutesList.length;

                    loadedOutboundRoutesList.splice(targetInsertIdx, 0, movedItem);
                    saveOutboundRoutesOrder();
                });

                tbody.appendChild(tr);
            });
        }

        function moveOutboundRoute(idx, direction) {
            const targetIdx = idx + direction;
            if (!loadedOutboundRoutesList || targetIdx < 0 || targetIdx >= loadedOutboundRoutesList.length) return;
            const temp = loadedOutboundRoutesList[idx];
            loadedOutboundRoutesList[idx] = loadedOutboundRoutesList[targetIdx];
            loadedOutboundRoutesList[targetIdx] = temp;
            saveOutboundRoutesOrder();
        }

        function saveOutboundRoutesOrder() {
            const routeIds = (loadedOutboundRoutesList || []).map(r => r.route_id);
            renderOutboundRoutesTable();

            fetch('/api/config/routes/outbound/reorder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ route_ids: routeIds })
            })
            .then(res => {
                if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                return res.json();
            })
            .then(data => {
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ أولوية المسارات الصادرة بنجاح.' : 'Outbound routes priority reordered successfully.', 'success');
                } else {
                    showToast(data.error || 'Failed to reorder routes', 'error');
                    fetchOutboundRoutes();
                }
            })
            .catch(err => {
                console.error(err);
                showToast('Network error while reordering routes', 'error');
                fetchOutboundRoutes();
            });
        }

        function editOutboundRouteByIndex(idx) {
            const r = (loadedOutboundRoutesList || [])[idx] || (loadedOutboundRoutesList || []).find(x => String(x.route_id) === String(idx));
            if (r) {
                editOutboundRoute(r.route_id, r.name, r.patterns, r.trunks, r.outcid, r.outcid_mode);
            } else {
                openOutboundModal();
            }
        }

        function openOutboundModal() {
            openModal('outboundModal');
            document.getElementById('outboundModalTitle').textContent = isRtl ? 'إضافة مسار صادر' : 'Add Outbound Route';
            document.getElementById('outboundEditId').value = "";
            document.getElementById('outboundForm').reset();
            if (document.getElementById('outCid')) document.getElementById('outCid').value = '';
            if (document.getElementById('outCidOverride')) document.getElementById('outCidOverride').checked = false;
            modalPatternsList = [];
            modalTrunksSequence = [];
            editingPatternIndex = -1;

            const btn = document.getElementById('addPatternBtn');
            if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';

            const sel = document.getElementById('sequenceTrunkSelect');
            if (sel) {
                sel.innerHTML = '<option value="">-- Choose Trunk --</option>';
                (loadedTrunksList || []).forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.trunkid;
                    opt.textContent = `${t.name} (${t.tech})`;
                    sel.appendChild(opt);
                });
            }

            renderModalPatterns();
            renderModalTrunksSequence();
        }

        function editOutboundRoute(routeId, name, patterns, trunks, outcid = '', outcid_mode = '') {
            openModal('outboundModal');
            document.getElementById('outboundModalTitle').textContent = (isRtl ? 'تعديل المسار الصادر ' : 'Edit Outbound Route ') + (name || '');
            document.getElementById('outboundEditId').value = routeId;
            document.getElementById('outName').value = name || '';
            if (document.getElementById('outCid')) document.getElementById('outCid').value = outcid || '';
            if (document.getElementById('outCidOverride')) document.getElementById('outCidOverride').checked = (outcid_mode === 'override_extension');
            editingPatternIndex = -1;

            const btn = document.getElementById('addPatternBtn');
            if (btn) btn.textContent = isRtl ? '+ إضافة نمط' : '+ Add Pattern';

            if (Array.isArray(patterns)) {
                modalPatternsList = patterns;
            } else {
                try { modalPatternsList = JSON.parse(patterns) || []; } catch(e) { modalPatternsList = []; }
            }

            if (Array.isArray(trunks)) {
                const trs = [...trunks].sort((a,b) => (a.seq || 0) - (b.seq || 0));
                modalTrunksSequence = trs.map(t => String(t.trunk_id));
            } else {
                try {
                    const trs = JSON.parse(trunks) || [];
                    trs.sort((a,b) => (a.seq || 0) - (b.seq || 0));
                    modalTrunksSequence = trs.map(t => String(t.trunk_id));
                } catch(e) { modalTrunksSequence = []; }
            }
            const sel = document.getElementById('sequenceTrunkSelect');
            if (sel) {
                sel.innerHTML = '<option value="">-- Choose Trunk --</option>';
                (loadedTrunksList || []).forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.trunkid;
                    opt.textContent = `${t.name} (${t.tech})`;
                    sel.appendChild(opt);
                });
            }

            renderModalPatterns();
            renderModalTrunksSequence();
        }

        function saveOutboundRoute(e) {
            e.preventDefault();
            const editId = document.getElementById('outboundEditId').value;
            const name = document.getElementById('outName').value.trim();

            if (modalPatternsList.length === 0) {
                showToast(isRtl ? 'يرجى إضافة نمط اتصال واحد على الأقل.' : 'Please add at least one Dial Pattern.', 'error');
                return;
            }
            const sel = document.getElementById('sequenceTrunkSelect');
            if (modalTrunksSequence.length === 0 && sel && sel.value) {
                addTrunkToModalSequence();
            }

            if (modalTrunksSequence.length === 0) {
                showToast(isRtl ? 'يرجى إضافة خط ربط واحد على الأقل في التسلسل (اضغط "Add").' : 'Please add at least one Trunk to the sequence (click "Add").', 'error');
                return;
            }

            const url = editId ? '/api/config/routes/outbound/' + editId : '/api/config/routes/outbound';
            const method = editId ? 'PUT' : 'POST';

            const submitBtn = e.target ? (e.target.matches('button') ? e.target : e.target.querySelector('button[type="submit"]')) : null;
            if (submitBtn) setButtonLoading(submitBtn, true);

            const outcid = document.getElementById('outCid') ? document.getElementById('outCid').value.trim() : '';
            const outcid_mode = (document.getElementById('outCidOverride') && document.getElementById('outCidOverride').checked) ? 'override_extension' : '';

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    name,
                    outcid,
                    outcid_mode,
                    patterns: modalPatternsList,
                    trunks: modalTrunksSequence
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('outboundModal');
                    fetchOutboundRoutes();
                } else showToast(data.error, 'error');
            })
            .catch(err => showToast(err.message, 'error'))
            .finally(() => {
                if (submitBtn) setButtonLoading(submitBtn, false);
            });
        }

        async function deleteOutboundRoute(routeId) {
            const ok = await window.sokratConfirm({
                title: isRtl ? 'حذف المسار الصادر' : 'Delete Outbound Route',
                message: isRtl ? `هل أنت متأكد من حذف المسار الصادر #${routeId}؟` : `Are you sure you want to delete outbound route ID ${routeId}?`,
                confirmText: isRtl ? 'حذف' : 'Delete',
                type: 'danger'
            });
            if (!ok) return;
            fetch('/api/config/routes/outbound/' + routeId, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchOutboundRoutes();
                    } else showToast(data.error, 'error');
                })
                .catch(err => showToast(err.message || 'Failed to delete outbound route', 'error'));
        }
        window.fetchOutboundRoutes = fetchOutboundRoutes;
        window.editOutboundRouteByIndex = editOutboundRouteByIndex;
        window.editOutboundRoute = editOutboundRoute;
        window.deleteOutboundRoute = deleteOutboundRoute;
        window.saveOutboundRoute = saveOutboundRoute;
        window.openOutboundModal = openOutboundModal;
        window.renderModalPatterns = renderModalPatterns;
        window.editDialPatternInModalList = editDialPatternInModalList;
        window.addDialPatternToModalList = addDialPatternToModalList;
        window.removeDialPatternFromModalList = removeDialPatternFromModalList;
        window.renderModalTrunksSequence = renderModalTrunksSequence;
        window.addTrunkToModalSequence = addTrunkToModalSequence;
        window.moveTrunkInSequence = moveTrunkInSequence;
        window.removeTrunkFromModalSequence = removeTrunkFromModalSequence;
        window.loadDongleInfoPopup = loadDongleInfoPopup;

        // Global format helper function
        window.selectDialFormat = function(format) {
            const input = document.getElementById('trunkDialString');
            if (input) {
                input.value = format;
                input.dispatchEvent(new Event('input'));
            }
            const popup = document.getElementById('dongleInfoPopup');
            if (popup) popup.classList.add('hidden');
        };

        window.selectInboundDid = function(didValue) {
            const input = document.getElementById('inExtension');
            if (input) {
                input.value = didValue;
                input.dispatchEvent(new Event('input'));
            }
            const popup = document.getElementById('inboundDongleInfoPopup');
            if (popup) popup.classList.add('hidden');
        };

        // Load dongle list for inbound route DID pop-up helper
        function loadInboundDonglePopup() {
            const listContainer = document.getElementById('inboundDongleList');
            if (!listContainer) return;

            listContainer.innerHTML = '<span class="text-[11px] text-[var(--text-muted)]">Loading...</span>';
            const isRtl = '<%= isRtl %>' === 'true';

            fetch('/api/config/dongle-mappings')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.mappings || data.mappings.length === 0) {
                        listContainer.innerHTML = `<span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'لا توجد أجهزة متصلة' : 'No connected dongles found.'}</span>`;
                        return;
                    }

                    listContainer.innerHTML = '';
                    data.mappings.forEach(d => {
                        const div = document.createElement('div');
                        div.className = 'flex flex-col sm:flex-row sm:items-center justify-between p-2.5 hover:bg-[var(--bg-hover)]/30 rounded-lg border border-[var(--border-primary)]/40 gap-2 font-mono text-[11px] flex-wrap whitespace-normal break-all';

                        const stateStr = String(d.state || '').toLowerCase();
                        const statusColor = stateStr === 'free' ? 'text-green-400' : 'text-amber-400';
                        const num = d.phoneNumber || (d.simNumber !== 'Unknown' && d.simNumber !== '-' ? d.simNumber : '');

                        const infoDiv = document.createElement('div');
                        infoDiv.className = 'flex flex-col text-left';

                        const titleSpan = document.createElement('span');
                        titleSpan.className = 'font-bold text-[var(--text-primary)]';
                        titleSpan.textContent = d.dongleName + (num ? ' (' + num + ')' : ' ');

                        const stateSpan = document.createElement('span');
                        stateSpan.className = 'text-[10px] ' + statusColor + ' ml-1.5 font-semibold';
                        stateSpan.textContent = d.state || 'Unknown';
                        titleSpan.appendChild(stateSpan);

                        const providerSpan = document.createElement('span');
                        providerSpan.className = 'text-[10px] text-[var(--text-muted)]';
                        providerSpan.textContent = 'Provider: ' + (d.provider || 'None');

                        infoDiv.appendChild(titleSpan);
                        infoDiv.appendChild(providerSpan);

                        const btnGroup = document.createElement('div');
                        btnGroup.className = 'flex items-center gap-1.5 shrink-0';

                        if (num) {
                            const btnNum = document.createElement('button');
                            btnNum.type = 'button';
                            btnNum.className = 'px-2 py-0.5 text-[9px] bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded cursor-pointer transition-colors';
                            btnNum.textContent = 'Use Number (' + num + ')';
                            btnNum.addEventListener('click', () => selectInboundDid(num));
                            btnGroup.appendChild(btnNum);
                        }

                        div.appendChild(infoDiv);
                        div.appendChild(btnGroup);
                        listContainer.appendChild(div);
                    });
                    if (typeof window.positionInboundDonglePopup === 'function') window.positionInboundDonglePopup();
                })
                .catch(err => {
                    listContainer.innerHTML = `<span class="text-[11px] text-red-400">Error: ${err.message}</span>`;
                    if (typeof window.positionInboundDonglePopup === 'function') window.positionInboundDonglePopup();
                });
        }

        // Load dongle list for custom dial string pop-up helper
        function loadDongleInfoPopup() {
            const listContainer = document.getElementById('dongleInfoList');
            if (!listContainer) return;

            listContainer.innerHTML = '<span class="text-[11px] text-[var(--text-muted)]">Loading...</span>';
            const isRtl = '<%= isRtl %>' === 'true';

            fetch('/api/gsm-dongles')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.devices || data.devices.length === 0) {
                        listContainer.innerHTML = `<span class="text-[11px] text-[var(--text-muted)]">${isRtl ? 'لا توجد أجهزة متصلة' : 'No connected dongles found.'}</span>`;
                        return;
                    }

                    listContainer.innerHTML = '';
                    data.devices.forEach(d => {
                        const div = document.createElement('div');
                        div.className = 'flex flex-col sm:flex-row sm:items-center justify-between p-2.5 hover:bg-[var(--bg-hover)]/30 rounded-lg border border-[var(--border-primary)]/40 gap-2 font-mono text-[11px]';

                        const statusColor = d.State.toLowerCase() === 'free' ? 'text-green-400' : 'text-amber-400';
                        const cleanImei = String(d.IMEI || '').trim();
                        const hasImei = cleanImei && cleanImei !== '-';
                        const provider = d['Provider Name'] || 'None';

                        const dongleIdName = escapeHtml(d.ID || d.dongleName || '');
                        const numStr = d.Number && d.Number !== 'Unknown' && d.Number !== '-' ? ` (${escapeHtml(d.Number)})` : '';
                        div.innerHTML = `
                            <div class="flex flex-col text-left">
                                <span class="font-bold text-[var(--text-primary)]">
                                    ${dongleIdName}${numStr}
                                    <span class="text-[10px] ${statusColor} ml-1.5 font-semibold">${escapeHtml(d.State || '')}</span>
                                </span>
                                <span class="text-[10px] text-[var(--text-muted)]">Provider: ${escapeHtml(provider)} | IMEI: ${escapeHtml(cleanImei)}</span>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" onclick="selectDialFormat('dongle/${dongleIdName}/$OUTNUM$')" class="px-2 py-0.5 text-[9px] bg-blue-500/10 hover:bg-blue-500/20 text-blue-400 border border-blue-500/30 rounded cursor-pointer transition-colors">
                                    Use ID (${dongleIdName})
                                </button>
                                ${hasImei ? `
                                <button type="button" onclick="selectDialFormat('dongle/i:${escapeHtml(cleanImei)}/$OUTNUM$')" class="px-2 py-0.5 text-[9px] bg-purple-500/10 hover:bg-purple-500/20 text-purple-400 border border-purple-500/30 rounded cursor-pointer transition-colors">
                                    Use IMEI
                                </button>
                                ` : ''}
                            </div>
                        `;
                        listContainer.appendChild(div);
                    });
                    if (typeof window.positionDonglePopup === 'function') window.positionDonglePopup();
                })
                .catch(err => {
                    listContainer.innerHTML = `<span class="text-[11px] text-red-400">Error: ${err.message}</span>`;
                    if (typeof window.positionDonglePopup === 'function') window.positionDonglePopup();
                });
        }

        // Initialize on load
        function initConfigPage() {
            initTopPillBarWheelScroll();
            window.setPbxNavLayout(localStorage.getItem('pbx_nav_layout') || 'topbar');
            const tabButtons = ['extensions', 'ringgroups', 'inbound', 'trunks', 'outbound', 'queues', 'timegroups', 'timeconditions', 'voicemail', 'ivr', 'recordings', 'stt', 'diagram', 'announcements', 'modem', 'callcodes', 'dongles', 'terminal'];
            let defaultTab = null;
            for (const t of tabButtons) {
                if (document.getElementById('tab-btn-' + t)) {
                    defaultTab = t;
                    break;
                }
            }
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = urlParams.get('tab');
            if (tabParam === 'callcodes') {
                defaultTab = 'callcodes';
            } else if (tabParam && document.getElementById('tab-btn-' + tabParam)) {
                defaultTab = tabParam;
            }
            if (defaultTab) {
                switchTab(defaultTab);
            }
            const dialInput = document.getElementById('trunkDialString');
            const popup = document.getElementById('dongleInfoPopup');
            if (dialInput && popup) {
                if (popup.parentNode !== document.body) {
                    document.body.appendChild(popup);
                }
                window.positionDonglePopup = function() {
                    if (popup.classList.contains('hidden')) return;
                    const rect = dialInput.getBoundingClientRect();
                    const width = Math.min(Math.max(rect.width, 460), window.innerWidth - 16);
                    popup.style.width = width + 'px';
                    let left = rect.left;
                    if (left + width > window.innerWidth - 8) {
                        left = window.innerWidth - width - 8;
                    }
                    if (left < 8) left = 8;
                    popup.style.position = 'fixed';
                    popup.style.left = left + 'px';
                    popup.style.zIndex = '999999';
                    const maxAvailHeight = Math.min(window.innerHeight - 30, 280);
                    popup.style.maxHeight = maxAvailHeight + 'px';
                    const spaceBelow = window.innerHeight - rect.bottom;
                    const spaceAbove = rect.top;
                    const popupEstHeight = Math.min(popup.offsetHeight || 220, maxAvailHeight);
                    if (spaceBelow < popupEstHeight && spaceAbove > spaceBelow) {
                        popup.style.top = 'auto';
                        popup.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
                    } else {
                        popup.style.top = (rect.bottom + 6) + 'px';
                        popup.style.bottom = 'auto';
                    }
                };

                dialInput.addEventListener('focus', () => {
                    popup.classList.remove('hidden');
                    window.positionDonglePopup();
                    loadDongleInfoPopup();
                });
                dialInput.addEventListener('click', () => {
                    popup.classList.remove('hidden');
                    window.positionDonglePopup();
                });
                document.addEventListener('click', (e) => {
                    if (!dialInput.contains(e.target) && !popup.contains(e.target)) {
                        popup.classList.add('hidden');
                    }
                });
                window.addEventListener('scroll', () => {
                    if (!popup.classList.contains('hidden')) window.positionDonglePopup();
                }, true);
                window.addEventListener('resize', () => {
                    if (!popup.classList.contains('hidden')) window.positionDonglePopup();
                });
            }
            // Inbound route DID dongle popup handlers
            const inExtInput = document.getElementById('inExtension');
            const inPopup = document.getElementById('inboundDongleInfoPopup');
            if (inExtInput && inPopup) {
                if (inPopup.parentNode !== document.body) {
                    document.body.appendChild(inPopup);
                }

                window.positionInboundDonglePopup = function() {
                    if (inPopup.classList.contains('hidden')) return;
                    const rect = inExtInput.getBoundingClientRect();
                    const width = Math.min(Math.max(rect.width, 460), window.innerWidth - 16);
                    inPopup.style.width = width + 'px';
                    let left = rect.left;
                    if (left + width > window.innerWidth - 8) {
                        left = window.innerWidth - width - 8;
                    }
                    if (left < 8) left = 8;

                    inPopup.style.position = 'fixed';
                    inPopup.style.left = left + 'px';
                    inPopup.style.zIndex = '999999';

                    const spaceBelow = window.innerHeight - rect.bottom - 16;
                    const spaceAbove = rect.top - 16;
                    const maxPopupHeight = Math.min(320, Math.max(spaceBelow, spaceAbove, 180));

                    inPopup.style.maxHeight = maxPopupHeight + 'px';
                    inPopup.style.overflow = 'hidden';

                    const listEl = document.getElementById('inboundDongleList');
                    if (listEl) {
                        listEl.style.maxHeight = Math.max(80, maxPopupHeight - 45) + 'px';
                        listEl.style.overflowY = 'auto';
                    }

                    if (spaceBelow < 220 && spaceAbove > spaceBelow) {
                        inPopup.style.top = 'auto';
                        inPopup.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
                    } else {
                        inPopup.style.top = (rect.bottom + 6) + 'px';
                        inPopup.style.bottom = 'auto';
                    }
                };

                inExtInput.addEventListener('focus', () => {
                    inPopup.classList.remove('hidden');
                    window.positionInboundDonglePopup();
                    loadInboundDonglePopup();
                });
                inExtInput.addEventListener('click', () => {
                    inPopup.classList.remove('hidden');
                    window.positionInboundDonglePopup();
                });

                document.addEventListener('click', (e) => {
                    if (!inExtInput.contains(e.target) && !inPopup.contains(e.target)) {
                        inPopup.classList.add('hidden');
                    }
                });

                window.addEventListener('scroll', () => {
                    if (!inPopup.classList.contains('hidden')) window.positionInboundDonglePopup();
                }, true);
                window.addEventListener('resize', () => {
                    if (!inPopup.classList.contains('hidden')) window.positionInboundDonglePopup();
                });
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initConfigPage);
        } else {
            initConfigPage();
        }

        // --- 7. VOICEMAIL CONFIGURATION ---

        function fetchVoicemailExtensions() {
            const checklist = document.getElementById('vmMailboxChecklist');
            if (!checklist) return;

            // Always fetch and populate available system recordings into dropdown
            fetch('/api/config/recordings')
                .then(res => res.json())
                .then(recData => {
                    if (recData.success && recData.recordings) {
                        loadedRecordingsList = recData.recordings;
                        populateVmGreetingSelect();
                    }
                })
                .catch(() => {});

            checklist.innerHTML = `<span class="text-xs text-[var(--text-muted)] italic">${isRtl ? 'جاري تحميل صناديق البريد...' : 'Loading mailboxes...'}</span>`;

            fetch('/api/config/voicemail/extensions')
                .then(res => res.json())
                .then(data => {
                    if (!data.success || !data.extensions) return;
                    vmExtensionsList = Array.isArray(data.extensions) ? data.extensions : [];
                    const list = vmExtensionsList;
                    checklist.innerHTML = '';
                    if (list.length === 0) {
                        checklist.innerHTML = `<span class="text-xs text-[var(--text-muted)] italic">${isRtl ? 'لم يتم العثور على تحويلات مفعل بها البريد الصوتي.' : 'No voicemail-enabled extensions found.'}</span>`;
                        return;
                    }

                    data.extensions.forEach(ext => {
                        const label = document.createElement('label');
                        label.className = 'flex items-center justify-between gap-2 p-2 hover:bg-[var(--bg-hover)]/40 rounded-lg cursor-pointer text-xs transition';

                        const greetingBadge = ext.hasCustomGreeting ? `
                            <span class="text-[10px] text-emerald-400 font-bold bg-emerald-500/10 border border-emerald-500/20 px-2 py-0.5 rounded-md flex items-center gap-1.5 font-mono shrink-0 max-w-[220px] truncate shadow-sm" title="${escapeHtml(ext.greetingName || (isRtl ? 'ترحيب مخصص' : 'Custom Greeting'))}">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                <span class="truncate">${escapeHtml(ext.greetingName || (isRtl ? 'ترحيب مخصص' : 'Custom Greeting'))}</span>
                            </span>
                        ` : `
                            <span class="text-[10px] text-[var(--text-muted)] bg-[var(--bg-card)] border border-[var(--border-primary)] px-2 py-0.5 rounded-md font-mono shrink-0">
                                ${isRtl ? 'ترحيب افتراضي' : 'Default Greeting'}
                            </span>
                        `;

                        label.innerHTML = `
                            <span class="flex items-center gap-2 font-mono min-w-0 truncate">
                                <input type="checkbox" name="vm_mailbox" value="${escapeHtml(ext.extension)}" class="tab-checkbox vm-ext-chk">
                                <span class="font-bold text-[var(--text-primary)] shrink-0">${escapeHtml(ext.extension)}</span>
                                <span class="text-[var(--text-muted)] truncate">- ${escapeHtml(ext.name || '')}</span>
                            </span>
                            ${greetingBadge}
                        `;
                        checklist.appendChild(label);
                    });
                })
                .catch(err => {
                    checklist.innerHTML = `<span class="text-xs text-red-400">Error: ${err.message}</span>`;
                });
        }

        function toggleVmAllMailboxes() {
            const allChecked = document.getElementById('vmAllMailboxes').checked;
            const checkboxes = document.querySelectorAll('.vm-ext-chk');
            checkboxes.forEach(chk => chk.checked = allChecked);
        }

        function populateVmGreetingSelect() {
            const selectEl = document.getElementById('vmGreetingSelect');
            if (!selectEl) return;
            const currentVal = selectEl.value;
            selectEl.innerHTML = '<option value="">-- Choose Recording --</option>';
            (loadedRecordingsList || []).forEach(rec => {
                if (rec.displayname === '__invalid') return;
                const opt = document.createElement('option');
                opt.value = rec.id;
                opt.textContent = `${rec.displayname} (${rec.filename})`;
                if (currentVal && String(rec.id) === String(currentVal)) {
                    opt.selected = true;
                }
                selectEl.appendChild(opt);
            });
        }

        function saveVoicemailGreeting(e) {
            e.preventDefault();
            const recordingId = document.getElementById('vmGreetingSelect').value;
            const checkboxes = document.querySelectorAll('.vm-ext-chk:checked');
            const allEnabled = document.getElementById('vmAllMailboxes').checked;

            const extensions = Array.from(checkboxes).map(chk => chk.value);

            if (!allEnabled && extensions.length === 0) {
                showToast(isRtl ? 'يرجى اختيار تحويلة واحدة على الأقل.' : 'Please select at least one extension mailbox.', 'error');
                return;
            }

            fetch('/api/config/voicemail/greeting', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recordingId, extensions, allEnabled })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchVoicemailExtensions();
                } else showToast(data.error, 'error');
            });
        }

        function resetVoicemailGreetings() {
            const checkboxes = document.querySelectorAll('.vm-ext-chk:checked');
            const allEnabled = document.getElementById('vmAllMailboxes').checked;
            const extensions = Array.from(checkboxes).map(chk => chk.value);

            if (!allEnabled && extensions.length === 0) {
                showToast(isRtl ? 'يرجى اختيار تحويلة واحدة على الأقل للإرجاع للوضع الافتراضي.' : 'Please select at least one mailbox to reset.', 'error');
                return;
            }

            fetch('/api/config/voicemail/reset', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ extensions })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchVoicemailExtensions();
                } else showToast(data.error, 'error');
            });
        }

        // --- 8. CONFIG DIAGRAM ENGINE ---
        let diagramRawData = null;
        let diagramNodesList = [];
        let diagramLinks = [];
        let diagramRenderCtx = null; // { cardWidth, cardHeight, makeWirePath } set by renderDiagram
        let diagramCardDrag = null;

        let zoomScale = 1.0;
        let panX = 0;
        let panY = 0;
        let isDragging = false;
        let startX, startY;
        let isPanZoomInitialized = false;

        const DIAGRAM_LAYOUT_KEY = 'config_diagram_layout_v1';

        const WIRE_COLORS = {
            'inbound-dest': '#10b981', 'inbound-tc': '#eab308', 'inbound-ivr': '#3b82f6',
            'tc-true': '#10b981', 'tc-false': '#ef4444', 'tc-ivr': '#3b82f6',
            'ivr-entry': '#3b82f6', 'ivr-timeout': '#f59e0b', 'ivr-invalid': '#ef4444',
            'rg-member': '#a855f7', 'queue-member': '#f59e0b', 'queue-failover': '#ef4444',
            'queue-continue': '#38bdf8', 'ext-route-restricted': '#f97316', 'ext-route-global': '#64748b',
            'route-trunk': '#06b6d4'
        };
        const FAILING_WIRES = new Set(['tc-false', 'ivr-invalid', 'queue-failover']);

        function saveDiagramNodePosition(nodeId, x, y) {
            try {
                const saved = JSON.parse(localStorage.getItem(DIAGRAM_LAYOUT_KEY)) || {};
                saved[nodeId] = { x: Math.round(x), y: Math.round(y) };
                localStorage.setItem(DIAGRAM_LAYOUT_KEY, JSON.stringify(saved));
            } catch (_) {}
        }

        window.resetDiagramLayout = function () {
            try { localStorage.removeItem(DIAGRAM_LAYOUT_KEY); } catch (_) {}
            renderDiagram();
            sizeDiagramCanvas();
            setTimeout(fitDiagramToScreen, 50);
        };

        // Stretch the diagram canvas to consume all remaining viewport space
        function sizeDiagramCanvas() {
            const section = document.getElementById('section-diagram');
            const container = document.getElementById('diagramCanvasContainer');
            if (!section || !container || section.classList.contains('hidden')) return;
            const top = container.getBoundingClientRect().top;
            const available = window.innerHeight - top - 24;
            container.style.height = Math.max(560, Math.floor(available)) + 'px';
        }
        window.sizeDiagramCanvas = sizeDiagramCanvas;
        window.addEventListener('resize', () => {
            sizeDiagramCanvas();
            if (typeof fitDiagramToScreen === 'function' && diagramNodesList.length) fitDiagramToScreen();
        });

        function initDiagramNodeDragging() {
            const svgNodes = document.getElementById('diagramNodes');
            if (!svgNodes || svgNodes.dataset.dragInit === '1') return;
            svgNodes.dataset.dragInit = '1';

            const toSvgCoords = (clientX, clientY) => {
                const svg = document.getElementById('diagramSvg');
                const rect = svg.getBoundingClientRect();
                return {
                    x: (clientX - rect.left - panX) / zoomScale,
                    y: (clientY - rect.top - panY) / zoomScale
                };
            };

            svgNodes.addEventListener('pointerdown', (e) => {
                if (e.button !== 0) return;
                const cardEl = e.target.closest && e.target.closest('[data-node-id]');
                if (!cardEl) return;
                const nodeId = cardEl.getAttribute('data-node-id');
                const node = diagramNodesList.find(n => n.id === nodeId);
                if (!node || !diagramRenderCtx) return;
                e.stopPropagation();
                const pt = toSvgCoords(e.clientX, e.clientY);
                diagramCardDrag = {
                    node,
                    fo: cardEl.closest('foreignObject'),
                    dx: pt.x - node.x,
                    dy: pt.y - node.y,
                    moved: false
                };
                const svgEl = document.getElementById('diagramSvg');
                if (svgEl) svgEl.classList.add('wires-live');
                try { cardEl.setPointerCapture(e.pointerId); } catch (_) {}
            }, true);

            svgNodes.addEventListener('pointermove', (e) => {
                if (!diagramCardDrag) return;
                const ctx = diagramRenderCtx;
                const pt = toSvgCoords(e.clientX, e.clientY);
                let nx = pt.x - diagramCardDrag.dx;
                let ny = pt.y - diagramCardDrag.dy;
                if (!diagramCardDrag.moved && (Math.abs(nx - diagramCardDrag.node.x) > 2 || Math.abs(ny - diagramCardDrag.node.y) > 2)) {
                    diagramCardDrag.moved = true;
                    document.body.style.userSelect = 'none';
                }
                if (!diagramCardDrag.moved) return;

                // No invisible walls: the coordinate space starts at (0,0), so dragging
                // past the top/left edge shifts the WHOLE board (nodes, cards, wires)
                // instead of blocking the card.
                const EDGE_PAD = 60;
                if (nx < EDGE_PAD || ny < EDGE_PAD) {
                    const shiftX = nx < EDGE_PAD ? Math.ceil(EDGE_PAD - nx) : 0;
                    const shiftY = ny < EDGE_PAD ? Math.ceil(EDGE_PAD - ny) : 0;
                    if (shiftX || shiftY) {
                        diagramNodesList.forEach(n => { n.x += shiftX; n.y += shiftY; });
                        const nodeById = new Map(diagramNodesList.map(n => [n.id, n]));
                        svgNodes.querySelectorAll('foreignObject').forEach(fo => {
                            const div = fo.querySelector && fo.querySelector('[data-node-id]');
                            const n = div ? nodeById.get(div.getAttribute('data-node-id')) : null;
                            if (n) {
                                fo.setAttribute('x', n.x);
                                fo.setAttribute('y', n.y);
                            }
                        });
                        document.querySelectorAll('.diagram-wire').forEach(wire => {
                            const src = nodeById.get(wire.getAttribute('data-src'));
                            const tgt = nodeById.get(wire.getAttribute('data-tgt'));
                            if (src && tgt) {
                                wire.removeAttribute('stroke-dasharray');
                                wire.removeAttribute('stroke-dashoffset');
                                wire.setAttribute('d', ctx.makeWirePath(src, tgt));
                            }
                        });
                        nx += shiftX;
                        ny += shiftY;
                    }
                }

                diagramCardDrag.node.x = nx;
                diagramCardDrag.node.y = ny;
                if (diagramCardDrag.fo) {
                    diagramCardDrag.fo.setAttribute('x', nx);
                    diagramCardDrag.fo.setAttribute('y', ny);
                }

                // Grow the canvas on demand — dragging toward any edge expands the
                // drawable area instead of clipping the card.
                const svgEl = document.getElementById('diagramSvg');
                if (svgEl) {
                    const curW = parseFloat(svgEl.getAttribute('width')) || 0;
                    const curH = parseFloat(svgEl.getAttribute('height')) || 0;
                    const needW = nx + ctx.cardWidth + 160;
                    const needH = ny + ctx.cardHeight + 160;
                    if (needW > curW) {
                        svgEl.setAttribute('width', String(Math.ceil(needW)));
                        svgEl.style.width = Math.ceil(needW) + 'px';
                    }
                    if (needH > curH) {
                        svgEl.setAttribute('height', String(Math.ceil(needH)));
                        svgEl.style.height = Math.ceil(needH) + 'px';
                    }
                }

                const attached = document.querySelectorAll(
                    `.diagram-wire[data-src="${CSS.escape(diagramCardDrag.node.id)}"], .diagram-wire[data-tgt="${CSS.escape(diagramCardDrag.node.id)}"]`
                );
                attached.forEach(wire => {
                    const src = diagramNodesList.find(n => n.id === wire.getAttribute('data-src'));
                    const tgt = diagramNodesList.find(n => n.id === wire.getAttribute('data-tgt'));
                    if (src && tgt) {
                        // Stale draw-in dash state (attribute OR style) would break the
                        // stretched path into pieces
                        wire.removeAttribute('stroke-dasharray');
                        wire.removeAttribute('stroke-dashoffset');
                        wire.style.removeProperty('stroke-dasharray');
                        wire.style.removeProperty('stroke-dashoffset');
                        wire.setAttribute('d', ctx.makeWirePath(src, tgt));
                    }
                });
            }, true);

            const endDrag = (e) => {
                if (!diagramCardDrag) return;
                if (diagramCardDrag.moved) {
                    saveDiagramNodePosition(diagramCardDrag.node.id, diagramCardDrag.node.x, diagramCardDrag.node.y);
                }
                diagramCardDrag = null;
                document.body.style.userSelect = '';
                const svgEl = document.getElementById('diagramSvg');
                if (svgEl) svgEl.classList.remove('wires-live');
            };
            svgNodes.addEventListener('pointerup', endDrag, true);
            svgNodes.addEventListener('pointercancel', endDrag, true);
        }

        function fetchDiagramData() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            if (!svgNodes || !svgWires) return;

            svgNodes.innerHTML = `<foreignObject x="400" y="300" width="400" height="100">
                <div class="text-center text-[var(--text-muted)] italic text-sm">
                    ${isRtl ? 'جاري تحميل مخطط الإعدادات...' : 'Loading config diagram...'}
                </div>
            </foreignObject>`;
            svgWires.innerHTML = '';

            fetch('/api/config/diagram?t=' + Date.now())
                .then(res => res.json())
                .then(data => {
                    if (!data.success) {
                        showToast(data.error || 'Failed to fetch diagram data', 'error');
                        return;
                    }
                    diagramRawData = data;
                    renderDiagram();
                    sizeDiagramCanvas();
                    if (!isPanZoomInitialized) {
                        initPanZoom();
                        isPanZoomInitialized = true;
                    }
                    setTimeout(fitDiagramToScreen, 50);
                })
                .catch(err => {
                    showToast(err.message, 'error');
                });
        }
        window.fetchDiagramData = fetchDiagramData;
        function renderDiagramPipeline() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            const svg = document.getElementById('diagramSvg');
            const canvas = document.getElementById('diagramCanvasContainer');
            if (!svgNodes || !svgWires || !svg || !canvas || !diagramRawData) return;

            svgNodes.innerHTML = '';
            svgWires.innerHTML = '';

            const cardWidth = 280;
            const cardHeight = 135;

            function formatDestination(dest) {
                if (!dest) return isRtl ? 'غير محدد' : 'Not set';
                if (dest.startsWith('ext-group,')) {
                    return `${isRtl ? 'مجموعة:' : 'Group:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) {
                    return `${isRtl ? 'تحويلة:' : 'Extension:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    const ivrObj = (diagramRawData.ivrs || []).find(i => String(i.id) === String(ivrId));
                    return `IVR: ${ivrObj ? ivrObj.name : ivrId}`;
                }
                if (dest.startsWith('ext-queues,')) {
                    return `${isRtl ? 'طابور:' : 'Queue:'} ${dest.split(',')[1]}`;
                }
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                    const conditionId = dest.split(',')[1];
                    const condition = (diagramRawData.timeconditions || [])
                        .find(tc => String(tc.timeconditions_id) === String(conditionId));
                    return `${isRtl ? 'شرط زمني' : 'Time Condition'}: ${condition ? condition.displayname : conditionId}`;
                }
                if (dest.startsWith('ext-external-failover,') || dest.startsWith('from-internal,')) {
                    const rawTarget = dest.split(',')[1] || '';
                    const phone = rawTarget.split('/')[0].split('@')[0];
                    const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                    if (phone) {
                        const dongleLabel = dongle ? ` (${dongle})` : '';
                        return `${isRtl ? 'رقم خارجي:' : 'External:'} ${phone}${dongleLabel}`;
                    }
                }
                return dest;
            }

            function resolveTargetNodeId(dest) {
                if (!dest) return null;
                if (dest.startsWith('ext-group,')) return 'ringgroup-' + dest.split(',')[1];
                if (dest.startsWith('ext-queues,')) return 'queue-' + dest.split(',')[1];
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) return 'extension-' + dest.split(',')[1];
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) return 'timecondition-' + dest.split(',')[1];
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    return 'ivr-' + ivrId;
                }
                return null;
            }

            const inbound = diagramRawData.inbound || [];
            const ringgroups = diagramRawData.ringgroups || [];
            const extensions = diagramRawData.extensions || [];
            const outbound = diagramRawData.outbound || [];
            const trunks = diagramRawData.trunks || [];
            const timeconditions = diagramRawData.timeconditions || [];
            const queues = diagramRawData.queues || [];
            const ivrs = diagramRawData.ivrs || [];

            diagramNodesList = [];

            // 1. Inbound Nodes
            inbound.forEach((route, i) => {
                const nodeId = 'inbound-' + (route.did || 'any') + '-' + i;
                diagramNodesList.push({
                    id: nodeId,
                    type: 'inbound',
                    title: route.did ? `DID: ${route.did}` : (isRtl ? 'أي رقم وارد' : 'Any DID'),
                    subtitle: route.description || (isRtl ? 'مسار وارد' : 'Inbound Route'),
                    desc: route.destination,
                    data: route
                });
            });

            // 2. Ring Groups Nodes
            ringgroups.forEach((rg, i) => {
                diagramNodesList.push({
                    id: 'ringgroup-' + rg.grpnum,
                    type: 'ringgroup',
                    title: `${isRtl ? 'مجموعة:' : 'Group:'} ${rg.grpnum}`,
                    subtitle: rg.description || (isRtl ? 'مجموعة اتصال' : 'Ring Group'),
                    desc: `${isRtl ? 'الاستراتيجية:' : 'Strategy:'} ${rg.strategy}`,
                    data: rg
                });
            });

            // 2.5 IVR Nodes
            ivrs.forEach((ivr, i) => {
                const entriesCount = Array.isArray(ivr.entries) ? ivr.entries.length : 0;
                diagramNodesList.push({
                    id: 'ivr-' + ivr.id,
                    type: 'ivr',
                    title: `${isRtl ? 'الرد الآلي:' : 'IVR:'} ${ivr.name}`,
                    subtitle: ivr.description || (isRtl ? 'قائمة الرد الآلي' : 'IVR Menu'),
                    desc: `${isRtl ? 'خيارات:' : 'Options:'} ${entriesCount}`,
                    data: ivr
                });
            });

            // 3. Queues Nodes
            queues.forEach((q, i) => {
                diagramNodesList.push({
                    id: 'queue-' + q.extension,
                    type: 'queue',
                    title: `${isRtl ? 'طابور:' : 'Queue:'} ${q.extension}`,
                    subtitle: q.descr || (isRtl ? 'طابور انتظار' : 'Call Queue'),
                    desc: `${isRtl ? 'أقصى وقت:' : 'Max Wait:'} ${q.maxwait === '0' || !q.maxwait ? 'Unlimited' : q.maxwait + 's'}`,
                    data: q
                });
            });

            // 4. Extensions Nodes
            extensions.forEach((ext, i) => {
                diagramNodesList.push({
                    id: 'extension-' + ext.extension,
                    type: 'extension',
                    title: `${isRtl ? 'تحويلة:' : 'Ext:'} ${ext.extension}`,
                    subtitle: ext.name || (isRtl ? 'تحويلة SIP' : 'SIP Extension'),
                    desc: ext.voicemail === 'novm' ? (isRtl ? 'البريد مغلق' : 'Voicemail Off') : (isRtl ? 'البريد مفعل' : 'Voicemail On'),
                    data: ext
                });
            });

            // 5. Outbound Routes Nodes
            outbound.forEach((route, i) => {
                const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                const patternStr = patterns.map(p => p.pattern).filter(Boolean).slice(0, 2).join(', ');
                diagramNodesList.push({
                    id: 'outbound-' + route.route_id,
                    type: 'outbound',
                    title: route.name,
                    subtitle: isRtl ? 'مسار صادر' : 'Outbound Route',
                    desc: patternStr ? `${isRtl ? 'أنماط:' : 'Patterns:'} ${patternStr}` : (isRtl ? 'بلا أنماط' : 'No patterns'),
                    data: route
                });
            });

            // 6. Trunks Nodes
            trunks.forEach((tk, i) => {
                diagramNodesList.push({
                    id: 'trunk-' + tk.trunkid,
                    type: 'trunk',
                    title: tk.name,
                    subtitle: `${tk.tech ? tk.tech.toUpperCase() : 'SIP'} Trunk`,
                    desc: (tk.disabled === 'on') ? (isRtl ? 'معطل' : 'Disabled') : (isRtl ? 'نشط' : 'Active'),
                    data: tk
                });
            });
            // 7. Time Conditions Nodes
            timeconditions.forEach((tc, i) => {
                const scheduleStr = tc.details ? tc.details.map(d => d.time + ' ' + d.name).join('; ') : '';
                diagramNodesList.push({
                    id: 'timecondition-' + tc.timeconditions_id,
                    type: 'timecondition',
                    title: tc.displayname || (isRtl ? 'شرط زمني' : 'Time Condition'),
                    subtitle: tc.timegroup_name || (isRtl ? 'غير محدد' : 'No group'),
                    desc: scheduleStr || '',
                    data: tc
                });
            });

            diagramLinks = [];

            // Link 1: Inbound -> Ring Groups, Queues, or Extensions
            // Link 1: Inbound -> Destinations
            inbound.forEach((route, idx) => {
                const dest = route.destination || '';
                const targetId = resolveTargetNodeId(dest);
                let wireType = 'inbound-dest';
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) wireType = 'inbound-tc';
                else if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'inbound-ivr';
                if (targetId) {
                    diagramLinks.push({
                        id: `link-inbound-${idx}`,
                        source: 'inbound-' + (route.did || 'any') + '-' + idx,
                        target: targetId,
                        type: wireType
                    });
                }
            });

            // Link 2: Time Condition -> Destinations
            timeconditions.forEach(tc => {
                const trueDest = tc.truegoto || '';
                const falseDest = tc.falsegoto || '';
                [trueDest, falseDest].forEach((dest, isFalse) => {
                    const targetId = resolveTargetNodeId(dest);
                    let wireType = isFalse ? 'tc-false' : 'tc-true';
                    if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'tc-ivr';
                    if (targetId) {
                        diagramLinks.push({
                            id: 'link-tc-' + tc.timeconditions_id + '-' + (isFalse ? 'false' : 'true') + '-' + targetId,
                            source: 'timecondition-' + tc.timeconditions_id,
                            target: targetId,
                            type: wireType
                        });
                    }
                });
            });

            // Link 2.5: IVR -> Options & Destinations
            ivrs.forEach(ivr => {
                const entries = Array.isArray(ivr.entries) ? ivr.entries : [];
                entries.forEach((entry, idx) => {
                    const targetId = resolveTargetNodeId(entry.dest);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-entry-${entry.selection}-${idx}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-entry'
                        });
                    }
                });
                if (ivr.timeout_destination) {
                    const targetId = resolveTargetNodeId(ivr.timeout_destination);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-timeout-${targetId}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-timeout'
                        });
                    }
                }
                if (ivr.invalid_destination) {
                    const targetId = resolveTargetNodeId(ivr.invalid_destination);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-ivr-${ivr.id}-invalid-${targetId}`,
                            source: 'ivr-' + ivr.id,
                            target: targetId,
                            type: 'ivr-invalid'
                        });
                    }
                }
            });

            // Link 3: Ring Group -> Extensions
            ringgroups.forEach(rg => {
                const members = rg.grplist ? rg.grplist.split('-') : [];
                members.forEach(ext => {
                    const extExists = extensions.some(e => String(e.extension) === String(ext));
                    if (extExists) {
                        diagramLinks.push({
                            id: `link-rg-${rg.grpnum}-${ext}`,
                            source: 'ringgroup-' + rg.grpnum,
                            target: 'extension-' + ext,
                            type: 'rg-member'
                        });
                    }
                });
            });

            // Link 3.5: Queue -> Extensions
            queues.forEach(q => {
                const members = Array.isArray(q.static_members) ? q.static_members : [];
                members.forEach(ext => {
                    const extExists = extensions.some(e => String(e.extension) === String(ext));
                    if (extExists) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-${ext}`,
                            source: 'queue-' + q.extension,
                            target: 'extension-' + ext,
                            type: 'queue-member'
                        });
                    }
                });
            });

            // Link 3.6: Queue -> Failover and Continue Destinations
            queues.forEach(q => {
                if (q.dest) {
                    const targetId = resolveTargetNodeId(q.dest);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-failover-${targetId}`,
                            source: 'queue-' + q.extension,
                            target: targetId,
                            type: 'queue-failover'
                        });
                    }
                }
                if (q.destcontinue) {
                    const targetId = resolveTargetNodeId(q.destcontinue);
                    if (targetId) {
                        diagramLinks.push({
                            id: `link-queue-${q.extension}-continue-${targetId}`,
                            source: 'queue-' + q.extension,
                            target: targetId,
                            type: 'queue-continue'
                        });
                    }
                }
            });

            // Link 4: Extension -> Outbound Routes
            extensions.forEach(ext => {
                outbound.forEach(route => {
                    const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                    const hasRestrictedCid = patterns.some(p => String(p.cid) === String(ext.extension));
                    const hasGlobalRoute = patterns.some(p => !p.cid || p.cid === '');
                    if (hasRestrictedCid) {
                        diagramLinks.push({
                            id: `link-ext-outbound-${ext.extension}-${route.route_id}`,
                            source: 'extension-' + ext.extension,
                            target: 'outbound-' + route.route_id,
                            type: 'ext-route-restricted'
                        });
                    } else if (hasGlobalRoute) {
                        diagramLinks.push({
                            id: `link-ext-outbound-global-${ext.extension}-${route.route_id}`,
                            source: 'extension-' + ext.extension,
                            target: 'outbound-' + route.route_id,
                            type: 'ext-route-global'
                        });
                    }
                });
            });

            // Link 5: Outbound Route -> Trunks
            outbound.forEach(route => {
                const routeTrunks = Array.isArray(route.trunks) ? route.trunks : [];
                routeTrunks.forEach(tk => {
                    const tkId = tk.trunk_id || tk.trunkid;
                    const matchedTrunk = trunks.find(t => String(t.trunkid) === String(tkId) || (tk.trunk_name && String(t.name) === String(tk.trunk_name)));
                    const targetTrunkId = matchedTrunk ? matchedTrunk.trunkid : tkId;
                    if (targetTrunkId !== undefined && targetTrunkId !== null) {
                        diagramLinks.push({
                            id: `link-outbound-trunk-${route.route_id}-${targetTrunkId}`,
                            source: 'outbound-' + route.route_id,
                            target: 'trunk-' + targetTrunkId,
                            type: 'route-trunk'
                        });
                    }
                });
            });

            // -----------------------------------------------------------------
            // Layered auto-layout (Sugiyama-lite):
            //   1) layer = longest path from any source (cycle tolerant)
            //   2) barycenter ordering sweeps to reduce wire crossings
            //   3) x by layer, vertically centered stacks per layer
            // Manual drags are persisted in localStorage and win over auto layout.
            // -----------------------------------------------------------------
            function computeDiagramLayout() {
                const columnGap = 110;
                const rowGap = 34;
                const colSpacing = cardWidth + columnGap;
                const ySpacing = cardHeight + rowGap;
                const marginX = 60;
                const marginTop = 50;
                const bottomPadding = 50;

                const nodeById = new Map(diagramNodesList.map(n => [n.id, n]));

                // 1) Longest-path layering with natural telephony tier minimums
                const TIER_MIN_LAYER = {
                    inbound: 0,
                    timecondition: 1,
                    ivr: 2,
                    queue: 3,
                    ringgroup: 3,
                    extension: 4,
                    outbound: 5,
                    trunk: 6
                };

                const layerOf = new Map(diagramNodesList.map(n => [n.id, TIER_MIN_LAYER[n.type] || 0]));
                const maxIters = diagramNodesList.length + 2;
                for (let iter = 0; iter < maxIters; iter++) {
                    let changed = false;
                    diagramLinks.forEach(link => {
                        const s = layerOf.get(link.source) || 0;
                        const cur = layerOf.get(link.target) || 0;
                        if (s >= cur && s < diagramNodesList.length) {
                            layerOf.set(link.target, Math.max(cur, s + 1));
                            changed = true;
                        }
                    });
                    if (!changed) break;
                }

                // 2) Group by layer + barycenter ordering
                const maxLayer = Math.max(0, ...layerOf.values());
                const layers = [];
                for (let l = 0; l <= maxLayer; l++) layers.push([]);
                diagramNodesList.forEach(n => layers[layerOf.get(n.id)].push(n));

                const posInLayer = new Map();
                layers.forEach(nodes => nodes.forEach((n, i) => posInLayer.set(n.id, i)));
                const preds = new Map(diagramNodesList.map(n => [n.id, []]));
                const succs = new Map(diagramNodesList.map(n => [n.id, []]));
                diagramLinks.forEach(l => {
                    if (nodeById.has(l.source) && nodeById.has(l.target)) {
                        succs.get(l.source).push(l.target);
                        preds.get(l.target).push(l.source);
                    }
                });
                const bary = ids => ids.length
                    ? ids.reduce((sum, id) => sum + (posInLayer.get(id) || 0), 0) / ids.length
                    : Infinity;

                const TYPE_ORDER = { inbound: 0, timecondition: 1, ivr: 2, queue: 3, ringgroup: 4, extension: 5, outbound: 6, trunk: 7 };

                for (let sweep = 0; sweep < 4; sweep++) {
                    const down = sweep % 2 === 0;
                    const order = down
                        ? layers.map((_, i) => i).slice(1)
                        : layers.map((_, i) => i).reverse().slice(0, -1);
                    order.forEach(li => {
                        layers[li]
                            .map((n, i) => ({ n, i, b: down ? bary(preds.get(n.id)) : bary(succs.get(n.id)) }))
                            .sort((a, b2) => {
                                const typeDiff = (TYPE_ORDER[a.n.type] || 0) - (TYPE_ORDER[b2.n.type] || 0);
                                if (typeDiff !== 0) return typeDiff;
                                return (a.b === b2.b ? a.i - b2.i : a.b - b2.b);
                            })
                            .forEach((entry, i) => {
                                layers[li][i] = entry.n;
                                posInLayer.set(entry.n.id, i);
                            });
                    });
                }

                // 3) Coordinates — each layer stack centered on the shared midline
                const densest = Math.max(1, ...layers.map(l => l.length));
                const contentHeight = Math.max(560, marginTop + densest * ySpacing - rowGap + bottomPadding);
                const midY = contentHeight / 2 - cardHeight / 2;
                layers.forEach((nodes, li) => {
                    const stackHeight = nodes.length * ySpacing - rowGap;
                    const startY = midY - stackHeight / 2 + (nodes.length ? rowGap / 2 : 0);
                    nodes.forEach((n, i) => {
                        n.x = Math.round(marginX + li * colSpacing);
                        n.y = Math.round(startY + i * ySpacing);
                    });
                });

                // Saved manual positions override the auto layout
                let saved = null;
                try { saved = JSON.parse(localStorage.getItem('config_diagram_layout_v1')); } catch (_) {}
                if (saved && typeof saved === 'object') {
                    diagramNodesList.forEach(n => {
                        if (saved[n.id] && Number.isFinite(saved[n.id].x) && Number.isFinite(saved[n.id].y)) {
                            n.x = saved[n.id].x;
                            n.y = saved[n.id].y;
                        }
                    });
                }

                const maxUsedLayer = layers.reduce((m, l, li) => l.length ? Math.max(m, li) : m, 0);
                return {
                    width: marginX * 2 + maxUsedLayer * colSpacing + cardWidth,
                    height: contentHeight
                };
            }

            const layoutSize = computeDiagramLayout();
            svg.style.height = `${layoutSize.height}px`;
            svg.style.width = `${layoutSize.width}px`;
            svg.setAttribute('height', String(layoutSize.height));
            svg.setAttribute('width', String(layoutSize.width));

            diagramRenderCtx = {
                cardWidth,
                cardHeight,
                makeWirePath
            };
            initDiagramNodeDragging();

            const colSpacing = cardWidth + 110;

            // Arrowhead markers — one per stroke color used by the wires
            const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
            defs.innerHTML = Object.entries(WIRE_COLORS).map(([type, color]) =>
                `<marker id="arrow-${type}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 1 L 9 5 L 0 9 z" fill="${color}"/></marker>`
            ).join('');
            svgWires.appendChild(defs);

            function makeWirePath(sourceNode, targetNode) {
                const x1 = sourceNode.x + cardWidth;
                const y1 = sourceNode.y + cardHeight / 2;
                const x2 = targetNode.x - 4;
                const y2 = targetNode.y + cardHeight / 2;

                const colDistance = Math.abs(x2 - x1);
                if (colDistance > colSpacing * 1.2) {
                    const arcOffset = (y1 <= y2) ? -55 : 55;
                    const controlY1 = y1 + arcOffset;
                    const controlY2 = y2 + arcOffset;
                    return `M ${x1} ${y1} C ${x1 + colSpacing * 0.4} ${controlY1}, ${x2 - colSpacing * 0.4} ${controlY2}, ${x2} ${y2}`;
                }
                const dx = colDistance * 0.42;
                const controlX1 = (x2 >= x1) ? (x1 + dx) : (x1 - dx);
                const controlX2 = (x2 >= x1) ? (x2 - dx) : (x2 + dx);
                const dy = y2 - y1;
                const bow = (dy >= 0 ? 1 : -1) * Math.min(25, Math.abs(dy) * 0.2);
                return `M ${x1} ${y1} C ${controlX1} ${y1 + bow}, ${controlX2} ${y2 - bow}, ${x2} ${y2}`;
            }

            // Render Wires
            diagramLinks.forEach(link => {
                const sourceNode = diagramNodesList.find(n => n.id === link.source);
                const targetNode = diagramNodesList.find(n => n.id === link.target);
                if (!sourceNode || !targetNode) return;

                const strokeColor = WIRE_COLORS[link.type] || '#3f3f46';
                const isGlobalMesh = link.type === 'ext-route-global';

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('id', link.id);
                path.setAttribute('class', 'diagram-wire transition-all duration-200');
                path.setAttribute('d', makeWirePath(sourceNode, targetNode));
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke', strokeColor);
                path.setAttribute('stroke-width', isGlobalMesh ? '1px' : '2px');
                path.setAttribute('stroke-linecap', 'round');
                if (FAILING_WIRES.has(link.type)) path.setAttribute('stroke-dasharray', '7 5');
                if (!isGlobalMesh) path.setAttribute('marker-end', `url(#arrow-${link.type})`);
                path.setAttribute('data-type', link.type);
                path.setAttribute('data-src', link.source);
                path.setAttribute('data-tgt', link.target);
                path.style.opacity = isGlobalMesh ? '0.16' : '0.55';


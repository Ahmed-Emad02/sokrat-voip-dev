        function addTimeGroupRuleToModal(data = null) {
            const container = document.getElementById('timeGroupRulesListContainer');
            if (!container) return;

            const ruleIndex = (container.children ? container.children.length : 0) + 1;
            const card = document.createElement('div');
            card.className = 'rule-card p-4 border border-sky-500/20 rounded-xl bg-sky-950/20 relative flex flex-col gap-3.5 transition-all hover:border-sky-500/40';

            const daysList = [
                { id: 'sat', labelEn: 'Sat', labelAr: 'السبت' },
                { id: 'sun', labelEn: 'Sun', labelAr: 'الأحد' },
                { id: 'mon', labelEn: 'Mon', labelAr: 'الإثنين' },
                { id: 'tue', labelEn: 'Tue', labelAr: 'الثلاثاء' },
                { id: 'wed', labelEn: 'Wed', labelAr: 'الأربعاء' },
                { id: 'thu', labelEn: 'Thu', labelAr: 'الخميس' },
                { id: 'fri', labelEn: 'Fri', labelAr: 'الجمعة' }
            ];

            // Determine active days from data.weekday with wrap-around support (sat-thu, sun-thu, etc.)
            let activeDaysSet = new Set(['sat', 'sun', 'mon', 'tue', 'wed', 'thu', 'fri']);
            const ruleName = data ? (data.name || '') : '';
            if (data && data.weekday && data.weekday !== '*' && data.weekday !== '*-*') {
                activeDaysSet = new Set();
                const str = data.weekday.toLowerCase().trim();
                const allDaysOrder = ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'];
                if (str.includes('&') || str.includes(',')) {
                    str.split(/[,&]/).forEach(d => {
                        const cleanD = d.trim();
                        if (allDaysOrder.includes(cleanD)) activeDaysSet.add(cleanD);
                    });
                } else if (str.includes('-')) {
                    const [s, e] = str.split('-').map(x => x.trim());
                    const sIdx = allDaysOrder.indexOf(s);
                    const eIdx = allDaysOrder.indexOf(e);
                    if (sIdx !== -1 && eIdx !== -1) {
                        if (sIdx <= eIdx) {
                            for (let i = sIdx; i <= eIdx; i++) activeDaysSet.add(allDaysOrder[i]);
                        } else {
                            // Wrap-around (e.g. sat-thu, sun-thu, fri-mon)
                            for (let i = sIdx; i < allDaysOrder.length; i++) activeDaysSet.add(allDaysOrder[i]);
                            for (let i = 0; i <= eIdx; i++) activeDaysSet.add(allDaysOrder[i]);
                        }
                    }
                } else if (allDaysOrder.includes(str)) {
                    activeDaysSet.add(str);
                }
            }

            let dayTogglesHTML = '';

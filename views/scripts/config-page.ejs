        function saveQueue(e) {
            e.preventDefault();
            const isEdit = document.getElementById('queueEditMode').value === "true";
            const extension = document.getElementById('queueNum').value.trim();
            const descr = document.getElementById('queueDesc').value.trim();
            const static_members = document.getElementById('queueStaticList').value.trim();
            const dynmembers = document.getElementById('queueDynList').value.trim();
            const strategy = document.getElementById('queueStrategy').value;
            const musicclass = document.getElementById('queueMoh').value;
            const joinannounce_id = document.getElementById('queueAnnMsg').value;
            const recording = document.getElementById('queueRecording').value;
            const maxwait = document.getElementById('queueMaxWait').value;
            const timeout = document.getElementById('queueAgentTimeout').value;
            const retry = document.getElementById('queueRetry').value;
            const autofill = document.getElementById('queueAutofill').value;
            const skip_busy = document.getElementById('queueSkipBusy').value;
            const dest = document.getElementById('queueDestination').value.trim() || 'app-blackhole,hangup,1';
            const destcontinue = document.getElementById('queueContinueDestination').value.trim() || 'app-blackhole,hangup,1';

            if (!extension || !/^\d+$/.test(extension)) {
                showToast(isRtl ? 'يرجى إدخال رقم طابور صحيح' : 'Please enter a valid numeric Queue number.', 'error');
                return;
            }
            if (!descr) {
                showToast(isRtl ? 'يرجى إدخال اسم للطابور' : 'Please enter a Queue Name.', 'error');
                return;
            }
            if (!isEdit) {
                const qMatch = (loadedQueuesList || []).find(q => String(q.extension) === String(extension));
                if (qMatch) {
                    showToast(isRtl ? `طابور الانتظار ${extension} موجود بالفعل` : `Queue ${extension} already exists. Duplicate numbers are strictly restricted.`, 'error');
                    return;
                }
                const extMatch = (loadedExtensionsList || []).find(ext => String(ext.extension) === String(extension));
                if (extMatch) {
                    showToast(isRtl ? `الرقم ${extension} مستخدم بالفعل لتحويلة (${extMatch.name || extension}). غير مسموح بتكرار الأرقام.` : `Cannot create: Number ${extension} is already in use by Extension "${extMatch.name || extension}". Duplicate numbers are strictly restricted.`, 'error');
                    return;
                }
                const rgMatch = (loadedRingGroupsList || []).find(rg => String(rg.grpnum) === String(extension));
                if (rgMatch) {
                    showToast(isRtl ? `الرقم ${extension} مستخدم بالفعل لمجموعة اتصال (${rgMatch.description || extension}). غير مسموح بتكرار الأرقام.` : `Cannot create: Number ${extension} is already in use by Ring Group "${rgMatch.description || extension}". Duplicate numbers are strictly restricted.`, 'error');
                    return;
                }
            }
            const url = isEdit ? '/api/config/queues/' + extension : '/api/config/queues';
            const method = isEdit ? 'PUT' : 'POST';
            const submitBtn = e.target ? (e.target.matches('button') ? e.target : e.target.querySelector('button[type="submit"]')) : null;
            if (submitBtn) setButtonLoading(submitBtn, true);

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    extension, descr, static_members, dynmembers, strategy, musicclass,
                    joinannounce_id, recording, maxwait, timeout, retry, autofill, skip_busy, dest, destcontinue
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('queueModal');
                    fetchQueues();
                } else {
                    showToast(data.error, 'error');
                }
            })
            .catch(err => showToast(err.message, 'error'))
            .finally(() => {
                if (submitBtn) setButtonLoading(submitBtn, false);
            });
        }

        async function deleteQueue(extension) {
            const ok = await window.sokratConfirm({
                title: isRtl ? 'حذف طابور الانتظار' : 'Delete Queue',
                message: isRtl ? `هل أنت متأكد من حذف طابور الانتظار ${extension}؟` : `Are you sure you want to delete Queue ${extension}?`,
                confirmText: isRtl ? 'حذف' : 'Delete',
                type: 'danger'
            });
            if (!ok) return;
            fetch('/api/config/queues/' + extension, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchQueues();
                    } else showToast(data.error, 'error');
                })
                .catch(err => showToast(err.message, 'error'));
        }

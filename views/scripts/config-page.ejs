                                    </svg>
                                </button>
                                <button type="button" onclick="qualifyFederationPeer(${peer.id})" title="${isRtl ? 'اختبار الاستجابة (Qualify Ping)' : 'Qualify Ping Test'}" class="p-1.5 rounded-lg bg-[var(--bg-primary)] border border-[var(--border-primary)] text-[var(--text-secondary)] hover:text-emerald-400 hover:border-emerald-500/40 transition cursor-pointer">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />

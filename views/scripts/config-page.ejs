        // --- 5. INBOUND ROUTES ---
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function formatDestination(dest) {
            if (!dest) return '-';

            if (dest.startsWith('from-did-direct,')) {
                const parts = dest.split(',');
                const extNum = parts[1];
                const extMatch = (typeof loadedExtensionsList !== 'undefined' ? loadedExtensionsList : []).find(e => String(e.extension) === String(extNum));
                const nameStr = extMatch ? ` - ${extMatch.name}` : '';
                return `Extension: ${extNum}${nameStr}`;
            }

            if (dest.startsWith('ext-group,')) {
                const parts = dest.split(',');
                const grpNum = parts[1];
                const rgMatch = (typeof loadedRingGroupsList !== 'undefined' ? loadedRingGroupsList : []).find(rg => String(rg.grpnum) === String(grpNum));
                const descStr = rgMatch ? ` - ${rgMatch.description}` : '';
                return `Ring Group: ${grpNum}${descStr}`;
            }

            if (dest.startsWith('ext-queues,')) {
                const parts = dest.split(',');
                const qNum = parts[1];
                const qMatch = (typeof loadedQueuesList !== 'undefined' ? loadedQueuesList : []).find(q => String(q.extension) === String(qNum));
                const descStr = qMatch ? ` - ${qMatch.descr}` : '';
                return `Queue: ${qNum}${descStr}`;
            }

            if (dest.startsWith('ext-external-failover,') || dest.startsWith('from-internal,')) {
                const rawTarget = dest.split(',')[1] || '';
                const phone = rawTarget.split('/')[0].split('@')[0];
                const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                if (phone) {
                    const dongleLabel = dongle ? ` (${dongle})` : '';
                    return `${isRtl ? 'رقم خارجي / جوال:' : 'External / Mobile:'} ${phone}${dongleLabel}`;
                }
            }
            if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                const parts = dest.split(',');
                const conditionId = parts[1];
                const condition = (typeof loadedTimeConditionsList !== 'undefined' ? loadedTimeConditionsList : []).find(tc => String(tc.timeconditions_id) === String(conditionId));
                const name = condition ? condition.displayname : conditionId;
                return `${isRtl ? 'شرط زمني' : 'Time Condition'}: ${name}`;
            }

            if (dest.startsWith('app-announcement-')) {
                const parts = dest.split(',');
                const annId = parts[0].replace('app-announcement-', '');
                const ann = (typeof loadedAnnouncementsList !== 'undefined' ? loadedAnnouncementsList : []).find(a => String(a.announcement_id) === String(annId));
                const name = ann ? ann.description : annId;
                return `${isRtl ? 'إعلان' : 'Announcement'}: ${name}`;
            }

            if (dest.startsWith('ivr-')) {
                const parts = dest.split(',');
                const ivrId = parts[0].replace('ivr-', '');
                const ivr = (typeof loadedIvrsList !== 'undefined' ? loadedIvrsList : []).find(i => String(i.id) === String(ivrId));
                const name = ivr ? ivr.name : ivrId;
                return `IVR: ${name}`;
            }

            if (dest.startsWith('ext-local,vmu')) {
                const ext = dest.substring(13).split(',')[0];
                return `Voicemail: ${ext}`;
            }

            if (dest.startsWith('musiconhold,') || dest.startsWith('ext-moh,')) {
                const parts = dest.split(',');
                const catName = parts[1] || 'default';
                return `Music on Hold: ${catName}`;
            }
            if (dest.startsWith('ext-trunk,')) {
                const parts = dest.split(',');
                const trunkId = parts[1];
                const trunk = (typeof loadedTrunksList !== 'undefined' ? loadedTrunksList : []).find(t => String(t.trunkid) === String(trunkId));
                const name = trunk ? `${trunk.name} (${trunk.tech})` : trunkId;
                return `Trunk: ${name}`;
            }
            if (dest.startsWith('app-blackhole,hangup') || dest === 'app-blackhole,hangup,1') return isRtl ? 'إنهاء المكالمة (Hangup)' : 'Terminate Call (Hangup)';
            if (dest.startsWith('app-blackhole,congestion')) return isRtl ? 'نغمة ازدحام (Congestion)' : 'Play Congestion';
            if (dest.startsWith('app-blackhole,busy')) return isRtl ? 'نغمة مشغول (Busy)' : 'Play Busy';
            if (dest.startsWith('app-blackhole,zapateller')) return isRtl ? 'نغمة SIT (Zapateller)' : 'Play SIT Tone (Zapateller)';
            if (dest.startsWith('app-blackhole,musiconhold')) return isRtl ? 'الموسيقى في الانتظار (MoH)' : 'Hold Forever (MoH)';
            if (dest.startsWith('app-blackhole,ringing')) return isRtl ? 'رنين دائم' : 'Ring Forever';

            return dest;
        }


        // --- 5. INBOUND ROUTES ---
        function fetchInboundRoutes() {
            const tbody = document.getElementById('inbound-table-body');
            return fetch('/api/config/routes/inbound')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.routes) return;
                    loadedInboundRoutesList = Array.isArray(data.routes) ? data.routes : [];
                    const list = loadedInboundRoutesList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد مسارات واردة.' : 'No inbound routes found.') + '</td></tr>';
                        return;
                    }
                    list.forEach((r, idx) => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const extText = r.extension || '(ANY)';
                        const destText = formatDestination(r.destination);

                        const cidBadge = r.cidnum
                            ? `<div class="text-[10px] font-mono text-amber-400 font-semibold mt-0.5">CID: ${escapeHtml(r.cidnum)}</div>`
                            : `<div class="text-[10px] font-mono text-[var(--text-muted)] mt-0.5">CID: ANY</div>`;

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(r.description || '')}</td>
                            <td class="py-3 px-4 font-mono">
                                <div class="font-bold text-emerald-400">${escapeHtml(extText)}</div>
                                ${cidBadge}
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-semibold">${escapeHtml(destText)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editInboundRouteByIndex(${idx})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteInboundRouteByIndex(${idx})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }


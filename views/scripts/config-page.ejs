                    list.forEach(rec => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const currentGain = Number.isFinite(Number(rec.gain_db)) ? Number(rec.gain_db) : 0;
                        const gainBadgeText = (currentGain > 0 ? '+' : '') + currentGain + ' dB';
                        const gainColorClass = currentGain === 0 ? 'text-[var(--text-muted)]' : (currentGain < 0 ? 'text-amber-400' : 'text-emerald-400');
                        let dspBadgesHtml = '';
                        if (rec.dsp_settings && typeof rec.dsp_settings === 'object') {
                            const d = rec.dsp_settings;
                            const tags = [];
                            if (d.normDb !== null && d.normDb !== undefined) tags.push(`Norm ${d.normDb}dB`);
                            if (d.bandpass) tags.push('G.711');
                            if (d.compand && d.compand !== 'off') tags.push(`Compand:${d.compand}`);
                            if (d.trimSilence) tags.push('Trimmed');
                            if (d.enablePadLead && d.padLead > 0) tags.push(`Pre:${parseFloat(d.padLead).toFixed(2)}s`);
                            if (d.enablePadTrail && d.padTrail > 0) tags.push(`Post:${parseFloat(d.padTrail).toFixed(2)}s`);
                            if (d.bass || d.treble) tags.push(`EQ:${d.bass > 0 ? '+' : ''}${d.bass || 0}B/${d.treble > 0 ? '+' : ''}${d.treble || 0}T`);
                            if (d.tempo && Math.abs(d.tempo - 1.0) >= 0.02) tags.push(`${parseFloat(d.tempo).toFixed(2)}x`);
                            if (d.generateCodecs) tags.push('Codecs');
                            if (tags.length > 0) {
                                dspBadgesHtml = '<div class="flex flex-wrap gap-1 mt-1">' + tags.map(t => `<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-black text-purple-200 bg-purple-900/60 hover:bg-purple-900/80 border border-purple-400/50 shadow-xs transition-colors">${escapeHtml(t)}</span>`).join('') + '</div>';
                            }
                        }
                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-muted)]">${rec.id}</td>
                            <td class="py-3 px-4">
                                <span class="font-bold text-[var(--text-primary)] block">${escapeHtml(rec.displayname || '-')}</span>
                                ${dspBadgesHtml}
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-semibold">${escapeHtml(rec.filename || '-')}</td>
                            <td class="py-3 px-4">
                                <div class="flex flex-col gap-2 min-w-[240px] p-2.5 rounded-xl bg-[var(--bg-primary)]/50 border border-[var(--border-primary)] shadow-inner">
                                    <div class="flex items-center justify-between gap-2">
                                        <span class="text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-wider">${isRtl ? 'مستوى الكسب' : 'Headroom Gain'}</span>
                                        <span id="recGainBadge_${rec.id}" class="font-mono font-bold text-xs ${gainColorClass} px-2 py-0.5 rounded bg-black/40 border border-white/5 shadow-sm">${gainBadgeText}</span>
                                    </div>

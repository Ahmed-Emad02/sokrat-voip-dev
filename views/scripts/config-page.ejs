                        const staticStr = Array.isArray(q.static_members) ? q.static_members.join(', ') : '';
                        const maxWaitText = q.maxwait === '0' || !q.maxwait ? 'Unlimited' : q.maxwait + 's';

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-amber-400">${escapeHtml(q.extension)}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(q.descr || '-')}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(q.strategy || 'rrmemory')}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(staticStr || '-')}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(q.dynmembers || '-')}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(annText)}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(maxWaitText)}</td>
                            <td class="py-3 px-4 font-mono text-xs text-rose-400 font-bold">${escapeHtml(formatDestination(q.dest))}</td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-bold">${escapeHtml(formatDestination(q.destcontinue))}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editQueue('${q.extension}')" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteQueue('${q.extension}')" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function openQueueModal() {

        function fetchFederationSettings() {
            return fetch('/api/config/federation/settings')
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.settings) {
                        loadedFederationSettings = data.settings;
                        const siteBadge = document.getElementById('fedLocalSiteBadge');
                        if (siteBadge) siteBadge.textContent = `Site ${data.settings.local_site_code || '10'}`;

        let currentlyPlayingCustomAudio = null;
        function initCustomAudioPlayers(container) {
            if (!container) return;
            container.querySelectorAll('.audio-player').forEach(player => {
                if (player._customAudioInit) return;
                player._customAudioInit = true;

                const audio       = player.querySelector('[data-player-audio]');
                const playBtn     = player.querySelector('[data-player-playpause]');
                const iconPlay    = player.querySelector('[data-icon-play]');
                const iconPause   = player.querySelector('[data-icon-pause]');
                const slider      = player.querySelector('[data-player-slider]');
                const curEl       = player.querySelector('[data-player-current]');
                const durEl       = player.querySelector('[data-player-duration]');
                const speedSel    = player.querySelector('[data-player-speed]');
                const muteBtn     = player.querySelector('[data-player-mute]');
                const iconVolHigh = player.querySelector('[data-icon-vol-high]');
                const iconVolMute = player.querySelector('[data-icon-vol-mute]');
                const volSlider   = player.querySelector('[data-player-volume]');
                const volGroup    = player.querySelector('[data-volume-group]');
                const volPopover  = player.querySelector('[data-volume-popover]');

                if (!audio || !playBtn) return;

                let isScrubbing = false;
                let lastVolume = 1;
                let isDraggingVol = false;
                let volHideTimeout = null;

                function fmtTime(s) {
                    if (!s || isNaN(s)) return '0:00';
                    const m = Math.floor(s / 60);
                    const sec = Math.floor(s % 60);
                    return m + ':' + String(sec).padStart(2, '0');
                }

                function updateSliderBackground(val) {
                    if (slider) slider.style.setProperty('--seek-before-width', val + '%');
                }

                function updateVolBackground(val) {
                    if (volSlider) volSlider.style.setProperty('--vol-before-width', (val * 100) + '%');
                }

                playBtn.addEventListener('click', () => {
                    if (audio.paused) {
                        if (currentlyPlayingCustomAudio && currentlyPlayingCustomAudio !== audio) {
                            currentlyPlayingCustomAudio.pause();
                            currentlyPlayingCustomAudio.currentTime = 0;
                            const other = currentlyPlayingCustomAudio.closest('.audio-player');
                            if (other) {
                                other.querySelector('[data-icon-play]')?.classList.remove('hidden');
                                other.querySelector('[data-icon-pause]')?.classList.add('hidden');
                                const otherSlider = other.querySelector('[data-player-slider]');
                                if (otherSlider) {
                                    otherSlider.value = 0;
                                    otherSlider.style.setProperty('--seek-before-width', '0%');
                                }
                                const otherCur = other.querySelector('[data-player-current]');
                                if (otherCur) otherCur.textContent = '0:00';
                            }
                        }
                        const p = audio.play();
                        if (p && typeof p.catch === 'function') {
                            p.catch(err => {
                                if (err.name !== 'AbortError') console.warn('[Audio Player] Play error:', err);
                            });
                        }
                        currentlyPlayingCustomAudio = audio;
                        iconPlay?.classList.add('hidden');
                        iconPause?.classList.remove('hidden');
                    } else {
                        audio.pause();
                        iconPlay?.classList.remove('hidden');
                        iconPause?.classList.add('hidden');
                    }
                });

                const initialDur = parseFloat(audio.getAttribute('data-total-duration')) || 0;
                let knownDuration = initialDur > 0 ? initialDur : 0;

                if (knownDuration > 0 && durEl) {
                    durEl.textContent = fmtTime(knownDuration);
                }

                audio.addEventListener('loadedmetadata', () => {
                    if (audio.duration && !isNaN(audio.duration) && isFinite(audio.duration) && audio.duration > 0) {
                        knownDuration = audio.duration;
                        if (durEl) durEl.textContent = fmtTime(audio.duration);
                    }
                });

                audio.addEventListener('durationchange', () => {
                    if (audio.duration && !isNaN(audio.duration) && isFinite(audio.duration) && audio.duration > 0) {
                        knownDuration = audio.duration;
                        if (durEl) durEl.textContent = fmtTime(audio.duration);
                    }
                });

                audio.addEventListener('timeupdate', () => {
                    const dur = (audio.duration && !isNaN(audio.duration) && isFinite(audio.duration) && audio.duration > 0)
                        ? audio.duration
                        : knownDuration;
                    if (dur > 0 && !isScrubbing) {
                        const pct = (audio.currentTime / dur) * 100;
                        if (slider) {
                            slider.value = pct;
                            updateSliderBackground(pct);
                        }
                    }
                    if (curEl) curEl.textContent = fmtTime(audio.currentTime);
                });

                audio.addEventListener('ended', () => {
                    iconPlay?.classList.remove('hidden');
                    iconPause?.classList.add('hidden');
                    if (slider) {
                        slider.value = 0;
                        updateSliderBackground(0);
                    }
                    if (curEl) curEl.textContent = '0:00';
                    currentlyPlayingCustomAudio = null;
                });

                if (slider) {
                    ['mousedown', 'touchstart'].forEach(evt => {
                        slider.addEventListener(evt, () => { isScrubbing = true; });
                    });
                    slider.addEventListener('input', () => {
                        isScrubbing = true;
                        const pct = parseFloat(slider.value);
                        updateSliderBackground(pct);
                        if (audio.duration && curEl) {
                            curEl.textContent = fmtTime((pct / 100) * audio.duration);
                        }
                    });
                    slider.addEventListener('change', () => {
                        if (audio.duration) {
                            audio.currentTime = (parseFloat(slider.value) / 100) * audio.duration;
                        }
                        isScrubbing = false;
                    });
                    ['mouseup', 'touchend'].forEach(evt => {
                        slider.addEventListener(evt, () => {
                            if (isScrubbing && audio.duration) {
                                audio.currentTime = (parseFloat(slider.value) / 100) * audio.duration;
                            }
                            isScrubbing = false;
                        });
                    });
                }

                if (speedSel) {
                    speedSel.addEventListener('change', () => {
                        audio.playbackRate = parseFloat(speedSel.value);
                    });
                }

                if (volGroup && volPopover) {
                    volGroup.addEventListener('mouseenter', () => {
                        clearTimeout(volHideTimeout);
                        volPopover.classList.remove('hidden');
                        volPopover.classList.add('flex');
                    });
                    volGroup.addEventListener('mouseleave', () => {
                        volHideTimeout = setTimeout(() => {
                            if (!isDraggingVol) {
                                volPopover.classList.add('hidden');
                                volPopover.classList.remove('flex');
                            }
                        }, 300);
                    });
                }

                if (muteBtn) {
                    muteBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (audio.muted || audio.volume === 0) {
                            audio.muted = false;
                            audio.volume = lastVolume > 0 ? lastVolume : 1;
                            if (volSlider) volSlider.value = audio.volume;
                            updateVolBackground(audio.volume);
                            iconVolHigh?.classList.remove('hidden');
                            iconVolMute?.classList.add('hidden');
                        } else {
                            lastVolume = audio.volume;
                            audio.muted = true;
                            if (volSlider) volSlider.value = 0;
                            updateVolBackground(0);
                            iconVolHigh?.classList.add('hidden');
                            iconVolMute?.classList.remove('hidden');
                        }
                    });
                }

                if (volSlider) {
                    ['mousedown', 'touchstart'].forEach(evt => {
                        volSlider.addEventListener(evt, () => {
                            isDraggingVol = true;
                            clearTimeout(volHideTimeout);
                            if (volPopover) {
                                volPopover.classList.remove('hidden');
                                volPopover.classList.add('flex');
                            }
                        });
                    });
                    ['mouseup', 'touchend'].forEach(evt => {
                        window.addEventListener(evt, () => {
                            if (isDraggingVol) {
                                isDraggingVol = false;
                                volHideTimeout = setTimeout(() => {
                                    if (volPopover && volGroup && !volGroup.matches(':hover')) {
                                        volPopover.classList.add('hidden');
                                        volPopover.classList.remove('flex');
                                    }
                                }, 300);
                            }
                        });
                    });
                    volSlider.addEventListener('input', (e) => {
                        e.stopPropagation();
                        const v = parseFloat(volSlider.value);
                        audio.volume = v;
                        audio.muted = (v === 0);
                        updateVolBackground(v);
                        if (v === 0) {
                            iconVolHigh?.classList.add('hidden');
                            iconVolMute?.classList.remove('hidden');
                        } else {
                            lastVolume = v;
                            iconVolHigh?.classList.remove('hidden');
                            iconVolMute?.classList.add('hidden');
                        }
                    });
                }
            });
        }
        window.initCustomAudioPlayers = initCustomAudioPlayers;

        function updateMohFileLabel() {
            const input = document.getElementById('mohAudioFile');
            const label = document.getElementById('mohFileLabel');
            if (input && label && input.files && input.files[0]) {
                label.textContent = input.files[0].name;
            }
        }
        window.updateMohFileLabel = updateMohFileLabel;

        async function uploadMohAudio(e) {
            e.preventDefault();
            const input = document.getElementById('mohAudioFile');
            if (!input || !input.files || !input.files[0]) {
                showToast(isRtl ? 'يرجى اختيار ملف صوتي أولاً' : 'Please select an audio file first', 'error');
                return;
            }
            const formData = new FormData();
            formData.append('category', activeMohCategoryName);
            formData.append('audio', input.files[0]);

            showToast(isRtl ? 'جاري رفع الملف الصوتي...' : 'Uploading MoH audio track...', 'info');

            try {
                const res = await fetch('/api/config/moh/upload?category=' + encodeURIComponent(activeMohCategoryName), {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    input.value = '';
                    document.getElementById('mohFileLabel').textContent = isRtl ? 'اختر ملف صوتی...' : 'Choose audio file...';
                    fetchMohData();
                } else {
                    showToast(data.error || 'Failed to upload MoH audio file', 'error');
                }
            } catch(err) {
                showToast('Upload error: ' + err.message, 'error');
            }
        }
        window.uploadMohAudio = uploadMohAudio;

        async function deleteMohFile(catName, filename) {
            if (!confirm(isRtl ? `حذف المقطع الصوتي '${filename}' من الفئة '${catName}'؟` : `Delete audio track '${filename}' from category '${catName}'?`)) return;
            try {
                const res = await fetch('/api/config/moh/file', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ category: catName, filename })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    fetchMohData();
                } else {
                    showToast(data.error || 'Failed to delete audio file', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.deleteMohFile = deleteMohFile;

        function openMohCategoryModal() {
            document.getElementById('mohCatName').value = '';
            openModal('mohCategoryModal');
        }
        window.openMohCategoryModal = openMohCategoryModal;

        async function saveMohCategory(e) {
            e.preventDefault();
            const name = document.getElementById('mohCatName').value.trim();
            const sort = document.getElementById('mohCatSort').value;
            if (!name) return;

            try {
                const res = await fetch('/api/config/moh/category', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, sort })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    activeMohCategoryName = name.toLowerCase().replace(/[^a-z0-9_-]/g, '_');
                    closeModal('mohCategoryModal');
                    fetchMohData();
                } else {
                    showToast(data.error || 'Failed to create MoH category', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.saveMohCategory = saveMohCategory;

        async function deleteMohCategory(catName) {
            if (!confirm(isRtl ? `حذف فئة الموسيقى '${catName}' بالكامل مع جميع ملفاتها؟` : `Delete MoH Category '${catName}' and all its audio files?`)) return;
            try {
                const res = await fetch(`/api/config/moh/category/${encodeURIComponent(catName)}`, {
                    method: 'DELETE'
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    activeMohCategoryName = 'default';
                    fetchMohData();
                } else {
                    showToast(data.error || 'Failed to delete MoH Category', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.deleteMohCategory = deleteMohCategory;
        window.uploadMohFile = uploadMohAudio;
        function openAddDongleSlotModal() {
            openModal('addDongleSlotModal');
            const cards = document.querySelectorAll('#modemDonglesGrid [data-dongle-id]');
            const existingNames = Array.from(cards).map(c => c.getAttribute('data-dongle-id'));
            let nextIndex = 0;
            while (existingNames.includes(`dongle${nextIndex}`)) {
                nextIndex++;
            }
            const countEl = document.getElementById('newSlotCount');
            if (countEl) countEl.value = '1';
            const prefixEl = document.getElementById('newSlotPrefix');
            if (prefixEl) prefixEl.value = 'dongle';
            const nameEl = document.getElementById('newSlotName');
            if (nameEl) nameEl.value = `dongle${nextIndex}`;
            const audioEl = document.getElementById('newSlotAudio');
            if (audioEl) audioEl.value = `/dev/ttyUSB${nextIndex * 3 + 1}`;
            const dataEl = document.getElementById('newSlotData');
            if (dataEl) dataEl.value = `/dev/ttyUSB${nextIndex * 3 + 2}`;
            updateDongleSlotPreview();
        }
        window.openAddDongleSlotModal = openAddDongleSlotModal;

        function updateDongleSlotPreview() {
            const count = Math.max(1, parseInt(document.getElementById('newSlotCount')?.value, 10) || 1);
            const prefix = (document.getElementById('newSlotPrefix')?.value || 'dongle').trim().toLowerCase().replace(/[^a-z0-9_-]/g, '_') || 'dongle';
            const customName = document.getElementById('newSlotName')?.value.trim().toLowerCase();
            const cards = document.querySelectorAll('#modemDonglesGrid [data-dongle-id]');
            const existingSlotNames = new Set(Array.from(cards).map(c => c.getAttribute('data-dongle-id')));

            const previews = [];
            let nextIndex = 0;
            for (let i = 0; i < count; i++) {
                let targetName = '';
                if (count === 1 && customName) {
                    targetName = customName;
                } else {
                    while (existingSlotNames.has(`${prefix}${nextIndex}`)) {
                        nextIndex++;
                    }
                    targetName = `${prefix}${nextIndex}`;
                    existingSlotNames.add(targetName);
                }
                previews.push(targetName);
            }
            const previewEl = document.getElementById('newSlotPreviewText');
            if (previewEl) previewEl.textContent = previews.join(', ');
        }
        window.updateDongleSlotPreview = updateDongleSlotPreview;

        async function saveNewDongleSlot(e) {
            e.preventDefault();
            const count = Math.max(1, parseInt(document.getElementById('newSlotCount').value, 10) || 1);
            const prefix = document.getElementById('newSlotPrefix').value.trim();
            const dongleName = document.getElementById('newSlotName').value.trim().toLowerCase();
            const audio = document.getElementById('newSlotAudio').value.trim();
            const dataPort = document.getElementById('newSlotData').value.trim();
            const rxgain = parseInt(document.getElementById('newSlotRxGain').value, 10) || 0;
            const txgain = parseInt(document.getElementById('newSlotTxGain').value, 10) || 0;

            showToast(isRtl ? `جاري إضافة ${count} فتحة مودم جديدة...` : `Adding ${count} new dongle slot(s) to dongle.conf...`, 'info');

            try {
                const res = await fetch('/api/config/modem/dongle-slot', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ count, prefix, dongleName, audio, data: dataPort, rxgain, txgain })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('addDongleSlotModal');
                    fetchModemConfig();
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to add dongle slot(s)', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.saveNewDongleSlot = saveNewDongleSlot;

        function openRemoveDongleSlotModal() {
            openModal('removeDongleSlotModal');
            const container = document.getElementById('removeSlotChecklist');
            if (!container) return;
            container.innerHTML = '<div class="text-center text-xs text-[var(--text-muted)] py-2">' + (isRtl ? 'جاري تحميل الشرائح...' : 'Loading slots...') + '</div>';
            const countEl = document.getElementById('removeSlotCount');
            if (countEl) countEl.value = '1';
            fetch('/api/config/modem')
                .then(res => res.json())
                .then(data => {
                    const dongles = data && data.dongles ? Object.keys(data.dongles) : [];
                    container.innerHTML = '';
                    if (dongles.length === 0) {
                        container.innerHTML = '<div class="text-center text-xs text-[var(--text-muted)] py-2">' + (isRtl ? 'لا توجد فتحات شرائح في dongle.conf' : 'No dongle slots found in dongle.conf') + '</div>';
                    } else {
                        dongles.forEach(dId => {
                            const label = document.createElement('label');
                            label.className = 'flex items-center gap-2 text-xs cursor-pointer hover:text-white';
                            label.innerHTML = `<input type="checkbox" name="removeDongleSlot" value="${dId}" class="rounded border-[var(--border-primary)] text-red-500 focus:ring-red-500"> <span>${dId}</span>`;
                            container.appendChild(label);
                        });
                    }
                })
                .catch(() => {
                    container.innerHTML = '<div class="text-center text-xs text-red-400 py-2">' + (isRtl ? 'فشل تحميل الشرائح' : 'Failed to load slots') + '</div>';
                });
        }
        window.openRemoveDongleSlotModal = openRemoveDongleSlotModal;

        async function executeRemoveDongleSlot(e) {
            e.preventDefault();
            const checked = Array.from(document.querySelectorAll('input[name="removeDongleSlot"]:checked')).map(cb => cb.value);
            const count = Math.max(1, parseInt(document.getElementById('removeSlotCount').value, 10) || 1);

            const payload = {};
            if (checked.length > 0) {
                payload.dongleNames = checked;
            } else {
                payload.count = count;
            }

            const targetText = checked.length > 0 ? checked.join(', ') : `${count} last slot(s)`;
            if (!confirm(isRtl ? `حذف الفتحات '${targetText}' نهائياً من dongle.conf؟` : `Remove dongle slot(s) '${targetText}' permanently from dongle.conf?`)) return;

            showToast(isRtl ? 'جاري حذف الشرائح...' : 'Removing dongle slot(s)...', 'info');

            try {
                const res = await fetch('/api/config/modem/dongle-slot', {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('removeDongleSlotModal');
                    fetchModemConfig();
                    fetchDongleMappingsTab();
                } else {
                    showToast(data.error || 'Failed to remove dongle slot(s)', 'error');
                }
            } catch(err) {
                showToast('Error: ' + err.message, 'error');
            }
        }
        window.executeRemoveDongleSlot = executeRemoveDongleSlot;
        function fetchAnnouncements() {
            fetchMohData();
            return fetch('/api/config/announcements')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!data || !data.success || !data.announcements) return;
                    loadedAnnouncementsList = Array.isArray(data.announcements) ? data.announcements : [];
                    const list = loadedAnnouncementsList;
                    const tbody = document.getElementById('announcements-table-body');
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد إعلانات مسجلة.' : 'No Announcements found.') + '</td></tr>';
                        return;
                    }

                    list.forEach(ann => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors border-b border-[var(--border-primary)]/40 text-xs';

                        const opts = [];
                        if (ann.allow_skip) opts.push('<span class="px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] font-bold">Skip</span>');
                        if (ann.return_ivr) opts.push('<span class="px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20 text-[10px] font-bold">Return IVR</span>');
                        if (ann.noanswer) opts.push('<span class="px-1.5 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/20 text-[10px] font-bold">No Answer</span>');
                        const optsHtml = opts.length ? opts.join(' ') : '<span class="text-[var(--text-muted)]">-</span>';

                        const recCell = ann.recording_missing
                            ? '<span class="text-red-400 font-semibold">' + (isRtl ? 'التسجيل مفقود' : 'Recording missing') + '</span>' +
                              '<span class="block text-[10px] font-mono text-red-400/70">' + (isRtl ? 'اختر تسجيلاً بديلاً - الإعلان صامت الآن' : 'Pick another recording - this announcement is silent') + '</span>'
                            : (ann.recording_name
                                ? '<span class="text-emerald-400 font-semibold">' + escapeHtml(ann.recording_name) + '</span>' +
                                  (ann.recording_filename ? '<span class="block text-[10px] font-mono text-[var(--text-muted)]">' + escapeHtml(ann.recording_filename) + '</span>' : '')
                                : '<span class="text-[var(--text-muted)]">' + (isRtl ? 'تحويل النص إلى كلام' : 'Text-to-Speech') + '</span>');

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${ann.announcement_id}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ann.description || '')}</td>
                            <td class="py-3 px-4">${recCell}</td>
                            <td class="py-3 px-4 font-mono font-bold text-amber-400">${ann.repeat_msg ? escapeHtml(ann.repeat_msg) : '-'}</td>
                            <td class="py-3 px-4 flex items-center gap-1 flex-wrap">${optsHtml}</td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-bold">${formatDestination(ann.post_dest)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="openAnnouncementStudioById(${ann.announcement_id})" ${ann.recording_id > 0 && !ann.recording_missing ? '' : 'disabled'} class="px-2.5 py-1 text-xs font-semibold text-purple-400 hover:bg-purple-500/10 rounded border border-purple-500/30 transition cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"><span>${isRtl ? 'استوديو' : 'Studio'}</span></button>
                                    <button type="button" onclick="editAnnouncement(${ann.announcement_id})" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 transition cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteAnnouncement(${ann.announcement_id})" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 transition cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }
        window.fetchAnnouncements = fetchAnnouncements;

        function populateAnnouncementRecordingsDropdown(selectedId = 0) {
            const sel = document.getElementById('annRecording');
            if (!sel) return;
            sel.innerHTML = '<option value="0">== ' + (isRtl ? 'بدون تسجيل (استخدام تحويل النص إلى كلام)' : 'None (Use Text-To-Speech TTS)') + ' ==</option>';
            const list = loadedRecordingsList || [];
            const known = list.some(r => String(r.id) === String(selectedId));
            // The announcement may point at a recording that was deleted: keep it
            // selectable (and flagged) instead of silently falling back to TTS.
            if (selectedId > 0 && !known) {
                const opt = document.createElement('option');
                opt.value = selectedId;
                opt.textContent = (isRtl ? 'تسجيل مفقود' : 'Missing recording') + ' (ID: ' + selectedId + ')';
                opt.selected = true;
                sel.appendChild(opt);
            }
            list.forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = r.displayname + ' (ID: ' + r.id + ')';
                if (String(r.id) === String(selectedId)) opt.selected = true;
                sel.appendChild(opt);
            });
            updateAnnouncementRecordingState();
        }
        window.populateAnnouncementRecordingsDropdown = populateAnnouncementRecordingsDropdown;

        // Reflect the studio state (gain / DSP) of the selected recording and
        // flag a recording that no longer exists - Issabel would generate an
        // empty Playback() for it and the announcement would be silent.
        function updateAnnouncementRecordingState() {
            const stateEl = document.getElementById('annRecordingState');
            const studioBtn = document.getElementById('annStudioBtn');
            const previewBtn = document.getElementById('annPreviewBtn');
            const sel = document.getElementById('annRecording');
            if (!sel) return;
            const recId = parseInt(sel.value, 10) || 0;
            const rec = (loadedRecordingsList || []).find(r => String(r.id) === String(recId));

            if (studioBtn) studioBtn.disabled = !rec;
            if (previewBtn) previewBtn.disabled = !rec;

            if (!stateEl) return;
            if (!rec) {
                if (recId > 0) {
                    stateEl.innerHTML = '<span class="text-red-400 font-semibold">' + (isRtl ? 'التسجيل الصوتي مفقود' : 'The selected recording is missing') + '</span>' +
                        ' <span class="text-[var(--text-muted)]">' + (isRtl ? '- اختر تسجيلاً آخر أو ارفع تسجيلاً جديداً' : '- pick another recording or upload a new one') + '</span>';
                    stateEl.className = 'text-[10px] mt-1.5';
                } else {
                    stateEl.innerHTML = '<span class="text-[var(--text-muted)]">' + (isRtl ? 'سيتم استخدام تحويل النص إلى كلام' : 'Text-to-speech will be used') + '</span>';
                    stateEl.className = 'text-[10px] text-[var(--text-muted)] mt-1.5';
                }
                return;
            }
            const gain = (rec.gain_db !== undefined && rec.gain_db !== null) ? Number(rec.gain_db) : 0;
            const dsp = rec.dsp_settings ? (isRtl ? 'معالجة DSP مفعّلة' : 'DSP processing applied') : (isRtl ? 'بدون معالجة DSP' : 'no DSP processing');
            stateEl.innerHTML = '<span class="font-mono">' + escapeHtml(rec.displayname || ('#' + recId)) + '</span>' +
                ' <span class="text-[var(--text-muted)]">·</span> ' +
                '<span class="font-mono">' + (gain > 0 ? '+' : '') + gain + ' dB</span>' +
                ' <span class="text-[var(--text-muted)]">·</span> ' +
                '<span>' + dsp + '</span>' +
                ' <span class="text-[var(--text-muted)]">·</span> ' +
                '<span class="font-mono">' + escapeHtml(rec.filename || '') + '</span>';
            stateEl.className = 'text-[10px] text-[var(--text-secondary)] mt-1.5';
        }
        window.updateAnnouncementRecordingState = updateAnnouncementRecordingState;

        // Open the audio studio (SoX DSP) for the announcement's recording.
        function openAnnouncementStudio() {
            const sel = document.getElementById('annRecording');
            if (!sel) return;
            const recId = parseInt(sel.value, 10) || 0;
            if (!recId) {
                showToast(isRtl ? 'اختر تسجيلاً صوتياً أولاً' : 'Select a system recording first', 'error');
                return;
            }
            if (typeof openRecordingStudioModal === 'function') {
                openRecordingStudioModal(recId);
            } else {
                showToast(isRtl ? 'الاستوديو غير متاح' : 'The audio studio is not available', 'error');
            }
        }
        window.openAnnouncementStudio = openAnnouncementStudio;

        // Open the audio studio for a recording that is attached to an
        // announcement (used by the Announcements table).
        function openAnnouncementStudioById(announcementId) {
            const ann = (loadedAnnouncementsList || []).find(a => String(a.announcement_id) === String(announcementId));
            if (!ann) {
                showToast(isRtl ? 'الإعلان غير موجود' : 'Announcement not found', 'error');
                return;
            }
            const recId = parseInt(ann.recording_id, 10) || 0;
            if (!recId || ann.recording_missing) {
                showToast(isRtl ? 'لا يوجد تسجيل مرتبط بهذا الإعلان' : 'This announcement has no usable recording', 'error');
                return;
            }
            if (typeof openRecordingStudioModal === 'function') {
                openRecordingStudioModal(recId);
            } else {
                showToast(isRtl ? 'الاستوديو غير متاح' : 'The audio studio is not available', 'error');
            }
        }
        window.openAnnouncementStudioById = openAnnouncementStudioById;

        // Preview the announcement's recording.
        let announcementPreviewAudio = null;
        function previewAnnouncementRecording() {
            const sel = document.getElementById('annRecording');
            if (!sel) return;
            const recId = parseInt(sel.value, 10) || 0;
            if (!recId) {
                showToast(isRtl ? 'اختر تسجيلاً صوتياً أولاً' : 'Select a system recording first', 'error');
                return;
            }
            try {
                if (announcementPreviewAudio) {
                    announcementPreviewAudio.pause();
                    announcementPreviewAudio = null;
                }
                announcementPreviewAudio = new Audio('/api/config/recordings/audio/' + recId + '?t=' + Date.now());
                announcementPreviewAudio.play().catch(() => {
                    showToast(isRtl ? 'تعذر تشغيل الصوت' : 'Could not play the recording', 'error');
                });
            } catch (err) {
                showToast(isRtl ? 'تعذر تشغيل الصوت' : 'Could not play the recording', 'error');
            }
        }
        window.previewAnnouncementRecording = previewAnnouncementRecording;

        // Upload a new system recording from inside the Announcements modal and
        // select it as soon as it lands in the library.
        function openRecordingUploadModal() {
            const form = document.getElementById('recordingUploadModalForm');
            if (form) form.reset();
            const wrap = document.getElementById('ruProgressWrap');
            if (wrap) wrap.classList.add('hidden');
            openModal('recordingUploadModal');
        }
        window.openRecordingUploadModal = openRecordingUploadModal;

        async function submitRecordingUploadModal(e) {
            e.preventDefault();
            const nameInput = document.getElementById('ruName');
            const fileInput = document.getElementById('ruFile');
            const gainSelect = document.getElementById('ruGain');
            const submitBtn = document.getElementById('ruSubmitBtn');
            const wrap = document.getElementById('ruProgressWrap');
            const bar = document.getElementById('ruProgressBar');
            const percent = document.getElementById('ruPercent');

            if (!fileInput || !fileInput.files.length) {
                showToast(isRtl ? 'اختر ملف صوتي' : 'Please select an audio file', 'error');
                return;
            }
            if (submitBtn) submitBtn.disabled = true;
            if (wrap) wrap.classList.remove('hidden');
            if (bar) bar.style.width = '0%';
            if (percent) percent.textContent = '0%';

            try {
                const result = await uploadRecordingFile(
                    fileInput.files[0],
                    nameInput ? nameInput.value : '',
                    gainSelect ? gainSelect.value : '0',
                    (pct) => {
                        if (bar) bar.style.width = pct + '%';
                        if (percent) percent.textContent = pct + '%';
                    }
                );
                if (!result.success) {
                    showToast(result.error || (isRtl ? 'فشل الرفع' : 'Upload failed'), 'error');
                    return;
                }
                showToast(result.message || (isRtl ? 'تم الرفع' : 'Uploaded'), 'success');
                closeModal('recordingUploadModal');
                // Refresh the library, then select the new recording.
                await fetchRecordings();
                const newId = (result.recording && result.recording.id) || result.id || 0;
                if (newId) {
                    const sel = document.getElementById('annRecording');
                    if (sel) {
                        sel.value = String(newId);
                        if (typeof onAnnRecordingChange === 'function') onAnnRecordingChange();
                    }
                }
                populateAnnouncementRecordingsDropdown(newId || 0);
            } catch (err) {
                showToast(err.error || err.message || (isRtl ? 'فشل الرفع' : 'Upload failed'), 'error');
            } finally {
                if (submitBtn) submitBtn.disabled = false;
                setTimeout(() => { if (wrap) wrap.classList.add('hidden'); }, 600);
            }
        }
        window.submitRecordingUploadModal = submitRecordingUploadModal;

        function onAnnRecordingChange() {
            const recId = parseInt(document.getElementById('annRecording').value, 10) || 0;
            const ttsLang = document.getElementById('annTtsLang');
            const ttsText = document.getElementById('annTtsText');
            const allowSkip = document.getElementById('annAllowSkip');

            if (!ttsLang || !ttsText || !allowSkip) return;

            if (recId === 0) {
                ttsLang.disabled = false;
                ttsText.disabled = false;
                ttsLang.classList.remove('opacity-40');
                ttsText.classList.remove('opacity-40');

                allowSkip.checked = false;
                allowSkip.disabled = true;
                allowSkip.closest('label').classList.add('opacity-40', 'cursor-not-allowed');
            } else {
                ttsLang.disabled = true;
                ttsText.disabled = true;
                ttsLang.classList.add('opacity-40');
                ttsText.classList.add('opacity-40');

                allowSkip.disabled = false;
                allowSkip.closest('label').classList.remove('opacity-40', 'cursor-not-allowed');
            }

            // Keep the studio state line and the Studio/Preview buttons in sync
            // with the selected recording.
            updateAnnouncementRecordingState();
        }
        window.onAnnRecordingChange = onAnnRecordingChange;

        function openAnnouncementModal() {
            openModal('announcementModal');
            document.getElementById('announcementForm').reset();
            document.getElementById('annEditMode').value = 'false';
            document.getElementById('annId').value = '';
            document.getElementById('annDescription').value = '';
            document.getElementById('annRepeatMsg').value = '';
            document.getElementById('annTtsLang').value = 'en-US';
            document.getElementById('annTtsText').value = '';
            document.getElementById('annAllowSkip').checked = false;
            document.getElementById('annReturnIvr').checked = false;
            document.getElementById('annNoAnswer').checked = false;
            populateAnnouncementRecordingsDropdown();
            document.getElementById('annPostDestination').value = 'app-blackhole,hangup,1';

            initDestinationSelectInstances();
            if (annPostDestSelectInstance) annPostDestSelectInstance.setDialplan('app-blackhole,hangup,1');

            document.getElementById('announcementModalTitle').textContent = isRtl ? 'إضافة إعلان جديد' : 'Add Announcement';
            ensureAllConfigListsLoaded().then(() => {
                populateAnnouncementRecordingsDropdown();
                if (annPostDestSelectInstance) annPostDestSelectInstance.render();
            }).catch(() => {});
        }
        window.openAnnouncementModal = openAnnouncementModal;

        function editAnnouncement(id) {
            openModal('announcementModal');
            const ann = (loadedAnnouncementsList || []).find(a => String(a.announcement_id) === String(id));
            if (!ann) {
                openAnnouncementModal();
                return;
            }
            document.getElementById('annEditMode').value = 'true';
            document.getElementById('annId').value = ann.announcement_id;
            document.getElementById('annDescription').value = ann.description || '';
            document.getElementById('annRepeatMsg').value = ann.repeat_msg || '';
            document.getElementById('annTtsLang').value = ann.tts_lang || 'en-US';
            document.getElementById('annTtsText').value = ann.tts_text || '';
            document.getElementById('annAllowSkip').checked = !!ann.allow_skip;
            document.getElementById('annReturnIvr').checked = !!ann.return_ivr;
            document.getElementById('annNoAnswer').checked = !!ann.noanswer;
            populateAnnouncementRecordingsDropdown(ann.recording_id || 0);
            document.getElementById('annPostDestination').value = ann.post_dest || 'app-blackhole,hangup,1';

            initDestinationSelectInstances();
            if (annPostDestSelectInstance) annPostDestSelectInstance.setDialplan(ann.post_dest || 'app-blackhole,hangup,1');

            document.getElementById('announcementModalTitle').textContent = (isRtl ? 'تعديل الإعلان: ' : 'Edit Announcement: ') + (ann.description || '');
            ensureAllConfigListsLoaded().then(() => {
                populateAnnouncementRecordingsDropdown(ann.recording_id || 0);
                if (annPostDestSelectInstance) annPostDestSelectInstance.render();
            }).catch(() => {});
        }
        window.editAnnouncement = editAnnouncement;

        function saveAnnouncement(e) {
            e.preventDefault();
            const editMode = document.getElementById('annEditMode').value === 'true';
            const id = document.getElementById('annId').value;
            const description = document.getElementById('annDescription').value.trim();
            const recording_id = document.getElementById('annRecording').value;
            const recId = parseInt(recording_id, 10) || 0;
            const repeat_msg = document.getElementById('annRepeatMsg').value;
            const tts_lang = recId === 0 ? (document.getElementById('annTtsLang').value || 'en-US') : 'en-US';
            const tts_text = recId === 0 ? document.getElementById('annTtsText').value.trim() : '';
            const allow_skip = recId === 0 ? 0 : (document.getElementById('annAllowSkip').checked ? 1 : 0);
            const return_ivr = document.getElementById('annReturnIvr').checked ? 1 : 0;
            const noanswer = document.getElementById('annNoAnswer').checked ? 1 : 0;
            const post_dest = document.getElementById('annPostDestination').value.trim();

            if (!description) {
                showToast('Please enter an Announcement Description.', 'error');
                return;
            }

            const method = editMode ? 'PUT' : 'POST';
            const url = editMode ? '/api/config/announcements/' + id : '/api/config/announcements';
            const submitBtn = e.target ? (e.target.matches('button') ? e.target : e.target.querySelector('button[type="submit"]')) : null;
            if (submitBtn) setButtonLoading(submitBtn, true);

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ description, recording_id, allow_skip, post_dest, return_ivr, noanswer, repeat_msg, tts_lang, tts_text })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    closeModal('announcementModal');
                    showToast(editMode ? 'Announcement updated successfully.' : 'Announcement added successfully.', 'success');
                    fetchAnnouncements();
                } else {
                    showToast(data.error || 'Failed to save Announcement.', 'error');
                }
            })
            .catch(err => {
                showToast('Failed to connect to server.', 'error');
            })
            .finally(() => {
                if (submitBtn) setButtonLoading(submitBtn, false);
            });
        }
        window.saveAnnouncement = saveAnnouncement;

        async function deleteAnnouncement(id) {
            const ok = await window.sokratConfirm({
                title: isRtl ? 'حذف الإعلان' : 'Delete Announcement',
                message: isRtl ? 'هل أنت متأكد من حذف هذا الإعلان؟' : 'Are you sure you want to delete this Announcement?',
                confirmText: isRtl ? 'حذف' : 'Delete',
                type: 'danger'
            });
            if (!ok) return;
            fetch(`/api/config/announcements/${id}`, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast('Announcement deleted successfully.', 'success');
                        fetchAnnouncements();
                    } else {
                        showToast(data.error || 'Failed to delete Announcement.', 'error');
                    }
                })
                .catch(err => showToast(err.message || 'Failed to delete Announcement', 'error'));
        }
        window.deleteAnnouncement = deleteAnnouncement;
        // --- MODEM CONF (DONGLE VOLUME GAIN) CLIENT LOGIC ---

        async function fetchModemConfig() {
            const grid = document.getElementById('modemDonglesGrid');
            const countBadge = document.getElementById('modemDongleCount');
            if (!grid) return;

            grid.innerHTML = `<div class="col-span-full text-center text-xs text-[var(--text-muted)] py-8">${isRtl ? 'جاري تحميل إعدادات المودم...' : 'Loading modem configurations...'}</div>`;
            if (countBadge) countBadge.textContent = isRtl ? 'جار التحميل...' : 'Loading...';

            try {
                const res = await fetch('/api/config/modem');
                const data = await res.json();
                if (!data.success || !data.dongles) {
                    if (countBadge) countBadge.textContent = isRtl ? '0 أجهزة' : '0 devices';
                    grid.innerHTML = `<div class="col-span-full text-center text-xs text-red-400 py-8">${escapeHtml(data.error || 'Failed to load modem configurations.')}</div>`;
                    return;
                }

                // Populate Dongle and SIM selects for reports
                populateDongleReportFilterSelects(data.dongles);

                grid.innerHTML = '';
                const dongleIds = Object.keys(data.dongles);
                if (countBadge) {
                    countBadge.textContent = `${dongleIds.length} ${isRtl ? 'أجهزة' : (dongleIds.length === 1 ? 'device' : 'devices')}`;
                }
                if (dongleIds.length === 0) {
                    grid.innerHTML = `<div class="col-span-full text-center text-xs text-[var(--text-muted)] py-8">${isRtl ? 'لا توجد شرائح GSM معرفة في dongle.conf' : 'No GSM dongles found in dongle.conf'}</div>`;
                    return;
                }

                grid.innerHTML = '';
                dongleIds.forEach(id => {
                    const dongle = data.dongles[id];
                    const rxValue = Math.max(-10, Math.min(10, parseInt(dongle.rxgain, 10) || 0));
                    const txValue = Math.max(-10, Math.min(10, parseInt(dongle.txgain, 10) || 0));
                    const safeId = escapeHtml(id);
                    const phoneNumber = dongle.phone_number ? escapeHtml(dongle.phone_number) : (isRtl ? 'غير محدد' : 'No DID assigned');
                    const formatDb = value => `${value > 0 ? '+' : ''}${value} dB`;

                    const card = document.createElement('div');
                    card.className = 'rounded-xl border border-[var(--border-primary)] bg-[var(--bg-card)] overflow-hidden';
                    card.setAttribute('data-dongle-id', id);
                    card.innerHTML = `
                        <div class="flex items-center justify-between gap-3 px-4 py-3.5 border-b border-[var(--border-primary)] bg-[var(--bg-primary)]/25">

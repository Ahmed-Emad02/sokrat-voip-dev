        function filterExtensionDspTable() {
            const q = (document.getElementById('dspExtSearchInput')?.value || '').toLowerCase().trim();
            if (!q) {
                renderExtensionsDspTable(cachedDspExtensions);
                return;
            }
            const filtered = cachedDspExtensions.filter(ext => 
                ext.extension.toLowerCase().includes(q) || (ext.name && ext.name.toLowerCase().includes(q))
            );
            renderExtensionsDspTable(filtered);
        }


                                <td class="py-3 px-4 text-center">
                                    <span class="px-2 py-0.5 text-[11px] font-bold rounded ${uptime >= 90 ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/20' : uptime >= 60 ? 'bg-amber-500/15 text-amber-300 border border-amber-500/20' : 'bg-rose-500/15 text-rose-400 border border-rose-500/20'}">
                                        ${uptime}%

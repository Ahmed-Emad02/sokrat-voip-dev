        } catch (_) {}

        function setDiagramViewMode(mode) {
            diagramViewMode = mode;
            try { localStorage.setItem('diagram_view_mode', mode); } catch (_) {}
            updateDiagramViewSwitcherButtons();
            renderDiagram();
            sizeDiagramCanvas();
            setTimeout(fitDiagramToScreen, 50);
        }
        window.setDiagramViewMode = setDiagramViewMode;

        function updateDiagramViewSwitcherButtons() {
            const btnRadial = document.getElementById('btnDiagramViewRadial');
            const btnPipeline = document.getElementById('btnDiagramViewPipeline');
            if (!btnRadial || !btnPipeline) return;

            if (diagramViewMode === 'radial') {
                btnRadial.className = 'px-3 py-1.5 rounded-lg text-xs font-black flex items-center gap-1.5 transition-all cursor-pointer bg-purple-600 text-white border border-purple-400 shadow-md';
                btnPipeline.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold flex items-center gap-1.5 transition-all cursor-pointer text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] border border-transparent';
            } else {
                btnPipeline.className = 'px-3 py-1.5 rounded-lg text-xs font-black flex items-center gap-1.5 transition-all cursor-pointer bg-blue-600 text-white border border-blue-400 shadow-md';
                btnRadial.className = 'px-3 py-1.5 rounded-lg text-xs font-extrabold flex items-center gap-1.5 transition-all cursor-pointer text-[var(--text-secondary)] hover:text-white hover:bg-[var(--bg-hover)] border border-transparent';
            }
        }

        // =========================================================================
        // RADIAL TOPOLOGY VIEW ENGINE (Inspired by Reference Architecture Topology)
        // 4-Quadrant Starburst Architecture centered around a CORE ROUTING HUB
        // =========================================================================
        function renderDiagramRadial() {
            const svgNodes = document.getElementById('diagramNodes');
            const svgWires = document.getElementById('diagramConnections');
            const svg = document.getElementById('diagramSvg');
            const canvas = document.getElementById('diagramCanvasContainer');
            if (!svgNodes || !svgWires || !svg || !canvas || !diagramRawData) return;

            svgNodes.innerHTML = '';
            svgWires.innerHTML = '';

            const cardWidth = 270;
            const cardHeight = 130;

            function formatDestination(dest) {
                if (!dest) return isRtl ? 'غير محدد' : 'Not set';
                if (dest.startsWith('ext-group,')) return `${isRtl ? 'مجموعة:' : 'Group:'} ${dest.split(',')[1]}`;
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) return `${isRtl ? 'تحويلة:' : 'Extension:'} ${dest.split(',')[1]}`;
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    const ivrObj = (diagramRawData.ivrs || []).find(i => String(i.id) === String(ivrId));
                    return `IVR: ${ivrObj ? ivrObj.name : ivrId}`;
                }
                if (dest.startsWith('ext-queues,')) return `${isRtl ? 'طابور:' : 'Queue:'} ${dest.split(',')[1]}`;
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) {
                    const conditionId = dest.split(',')[1];
                    const condition = (diagramRawData.timeconditions || []).find(tc => String(tc.timeconditions_id) === String(conditionId));
                    return `${isRtl ? 'شرط زمني' : 'Time Condition'}: ${condition ? condition.displayname : conditionId}`;
                }
                if (dest.startsWith('ext-external-failover,') || dest.startsWith('from-internal,')) {
                    const rawTarget = dest.split(',')[1] || '';
                    const phone = rawTarget.split('/')[0].split('@')[0];
                    const dongle = rawTarget.includes('/') ? rawTarget.split('/')[1] : (rawTarget.includes('@') ? rawTarget.split('@')[1] : '');
                    if (phone) return `${isRtl ? 'رقم خارجي:' : 'External:'} ${phone}${dongle ? ' (' + dongle + ')' : ''}`;
                }
                return dest;
            }

            function resolveTargetNodeId(dest) {
                if (!dest) return null;
                if (dest.startsWith('ext-group,')) return 'ringgroup-' + dest.split(',')[1];
                if (dest.startsWith('ext-queues,')) return 'queue-' + dest.split(',')[1];
                if (dest.startsWith('from-did-direct,') || dest.startsWith('ext-local,')) return 'extension-' + dest.split(',')[1];
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) return 'timecondition-' + dest.split(',')[1];
                if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) {
                    const ivrId = dest.startsWith('ext-ivr,') ? dest.split(',')[1] : dest.split(',')[0].replace('ivr-', '');
                    return 'ivr-' + ivrId;
                }
                return null;
            }

            const inbound = diagramRawData.inbound || [];
            const ringgroups = diagramRawData.ringgroups || [];
            const extensions = diagramRawData.extensions || [];
            const outbound = diagramRawData.outbound || [];
            const trunks = diagramRawData.trunks || [];
            const timeconditions = diagramRawData.timeconditions || [];
            const queues = diagramRawData.queues || [];
            const ivrs = diagramRawData.ivrs || [];

            diagramNodesList = [];

            // 1. Inbound Nodes
            inbound.forEach((route, i) => {
                diagramNodesList.push({
                    id: 'inbound-' + (route.did || 'any') + '-' + i,
                    type: 'inbound',
                    title: route.did ? `DID: ${route.did}` : (isRtl ? 'أي رقم وارد' : 'Any DID'),
                    subtitle: route.description || (isRtl ? 'مسار وارد' : 'Inbound Route'),
                    desc: route.destination,
                    data: route
                });
            });

            // 2. Ring Groups Nodes
            ringgroups.forEach(rg => {
                diagramNodesList.push({
                    id: 'ringgroup-' + rg.grpnum,
                    type: 'ringgroup',
                    title: `${isRtl ? 'مجموعة:' : 'Group:'} ${rg.grpnum}`,
                    subtitle: rg.description || (isRtl ? 'مجموعة اتصال' : 'Ring Group'),
                    desc: `${isRtl ? 'الاستراتيجية:' : 'Strategy:'} ${rg.strategy}`,
                    data: rg
                });
            });

            // 3. IVR Nodes
            ivrs.forEach(ivr => {
                const entriesCount = Array.isArray(ivr.entries) ? ivr.entries.length : 0;
                diagramNodesList.push({
                    id: 'ivr-' + ivr.id,
                    type: 'ivr',
                    title: `${isRtl ? 'الرد الآلي:' : 'IVR:'} ${ivr.name}`,
                    subtitle: ivr.description || (isRtl ? 'قائمة الرد الآلي' : 'IVR Menu'),
                    desc: `${isRtl ? 'خيارات:' : 'Options:'} ${entriesCount}`,
                    data: ivr
                });
            });

            // 4. Queues Nodes
            queues.forEach(q => {
                diagramNodesList.push({
                    id: 'queue-' + q.extension,
                    type: 'queue',
                    title: `${isRtl ? 'طابور:' : 'Queue:'} ${q.extension}`,
                    subtitle: q.descr || (isRtl ? 'طابور انتظار' : 'Call Queue'),
                    desc: `${isRtl ? 'أقصى وقت:' : 'Max Wait:'} ${q.maxwait === '0' || !q.maxwait ? 'Unlimited' : q.maxwait + 's'}`,
                    data: q
                });
            });

            // 5. Extensions Nodes
            extensions.forEach(ext => {
                diagramNodesList.push({
                    id: 'extension-' + ext.extension,
                    type: 'extension',
                    title: `${ext.extension} - ${ext.name || 'User'}`,
                    subtitle: ext.tech ? ext.tech.toUpperCase() : 'SIP',
                    desc: `CID: ${ext.outboundcid || 'Default'}`,
                    data: ext
                });
            });

            // 6. Outbound Routes Nodes
            outbound.forEach(route => {
                const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                const patternStr = patterns.map(p => p.pattern).filter(Boolean).join(', ');
                diagramNodesList.push({
                    id: 'outbound-' + route.route_id,
                    type: 'outbound',
                    title: route.name || (isRtl ? 'مسار صادر' : 'Outbound Route'),
                    subtitle: (route.trunks || []).map(t => t.trunk_name || t.name).join(', ') || (isRtl ? 'بدون خطوط' : 'No trunks'),
                    desc: patternStr || '',
                    data: route
                });
            });

            // 7. Trunks Nodes
            trunks.forEach(tk => {
                diagramNodesList.push({
                    id: 'trunk-' + tk.trunkid,
                    type: 'trunk',
                    title: tk.name || `Trunk ${tk.trunkid}`,
                    subtitle: (tk.tech || 'SIP').toUpperCase(),
                    desc: tk.channelid || '',
                    data: tk
                });
            });

            // 8. Time Conditions Nodes
            timeconditions.forEach(tc => {
                const scheduleStr = tc.details ? tc.details.map(d => d.time + ' ' + d.name).join('; ') : '';
                diagramNodesList.push({
                    id: 'timecondition-' + tc.timeconditions_id,
                    type: 'timecondition',
                    title: tc.displayname || (isRtl ? 'شرط زمني' : 'Time Condition'),
                    subtitle: tc.timegroup_name || (isRtl ? 'غير محدد' : 'No group'),
                    desc: scheduleStr || '',
                    data: tc
                });
            });

            // Build Diagram Links
            diagramLinks = [];

            inbound.forEach((route, idx) => {
                const dest = route.destination || '';
                const targetId = resolveTargetNodeId(dest);
                let wireType = 'inbound-dest';
                if (dest.startsWith('timeconditions,') || dest.startsWith('ext-timeconditions,')) wireType = 'inbound-tc';
                else if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'inbound-ivr';
                if (targetId) {
                    diagramLinks.push({ id: `link-inbound-${idx}`, source: 'inbound-' + (route.did || 'any') + '-' + idx, target: targetId, type: wireType });
                }
            });

            timeconditions.forEach(tc => {
                [tc.truegoto || '', tc.falsegoto || ''].forEach((dest, isFalse) => {
                    const targetId = resolveTargetNodeId(dest);
                    let wireType = isFalse ? 'tc-false' : 'tc-true';
                    if (dest.startsWith('ivr-') || dest.startsWith('ext-ivr,')) wireType = 'tc-ivr';
                    if (targetId) {
                        diagramLinks.push({ id: 'link-tc-' + tc.timeconditions_id + '-' + (isFalse ? 'false' : 'true') + '-' + targetId, source: 'timecondition-' + tc.timeconditions_id, target: targetId, type: wireType });
                    }
                });
            });

            ivrs.forEach(ivr => {
                (Array.isArray(ivr.entries) ? ivr.entries : []).forEach((entry, idx) => {
                    const targetId = resolveTargetNodeId(entry.dest);
                    if (targetId) {
                        diagramLinks.push({ id: `link-ivr-${ivr.id}-entry-${entry.selection}-${idx}`, source: 'ivr-' + ivr.id, target: targetId, type: 'ivr-entry' });
                    }
                });
                if (ivr.timeout_destination) {
                    const targetId = resolveTargetNodeId(ivr.timeout_destination);
                    if (targetId) diagramLinks.push({ id: `link-ivr-${ivr.id}-timeout`, source: 'ivr-' + ivr.id, target: targetId, type: 'ivr-timeout' });
                }
            });

            ringgroups.forEach(rg => {
                (Array.isArray(rg.grplist) ? rg.grplist : []).forEach(ext => {
                    if (extensions.some(e => String(e.extension) === String(ext))) {
                        diagramLinks.push({ id: `link-rg-${rg.grpnum}-${ext}`, source: 'ringgroup-' + rg.grpnum, target: 'extension-' + ext, type: 'rg-member' });
                    }
                });
            });

            queues.forEach(q => {
                (Array.isArray(q.static_members) ? q.static_members : []).forEach(ext => {
                    if (extensions.some(e => String(e.extension) === String(ext))) {
                        diagramLinks.push({ id: `link-queue-${q.extension}-${ext}`, source: 'queue-' + q.extension, target: 'extension-' + ext, type: 'queue-member' });
                    }
                });
                if (q.dest) {
                    const targetId = resolveTargetNodeId(q.dest);
                    if (targetId) diagramLinks.push({ id: `link-queue-${q.extension}-failover-${targetId}`, source: 'queue-' + q.extension, target: targetId, type: 'queue-failover' });
                }
                if (q.destcontinue) {
                    const targetId = resolveTargetNodeId(q.destcontinue);
                    if (targetId) diagramLinks.push({ id: `link-queue-${q.extension}-continue-${targetId}`, source: 'queue-' + q.extension, target: targetId, type: 'queue-continue' });
                }
            });

            extensions.forEach(ext => {
                outbound.forEach(route => {
                    const patterns = Array.isArray(route.patterns) ? route.patterns : [];
                    const hasRestrictedCid = patterns.some(p => String(p.cid) === String(ext.extension));
                    const hasGlobalRoute = patterns.some(p => !p.cid || p.cid === '');
                    if (hasRestrictedCid) {
                        diagramLinks.push({ id: `link-ext-outbound-${ext.extension}-${route.route_id}`, source: 'extension-' + ext.extension, target: 'outbound-' + route.route_id, type: 'ext-route-restricted' });
                    } else if (hasGlobalRoute) {
                        diagramLinks.push({ id: `link-ext-outbound-global-${ext.extension}-${route.route_id}`, source: 'extension-' + ext.extension, target: 'outbound-' + route.route_id, type: 'ext-route-global' });
                    }
                });
            });

            outbound.forEach(route => {
                (Array.isArray(route.trunks) ? route.trunks : []).forEach(tk => {
                    const tkId = tk.trunk_id || tk.trunkid;
                    const matchedTrunk = trunks.find(t => String(t.trunkid) === String(tkId) || (tk.trunk_name && String(t.name) === String(tk.trunk_name)));
                    const targetTrunkId = matchedTrunk ? matchedTrunk.trunkid : tkId;
                    if (targetTrunkId !== undefined && targetTrunkId !== null) {
                        diagramLinks.push({ id: `link-outbound-${route.route_id}-trunk-${targetTrunkId}`, source: 'outbound-' + route.route_id, target: 'trunk-' + targetTrunkId, type: 'outbound-trunk' });
                    }
                });
            });

            // -------------------------------------------------------------
            // DEDICATED 8-ZONE NON-OVERLAPPING TOPOLOGICAL GRID
            // Col 1: Trunks (Top) / Time Conditions (Bottom)
            // Col 2: Inbound DIDs (Top) / IVR Menus (Bottom)
            // Col 3: Outbound Routes (Top) / Call Queues (Bottom)
            // Col 4: Extensions (Top) / Ring Groups (Bottom)
            // -------------------------------------------------------------
            const zTrunks = diagramNodesList.filter(n => n.type === 'trunk');
            const zTimecond = diagramNodesList.filter(n => n.type === 'timecondition');
            const zInbound = diagramNodesList.filter(n => n.type === 'inbound');
            const zIvrs = diagramNodesList.filter(n => n.type === 'ivr');
            const zOutbound = diagramNodesList.filter(n => n.type === 'outbound');
            const zQueues = diagramNodesList.filter(n => n.type === 'queue');
            const zExts = diagramNodesList.filter(n => n.type === 'extension');
            const zRinggroups = diagramNodesList.filter(n => n.type === 'ringgroup');

            const zonePad = 22;
            const headerH = 42;
            const cardGapX = 18;
            const cardGapY = 16;
            const colGap = 48;
            const rowGap = 48;

            function zoneDimensions(count, maxCols) {
                const cols = Math.max(1, Math.min(maxCols, count || 1));
                const rows = Math.max(1, Math.ceil((count || 1) / cols));
                const w = zonePad * 2 + cols * cardWidth + (cols - 1) * cardGapX;
                const h = headerH + zonePad + rows * cardHeight + (rows - 1) * cardGapY + zonePad;
                return { w, h, cols, rows };
            }

            const dimTrunks = zoneDimensions(zTrunks.length, 1);
            const dimTimecond = zoneDimensions(zTimecond.length, 1);
            const dimInbound = zoneDimensions(zInbound.length, 1);
            const dimIvrs = zoneDimensions(zIvrs.length, 1);
            const dimOutbound = zoneDimensions(zOutbound.length, 1);
            const dimQueues = zoneDimensions(zQueues.length, 1);
            const dimExts = zoneDimensions(zExts.length, 2);
            const dimRinggroups = zoneDimensions(zRinggroups.length, 2);

            const col1W = Math.max(dimTrunks.w, dimTimecond.w);
            const col2W = Math.max(dimInbound.w, dimIvrs.w);
            const col3W = Math.max(dimOutbound.w, dimQueues.w);
            const col4W = Math.max(dimExts.w, dimRinggroups.w);

            const topRowH = Math.max(dimTrunks.h, dimInbound.h, dimOutbound.h, dimExts.h);
            const bottomRowH = Math.max(dimTimecond.h, dimIvrs.h, dimQueues.h, dimRinggroups.h);

            const col1_x = 70;
            const col2_x = col1_x + col1W + colGap;
            const col3_x = col2_x + col2W + colGap;
            const col4_x = col3_x + col3W + colGap;

            const row1_y = 100;
            const row2_y = row1_y + topRowH + rowGap;

            const W = col4_x + col4W + 70;
            const H = row2_y + bottomRowH + 110;

            const ZONES = {
                trunks: { x: col1_x, y: row1_y, w: col1W, h: topRowH, color: '#06b6d4', bg: '#08252e', borderColor: '#0891b2', title: 'EXTERNAL GATEWAYS (SIP TRUNKS)', nodes: zTrunks, cols: dimTrunks.cols },
                timeconditions: { x: col1_x, y: row2_y, w: col1W, h: bottomRowH, color: '#f59e0b', bg: '#2e2407', borderColor: '#d97706', title: 'TIME CONDITIONS & SCHEDULES', nodes: zTimecond, cols: dimTimecond.cols },

                inbound: { x: col2_x, y: row1_y, w: col2W, h: topRowH, color: '#10b981', bg: '#072b1e', borderColor: '#059669', title: 'INBOUND ROUTES (DIDs)', nodes: zInbound, cols: dimInbound.cols },
                ivrs: { x: col2_x, y: row2_y, w: col2W, h: bottomRowH, color: '#8b5cf6', bg: '#20133d', borderColor: '#7c3aed', title: 'APPLICATION SERVERS (IVR & QUEUES)', nodes: zIvrs, cols: dimIvrs.cols },

                outbound: { x: col3_x, y: row1_y, w: col3W, h: topRowH, color: '#ea580c', bg: '#331407', borderColor: '#dc2626', title: 'ROUTING RULES (OUTBOUND)', nodes: zOutbound, cols: dimOutbound.cols },
                queues: { x: col3_x, y: row2_y, w: col3W, h: bottomRowH, color: '#f97316', bg: '#2e1807', borderColor: '#ea580c', title: 'CALL QUEUES (ACD)', nodes: zQueues, cols: dimQueues.cols },

                extensions: { x: col4_x, y: row1_y, w: col4W, h: topRowH, color: '#3b82f6', bg: '#0c1f3d', borderColor: '#2563eb', title: 'INTERNAL USER EXTENSIONS', nodes: zExts, cols: dimExts.cols },
                ringgroups: { x: col4_x, y: row2_y, w: col4W, h: bottomRowH, color: '#d946ef', bg: '#2e0a29', borderColor: '#c026d3', title: 'RING GROUPS (HUNT GROUPS)', nodes: zRinggroups, cols: dimRinggroups.cols }
            };

            // Layout each node within its strictly non-overlapping dedicated zone
            Object.values(ZONES).forEach(zone => {
                zone.nodes.forEach((n, idx) => {
                    const col = idx % zone.cols;
                    const row = Math.floor(idx / zone.cols);
                    n.x = zone.x + zonePad + col * (cardWidth + cardGapX);
                    n.y = zone.y + headerH + zonePad + row * (cardHeight + cardGapY);
                });
            });

            // Manual saved positions override
            let savedRadial = null;
            try { savedRadial = JSON.parse(localStorage.getItem('config_diagram_radial_layout_v1')); } catch (_) {}
            if (savedRadial && typeof savedRadial === 'object') {
                diagramNodesList.forEach(n => {
                    if (savedRadial[n.id] && Number.isFinite(savedRadial[n.id].x) && Number.isFinite(savedRadial[n.id].y)) {
                        n.x = savedRadial[n.id].x;
                        n.y = savedRadial[n.id].y;
                    }
                });
            }

            svg.style.height = `${H}px`;
            svg.style.width = `${W}px`;
            svg.setAttribute('height', String(H));
            svg.setAttribute('width', String(W));

            diagramRenderCtx = {
                cardWidth,
                cardHeight,
                makeWirePath: makeCleanDirectWirePath
            };
            initDiagramNodeDragging();

            // Arrowheads
            const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
            defs.innerHTML = Object.entries(WIRE_COLORS).map(([type, color]) =>
                `<marker id="arrow-rad-${type}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M 0 1 L 9 5 L 0 9 z" fill="${color}"/></marker>`
            ).join('');
            svgWires.appendChild(defs);

            // Background Area Boundary Boxes & Headers for all 8 zones
            const bgGroup = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            bgGroup.setAttribute('class', 'diagram-radial-backdrop select-none');

            Object.values(ZONES).forEach(zone => {
                bgGroup.innerHTML += `
                    <rect x="${zone.x}" y="${zone.y}" width="${zone.w}" height="${zone.h}" rx="16"
                          fill="rgba(15, 23, 42, 0.45)" stroke="${zone.borderColor}" stroke-width="1.5" stroke-dasharray="6 6" stroke-opacity="0.5" />
                    <g transform="translate(${zone.x + 16}, ${zone.y + 14})">
                        <rect x="0" y="0" width="${zone.w - 32}" height="32" rx="7" fill="${zone.bg}" fill-opacity="0.9" stroke="${zone.borderColor}" stroke-width="1" stroke-opacity="0.6" />
                        <circle cx="16" cy="16" r="5" fill="${zone.color}" />
                        <text x="28" y="20" class="font-mono font-black uppercase text-[11px] fill-white tracking-wider">${zone.title}</text>
                        <text x="${zone.w - 48}" y="20" text-anchor="end" class="font-mono font-bold text-[10px] fill-[var(--text-muted)]">${zone.nodes.length} items</text>
                    </g>
                `;
            });

            // Clean direct wire path
            function makeCleanDirectWirePath(sourceNode, targetNode) {
                const sx = sourceNode.x < targetNode.x ? (sourceNode.x + cardWidth) : sourceNode.x;
                const sy = sourceNode.y + cardHeight / 2;
                const tx = sourceNode.x < targetNode.x ? targetNode.x : (targetNode.x + cardWidth);
                const ty = targetNode.y + cardHeight / 2;

                const dx = Math.abs(tx - sx) * 0.45;
                const c1x = tx >= sx ? sx + dx : sx - dx;
                const c2x = tx >= sx ? tx - dx : tx + dx;

                return `M ${sx} ${sy} C ${c1x} ${sy}, ${c2x} ${ty}, ${tx} ${ty}`;
            }

            // Render Wires directly between nodes
            diagramLinks.forEach(link => {
                const sourceNode = diagramNodesList.find(n => n.id === link.source);
                const targetNode = diagramNodesList.find(n => n.id === link.target);
                if (!sourceNode || !targetNode) return;

                const strokeColor = WIRE_COLORS[link.type] || '#38bdf8';
                const isGlobalMesh = link.type === 'ext-route-global';

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('id', link.id);
                path.setAttribute('class', 'diagram-wire transition-all duration-200');
                path.setAttribute('d', makeCleanDirectWirePath(sourceNode, targetNode));
                path.setAttribute('fill', 'none');
                path.setAttribute('stroke', strokeColor);
                path.setAttribute('stroke-width', isGlobalMesh ? '1px' : '2px');
                path.setAttribute('stroke-linecap', 'round');
                if (FAILING_WIRES.has(link.type)) path.setAttribute('stroke-dasharray', '7 5');
                if (!isGlobalMesh) path.setAttribute('marker-end', `url(#arrow-rad-${link.type})`);
                path.setAttribute('data-type', link.type);
                path.setAttribute('data-src', link.source);
                path.setAttribute('data-tgt', link.target);
                path.style.opacity = isGlobalMesh ? '0.16' : '0.55';

                svgWires.appendChild(path);
            });

            svgWires.appendChild(bgGroup);

            // Full-Bleed Colored Card Themes (matching GSM dongles)
            const CARD_THEMES = {
                trunk: { bg: '#08252e', border: 'border-cyan-500/80 hover:border-cyan-400', innerBg: '#03171f', innerBorder: 'border-cyan-500/30', iconBg: 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40', accentText: 'text-cyan-300' },
                inbound: { bg: '#072b1e', border: 'border-emerald-500/80 hover:border-emerald-400', innerBg: '#021a12', innerBorder: 'border-emerald-500/30', iconBg: 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40', accentText: 'text-emerald-300' },
                timecondition: { bg: '#2e2407', border: 'border-amber-500/80 hover:border-amber-400', innerBg: '#1c1603', innerBorder: 'border-amber-500/30', iconBg: 'bg-amber-500/20 text-amber-300 border border-amber-500/40', accentText: 'text-amber-300' },
                ivr: { bg: '#20133d', border: 'border-purple-500/80 hover:border-purple-400', innerBg: '#110a24', innerBorder: 'border-purple-500/30', iconBg: 'bg-purple-500/20 text-purple-300 border border-purple-500/40', accentText: 'text-purple-300' },
                queue: { bg: '#2e1807', border: 'border-orange-500/80 hover:border-orange-400', innerBg: '#1c0d02', innerBorder: 'border-orange-500/30', iconBg: 'bg-orange-500/20 text-orange-300 border border-orange-500/40', accentText: 'text-orange-300' },
                ringgroup: { bg: '#2e0a29', border: 'border-fuchsia-500/80 hover:border-fuchsia-400', innerBg: '#1c061a', innerBorder: 'border-fuchsia-500/30', iconBg: 'bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/40', accentText: 'text-fuchsia-300' },
                extension: { bg: '#0c1f3d', border: 'border-blue-500/80 hover:border-blue-400', innerBg: '#051226', innerBorder: 'border-blue-500/30', iconBg: 'bg-blue-500/20 text-blue-300 border border-blue-500/40', accentText: 'text-blue-300' },
                outbound: { bg: '#331407', border: 'border-rose-500/80 hover:border-rose-400', innerBg: '#1f0a03', innerBorder: 'border-rose-500/30', iconBg: 'bg-rose-500/20 text-rose-300 border border-rose-500/40', accentText: 'text-rose-300' }
            };

            // Render Nodes
            diagramNodesList.forEach(node => {
                const theme = CARD_THEMES[node.type] || CARD_THEMES.trunk;
                let svgIcon = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" /></svg>`;

                if (node.type === 'ringgroup') svgIcon = `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`;

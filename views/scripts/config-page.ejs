        // Helper string formatters for Issabel Time Rules
        const WEEKDAY_NAMES = { mon: 'Mon', tue: 'Tue', wed: 'Wed', thu: 'Thu', fri: 'Fri', sat: 'Sat', sun: 'Sun' };
        const WEEKDAY_NAMES_AR = { mon: 'الإثنين', tue: 'الثلاثاء', wed: 'الأربعاء', thu: 'الخميس', fri: 'الجمعة', sat: 'السبت', sun: 'الأحد' };
        const MONTH_NAMES = { jan: 'Jan', feb: 'Feb', mar: 'Mar', apr: 'Apr', may: 'May', jun: 'Jun', jul: 'Jul', aug: 'Aug', sep: 'Sep', oct: 'Oct', nov: 'Nov', dec: 'Dec' };
        const MONTH_NAMES_AR = { jan: 'يناير', feb: 'فبراير', mar: 'مارس', apr: 'أبريل', may: 'مايو', jun: 'يونيو', jul: 'يوليو', aug: 'أغسطس', sep: 'سبتمبر', oct: 'أكتوبر', nov: 'نوفمبر', dec: 'ديسمبر' };

        function formatWeekdayText(val) {
            if (!val || val === '*' || val === '*-*') return isRtl ? 'كل أيام الأسبوع' : 'All Weekdays';
            const map = isRtl ? WEEKDAY_NAMES_AR : WEEKDAY_NAMES;
            if (val.includes('&')) {
                return val.split('&').map(d => map[d] || d).join(', ');
            }
            if (val.includes('-')) {
                const [s, e] = val.split('-');
                return `${map[s] || s} - ${map[e] || e}`;
            }
            return val.split(',').map(d => map[d] || d).join(', ');
        }

        function formatMonthdayText(val) {
            if (!val || val === '*' || val === '*-*') return isRtl ? 'كل أيام الشهر' : 'All Monthdays';
            if (val.includes('-')) {
                const [s, e] = val.split('-');
                return isRtl ? `الأيام ${s} - ${e}` : `Days ${s} - ${e}`;
            }
            return isRtl ? `يوم ${val}` : `Day ${val}`;
        }

        function formatMonthText(val) {
            if (!val || val === '*' || val === '*-*') return isRtl ? 'كل الشهور' : 'All Months';
            const map = isRtl ? MONTH_NAMES_AR : MONTH_NAMES;
            if (val.includes('-')) {
                const [s, e] = val.split('-');
                return `${map[s] || s} - ${map[e] || e}`;
            }
            return val.split(',').map(m => map[m] || m).join(', ');
        }

        function formatTimeText(val) {
            if (!val || val === '*' || val === '*-*') return isRtl ? 'طوال اليوم (24 ساعة)' : 'All Day (00:00 - 23:59)';
            return val;
        }


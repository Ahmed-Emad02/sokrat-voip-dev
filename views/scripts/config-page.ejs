                        const groupLabel = ext.emp_group ? escapeHtml(formatGroupName(ext.emp_group, isRtl)) : (isRtl ? 'بدون مجموعة' : 'Ungrouped');
                        const groupClass = ext.emp_group ? 'text-red-400 font-bold' : 'text-[var(--text-muted)]';
                        const groupText = `<div class="flex items-center gap-1.5 flex-wrap"><span class="text-[10px] truncate ${groupClass}">${groupLabel}</span>${adminBadge}</div>`;
                        const isWebRtcExt = (ext.tech === 'pjsip' || ext.tech === 'webrtc');
                        let policyBadges = '';
                        if (isWebRtcExt) {
                            const aaColor = ext.auto_answer === 'force_on' ? 'text-emerald-400' : (ext.auto_answer === 'force_off' ? 'text-rose-400' : 'text-zinc-400');
                            const aaLabel = ext.auto_answer === 'force_on' ? (isRtl ? 'رد: إجباري' : 'Auto: Force') : (ext.auto_answer === 'force_off' ? (isRtl ? 'رد: ممنوع' : 'Auto: Off') : (isRtl ? 'رد: حر' : 'Auto: User'));
                            const dndColor = ext.dnd === 'force_on' ? 'text-amber-400' : (ext.dnd === 'force_off' ? 'text-rose-400' : 'text-zinc-400');
                            const dndLabel = ext.dnd === 'force_on' ? (isRtl ? 'DND: إجباري' : 'DND: Force') : (ext.dnd === 'force_off' ? (isRtl ? 'DND: ممنوع' : 'DND: Off') : (isRtl ? 'DND: حر' : 'DND: User'));
                            const cancelBadge = (ext.disable_outbound_ringing_cancel == 1 || ext.disable_outbound_ringing_cancel === true) ? `<span class="px-1.5 py-0.5 text-[9px] font-bold rounded text-rose-400" title="${isRtl ? 'ممنوع إنهاء الرنين' : 'Block Ring Cancel'}">${isRtl ? 'قفل الرنين' : 'No Cancel'}</span>` : '';
                            policyBadges = `<div class="flex items-center gap-1 mt-1 flex-wrap"><span class="px-1.5 py-0.5 text-[9px] font-bold rounded ${aaColor}">${aaLabel}</span><span class="px-1.5 py-0.5 text-[9px] font-bold rounded ${dndColor}">${dndLabel}</span>${cancelBadge}</div>`;
                        }
                        const techBadge = isWebRtcExt
                            ? `<div class="flex flex-col gap-0.5"><span class="ext-tech-badge ext-tech-webrtc">WebRTC Softphone</span>${policyBadges}</div>`
                            : `<span class="ext-tech-badge ext-tech-sip">Generic SIP Device</span>`;
                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${escapeHtml(ext.extension)}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${escapeHtml(ext.name || '-')}</td>
                            <td class="py-3 px-4">
                                <div class="min-w-[12rem] flex flex-col">${titleText}${groupText}</div>
                            </td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${escapeHtml(ext.secret || '-')}</td>
                            <td class="py-3 px-4">${techBadge}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded text-emerald-400">Yes</span></td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded text-purple-400">Always</span></td>
                            <td class="py-3 px-4">${vmBadge}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" data-action="edit" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" data-action="delete" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tr.querySelector('[data-action="edit"]').addEventListener('click', () => {
                            editExtension(ext.extension, ext.name, ext.secret, ext.voicemail, ext.tech, ext.denoise, ext.vad_gate, ext.vad_db, ext.agc, ext.auto_answer, ext.dnd, ext.disable_outbound_ringing_cancel);
                        });
                        tr.querySelector('[data-action="delete"]').addEventListener('click', () => {
                            deleteExtension(ext.extension);
                        });
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => {
                    console.error('fetchExtensions error:', err);
                    if (tbody) tbody.innerHTML = '<tr><td colspan="9" class="py-6 text-center text-rose-400 font-semibold">' + (isRtl ? 'خطأ في جلب بيانات التحويلات.' : 'Error fetching extensions.') + '</td></tr>';
                });
        }

        function resetEmployeeProfileFields() {
            document.getElementById('extTitle').value = '';
            const isGroupAdminEl = document.getElementById('extIsGroupAdmin');
            if (isGroupAdminEl) isGroupAdminEl.checked = false;
            const groupSelect = document.getElementById('extGroup');
            groupSelect.disabled = true;
            groupSelect.innerHTML = '<option value="">' + (isRtl ? 'جاري تحميل المجموعات...' : 'Loading groups...') + '</option>';
        }

        function formatGroupName(groupOrName, isRtl) {
            if (!groupOrName) return isRtl ? 'بدون مجموعة' : 'Ungrouped';
            let name = '';
            let nameAr = '';
            let nameEn = '';
            if (typeof groupOrName === 'object') {
                name = groupOrName.name || '';
                nameAr = groupOrName.name_ar || '';
                nameEn = groupOrName.name_en || '';
            } else {
                name = String(groupOrName || '');
            }
            if (name === '___ungrouped___') return isRtl ? 'بدون مجموعة' : 'Ungrouped';
            if (isRtl && nameAr) return nameAr;
            if (!isRtl && nameEn) return nameEn;
            const parenMatch = name.match(/^([^(]+?)\s*\(([^)]+)\)$/);
            if (parenMatch) {
                const p1 = parenMatch[1].trim();
                const p2 = parenMatch[2].trim();
                const hasAr1 = /[\u0600-\u06FF]/.test(p1);
                const hasAr2 = /[\u0600-\u06FF]/.test(p2);
                if (hasAr1 && !hasAr2) return isRtl ? p1 : p2;
                if (!hasAr1 && hasAr2) return isRtl ? p2 : p1;
                return isRtl ? p1 : p2;
            }
            const slashMatch = name.match(/^([^\/]+?)\s*[\/|]\s*(.+)$/);
            if (slashMatch) {
                const p1 = slashMatch[1].trim();
                const p2 = slashMatch[2].trim();
                const hasAr1 = /[\u0600-\u06FF]/.test(p1);
                const hasAr2 = /[\u0600-\u06FF]/.test(p2);
                if (hasAr1 && !hasAr2) return isRtl ? p1 : p2;
                if (!hasAr1 && hasAr2) return isRtl ? p2 : p1;
                return isRtl ? p1 : p2;
            }
            return name;
        }

        function setEmployeeGroupOptions(groups, selectedValue = '') {
            const select = document.getElementById('extGroup');
            select.innerHTML = '';
            const emptyOption = document.createElement('option');
            emptyOption.value = '';
            emptyOption.textContent = isRtl ? '(بدون مجموعة)' : '(No Group)';
            select.appendChild(emptyOption);
            groups.forEach(group => {
                const option = document.createElement('option');
                option.value = group.name;
                option.textContent = formatGroupName(group, isRtl);
                select.appendChild(option);
            });
            select.value = selectedValue;
            select.disabled = false;
        }

        async function loadEmployeeGroups(selectedValue = '') {
            const response = await fetch('/api/employee/groups');
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Failed to load employee groups');
            }
            setEmployeeGroupOptions(data.groups || [], selectedValue);
        }

        async function openExtensionModal() {
            document.getElementById('extModalTitle').textContent = isRtl ? 'إضافة تحويلة جديدة (WebRTC / Generic SIP)' : 'Add Extension (WebRTC / Generic SIP)';
            document.getElementById('extEditMode').value = 'false';
            document.getElementById('extNum').disabled = false;
            document.getElementById('extensionForm').reset();
            document.getElementById('extVoicemail').value = 'disabled';
            document.getElementById('extTech').value = 'sip';
            document.getElementById('extDenoise').value = 'both';
            if (document.getElementById('extAutoAnswer')) document.getElementById('extAutoAnswer').value = 'user_choice';
            if (document.getElementById('extDnd')) document.getElementById('extDnd').value = 'user_choice';
            if (document.getElementById('extCancel')) document.getElementById('extCancel').value = '0';
            document.getElementById('extVoicemail').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extTech').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extDenoise').dispatchEvent(new Event('change', { bubbles: true }));
            if (document.getElementById('extAutoAnswer')) document.getElementById('extAutoAnswer').dispatchEvent(new Event('change', { bubbles: true }));
            if (document.getElementById('extDnd')) document.getElementById('extDnd').dispatchEvent(new Event('change', { bubbles: true }));
            if (document.getElementById('extCancel')) document.getElementById('extCancel').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadGate').value = '1';
            document.getElementById('extVadGate').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadDb').value = 'off';
            document.getElementById('extVadDb').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extAgc').value = '8000';
            document.getElementById('extAgc').dispatchEvent(new Event('change', { bubbles: true }));
            resetEmployeeProfileFields();
            openModal('extensionModal');
            try {
                await loadEmployeeGroups();
            } catch (error) {
                showToast(error.message, 'error');
            }
        }

        async function editExtension(extNum, name, secret, voicemail, tech, denoise, vadGate, vadDb, agc, autoAnswer, dnd, disableCancel) {
            document.getElementById('extModalTitle').textContent = (isRtl ? 'تعديل التحويلة ' : 'Edit Extension ') + extNum;
            document.getElementById('extEditMode').value = 'true';
            document.getElementById('extNum').value = extNum;
            document.getElementById('extNum').disabled = true;
            document.getElementById('extName').value = name || '';
            document.getElementById('extSecret').value = secret || '';
            document.getElementById('extVoicemail').value = (voicemail === 'default' || voicemail === 'enabled') ? 'enabled' : 'disabled';
            document.getElementById('extTech').value = (tech === 'pjsip' || tech === 'webrtc') ? 'webrtc' : 'sip';
            document.getElementById('extDenoise').value = ['both', 'rx', 'tx', 'off'].includes(denoise) ? denoise : 'both';
            document.getElementById('extVadGate').value = (vadGate === '0' || vadGate === 0 || vadGate === false) ? '0' : '1';
            document.getElementById('extVadDb').value = (vadDb && vadDb !== 'undefined') ? String(vadDb).trim() : 'off';
            document.getElementById('extAgc').value = (agc && agc !== 'undefined') ? String(agc).trim() : '8000';
            if (document.getElementById('extAutoAnswer')) document.getElementById('extAutoAnswer').value = ['user_choice', 'force_on', 'force_off'].includes(autoAnswer) ? autoAnswer : 'user_choice';
            if (document.getElementById('extDnd')) document.getElementById('extDnd').value = ['user_choice', 'force_on', 'force_off'].includes(dnd) ? dnd : 'user_choice';
            if (document.getElementById('extCancel')) document.getElementById('extCancel').value = (disableCancel === '1' || disableCancel === 1 || disableCancel === true) ? '1' : '0';
            document.getElementById('extVoicemail').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extTech').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extDenoise').dispatchEvent(new Event('change', { bubbles: true }));
            if (document.getElementById('extAutoAnswer')) document.getElementById('extAutoAnswer').dispatchEvent(new Event('change', { bubbles: true }));
            if (document.getElementById('extDnd')) document.getElementById('extDnd').dispatchEvent(new Event('change', { bubbles: true }));
            if (document.getElementById('extCancel')) document.getElementById('extCancel').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadGate').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extVadDb').dispatchEvent(new Event('change', { bubbles: true }));
            document.getElementById('extAgc').dispatchEvent(new Event('change', { bubbles: true }));
            resetEmployeeProfileFields();
            openModal('extensionModal');

            try {
                const [groupsResponse, extrasResponse] = await Promise.all([
                    fetch('/api/employee/groups'),
                    fetch('/api/employee/extras/' + encodeURIComponent(extNum))
                ]);
                const [groupsData, extrasData] = await Promise.all([
                    groupsResponse.json(),
                    extrasResponse.json()
                ]);
                if (!groupsResponse.ok || !groupsData.success) {
                    throw new Error(groupsData.error || 'Failed to load employee groups');
                }
                if (!extrasResponse.ok || !extrasData.success) {
                    throw new Error(extrasData.error || 'Failed to load employee profile');
                }

                const extras = extrasData.extras || {};
                setEmployeeGroupOptions(groupsData.groups || [], extras.emp_group || '');
                document.getElementById('extTitle').value = extras.title || '';
                const isGroupAdminEl = document.getElementById('extIsGroupAdmin');
                if (isGroupAdminEl) isGroupAdminEl.checked = Boolean(extras.is_group_admin);
            } catch (error) {
                setEmployeeGroupOptions([], '');
                showToast(error.message, 'error');
            }
        }

        async function saveExtension(event) {
            event.preventDefault();
            const wasEdit = document.getElementById('extEditMode').value === 'true';
            const extNum = document.getElementById('extNum').value.trim();
            const name = document.getElementById('extName').value.trim();
            const secret = document.getElementById('extSecret').value.trim();
            const voicemail = document.getElementById('extVoicemail').value;
            const tech = document.getElementById('extTech').value;
            const denoise = document.getElementById('extDenoise').value;
            const vadGate = document.getElementById('extVadGate').value;
            const vadDb = document.getElementById('extVadDb').value;
            const agc = document.getElementById('extAgc').value;
            const autoAnswer = document.getElementById('extAutoAnswer')?.value || 'user_choice';
            const dnd = document.getElementById('extDnd')?.value || 'user_choice';
            const disableCancel = document.getElementById('extCancel')?.value || '0';
            const saveButton = document.getElementById('extSaveBtn');
            let extensionCreated = false;

            if (saveButton) setButtonLoading(saveButton, true, isRtl ? 'جاري الحفظ...' : 'Saving...');

            if (!wasEdit) {
                const qMatch = (loadedQueuesList || []).find(q => String(q.extension) === extNum);
                if (qMatch) {
                    showToast(isRtl ? `الرقم ${extNum} مستخدم بالفعل لطابور (${qMatch.descr || extNum}). غير مسموح بتكرار الأرقام.` : `Cannot create: Number ${extNum} is already assigned to Queue "${qMatch.descr || extNum}". Duplicate numbers are strictly restricted.`, 'error');
                    if (saveButton) setButtonLoading(saveButton, false);
                    return;
                }
                const rgMatch = (loadedRingGroupsList || []).find(rg => String(rg.grpnum) === extNum);
                if (rgMatch) {
                    showToast(isRtl ? `الرقم ${extNum} مستخدم بالفعل لمجموعة اتصال (${rgMatch.description || extNum}). غير مسموح بتكرار الأرقام.` : `Cannot create: Number ${extNum} is already assigned to Ring Group "${rgMatch.description || extNum}". Duplicate numbers are strictly restricted.`, 'error');
                    if (saveButton) setButtonLoading(saveButton, false);
                    return;
                }
            }
            try {
                const response = await fetch(wasEdit ? '/api/config/extensions/' + extNum : '/api/config/extensions', {
                    method: wasEdit ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        extension: extNum,
                        name,
                        secret,
                        voicemail,
                        tech,
                        denoise,
                        vad_gate: vadGate,
                        vad_db: vadDb,
                        agc,
                        auto_answer: autoAnswer,
                        dnd: dnd,
                        disable_outbound_ringing_cancel: parseInt(disableCancel, 10)
                    })
                });
                const data = await response.json();
                if (!response.ok || !data.success) {
                    throw new Error(data.error || 'Failed to save extension');
                }

                if (!wasEdit) {
                    extensionCreated = true;
                    document.getElementById('extEditMode').value = 'true';
                    document.getElementById('extNum').disabled = true;
                }
                await saveEmployeeExtras(extNum);
                showToast(data.message, 'success');
                closeModal('extensionModal');
                fetchExtensions();
                if (tech === 'webrtc' && !wasEdit) {
                    document.getElementById('credExt').textContent = extNum;
                    document.getElementById('credName').textContent = name;
                    document.getElementById('credSecret').textContent = secret;
                    document.getElementById('credWsUrl').textContent = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.hostname + (location.protocol === 'https:' ? ':8089/ws' : ':8088/ws');
                    openModal('webrtcCredentialsModal');
                }
            } catch (error) {
                const prefix = extensionCreated
                    ? (isRtl ? 'تم إنشاء التحويلة، لكن تعذر حفظ بيانات الموظف: ' : 'Extension created, but employee profile failed: ')
                    : '';
                showToast(prefix + error.message, 'error');
            } finally {
                if (saveButton) setButtonLoading(saveButton, false);
            }
        }

        async function deleteExtension(extNum) {
            const ok = await window.sokratConfirm({
                title: isRtl ? 'حذف التحويلة' : 'Delete Extension',
                message: isRtl ? `هل أنت متأكد من حذف التحويلة ${extNum}؟` : `Are you sure you want to delete extension ${extNum}?`,
                confirmText: isRtl ? 'حذف' : 'Delete',
                type: 'danger'
            });
            if (!ok) return;
            fetch('/api/config/extensions/' + extNum, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchExtensions();
                    } else {
                        showToast(data.error, 'error');
                    }
                })
                .catch(error => showToast(error.message, 'error'));
        }

        async function saveEmployeeExtras(extNum) {
            const title = document.getElementById('extTitle').value.trim();
            const empGroup = document.getElementById('extGroup').value;

            const response = await fetch('/api/employee/extras/' + encodeURIComponent(extNum), {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    title: title || null,
                    emp_group: empGroup || null,
                    is_group_admin: document.getElementById('extIsGroupAdmin')?.checked ? 1 : 0
                })
            });
            const data = await response.json();
            if (!response.ok || !data.success) {
                throw new Error(data.error || 'Failed to save employee profile');
            }
            return data.extras;
        }
        window.openExtensionModal = openExtensionModal;
        window.editExtension = editExtension;
        window.deleteExtension = deleteExtension;
        window.saveExtension = saveExtension;
        window.fetchExtensions = fetchExtensions;
        window.resetEmployeeProfileFields = resetEmployeeProfileFields;
        window.setEmployeeGroupOptions = setEmployeeGroupOptions;
        window.loadEmployeeGroups = loadEmployeeGroups;
        window.saveEmployeeExtras = saveEmployeeExtras;

        // --- WEBRTC EXTENSION POLICIES ---
        function openPolicyManagerModal() {
            if (typeof openModal === 'function') openModal('policyManagerModal');
            else {
                const modal = document.getElementById('policyManagerModal');
                if (modal) modal.classList.remove('hidden');
            }
            loadWebRtcExtensionPolicies();
        }
        window.openPolicyManagerModal = openPolicyManagerModal;

        function closePolicyManagerModal() {
            if (typeof closeModal === 'function') closeModal('policyManagerModal');
            else {
                const modal = document.getElementById('policyManagerModal');
                if (modal) modal.classList.add('hidden');
            }
        }
        window.closePolicyManagerModal = closePolicyManagerModal;

        async function loadWebRtcExtensionPolicies() {
            const tbody = document.getElementById('policyManagerTbody');
            if (!tbody) return;
            try {
                const res = await fetch('/api/extension-policies');
                const data = await res.json();
                if (!data.success || !data.policies || data.policies.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-zinc-500">No WebRTC extensions found.</td></tr>';
                    return;
                }
                tbody.innerHTML = '';
                const isAr = document.documentElement.getAttribute('dir') === 'rtl';

                data.policies.forEach(p => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-zinc-800/30 transition';
                    tr.innerHTML = `
                        <td class="py-2.5 px-3.5 align-middle whitespace-nowrap">
                            <div class="flex items-center gap-1.5 font-mono font-bold text-white text-sm">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shrink-0"></span>
                                <span>${p.extension}</span>
                            </div>
                        </td>
                        <td class="py-2.5 px-3.5 font-semibold text-zinc-300 align-middle whitespace-nowrap">${p.name || 'Ext ' + p.extension}</td>
                        <td class="py-2.5 px-3.5 align-middle">
                            <div class="w-full min-w-[170px]">
                                <select id="policyAuto_${p.extension}" name="policy_auto_${p.extension}" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg text-xs font-semibold px-2 py-1 text-[var(--text-primary)] w-full policy-auto-${p.extension}">
                                    <option value="user_choice" ${p.auto_answer === 'user_choice' ? 'selected' : ''}>${isAr ? 'حر (اختيار الموظف)' : 'User Controlled'}</option>
                                    <option value="force_on" ${p.auto_answer === 'force_on' ? 'selected' : ''}>${isAr ? '[مقفل] إجباري مفعل (قفل)' : '[Locked] ON (Force)'}</option>
                                    <option value="force_off" ${p.auto_answer === 'force_off' ? 'selected' : ''}>${isAr ? '[مقفل] إجباري معطل (ممنوع)' : '[Locked] OFF (Prohibit)'}</option>
                                </select>
                            </div>
                        </td>
                        <td class="py-2.5 px-3.5 align-middle">
                            <div class="w-full min-w-[170px]">
                                <select id="policyDnd_${p.extension}" name="policy_dnd_${p.extension}" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg text-xs font-semibold px-2 py-1 text-[var(--text-primary)] w-full policy-dnd-${p.extension}">
                                    <option value="user_choice" ${p.dnd === 'user_choice' ? 'selected' : ''}>${isAr ? 'حر (اختيار الموظف)' : 'User Controlled'}</option>
                                    <option value="force_on" ${p.dnd === 'force_on' ? 'selected' : ''}>${isAr ? '[مقفل] إجباري مفعل (قفل)' : '[Locked] ON (Force)'}</option>
                                    <option value="force_off" ${p.dnd === 'force_off' ? 'selected' : ''}>${isAr ? '[مقفل] إجباري معطل (ممنوع)' : '[Locked] OFF (Prohibit)'}</option>
                                </select>
                            </div>
                        </td>
                        <td class="py-2.5 px-3.5 align-middle">
                            <div class="w-full min-w-[190px]">
                                <select id="policyCancel_${p.extension}" name="policy_cancel_${p.extension}" class="bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-lg text-xs font-semibold px-2 py-1 text-[var(--text-primary)] w-full policy-cancel-${p.extension}">
                                    <option value="0" ${!p.disable_outbound_ringing_cancel ? 'selected' : ''}>${isAr ? 'مسموح الإنهاء' : 'Allow Cancel'}</option>
                                    <option value="1" ${p.disable_outbound_ringing_cancel ? 'selected' : ''}>${isAr ? '[مقفل] ممنوع الإنهاء أثناء الرنين' : '[Locked] Block Cancel'}</option>
                                </select>
                            </div>
                        </td>
                        <td class="py-2.5 px-3.5 text-end align-middle whitespace-nowrap">
                            <button type="button" onclick="saveWebRtcPolicy('${p.extension}', this)" class="btn-ghost py-1 px-3 text-xs text-emerald-400 hover:text-emerald-300 hover:border-emerald-500/50 cursor-pointer">
                                ${isAr ? 'حفظ' : 'Save'}
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-red-400">Failed to load WebRTC extension policies.</td></tr>';
            }
        }
        window.loadWebRtcExtensionPolicies = loadWebRtcExtensionPolicies;

        async function saveWebRtcPolicy(ext, btn) {
            const autoSelect = document.querySelector(`.policy-auto-${ext}`);
            const dndSelect = document.querySelector(`.policy-dnd-${ext}`);
            const cancelSelect = document.querySelector(`.policy-cancel-${ext}`);
            if (!autoSelect || !dndSelect) return;
            const isAr = document.documentElement.getAttribute('dir') === 'rtl';
            if (btn) setButtonLoading(btn, true, isAr ? 'حفظ...' : 'Save...');

            try {
                const res = await fetch(`/api/extension-policies/${ext}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        auto_answer: autoSelect.value,
                        dnd: dndSelect.value,
                        disable_outbound_ringing_cancel: cancelSelect ? parseInt(cancelSelect.value, 10) : 0
                    })
                });
                const data = await res.json();
                const statusEl = document.getElementById('policyModalStatus');
                if (data.success) {
                    if (statusEl) {
                        statusEl.textContent = `Policy updated for Ext ${ext}`;
                        setTimeout(() => { statusEl.textContent = ''; }, 3000);
                    }
                    if (typeof fetchExtensions === 'function') fetchExtensions();
                } else {
                    if (statusEl) {
                        statusEl.textContent = data.error || 'Error saving policy';
                        statusEl.className = 'text-xs font-bold text-red-400';
                        setTimeout(() => { statusEl.textContent = ''; statusEl.className = 'text-xs font-bold text-emerald-400'; }, 3000);
                    }
                }
            } catch (e) {
                console.error(e);
            } finally {
                if (btn) setButtonLoading(btn, false);
            }
        }
        window.saveWebRtcPolicy = saveWebRtcPolicy;

        async function applyBulkPolicies(btn) {
            const autoVal = document.getElementById('bulkAutoAnswer').value;
            const dndVal = document.getElementById('bulkDnd').value;
            const cancelVal = document.getElementById('bulkCancel').value;
            if (!autoVal && !dndVal && !cancelVal) return;
            const isAr = document.documentElement.getAttribute('dir') === 'rtl';
            if (btn) setButtonLoading(btn, true, isAr ? 'جاري التطبيق...' : 'Applying...');

            try {
                const res = await fetch('/api/extension-policies-bulk', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        auto_answer: autoVal || undefined,
                        dnd: dndVal || undefined,
                        disable_outbound_ringing_cancel: cancelVal ? parseInt(cancelVal, 10) : undefined
                    })
                });
                const data = await res.json();
                const statusEl = document.getElementById('policyModalStatus');
                if (data.success) {
                    if (statusEl) {
                        statusEl.textContent = `Bulk policy applied to ${data.count} WebRTC extension(s)`;
                        setTimeout(() => { statusEl.textContent = ''; }, 3000);
                    }
                    loadWebRtcExtensionPolicies();
                }
            } catch (e) {
                console.error(e);
            } finally {
                if (btn) setButtonLoading(btn, false);
            }
        }
        window.applyBulkPolicies = applyBulkPolicies;

        // ==========================================
        // CALL CONTROL CODES (FEATURE CODES) TAB
        // ==========================================
        let configCallCodesList = [];
        let activeConfigCallCodesCat = 'all';

        async function fetchConfigCallCodes() {
            try {
                const res = await fetch('/api/telephony/call-codes');
                if (!res.ok) return;
                const data = await res.json();
                if (data.success && Array.isArray(data.codes)) {
                    configCallCodesList = data.codes;
                    const pillCount = document.getElementById('cfgCallCodesPillCount');
                    if (pillCount) pillCount.textContent = configCallCodesList.length;
                    updateConfigCategoryCounts();
                    renderConfigCallCodesList();
                }
            } catch (err) {
                console.warn('Error fetching call codes:', err.message);
            }
        }
        window.fetchConfigCallCodes = fetchConfigCallCodes;

        function updateConfigCategoryCounts() {
            const countEl = (id, count) => {
                const el = document.getElementById(id);
                if (el) el.textContent = count;
            };
            countEl('cfg-cat-count-all', configCallCodesList.length);
            countEl('cfg-cat-count-incall', configCallCodesList.filter(c => c.cat === 'incall').length);
            countEl('cfg-cat-count-campon', configCallCodesList.filter(c => c.cat === 'campon').length);
            countEl('cfg-cat-count-spy', configCallCodesList.filter(c => c.cat === 'spy').length);
            countEl('cfg-cat-count-intercom', configCallCodesList.filter(c => c.cat === 'intercom').length);
            countEl('cfg-cat-count-parking', configCallCodesList.filter(c => c.cat === 'parking').length);
            countEl('cfg-cat-count-forward', configCallCodesList.filter(c => c.cat === 'forward').length);
            countEl('cfg-cat-count-diagnostics', configCallCodesList.filter(c => c.cat === 'diagnostics').length);
        }

        function setConfigCallCodesCategory(cat) {
            activeConfigCallCodesCat = cat || 'all';
            const activeClass = 'cfg-call-code-cat-btn shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap cursor-pointer bg-rose-500/20 text-rose-300 border border-rose-500/40 shadow-md';
            const inactiveClass = 'cfg-call-code-cat-btn shrink-0 inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap cursor-pointer bg-[var(--bg-card)] hover:bg-[var(--bg-hover)] border border-[var(--border-primary)] shadow-sm';
            document.querySelectorAll('.cfg-call-code-cat-btn').forEach(btn => {
                const bCat = btn.getAttribute('data-cat');
                btn.className = (bCat === activeConfigCallCodesCat) ? activeClass : inactiveClass;
            });
            renderConfigCallCodesList();
        }
        window.setConfigCallCodesCategory = setConfigCallCodesCategory;

        function filterConfigCallCodesList() {
            renderConfigCallCodesList();
        }
        window.filterConfigCallCodesList = filterConfigCallCodesList;

        function clearConfigCallCodesSearch() {
            const input = document.getElementById('cfgCallCodesSearchInput');
            if (input) {
                input.value = '';
                input.focus();
                renderConfigCallCodesList();
            }
        }
        window.clearConfigCallCodesSearch = clearConfigCallCodesSearch;

        function renderConfigCallCodesList() {
            const query = (document.getElementById('cfgCallCodesSearchInput')?.value || '').toLowerCase().trim();
            const clearBtn = document.getElementById('cfgClearCallCodesSearchBtn');
            if (clearBtn) clearBtn.classList.toggle('hidden', !query);

            const grid = document.getElementById('cfgCallCodesGrid');
            const emptyState = document.getElementById('cfgCallCodesEmptyState');
            const countBadge = document.getElementById('cfgCallCodesCountBadge');
            if (!grid) return;

            const isAr = document.documentElement.dir === 'rtl';

            const filtered = configCallCodesList.filter(item => {
                if (activeConfigCallCodesCat !== 'all' && item.cat !== activeConfigCallCodesCat) {
                    return false;
                }
                if (!query) return true;
                const exampleText = isAr ? (item.example_ar || item.example || '') : (item.example_en || item.example || '');
                return (
                    (item.code && item.code.toLowerCase().includes(query)) ||
                    (item.name_en && item.name_en.toLowerCase().includes(query)) ||
                    (item.name_ar && item.name_ar.toLowerCase().includes(query)) ||
                    (item.desc_en && item.desc_en.toLowerCase().includes(query)) ||
                    (item.desc_ar && item.desc_ar.toLowerCase().includes(query)) ||
                    exampleText.toLowerCase().includes(query)
                );
            });

            if (countBadge) {
                countBadge.textContent = filtered.length + ' ' + (isAr ? 'كود' : (filtered.length === 1 ? 'code' : 'codes'));
            }

            if (filtered.length === 0) {
                grid.innerHTML = '';
                if (emptyState) emptyState.classList.remove('hidden');
                return;
            }

            if (emptyState) emptyState.classList.add('hidden');

            grid.innerHTML = filtered.map(item => {
                const title = isAr ? item.name_ar : item.name_en;
                const subTitle = isAr ? item.name_en : item.name_ar;
                const desc = isAr ? item.desc_ar : item.desc_en;
                const example = isAr ? (item.example_ar || item.example) : (item.example_en || item.example);

                let timingBadge = '';
                if (item.timing === 'incall') {
                    timingBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-500/15 text-rose-300 border border-rose-500/30 whitespace-nowrap">' + (isAr ? 'أثناء المكالمة' : 'In-Call DTMF') + '</span>';
                } else if (item.timing === 'busy') {
                    timingBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-500/15 text-purple-300 border border-purple-500/30 whitespace-nowrap">' + (isAr ? 'نغمة المشغول' : 'When Busy') + '</span>';
                } else {
                    timingBadge = '<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-500/15 text-sky-300 border border-sky-500/30 whitespace-nowrap">' + (isAr ? 'طلب مباشر' : 'Direct Dial') + '</span>';
                }

                let statusBadges = '';
                if (item.is_custom) {
                    statusBadges += '<span class="text-[9px] font-bold font-mono px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 border border-amber-500/30 uppercase tracking-wider">' + (isAr ? 'مخصص' : 'Custom') + '</span>';
                }
                if (item.enabled === false) {
                    statusBadges += '<span class="text-[9px] font-bold font-mono px-1.5 py-0.5 rounded bg-zinc-500/20 text-zinc-400 border border-zinc-500/30 uppercase tracking-wider ' + (statusBadges ? 'ml-1' : '') + '">' + (isAr ? 'معطل' : 'Disabled') + '</span>';
                }

                const dialBtn = (item.dial && item.enabled !== false) ? `
                    <button type="button" onclick="dialConfigCallCode('${item.code}')" class="px-2 py-1 text-[11px] font-black bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 rounded-lg transition flex items-center gap-1 cursor-pointer shadow-sm" title="${isAr ? 'اتصال الآن' : 'Dial Now'}">
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1.1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                        <span>${isAr ? 'اتصال' : 'Dial'}</span>
                    </button>
                ` : '';

                const editBtn = `
                    <button type="button" onclick="openConfigCallCodeModal('${item.id}')" class="px-2 py-1 text-[11px] font-black bg-rose-300 hover:bg-rose-200 border border-rose-400 rounded-lg transition flex items-center gap-1 cursor-pointer shadow-sm" title="${isAr ? 'تعديل وتخصيص هذا الكود' : 'Configure this code'}">
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                        <span>${isAr ? 'تعديل' : 'Edit'}</span>
                    </button>
                `;

                const isDimmed = item.enabled === false;
                const cardBorder = isDimmed ? 'border-zinc-700/50 opacity-60' : (item.is_custom ? 'border-amber-500/40' : 'border-[var(--border-primary)] hover:border-rose-500/40');

                return `
                    <div class="bg-[var(--bg-card)] border ${cardBorder} rounded-xl p-3 flex flex-col justify-between transition-all group">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-1.5 flex-wrap">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <span class="font-mono font-black text-sm text-rose-400 bg-rose-500/15 px-2.5 py-0.5 rounded-lg border border-rose-500/30 tracking-wider select-all shadow-sm">${item.code}</span>
                                    ${timingBadge}
                                    ${statusBadges}
                                </div>
                                <div class="flex items-center gap-1">
                                    ${editBtn}
                                    ${dialBtn}
                                    <button type="button" onclick="copyConfigCallCode('${item.code}', this)" class="px-2 py-1 text-[11px] font-black bg-zinc-200 hover:bg-white border border-zinc-300 rounded-lg transition flex items-center gap-1 cursor-pointer shadow-sm" title="${isAr ? 'نسخ الكود' : 'Copy Code'}">
                                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                        <span>${isAr ? 'نسخ' : 'Copy'}</span>
                                    </button>
                                </div>
                            </div>
                            <h4 class="text-xs sm:text-sm font-extrabold text-[var(--text-primary)] leading-tight mb-0.5">${title}</h4>
                            <div class="text-[10px] text-[var(--text-muted)] font-medium mb-1.5">${subTitle}</div>
                            <p class="text-[11px] text-[var(--text-secondary)] leading-relaxed">${desc}</p>
                        </div>
                        <div class="mt-2.5 pt-2 border-t border-[var(--border-primary)]/50 flex items-center justify-between text-[10px] font-mono text-[var(--text-muted)]">
                            <span>${isAr ? 'طريقة الطلب:' : 'Example:'} <span class="text-zinc-300 font-bold">${example}</span></span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function copyConfigCallCode(text, btnEl) {
            if (!text) return;
            const isAr = document.documentElement.dir === 'rtl';
            const clean = String(text).split(' ')[0].trim();
            navigator.clipboard.writeText(clean).then(() => {
                if (btnEl) {
                    const originalHTML = btnEl.innerHTML;
                    btnEl.innerHTML = '<span>' + (isAr ? 'تم النسخ' : 'Copied!') + '</span>';
                    setTimeout(() => { btnEl.innerHTML = originalHTML; }, 1200);
                }
                showToast(isAr ? 'تم نسخ الكود للحافظة' : 'Code copied to clipboard', 'success');
            }).catch(() => {});
        }
        window.copyConfigCallCode = copyConfigCallCode;

        function dialConfigCallCode(code) {
            if (!code) return;
            const clean = String(code).split(' ')[0].trim();
            window.location.href = 'sip:' + clean;
        }
        window.dialConfigCallCode = dialConfigCallCode;

        function openConfigCallCodeModal(id) {
            const item = configCallCodesList.find(c => c.id === id);
            if (!item) return;

            const isAr = document.documentElement.dir === 'rtl';
            document.getElementById('cfgEditCallCodeId').value = item.id;
            document.getElementById('cfgCallCodeModalTitle').textContent = isAr ? item.name_ar : item.name_en;
            document.getElementById('cfgCallCodeModalSubtitle').textContent = isAr ? item.name_en : item.name_ar;
            document.getElementById('cfgEditCallCodeInput').value = item.code;
            document.getElementById('cfgEditCallCodeDefaultBadge').textContent = (isAr ? 'الافتراضي: ' : 'Default: ') + item.default_code;
            document.getElementById('cfgEditCallCodeExampleInput').value = (isAr ? item.example_ar : item.example_en) || item.example || '';
            document.getElementById('cfgEditCallCodeEnabled').checked = (item.enabled !== false);

            openModal('callCodeModal');
            setTimeout(() => document.getElementById('cfgEditCallCodeInput')?.focus(), 100);
        }
        window.openConfigCallCodeModal = openConfigCallCodeModal;

        function revertConfigCallCodeToDefault() {
            const id = document.getElementById('cfgEditCallCodeId').value;
            const item = configCallCodesList.find(c => c.id === id);
            if (item && item.default_code) {
                document.getElementById('cfgEditCallCodeInput').value = item.default_code;
                document.getElementById('cfgEditCallCodeEnabled').checked = true;
            }
        }
        window.revertConfigCallCodeToDefault = revertConfigCallCodeToDefault;

        async function saveConfigCallCodeEdit() {
            const id = document.getElementById('cfgEditCallCodeId').value;
            const newCode = document.getElementById('cfgEditCallCodeInput').value.trim();
            const example = document.getElementById('cfgEditCallCodeExampleInput').value.trim();
            const enabled = document.getElementById('cfgEditCallCodeEnabled').checked;
            const isAr = document.documentElement.dir === 'rtl';

            if (!newCode) {
                showToast(isAr ? 'لا يمكن ترك الكود فارغاً' : 'Code cannot be empty', 'error');
                return;
            }

            const saveBtn = document.getElementById('btnSaveCfgCallCodeEdit');
            if (saveBtn) setButtonLoading(saveBtn, true, isAr ? 'جاري التطبيق...' : 'Applying...');

            try {
                const res = await fetch('/api/telephony/call-codes/' + encodeURIComponent(id), {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        code: newCode,
                        enabled,
                        example_en: isAr ? undefined : example,
                        example_ar: isAr ? example : undefined
                    })
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Failed to update code');
                }

                closeModal('callCodeModal');
                showToast(isAr ? 'تم تحديث الكود وتطبيقه في أستيركس بنجاح' : 'Call code updated and applied to Asterisk', 'success');
                fetchConfigCallCodes();
            } catch (err) {
                showToast(err.message, 'error');
            } finally {
                if (saveBtn) setButtonLoading(saveBtn, false);
            }
        }
        window.saveConfigCallCodeEdit = saveConfigCallCodeEdit;

        async function confirmResetAllConfigCallCodes() {
            const isAr = document.documentElement.dir === 'rtl';
            const msg = isAr ? 'هل أنت متأكد من رغبتك في استعادة كافة أكواد أستيركس إلى القيم الافتراضية الأولية؟' : 'Are you sure you want to reset all Asterisk call control codes back to factory defaults?';
            if (!confirm(msg)) return;

            try {
                const res = await fetch('/api/telephony/call-codes/reset-defaults', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();
                if (!res.ok || !data.success) {
                    throw new Error(data.error || 'Failed to reset call codes');
                }

                showToast(isAr ? 'تم استعادة كافة الأكواد الافتراضية بنجاح' : 'All call codes reset to factory defaults', 'success');
                fetchConfigCallCodes();
            } catch (err) {
                showToast(err.message, 'error');
            }
        }
        window.confirmResetAllConfigCallCodes = confirmResetAllConfigCallCodes;

        // --- 2. RING GROUPS ---
        document.addEventListener('DOMContentLoaded', () => {
            const rgNumEl = document.getElementById('rgNum');
            if (rgNumEl) {
                rgNumEl.addEventListener('input', () => {
                    const isEdit = document.getElementById('rgEditMode').value === "true";
                    if (!isEdit) {
                        const num = rgNumEl.value.trim() || '600';
                        const destVal = `ext-group,${num},1`;
                        const noticeNumEl = document.getElementById('rgPostDestCreateNoticeNum');
                        if (noticeNumEl) noticeNumEl.textContent = destVal;
                        document.getElementById('rgPostDestination').value = destVal;
                    }
                });
            }
        });
        function renderQuickPickPills() {
            const container = document.getElementById('rgQuickPickContainer');
            if (!container) return;
            container.innerHTML = '';

            const currentSelected = parseRgListArray();

            // 1. Local extensions
            (loadedExtensionsList || []).forEach(ext => {
                const extStr = String(ext.extension);
                const isSelected = currentSelected.includes(extStr);
                const pill = document.createElement('div');
                pill.className = `ext-pill text-xs px-2.5 py-1 rounded-lg border font-mono font-bold cursor-pointer transition-all ${isSelected ? 'active bg-emerald-500/20 text-emerald-400 border-emerald-500/40' : 'bg-[var(--bg-secondary)] text-[var(--text-secondary)] border-[var(--border-primary)] hover:border-emerald-500/40'}`;
                pill.textContent = `${ext.extension} (${ext.name || 'Ext'})`;
                pill.onclick = () => toggleQuickPickExt(extStr);
                container.appendChild(pill);
            });

            // 2. Remote federation extensions
            (loadedRemoteExtensionsList || []).forEach(re => {
                const peer = (loadedFederationPeersList || []).find(p => Number(p.id) === Number(re.peer_id));
                const peerLabel = peer ? (peer.node_name || 'Site ' + peer.site_code) : 'Remote';
                const targetDial = `${re.dial_alias}#`;
                const isSelected = currentSelected.includes(targetDial) || currentSelected.includes(String(re.dial_alias));
                const pill = document.createElement('div');
                pill.className = `ext-pill text-xs px-2.5 py-1 rounded-lg border font-mono font-bold cursor-pointer transition-all ${isSelected ? 'active bg-purple-500/20 text-purple-400 border-purple-500/40' : 'bg-purple-500/5 text-purple-300 border-purple-500/20 hover:border-purple-500/40'}`;
                pill.textContent = `[${peerLabel}] ${re.native_extension} (${re.display_name || ''}) #${re.dial_alias}`;
                pill.onclick = () => toggleQuickPickExt(targetDial);
                container.appendChild(pill);
            });

            if (container.children.length === 0) {
                container.innerHTML = '<span class="text-[11px] text-[var(--text-muted)]">No extensions available.</span>';
            }
        }

        function parseRgListArray() {
            const val = document.getElementById('rgList').value || '';
            return val.split(/[\s\-,]+/).map(s => s.trim()).filter(Boolean);
        }

        function toggleQuickPickExt(extNum) {
            let list = parseRgListArray();
            if (list.includes(extNum)) {
                list = list.filter(e => e !== extNum);
            } else {
                list.push(extNum);
            }
            document.getElementById('rgList').value = list.join(', ');
            renderQuickPickPills();
        }

        function clearQuickPickExts() {
            document.getElementById('rgList').value = '';
            renderQuickPickPills();
        }

        function populateAnnouncementsDropdown(desiredValue) {
            const sel = document.getElementById('rgAnnMsg');
            if (!sel) return;

            // Same trap as the queue dialog: this runs again after the async
            // recording list arrives, so the saved id must be restored instead of
            // falling back to "None".
            const keep = (desiredValue !== undefined && desiredValue !== null && String(desiredValue).trim() !== '')
                ? String(desiredValue).trim()
                : String(sel.value || '0').trim();

            sel.innerHTML = '<option value="0">None / No Announcement</option>';
            (loadedRecordingsList || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = `${r.displayname} (ID: ${r.id})`;
                sel.appendChild(opt);
            });

            if (keep !== '0' && !Array.from(sel.options).some(o => String(o.value) === keep)) {
                const opt = document.createElement('option');
                opt.value = keep;
                opt.textContent = (isRtl ? 'تسجيل محذوف' : 'Missing recording') + ` (ID: ${keep})`;
                sel.appendChild(opt);
            }

            sel.value = keep;
            if (String(sel.value) !== keep) sel.value = '0';
            if (typeof window.syncConfigDropdownTrigger === 'function') {
                window.syncConfigDropdownTrigger(sel);
            }
        }

        function syncRingGroupModalSelects() {
            if (typeof window.syncConfigDropdownTrigger !== 'function') return;
            ['rgStrategy', 'rgRinging', 'rgAnnMsg'].forEach(id => {
                const el = document.getElementById(id);
                if (el) window.syncConfigDropdownTrigger(el);
            });
        }

        function populateMohRingGroupDropdown() {
            const sel = document.getElementById('rgRinging');
            if (!sel) return;
            const currentVal = sel.value || 'Ring';
            sel.innerHTML = `<option value="Ring">${isRtl ? 'نغمة الرنين (افتراضي)' : 'Ring (Default Ringtone)'}</option>`;
            const mohList = typeof loadedMohCategories !== 'undefined' ? loadedMohCategories : [];
            mohList.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.name;
                opt.textContent = `${isRtl ? 'موسيقى الانتظار:' : 'Music on Hold:'} ${cat.name}${cat.fileCount !== undefined ? ` (${cat.fileCount} ${isRtl ? 'مقاطع' : 'tracks'})` : ''}`;
                sel.appendChild(opt);
            });
            sel.value = currentVal;
        }

        function fetchRingGroups() {
            const tbody = document.getElementById('ringgroups-table-body');
            return fetch('/api/config/ringgroups')
                .then(res => {
                    if (res.status === 401) { window.location.href = '/login'; throw new Error('Unauthorized'); }
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    loadedRingGroupsList = Array.isArray(data.ringgroups) ? data.ringgroups : [];
                    const list = loadedRingGroupsList;
                    if (!tbody) return;
                    tbody.innerHTML = '';
                    if (list.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="10" class="py-6 text-center text-[var(--text-muted)]">' + (isRtl ? 'لا توجد مجموعات اتصال.' : 'No ring groups found.') + '</td></tr>';
                        return;
                    }
                    list.forEach(rg => {
                        const tr = document.createElement('tr');
                        tr.className = 'hover:bg-[var(--bg-hover)] transition-colors';
                        const recMatch = (loadedRecordingsList || []).find(r => r.id == rg.annmsg_id);
                        const annText = recMatch ? recMatch.displayname : (rg.annmsg_id ? 'ID #' + rg.annmsg_id : 'None');
                        const mohDisplay = (!rg.ringing || rg.ringing === 'Ring')
                            ? `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-slate-500/15 text-slate-400 border border-slate-500/20">Ring</span>`
                            : `<span class="px-2 py-0.5 text-[11px] font-bold rounded bg-amber-500/15 text-amber-300 border border-amber-500/20 truncate max-w-[120px] inline-block align-middle" title="MoH: ${rg.ringing}">MoH: ${rg.ringing}</span>`;

                        tr.innerHTML = `
                            <td class="py-3 px-4 font-mono font-bold text-[var(--text-primary)]">${rg.grpnum}</td>
                            <td class="py-3 px-4 font-bold text-[var(--text-primary)]">${rg.description || '-'}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${rg.strategy || 'ringall'}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${annText}</td>
                            <td class="py-3 px-4">${mohDisplay}</td>
                            <td class="py-3 px-4 font-mono text-xs text-[var(--text-secondary)]">${rg.grplist}</td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded text-emerald-400">Yes</span></td>
                            <td class="py-3 px-4"><span class="px-2 py-0.5 text-[11px] font-bold rounded text-purple-400">Always</span></td>
                            <td class="py-3 px-4 font-mono text-xs text-blue-400 font-bold">${formatDestination(rg.postdest)}</td>
                            <td class="py-3 px-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button type="button" onclick="editRingGroup('${rg.grpnum}')" class="px-2.5 py-1 text-xs font-semibold text-blue-400 hover:bg-blue-500/10 rounded border border-blue-500/30 cursor-pointer"><span>${isRtl ? 'تعديل' : 'Edit'}</span></button>
                                    <button type="button" onclick="deleteRingGroup('${rg.grpnum}')" class="px-2.5 py-1 text-xs font-semibold text-red-400 hover:bg-red-500/10 rounded border border-red-500/30 cursor-pointer"><span>${isRtl ? 'حذف' : 'Delete'}</span></button>
                                </div>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                })
                .catch(err => console.error(err));
        }

        function getNextAvailableRingGroupNum() {
            const existingNums = new Set((loadedRingGroupsList || []).map(rg => String(rg.grpnum)));
            let candidate = 600;
            while (existingNums.has(String(candidate))) {
                candidate++;
            }
            return String(candidate);
        }

        function openRingGroupModal() {
            openModal('ringGroupModal');
            document.getElementById('rgModalTitle').textContent = isRtl ? 'إضافة مجموعة جديدة' : 'Add Ring Group';
            document.getElementById('rgEditMode').value = "false";
            document.getElementById('rgNum').disabled = false;
            document.getElementById('ringGroupForm').reset();

            const num = getNextAvailableRingGroupNum();
            document.getElementById('rgNum').value = num;

            populateAnnouncementsDropdown(0);
            populateMohRingGroupDropdown();
            document.getElementById('rgRinging').value = 'Ring';
            syncRingGroupModalSelects();
            renderQuickPickPills();

            const destVal = `ext-group,${num},1`;
            document.getElementById('rgPostDestination').value = destVal;
            const noticeNumEl = document.getElementById('rgPostDestCreateNoticeNum');
            if (noticeNumEl) noticeNumEl.textContent = destVal;

            initDestinationSelectInstances();
            if (rgPostDestSelectInstance) rgPostDestSelectInstance.setDialplan(destVal);
            if (typeof ensureAllConfigListsLoaded === 'function') {
                ensureAllConfigListsLoaded().then(() => {
                    populateAnnouncementsDropdown(0);
                    populateMohRingGroupDropdown();
                    syncRingGroupModalSelects();
                    renderQuickPickPills();
                    if (rgPostDestSelectInstance) rgPostDestSelectInstance.setDialplan(destVal);
                }).catch(() => {});
            }
        }

        function editRingGroup(grpnum) {
            openModal('ringGroupModal');
            const rg = (loadedRingGroupsList || []).find(g => String(g.grpnum) === String(grpnum));
            if (!rg) {
                openRingGroupModal();
                return;
            }

            document.getElementById('rgModalTitle').textContent = (isRtl ? 'تعديل المجموعة ' : 'Edit Ring Group ') + grpnum;
            document.getElementById('rgEditMode').value = "true";
            document.getElementById('rgNum').value = grpnum;
            document.getElementById('rgNum').disabled = true;
            document.getElementById('rgDesc').value = rg.description || '';
            document.getElementById('rgStrategy').value = rg.strategy || 'ringall';
            document.getElementById('rgTime').value = rg.grptime || 20;
            document.getElementById('rgList').value = rg.grplist || '';
            const rgAnnMsgId = parseInt(rg.annmsg_id, 10) || 0;
            populateAnnouncementsDropdown(rgAnnMsgId);
            populateMohRingGroupDropdown();
            document.getElementById('rgAnnMsg').value = String(rgAnnMsgId);
            document.getElementById('rgRinging').value = rg.ringing || 'Ring';
            syncRingGroupModalSelects();
            renderQuickPickPills();

            const destVal = rg.postdest || `ext-group,${grpnum},1`;
            document.getElementById('rgPostDestination').value = destVal;

            initDestinationSelectInstances();
            if (rgPostDestSelectInstance) rgPostDestSelectInstance.setDialplan(destVal);
            if (typeof ensureAllConfigListsLoaded === 'function') {
                ensureAllConfigListsLoaded().then(() => {
                    populateAnnouncementsDropdown(rgAnnMsgId);
                    populateMohRingGroupDropdown();
                    syncRingGroupModalSelects();
                    renderQuickPickPills();
                    if (rgPostDestSelectInstance) rgPostDestSelectInstance.setDialplan(destVal);
                }).catch(() => {});
            }
        }


        function saveRingGroup(e) {
            e.preventDefault();
            const isEdit = document.getElementById('rgEditMode').value === "true";
            const grpnum = document.getElementById('rgNum').value.trim();
            const description = document.getElementById('rgDesc').value.trim();
            const strategy = document.getElementById('rgStrategy').value;
            const grptime = document.getElementById('rgTime').value;
            const grplist = document.getElementById('rgList').value.trim();
            const annmsg_id = document.getElementById('rgAnnMsg').value;
            const ringing = document.getElementById('rgRinging').value;

            if (!grpnum || !/^\d+$/.test(grpnum)) {
                showToast(isRtl ? 'يرجى إدخال رقم مجموعة اتصال صحيح' : 'Please enter a valid numeric Ring Group number.', 'error');
                return;
            }
            if (!description) {
                showToast(isRtl ? 'يرجى إدخال وصف للمجموعة' : 'Please enter a Group Description.', 'error');
                return;
            }
            if (!grplist) {
                showToast(isRtl ? 'يرجى تحديد أو كتابة رقم تحويلة واحد على الأقل' : 'Please enter or select at least one Extension.', 'error');
                return;
            }
            if (!isEdit) {
                if (loadedRingGroupsList && (loadedRingGroupsList || []).some(rg => String(rg.grpnum) === String(grpnum))) {
                    showToast((isRtl ? 'رقم مجموعة الاتصال ' : 'Ring Group ') + grpnum + (isRtl ? ' موجود بالفعل. يرجى اختيار رقم آخر.' : ' already exists. Please choose a different number.'), 'error');
                    return;
                }
                const extMatch = (loadedExtensionsList || []).find(ext => String(ext.extension) === String(grpnum));
                if (extMatch) {
                    showToast(isRtl ? `الرقم ${grpnum} مستخدم بالفعل لتحويلة (${extMatch.name || grpnum}). غير مسموح بتكرار الأرقام.` : `Cannot create: Number ${grpnum} is already in use by Extension "${extMatch.name || grpnum}". Duplicate numbers are strictly restricted.`, 'error');
                    return;
                }
                const qMatch = (loadedQueuesList || []).find(q => String(q.extension) === String(grpnum));
                if (qMatch) {
                    showToast(isRtl ? `الرقم ${grpnum} مستخدم بالفعل لطابور (${qMatch.descr || grpnum}). غير مسموح بتكرار الأرقام.` : `Cannot create: Number ${grpnum} is already in use by Queue "${qMatch.descr || grpnum}". Duplicate numbers are strictly restricted.`, 'error');
                    return;
                }
            }

            const postdest = isEdit ? document.getElementById('rgPostDestination').value.trim() : (`ext-group,${grpnum},1`);

            const url = isEdit ? '/api/config/ringgroups/' + grpnum : '/api/config/ringgroups';
            const method = isEdit ? 'PUT' : 'POST';
            const submitBtn = e.target ? (e.target.matches('button') ? e.target : e.target.querySelector('button[type="submit"]')) : null;
            if (submitBtn) setButtonLoading(submitBtn, true);

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ grpnum, description, strategy, grptime, grplist, annmsg_id, ringing, postdest })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    closeModal('ringGroupModal');
                    fetchRingGroups();
                } else showToast(data.error, 'error');
            })
            .catch(err => {
                showToast(err.message || 'Request failed', 'error');
            })
            .finally(() => {
                if (submitBtn) setButtonLoading(submitBtn, false);
            });
        }
        async function deleteRingGroup(grpnum) {
            const ok = await window.sokratConfirm({
                title: isRtl ? 'حذف مجموعة الاتصال' : 'Delete Ring Group',
                message: isRtl ? `هل أنت متأكد من حذف مجموعة الاتصال ${grpnum}؟` : `Are you sure you want to delete ring group ${grpnum}?`,
                confirmText: isRtl ? 'حذف' : 'Delete',
                type: 'danger'
            });
            if (!ok) return;
            fetch('/api/config/ringgroups/' + grpnum, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        fetchRingGroups();
                    } else showToast(data.error, 'error');
                })
                .catch(err => showToast(err.message || 'Failed to delete ring group', 'error'));
        }
        window.openRingGroupModal = openRingGroupModal;
        window.editRingGroup = editRingGroup;
        window.deleteRingGroup = deleteRingGroup;
        window.saveRingGroup = saveRingGroup;
        window.fetchRingGroups = fetchRingGroups;
        window.getNextAvailableRingGroupNum = getNextAvailableRingGroupNum;
        window.clearQuickPickExts = clearQuickPickExts;
        window.toggleQuickPickExt = toggleQuickPickExt;
        window.renderQuickPickPills = renderQuickPickPills;
        window.populateAnnouncementsDropdown = populateAnnouncementsDropdown;
        window.populateMohRingGroupDropdown = populateMohRingGroupDropdown;

        // --- 2.5 QUEUES MANAGEMENT JS ---
        function renderQueueAgentChecklist() {
            const container = document.getElementById('queueAgentsChecklistContainer');
            if (!container) return;
            container.innerHTML = '';

            const currentStatic = parseQueueExtArray('queueStaticList');
            const currentDyn = parseQueueExtArray('queueDynList');
            const filterTerm = (document.getElementById('queueAgentSearch')?.value || '').toLowerCase().trim();

            const allAgentsToRender = [];

            // 1. Local extensions
            (loadedExtensionsList || []).forEach(ext => {
                allAgentsToRender.push({
                    extStr: String(ext.extension),
                    nameStr: String(ext.name || 'Ext'),
                    badgeLabel: null,
                    isRemote: false
                });
            });

            // 2. Remote federation extensions
            (loadedRemoteExtensionsList || []).forEach(re => {
                const peer = (loadedFederationPeersList || []).find(p => Number(p.id) === Number(re.peer_id));
                const peerLabel = peer ? (peer.node_name || 'Site ' + peer.site_code) : 'Remote';
                allAgentsToRender.push({
                    extStr: String(re.dial_alias),
                    nameStr: `[${peerLabel}] ${re.display_name || re.native_extension}`,
                    badgeLabel: `#${peer ? peer.site_code : ''}`,
                    isRemote: true
                });
            });

            if (allAgentsToRender.length === 0) {
                container.innerHTML = `<span class="text-xs text-[var(--text-muted)] italic">${isRtl ? 'لا توجد تحويلات مسجلة بالمجمّع' : 'No extensions found.'}</span>`;
                return;
            }

            allAgentsToRender.forEach(agent => {
                if (filterTerm && !agent.extStr.toLowerCase().includes(filterTerm) && !agent.nameStr.toLowerCase().includes(filterTerm)) {
                    return;
                }

                const isStatic = currentStatic.includes(agent.extStr);
                const isDyn = currentDyn.includes(agent.extStr);
                const isAssigned = isStatic || isDyn;

                let badgeStyle = 'bg-slate-200/80 text-slate-700 dark:bg-zinc-800/80 dark:text-zinc-400 border-slate-300 dark:border-zinc-700 hover:border-amber-500/50';
                let badgeText = 'Off';

                if (isStatic && isDyn) {
                    badgeStyle = 'bg-gradient-to-r from-amber-500 to-indigo-600 text-white font-black border-purple-600';
                    badgeText = 'static + dyn';
                } else if (isStatic) {
                    badgeStyle = 'bg-amber-500 font-black border-amber-600';
                    badgeText = 'Static';
                } else if (isDyn) {
                    badgeStyle = 'bg-indigo-600 text-white font-black border-indigo-700';
                    badgeText = 'Dynamic';
                }

                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-2 rounded-xl border border-[var(--border-primary)]/60 bg-[var(--bg-secondary)] hover:border-blue-500/40 transition-all gap-2';

                const remoteBadgeHtml = agent.isRemote ? `<span class="px-1.5 py-0.5 rounded text-[9px] font-mono font-bold bg-purple-500/20 text-purple-400 border border-purple-500/30 shrink-0">${agent.badgeLabel}</span>` : '';

                item.innerHTML = `
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="px-2 py-0.5 rounded-md font-mono text-xs font-bold bg-[var(--bg-card)] border border-[var(--border-primary)] text-[var(--text-primary)] shrink-0">${agent.extStr}</span>
                        ${remoteBadgeHtml}
                        <span class="text-xs font-semibold text-[var(--text-primary)] truncate">${escapeHtml(agent.nameStr)}</span>
                    </div>
                    <button type="button" onclick="cycleQueueAgentRole('${agent.extStr}')" class="px-3 py-1 text-xs rounded-lg border font-bold cursor-pointer transition-all shrink-0 ${badgeStyle}">
                        ${badgeText}
                    </button>
                `;
                container.appendChild(item);
            });
        }

        function filterQueueAgentChecklist() {
            renderQueueAgentChecklist();
        }

        function cycleQueueAgentRole(extStr) {
            let staticList = parseQueueExtArray('queueStaticList');
            let dynList = parseQueueExtArray('queueDynList');

            const isStatic = staticList.includes(extStr);
            const isDyn = dynList.includes(extStr);

            if (isStatic || isDyn) {
                // Currently ON -> Turn OFF (remove from both)
                staticList = staticList.filter(e => e !== extStr);
                dynList = dynList.filter(e => e !== extStr);
            } else {
                // Currently OFF -> Turn ON (add to static + dyn)
                staticList.push(extStr);
                dynList.push(extStr);
            }

            document.getElementById('queueStaticList').value = staticList.join(', ');
            document.getElementById('queueDynList').value = dynList.join(', ');
            renderQueueAgentChecklist();
        }

        // Queue agent helpers: the API returns plain extension numbers, but older
        // rows may still contain "110,0" penalties or "Local/110@..." interfaces.
        function cleanQueueAgentsFromApi(value) {
            const raw = Array.isArray(value) ? value : String(value || '').split(/[\r\n,;]+/);
            const out = [];
            raw.forEach(item => {
                const token = String(item || '')
                    .trim()
                    .replace(/^[A-Za-z]+\//, '')
                    .replace(/@.*$/, '')
                    .replace(/,\s*\d+$/, '')
                    .trim();
                if (/^\d{2,}$/.test(token) && !out.includes(token)) out.push(token);
            });
            return out;
        }

        function parseQueueExtArray(inputId) {
            const el = document.getElementById(inputId);
            if (!el) return [];
            const val = el.value || '';
            return val.split(/[\r\n\s\-,]+/).map(s => {
                const clean = s.trim().replace(/^[A-Za-z]+\//, '').replace(/@.*/, '');
                const match = clean.match(/(\d+)/);
                return match ? match[1] : clean;
            }).filter(Boolean);
        }

        function clearAllQueueAgents() {
            document.getElementById('queueStaticList').value = '';
            document.getElementById('queueDynList').value = '';
            renderQueueAgentChecklist();
        }

        function populateQueueAnnouncementsDropdown(desiredValue) {
            const sel = document.getElementById('queueAnnMsg');
            if (!sel) return;

            // Repopulating must never silently drop the saved announcement: the
            // modal sets the value first, then this runs again after the async
            // recording list arrives.
            const keep = (desiredValue !== undefined && desiredValue !== null && String(desiredValue).trim() !== '')
                ? String(desiredValue).trim()
                : String(sel.value || '0').trim();

            sel.innerHTML = '<option value="0">None / No Announcement</option>';
            (loadedRecordingsList || []).forEach(r => {
                const opt = document.createElement('option');
                opt.value = r.id;
                opt.textContent = `${r.displayname} (ID: ${r.id})`;
                sel.appendChild(opt);
            });

            // Keep a deleted/missing recording visible instead of resetting to None.
            if (keep !== '0' && !Array.from(sel.options).some(o => String(o.value) === keep)) {
                const opt = document.createElement('option');
                opt.value = keep;
                opt.textContent = (isRtl ? 'تسجيل محذوف' : 'Missing recording') + ` (ID: ${keep})`;
                sel.appendChild(opt);
            }

            sel.value = keep;
            if (String(sel.value) !== keep) sel.value = '0';
            if (typeof window.syncConfigDropdownTrigger === 'function') {
                window.syncConfigDropdownTrigger(sel);
            }
        }

        // Native selects are hidden behind the custom dropdown component, so a
        // programmatic .value change does not refresh the visible label.
        function syncQueueModalSelects() {
            if (typeof window.syncConfigDropdownTrigger !== 'function') return;
            ['queueStrategy', 'queueMoh', 'queueRecording', 'queueAutofill', 'queueSkipBusy', 'queueAnnMsg'].forEach(id => {
                const el = document.getElementById(id);
                if (el) window.syncConfigDropdownTrigger(el);
            });
        }

        // Any modal that assigns values to dropdown fields must refresh the
        // custom dropdown labels, otherwise the dialog shows the previous value
        // and the operator re-saves stale data.
        function syncModalSelects(root) {
            if (typeof window.syncConfigDropdownTrigger !== 'function') return;
            const scope = root || document;
            scope.querySelectorAll('select.enhanced-select, select.config-input').forEach(sel => {
                if (sel && !sel.multiple) window.syncConfigDropdownTrigger(sel);
            });
        }
        window.syncModalSelects = syncModalSelects;


                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-rose-400 font-bold">${notInit.formatted}</span>
                                        <span class="text-[10px] text-zinc-500">(${notInit.pct}%)</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-amber-400 font-bold">${notConn.formatted}</span>
                                        <span class="text-[10px] text-zinc-500">(${notConn.pct}%)</span>

        function editQueue(extNum) {
            openModal('queueModal');
            const q = (loadedQueuesList || []).find(item => String(item.extension) === String(extNum));
            if (!q) {
                openQueueModal();
                return;
            }

            document.getElementById('queueModalTitle').textContent = (isRtl ? 'تعديل طابور الانتظار ' : 'Edit Queue ') + q.extension;
            document.getElementById('queueEditMode').value = "true";
            document.getElementById('queueNum').value = q.extension;
            document.getElementById('queueNum').disabled = true;
            document.getElementById('queueDesc').value = q.descr || '';
            document.getElementById('queueStrategy').value = q.strategy || 'rrmemory';
            document.getElementById('queueMoh').value = q.musicclass || 'default';
            document.getElementById('queueRecording').value = (q.monitor_type === 'bgrnd' || q.monitor_type === 'yes') ? 'yes' : (q.monitor_type === '' ? 'no' : 'yes');
            document.getElementById('queueMaxWait').value = q.maxwait || 0;
            document.getElementById('queueAgentTimeout').value = q.timeout || 15;
            document.getElementById('queueRetry').value = q.retry || 5;
            document.getElementById('queueAutofill').value = q.autofill || 'yes';
            document.getElementById('queueSkipBusy').value = (Number(q.cwignore) > 0) ? 'yes' : 'no';

            const staticArr = cleanQueueAgentsFromApi(q.static_members);
            const dynArr = cleanQueueAgentsFromApi(q.dynmembers);

            document.getElementById('queueStaticList').value = staticArr.join(', ');
            document.getElementById('queueDynList').value = dynArr.join(', ');

            const annMsgId = parseInt(q.joinannounce_id, 10) || 0;
            populateQueueAnnouncementsDropdown(annMsgId);
            renderQueueAgentChecklist();
            document.getElementById('queueAnnMsg').value = String(annMsgId);
            syncQueueModalSelects();

            const destVal = q.dest || 'app-blackhole,hangup,1';
            document.getElementById('queueDestination').value = destVal;
            const destContinueVal = q.destcontinue || 'app-blackhole,hangup,1';
            document.getElementById('queueContinueDestination').value = destContinueVal;

            initDestinationSelectInstances();
            if (queueDestSelectInstance) queueDestSelectInstance.setDialplan(destVal);
            if (queueContinueDestSelectInstance) queueContinueDestSelectInstance.setDialplan(destContinueVal);
            if (typeof ensureAllConfigListsLoaded === 'function') {
                ensureAllConfigListsLoaded().then(() => {
                    populateQueueAnnouncementsDropdown(annMsgId);
                    renderQueueAgentChecklist();
                    syncQueueModalSelects();
                    if (queueDestSelectInstance) queueDestSelectInstance.setDialplan(destVal);
                    if (queueContinueDestSelectInstance) queueContinueDestSelectInstance.setDialplan(destContinueVal);
                }).catch(() => {});
            }

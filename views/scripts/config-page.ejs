        async function saveSingleDongleDsp(id) {
            const payload = {
                denoise: document.getElementById(`d_denoise_${id}`)?.value,
                rnnoise: document.getElementById(`d_rnnoise_${id}`)?.value,
                agc: document.getElementById(`d_agc_${id}`)?.value,
                vad_threshold: document.getElementById(`d_thresh_${id}`)?.value
            };
            try {
                const res = await fetch(`/api/config/audio/dongles/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? `تم حفظ ملف معالجة الصوت للشريحة ${id}` : `Audio DSP profile for ${id} saved.`, 'success');
                    loadPerDongleAudioProfiles();
                } else {
                    showToast(data.error || 'Failed to save dongle DSP', 'error');
                }
            } catch (e) {
                showToast(e.message, 'error');
            }
        }


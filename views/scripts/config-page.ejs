                    const rawNum = externalInput ? externalInput.value.trim().replace(/\s+/g, '') : '';
                    const dongle = externalDongleSelect ? externalDongleSelect.value.trim() : '';
                    this.selectedTarget = rawNum;
                    this.selectedDongle = dongle;

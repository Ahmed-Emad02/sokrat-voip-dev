        function saveInboundRoute(e) {
            if (e && typeof e.preventDefault === 'function') e.preventDefault();
            const editExt = document.getElementById('inboundEditExt').value;
            const editCid = document.getElementById('inboundEditCid') ? document.getElementById('inboundEditCid').value : '';
            const editDesc = document.getElementById('inboundEditDesc').value;
            const editDest = document.getElementById('inboundEditDest').value;

            const description = document.getElementById('inDescription').value.trim();
            const extension = document.getElementById('inExtension').value.trim();
            const cidnum = document.getElementById('inCidNum') ? document.getElementById('inCidNum').value.trim() : '';
            const destination = document.getElementById('inDestination').value.trim();

            if (!destination) {
                showToast(isRtl ? 'يرجى اختيار الوجهة.' : 'Please select a destination.', 'error');
                return;
            }

            const isEdit = (editDesc !== '' || editExt !== '' || editCid !== '' || editDest !== '');
            if (Array.isArray(loadedInboundRoutesList)) {
                const normExt = extension;
                const normCid = cidnum;
                const existingRoute = (loadedInboundRoutesList || []).find(r => {
                    const origExt = (editExt || '').trim();
                    const origCid = (editCid || '').trim();
                    if (isEdit) {
                        if (String(r.extension || '').trim() === origExt && String(r.cidnum || '').trim() === origCid) {
                            return false;
                        }
                    }
                    const rExt = String(r.extension || '').trim();
                    const rCid = String(r.cidnum || '').trim();
                    return rExt === normExt && rCid === normCid;
                });
                if (existingRoute) {
                    showToast(isRtl ? ("تحذير: المسار الوارد لهذا الرقم DID وهاتف المتصل CID موجود بالفعل (" + (existingRoute.description || existingRoute.extension || 'Route') + ")") : ("Warning: An inbound route for this DID/CID combination already exists (" + (existingRoute.description || existingRoute.extension || 'Route') + ")"), "warning");
                }
            }

            const url = '/api/config/routes/inbound';
            const method = isEdit ? 'PUT' : 'POST';

            const bodyData = { description, extension, cidnum, destination };
            if (method === 'PUT') {
                bodyData.originalExtension = editExt;
                bodyData.originalCidnum = editCid;
                bodyData.originalDescription = editDesc;
                bodyData.originalDestination = editDest;
            }

            const submitBtn = e.target ? (e.target.matches('button') ? e.target : e.target.querySelector('button[type="submit"]')) : null;
            if (submitBtn) setButtonLoading(submitBtn, true);

            fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(bodyData)
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    if (data.warningMessage) {
                        showToast(data.warningMessage, 'warning');
                    } else {
                        showToast(data.message, 'success');
                    }
                    closeModal('inboundModal');
                    fetchInboundRoutes();
                } else showToast(data.error, 'error');
            })
            .catch(err => showToast(err.message, 'error'))
            .finally(() => {
                if (submitBtn) setButtonLoading(submitBtn, false);
            });
        }


                }

                donglesHTML += `
                                </tbody>
                            </table>
                        </div>
                    </div>
                `;

                tablesContainer.innerHTML = donglesHTML;

            } catch (err) {
                summaryContainer.innerHTML = `<div class="col-span-full text-center text-xs text-red-400 py-4">Failed to fetch dongle reports: ${escapeHtml(err.message)}</div>`;
            }
        }
        window.fetchDongleStateReports = fetchDongleStateReports;
        rtcpTimer = null;
        function startRtcpTimer() {
            stopRtcpTimer();
            rtcpTimer = window.sokratPoll(fetchRtcpDiagnostics, 3000);
        }
        function stopRtcpTimer() {
            if (rtcpTimer) {
                if (typeof rtcpTimer.stop === 'function') rtcpTimer.stop();
                else clearInterval(rtcpTimer);
                rtcpTimer = null;
            }
        }
        window.fetchRtcpDiagnostics = fetchRtcpDiagnostics;
        // =========================================================================
        // --- TTY TERMINAL SHELL MODULE WITH CLIPBOARD PASTE ---
        // =========================================================================
        let ttySocket = null;
        let ttyXterm = null;
        let ttyFitAddon = null;
        let isTtyInitialized = false;

        function initTtyTerminal() {
            if (isTtyInitialized) {
                if (ttyFitAddon) try { ttyFitAddon.fit(); } catch(_) {}
                return;
            }
            isTtyInitialized = true;

            const container = document.getElementById('terminalContainer');
            if (!container) return;

            if (typeof io !== 'undefined') {
                ttySocket = io();
                window.ttySocket = ttySocket;
            } else {
                updateTtyStatus(false, 'Socket.IO unavailable');
                return;
            }

            if (typeof window.Terminal !== 'undefined') {
                ttyXterm = new window.Terminal({
                    cursorStyle: 'block',
                    fontFamily: '"JetBrains Mono", "Courier New", monospace',
                    fontSize: 13,
                    theme: {
                        background: '#09090b',
                        foreground: '#34d399',
                        cursor: '#10b981',
                        selectionBackground: 'rgba(16, 185, 129, 0.3)',
                        black: '#18181b',
                        red: '#f87171',
                        green: '#34d399',
                        yellow: '#fbbf24',
                        blue: '#60a5fa',
                        magenta: '#c084fc',
                        cyan: '#22d3ee',
                        white: '#f4f4f5'
                    }
                });
                window.ttyXterm = ttyXterm;
                if (typeof window.FitAddon !== 'undefined' && window.FitAddon.FitAddon) {
                    ttyFitAddon = new window.FitAddon.FitAddon();
                    ttyXterm.loadAddon(ttyFitAddon);
                }

                ttyXterm.open(container);
                if (ttyFitAddon) try { ttyFitAddon.fit(); } catch(_) {}

                ttyXterm.attachCustomKeyEventHandler((arg) => {
                    if ((arg.ctrlKey || arg.metaKey) && arg.code === 'KeyC' && arg.type === 'keydown') {
                        if (ttyXterm.hasSelection()) {
                            const selected = ttyXterm.getSelection();
                            if (navigator.clipboard && navigator.clipboard.writeText) {
                                navigator.clipboard.writeText(selected);
                                showToast(isRtl ? 'تم نسخ النص إلى الحافظة' : 'Copied selected text to clipboard', 'success');
                            }
                            return false;
                        }
                    }
                    if ((arg.ctrlKey || arg.metaKey) && arg.code === 'KeyV' && arg.type === 'keydown') {
                        pasteClipboardToTerminal();
                        return false;
                    }
                    return true;
                });
                ttyXterm.onSelectionChange(() => {
                    const text = ttyXterm.getSelection();
                    if (text && navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).catch(() => {});
                    }
                });

                ttyXterm.onData(data => {
                    if (ttySocket) ttySocket.emit('tty_input', data);
                });
                window.addEventListener('resize', () => {
                    if (ttyFitAddon && ttyXterm) {
                        try {
                            ttyFitAddon.fit();
                            ttySocket.emit('tty_resize', { cols: ttyXterm.cols, rows: ttyXterm.rows });
                        } catch(_) {}
                    }
                });
            } else {
                container.innerHTML = '<div id="ttyOutput" class="whitespace-pre-wrap font-mono text-xs leading-relaxed text-emerald-400 p-2"></div>';
                container.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') {
                        if (ttySocket) ttySocket.emit('tty_input', '\r');
                    } else if (e.key === 'Backspace') {
                        if (ttySocket) ttySocket.emit('tty_input', '\b');
                    } else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
                        if (ttySocket) ttySocket.emit('tty_input', e.key);
                    }
                });
            }

            const handlePasteEvent = (e) => {
                e.preventDefault();
                const pasteText = (e.clipboardData || window.clipboardData).getData('text');
                if (pasteText && ttySocket) {
                    ttySocket.emit('tty_input', pasteText);
                }
            };
            container.addEventListener('paste', handlePasteEvent);
            if (ttyXterm && ttyXterm.element) {
                ttyXterm.element.addEventListener('paste', handlePasteEvent);
            }
            ttySocket.on('tty_output', (data) => {
                if (ttyXterm) {
                    ttyXterm.write(data);
                } else {
                    const output = document.getElementById('ttyOutput');
                    if (output) {
                        output.textContent += data;
                        container.scrollTop = container.scrollHeight;
                    }
                }
            });

            ttySocket.on('tty_status', (status) => {
                if (status && status.connected) {
                    updateTtyStatus(true, 'Connected (PID: ' + (status.pid || 'live') + ')');
                } else {
                    updateTtyStatus(false, 'Disconnected');
                }
            });

            const cols = ttyXterm ? ttyXterm.cols : 100;
            const rows = ttyXterm ? ttyXterm.rows : 30;
            ttySocket.emit('tty_init', { cols, rows });
        }

        function updateTtyStatus(connected, text) {
            const badge = document.getElementById('ttyStatusBadge');
            const dot = document.getElementById('ttyStatusDot');
            const txt = document.getElementById('ttyStatusText');
            if (!badge || !dot || !txt) return;
            txt.textContent = text;
            if (connected) {
                badge.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5';
                dot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-pulse';
            } else {
                badge.className = 'px-2.5 py-1 text-xs font-bold rounded-lg bg-red-500/10 text-red-400 border border-red-500/20 flex items-center gap-1.5';
                dot.className = 'w-2 h-2 rounded-full bg-red-400';
            }
        }

        async function copySelectedTextFromTerminal() {
            try {
                let selected = '';
                if (ttyXterm && ttyXterm.hasSelection()) {
                    selected = ttyXterm.getSelection();
                } else if (window.getSelection) {
                    selected = window.getSelection().toString();
                }
                if (!selected) {
                    showToast(isRtl ? 'يرجى تحديد النص في الطرفية لنسخه' : 'Please select text in the terminal to copy', 'info');
                    return;
                }
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(selected);
                    showToast(isRtl ? 'تم نسخ النص إلى الحافظة' : 'Copied selected text to clipboard', 'success');
                } else {
                    showToast(isRtl ? 'تعذر الوصول إلى الحافظة' : 'Clipboard access restricted', 'error');
                }
            } catch(err) {
                showToast(isRtl ? 'تعذر النسخ' : 'Failed to copy text', 'error');
            }
        }
        window.copySelectedTextFromTerminal = copySelectedTextFromTerminal;

        async function pasteClipboardToTerminal() {
            try {
                let pasteText = '';
                if (navigator.clipboard && navigator.clipboard.readText) {
                    pasteText = await navigator.clipboard.readText();
                }
                if (!pasteText) {
                    pasteText = prompt(isRtl ? 'قم بلصق النص هنا لإرساله إلى الطرفية:' : 'Paste text here to send to TTY terminal:');
                }
                if (pasteText && ttySocket) {
                    ttySocket.emit('tty_input', pasteText);
                    showToast(isRtl ? 'تم إرسال النص إلى الطرفية' : 'Pasted text sent to terminal', 'success');
                }
            } catch(err) {
                const pasteText = prompt(isRtl ? 'قم بلصق النص هنا لإرساله إلى الطرفية:' : 'Paste text here to send to TTY terminal:');
                if (pasteText && ttySocket) {
                    ttySocket.emit('tty_input', pasteText);
                    showToast(isRtl ? 'تم إرسال النص إلى الطرفية' : 'Pasted text sent to terminal', 'success');
                }
            }
        }
        window.pasteClipboardToTerminal = pasteClipboardToTerminal;

        function clearTerminalScreen() {
            if (ttyXterm) {
                ttyXterm.clear();
            } else {
                const output = document.getElementById('ttyOutput');
                if (output) output.textContent = '';
            }
            if (ttySocket) ttySocket.emit('tty_input', '\x0c');
        }
        window.clearTerminalScreen = clearTerminalScreen;

        function restartTtyShell() {
            if (ttyXterm) ttyXterm.clear();
            const cols = ttyXterm ? ttyXterm.cols : 100;
            const rows = ttyXterm ? ttyXterm.rows : 30;
            if (ttySocket) ttySocket.emit('tty_restart', { cols, rows });
        }
        window.restartTtyShell = restartTtyShell;

        function runLastTtyCommand() {
            if (ttySocket) {
                ttySocket.emit('tty_input', '\x1b[A\r');
                showToast(isRtl ? 'تم إرسال الأمر السابق' : 'Executed last command (Up + Enter)', 'info');
            } else {
                showToast(isRtl ? 'الطرفية غير متصلة' : 'Terminal not connected', 'error');
            }
        }
        window.runLastTtyCommand = runLastTtyCommand;
        window.restartTtyShell = restartTtyShell;


        async function saveSingleDongleGain(dongleId) {
            const rxInput = document.getElementById(`rxInput_${dongleId}`);
            const txInput = document.getElementById(`txInput_${dongleId}`);
            if (!rxInput || !txInput) return;

            const rxgain = Math.max(-10, Math.min(10, parseInt(rxInput.value, 10) || 0));
            const txgain = Math.max(-10, Math.min(10, parseInt(txInput.value, 10) || 0));

            try {
                const res = await fetch('/api/config/modem/gain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dongleId, rxgain, txgain })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || `${dongleId} volume gain updated successfully!`, 'success');
                } else {
                    showToast(data.error || 'Failed to update volume gain.', 'error');
                }
            } catch (e) {
                showToast('Error updating volume gain: ' + e.message, 'error');
            }
        }
        window.saveSingleDongleGain = saveSingleDongleGain;

        async function saveAllDongleGains() {
            const cards = document.querySelectorAll('#modemDonglesGrid [data-dongle-id]');
            if (!cards.length) return;

            const gains = {};
            cards.forEach(card => {
                const dongleId = card.getAttribute('data-dongle-id');
                const rxInput = document.getElementById(`rxInput_${dongleId}`);
                const txInput = document.getElementById(`txInput_${dongleId}`);
                if (dongleId && rxInput && txInput) {
                    gains[dongleId] = {
                        rxgain: Math.max(-10, Math.min(10, parseInt(rxInput.value, 10) || 0)),
                        txgain: Math.max(-10, Math.min(10, parseInt(txInput.value, 10) || 0))
                    };
                }
            });

            try {
                const res = await fetch('/api/config/modem/gain', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gains })
                });
                const data = await res.json();
                if (data.success) {
                    showToast(data.message || 'All dongle volume gains updated successfully!', 'success');
                } else {
                    showToast(data.error || 'Failed to update volume gains.', 'error');
                }
            } catch (e) {
                showToast('Error saving all gains: ' + e.message, 'error');
            }
        }
        window.saveAllDongleGains = saveAllDongleGains;
        window.saveModemConfig = saveAllDongleGains;

        async function loadAudioGlobals() {
            const threshEl = document.getElementById('dspVadThreshold') || document.getElementById('globalVadThreshold');
            const hangEl = document.getElementById('dspVadHangover') || document.getElementById('globalVadHangover');
            const dbThreshEl = document.getElementById('dspVadDbThreshold') || document.getElementById('globalVadDbThreshold');
            const cDenoiseEl = document.getElementById('cellularDenoiseSelect');
            const cRnnoiseEl = document.getElementById('cellularRnnoiseSelect');
            const cAgcEl = document.getElementById('cellularAgcSelect');
            const cJbEl = document.getElementById('cellularJbSelect');
            try {
                const res = await fetch('/api/config/audio-globals');
                const data = await res.json();
                if (data.success && data.globals) {
                    const g = data.globals;
                    const vThresh = String(parseFloat(g.vad_threshold || '0.20').toFixed(2));
                    const vHang = String(parseInt(g.vad_hangover || '250', 10));
                    const vDb = String(g.vad_db_threshold || '-90');
                    
                    // Sync both tabs if both exist
                    ['dspVadThreshold', 'globalVadThreshold'].forEach(id => { const el = document.getElementById(id); if (el) el.value = vThresh; });
                    ['dspVadHangover', 'globalVadHangover'].forEach(id => { const el = document.getElementById(id); if (el) el.value = vHang; });
                    ['dspVadDbThreshold', 'globalVadDbThreshold'].forEach(id => { const el = document.getElementById(id); if (el) el.value = vDb; });
                    
                    if (cDenoiseEl && g.cellular_denoise) cDenoiseEl.value = String(g.cellular_denoise);
                    if (cRnnoiseEl && g.cellular_rnnoise) cRnnoiseEl.value = String(g.cellular_rnnoise);
                    if (cAgcEl && g.cellular_agc) cAgcEl.value = String(g.cellular_agc);
                    if (cJbEl && g.cellular_jitterbuffer) cJbEl.value = String(g.cellular_jitterbuffer);
                }
            } catch (_) {}
        }
        window.loadAudioGlobals = loadAudioGlobals;

        async function saveAudioGlobals() {
            const threshEl = document.getElementById('dspVadThreshold') || document.getElementById('globalVadThreshold');
            const hangEl = document.getElementById('dspVadHangover') || document.getElementById('globalVadHangover');
            const dbThreshEl = document.getElementById('dspVadDbThreshold') || document.getElementById('globalVadDbThreshold');
            const cDenoiseEl = document.getElementById('cellularDenoiseSelect');
            const cRnnoiseEl = document.getElementById('cellularRnnoiseSelect');
            const cAgcEl = document.getElementById('cellularAgcSelect');
            const cJbEl = document.getElementById('cellularJbSelect');
            
            const vThresh = (threshEl && threshEl.value) ? threshEl.value : '0.20';
            const vHang = (hangEl && hangEl.value) ? hangEl.value : '250';
            const vDb = (dbThreshEl && dbThreshEl.value) ? dbThreshEl.value : '-90';
            
            try {
                const payload = {
                    vad_threshold: vThresh,
                    vad_hangover: vHang,
                    vad_db_threshold: vDb
                };
                if (cDenoiseEl) payload.cellular_denoise = cDenoiseEl.value;
                if (cRnnoiseEl) payload.cellular_rnnoise = cRnnoiseEl.value;
                if (cAgcEl) payload.cellular_agc = cAgcEl.value;
                if (cJbEl) payload.cellular_jitterbuffer = cJbEl.value;
                
                const res = await fetch('/api/config/audio-globals', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (data.success) {
                    showToast(isRtl ? 'تم حفظ وتفعيل إعدادات معالجة الصوت الرقمية (DSP) بنجاح.' : 'Audio processing suite (DSP) settings saved and applied.', 'success');
                } else {
                    showToast(data.error || 'Failed to save audio processing settings.', 'error');
                }
            } catch (e) {
                showToast('Error saving audio processing settings: ' + e.message, 'error');
            }
        }
        window.saveAudioGlobals = saveAudioGlobals;


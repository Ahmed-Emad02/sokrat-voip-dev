        /* ===== Config top pill strip: scrolling engine =====
           Fixes the previously broken horizontal scrolling:
             - The 3x wheel multiplier made the strip feel sluggish and
               overshoot past the last pill.
             - preventDefault() was called even when the strip could not
               scroll, which blocked page scrolling.
             - The container had scroll-smooth, so every wheel tick was
               animated and lagged behind the pointer.
           Now: native 1:1 delta, no smooth behaviour on wheel, and
           preventDefault only when the strip can actually scroll. */
        /* Drag to scroll: press and drag the strip left / right and it follows
           the pointer 1:1 - the most direct scrolling there is. A drag must
           not switch tabs, so the click that follows it is swallowed. */
        function enablePillDragScroll() {
            const sc = document.getElementById('configTopPillsScroll');
            if (!sc || sc.__dragBound) return;
            sc.__dragBound = true;

            let dragging = false;
            let moved = false;
            let startX = 0;
            let startScroll = 0;
            let pointerId = null;
            let velocity = 0;          // px per millisecond (signed)
            let lastX = 0;
            let lastMoveAt = 0;
            let momentumFrame = null;
            let momentumRunning = false;

            // Flick momentum: after the pointer is released the strip keeps
            // gliding and decays to a stop, like a native scroll fling.
            const stopMomentum = () => {
                if (momentumFrame !== null) {
                    cancelAnimationFrame(momentumFrame);
                    momentumFrame = null;
                }
                momentumRunning = false;
            };

            const startMomentum = () => {
                stopMomentum();
                momentumRunning = false;
                if (Math.abs(velocity) < 0.12) { sc.classList.remove('is-gliding'); return; }   // too slow to fling
                momentumRunning = true;
                // The drag moves the strip with -dx, so the momentum has to
                // continue in the very same direction: negate the pointer
                // velocity so a flick to the left keeps gliding to the left.
                let v = -velocity * 16;                       // px per frame
                if (v > 45) v = 45;                           // cap the fling
                if (v < -45) v = -45;
                const max = __pillStripMax;
                const rtl = __pillStripRtl;
                const min = rtl ? -max : 0;
                const maxPos = rtl ? 0 : max;
                sc.classList.add('is-gliding');
                const glide = () => {
                    v *= 0.94;                               // decay
                    let next = sc.scrollLeft + v;
                    if (next <= min) { next = min; v = 0; }
                    if (next >= maxPos) { next = maxPos; v = 0; }
                    sc.scrollLeft = next;
                    if (Math.abs(v) > 0.4) {
                        momentumFrame = requestAnimationFrame(glide);
                    } else {
                        momentumFrame = null;
                        sc.classList.remove('is-gliding');
                        scheduleTopPillScrollAffordance();
                        refreshPillStripMetrics();
                    }
                };
                momentumFrame = requestAnimationFrame(glide);
            };

            sc.addEventListener('pointerdown', (e) => {
                if (e.button !== 0 || !e.isPrimary) return;
                stopMomentum();
                dragging = true;
                moved = false;
                startX = e.clientX;
                lastX = e.clientX;
                lastMoveAt = performance.now();
                velocity = 0;
                startScroll = sc.scrollLeft;
                pointerId = e.pointerId;
            });

            sc.addEventListener('pointermove', (e) => {
                if (!dragging || e.pointerId !== pointerId) return;
                const dx = e.clientX - startX;
                if (!moved && Math.abs(dx) < 4) return;    // still a plain click
                const now = performance.now();
                const dt = Math.max(1, now - lastMoveAt);
                // velocity of the pointer, used for the flick momentum
                velocity = (e.clientX - lastX) / dt;
                lastX = e.clientX;
                lastMoveAt = now;
                if (!moved) {
                    moved = true;
                    sc.classList.add('is-dragging');
                    sc.classList.add('is-gliding');
                    try { sc.setPointerCapture(pointerId); } catch (_) {}
                }
                // The strip follows the pointer in both directions (in RTL the
                // scroll offset is negative, the same formula still holds).
                sc.scrollLeft = startScroll - dx;
                e.preventDefault();
            });

            const endDrag = () => {
                if (!dragging) return;
                dragging = false;
                sc.classList.remove('is-dragging');
                if (!momentumRunning) sc.classList.remove('is-gliding');
                try { if (pointerId !== null) sc.releasePointerCapture(pointerId); } catch (_) {}
                pointerId = null;
                if (moved) {
                    startMomentum();
                    // Swallow the click the drag produced - but only that one:
                    // the suppressor is removed again after a moment so it can
                    // never swallow a later, legitimate click.
                    const swallow = (e) => {
                        e.stopPropagation();
                        e.preventDefault();
                    };
                    sc.addEventListener('click', swallow, { capture: true, once: true });
                    setTimeout(() => sc.removeEventListener('click', swallow, { capture: true }), 400);
                    scheduleTopPillScrollAffordance();
                    refreshPillStripMetrics();
                }
            };
            sc.addEventListener('pointerup', endDrag);
            sc.addEventListener('pointercancel', endDrag);
            sc.addEventListener('dragstart', (e) => e.preventDefault());
        }

        /* Eased rAF animation for the pill strip: the wheel handler feeds it a
           target position and it eases there, so the strip glides instead of
           jumping one wheel tick at a time. */
        const __pillScrollAnims = new WeakMap();
        function animatePillScrollTo(sc, next) {
            const max = __pillStripMax;
            // In RTL the strip scrolls into negative scrollLeft values, so the
            // clamp has to follow the direction or the strip never moves.
            const rtl = __pillStripRtl;
            const min = rtl ? -max : 0;
            const maxPos = rtl ? 0 : max;
            const target = Math.max(min, Math.min(maxPos, next));
            let anim = __pillScrollAnims.get(sc);
            if (!anim) {
                anim = { target: sc.scrollLeft, current: sc.scrollLeft, from: sc.scrollLeft, start: 0, duration: 200, frame: null };
                __pillScrollAnims.set(sc, anim);
            }
            anim.target = target;
            anim.ownScrolls = 0;
            if (anim.frame !== null) return;
            // Time based easing: the glide always takes ~200 ms no matter how
            // far it has to travel, so the strip feels quick and consistent.
            anim.from = anim.current;
            anim.start = performance.now();
            // The CSS smooth scrolling would animate every single frame write,
            // so it is switched off for the duration of the glide.
            sc.classList.add('is-gliding');
            const step = (now) => {
                const t = Math.min(1, (now - anim.start) / anim.duration);
                const eased = 1 - Math.pow(1 - t, 3);   // easeOutCubic
                anim.current = anim.from + (anim.target - anim.from) * eased;
                sc.scrollLeft = anim.current;
                anim.ownScrolls = (anim.ownScrolls || 0) + 1;
                if (t < 1) {
                    anim.frame = requestAnimationFrame(step);
                } else {
                    anim.current = anim.target;
                    sc.scrollLeft = anim.target;
                    anim.ownScrolls = (anim.ownScrolls || 0) + 1;
                    anim.frame = null;
                    sc.classList.remove('is-gliding');
                    refreshPillStripMetrics();
                    // The affordance is refreshed once at the end - doing it on
                    // every frame forced a layout each time and made the
                    // scrolling visibly choppy.
                    updateTopPillScrollAffordance();
                }
            };
            anim.frame = requestAnimationFrame(step);
        }

        function initTopPillBarWheelScroll() {
            const scrollContainer = document.getElementById('configTopPillsScroll');
            if (!scrollContainer || scrollContainer._wheelAttached) return;
            scrollContainer._wheelAttached = true;

            refreshPillStripMetrics();
            enablePillDragScroll();
            scrollContainer.addEventListener('wheel', function(e) {
                if (e.ctrlKey) return;                       // let pinch-zoom through
                const maxScroll = __pillStripMax;            // cached - no layout in the hot path
                if (maxScroll <= 1) return;                  // nothing to scroll: do not block the page

                const rtl = __pillStripRtl;

                // Trackpads report deltaX for horizontal swipes; mice only
                // report deltaY. Prefer the axis the user is actually using.
                const absX = Math.abs(e.deltaX);
                const absY = Math.abs(e.deltaY);
                let delta;
                if (absX > absY) {
                    delta = e.deltaX * 1.6;                  // trackpad swipe
                } else {
                    delta = e.deltaY * 3.5;                  // mouse wheel notch: a big
                }                                        // chunk of the strip

                if (!delta) return;

                // Work in scrollLeft terms: in RTL the strip scrolls into
                // negative values, so the edges are [-maxScroll, 0] instead of
                // [0, maxScroll]. A wheel down always reveals the LATER pills.
                const slDelta = rtl ? -delta : delta;
                const min = rtl ? -maxScroll : 0;
                const maxPos = rtl ? 0 : maxScroll;

                // Only hand the gesture back to the page when the strip is
                // ALREADY at the edge and the user keeps pushing past it.
                if ((slDelta < 0 && scrollContainer.scrollLeft <= min + 1) ||
                    (slDelta > 0 && scrollContainer.scrollLeft >= maxPos - 1)) return;

                e.preventDefault();
                // The wheel takes over from a running flick.
                const anim = __pillScrollAnims.get(scrollContainer);
                if (anim && anim.frame !== null) { cancelAnimationFrame(anim.frame); anim.frame = null; }
                // Animate towards the new position instead of jumping: a single
                // wheel tick used to move the strip in one instant step, which
                // read as a jump rather than a scroll.
                animatePillScrollTo(scrollContainer, scrollContainer.scrollLeft + (rtl ? -delta : delta));
                scheduleTopPillScrollAffordance();
            }, { passive: false });

            window.addEventListener('resize', refreshPillStripMetrics);
            scrollContainer.addEventListener('scroll', function() {
                // While the glide is running it drives the position itself and
                // refreshes the affordance once at the end - reading the
                // scroll metrics on every frame made the scrolling choppy.
                const anim = __pillScrollAnims.get(scrollContainer);
                // Ignore the scroll events our own glide produced (the browser
                // queues one per frame write) - reacting to them would read the
                // scroll metrics on every frame and make the scroll choppy.
                if (anim && anim.ownScrolls > 0) { anim.ownScrolls--; return; }
                if (anim && anim.frame !== null) return;
                scheduleTopPillScrollAffordance();
            }, { passive: true });
            window.addEventListener('resize', updateTopPillScrollAffordance);
            // Web fonts and late layout can change the strip width, so re-measure
            // the overflow once the browser has settled.
            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(updateTopPillScrollAffordance).catch(() => {});
            }
            requestAnimationFrame(updateTopPillScrollAffordance);
            setTimeout(updateTopPillScrollAffordance, 350);

            /* Left/Right arrow keys move between pills (roving tabindex). */
            scrollContainer.addEventListener('keydown', function(e) {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                const pills = Array.from(scrollContainer.querySelectorAll('.config-tab-btn'));
                if (!pills.length) return;
                const idx = pills.indexOf(document.activeElement);
                if (idx === -1) return;
                e.preventDefault();
                const dir = (e.key === 'ArrowRight') ? 1 : -1;
                const next = pills[(idx + dir + pills.length) % pills.length];
                if (!next) return;
                next.focus({ preventScroll: true });
                const tabId = next.getAttribute('data-tab-target');
                if (tabId && typeof window.switchTab === 'function') window.switchTab(tabId);
            });

            updateTopPillScrollAffordance();
        }

        /* Shows the left/right edge fades only when there is content to reach. */
        /* Smooth wheel / trackpad scrolling for the horizontal pill strip.
           CSS `scroll-behavior: smooth` only covers programmatic scrolling -
           Chrome's mouse wheel is always instant - so the wheel delta is
           captured and the strip is animated towards the new position with an
           eased rAF loop. At the ends the wheel is released so the page can
           still be scrolled normally. */

        /* The affordance helper reads the strip's scroll metrics, so it must
           not run on every scroll event - that forces a layout per frame and
           makes the scrolling choppy. One refresh per animation frame is
           enough. */
        let __pillAffordanceRaf = null;
        function scheduleTopPillScrollAffordance() {
            if (__pillAffordanceRaf !== null) return;
            __pillAffordanceRaf = requestAnimationFrame(() => {
                __pillAffordanceRaf = null;
                updateTopPillScrollAffordance();
            });
        }

        /* Cached scroll metrics. Reading scrollWidth / clientWidth forces a
           synchronous layout, so the wheel handler must never do it - it is
           refreshed here (resize / after a glide) and read from the cache. */
        let __pillStripMax = 0;
        let __pillStripRtl = false;
        function refreshPillStripMetrics() {
            const sc = document.getElementById('configTopPillsScroll');
            if (!sc) return;
            __pillStripMax = Math.max(0, sc.scrollWidth - sc.clientWidth);
            __pillStripRtl = getComputedStyle(sc).direction === 'rtl';
        }

        function updateTopPillScrollAffordance() {
            const sc = document.getElementById('configTopPillsScroll');
            const bar = document.getElementById('configTopPillBar');
            if (!sc || !bar) return;
            const max = sc.scrollWidth - sc.clientWidth;
            if (max <= 1) {
                bar.classList.remove('can-scroll-start', 'can-scroll-end');
                return;
            }
            const pos = Math.abs(sc.scrollLeft);
            bar.classList.toggle('can-scroll-start', pos > 2);
            bar.classList.toggle('can-scroll-end', pos < max - 2);
        }

        /* Brings a pill into view inside the strip.
           Scrolls ONLY the strip - never the page - and does the minimum
           amount of scrolling needed, so switching tabs does not make the
           whole strip jump around. */
        function scrollTopPillIntoView(tabId, animate) {
            const sc = document.getElementById('configTopPillsScroll');
            if (!sc) return;
            const pill = sc.querySelector('[data-tab-target="' + tabId + '"]');
            if (!pill) return;

            const margin = 12;
            const pillLeft = pill.offsetLeft;
            const pillRight = pillLeft + pill.offsetWidth;
            const viewLeft = sc.scrollLeft;
            const viewRight = sc.scrollLeft + sc.clientWidth;

            let delta = 0;
            if (pillLeft - margin < viewLeft) {
                delta = (pillLeft - margin) - viewLeft;
            } else if (pillRight + margin > viewRight) {
                delta = (pillRight + margin) - viewRight;
            }
            if (delta === 0) { updateTopPillScrollAffordance(); return; }

            const rtl = getComputedStyle(sc).direction === 'rtl';
            const next = sc.scrollLeft + (rtl ? -delta : delta);

            if (animate === false) {
                sc.scrollTo({ left: next, behavior: 'auto' });
            } else {
                sc.scrollTo({ left: next, behavior: 'smooth' });
            }
            updateTopPillScrollAffordance();
        }


<%
const isRtl = currentLang === 'ar';
const t = isRtl ? {
    title: 'المستأجرون السحابيون',
    subtitle: 'روابط الاتصال العامة ومجموعات الرنين لكل نشاط تجاري',
    newTenant: 'نشاط تجاري جديد',
    business: 'النشاط التجاري',
    status: 'الحالة',
    ringGroup: 'مجموعة الرنين',
    pool: 'خطوط الضيوف',
    active: 'مكالمات نشطة',
    link: 'رابط الاتصال',
    actions: 'إجراءات',
    copy: 'نسخ',
    copyEmbed: 'نسخ كود التضمين',
    suspend: 'تعليق',
    activate: 'تفعيل',
    empty: 'لا يوجد مستأجرون بعد.',
    loading: 'جارٍ التحميل...',
    name: 'اسم النشاط',
    agents: 'تحويلات الموظفين',
    selectExtensions: '-- اختر التحويلات --',
    selectAll: 'تحديد الكل',
    clearAll: 'مسح',
    noExtensions: 'لا توجد تحويلات معرفة',
    linkAutoNote: 'يتم إنشاء رابط الاتصال تلقائياً بعد الحفظ، ثم يظهر الرابط وكود التضمين.',
    concurrency: 'أقصى مكالمات متزامنة',
    poolSize: 'حجم خطوط الضيوف',
    ringGroupOptional: 'رقم مجموعة الرنين (اختياري)',
    linkLabel: 'اسم الرابط',
    origins: 'النطاقات المسموح بها (مفصولة بفاصلة)',
    recording: 'تسجيل المكالمات',
    create: 'إنشاء',
    cancel: 'إلغاء',
    created: 'تم إنشاء النشاط التجاري',
    failed: 'فشل إنشاء النشاط التجاري',
    copied: 'تم النسخ',
    snippet: 'كود التضمين',
    publicLink: 'الرابط العام',
    close: 'إغلاق',
    manageAgents: 'إدارة الموظفين',
    save: 'حفظ',
    selectAtLeastOneAgent: 'اختر موظفاً واحداً على الأقل',
    noAgents: 'لا يوجد موظفون',
    agentsFor: 'موظفو النشاط'
} : {
    title: 'Cloud Tenants',
    subtitle: 'Public call links and ring groups for every business',
    newTenant: 'New Business',
    business: 'Business',
    status: 'Status',
    ringGroup: 'Ring Group',
    pool: 'Guest Lines',
    active: 'Active Calls',
    link: 'Call Link',
    actions: 'Actions',
    copy: 'Copy',
    copyEmbed: 'Copy Embed Code',
    suspend: 'Suspend',
    activate: 'Activate',
    empty: 'No tenants yet.',
    loading: 'Loading...',
    name: 'Business Name',
    agents: 'Agent Extensions',
    selectExtensions: '-- Select extensions --',
    selectAll: 'Select all',
    clearAll: 'Clear',
    noExtensions: 'No extensions configured',
    linkAutoNote: 'The public call link is generated automatically after saving; the URL and embed code are shown next.',
    concurrency: 'Max Concurrent Calls',
    poolSize: 'Guest Line Pool Size',
    ringGroupOptional: 'Ring Group Number (optional)',
    linkLabel: 'Link Label',
    origins: 'Allowed Domains (comma separated)',
    recording: 'Record Calls',
    create: 'Create',
    cancel: 'Cancel',
    created: 'Business created',
    failed: 'Could not create business',
    copied: 'Copied',
    snippet: 'Embed Code',
    publicLink: 'Public Link',
    close: 'Close',
    manageAgents: 'Agents',
    save: 'Save',
    selectAtLeastOneAgent: 'Select at least one agent',
    noAgents: 'No agents',
    agentsFor: 'Agents for'
};
%>
<!DOCTYPE html>
<html lang="<%= currentLang === 'ar' ? 'ar' : 'en' %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sokrat VOIP - <%= t.title %></title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <script src="/js/tailwindcss-browser.js"></script>
    <style>
        :root { --bg-primary:#000; --bg-secondary:#121212; --bg-card:#18181b; --bg-hover:#27272a; --border-primary:#27272a; --text-primary:#fff; --text-secondary:#a1a1aa; --text-muted:#71717a; --accent-color:#e11d48; }
        body { background: var(--bg-primary); color: var(--text-primary); font-family: 'Cairo','Segoe UI',sans-serif; min-height:100vh; }
        .panel-surface { background: var(--bg-secondary); border:1px solid var(--border-primary); border-radius:1rem; }
        .config-input { width:100%; background:#09090b; border:1px solid var(--border-primary); border-radius:.7rem; padding:.65rem .8rem; color:var(--text-primary); font-size:.8rem; outline:none; }
        .config-input:focus { border-color:var(--accent-color); }
        .badge { display:inline-flex; align-items:center; padding:.2rem .55rem; border-radius:999px; font-size:.65rem; font-weight:800; }
        .badge-active { background:rgba(16,185,129,.12); color:#34d399; border:1px solid rgba(16,185,129,.25); }
        .badge-suspended { background:rgba(245,158,11,.12); color:#fbbf24; border:1px solid rgba(245,158,11,.25); }
.multi-menu { position:absolute; top:calc(100% + 6px); left:0; right:0; z-index:80; max-height:220px; overflow-y:auto; background:var(--bg-card); border:1px solid var(--border-primary); border-radius:.8rem; padding:.55rem; box-shadow:0 18px 50px rgba(0,0,0,.55); }
        .multi-option { display:flex; align-items:center; gap:.5rem; padding:.42rem .5rem; border-radius:.5rem; cursor:pointer; font-size:.72rem; }
        .multi-option:hover { background:var(--bg-hover); }
        .multi-option input { accent-color: var(--accent-color); width:14px; height:14px; }
        .btn { border-radius:.65rem; padding:.55rem .8rem; font-size:.72rem; font-weight:800; cursor:pointer; border:1px solid var(--border-primary); background:var(--bg-hover); color:var(--text-primary); }
        .btn-primary { background:var(--accent-color); border-color:var(--accent-color); color:#fff; }
        .btn:hover { filter:brightness(1.08); }
        .modal-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.75); display:none; align-items:center; justify-content:center; padding:16px; z-index:1000; }
        .modal-backdrop.open { display:flex; }
        .modal { width:min(560px,96vw); max-height:92vh; overflow:auto; background:var(--bg-card); border:1px solid var(--border-primary); border-radius:1.25rem; padding:22px; }
        .toast { position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:#18181b; border:1px solid var(--border-primary); padding:12px 18px; border-radius:.8rem; font-size:.8rem; z-index:2000; opacity:0; pointer-events:none; transition:.2s; }
        .toast.show { opacity:1; }
        .code { font-family:monospace; font-size:.7rem; background:#09090b; border:1px solid var(--border-primary); border-radius:.6rem; padding:.65rem; overflow:auto; white-space:pre-wrap; word-break:break-all; }
    </style>
</head>
<body class="flex flex-col md:flex-row min-h-screen m-0 p-0">
    <%- include('sidebar') %>
    <div class="flex-1 min-w-0 p-6 md:p-8 relative flex flex-col min-h-screen w-full">
        <div class="w-full space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl md:text-3xl font-black tracking-tight"><%= t.title %></h1>
                    <p class="text-xs text-[var(--text-muted)] mt-1"><%= t.subtitle %></p>
                </div>
                <button type="button" class="btn btn-primary" onclick="openCreateModal()">+ <%= t.newTenant %></button>
            </div>

            <div class="panel-surface overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-[10px] uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-primary)]">
                            <th class="text-start p-3"><%= t.business %></th>
                            <th class="text-start p-3"><%= t.status %></th>
                            <th class="text-start p-3"><%= t.ringGroup %></th>
                            <th class="text-start p-3"><%= t.pool %></th>
                            <th class="text-start p-3"><%= t.active %></th>
                            <th class="text-start p-3"><%= t.link %></th>
                            <th class="text-start p-3"><%= t.actions %></th>
                        </tr>
                    </thead>
                    <tbody id="tenantsBody">
                        <tr><td colspan="7" class="p-8 text-center text-[var(--text-muted)]"><%= t.loading %></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal-backdrop" id="createModal">
        <div class="modal">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-black"><%= t.newTenant %></h2>
                <button type="button" class="btn" onclick="closeCreateModal()">✕</button>
            </div>
            <form id="createTenantForm" class="space-y-3">
                <div>
                    <label for="tenantName" class="block text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.name %></label>
                    <input id="tenantName" class="config-input" name="name" required maxlength="120" placeholder="Acme Ltd">
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="relative" id="tenantAgentsWrap">
                        <span id="tenantAgentsLabel" class="block text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.agents %></span>
                        <button type="button" id="tenantAgentsBtn" class="config-input flex items-center justify-between text-start cursor-pointer" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="tenantAgentsLabel">
                            <span id="tenantAgentsSummary" class="truncate text-xs font-semibold text-[var(--text-muted)]"><%= t.selectExtensions %></span>
                            <svg class="w-3.5 h-3.5 text-[var(--text-muted)] shrink-0 ms-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div id="tenantAgentsMenu" class="multi-menu hidden" role="listbox" aria-multiselectable="true">
                            <div class="flex items-center justify-between pb-1.5 mb-1 border-b border-[var(--border-primary)] text-[10px]">
                                <button type="button" class="text-[var(--accent-color)] font-bold" onclick="selectAllTenantAgents(true)"><%= t.selectAll %></button>
                                <button type="button" class="text-[var(--text-muted)] font-bold" onclick="selectAllTenantAgents(false)"><%= t.clearAll %></button>
                            </div>
                            <% if (typeof roster !== 'undefined' && roster && roster.length > 0) { %>
                                <% roster.forEach(emp => { %>
                                    <% const isAssigned = (typeof assignedExtensions !== 'undefined' && assignedExtensions.map(String).includes(String(emp.extension))); %>
                                    <label class="multi-option" style="<%= isAssigned ? 'opacity:.45;cursor:not-allowed;' : '' %>">
                                        <input type="checkbox" class="tenantAgentCheckbox" value="<%= emp.extension %>" <%= isAssigned ? 'disabled' : '' %>>
                                        <span class="font-mono font-bold text-[var(--text-primary)]"><%= emp.extension %></span>
                                        <span class="truncate text-[var(--text-muted)]"><%= emp.name %></span>
                                        <% if (isAssigned) { %><span class="ms-auto text-[9px] font-bold text-[var(--text-muted)]"><%= isRtl ? 'مُسند' : 'assigned' %></span><% } %>
                                    </label>
                                <% }); %>
                            <% } else { %>
                                <p class="py-3 text-center text-[10px] text-[var(--text-muted)]"><%= t.noExtensions %></p>
                            <% } %>
                        </div>
                        <input type="hidden" id="tenantAgents" name="agent_extensions" value="">
                    </div>
                    <div>
                        <label for="tenantRingGroup" class="block text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.ringGroupOptional %></label>
                        <input id="tenantRingGroup" class="config-input" name="ring_group" placeholder="7001">
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label for="tenantConcurrency" class="block text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.concurrency %></label>
                        <input id="tenantConcurrency" class="config-input" name="max_concurrency" type="number" min="1" max="50" value="5">
                    </div>
                    <div>
                        <label for="tenantPoolSize" class="block text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.poolSize %></label>
                        <input id="tenantPoolSize" class="config-input" name="pool_size" type="number" min="1" max="50" value="5">
                    </div>
                </div>
                <div class="rounded-xl border border-[var(--border-primary)] bg-[var(--bg-primary)]/60 p-3">
                    <div class="text-[11px] font-bold text-[var(--text-secondary)]"><%= t.publicLink %></div>
                    <p class="text-[10px] text-[var(--text-muted)] mt-1 leading-relaxed"><%= t.linkAutoNote %></p>
                </div>
                <div>
                    <label for="tenantOrigins" class="block text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.origins %></label>
                    <input id="tenantOrigins" class="config-input" name="allowed_origins" placeholder="https://acme.example, https://www.acme.example">
                </div>
                <label for="tenantRecording" class="flex items-center gap-2 text-xs font-bold text-[var(--text-secondary)]">
                    <input id="tenantRecording" type="checkbox" name="recording_enabled" checked>
                    <%= t.recording %>
                </label>
                <div class="flex justify-end gap-2 pt-2">
                    <button type="button" class="btn" onclick="closeCreateModal()"><%= t.cancel %></button>
                    <button type="submit" class="btn btn-primary" id="createTenantBtn"><%= t.create %></button>
                </div>
            </form>
        </div>
    </div>

    <div class="modal-backdrop" id="agentsModal">
        <div class="modal">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-black"><%= t.agentsFor %> <span id="agentsTenantName" class="text-[var(--accent-color)]"></span></h2>
                <button type="button" class="btn" onclick="closeAgentsModal()">✕</button>
            </div>
            <p class="text-[10px] text-[var(--text-muted)] mb-3"><%= isRtl ? 'التحويلات المرتبطة بنشاط آخر تظهر معطلة. اختر موظفي هذا النشاط.' : 'Extensions assigned to another business are disabled. Select the agents for this business.' %></p>
            <select id="tenantAgentsEdit" multiple size="9" class="config-input h-auto"></select>
            <div class="flex justify-end gap-2 pt-4">
                <button type="button" class="btn" onclick="closeAgentsModal()"><%= t.cancel %></button>
                <button type="button" class="btn btn-primary" id="saveTenantAgentsBtn" onclick="saveTenantAgents()"><%= t.save %></button>
            </div>
        </div>
    </div>

    <div class="modal-backdrop" id="linkModal">
        <div class="modal">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-black"><%= t.publicLink %></h2>
                <button type="button" class="btn" onclick="closeLinkModal()">✕</button>
            </div>
            <div class="space-y-3">
                <div>
                    <div class="text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.publicLink %></div>
                    <div class="code" id="linkModalUrl"></div>
                </div>
                <div>
                    <div class="text-[11px] font-bold text-[var(--text-secondary)] mb-1"><%= t.snippet %></div>
                    <div class="code" id="linkModalSnippet"></div>
                </div>
                <div class="flex justify-end gap-2">
                    <button type="button" class="btn" onclick="copyModalUrl()"><%= t.copy %></button>
                    <button type="button" class="btn btn-primary" onclick="copyModalSnippet()"><%= t.copyEmbed %></button>
                </div>
            </div>
        </div>
    </div>

    <div class="toast" id="tenantToast"></div>

    <script>
        const T = <%- JSON.stringify(t) %>;
        const ROSTER = <%- JSON.stringify((typeof roster !== 'undefined' ? roster : []).map(e => ({ extension: String(e.extension), name: e.name || '' }))).replace(/</g, '\\u003c') %>;
        let tenants = [];
        let agentsTenantId = null;
        let modalLink = null;

        function escapeHtml(value) {
            return String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[ch]));
        }
        function toast(message) {
            const el = document.getElementById('tenantToast');
            el.textContent = message;
            el.classList.add('show');
            setTimeout(() => el.classList.remove('show'), 2200);
        }
        function updateTenantAgentSummary() {
            const hidden = document.getElementById('tenantAgents');
            const summary = document.getElementById('tenantAgentsSummary');
            const checks = Array.from(document.querySelectorAll('.tenantAgentCheckbox:checked:not(:disabled)')).map(cb => cb.value.trim()).filter(Boolean);
            if (hidden) hidden.value = checks.join(',');
            if (!summary) return;
            if (checks.length === 0) {
                summary.textContent = T.selectExtensions;
                summary.className = 'truncate text-xs font-semibold text-[var(--text-muted)]';
            } else {
                summary.textContent = checks.join(', ');
                summary.className = 'truncate text-xs font-bold text-[var(--text-primary)] font-mono';
            }
        }
        function toggleTenantAgentsMenu(force) {
            const menu = document.getElementById('tenantAgentsMenu');
            const btn = document.getElementById('tenantAgentsBtn');
            if (!menu || !btn) return;
            const open = typeof force === 'boolean' ? force : menu.classList.contains('hidden');
            menu.classList.toggle('hidden', !open);
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        }
        function selectAllTenantAgents(checked) {
            document.querySelectorAll('.tenantAgentCheckbox').forEach(cb => { if (!cb.disabled) cb.checked = Boolean(checked); });
            updateTenantAgentSummary();
        }

        function openAgentsModal(tenantId) {
            const tenant = tenants.find(item => Number(item.id) === Number(tenantId));
            if (!tenant) return;
            agentsTenantId = tenant.id;
            document.getElementById('agentsTenantName').textContent = tenant.name;
            const select = document.getElementById('tenantAgentsEdit');
            select.innerHTML = '';
            const current = new Set((tenant.agents || []).map(String));
            const otherAssigned = new Set();
            tenants.forEach(item => {
                if (Number(item.id) !== Number(tenant.id)) {
                    (item.agents || []).forEach(ext => otherAssigned.add(String(ext)));
                }
            });
            if (!ROSTER.length) {
                const option = document.createElement('option');
                option.textContent = T.noExtensions;
                option.disabled = true;
                select.appendChild(option);
            }
            ROSTER.forEach(emp => {
                const option = document.createElement('option');
                option.value = emp.extension;
                option.textContent = emp.extension + ' - ' + emp.name;
                option.disabled = otherAssigned.has(String(emp.extension));
                option.selected = current.has(String(emp.extension));
                select.appendChild(option);
            });
            document.getElementById('agentsModal').classList.add('open');
        }
        function closeAgentsModal() {
            document.getElementById('agentsModal').classList.remove('open');
        }
        async function saveTenantAgents() {
            if (!agentsTenantId) return;
            const select = document.getElementById('tenantAgentsEdit');
            const selected = Array.from(select.options).filter(option => option.selected && !option.disabled).map(option => option.value);
            if (selected.length === 0) {
                toast(T.selectAtLeastOneAgent);
                return;
            }
            const button = document.getElementById('saveTenantAgentsBtn');
            button.disabled = true;
            try {
                const response = await fetch('/api/admin/tenants/' + agentsTenantId, {
                    method: 'PUT',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ agent_extensions: selected.join(',') })
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.error || T.failed);
                closeAgentsModal();
                toast(T.created);
                await loadTenants();
            } catch (error) {
                toast(error.message);
            } finally {
                button.disabled = false;
            }
        }

        function snippetFor(tenant, link) {
            return '<' + 'script src="' + window.location.origin + '/js/sokrat-call-widget.js" data-tenant="' +
                tenant.public_id + '" data-link="' + link.slug + '" data-label="Call us"><' + '/script>';
        }
        async function loadTenants() {
            const body = document.getElementById('tenantsBody');
            try {
                const response = await fetch('/api/admin/tenants', { credentials: 'same-origin' });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.error || 'Failed to load tenants');
                tenants = data.tenants || [];
                renderTenants();
            } catch (error) {
                body.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-red-400">' + escapeHtml(error.message) + '</td></tr>';
            }
        }
        function renderTenants() {
            const body = document.getElementById('tenantsBody');
            if (!tenants.length) {
                body.innerHTML = '<tr><td colspan="7" class="p-8 text-center text-[var(--text-muted)]">' + T.empty + '</td></tr>';
                return;
            }
            body.innerHTML = tenants.map(tenant => {
                const link = (tenant.links || [])[0];
                const statusClass = tenant.status === 'active' ? 'badge-active' : 'badge-suspended';
                const linkCell = link
                    ? '<button class="btn" onclick="showLink(' + tenant.id + ')">' + T.copy + '</button>'
                    : '<span class="text-[var(--text-muted)]">—</span>';
                const toggle = tenant.status === 'active'
                    ? '<button class="btn" onclick="toggleTenant(' + tenant.id + ', \'suspended\')">' + T.suspend + '</button>'
                    : '<button class="btn" onclick="toggleTenant(' + tenant.id + ', \'active\')">' + T.activate + '</button>';
                const agents = Array.isArray(tenant.agents) ? tenant.agents : [];
                const agentInfo = agents.length
                    ? '<div class="text-[10px] text-[var(--text-muted)] mt-1">' + escapeHtml(agents.join(', ')) + '</div>'
                    : '<div class="text-[10px] font-bold text-amber-400 mt-1">⚠ ' + T.noAgents + '</div>';
                return '<tr class="border-b border-[var(--border-primary)]/60">' +
                    '<td class="p-3 font-bold">' + escapeHtml(tenant.name) + '<div class="text-[10px] text-[var(--text-muted)]">' + escapeHtml(tenant.public_id) + '</div>' + agentInfo + '</td>' +
                    '<td class="p-3"><span class="badge ' + statusClass + '">' + escapeHtml(tenant.status) + '</span></td>' +
                    '<td class="p-3 font-mono">' + escapeHtml(tenant.ring_group) + '</td>' +
                    '<td class="p-3 font-mono">' + (tenant.pool_free ?? '—') + ' / ' + (tenant.pool_total ?? '—') + '</td>' +
                    '<td class="p-3 font-mono">' + (tenant.active_sessions ?? 0) + '</td>' +
                    '<td class="p-3">' + linkCell + '</td>' +
                    '<td class="p-3"><div class="flex gap-2"><button class="btn" onclick="openAgentsModal(' + tenant.id + ')">' + T.manageAgents + '</button>' + toggle + '</div></td>' +
                    '</tr>';
            }).join('');
        }
        function showLink(tenantId) {
            const tenant = tenants.find(item => Number(item.id) === Number(tenantId));
            const link = tenant && tenant.links && tenant.links[0];
            if (!link) return;
            modalLink = { tenant, link };
            document.getElementById('linkModalUrl').textContent = link.public_url || '';
            document.getElementById('linkModalSnippet').textContent = snippetFor(tenant, link);
            document.getElementById('linkModal').classList.add('open');
        }
        function closeLinkModal() {
            document.getElementById('linkModal').classList.remove('open');
        }
        async function copyText(text) {
            try {
                await navigator.clipboard.writeText(text);
                toast(T.copied);
            } catch (_) {
                window.prompt(T.copy, text);
            }
        }
        function copyModalUrl() {
            if (modalLink) copyText(document.getElementById('linkModalUrl').textContent);
        }
        function copyModalSnippet() {
            if (modalLink) copyText(document.getElementById('linkModalSnippet').textContent);
        }
        function openCreateModal() {
            document.getElementById('createModal').classList.add('open');
        }
        function closeCreateModal() {
            document.getElementById('createModal').classList.remove('open');
        }
        async function toggleTenant(tenantId, status) {
            const response = await fetch('/api/admin/tenants/' + tenantId, {
                method: 'PUT',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status })
            });
            const data = await response.json();
            if (!response.ok || !data.success) {
                toast(data.error || T.failed);
                return;
            }
            await loadTenants();
        }
        document.getElementById('createTenantForm').addEventListener('submit', async function (event) {
            event.preventDefault();
            const form = event.currentTarget;
            const button = document.getElementById('createTenantBtn');
            button.disabled = true;
            const formData = new FormData(form);
            if (!formData.get('agent_extensions')) {
                toast(T.selectAtLeastOneAgent);
                button.disabled = false;
                return;
            }
            const payload = {
                name: formData.get('name'),
                agent_extensions: formData.get('agent_extensions'),
                ring_group: formData.get('ring_group') || undefined,
                max_concurrency: Number(formData.get('max_concurrency') || 5),
                pool_size: Number(formData.get('pool_size') || 5),
                recording_enabled: formData.get('recording_enabled') === 'on',
                link: {
                    label: 'Website',
                    allowed_origins: formData.get('allowed_origins') || ''
                }
            };
            try {
                const response = await fetch('/api/admin/tenants', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await response.json();
                if (!response.ok || !data.success) throw new Error(data.error || T.failed);
                closeCreateModal();
                form.reset();
                updateTenantAgentSummary();
                toast(T.created);
                await loadTenants();
                if (data.tenant && data.link) {
                    modalLink = { tenant: data.tenant, link: data.link };
                    document.getElementById('linkModalUrl').textContent = data.link.public_url || '';
                    document.getElementById('linkModalSnippet').textContent = snippetFor(data.tenant, data.link);
                    document.getElementById('linkModal').classList.add('open');
                }
            } catch (error) {
                toast(error.message);
            } finally {
                button.disabled = false;
            }
        });
        document.querySelectorAll('.modal-backdrop').forEach(el => {
            el.addEventListener('click', event => { if (event.target === el) el.classList.remove('open'); });
        });
        const tenantAgentsBtn = document.getElementById('tenantAgentsBtn');
        if (tenantAgentsBtn) {
            tenantAgentsBtn.addEventListener('click', event => {
                event.stopPropagation();
                toggleTenantAgentsMenu();
            });
        }
        document.querySelectorAll('.tenantAgentCheckbox').forEach(cb => {
            cb.addEventListener('change', updateTenantAgentSummary);
        });
        document.addEventListener('click', event => {
            const wrap = document.getElementById('tenantAgentsWrap');
            if (wrap && !wrap.contains(event.target)) toggleTenantAgentsMenu(false);
        });
        updateTenantAgentSummary();
        loadTenants();
    </script>
</body>
</html>

    <script>
        // --- VOICEMAIL STORAGE & RETENTION MODAL JS ---
        const vmWords = {
            purging: <%- JSON.stringify(t.purging || 'Purging...') %>,
            purgeSuccess: <%- JSON.stringify(t.purgeSuccess || 'Successfully purged {count} voicemails, freeing {size}.') %>,
            saveSuccess: <%- JSON.stringify(t.saveSuccess || 'Settings updated successfully.') %>,
            saving: <%- JSON.stringify(t.saving || 'Saving...') %>,
            purgeConfirm: <%- JSON.stringify(t.purgeConfirm || 'Are you sure you want to delete all voicemails older than {days} days? This action cannot be undone.') %>
        };

        async function openVmStorageModal() {
            const modal = document.getElementById('vmStorageModal');
            if (!modal) return;
            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');

            try {
                const res = await fetch('/api/voicemail-storage/settings');
                const data = await res.json();
                if (data && data.success) {
                    populateVmStorageUI(data.settings, data.stats);
                }
            } catch (err) {
                console.error('Failed to load voicemail storage settings:', err);
            }
        }

        function closeVmStorageModal() {
            const modal = document.getElementById('vmStorageModal');
            if (!modal) return;
            modal.classList.remove('opacity-100', 'pointer-events-auto');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        function populateVmStorageUI(settings, stats) {
            if (settings) {
                const maxMsgInput = document.getElementById('vmMaxMsgInput');
                const maxSecsInput = document.getElementById('vmMaxSecsInput');
                const retentionInput = document.getElementById('vmRetentionDaysInput');
                const autoPurgeToggle = document.getElementById('vmAutoPurgeToggle');
                if (maxMsgInput) maxMsgInput.value = settings.max_messages || 1000;
                if (maxSecsInput) maxSecsInput.value = settings.max_duration_sec || 300;
                if (retentionInput) retentionInput.value = settings.retention_days || 90;
                if (autoPurgeToggle) autoPurgeToggle.checked = !!settings.auto_purge_enabled;
            }
            if (stats) {
                const statMsgs = document.getElementById('vmStatMsgs');
                const statDisk = document.getElementById('vmStatDisk');
                const statMailboxes = document.getElementById('vmStatMailboxes');
                if (statMsgs) statMsgs.textContent = stats.totalMessages || 0;
                if (statDisk) statDisk.textContent = stats.totalSizeFormatted || '0 KB';
                if (statMailboxes) statMailboxes.textContent = stats.mailboxesCount || 0;
            }
        }

        async function saveVmStorageSettings(e) {
            e.preventDefault();
            const saveBtn = document.getElementById('vmSaveSettingsBtn');
            const msgEl = document.getElementById('vmStorageMsg');
            const max_messages = parseInt(document.getElementById('vmMaxMsgInput').value, 10);
            const max_duration_sec = parseInt(document.getElementById('vmMaxSecsInput').value, 10);
            const retention_days = parseInt(document.getElementById('vmRetentionDaysInput').value, 10);
            const auto_purge_enabled = document.getElementById('vmAutoPurgeToggle').checked ? 1 : 0;

            saveBtn.disabled = true;
            const origText = saveBtn.innerHTML;
            saveBtn.textContent = vmWords.saving;

            try {
                const res = await fetch('/api/voicemail-storage/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ max_messages, max_duration_sec, retention_days, auto_purge_enabled })
                });
                const data = await res.json();
                if (data && data.success) {
                    populateVmStorageUI(data.settings, data.stats);
                    if (typeof showToast === 'function') {
                        showToast(vmWords.saveSuccess, 'success');
                    }
                    if (msgEl) {
                        msgEl.className = 'text-xs text-center py-1 text-emerald-400 font-bold';
                        msgEl.textContent = vmWords.saveSuccess;
                        msgEl.classList.remove('hidden');
                        setTimeout(() => {
                            msgEl.classList.add('hidden');
                            closeVmStorageModal();
                        }, 1200);
                    }
                } else {
                    if (msgEl) {
                        msgEl.className = 'text-xs text-center py-1 text-red-400 font-bold';
                        msgEl.textContent = (data && data.error) ? data.error : 'Failed to save settings';
                        msgEl.classList.remove('hidden');
                    }
                }
            } catch (err) {
                if (msgEl) {
                    msgEl.className = 'text-xs text-center py-1 text-red-400 font-bold';
                    msgEl.textContent = err.message;
                    msgEl.classList.remove('hidden');
                }
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origText;
            }
        }

        async function runVmPurgeNow() {
            const retention_days = parseInt(document.getElementById('vmRetentionDaysInput').value, 10) || 90;
            const confirmMsg = vmWords.purgeConfirm.replace('{days}', retention_days);
            if (!confirm(confirmMsg)) return;

            const purgeBtn = document.getElementById('vmPurgeNowBtn');
            const msgEl = document.getElementById('vmStorageMsg');
            purgeBtn.disabled = true;
            const origText = purgeBtn.innerHTML;
            purgeBtn.textContent = vmWords.purging;

            try {
                const res = await fetch('/api/voicemail-storage/purge', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ retention_days })
                });
                const data = await res.json();
                if (data && data.success) {
                    populateVmStorageUI(null, data.stats);
                    const successMsg = vmWords.purgeSuccess.replace('{count}', data.purgedCount).replace('{size}', data.freedFormatted);
                    if (typeof showToast === 'function') {
                        showToast(successMsg, 'success');
                    }
                    if (msgEl) {
                        msgEl.className = 'text-xs text-center py-1 text-emerald-400 font-bold';
                        msgEl.textContent = successMsg;
                        msgEl.classList.remove('hidden');
                    }
                    // If messages were purged, refresh page list after 1.5s
                    if (data.purgedCount > 0) {
                        setTimeout(() => {
                            window.location.reload();
                        }, 1500);
                    }
                } else {
                    if (msgEl) {
                        msgEl.className = 'text-xs text-center py-1 text-red-400 font-bold';
                        msgEl.textContent = (data && data.error) ? data.error : 'Purge failed';
                        msgEl.classList.remove('hidden');
                    }
                }
            } catch (err) {
                if (msgEl) {
                    msgEl.className = 'text-xs text-center py-1 text-red-400 font-bold';
                    msgEl.textContent = err.message;
                    msgEl.classList.remove('hidden');
                }
            } finally {
                purgeBtn.disabled = false;
                purgeBtn.innerHTML = origText;
            }
        }
    </script>
</body>
</html>

<%
const lang = (typeof currentLang !== 'undefined' && currentLang) ? currentLang : 'ar';
const isRtl = (lang === 'ar');
%>
<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= isRtl ? 'rtl' : 'ltr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= isRtl ? 'لوحة المراقبة المباشرة للسنترال' : 'Live PBX Monitor' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'JetBrains Mono', 'Cairo', monospace !important; background-color: #f8fafc; color: #0f172a; }
        .action-select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2064748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: <%= isRtl ? 'left 0.75rem center' : 'right 0.75rem center' %>;
            background-size: 1em;
        }
        .presence-timer-badge {
            background-color: rgba(255,255,255,0.6);
            border-radius: 4px;
            padding: 0 4px;
        }
    </style>
</head>
<body class="p-4 sm:p-6 select-none bg-slate-50 text-slate-900">
    <div class="max-w-7xl mx-auto space-y-5">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-200 gap-4">
            <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
                        <span><%= isRtl ? 'لوحة المراقبة المباشرة للسنترال' : 'Live PBX Monitor' %></span>
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">
                        <%= isRtl ? 'مراقبة فورية للتحويلات والمكالمات في السنترال' : 'Real-time monitoring of extensions and calls' %>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 self-end sm:self-auto">
                <button type="button" onclick="openGroupManager()" class="text-xs font-extrabold bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-sm transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    <span><%= isRtl ? 'إدارة المجموعات وحالات PJSIP' : 'Manage Groups & PJSIP' %></span>
                </button>

                <span id="crmUserNameBadge" class="text-xs font-bold bg-white text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200"></span>
                
                <div id="supervisorBadge" class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg border border-emerald-200 flex items-center gap-1.5 <%= session.supervisor_extension ? '' : 'hidden' %>">
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <span><%= isRtl ? 'المشرف:' : 'Supervisor:' %></span>
                    <span id="supervisorExtVal" class="font-mono font-extrabold"><%= session.supervisor_extension || '' %></span>
                </div>
            </div>
        </div>

        <!-- Summary Filter Cards -->
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            <!-- 1. All Extensions -->
            <div data-filter="all" class="top-filter-card cursor-pointer bg-white p-3.5 rounded-xl border-2 border-slate-900 shadow-sm transition hover:shadow flex items-center justify-between active">
                <div>
                    <div class="text-[11px] font-bold text-slate-500"><%= isRtl ? 'الكل' : 'All' %></div>
                    <div id="statTotal" class="text-xl font-black text-slate-900 mt-0.5">0</div>
                </div>
                <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-700 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                </div>
            </div>

            <!-- 2. Online Extensions -->
            <div data-filter="online" class="top-filter-card cursor-pointer bg-white p-3.5 rounded-xl border-2 border-transparent hover:border-emerald-300 shadow-sm transition hover:shadow flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-bold text-slate-500"><%= isRtl ? 'متصل' : 'Online' %></div>
                    <div id="statOnline" class="text-xl font-black text-emerald-600 mt-0.5">0</div>
                </div>
                <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>

            <!-- 3. Active Calls (In Call) -->
            <div data-filter="busy" class="top-filter-card cursor-pointer bg-white p-3.5 rounded-xl border-2 border-transparent hover:border-rose-300 shadow-sm transition hover:shadow flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-bold text-slate-500"><%= isRtl ? 'في مكالمة' : 'In Call' %></div>
                    <div id="statActive" class="text-xl font-black text-rose-600 mt-0.5">0</div>
                </div>
                <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
            </div>

            <!-- 4. Ringing Calls -->
            <div data-filter="ringing" class="top-filter-card cursor-pointer bg-white p-3.5 rounded-xl border-2 border-transparent hover:border-amber-300 shadow-sm transition hover:shadow flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-bold text-slate-500"><%= isRtl ? 'رنين' : 'Ringing' %></div>
                    <div id="statRinging" class="text-xl font-black text-amber-600 mt-0.5">0</div>
                </div>
                <div class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
                    <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                </div>
            </div>

            <!-- 5. Break / DND -->
            <div data-filter="break" class="top-filter-card cursor-pointer bg-white p-3.5 rounded-xl border-2 border-transparent hover:border-purple-300 shadow-sm transition hover:shadow flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-bold text-slate-500"><%= isRtl ? 'استراحة' : 'Break / DND' %></div>
                    <div id="statBreak" class="text-xl font-black text-purple-600 mt-0.5">0</div>
                </div>
                <div class="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>

            <!-- 6. Offline Extensions -->
            <div data-filter="offline" class="top-filter-card cursor-pointer bg-white p-3.5 rounded-xl border-2 border-transparent hover:border-slate-300 shadow-sm transition hover:shadow flex items-center justify-between">
                <div>
                    <div class="text-[11px] font-bold text-slate-500"><%= isRtl ? 'غير متصل' : 'Offline' %></div>
                    <div id="statOffline" class="text-xl font-black text-slate-500 mt-0.5">0</div>
                </div>
                <div class="w-8 h-8 rounded-lg bg-slate-100 text-slate-400 flex items-center justify-center">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                </div>
            </div>
        </div>

        <!-- Search Bar (Filter buttons removed) -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-white p-3 rounded-xl border border-slate-200/80">
            <div class="relative w-full sm:w-80">
                <input id="searchInput" type="text" placeholder="<%= isRtl ? 'بحث بالاسم أو رقم التحويلة...' : 'Search by name or extension...' %>" class="w-full <%= isRtl ? 'pl-9 pr-3' : 'pr-9 pl-3' %> py-2 text-xs rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900">
                <span class="absolute <%= isRtl ? 'left-3' : 'right-3' %> top-2.5 text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
            </div>

            <div class="text-xs font-bold text-slate-500 flex items-center gap-2">
                <span id="activeFilterBadge" class="bg-slate-100 text-slate-800 px-2.5 py-1 rounded-md text-[11px] font-extrabold"><%= isRtl ? 'الكل' : 'All' %></span>
                <span id="resultsCount">0 <%= isRtl ? 'تحويلة' : 'extensions' %></span>
            </div>
        </div>

        <!-- Extensions Grid -->
        <div id="extensionsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <div id="loadingStatus" class="col-span-full text-center py-12 text-slate-400 text-sm font-semibold">
                <%= isRtl ? 'جاري الاتصال بالخادم وتحميل الخطوط...' : 'Connecting to PBX and loading extensions...' %>
            </div>
        </div>

    </div>

    <script>
        (function() {
            const EMBED_TOKEN = <%- safeJsonSerialize(sessionToken) %>;
            let SUPERVISOR_EXT = <%- safeJsonSerialize(session.supervisor_extension) %>;
            const CRM_USER_NAME = <%- safeJsonSerialize(session.crm_user_name) %>;

            document.getElementById('crmUserNameBadge').textContent = CRM_USER_NAME;

            // Socket.IO Connection
            const socket = io('/crm-live', {
                auth: { token: EMBED_TOKEN },
                transports: ['websocket', 'polling']
            });

            let localPeerStatus = {};
            let localCallStatus = {};
            let activeFilter = 'all';
            let searchQuery = '';
            let isDomInitialized = false;

            socket.on('connect_error', (err) => {
                const grid = document.getElementById('extensionsGrid');
                grid.replaceChildren();
                const errDiv = document.createElement('div');
                errDiv.className = 'col-span-full text-center py-12 text-rose-600 font-extrabold text-sm';
                errDiv.textContent = 'فشل الاتصال بسيرفر السنترال';
                grid.appendChild(errDiv);
            });

            socket.on('peerStatus', (data) => {
                localPeerStatus = data || {};
                if (!isDomInitialized) {
                    initGridDom();
                } else {
                    updateAllCardsInPlace();
                }
            });

            socket.on('activeCalls', (data) => {
                const list = data || [];
                localCallStatus = {};
                list.forEach(c => {
                    if (c && c.extension) {
                        localCallStatus[String(c.extension)] = c;
                    }
                });
                updateAllCardsInPlace();
            });

            // Presence status duration timers (dynamic states only - PJSIP only - no timer for static available/offline)
            setInterval(() => {
                const exts = Object.keys(localPeerStatus);
                exts.forEach(ext => {
                    const info = localPeerStatus[ext] || {};
                    const isPjsip = Boolean(info.isPjsip || info.tech === 'pjsip' || ext === '150');
                    if (!isPjsip) return;
                    const presenceTimer = document.getElementById('presenceTimer-' + ext);
                    if (presenceTimer && info.agentStatus && info.agentStatusTime) {
                        const isDynamic = (info.agentStatus !== 'available' && info.agentStatus !== 'offline');
                        if (isDynamic) {
                            presenceTimer.classList.remove('hidden');
                            const elapsedSec = Math.max(0, Math.floor((Date.now() - info.agentStatusTime) / 1000));
                            presenceTimer.textContent = formatTimer(elapsedSec);
                        } else {
                            presenceTimer.classList.add('hidden');
                        }
                    }
                });
            }, 1000);

            // Search & Top Filter Cards Listeners
            document.getElementById('searchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                applyFilterAndSearch();
            });

            document.querySelectorAll('.top-filter-card').forEach(card => {
                card.addEventListener('click', () => {
                    document.querySelectorAll('.top-filter-card').forEach(c => {
                        c.classList.remove('active', 'border-slate-900', 'border-emerald-600', 'border-rose-600', 'border-amber-500', 'border-purple-600', 'border-slate-500');
                        c.classList.add('border-transparent');
                    });
                    card.classList.add('active');
                    activeFilter = card.getAttribute('data-filter');

                    const borderColors = {
                        all: 'border-slate-900',
                        online: 'border-emerald-600',
                        busy: 'border-rose-600',
                        ringing: 'border-amber-500',
                        break: 'border-purple-600',
                        offline: 'border-slate-500'
                    };
                    card.classList.remove('border-transparent');
                    card.classList.add(borderColors[activeFilter] || 'border-slate-900');

                    const badge = document.getElementById('activeFilterBadge');
                    if (badge) {
                        const labels = {
                            all: isRtl ? 'الكل' : 'All',
                            online: isRtl ? 'متصل' : 'Online',
                            busy: isRtl ? 'في مكالمة' : 'In Call',
                            ringing: isRtl ? 'رنين' : 'Ringing',
                            break: isRtl ? 'استراحة' : 'Break',
                            offline: isRtl ? 'غير متصل' : 'Offline'
                        };
                        badge.textContent = labels[activeFilter] || activeFilter;
                    }

                    applyFilterAndSearch();
                });
            });

            function handleSelectAction(targetExt, action) {
                if (!action) return;

                let supExt = SUPERVISOR_EXT;
                if (action !== 'hangup' && !supExt) {
                    supExt = prompt('أدخل رقم تحويتك المباشرة لتنفيذ التحكم:');
                    if (!supExt || !/^\d{2,10}$/.test(supExt.trim())) {
                        alert('رقم التحويلة غير صحيح.');
                        return;
                    }
                    SUPERVISOR_EXT = supExt.trim();
                    document.getElementById('supervisorExtVal').textContent = SUPERVISOR_EXT;
                    document.getElementById('supervisorBadge').classList.remove('hidden');
                }

                const actionLabels = {
                    listen: 'استماع',
                    whisper: 'همس',
                    barge: 'تدخل',
                    hijack: 'سحب المكالمة',
                    hangup: 'إنهاء المكالمة'
                };

                const label = actionLabels[action] || action;
                if (!confirm('تأكيد تنفيذ أمر ' + label + ' على التحويلة ' + targetExt + '?')) return;

                socket.emit('action', { action: action, targetExtension: targetExt, supervisorExtension: SUPERVISOR_EXT }, (res) => {
                    if (res && res.success) {
                        alert(res.message || 'تم تنفيذ الأمر بنجاح');
                    } else {
                        alert((res && res.error) ? res.error : 'فشل تنفيذ الأمر');
                    }
                });
            }

            function formatTimer(seconds) {
                if (isNaN(seconds) || seconds < 0) seconds = 0;
                const mins = Math.floor(seconds / 60);
                const secs = seconds % 60;
                return (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
            }

            // Live 1-second Ticker
            setInterval(() => {
                document.querySelectorAll('[data-start]').forEach(card => {
                    const startMs = parseInt(card.getAttribute('data-start'), 10);
                    if (startMs > 0) {
                        const ext = card.getAttribute('data-ext');
                        const timerEl = document.getElementById('timer-' + ext);
                        if (timerEl) {
                            const elapsed = Math.max(0, Math.floor((Date.now() - startMs) / 1000));
                            timerEl.textContent = formatTimer(elapsed);
                        }
                    }
                });
            }, 1000);

            // Initialize Grid DOM ONCE
            function initGridDom() {
                const grid = document.getElementById('extensionsGrid');
                grid.replaceChildren();

                const exts = Object.keys(localPeerStatus).sort((a, b) => parseInt(a, 10) - parseInt(b, 10));
                if (exts.length === 0) return;

                isDomInitialized = true;

                exts.forEach(ext => {
                    const info = localPeerStatus[ext] || {};

                    const card = document.createElement('div');
                    card.id = 'card-' + ext;
                    card.setAttribute('data-ext', ext);
                    card.className = 'bg-white border border-slate-200/80 rounded-xl p-4 flex flex-col justify-between hover:border-slate-300 transition';

                    card.innerHTML = `
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <div id="avatar-${ext}" class="w-9 h-9 rounded-xl font-mono font-extrabold text-xs flex items-center justify-center bg-slate-100 text-slate-500 border border-slate-200">
                                        ${ext}
                                    </div>
                                    <div>
                                        <div id="name-${ext}" class="font-bold text-sm text-slate-900 leading-tight">${info.name || 'تحويلة ' + ext}</div>
                                        <div class="text-[11px] text-slate-400 font-mono">التحويلة: ${ext}</div>
                                    </div>
                                </div>
                                <div id="badge-${ext}" class="flex items-center gap-1.5 text-[11px] font-extrabold px-2.5 py-1 rounded-full border bg-slate-50 text-slate-500 border-slate-200">
                                    <div id="dot-${ext}" class="w-2 h-2 rounded-full bg-slate-400"></div>
                                    <span id="badgeText-${ext}">غير متصل</span>
                                </div>
                            </div>

                            <!-- Live Agent Presence Status Box (PJSIP Extensions Only) -->
                            <div id="presenceBox-${ext}" class="mt-2 text-xs font-mono p-2 rounded-lg border space-y-1 transition-all bg-slate-50 border-slate-200/80 ${info.isPjsip || info.tech === 'pjsip' || ext === '150' ? '' : 'hidden'}">
                                <div class="flex justify-between items-center">
                                    <span id="presenceLabel-${ext}" class="font-mono text-xs font-bold text-slate-800">متاح (Available)</span>
                                    <strong id="presenceTimer-${ext}" class="font-mono text-xs font-bold text-slate-600 hidden">00:00</strong>
                                </div>
                            </div>

                            <div id="callBox-${ext}" class="hidden mt-2 text-xs font-mono bg-amber-50/70 p-3 rounded-lg border border-amber-200/80 text-slate-800 space-y-1 mb-3">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-500 font-mono text-[11px]">الطرف الآخر:</span>
                                    <strong id="partner-${ext}" class="font-mono text-slate-900">-</strong>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-500 font-mono text-[11px]">حالة المكالمة:</span>
                                    <strong id="stateLabel-${ext}" class="font-mono font-bold text-amber-700">-</strong>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-500 font-mono text-[11px]">المدة الحية:</span>
                                    <strong id="timer-${ext}" class="font-mono text-emerald-600">00:00</strong>
                                </div>
                            </div>
                            <div id="spacer-${ext}" class="h-2"></div>
                        </div>

                        <div class="pt-3 border-t border-slate-100">
                            <select id="actionSelect-${ext}" disabled class="action-select w-full bg-slate-50 text-xs font-bold rounded-lg px-3 py-2 border border-slate-200 text-slate-700 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed transition">
                                <option value="" disabled selected hidden>إجراءات المكالمة</option>
                                <option value="listen">استماع (Listen)</option>
                                <option value="whisper">همس (Whisper)</option>
                                <option value="barge">تدخل (Barge)</option>
                                <option value="hijack" class="font-bold text-rose-600">سحب المكالمة (Hijack)</option>
                                <option value="hangup" class="font-bold text-rose-600">إنهاء المكالمة (Hangup)</option>
                            </select>
                        </div>
                    `;

                    grid.appendChild(card);

                    // Add listener to select element ONCE
                    const selectEl = card.querySelector('#actionSelect-' + ext);
                    selectEl.addEventListener('change', function() {
                        const val = this.value;
                        this.value = '';
                        if (val) {
                            handleSelectAction(ext, val);
                        }
                    });
                });

                updateAllCardsInPlace();
            }

            // In-place DOM update function
            function updateAllCardsInPlace() {
                const exts = Object.keys(localPeerStatus);

                let totalCount = exts.length;
                let onlineCount = 0;
                let busyCount = 0;
                let ringingCount = 0;
                let breakCount = 0;
                let offlineCount = 0;

                exts.forEach(e => {
                    const info = localPeerStatus[e] || {};
                    const call = localCallStatus[e];
                    const isOnline = Boolean(info.online);
                    const isBusy = Boolean(call);
                    const callState = String(call?.state || call?.status || info.status || '').toLowerCase();
                    const isRinging = (isBusy || info.status === 'ringing') && (callState.includes('ring') || callState.includes('dial') || callState.includes('connect') || info.status === 'ringing');
                    const agentStatus = String(info.agentStatus || '').toLowerCase();
                    const isOnBreak = ['break', 'lunch', 'meeting', 'training', 'away', 'dnd'].includes(agentStatus);

                    if (isRinging) {
                        ringingCount++;
                    } else if (isBusy) {
                        busyCount++;
                    } else if (isOnBreak) {
                        breakCount++;
                    } else if (isOnline) {
                        onlineCount++;
                    } else {
                        offlineCount++;
                    }
                });

                document.getElementById('statTotal').textContent = totalCount;
                document.getElementById('statOnline').textContent = onlineCount;
                document.getElementById('statActive').textContent = busyCount;
                if (document.getElementById('statRinging')) document.getElementById('statRinging').textContent = ringingCount;
                if (document.getElementById('statBreak')) document.getElementById('statBreak').textContent = breakCount;
                if (document.getElementById('statOffline')) document.getElementById('statOffline').textContent = offlineCount;

                exts.forEach(ext => {
                    const card = document.getElementById('card-' + ext);
                    if (!card) return;

                    const info = localPeerStatus[ext] || {};
                    const call = localCallStatus[ext];
                    const isOnline = Boolean(info.online);
                    const isBusy = Boolean(call);
                    const isAnswered = isBusy && (
                        call.state === 'In Call' || 
                        call.state === 'in_call' || 
                        call.state === 'Up' || 
                        call.state === 'lead_answered' || 
                        call.state === 'agent_bridged' ||
                        call.state === 'answered'
                    );

                    const avatar = document.getElementById('avatar-' + ext);
                    const badge = document.getElementById('badge-' + ext);
                    const dot = document.getElementById('dot-' + ext);
                    const badgeText = document.getElementById('badgeText-' + ext);
                    const callBox = document.getElementById('callBox-' + ext);
                    const spacer = document.getElementById('spacer-' + ext);
                    const partner = document.getElementById('partner-' + ext);
                    const stateLabel = document.getElementById('stateLabel-' + ext);
                    const timerEl = document.getElementById('timer-' + ext);
                    const selectEl = document.getElementById('actionSelect-' + ext);

                    const presenceBox = document.getElementById('presenceBox-' + ext);
                    const presenceLabel = document.getElementById('presenceLabel-' + ext);
                    const presenceTimer = document.getElementById('presenceTimer-' + ext);

                    // Avatar styling
                    avatar.className = 'w-9 h-9 rounded-xl font-mono font-extrabold text-xs flex items-center justify-center ' + 
                        (isAnswered ? 'bg-amber-500 text-white' : (isBusy ? 'bg-yellow-400 text-slate-900' : (isOnline ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-500 border border-slate-200')));

                    // Badge styling
                    badge.className = 'flex items-center gap-1.5 text-[11px] font-extrabold px-2.5 py-1 rounded-full border ' +
                        (isAnswered 
                            ? 'bg-amber-50 text-amber-700 border-amber-200'
                            : (isBusy 
                                ? 'bg-yellow-50 text-yellow-800 border-yellow-300 animate-pulse'
                                : (isOnline 
                                    ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
                                    : 'bg-slate-50 text-slate-500 border-slate-200')));

                    dot.className = 'w-2 h-2 rounded-full ' + (isAnswered ? 'bg-amber-500' : (isBusy ? 'bg-yellow-500' : (isOnline ? 'bg-emerald-500' : 'bg-slate-400')));
                    badgeText.textContent = isBusy ? (isAnswered ? 'في مكالمة' : 'يرن...') : (isOnline ? 'متصل' : 'غير متصل');

                    // Live Agent Presence Status (PJSIP extensions only)
                    if (presenceBox && presenceLabel) {
                        const isPjsip = Boolean(info.isPjsip || info.tech === 'pjsip' || ext === '150');
                        if (!isPjsip) {
                            presenceBox.classList.add('hidden');
                        } else {
                            presenceBox.classList.remove('hidden');
                            const agentStatus = info.agentStatus || 'available';
                            const agentStatusTime = info.agentStatusTime || null;
                            const isDynamicStatus = (agentStatus !== 'available' && agentStatus !== 'offline');

                            let statusLabel = agentStatus;
                            if (agentStatus === 'break') statusLabel = isRtl ? 'استراحة (Break)' : 'Break';
                            else if (agentStatus === 'lunch') statusLabel = isRtl ? 'غداء (Lunch)' : 'Lunch';
                            else if (agentStatus === 'meeting') statusLabel = isRtl ? 'اجتماع (Meeting)' : 'Meeting';
                            else if (agentStatus === 'training') statusLabel = isRtl ? 'تدريب (Training)' : 'Training';
                            else if (agentStatus === 'available') statusLabel = isRtl ? 'متاح (Available)' : 'Available';
                            else if (agentStatus === 'offline') statusLabel = isRtl ? 'غير متاح (Offline)' : 'Offline';

                            presenceLabel.textContent = statusLabel;

                            let presenceBgClass = 'bg-slate-100 border-slate-200 text-slate-800';
                            let presenceLabelClass = 'text-slate-800';
                            let presenceTimerClass = 'text-slate-600';

                            if (agentStatus === 'break') {
                                presenceBgClass = 'bg-amber-100 border-amber-300 text-amber-950 shadow-sm';
                                presenceLabelClass = 'text-amber-950 font-bold';
                                presenceTimerClass = 'text-amber-900 font-extrabold';
                            } else if (agentStatus === 'lunch') {
                                presenceBgClass = 'bg-sky-100 border-sky-300 text-sky-950 shadow-sm';
                                presenceLabelClass = 'text-sky-950 font-bold';
                                presenceTimerClass = 'text-sky-900 font-extrabold';
                            } else if (agentStatus === 'meeting') {
                                presenceBgClass = 'bg-purple-100 border-purple-300 text-purple-950 shadow-sm';
                                presenceLabelClass = 'text-purple-950 font-bold';
                                presenceTimerClass = 'text-purple-900 font-extrabold';
                            } else if (agentStatus === 'training') {
                                presenceBgClass = 'bg-blue-100 border-blue-300 text-blue-950 shadow-sm';
                                presenceLabelClass = 'text-blue-950 font-bold';
                                presenceTimerClass = 'text-blue-900 font-extrabold';
                            } else if (agentStatus === 'available') {
                                presenceBgClass = 'bg-emerald-100 border-emerald-300 text-emerald-950 shadow-sm';
                                presenceLabelClass = 'text-emerald-950 font-bold';
                                presenceTimerClass = 'text-emerald-900 font-extrabold';
                            } else if (agentStatus === 'offline') {
                                presenceBgClass = 'bg-slate-200 border-slate-300 text-slate-800';
                                presenceLabelClass = 'text-slate-800 font-bold';
                                presenceTimerClass = 'text-slate-700 font-extrabold';
                            }

                            presenceBox.className = 'mt-2 text-xs font-mono p-2 rounded-lg border space-y-1 transition-all ' + presenceBgClass;
                            presenceLabel.className = 'font-mono text-xs font-bold ' + presenceLabelClass;

                            if (isDynamicStatus && agentStatusTime && presenceTimer) {
                                presenceTimer.classList.remove('hidden');
                                presenceTimer.className = 'font-mono text-xs font-extrabold ' + presenceTimerClass;
                                const elapsedSec = Math.max(0, Math.floor((Date.now() - agentStatusTime) / 1000));
                                presenceTimer.textContent = formatTimer(elapsedSec);
                            } else if (presenceTimer) {
                                presenceTimer.classList.add('hidden');
                            }
                        }
                    }

                    // Active Call details & timer
                    if (call) {
                        callBox.classList.remove('hidden');
                        spacer.classList.add('hidden');

                        partner.textContent = call.partner || '-';
                        stateLabel.textContent = isAnswered ? 'في مكالمة (نشطة)' : 'جاري الرنين...';

                        // Initialize or preserve start timestamp
                        if (!card.getAttribute('data-start')) {
                            const startMs = call.started_at || Date.now();
                            card.setAttribute('data-start', startMs);
                        }

                        const currentStart = parseInt(card.getAttribute('data-start'), 10);
                        const elapsedSec = Math.max(0, Math.floor((Date.now() - currentStart) / 1000));
                        timerEl.textContent = formatTimer(elapsedSec);

                        // Unlock Call Actions Dropdown
                        selectEl.disabled = false;
                    } else {
                        card.removeAttribute('data-start');
                        callBox.classList.add('hidden');
                        spacer.classList.remove('hidden');

                        // Lock Call Actions Dropdown when idle
                        selectEl.disabled = true;
                        selectEl.value = '';
                    }
                });

                applyFilterAndSearch();
            }

            function applyFilterAndSearch() {
                const exts = Object.keys(localPeerStatus);
                let visibleCount = 0;

                exts.forEach(ext => {
                    const card = document.getElementById('card-' + ext);
                    if (!card) return;

                    const info = localPeerStatus[ext] || {};
                    const call = localCallStatus[ext];
                    const isOnline = Boolean(info.online);
                    const isBusy = Boolean(call);
                    const callState = String(call?.state || call?.status || info.status || '').toLowerCase();
                    const isRinging = (isBusy || info.status === 'ringing') && (callState.includes('ring') || callState.includes('dial') || callState.includes('connect') || info.status === 'ringing');
                    const agentStatus = String(info.agentStatus || '').toLowerCase();
                    const isOnBreak = ['break', 'lunch', 'meeting', 'training', 'away', 'dnd'].includes(agentStatus);

                    let visible = true;
                    if (activeFilter === 'online' && (isBusy || isOnBreak || !isOnline)) visible = false;
                    if (activeFilter === 'busy' && (!isBusy || isRinging)) visible = false;
                    if (activeFilter === 'ringing' && !isRinging) visible = false;
                    if (activeFilter === 'break' && (isBusy || !isOnBreak)) visible = false;
                    if (activeFilter === 'offline' && (isOnline || isBusy)) visible = false;

                    if (searchQuery) {
                        const nameStr = (info.name || '').toLowerCase();
                        if (!ext.includes(searchQuery) && !nameStr.includes(searchQuery)) visible = false;
                    }

                    if (visible) {
                        card.classList.remove('hidden');
                        visibleCount++;
                    } else {
                        card.classList.add('hidden');
                    }
                });

                const countEl = document.getElementById('resultsCount');
                if (countEl) {
                    countEl.textContent = visibleCount + (isRtl ? ' تحويلة' : ' extensions');
                }
            }
        })();

        // Group & PJSIP Status Manager
        let cachedGroupsData = [];
        const isRtl = <%= isRtl %>;

        function formatGroupName(groupOrName, isRtl) {
            if (!groupOrName) return isRtl ? 'بدون مجموعة' : 'Ungrouped';
            let name = '';
            let nameAr = '';
            let nameEn = '';
            if (typeof groupOrName === 'object') {
                name = groupOrName.name || '';
                nameAr = groupOrName.name_ar || '';
                nameEn = groupOrName.name_en || '';
            } else {
                name = String(groupOrName || '');
            }
            if (name === '___ungrouped___') return isRtl ? 'بدون مجموعة' : 'Ungrouped';
            if (isRtl && nameAr) return nameAr;
            if (!isRtl && nameEn) return nameEn;
            const parenMatch = name.match(/^([^(]+?)\s*\(([^)]+)\)$/);
            if (parenMatch) {
                const p1 = parenMatch[1].trim();
                const p2 = parenMatch[2].trim();
                const hasAr1 = /[\u0600-\u06FF]/.test(p1);
                const hasAr2 = /[\u0600-\u06FF]/.test(p2);
                if (hasAr1 && !hasAr2) return isRtl ? p1 : p2;
                if (!hasAr1 && hasAr2) return isRtl ? p2 : p1;
                return isRtl ? p1 : p2;
            }
            const slashMatch = name.match(/^([^\/]+?)\s*[\/|]\s*(.+)$/);
            if (slashMatch) {
                const p1 = slashMatch[1].trim();
                const p2 = slashMatch[2].trim();
                const hasAr1 = /[\u0600-\u06FF]/.test(p1);
                const hasAr2 = /[\u0600-\u06FF]/.test(p2);
                if (hasAr1 && !hasAr2) return isRtl ? p1 : p2;
                if (!hasAr1 && hasAr2) return isRtl ? p2 : p1;
                return isRtl ? p1 : p2;
            }
            return name;
        }

        function switchGroupModalTab(tab) {
            const btnGroups = document.getElementById('tabBtnGroups');
            const btnStatuses = document.getElementById('tabBtnStatuses');
            const contentGroups = document.getElementById('tabContentGroups');
            const contentStatuses = document.getElementById('tabContentStatuses');

            if (tab === 'statuses') {
                btnStatuses.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition bg-red-600 text-white cursor-pointer shadow-sm';
                btnGroups.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition text-slate-400 hover:text-slate-800 cursor-pointer';
                contentGroups.classList.add('hidden');
                contentStatuses.classList.remove('hidden');
                loadPjsipStatusesList();
            } else {
                btnGroups.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition bg-red-600 text-white cursor-pointer shadow-sm';
                btnStatuses.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition text-slate-400 hover:text-slate-800 cursor-pointer';
                contentStatuses.classList.add('hidden');
                contentGroups.classList.remove('hidden');
                loadGroupsList();
            }
        }

        function openGroupManager() {
            document.getElementById('groupManagerModal').classList.remove('hidden');
            switchGroupModalTab('groups');
        }

        function closeGroupManager() {
            document.getElementById('groupManagerModal').classList.add('hidden');
        }

        function loadGroupsList() {
            fetch('/api/employee/groups?lang=' + (isRtl ? 'ar' : 'en'), {
                headers: { 'Authorization': 'Bearer ' + EMBED_TOKEN, 'X-Embed-Token': EMBED_TOKEN }
            })
                .then(r => r.json())
                .then(data => {
                    cachedGroupsData = data.groups || [];
                    const list = document.getElementById('groupsList');
                    list.replaceChildren();

                    const selectGrp = document.getElementById('newStatusGroupSelect');
                    if (selectGrp) {
                        selectGrp.innerHTML = `<option value="all">${isRtl ? 'جميع المجموعات (All Groups)' : 'All Groups'}</option>` +
                            cachedGroupsData.map(g => `<option value="${g.name}">${formatGroupName(g, isRtl)}</option>`).join('');
                    }

                    if (!cachedGroupsData.length) {
                        const empty = document.createElement('div');
                        empty.className = 'text-center text-slate-400 text-xs py-5';
                        empty.textContent = isRtl ? 'لا توجد مجموعات بعد' : 'No groups yet';
                        list.appendChild(empty);
                        return;
                    }

                    cachedGroupsData.forEach(group => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs font-bold';
                        const dispName = formatGroupName(group, isRtl);
                        const subName = isRtl ? (group.name_en || '') : (group.name_ar || '');
                        const titleHtml = (subName && subName !== dispName) 
                            ? `${dispName} <span class="text-xs font-normal text-slate-400">(${subName})</span>` 
                            : dispName;
                        row.innerHTML = `
                            <span>${titleHtml}</span>
                            <button type="button" onclick="deleteGroup(${group.id}, '${group.name}')" class="text-red-500 hover:text-red-700 cursor-pointer p-1">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        `;
                        list.appendChild(row);
                    });
                })
                .catch(err => {
                    document.getElementById('groupsList').innerHTML = `<div class="text-center text-red-500 text-xs py-3">${err.message}</div>`;
                });
        }

        function addGroup(e) {
            e.preventDefault();
            const inputAr = document.getElementById('newGroupNameAr');
            const inputEn = document.getElementById('newGroupNameEn');
            const inputLegacy = document.getElementById('newGroupName');
            const btn = document.getElementById('addGroupButton');

            const nameAr = inputAr ? inputAr.value.trim() : '';
            const nameEn = inputEn ? inputEn.value.trim() : '';
            const nameLegacy = inputLegacy ? inputLegacy.value.trim() : '';

            let payload = {};
            if (nameAr || nameEn) {
                payload.name_ar = nameAr;
                payload.name_en = nameEn;
                payload.name = (nameAr && nameEn) ? `${nameAr} (${nameEn})` : (nameAr || nameEn);
            } else if (nameLegacy) {
                payload.name = nameLegacy;
            } else {
                return;
            }

            btn.disabled = true;
            fetch('/api/employee/groups', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + EMBED_TOKEN,
                    'X-Embed-Token': EMBED_TOKEN
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) throw new Error(data.error || 'Failed to add group');
                if (inputAr) inputAr.value = '';
                if (inputEn) inputEn.value = '';
                if (inputLegacy) inputLegacy.value = '';
                loadGroupsList();
            })
            .catch(err => alert(err.message))
            .finally(() => { btn.disabled = false; });
        }

        function deleteGroup(id, name) {
            if (!confirm((isRtl ? 'هل أنت متأكد من حذف المجموعة ' : 'Delete group ') + name + '?')) return;
            fetch('/api/employee/groups/' + id, { 
                method: 'DELETE',
                headers: { 
                    'Authorization': 'Bearer ' + EMBED_TOKEN,
                    'X-Embed-Token': EMBED_TOKEN
                }
            })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) throw new Error(data.error || 'Failed to delete');
                    loadGroupsList();
                })
                .catch(err => alert(err.message));
        }

        function loadPjsipStatusesList() {
            fetch('/api/employee/statuses', {
                headers: { 
                    'Authorization': 'Bearer ' + EMBED_TOKEN,
                    'X-Embed-Token': EMBED_TOKEN
                }
            })
                .then(r => r.json())
                .then(data => {
                    const list = document.getElementById('pjsipStatusesList');
                    list.replaceChildren();

                    const statuses = data.statuses || [];
                    if (!statuses.length) {
                        list.innerHTML = `<div class="text-center text-slate-400 text-xs py-4">${isRtl ? 'لا توجد حالات مخصصة بعد' : 'No custom statuses yet'}</div>`;
                        return;
                    }

                    statuses.forEach(st => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs';
                        const dotColor = st.color || '#f59e0b';
                        const grpLabel = (st.target_group && st.target_group !== 'all') ? formatGroupName(st.target_group, isRtl) : (isRtl ? 'جميع المجموعات' : 'All Groups');

                        row.innerHTML = `
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${dotColor}; box-shadow:0 0 0 2px ${dotColor}33;"></span>
                                <strong class="text-slate-800 font-bold">${isRtl ? st.label_ar : (st.label_en || st.label_ar)}</strong>
                                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">${grpLabel}</span>
                            </div>
                            <button type="button" onclick="deletePjsipStatus(${st.id}, '${st.label_ar}')" class="text-red-500 hover:text-red-700 cursor-pointer p-1">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        `;
                        list.appendChild(row);
                    });
                })
                .catch(err => {
                    document.getElementById('pjsipStatusesList').innerHTML = `<div class="text-center text-red-500 text-xs py-3">${err.message}</div>`;
                });
        }

        function setPresetColor(hex) {
            const el = document.getElementById('newStatusColor');
            if (el) el.value = hex;
        }

        function generateStatusSlug(nameAr, nameEn) {
            if (nameEn && nameEn.trim()) {
                const slug = nameEn.toLowerCase().trim().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');
                if (slug) return slug;
            }
            const arMap = {
                'صلاة': 'prayer', 'صلاه': 'prayer', 'تدريب': 'training', 'اجتماع': 'meeting',
                'استراحة': 'break', 'راحة': 'break', 'غداء': 'lunch', 'متابعة': 'followup',
                'متابعه': 'followup', 'مكالمة': 'call', 'مكالمات': 'calls', 'بحث': 'research',
                'مهمة': 'task', 'عمل': 'work', 'إداري': 'admin', 'اداري': 'admin', 'طوارئ': 'emergency'
            };
            const trimmed = (nameAr || '').trim();
            if (arMap[trimmed]) return arMap[trimmed];
            for (const [k, v] of Object.entries(arMap)) {
                if (trimmed.includes(k)) return v + '_' + Date.now().toString().slice(-4);
            }
            return 'status_' + Date.now().toString().slice(-6);
        }

        function addPjsipStatus(e) {
            e.preventDefault();
            const arInput = document.getElementById('newStatusLabelAr');
            const enInput = document.getElementById('newStatusLabelEn');
            const colInput = document.getElementById('newStatusColor');
            const grpInput = document.getElementById('newStatusGroupSelect');
            const btn = document.getElementById('addStatusButton');

            const nameAr = arInput.value.trim();
            const nameEn = enInput ? enInput.value.trim() : '';
            const statusKey = generateStatusSlug(nameAr, nameEn);

            const payload = {
                status_key: statusKey,
                label_ar: nameAr,
                label_en: nameEn || nameAr,
                color: colInput ? colInput.value : '#f59e0b',
                target_group: grpInput ? grpInput.value : 'all'
            };

            btn.disabled = true;
            fetch('/api/employee/statuses', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + EMBED_TOKEN,
                    'X-Embed-Token': EMBED_TOKEN
                },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) throw new Error(data.error || 'Failed to add status');
                arInput.value = '';
                if (enInput) enInput.value = '';
                loadPjsipStatusesList();
            })
            .catch(err => alert(err.message))
            .finally(() => { btn.disabled = false; });
        }

        function deletePjsipStatus(id, name) {
            if (!confirm((isRtl ? 'هل تريد حذف الحالة ' : 'Delete status ') + name + '?')) return;
            fetch('/api/employee/statuses/' + id, { 
                method: 'DELETE',
                headers: { 
                    'Authorization': 'Bearer ' + EMBED_TOKEN,
                    'X-Embed-Token': EMBED_TOKEN
                }
            })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) throw new Error(data.error || 'Failed to delete status');
                    loadPjsipStatusesList();
                })
                .catch(err => alert(err.message));
        }
    </script>

    <!-- Enhanced Group & PJSIP Status Manager Modal -->

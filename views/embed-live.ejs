                        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <span><%= isRtl ? 'إدارة المجموعات وحالات الوكلاء (PJSIP)' : 'Manage Groups & PJSIP Statuses' %></span>
                    </h3>
                    <p class="text-xs text-slate-500 mt-1"><%= isRtl ? 'ربط حالات الوكلاء بمجموعات العمل والتحويلات للسنترال و CRM' : 'Configure extension groups and connected PJSIP presence statuses' %></p>
                </div>
                <button type="button" onclick="closeGroupManager()" class="text-slate-400 hover:text-slate-800 cursor-pointer p-1.5 rounded-lg hover:bg-slate-100">&#10005;</button>
            </div>

            <!-- Tab Buttons -->
            <div class="flex items-center gap-2 mb-4 bg-slate-100 p-1.5 rounded-xl border border-slate-200">
                <button type="button" id="tabBtnGroups" onclick="switchGroupModalTab('groups')" class="flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition bg-red-600 text-white cursor-pointer shadow-sm">
                    <%= isRtl ? 'مجموعات الموظفين (Groups)' : 'Employee Groups' %>
                </button>
                <button type="button" id="tabBtnStatuses" onclick="switchGroupModalTab('statuses')" class="flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition text-slate-500 hover:text-slate-800 cursor-pointer">
                    <%= isRtl ? 'حالات الوكلاء و PJSIP (Statuses)' : 'PJSIP Agent Statuses' %>
                </button>
            </div>

            <!-- TAB 1: GROUPS MANAGEMENT -->
            <div id="tabContentGroups" class="space-y-4 flex-1 overflow-y-auto pr-1">
                <form id="groupForm" onsubmit="addGroup(event)" class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2.5">
                    <div class="text-xs font-extrabold text-slate-800">
                        <%= isRtl ? '+ إضافة مجموعة عمل جديدة' : '+ Add New Extension Group' %>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1"><%= isRtl ? 'اسم المجموعة (عربي)' : 'Group Name (Arabic)' %></label>
                            <input type="text" id="newGroupNameAr" required placeholder="<%= isRtl ? 'مثال: المبيعات أو الدعم الفني' : 'e.g. Sales' %>" class="w-full px-2.5 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1"><%= isRtl ? 'اسم المجموعة (إنجليزي)' : 'Group Name (English)' %></label>
                            <input type="text" id="newGroupNameEn" required placeholder="<%= isRtl ? 'e.g. Sales or Support' : 'e.g. Sales' %>" class="w-full px-2.5 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                    </div>
                    <div class="flex justify-end pt-1">
                        <button id="addGroupButton" type="submit" class="px-4 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg cursor-pointer whitespace-nowrap transition">
                            <%= isRtl ? 'إضافة مجموعة' : 'Add Group' %>
                        </button>
                    </div>
                </form>

                <div id="groupsList" class="space-y-2 max-h-64 overflow-y-auto">
                    <div class="text-center text-slate-400 text-sm py-4"><%= isRtl ? 'جاري التحميل...' : 'Loading...' %></div>
                </div>
            </div>

            <!-- TAB 2: PJSIP AGENT STATUSES (CONNECTED TO GROUPS) -->
            <div id="tabContentStatuses" class="hidden space-y-4 flex-1 overflow-y-auto pr-1">
                <!-- Static Core Statuses Notice -->
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <div class="text-[11px] font-bold text-slate-600 mb-2 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span>الحالات الأساسية الثابتة (Static Core - لا يوجد مؤقت وقت):</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="flex items-center gap-2 p-2 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                            <span>متاح (Available)</span>
                        </div>
                        <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                            <span>غير متاح (Offline)</span>
                        </div>
                    </div>
                </div>

                <!-- Add Dynamic PJSIP Status Form -->
                <form id="pjsipStatusForm" onsubmit="addPjsipStatus(event)" class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-3">
                    <div class="text-xs font-extrabold text-slate-800 flex items-center justify-between">
                        <span>+ إضافة حالة ديناميكية جديدة</span>
                        <span class="text-[10px] text-amber-600 font-normal">(مؤقت وقت تفاعلي عند التفعيل)</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">اسم الحالة (عربي)</label>
                            <input type="text" id="newStatusLabelAr" required placeholder="مثال: صلاة أو تدريب" class="w-full px-2.5 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">الاسم بالإنجليزي (اختياري)</label>
                            <input type="text" id="newStatusLabelEn" placeholder="e.g. Prayer / Training" class="w-full px-2.5 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">المجموعة المرتبطة</label>
                            <select id="newStatusGroupSelect" class="w-full px-2.5 py-1.5 text-xs border border-slate-300 rounded-lg outline-none h-[34px]">
                                <option value="all">جميع المجموعات (All Groups)</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2 border-t border-slate-200">
                        <div class="flex items-center gap-2 w-full sm:w-auto">
                            <span class="text-[10px] font-bold text-slate-600 shrink-0">لون المؤشر:</span>
                            <!-- Native Color Picker Swatch Button -->
                            <input type="color" id="newStatusColor" value="#f59e0b" class="w-9 h-8 rounded-lg cursor-pointer bg-transparent border border-slate-300 p-0.5 shrink-0" title="اختر اللون">
                            <!-- Quick Palette Swatches -->
                            <div class="flex items-center gap-1.5 overflow-x-auto py-1">
                                <button type="button" onclick="setPresetColor('#f59e0b')" style="background:#f59e0b;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Amber"></button>
                                <button type="button" onclick="setPresetColor('#ea580c')" style="background:#ea580c;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Orange"></button>
                                <button type="button" onclick="setPresetColor('#8b5cf6')" style="background:#8b5cf6;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Purple"></button>
                                <button type="button" onclick="setPresetColor('#06b6d4')" style="background:#06b6d4;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Cyan"></button>
                                <button type="button" onclick="setPresetColor('#3b82f6')" style="background:#3b82f6;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Blue"></button>
                                <button type="button" onclick="setPresetColor('#10b981')" style="background:#10b981;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Emerald"></button>
                                <button type="button" onclick="setPresetColor('#f43f5e')" style="background:#f43f5e;" class="w-5 h-5 rounded-full border border-black/20 hover:scale-110 transition cursor-pointer" title="Rose"></button>
                            </div>
                        </div>

                        <button id="addStatusButton" type="submit" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg cursor-pointer transition whitespace-nowrap w-full sm:w-auto">
                            إضافة الحالة
                        </button>
                    </div>
                </form>

                <!-- Statuses List -->
                <div class="space-y-1.5">
                    <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-1">
                        الحالات الحالية المعتمدة:
                    </div>
                    <div id="pjsipStatusesList" class="space-y-1.5 max-h-56 overflow-y-auto">
                        <div class="text-center text-slate-400 text-sm py-4">جاري التحميل...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة المراقبة المباشرة للسنترال</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="/socket.io/socket.io.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'JetBrains Mono', 'Cairo', monospace !important; background-color: #f8fafc; color: #0f172a; }
        .action-select {
            appearance: none;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2064748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: left 0.75rem center;
            background-size: 1em;
        }
    </style>
</head>
<body class="p-4 sm:p-6 select-none bg-slate-50 text-slate-900">
    <div class="max-w-7xl mx-auto space-y-5">

        <!-- Header -->
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-4 border-b border-slate-200 gap-4">
            <div class="flex items-center gap-3">
                <div class="w-3.5 h-3.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <div>
                    <h1 class="text-lg font-extrabold tracking-tight text-slate-900 flex items-center gap-2">
                        <span>لوحة المراقبة المباشرة للسنترال</span>
                    </h1>
                    <p class="text-xs text-slate-500 mt-0.5">
                        مراقبة فورية للتحويلات والمكالمات في السنترال
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 self-end sm:self-auto">
                <button type="button" onclick="openGroupManager()" class="text-xs font-extrabold bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-sm transition cursor-pointer">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                    <span>إدارة المجموعات وحالات PJSIP</span>
                </button>

                <span id="crmUserNameBadge" class="text-xs font-bold bg-white text-slate-700 px-3 py-1.5 rounded-lg border border-slate-200"></span>
                
                <div id="supervisorBadge" class="text-xs font-semibold bg-emerald-50 text-emerald-700 px-3 py-1.5 rounded-lg border border-emerald-200 flex items-center gap-1.5 <%= session.supervisor_extension ? '' : 'hidden' %>">
                    <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    <span>المشرف:</span>
                    <span id="supervisorExtVal" class="font-mono font-extrabold"><%= session.supervisor_extension || '' %></span>
                </div>
            </div>
        </div>

        <!-- Summary Stats Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-white p-4 rounded-xl border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-slate-500">إجمالي التحويلات</div>
                    <div id="statTotal" class="text-2xl font-black text-slate-900 mt-1">0</div>
                </div>
                <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-slate-500">الخطوط المتصلة</div>
                    <div id="statOnline" class="text-2xl font-black text-emerald-600 mt-1">0</div>
                </div>
                <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
            </div>

            <div class="bg-white p-4 rounded-xl border border-slate-200/80 flex items-center justify-between">
                <div>
                    <div class="text-xs font-bold text-slate-500">المكالمات الجارية</div>
                    <div id="statActive" class="text-2xl font-black text-amber-600 mt-1">0</div>
                </div>
                <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
            </div>
        </div>

        <!-- Search & Filter Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 bg-white p-3 rounded-xl border border-slate-200/80">
            <div class="relative w-full sm:w-72">
                <input id="searchInput" type="text" placeholder="بحث بالاسم أو رقم التحويلة..." class="w-full pl-9 pr-3 py-2 text-xs rounded-lg border border-slate-200 bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-slate-900">
                <span class="absolute left-3 top-2.5 text-slate-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </span>
            </div>

            <div class="flex items-center gap-1.5 text-xs font-bold self-end sm:self-auto">
                <button data-filter="all" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-900 text-white transition">الكل</button>
                <button data-filter="online" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition">متصل</button>
                <button data-filter="busy" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition">في مكالمة</button>
                <button data-filter="offline" class="filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition">غير متصل</button>
            </div>
        </div>

        <!-- Extensions Grid -->
        <div id="extensionsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <div id="loadingStatus" class="col-span-full text-center py-12 text-slate-400 text-sm font-semibold">
                جاري الاتصال بالخادم وتحميل الخطوط...
            </div>
        </div>

    </div>

    <script>
        (function() {
            const EMBED_TOKEN = <%- safeJsonSerialize(sessionToken) %>;
            let SUPERVISOR_EXT = <%- safeJsonSerialize(session.supervisor_extension) %>;
            const CRM_USER_NAME = <%- safeJsonSerialize(session.crm_user_name) %>;

            document.getElementById('crmUserNameBadge').textContent = CRM_USER_NAME;

            // Socket.IO Connection
            const socket = io('/crm-live', {
                auth: { token: EMBED_TOKEN },
                transports: ['websocket', 'polling']
            });

            let localPeerStatus = {};
            let localCallStatus = {};
            let activeFilter = 'all';
            let searchQuery = '';
            let isDomInitialized = false;

            socket.on('connect_error', (err) => {
                const grid = document.getElementById('extensionsGrid');
                grid.replaceChildren();
                const errDiv = document.createElement('div');
                errDiv.className = 'col-span-full text-center py-12 text-rose-600 font-extrabold text-sm';
                errDiv.textContent = 'فشل الاتصال بسيرفر السنترال';
                grid.appendChild(errDiv);
            });

            socket.on('peerStatus', (data) => {
                localPeerStatus = data || {};
                if (!isDomInitialized) {
                    initGridDom();
                } else {
                    updateAllCardsInPlace();
                }
            });

            socket.on('activeCalls', (data) => {
                const list = data || [];
                localCallStatus = {};
                list.forEach(c => {
                    if (c && c.extension) {
                        localCallStatus[String(c.extension)] = c;
                    }
                });
                updateAllCardsInPlace();
            });

            // Search & Filter Listeners
            document.getElementById('searchInput').addEventListener('input', (e) => {
                searchQuery = e.target.value.toLowerCase().trim();
                applyFilterAndSearch();
            });

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.filter-btn').forEach(b => {
                        b.className = 'filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition';
                    });
                    btn.className = 'filter-btn px-3 py-1.5 rounded-lg bg-slate-900 text-white transition';
                    activeFilter = btn.getAttribute('data-filter');
                    applyFilterAndSearch();
                });
            });

            function handleSelectAction(targetExt, action) {
                if (!action) return;

                let supExt = SUPERVISOR_EXT;
                if (action !== 'hangup' && !supExt) {
                    supExt = prompt('أدخل رقم تحويتك المباشرة لتنفيذ التحكم:');
                    if (!supExt || !/^\d{2,10}$/.test(supExt.trim())) {
                        alert('رقم التحويلة غير صحيح.');
                        return;
                    }
                    SUPERVISOR_EXT = supExt.trim();
                    document.getElementById('supervisorExtVal').textContent = SUPERVISOR_EXT;
                    document.getElementById('supervisorBadge').classList.remove('hidden');
                }

                const actionLabels = {
                    listen: 'استماع',
                    whisper: 'همس',
                    barge: 'تدخل',
                    hijack: 'سحب المكالمة',
                    hangup: 'إنهاء المكالمة'
                };

                const label = actionLabels[action] || action;
                if (!confirm('تأكيد تنفيذ أمر ' + label + ' على التحويلة ' + targetExt + '?')) return;

                socket.emit('action', { action: action, targetExtension: targetExt, supervisorExtension: SUPERVISOR_EXT }, (res) => {
                    if (res && res.success) {
                        alert(res.message || 'تم تنفيذ الأمر بنجاح');
                    } else {
                        alert((res && res.error) ? res.error : 'فشل تنفيذ الأمر');
                    }
                });
            }

            function formatTimer(seconds) {
                if (isNaN(seconds) || seconds < 0) seconds = 0;
                const mins = Math.floor(seconds / 60);
                const secs = seconds % 60;
                return (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
            }

            // Live 1-second Ticker
            setInterval(() => {
                document.querySelectorAll('[data-start]').forEach(card => {
                    const startMs = parseInt(card.getAttribute('data-start'), 10);
                    if (startMs > 0) {
                        const ext = card.getAttribute('data-ext');
                        const timerEl = document.getElementById('timer-' + ext);
                        if (timerEl) {
                            const elapsed = Math.max(0, Math.floor((Date.now() - startMs) / 1000));
                            timerEl.textContent = formatTimer(elapsed);
                        }
                    }
                });
            }, 1000);

            // Initialize Grid DOM ONCE
            function initGridDom() {
                const grid = document.getElementById('extensionsGrid');
                grid.replaceChildren();

                const exts = Object.keys(localPeerStatus).sort((a, b) => parseInt(a, 10) - parseInt(b, 10));
                if (exts.length === 0) return;

                isDomInitialized = true;

                exts.forEach(ext => {
                    const info = localPeerStatus[ext] || {};

                    const card = document.createElement('div');
                    card.id = 'card-' + ext;
                    card.setAttribute('data-ext', ext);
                    card.className = 'bg-white border border-slate-200/80 rounded-xl p-4 flex flex-col justify-between hover:border-slate-300 transition';

                    card.innerHTML = `
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <div class="flex items-center gap-3">
                                    <div id="avatar-${ext}" class="w-9 h-9 rounded-xl font-mono font-extrabold text-xs flex items-center justify-center bg-slate-100 text-slate-500 border border-slate-200">
                                        ${ext}
                                    </div>
                                    <div>
                                        <div id="name-${ext}" class="font-bold text-sm text-slate-900 leading-tight">${info.name || 'تحويلة ' + ext}</div>
                                        <div class="text-[11px] text-slate-400 font-mono">التحويلة: ${ext}</div>
                                    </div>
                                </div>
                                <div id="badge-${ext}" class="flex items-center gap-1.5 text-[11px] font-extrabold px-2.5 py-1 rounded-full border bg-slate-50 text-slate-500 border-slate-200">
                                    <div id="dot-${ext}" class="w-2 h-2 rounded-full bg-slate-400"></div>
                                    <span id="badgeText-${ext}">غير متصل</span>
                                </div>
                            </div>

                            <div id="callBox-${ext}" class="hidden mt-2 text-xs font-mono bg-amber-50/70 p-3 rounded-lg border border-amber-200/80 text-slate-800 space-y-1 mb-3">
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-500 font-mono text-[11px]">الطرف الآخر:</span>
                                    <strong id="partner-${ext}" class="font-mono text-slate-900">-</strong>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-500 font-mono text-[11px]">حالة المكالمة:</span>
                                    <strong id="stateLabel-${ext}" class="font-mono font-bold text-amber-700">-</strong>
                                </div>
                                <div class="flex justify-between items-center">
                                    <span class="text-slate-500 font-mono text-[11px]">المدة الحية:</span>
                                    <strong id="timer-${ext}" class="font-mono text-emerald-600">00:00</strong>
                                </div>
                            </div>
                            <div id="spacer-${ext}" class="h-2"></div>
                        </div>

                        <div class="pt-3 border-t border-slate-100">
                            <select id="actionSelect-${ext}" disabled class="action-select w-full bg-slate-50 text-xs font-bold rounded-lg px-3 py-2 border border-slate-200 text-slate-700 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed transition">
                                <option value="" disabled selected hidden>إجراءات المكالمة</option>
                                <option value="listen">استماع (Listen)</option>
                                <option value="whisper">همس (Whisper)</option>
                                <option value="barge">تدخل (Barge)</option>
                                <option value="hijack" class="font-bold text-rose-600">سحب المكالمة (Hijack)</option>
                                <option value="hangup" class="font-bold text-rose-600">إنهاء المكالمة (Hangup)</option>
                            </select>
                        </div>
                    `;

                    grid.appendChild(card);

                    // Add listener to select element ONCE
                    const selectEl = card.querySelector('#actionSelect-' + ext);
                    selectEl.addEventListener('change', function() {
                        const val = this.value;
                        this.value = '';
                        if (val) {
                            handleSelectAction(ext, val);
                        }
                    });
                });

                updateAllCardsInPlace();
            }

            // In-place DOM update function
            function updateAllCardsInPlace() {
                const exts = Object.keys(localPeerStatus);

                let totalCount = exts.length;
                let onlineCount = 0;
                let activeCount = Object.keys(localCallStatus).length;

                exts.forEach(e => { if (localPeerStatus[e] && localPeerStatus[e].online) onlineCount++; });

                document.getElementById('statTotal').textContent = totalCount;
                document.getElementById('statOnline').textContent = onlineCount;
                document.getElementById('statActive').textContent = activeCount;

                exts.forEach(ext => {
                    const card = document.getElementById('card-' + ext);
                    if (!card) return;

                    const info = localPeerStatus[ext] || {};
                    const call = localCallStatus[ext];
                    const isOnline = Boolean(info.online);
                    const isBusy = Boolean(call);
                    const isAnswered = isBusy && (
                        call.state === 'In Call' || 
                        call.state === 'in_call' || 
                        call.state === 'Up' || 
                        call.state === 'lead_answered' || 
                        call.state === 'agent_bridged' ||
                        call.state === 'answered'
                    );

                    const avatar = document.getElementById('avatar-' + ext);
                    const badge = document.getElementById('badge-' + ext);
                    const dot = document.getElementById('dot-' + ext);
                    const badgeText = document.getElementById('badgeText-' + ext);
                    const callBox = document.getElementById('callBox-' + ext);
                    const spacer = document.getElementById('spacer-' + ext);
                    const partner = document.getElementById('partner-' + ext);
                    const stateLabel = document.getElementById('stateLabel-' + ext);
                    const timerEl = document.getElementById('timer-' + ext);
                    const selectEl = document.getElementById('actionSelect-' + ext);

                    // Avatar styling
                    avatar.className = 'w-9 h-9 rounded-xl font-mono font-extrabold text-xs flex items-center justify-center ' + 
                        (isAnswered ? 'bg-amber-500 text-white' : (isBusy ? 'bg-yellow-400 text-slate-900' : (isOnline ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-500 border border-slate-200')));

                    // Badge styling
                    badge.className = 'flex items-center gap-1.5 text-[11px] font-extrabold px-2.5 py-1 rounded-full border ' +
                        (isAnswered 
                            ? 'bg-amber-50 text-amber-700 border-amber-200'
                            : (isBusy 
                                ? 'bg-yellow-50 text-yellow-800 border-yellow-300 animate-pulse'
                                : (isOnline 
                                    ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
                                    : 'bg-slate-50 text-slate-500 border-slate-200')));

                    dot.className = 'w-2 h-2 rounded-full ' + (isAnswered ? 'bg-amber-500' : (isBusy ? 'bg-yellow-500' : (isOnline ? 'bg-emerald-500' : 'bg-slate-400')));
                    badgeText.textContent = isBusy ? (isAnswered ? 'في مكالمة' : 'يرن...') : (isOnline ? 'متصل' : 'غير متصل');

                    // Active Call details & timer
                    if (call) {
                        callBox.classList.remove('hidden');
                        spacer.classList.add('hidden');

                        partner.textContent = call.partner || '-';
                        stateLabel.textContent = isAnswered ? 'في مكالمة (نشطة)' : 'جاري الرنين...';

                        // Initialize or preserve start timestamp
                        if (!card.getAttribute('data-start')) {
                            const startMs = call.started_at || Date.now();
                            card.setAttribute('data-start', startMs);
                        }

                        const currentStart = parseInt(card.getAttribute('data-start'), 10);
                        const elapsedSec = Math.max(0, Math.floor((Date.now() - currentStart) / 1000));
                        timerEl.textContent = formatTimer(elapsedSec);

                        // Unlock Call Actions Dropdown
                        selectEl.disabled = false;
                    } else {
                        card.removeAttribute('data-start');
                        callBox.classList.add('hidden');
                        spacer.classList.remove('hidden');

                        // Lock Call Actions Dropdown when idle
                        selectEl.disabled = true;
                        selectEl.value = '';
                    }
                });

                applyFilterAndSearch();
            }

            function applyFilterAndSearch() {
                const exts = Object.keys(localPeerStatus);

                exts.forEach(ext => {
                    const card = document.getElementById('card-' + ext);
                    if (!card) return;

                    const info = localPeerStatus[ext] || {};
                    const call = localCallStatus[ext];
                    const isOnline = Boolean(info.online);
                    const isBusy = Boolean(call);

                    let visible = true;
                    if (activeFilter === 'online' && !isOnline) visible = false;
                    if (activeFilter === 'busy' && !isBusy) visible = false;
                    if (activeFilter === 'offline' && isOnline) visible = false;

                    if (searchQuery) {
                        const nameStr = (info.name || '').toLowerCase();
                        if (!ext.includes(searchQuery) && !nameStr.includes(searchQuery)) visible = false;
                    }

                    if (visible) {
                        card.classList.remove('hidden');
                    } else {
                        card.classList.add('hidden');
                    }
                });
            }
        })();

        // Group & PJSIP Status Manager
        let cachedGroupsData = [];

        function switchGroupModalTab(tab) {
            const btnGroups = document.getElementById('tabBtnGroups');
            const btnStatuses = document.getElementById('tabBtnStatuses');
            const contentGroups = document.getElementById('tabContentGroups');
            const contentStatuses = document.getElementById('tabContentStatuses');

            if (tab === 'statuses') {
                btnStatuses.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition bg-red-600 text-white cursor-pointer shadow-sm';
                btnGroups.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition text-slate-400 hover:text-slate-800 cursor-pointer';
                contentGroups.classList.add('hidden');
                contentStatuses.classList.remove('hidden');
                loadPjsipStatusesList();
            } else {
                btnGroups.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition bg-red-600 text-white cursor-pointer shadow-sm';
                btnStatuses.className = 'flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition text-slate-400 hover:text-slate-800 cursor-pointer';
                contentStatuses.classList.add('hidden');
                contentGroups.classList.remove('hidden');
                loadGroupsList();
            }
        }

        function openGroupManager() {
            document.getElementById('groupManagerModal').classList.remove('hidden');
            switchGroupModalTab('groups');
        }

        function closeGroupManager() {
            document.getElementById('groupManagerModal').classList.add('hidden');
        }

        function loadGroupsList() {
            fetch('/api/employee/groups')
                .then(r => r.json())
                .then(data => {
                    cachedGroupsData = data.groups || [];
                    const list = document.getElementById('groupsList');
                    list.replaceChildren();

                    const selectGrp = document.getElementById('newStatusGroupSelect');
                    if (selectGrp) {
                        selectGrp.innerHTML = `<option value="all">جميع المجموعات (All Groups)</option>` +
                            cachedGroupsData.map(g => `<option value="${g.name}">${g.name}</option>`).join('');
                    }

                    if (!cachedGroupsData.length) {
                        const empty = document.createElement('div');
                        empty.className = 'text-center text-slate-400 text-xs py-5';
                        empty.textContent = 'لا توجد مجموعات بعد';
                        list.appendChild(empty);
                        return;
                    }

                    cachedGroupsData.forEach(group => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs font-bold';
                        row.innerHTML = `
                            <span>${group.name}</span>
                            <button type="button" onclick="deleteGroup(${group.id}, '${group.name}')" class="text-red-500 hover:text-red-700 cursor-pointer p-1">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        `;
                        list.appendChild(row);
                    });
                })
                .catch(err => {
                    document.getElementById('groupsList').innerHTML = `<div class="text-center text-red-500 text-xs py-3">${err.message}</div>`;
                });
        }

        function addGroup(e) {
            e.preventDefault();
            const input = document.getElementById('newGroupName');
            const btn = document.getElementById('addGroupButton');
            const name = input.value.trim();
            if (!name) return;

            btn.disabled = true;
            fetch('/api/employee/groups', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name })
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) throw new Error(data.error || 'Failed to add group');
                input.value = '';
                loadGroupsList();
            })
            .catch(err => alert(err.message))
            .finally(() => { btn.disabled = false; });
        }

        function deleteGroup(id, name) {
            if (!confirm('هل أنت متأكد من حذف المجموعة ' + name + '؟')) return;
            fetch('/api/employee/groups/' + id, { method: 'DELETE' })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) throw new Error(data.error || 'Failed to delete');
                    loadGroupsList();
                })
                .catch(err => alert(err.message));
        }

        function loadPjsipStatusesList() {
            fetch('/api/employee/statuses')
                .then(r => r.json())
                .then(data => {
                    const list = document.getElementById('pjsipStatusesList');
                    list.replaceChildren();

                    const statuses = data.statuses || [];
                    if (!statuses.length) {
                        list.innerHTML = `<div class="text-center text-slate-400 text-xs py-4">لا توجد حالات مخصصة بعد</div>`;
                        return;
                    }

                    statuses.forEach(st => {
                        const row = document.createElement('div');
                        row.className = 'flex items-center justify-between gap-3 bg-slate-50 border border-slate-200 rounded-lg px-3 py-2 text-xs';
                        const dotColor = st.color || '#f59e0b';
                        const grpLabel = (st.target_group && st.target_group !== 'all') ? st.target_group : 'جميع المجموعات';

                        row.innerHTML = `
                            <div class="flex items-center gap-2 min-w-0">
                                <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${dotColor}; box-shadow:0 0 0 2px ${dotColor}33;"></span>
                                <strong class="text-slate-800 font-bold">${st.label_ar} (${st.label_en || st.status_key})</strong>
                                <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">${grpLabel}</span>
                            </div>
                            <button type="button" onclick="deletePjsipStatus(${st.id}, '${st.label_ar}')" class="text-red-500 hover:text-red-700 cursor-pointer p-1">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                            </button>
                        `;
                        list.appendChild(row);
                    });
                })
                .catch(err => {
                    document.getElementById('pjsipStatusesList').innerHTML = `<div class="text-center text-red-500 text-xs py-3">${err.message}</div>`;
                });
        }

        function addPjsipStatus(e) {
            e.preventDefault();
            const keyInput = document.getElementById('newStatusKey');
            const arInput = document.getElementById('newStatusLabelAr');
            const enInput = document.getElementById('newStatusLabelEn');
            const colInput = document.getElementById('newStatusColor');
            const grpInput = document.getElementById('newStatusGroupSelect');
            const btn = document.getElementById('addStatusButton');

            const payload = {
                status_key: keyInput.value.trim(),
                label_ar: arInput.value.trim(),
                label_en: enInput.value.trim(),
                color: colInput.value.trim(),
                target_group: grpInput.value
            };

            btn.disabled = true;
            fetch('/api/employee/statuses', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(data => {
                if (!data.success) throw new Error(data.error || 'Failed to add status');
                keyInput.value = '';
                arInput.value = '';
                enInput.value = '';
                loadPjsipStatusesList();
            })
            .catch(err => alert(err.message))
            .finally(() => { btn.disabled = false; });
        }

        function deletePjsipStatus(id, name) {
            if (!confirm('هل تريد حذف الحالة ' + name + '؟')) return;
            fetch('/api/employee/statuses/' + id, { method: 'DELETE' })
                .then(r => r.json())
                .then(data => {
                    if (!data.success) throw new Error(data.error || 'Failed to delete status');
                    loadPjsipStatusesList();
                })
                .catch(err => alert(err.message));
        }
    </script>

    <!-- Enhanced Group & PJSIP Status Manager Modal -->
    <div id="groupManagerModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl border border-slate-200 max-w-xl w-full p-6 text-slate-900 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex items-center justify-between border-b border-slate-200 pb-3 mb-4">
                <div>
                    <h3 class="text-base font-extrabold flex items-center gap-2">
                        <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
                        <span>إدارة المجموعات وحالات الوكلاء (PJSIP)</span>
                    </h3>
                    <p class="text-xs text-slate-500 mt-1">ربط حالات الوكلاء بمجموعات العمل والتحويلات للسنترال و CRM</p>
                </div>
                <button type="button" onclick="closeGroupManager()" class="text-slate-400 hover:text-slate-800 cursor-pointer p-1.5 rounded-lg hover:bg-slate-100">&#10005;</button>
            </div>

            <!-- Tab Buttons -->
            <div class="flex items-center gap-2 mb-4 bg-slate-100 p-1.5 rounded-xl border border-slate-200">
                <button type="button" id="tabBtnGroups" onclick="switchGroupModalTab('groups')" class="flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition bg-red-600 text-white cursor-pointer shadow-sm">
                    مجموعات الموظفين (Groups)
                </button>
                <button type="button" id="tabBtnStatuses" onclick="switchGroupModalTab('statuses')" class="flex-1 py-1.5 px-3 text-xs font-extrabold rounded-lg transition text-slate-500 hover:text-slate-800 cursor-pointer">
                    حالات الوكلاء و PJSIP (Statuses)
                </button>
            </div>

            <!-- TAB 1: GROUPS MANAGEMENT -->
            <div id="tabContentGroups" class="space-y-4 flex-1 overflow-y-auto pr-1">
                <form id="groupForm" onsubmit="addGroup(event)" class="flex gap-2">
                    <input type="text" id="newGroupName" maxlength="100" required placeholder="اسم المجموعة الجديدة..." class="flex-1 px-3 py-2 text-xs border border-slate-300 rounded-lg outline-none focus:ring-2 focus:ring-red-500">
                    <button id="addGroupButton" type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg cursor-pointer whitespace-nowrap">
                        إضافة مجموعة
                    </button>
                </form>

                <div id="groupsList" class="space-y-2 max-h-64 overflow-y-auto">
                    <div class="text-center text-slate-400 text-sm py-4">جاري التحميل...</div>
                </div>
            </div>

            <!-- TAB 2: PJSIP AGENT STATUSES (CONNECTED TO GROUPS) -->
            <div id="tabContentStatuses" class="hidden space-y-4 flex-1 overflow-y-auto pr-1">
                <!-- Static Core Statuses Notice -->
                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <div class="text-[11px] font-bold text-slate-600 mb-2 flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                        <span>الحالات الأساسية الثابتة (Static Core - لا يوجد مؤقت وقت):</span>
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div class="flex items-center gap-2 p-2 rounded-lg bg-emerald-50 border border-emerald-200 text-xs font-bold text-emerald-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                            <span>متاح (Available)</span>
                        </div>
                        <div class="flex items-center gap-2 p-2 rounded-lg bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700">
                            <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span>
                            <span>غير متاح (Offline)</span>
                        </div>
                    </div>
                </div>

                <!-- Add Dynamic PJSIP Status Form -->
                <form id="pjsipStatusForm" onsubmit="addPjsipStatus(event)" class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-2.5">
                    <div class="text-xs font-extrabold text-slate-800 mb-1 flex items-center justify-between">
                        <span>+ إضافة حالة ديناميكية جديدة</span>
                        <span class="text-[10px] text-amber-600 font-normal">(تتضمن مؤقت وقت لتعقب الجاهزية)</span>
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">المعرف (Key)</label>
                            <input type="text" id="newStatusKey" required placeholder="e.g. prayer" pattern="^[a-zA-Z0-9_-]+$" class="w-full px-2 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">الاسم بالعربي</label>
                            <input type="text" id="newStatusLabelAr" required placeholder="مثال: صلاة" class="w-full px-2 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">الاسم بالإنجليزي</label>
                            <input type="text" id="newStatusLabelEn" required placeholder="e.g. Prayer" class="w-full px-2 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2 items-end">
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">اللون</label>
                            <div class="flex items-center gap-1.5">
                                <input type="color" id="newStatusColorPicker" value="#f59e0b" onchange="document.getElementById('newStatusColor').value=this.value" class="w-8 h-8 rounded cursor-pointer bg-transparent border-0 p-0">
                                <input type="text" id="newStatusColor" value="#f59e0b" class="w-full px-2 py-1.5 text-xs border border-slate-300 rounded-lg uppercase">
                            </div>
                        </div>
                        <div>
                            <label class="text-[10px] font-bold text-slate-500 block mb-1">المجموعة المرتبطة</label>
                            <select id="newStatusGroupSelect" class="w-full px-2 py-1.5 text-xs border border-slate-300 rounded-lg outline-none">
                                <option value="all">جميع المجموعات (All Groups)</option>
                            </select>
                        </div>
                        <div>
                            <button id="addStatusButton" type="submit" class="w-full py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg cursor-pointer transition">
                                إضافة الحالة
                            </button>
                        </div>
                    </div>
                </form>

                <!-- Statuses List -->
                <div class="space-y-1.5">
                    <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider px-1">
                        الحالات الحالية المعتمدة:
                    </div>
                    <div id="pjsipStatusesList" class="space-y-1.5 max-h-56 overflow-y-auto">
                        <div class="text-center text-slate-400 text-sm py-4">جاري التحميل...</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

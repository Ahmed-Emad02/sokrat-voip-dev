[Unit]
Description=Watch FreePBX dialplan for Sokrat WebRTC wake refresh
StartLimitIntervalSec=0

[Path]
PathChanged=/etc/asterisk/extensions_additional.conf
PathChanged=/etc/asterisk/pjsip_custom_post.conf
PathChanged=/etc/asterisk/queues_additional.conf
Unit=sokrat-webrtc-wake-apply.service

[Install]
WantedBy=paths.target

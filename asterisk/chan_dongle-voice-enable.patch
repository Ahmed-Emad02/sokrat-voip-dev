 /*!
+ * \brief Enable voice audio on every dongle during initialization.
+ *
+ * Firmware can report voice support while the PCM/audio path remains disabled.
+ * AT^CVOICE=0 is sent for every dongle; unsupported devices simply fail the
+ * bounded retry path.
+ */
+EXPORT_DEF int at_enqueue_cvoice_enable(struct cpvt *cpvt)
+{
+	static const char cmd_cvoice_enable[] = "AT^CVOICE=0\r";
+	static const at_queue_cmd_t at_cmd = ATQ_CMD_DECLARE_ST(CMD_AT_CVOICE_ENABLE, cmd_cvoice_enable);
+
+	if (at_queue_insert_const(cpvt, &at_cmd, 1, 1) != 0) {
+		chan_dongle_err = E_QUEUE;
+		return -1;
+	}
+	return 0;
+}
+

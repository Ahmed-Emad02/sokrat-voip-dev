+/* E173 firmware 21.x can report voice support while its PCM path is disabled. */
+#define E173_VOICE_MAX_ATTEMPTS 3
+
+static void maybe_enable_e173_voice(struct pvt* pvt)
+{
+	if (pvt->e173_voice_attempts >= E173_VOICE_MAX_ATTEMPTS)
+	{
+		ast_log (LOG_WARNING, "[%s] Voice enable exhausted %u attempts\n", PVT_ID(pvt), pvt->e173_voice_attempts);
+		return;
+	}
+	pvt->e173_voice_attempts++;
+	ast_debug (1, "[%s] Enabling voice with AT^CVOICE=0 (attempt %u/%u)\n", PVT_ID(pvt), pvt->e173_voice_attempts, E173_VOICE_MAX_ATTEMPTS);
+	if (at_enqueue_cvoice_enable(&pvt->sys_chan))
+		ast_log (LOG_WARNING, "[%s] Could not enqueue voice enable\n", PVT_ID(pvt));
+}

+/*!
+ * \brief Enqueue AT+CHLD=0 to reject waiting incoming call (User Determined User Busy)
+ * \param cpvt -- cpvt structure
+ * \return 0 on success
+ */
+EXPORT_DEF int at_enqueue_reject_waiting(struct cpvt *cpvt)
+{
+	static const char cmd_chld0[] = "AT+CHLD=0\r";
+	at_queue_cmd_t at_cmd = ATQ_CMD_DECLARE_ST(CMD_AT_CHLD_0, cmd_chld0);
+	if (at_queue_insert(cpvt, &at_cmd, 1, 1) != 0) {
+		chan_dongle_err = E_QUEUE;
+		return -1;
+	}
+	return 0;
+}

+#/* */
+static long at_write_remaining_ms(const struct timespec * deadline)
+{
+	struct timespec now;
+	long ms;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now))
+		return -1;
+	ms = (deadline->tv_sec - now.tv_sec) * 1000L +
+		(deadline->tv_nsec - now.tv_nsec) / 1000000L;
+	return ms > 0 ? ms : 0;

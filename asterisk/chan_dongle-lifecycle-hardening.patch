 /*!
+ * \brief Cancel unsent call-owned DTMF, preserving in-flight/teardown work
+ *
+ * A call can end while its DTMF tasks are still behind another command. They
+ * must not reach the device afterwards: the call index may already belong to
+ * a different call. Commands that were already transmitted keep their response
+ * boundary and are merely relinked to sys_chan so the freed cpvt is never
+ * dereferenced. Non-DTMF teardown tasks (CHUP/CHLD) are likewise retained.
+ */
+#/* */
+EXPORT_DEF unsigned at_queue_cancel_unsent_dtmf (struct pvt * pvt, struct cpvt * cpvt)
+{
+	at_queue_task_t * task, * next;
+	unsigned cancelled = 0;
+
+	for (task = AST_LIST_FIRST (&pvt->at_queue); task; task = next)
+	{
+		at_queue_cmd_t * cmd;
+
+		next = AST_LIST_NEXT (task, entry);
+		if (task->cpvt != cpvt)
+			continue;
+
+		cmd = &task->cmds[task->cindex];
+		if (cmd->cmd == CMD_AT_DTMF && cmd->length > 0)
+		{
+			ast_debug (3, "[%s] cancel unsent DTMF for ended call idx %d\n",
+					PVT_ID(pvt), cpvt->call_idx);
+			at_queue_remove_task (pvt, task);
+			cancelled++;
+			continue;
+		}
+		/* In-flight DTMF and legitimate hangup commands stay ordered. */
+		task->cpvt = &pvt->sys_chan;
+	}
+	return cancelled;
+}
+
+#/* */
+EXPORT_DEF int at_queue_claim_sms_result (struct pvt * pvt)
+{
+	at_queue_task_t *task = AST_LIST_FIRST (&pvt->at_queue);
+	const at_queue_cmd_t *cmd = task ? &task->cmds[task->cindex] : NULL;
+	if (!task || !cmd || !task->sms || task->uid <= 0 ||
+	    task->sms_result_seen || cmd->cmd != CMD_AT_SMSTEXT || cmd->length != 0)
+		return -1;
+	task->sms_result_seen = 1;
+	return task->uid;
+}
+
+static int at_queue_dtmf_eligible (struct pvt * pvt, const at_queue_task_t * task, const at_queue_cmd_t * cmd)
+{
+	struct cpvt * cpvt;
+	int call_idx = -1;
+
+	if (!task || !task->cpvt || task->cpvt == &pvt->sys_chan)
+		return 0;
+	if (sscanf(cmd->data, "AT^DTMF=%d,", &call_idx) != 1)
+		return 0;
+
+	AST_LIST_TRAVERSE(&pvt->chans, cpvt, entry)
+	{
+		if (cpvt == task->cpvt)
+			return cpvt->state == CALL_STATE_ACTIVE && cpvt->call_idx == call_idx;
+	}
+	return 0;
+}

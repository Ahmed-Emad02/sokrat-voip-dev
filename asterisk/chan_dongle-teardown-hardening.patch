+};
+
+static void close_teardown_ttys(struct teardown_ttys *ttys)
 {
+	if (ttys->audio_fd >= 0)
+		close(ttys->audio_fd);
+	if (ttys->data_fd >= 0)
+		close(ttys->data_fd);
+	if (ttys->audio_lock)
+	{
+		unlink(ttys->audio_lock);
+		ast_free(ttys->audio_lock);
+	}
+	if (ttys->data_lock)
+	{
+		unlink(ttys->data_lock);
+		ast_free(ttys->data_lock);
+	}
+}

 /*!
  * \brief SEND AT+CHUP command to device IMMEDIALITY
- * \param cpvt -- cpvt structure
+ * \param pvt -- device structure
  */
-EXPORT_DEF void at_hangup_immediality(struct cpvt* cpvt)
+static int at_write_teardown(struct pvt *pvt, const char *buf, size_t count)
 {
+	size_t off = 0;
+	int retries = 0;
+	struct pollfd pfd;
+
+	if (!pvt || pvt->data_fd < 0)
+		return -1;
+
+	while (off < count)
+	{
+		ssize_t wrote = write(pvt->data_fd, buf + off, count - off);
+
+		if (wrote > 0)
+		{
+			off += (size_t) wrote;
+			retries = 0;
+			continue;
+		}
+		if (wrote < 0 && errno == EINTR)
+			continue;
+		if (wrote < 0 && errno == EAGAIN && retries++ < 5)
+		{
+			pfd.fd = pvt->data_fd;
+			pfd.events = POLLOUT;
+			pfd.revents = 0;
+			if (poll(&pfd, 1, 100) > 0 && (pfd.revents & POLLOUT))
+				continue;
+			if (errno == EINTR)
+				continue;
+		}
+		break;
+	}
+
+	if (off != count)
+	{
+		ast_log(LOG_WARNING, "[%s] teardown write failed: %zu/%zu bytes: %s\n",
+			PVT_ID(pvt), off, count, strerror(errno));
+		return -1;
+	}
+	return 0;
+}
+
+EXPORT_DEF void at_abort_pending_sms(struct pvt *pvt)
+{
+	const at_queue_cmd_t *ecmd;
+	static const char esc[] = "\x1b";
+
+	if (!pvt)
+		return;
+	ecmd = at_queue_head_cmd(pvt);
+	if (pvt->outgoing_sms > 0 ||
+	    (ecmd && (ecmd->cmd == CMD_AT_CMGS || ecmd->cmd == CMD_AT_SMSTEXT)))
+	{
+		if (at_write_teardown(pvt, esc, 1) != 0)
+			ast_log(LOG_WARNING, "[%s] could not cancel pending SMS prompt\n", PVT_ID(pvt));
+	}
+}
+
+EXPORT_DEF void at_hangup_immediality(struct pvt* pvt)
+{
 	/* Session teardown can run while an outgoing ATD is still unacknowledged.
 	 * Writing AT+CHLD=1x before ^ORIG/^CONF is Huawei HW BUG 1: the modem stops
 	 * answering every later AT command. AT+CHUP is the abort form for an
 	 * unconfirmed call and is safe for this final, best-effort teardown. */
 	static const char cmd_chup[] = "AT+CHUP\r";
 
-	if (cpvt && cpvt->pvt)
-		at_write(cpvt->pvt, cmd_chup, STRLEN(cmd_chup));
+	if (at_write_teardown(pvt, cmd_chup, STRLEN(cmd_chup)) != 0)
+		ast_log(LOG_WARNING, "[%s] could not send teardown AT+CHUP\n", PVT_ID(pvt));
 }
 

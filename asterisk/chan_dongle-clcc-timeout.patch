+/* Quarantine the CLCC head until a distinctive read-only reply establishes
+ * an ordered terminal boundary. Never transmit a queued SMS across this gap. */
+EXPORT_DEF int at_queue_recover(struct pvt *pvt)
+{
+	const at_queue_cmd_t *cmd = at_queue_head_cmd(pvt);
+	static const char probe[] = "AT+CSQ\r";
+
+	if (pvt->at_recovery || !cmd || cmd->cmd != CMD_AT_CLCC)
+		return -1;
+	if (clock_gettime(CLOCK_MONOTONIC, &pvt->at_recovery_deadline))
+		return -1;
+	pvt->at_recovery_deadline.tv_sec += ATQ_CMD_TIMEOUT_MEDIUM;
+	pvt->at_recovery = 1;
+	ast_log(LOG_WARNING, "[%s] CLCC timeout: quarantining queue for CSQ resync\n", PVT_ID(pvt));
+	return at_write(pvt, probe, sizeof(probe) - 1) ? -1 : 0;
+}
+
+EXPORT_DEF int at_queue_recovery_response(struct pvt *pvt, at_res_t res, int valid_csq)
+{
+	if (!pvt->at_recovery)
+		return 1;
+	if (at_queue_timeout(pvt) == 0)
+		return -1;
+	switch (res)
+	{
+		case RES_CSQ:
+			if (!valid_csq)
+				return -1;
+			pvt->at_recovery = 2;
+			return 0;
+		case RES_OK:
+			if (pvt->at_recovery == 2)
+			{
+				pvt->at_recovery = 0;
+				at_queue_handle_result(pvt, RES_PARSE_ERROR);
+			}
+			return 0;
+		case RES_ERROR:
+		case RES_CME_ERROR:
+		case RES_CMS_ERROR:
+		case RES_BUSY:
+		case RES_NO_CARRIER:
+		case RES_NO_DIALTONE:
+			/* Before the marker these belong to the timed-out CLCC. */
+			return pvt->at_recovery == 2 ? -1 : 0;
+		case RES_CLCC:
+		case RES_CMGR:
+		case RES_CMGS:
+		case RES_SMS_PROMPT:
+		case RES_UNKNOWN:
+			return 0;
+		default:
+			return 1;
+	}
+}
